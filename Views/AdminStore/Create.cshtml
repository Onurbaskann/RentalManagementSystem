@model KiraTakip.Models.ViewModels.StoreFormViewModel
@{
    ViewData["Title"] = "Yeni Mağaza";
    ViewData["UseCentralFeedback"] = true;
}

<div class="max-w-[700px] mx-auto">
    <div class="page-header"><div class="page-title">Yeni Mağaza</div></div>
    <div class="card">
        <form method="post" action="/Admin/Store/Create" asp-form-write-permission="@PermissionCatalog.Store.Create">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Ad <span class="text-red-500">*</span></label>
                <input asp-for="Name" class="form-control" maxlength="200" required />
                <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
            </div>
            <div class="form-group">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Description" class="text-red-500 text-xs mt-1"></span>
            </div>
            <div class="form-group">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox" class="w-4 h-4 accent-primary" />
                    <span class="form-label mb-0">Aktif</span>
                </label>
            </div>
            <div class="flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.Store.Create">Kaydet</button>
                <a href="/Admin/Store" class="btn btn-secondary px-6">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
