@model KiraTakip.Models.BorcTipi
@using KiraTakip.Models
@{
    ViewData["Title"] = "Yeni Borç Tipi";
}

<div class="page-header">
    <div>
        <div class="page-title">Yeni Borç Tipi</div>
    </div>
</div>

<div class="card" style="max-width:480px;">
    <form method="post" action="/Admin/BorcTipi/Ekle">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Ad <span style="color:red">*</span></label>
            <input asp-for="Ad" class="form-control" placeholder="Kira Bedeli" required />
            <span asp-validation-for="Ad" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Kod <span style="color:red">*</span></label>
            <input asp-for="Kod" class="form-control" placeholder="KIRA" style="font-family:monospace;text-transform:uppercase;" required maxlength="20" />
            <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Kısa tanımlayıcı (büyük harf, boşluksuz). Ör: KIRA, ORTAK, PORTAL</div>
            <span asp-validation-for="Kod" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Davranış <span style="color:red">*</span></label>
            <select asp-for="Davranis" class="form-control">
                <option value="@((int)BorcTipiDavranisi.AylikSabit)">Aylık Sabit — Her ay tahakkuka eklenir</option>
                <option value="@((int)BorcTipiDavranisi.IlkAyTekSeferlik)">İlk Ay Tek Seferlik — Sadece sözleşmenin ilk ayında eklenir (ör. depozito)</option>
                <option value="@((int)BorcTipiDavranisi.ManuelTetiklemeli)">Manuel Tetiklemeli — Kullanıcı tarafından manuel eklenir</option>
            </select>
            <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Borç kaleminin tahakkuklarda nasıl oluşturulacağını belirler.</div>
            <span asp-validation-for="Davranis" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Sira" type="number" class="form-control" min="1" style="width:100px;" />
        </div>

        <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input asp-for="Aktif" type="checkbox" />
                <span class="form-label" style="margin:0;">Aktif</span>
            </label>
        </div>

        <div style="display:flex;gap:8px;margin-top:8px;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Admin/BorcTipi" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
