@model KiraTakip.Models.BorcTipi
@using KiraTakip.Models
@{
    ViewData["Title"] = "Borç Tipi Düzenle";
    var sistemKilidi = Model.Sistem;
}

<div class="page-header">
    <div>
        <div class="page-title">Borç Tipi Düzenle</div>
    </div>
</div>

<div class="card" style="max-width:480px;">
    <form method="post" action="/Admin/BorcTipi/Duzenle/@Model.Id">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Sistem" type="hidden" />

        <div class="form-group">
            <label class="form-label">Ad <span style="color:red">*</span></label>
            <input asp-for="Ad" class="form-control" required />
            <span asp-validation-for="Ad" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Kod @if (!sistemKilidi) { <span style="color:red">*</span> }</label>
            @if (sistemKilidi)
            {
                <input asp-for="Kod" class="form-control" style="font-family:monospace;font-weight:600;background:#f3f4f6;color:#6b7280;" readonly />
                <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">🔒 Sistem kaydı — kod değiştirilemez.</div>
            }
            else
            {
                <input asp-for="Kod" class="form-control" style="font-family:monospace;text-transform:uppercase;" required maxlength="20" />
                <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Kısa tanımlayıcı (büyük harf, rakam, alt çizgi — 2-20 karakter)</div>
                <span asp-validation-for="Kod" class="text-danger" style="font-size:12px;"></span>
            }
        </div>

        <div class="form-group">
            <label class="form-label">Davranış <span style="color:red">*</span></label>
            <select asp-for="Davranis" class="form-control">
                <option value="@((int)BorcTipiDavranisi.AylikSabit)">Aylık Sabit — Her ay tahakkuka eklenir</option>
                <option value="@((int)BorcTipiDavranisi.IlkAyTekSeferlik)">İlk Ay Tek Seferlik — Sadece sözleşmenin ilk ayında eklenir (ör. depozito)</option>
                <option value="@((int)BorcTipiDavranisi.KullaniciManuel)">Kullanıcı Manuel — Kullanıcı tarafından manuel eklenir</option>
                <option value="@((int)BorcTipiDavranisi.RezervasyonOzel)">Rezervasyon Özel — Yalnızca rezervasyon akışı tarafından oluşturulur</option>
            </select>
            <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Borç kaleminin tahakkuklarda nasıl oluşturulacağını belirler.</div>
            <span asp-validation-for="Davranis" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Sira" type="number" class="form-control" min="1" style="width:100px;" />
        </div>

        <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input asp-for="Aktif" type="checkbox" />
                <span class="form-label" style="margin:0;">Aktif</span>
            </label>
        </div>

        <div style="display:flex;gap:8px;margin-top:8px;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Admin/BorcTipi" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
