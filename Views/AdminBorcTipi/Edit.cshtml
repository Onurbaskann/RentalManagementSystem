@model KiraTakip.Models.BorcTipi
@using KiraTakip.Models
@{
    ViewData["Title"] = "Borç Tipi Düzenle";
    var sistemKilidi = Model.Sistem;
}

<div class="page-header">
    <div>
        <div class="page-title">Borç Tipi Düzenle</div>
    </div>
</div>

<div class="card max-w-[480px]">
    <form method="post" action="/Admin/BorcTipi/Duzenle/@Model.Id">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Sistem" type="hidden" />

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Ad" class="form-control" required />
            <span asp-validation-for="Ad" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Kod @if (!sistemKilidi) { <span class="text-red-500">*</span> }</label>
            @if (sistemKilidi)
            {
                <input asp-for="Kod" class="form-control font-mono font-bold bg-slate-100 text-slate-500" readonly />
                <div class="text-xs text-muted mt-1">🔒 Sistem kaydı — kod değiştirilemez.</div>
            }
            else
            {
                <input asp-for="Kod" class="form-control font-mono uppercase" required maxlength="20" />
                <div class="text-xs text-muted mt-1">Kısa tanımlayıcı (büyük harf, rakam, alt çizgi — 2-20 karakter)</div>
                <span asp-validation-for="Kod" class="text-red-500 text-xs mt-1"></span>
            }
        </div>

        <div class="form-group">
            <label class="form-label">Davranış <span class="text-red-500">*</span></label>
            <select asp-for="Davranis" class="form-control">
                <option value="@((int)BorcTipiDavranisi.AylikSabit)">Aylık Sabit — Her ay tahakkuka eklenir</option>
                <option value="@((int)BorcTipiDavranisi.IlkAyTekSeferlik)">İlk Ay Tek Seferlik — Sadece sözleşmenin ilk ayında eklenir (ör. depozito)</option>
                <option value="@((int)BorcTipiDavranisi.KullaniciManuel)">Kullanıcı Manuel — Kullanıcı tarafından manuel eklenir</option>
                <option value="@((int)BorcTipiDavranisi.RezervasyonOzel)">Rezervasyon Özel — Yalnızca rezervasyon akışı tarafından oluşturulur</option>
            </select>
            <div class="text-xs text-muted mt-1">Borç kaleminin tahakkuklarda nasıl oluşturulacağını belirler.</div>
            <span asp-validation-for="Davranis" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Sira" type="number" class="form-control w-24" min="1" />
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="Aktif" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6">Kaydet</button>
            <a href="/Admin/BorcTipi" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
