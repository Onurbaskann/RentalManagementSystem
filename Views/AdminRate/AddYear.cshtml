@model KiraTakip.Models.ViewModels.RateYearAddViewModel
@{
    ViewData["Title"] = "Yeni Tarife Yılı";
    ViewData["UseCentralFeedback"] = true;
    var existingYears = ViewBag.ExistingYears as IEnumerable<int> ?? [];
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div>
        <div class="page-title">Yeni Tarife Yılı</div>
    </div>
</div>

<div class="card">
    <form method="post" action="/Admin/Rate/AddYear">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Yıl <span style="color:red">*</span></label>
            <input asp-for="Year" type="number" class="form-control" style="width:120px;" />
            <span asp-validation-for="Year" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Önceki yıldan kopyala</label>
            <select asp-for="CopyFromYear" class="form-control" style="max-width:200px;">
                <option value="">— Kopyalama (boş başlat) —</option>
                @foreach (var y in existingYears)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Seçilirse o yılın fiyatları kopyalanır.</div>
        </div>

        <div style="display:flex;gap:8px;margin-top:8px;">
            <button type="submit" class="btn btn-primary">Oluştur</button>
            <a href="/Admin/Rate" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
</div>
