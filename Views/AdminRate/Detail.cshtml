@model KiraTakip.Models.ViewModels.RateMatrixViewModel
@{
    ViewData["Title"] = $"{Model.Year} Tarifeleri";
    ViewData["UseCentralFeedback"] = true;
    int idx = 0;

    string FieldValue(string key, string fallback)
    {
        return ViewData.ModelState.TryGetValue(key, out var state)
            ? state.AttemptedValue ?? fallback
            : fallback;
    }
}


<div class="page-header">
    <a href="/Admin/Rate" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">← Tarifeler</a>
    <div class="page-title">@Model.Year Tarifeleri</div>
    <div class="page-subtitle">Kiracı kategorisi × borç tipi bazında yıllık birim fiyatlar</div>
</div>

<form method="post" action="/Admin/Rate/Year/@Model.Year/UpdateLine">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Year" value="@Model.Year" />
    <input type="hidden" name="IsActive" value="@Model.IsActive.ToString().ToLower()" />



    <div class="card p-0 overflow-hidden mb-4">
        @if (Model.Rows == null || !Model.Rows.Any() || Model.Columns == null || !Model.Columns.Any())
        {
            <div class="p-6 text-center text-muted">
                Aktif kiracı kategorisi veya borç tipi bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-wrapper overflow-x-auto">
                <table class="min-w-[700px] border-collapse w-full">
                    <thead>
                        <tr>
                            <th class="p-4 text-left bg-slate-50 border-b border-[var(--color-border)] min-w-[160px] text-xs font-bold text-muted uppercase tracking-wider">
                                Kiracı Kategorisi
                            </th>
                            @foreach (var kolon in Model.Columns)
                            {
                                <th class="p-[10px_12px] text-center bg-slate-50 border-b border-[var(--color-border)] min-w-[200px]">
                                    <div class="text-[10px] color-muted font-bold uppercase tracking-wider mb-0.5">@kolon.ChargeTypeCode</div>
                                    <div class="text-[13px] font-bold text-slate-700">@kolon.ChargeTypeName</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var satir in Model.Rows)
                        {
                            <tr>
                                <td class="p-4 font-semibold text-[13.5px] border-b border-[var(--color-border)] align-middle">
                                    @satir.TenantCategoryName
                                </td>
                                @foreach (var hucre in satir.Cells)
                                {
                                    var calculationMethodField = $"Cells[{idx}].CalculationMethod";
                                    var unitValueField = $"Cells[{idx}].UnitValue";
                                    var kdvRateField = $"Cells[{idx}].KdvRate";

                                    <td class="p-[10px_12px] border-b border-[var(--color-border)] align-top bg-white/50">
                                        <input type="hidden" name="Cells[@idx].LineItemId"          value="@hucre.LineItemId" />
                                        <input type="hidden" name="Cells[@idx].TenantCategoryId" value="@hucre.TenantCategoryId" />
                                        <input type="hidden" name="Cells[@idx].ChargeTypeId"       value="@hucre.ChargeTypeId" />

                                        <div class="mb-2">
                                            <label class="text-[10px] text-muted font-bold uppercase tracking-wider block mb-0.5">Birim Değer (₺)</label>
                                            <input type="number" name="@unitValueField"
                                                   value="@FieldValue(unitValueField, hucre.UnitValue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                                   class="form-control form-control-sm text-xs font-mono" step="0.01" />
                                            @Html.ValidationMessage(unitValueField, null, new { @class = "text-danger text-[11px] mt-1 block" })
                                        </div>
                                        <div class="mb-2">
                                            <label class="text-[10px] text-muted font-bold uppercase tracking-wider block mb-0.5">Yöntem</label>
                                            <select name="@calculationMethodField" class="form-control form-control-sm text-xs">
                                                @if (hucre.CalculationMethod == KiraTakip.Models.CalculationMethod.Fixed)
                                                {
                                                    <option value="1" selected>Sabit</option>
                                                    <option value="2">m²</option>
                                                }
                                                else
                                                {
                                                    <option value="1">Sabit</option>
                                                    <option value="2" selected>m²</option>
                                                }
                                            </select>
                                            @Html.ValidationMessage(calculationMethodField, null, new { @class = "text-danger text-[11px] mt-1 block" })
                                        </div>
                                        <div>
                                            <label class="text-[10px] text-muted font-bold uppercase tracking-wider block mb-0.5">KDV (%)</label>
                                            <input type="number" name="@kdvRateField"
                                                   value="@FieldValue(kdvRateField, hucre.KdvRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                                   class="form-control form-control-sm text-xs font-mono" step="0.01" min="0" max="100" />
                                            @Html.ValidationMessage(kdvRateField, null, new { @class = "text-danger text-[11px] mt-1 block" })
                                        </div>
                                    </td>
                                    idx++;
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Rezervasyon Genel Tarifeleri Bölümü -->
    <div class="card p-0 overflow-hidden mt-6">
        <div class="p-4 bg-slate-50 border-b border-[var(--color-border)] flex items-center gap-2.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary shrink-0"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"/><path d="M12 11h.01"/><path d="M12 7h.01"/><path d="M12 15h.01"/><path d="M8 11h.01"/><path d="M8 7h.01"/><path d="M8 15h.01"/><path d="M16 11h.01"/><path d="M16 7h.01"/><path d="M16 15h.01"/></svg>
            <div class="text-[15px] font-bold text-slate-700">Rezervasyon Genel Tarifeleri</div>
        </div>

        @if (Model.ReservationRows == null || !Model.ReservationRows.Any())
        {
            <div class="p-6 text-center text-muted">
                Aktif rezervasyon yapılabilir birim türü bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-wrapper overflow-x-auto">
                <table class="min-w-[700px] border-collapse w-full">
                    <thead>
                        <tr>
                            <th class="p-[12px_16px] text-left bg-slate-50 border-b border-[var(--color-border)] text-xs font-bold text-muted uppercase tracking-wider">Alan Türü</th>
                            <th class="p-[12px_16px] text-left bg-slate-50 border-b border-[var(--color-border)] text-xs font-bold text-muted uppercase tracking-wider w-[120px]">Ücretsiz Süre (dk)</th>
                            <th class="p-[12px_16px] text-left bg-slate-50 border-b border-[var(--color-border)] text-xs font-bold text-muted uppercase tracking-wider w-[120px]">Periyot (dk)</th>
                            <th class="p-[12px_16px] text-left bg-slate-50 border-b border-[var(--color-border)] text-xs font-bold text-muted uppercase tracking-wider w-[150px]">Periyot Ücreti (₺)</th>
                            <th class="p-[12px_16px] text-left bg-slate-50 border-b border-[var(--color-border)] text-xs font-bold text-muted uppercase tracking-wider w-[100px]">KDV (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ReservationRows.Count; i++)
                        {
                            var rez = Model.ReservationRows[i];
                            var freeDurationField = $"ReservationCells[{i}].FreeDurationMinutes";
                            var billingPeriodField = $"ReservationCells[{i}].BillingPeriodMinutes";
                            var periodRateField = $"ReservationCells[{i}].PeriodRate";
                            var reservationKdvRateField = $"ReservationCells[{i}].KdvRate";

                            <tr>
                                <td class="p-[12px_16px] border-b border-[var(--color-border)] font-semibold text-[13.5px] text-slate-700">
                                    <input type="hidden" name="ReservationCells[@i].ReservationRateId" value="@rez.ReservationRateId" />
                                    <input type="hidden" name="ReservationCells[@i].UnitTypeId" value="@rez.UnitTypeId" />
                                    @rez.UnitTypeName
                                </td>
                                <td class="p-[10px_16px] border-b border-[var(--color-border)]">
                                    <input type="number" name="@freeDurationField"
                                           value="@FieldValue(freeDurationField, rez.FreeDurationMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                           class="form-control form-control-sm text-center" />
                                    @Html.ValidationMessage(freeDurationField, null, new { @class = "text-danger text-[11px] mt-1 block" })
                                </td>
                                <td class="p-[10px_16px] border-b border-[var(--color-border)]">
                                    <input type="number" name="@billingPeriodField"
                                           value="@FieldValue(billingPeriodField, rez.BillingPeriodMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                           class="form-control form-control-sm text-center" />
                                    @Html.ValidationMessage(billingPeriodField, null, new { @class = "text-danger text-[11px] mt-1 block" })
                                </td>
                                <td class="p-[10px_16px] border-b border-[var(--color-border)]">
                                    <input type="number" name="@periodRateField"
                                           value="@FieldValue(periodRateField, rez.PeriodRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                           class="form-control form-control-sm font-mono text-center" step="0.01" />
                                    @Html.ValidationMessage(periodRateField, null, new { @class = "text-danger text-[11px] mt-1 block" })
                                </td>
                                <td class="p-[10px_16px] border-b border-[var(--color-border)]">
                                    <input type="number" name="@reservationKdvRateField"
                                           value="@FieldValue(reservationKdvRateField, rez.KdvRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                           class="form-control form-control-sm font-mono text-center" step="0.01" min="0" max="100" />
                                    @Html.ValidationMessage(reservationKdvRateField, null, new { @class = "text-danger text-[11px] mt-1 block" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="mt-6 flex gap-3">
        <button type="submit" class="btn btn-primary btn-lg min-w-[140px]">Kaydet</button>
        <a href="/Admin/Rate" class="btn btn-secondary btn-lg min-w-[100px]">İptal</a>
    </div>
</form>
