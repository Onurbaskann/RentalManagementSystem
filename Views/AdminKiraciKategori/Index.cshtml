@model List<KiraTakip.Models.KiraciKategori>
@{
    ViewData["Title"] = "Kiracı Kategorileri";
}

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✕ @TempData["Error"]
    </div>
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Kiracı Kategorileri</div>
        <div class="page-subtitle">@Model.Count kayıt — çarpan hesaplamalarında kullanılır</div>
    </div>
    <a href="/Admin/KiraciKategori/Ekle" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Kategori
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th class="w-32">Kod</th>
                    <th>Ad</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@k.Sira</td>
                        <td><span class="font-mono font-semibold text-[13px]">@k.Kod</span></td>
                        <td class="font-medium text-slate-700">@k.Ad</td>
                        <td>
                            @if (k.Aktif)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/KiraciKategori/Duzenle/@k.Id" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/KiraciKategori/DurumDegistir/@k.Id"
                                  data-confirm="@(k.Aktif ? $"'{k.Ad}' pasif yapılsın mı?" : $"'{k.Ad}' aktif yapılsın mı?")"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(k.Aktif ? "btn-danger" : "btn-amber")">
                                    @(k.Aktif ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center py-8 text-muted">Henüz kiracı kategorisi tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
