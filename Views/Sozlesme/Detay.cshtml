@model KiraTakip.Models.ViewModels.SozlesmeDetayViewModel
@using KiraTakip.Models
@using KiraTakip.Services.Interfaces
@using KiraTakip.Authorization
@using System.Globalization
@inject IIstatistikService Istatistik
@{
    ViewData["Title"] = $"Sözleşme #{Model.Sozlesme.Id}";
    var s = Model.Sozlesme;
    var kiraci = s.Kiraci;
    var birim = s.Birim;
    var tasinmaz = birim.Tasinmaz;
    var trCulture = new CultureInfo("tr-TR");

    bool feshedildi = s.Durum == SozlesmeDurumu.Feshedildi;
    bool sonaErdi = s.Durum == SozlesmeDurumu.SonaErdi;

    string sozlesmeDurumBadgeCls = s.Durum switch {
        SozlesmeDurumu.Feshedildi => "badge-gecmis",
        SozlesmeDurumu.SonaErdi   => "badge-bos",
        _                          => Model.Durum == KiraDurumu.SuresiDolmakUzere ? "badge-surek" : "badge-kirali"
    };
    string sozlesmeDurumLabel = s.Durum switch {
        SozlesmeDurumu.Feshedildi => "Feshedildi",
        SozlesmeDurumu.SonaErdi   => "Sona Erdi",
        _                          => Model.Durum == KiraDurumu.SuresiDolmakUzere ? "Süresi Dolmak Üzere" : "Aktif"
    };

    string gunBadgeCls = Model.KalanGun <= 10 ? "day-badge-red" : Model.KalanGun <= 30 ? "day-badge-amber" : "day-badge-green";
    string gunMesaj = feshedildi ? "Sözleşme feshedildi." : Model.KalanGun <= 0 ? "Sözleşme sona erdi." : Model.KalanGun <= 30 ? "Süresi dolmak üzere!" : "Sözleşme aktif.";

    string TLFormat(decimal v) => v.ToString("N2") + " ₺";
    bool canEdit = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Sozlesme.Extend) || User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Sozlesme.Terminate);
    bool canRegenerate = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Tahakkuk.Regenerate);

    decimal aylikBedel = Model.AylikBedel;
    decimal kdvTutari = s.KdvUygulanacakMi ? aylikBedel * Model.KdvOraniEtkin / 100 : 0;
    decimal kdvDahilToplam = aylikBedel + kdvTutari;
    decimal aylikKdv = s.KdvUygulanacakMi ? aylikBedel * Model.KdvOraniEtkin / 100 : 0;
}

@if (TempData["Success"] != null)
{
    <div class="alert-success mb-4">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-danger mb-4">✕ @TempData["Error"]</div>
}

@if (feshedildi)
{
    <div class="alert-danger mb-4 text-[13.5px]">
        Bu sözleşme <strong>@s.FesihTarihi?.ToString("dd.MM.yyyy")</strong> tarihinde feshedildi.
        @if (!string.IsNullOrEmpty(s.FesihNedeni)) { <span> Neden: @s.FesihNedeni</span> }
    </div>
}

<div x-data="{
    showUzat: false,
    showFesih: false,
    showYenidenUret: false,
    tufeEnabled: false,
    birimYuzolcumu: @s.Birim.Yuzolcumu.ToString(System.Globalization.CultureInfo.InvariantCulture),
    sozlesmeBirimId: @s.BirimId,
    sozlesmeKiraciId: @s.KiraciId,
    sozlesmeId: @s.Id,
    tarifeYenidenUret: false,
    yenidenUretKalemler: [],
    yenidenUretKalemlerYuklendi: false,
    tarifeUzat: false,
    uzatKalemler: [],
    uzatKalemlerYuklendi: false,
    async fetchTarifeKalemler(hedef) {
        const yuklendi = hedef === 'yenidenUret' ? 'yenidenUretKalemlerYuklendi' : 'uzatKalemlerYuklendi';
        const kalemler = hedef === 'yenidenUret' ? 'yenidenUretKalemler' : 'uzatKalemler';
        if (this[yuklendi]) return;
        const res = await fetch(`/Sozlesme/GetVarsayilanKalemler?birimId=${this.sozlesmeBirimId}&kiraciId=${this.sozlesmeKiraciId}&baslangic=@DateTime.Today.ToString("yyyy-MM-dd")&sozlesmeId=${this.sozlesmeId}`);
        const data = await res.json();
        this[kalemler] = data.map(k => ({ ...k, originalBirimDeger: k.birimDeger, varsayilanHesaplamaYontemi: k.hesaplamaYontemi, _error: null }));
        this[yuklendi] = true;
    },
    hesaplaPopupTutar(k) {
        return k.hesaplamaYontemi == 2 ? k.birimDeger * this.birimYuzolcumu : k.birimDeger;
    },
    kdvEnabled: @(s.KdvUygulanacakMi ? "true" : "false"),
    tufeOrani: 25,
    kdvOrani: @Model.KdvOraniEtkin.ToString(CultureInfo.InvariantCulture),
    currentBedel: @aylikBedel.ToString(CultureInfo.InvariantCulture),
    yeniKiraBedeli: @aylikBedel.ToString(CultureInfo.InvariantCulture),
    get tufeArtisTutari() { return this.tufeEnabled ? Math.round(this.currentBedel * this.tufeOrani / 100) : 0; },
    get tufeSonrasiBedel() { return this.currentBedel + this.tufeArtisTutari; },
    get kdvTutari() { return this.kdvEnabled ? Math.round(this.yeniKiraBedeli * this.kdvOrani / 100) : 0; },
    get kdvDahilToplam() { return this.yeniKiraBedeli + this.kdvTutari; },
    formatTl(v) { return new Intl.NumberFormat('tr-TR').format(v) + ' ₺'; },
    async applyTufe() {
        await this.fetchTarifeKalemler('uzat');
        if (this.tufeEnabled) {
            this.tarifeUzat = true;
            const oran = this.tufeOrani / 100;
            this.uzatKalemler.forEach(k => {
                k.birimDeger = Math.round(k.originalBirimDeger * (1 + oran) * 100) / 100;
                k.kullaniciDegistirdiMi = true;
            });
            this.yeniKiraBedeli = this.tufeSonrasiBedel;
        } else {
            this.uzatKalemler.forEach(k => {
                k.birimDeger = k.originalBirimDeger;
                k.kullaniciDegistirdiMi = false;
            });
            this.yeniKiraBedeli = this.currentBedel;
        }
    }
}">

<!-- Breadcrumb + Butonlar -->
<div class="flex items-center justify-between mb-5">
    <a href="/Sozlesme" class="text-[12.5px] text-muted no-underline">← Sözleşmeler</a>
    <div class="flex gap-2.5">
        @if (canRegenerate && !feshedildi)
        {
            <button class="btn btn-secondary" type="button" @@click="showYenidenUret = true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.43"/></svg>
                Tahakkuk Yeniden Üret
            </button>
        }
        @if (canEdit && !feshedildi)
        {
            <button class="btn btn-amber" type="button" @@click="showUzat = true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                Sözleşmeyi Uzat
            </button>
            <button class="btn btn-danger" type="button" @@click="showFesih = true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Sözleşmeyi Feshet
            </button>
        }
    </div>
</div>

<!-- Ana Kart -->
<div class="card mb-4">
    <div class="grid grid-cols-2 gap-6 items-start">
        <!-- Sol: Kiracı -->
        <div>
            <div class="text-[11.5px] font-semibold text-muted uppercase tracking-wider mb-2.5">Kiracı</div>
            <div class="flex items-center gap-3.5 mb-3.5">
                <div class="w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center text-[17px] font-bold flex-shrink-0">
                    @(kiraci.GosterimAdi.Split(' ').Where(p => p.Length > 0).Take(2).Select(p => p[0].ToString().ToUpper()).Aggregate("", (a, b) => a + b))
                </div>
                <div>
                    <div class="font-serif text-[22px] font-bold leading-tight">@kiraci.GosterimAdi</div>
                    <div class="mt-1 flex gap-1.5 items-center">
                        @if (kiraci.KiraciTuru == KiraciTuru.Tuzel)
                        { <span class="badge badge-kurumsal">Tüzel Kişi</span> }
                        else
                        { <span class="badge badge-bireysel">Gerçek Kişi</span> }
                        @if (kiraci.KiraciKategori != null)
                        {
                            <span class="badge badge-bos">@kiraci.KiraciKategori.Ad</span>
                        }
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-1.5">
                <div class="flex items-center gap-2 text-[13px]">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.61 4.59 2 2 0 0 1 3.58 2.41h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.52 17z"/></svg>
                    @kiraci.Telefon
                </div>
                <div class="flex items-center gap-2 text-[13px]">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted flex-shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    @kiraci.Email
                </div>
            </div>
            <div class="mt-3">
                <a href="/Kiraci/Detay/@kiraci.Id" class="btn btn-sm btn-secondary">Kiracı Profili</a>
            </div>
        </div>

        <!-- Sağ: Taşınmaz + Sözleşme Durumu -->
        <div class="text-right">
            <div class="text-[11.5px] font-semibold text-muted uppercase tracking-wider mb-2.5">Taşınmaz</div>
            <div class="font-serif text-xl font-bold mb-1">@tasinmaz.Ad</div>
            @if (birim.BirimTipi == BirimTipi.Birim)
            {
                <div class="text-sm text-muted mb-1">Birim @birim.BirimNo@(birim.KatNo.HasValue ? $" • {birim.KatNo}. Kat" : "") • @birim.Yuzolcumu.ToString("N0") m²</div>
                <div class="text-[13px] text-muted mb-2.5">@tasinmaz.Ilce, @tasinmaz.Il</div>
            }
            else
            {
                <div class="text-sm text-muted mb-2.5">@birim.Ad • @tasinmaz.Ilce, @tasinmaz.Il</div>
            }
            <div class="mb-3">
                <span class="badge @sozlesmeDurumBadgeCls text-[12.5px] px-3.5 py-1.5">@sozlesmeDurumLabel</span>
            </div>
            <a href="/Tasinmaz/Detay/@tasinmaz.Id" class="btn btn-sm btn-secondary">Taşınmaz Detayı</a>
        </div>
    </div>
</div>

<!-- 3 Kolonlu Özet -->
<div class="grid grid-cols-3 gap-4 mb-4">
    <!-- Kira Bedeli -->
    <div class="card">
        <div class="card-title">Kira Bedeli</div>
        <div class="mt-2.5">
            <div class="text-xs text-muted mb-0.5">Aylık (KDV Hariç)</div>
            <div class="font-serif text-[26px] font-bold text-primary">@TLFormat(aylikBedel)</div>
        </div>
        @if (s.KdvUygulanacakMi)
        {
            <div class="mt-2 pt-2 border-t border-[var(--color-border)]">
                <div class="text-[11.5px] text-muted mb-0.5">KDV (%@Model.KdvOraniEtkin.ToString("G"))</div>
                <div class="text-sm font-semibold">+ @TLFormat(aylikKdv)</div>
                <div class="text-xs text-muted mt-1">KDV Dahil: <strong>@TLFormat(aylikBedel + aylikKdv)</strong></div>
            </div>
        }
        <div class="mt-2 pt-2 border-t border-[var(--color-border)]">
            <div class="text-[11.5px] text-muted mb-0.5">Yıllık</div>
            <div class="text-base font-bold">@TLFormat(Model.YillikBedel)</div>
        </div>
        <div class="mt-1.5 text-[11.5px] text-muted">
            Tam ay üzerinden
        </div>
    </div>

    <!-- Sözleşme Süresi -->
    <div class="card">
        <div class="card-title">Sözleşme Süresi</div>
        <div class="mt-2.5 flex items-center gap-2 text-[13px] font-medium">
            <span>@s.BaslangicTarihi.ToString("dd.MM.yyyy")</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted flex-shrink-0"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <span>@s.BitisTarihi.ToString("dd.MM.yyyy")</span>
        </div>
        <div class="mt-3.5">
            <div class="flex justify-between text-[11.5px] text-muted mb-1">
                <span>Geçen süre</span>
                <span>%@Model.SureYuzdesi.ToString("F0")</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill @(Model.SureYuzdesi > 85 ? "progress-fill-amber" : "")" style="width:@Model.SureYuzdesi.ToString("F0")%;"></div>
            </div>
        </div>
        <div class="mt-2.5 text-xs text-muted">
            Toplam @((int)(s.BitisTarihi - s.BaslangicTarihi).TotalDays) gün
        </div>
    </div>

    <!-- Kalan Gün -->
    <div class="card text-center">
        <div class="card-title text-center">Kalan Gün</div>
        <div class="mt-3.5">
            <div class="font-serif text-[52px] font-bold leading-none"
                 style="color:@(feshedildi ? "#dc2626" : Model.KalanGun <= 10 ? "#dc2626" : Model.KalanGun <= 30 ? "#b45309" : "var(--color-primary)");">
                @(feshedildi ? "—" : Math.Max(0, Model.KalanGun).ToString())
            </div>
            <div class="text-[13px] text-muted mt-1">@(feshedildi ? "" : "gün kaldı")</div>
        </div>
        <div class="mt-3.5 pt-3 border-t border-[var(--color-border)]">
            <span class="text-[13px] font-semibold" 
                  style="color:@(feshedildi || Model.KalanGun <= 0 ? "#dc2626" : Model.KalanGun <= 30 ? "#b45309" : "#065f46");">
                @gunMesaj
            </span>
        </div>
    </div>
</div>

<!-- Aylık Tahakkuk Kalemleri -->
@if (Model.GuncelKalemler.Any())
{
    <div class="card mb-4">
        <div class="flex justify-between items-center mb-3.5">
            <div>
                <span class="text-xs font-semibold text-muted uppercase tracking-wider">Aylık Tahakkuk Kalemleri</span>
                @if (Model.GuncelKalemDonemi.HasValue)
                {
                    <span class="text-xs text-muted ml-2">— @Model.GuncelKalemDonemi.Value.ToString("MMMM yyyy", trCulture)</span>
                }
                <div class="text-[11.5px] text-muted mt-0.5">İlk/son ay kıst uygulanır</div>
            </div>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Kalem</th>
                        <th>Yöntem</th>
                        <th class="text-right">Birim Değer</th>
                        <th class="text-right">Çarpan</th>
                        <th class="text-right">Net Tutar</th>
                        <th class="text-right">KDV</th>
                        <th class="text-right">Toplam</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.GuncelKalemler)
                    {
                        <tr>
                            <td>
                                <span class="font-mono text-[11px] bg-[#f1f5f9] px-[7px] py-[2px] rounded-sm text-[#475569]">@k.BorcTipi.Kod</span>
                                <span class="font-medium ml-1.5 text-[13.5px]">@k.BorcTipi.Ad</span>
                            </td>
                            <td class="text-[12.5px] text-muted">@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "m²" : "Sabit")</td>
                            <td class="text-right text-[13px]">@k.BirimDeger.ToString("N2") ₺</td>
                            <td class="text-right text-[13px] text-muted">
                                @if (k.Carpan == 1m) { <span>—</span> }
                                else { <span>× @k.Carpan.ToString("F2")</span> }
                            </td>
                            <td class="text-right font-semibold">@k.Tutar.ToString("N2") ₺</td>
                            <td class="text-right text-[13px] text-muted">
                                @if (k.KdvOrani > 0) { <span>%@k.KdvOrani.ToString("G") → @k.KdvTutari.ToString("N2") ₺</span> }
                                else { <span>—</span> }
                            </td>
                            <td class="text-right font-bold text-primary">@k.ToplamTutar.ToString("N2") ₺</td>
                        </tr>
                    }
                    <tr class="bg-[#fafbfc] border-t-2 border-[var(--color-border)]">
                        <td colspan="4" class="font-semibold text-right text-[13px] pr-4 text-muted">Toplam</td>
                        <td class="text-right font-bold">@Model.GuncelKalemler.Sum(k => k.Tutar).ToString("N2") ₺</td>
                        <td class="text-right font-semibold text-[13px]">@Model.GuncelKalemler.Sum(k => k.KdvTutari).ToString("N2") ₺</td>
                        <td class="text-right font-bold text-primary text-[15px]">@Model.GuncelKalemler.Sum(k => k.ToplamTutar).ToString("N2") ₺</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Alt Tab'lı Bölüm -->
<div id="sozlesme-tabs">
    <div class="tabs">
        <button class="tab">Detaylar</button>
        <button class="tab">Birim Bilgisi</button>
        <button class="tab">Geçmiş Sözleşmeler (@Model.GecmisSozlesmeler.Count)</button>
        <button class="tab">İşlem Geçmişi (@s.IslemGecmisi.Count)</button>
        @if (Model.HasOdemeAccess)
        {
            <button class="tab">Ödemeler (@Model.Tahakkuklar.Count)</button>
        }
    </div>

    <!-- Tab 1: Detaylar -->
    <div class="tab-content">
        <div class="card">
            <div class="grid grid-cols-2 gap-0">
                @{
                    void Row(string label, string value) {
                        <div class="px-4 py-3 border-b border-[var(--color-border)]">
                            <div class="detail-label">@label</div>
                            <div class="text-sm font-medium">@value</div>
                        </div>
                    }
                }
                @{
                    Row("Sözleşme No", $"#{s.Id}");
                    Row("Kira Bedeli (KDV Hariç)", $"{aylikBedel.ToString("N0")} ₺ / ay");
                    Row("Depozito", Model.DepozitoTutari.HasValue ? Model.DepozitoTutari.Value.ToString("N0") + " ₺" : "—");
                    Row("Başlangıç", s.BaslangicTarihi.ToString("dd MMMM yyyy", trCulture));
                    Row("Bitiş", s.BitisTarihi.ToString("dd MMMM yyyy", trCulture));
                    if (s.KdvUygulanacakMi)
                    {
                        Row("KDV Oranı", "%" + Model.KdvOraniEtkin.ToString("G"));
                        Row("KDV Tutarı", $"{kdvTutari.ToString("N0")} ₺ / ay");
                        Row("KDV Dahil Toplam", $"{kdvDahilToplam.ToString("N0")} ₺ / ay");
                    }
                    else
                    {
                        Row("KDV", "Uygulanmıyor");
                    }
                    if (feshedildi)
                    {
                        Row("Fesih Tarihi", s.FesihTarihi?.ToString("dd MMMM yyyy", trCulture) ?? "—");
                        Row("Fesih Nedeni", s.FesihNedeni ?? "—");
                    }
                }
            </div>
            @if (!string.IsNullOrEmpty(s.Notlar))
            {
                <div class="px-4 py-3.5 bg-[#fafbfc] rounded-b-xl">
                    <div class="detail-label mb-1.5">Notlar</div>
                    <div class="text-sm leading-relaxed">@s.Notlar</div>
                </div>
            }
        </div>
    </div>

    <!-- Tab 2: Birim Bilgisi -->
    <div class="tab-content">
        <div class="card">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <div class="detail-label mb-3">Birim</div>
                    <div class="flex flex-col gap-2.5">
                        <div>
                            <div class="text-xs text-muted">Ad</div>
                            <div class="text-[15px] font-semibold">@birim.Ad</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Yüzölçüm</div>
                            <div class="text-[15px] font-semibold">@birim.Yuzolcumu.ToString("N0") m²</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Tip</div>
                            <div class="text-[15px] font-semibold">
                                @if (birim.BirimTipi == BirimTipi.Birim)
                                {
                                    <span>Birim @birim.BirimNo</span>
                                    if (birim.KatNo.HasValue) { <span class="text-[13px] font-normal text-muted"> • @birim.KatNo. Kat</span> }
                                }
                                else { <span>Komple</span> }
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="detail-label mb-3">Taşınmaz</div>
                    <div class="flex flex-col gap-2.5">
                        <div>
                            <div class="text-xs text-muted">Ad</div>
                            <div class="text-[15px] font-semibold">@tasinmaz.Ad</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Konum</div>
                            <div class="text-[15px] font-semibold">@tasinmaz.Mahalle, @tasinmaz.Ilce / @tasinmaz.Il</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Adres</div>
                            <div class="text-sm">@tasinmaz.AcikAdres</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 3: Geçmiş Sözleşmeler -->
    <div class="tab-content">
        @if (!Model.GecmisSozlesmeler.Any())
        {
            <div class="card text-center text-muted p-8">Bu birime ait başka sözleşme yok.</div>
        }
        else
        {
            <div class="card p-0 overflow-hidden">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Kiracı</th>
                                <th>Başlangıç</th>
                                <th>Bitiş</th>
                                <th>Aylık Bedel</th>
                                <th>Durum</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gs in Model.GecmisSozlesmeler)
                            {
                                bool gAktif = Istatistik.Aktif(gs);
                                bool gFesih = gs.Durum == SozlesmeDurumu.Feshedildi;
                                <tr>
                                    <td class="font-semibold">@gs.Kiraci.GosterimAdi</td>
                                    <td>@gs.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                                    <td>@gs.BitisTarihi.ToString("dd.MM.yyyy")</td>
                                    <td>@((await Istatistik.AylikBedelAsync(gs)).ToString("N0")) ₺</td>
                                    <td>
                                        @if (gFesih) { <span class="badge badge-gecmis">Feshedildi</span> }
                                        else if (gAktif) { <span class="badge badge-kirali">Aktif</span> }
                                        else { <span class="badge badge-gecmis">Geçmiş</span> }
                                    </td>
                                    <td><a href="/Sozlesme/Detay/@gs.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 4: İşlem Geçmişi -->
    <div class="tab-content">
        @if (!s.IslemGecmisi.Any())
        {
            <div class="card text-center text-muted p-8">İşlem geçmişi yok.</div>
        }
        else
        {
            <div class="card p-0 overflow-hidden">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>İşlem</th>
                                <th>Açıklama</th>
                                <th>Kira Değişimi</th>
                                <th>Süre Değişimi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var islem in s.IslemGecmisi.OrderByDescending(i => i.IslemTarihi))
                            {
                                string islemLabel = islem.IslemTipi switch {
                                    SozlesmeIslemTipi.Olusturma            => "Oluşturma",
                                    SozlesmeIslemTipi.SureUzatma           => "Süre Uzatma",
                                    SozlesmeIslemTipi.Fesih                => "Fesih",
                                    SozlesmeIslemTipi.TufeArtis            => "TÜFE Artış",
                                    SozlesmeIslemTipi.KdvGuncelleme        => "KDV Güncelleme",
                                    SozlesmeIslemTipi.TahakkukYenidenUretim => "Tahakkuk Yeniden Üretim",
                                    _ => islem.IslemTipi.ToString()
                                };
                                string islemBadgeCls = islem.IslemTipi switch {
                                    SozlesmeIslemTipi.Olusturma             => "badge-kirali",
                                    SozlesmeIslemTipi.SureUzatma            => "badge-surek",
                                    SozlesmeIslemTipi.Fesih                 => "badge-gecmis",
                                    SozlesmeIslemTipi.TahakkukYenidenUretim => "badge-surek",
                                    _ => "badge-bos"
                                };
                                <tr>
                                    <td class="text-[13px] whitespace-nowrap">@islem.IslemTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="badge @islemBadgeCls">@islemLabel</span></td>
                                    <td class="text-[13px] text-muted">@islem.Aciklama</td>
                                    <td class="text-[13px]">
                                        @if (islem.EskiKiraBedeli.HasValue && islem.YeniKiraBedeli.HasValue)
                                        {
                                            <span>@islem.EskiKiraBedeli.Value.ToString("N0") ₺ → @islem.YeniKiraBedeli.Value.ToString("N0") ₺</span>
                                        }
                                        else if (islem.YeniKiraBedeli.HasValue)
                                        {
                                            <span>@islem.YeniKiraBedeli.Value.ToString("N0") ₺</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-[13px]">
                                        @if (islem.EskiBitisTarihi.HasValue && islem.YeniBitisTarihi.HasValue)
                                        {
                                            <span>@islem.EskiBitisTarihi.Value.ToString("dd.MM.yyyy") → @islem.YeniBitisTarihi.Value.ToString("dd.MM.yyyy")</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 5: Ödemeler (tahakkuk özeti) -->
    @if (Model.HasOdemeAccess)
    {
        <div class="tab-content">
        @if (!Model.Tahakkuklar.Any())
        {
            <div class="card text-center text-muted p-8">
                Bu sözleşme için henüz tahakkuk oluşturulmamış.
            </div>
        }
        else
        {
            decimal toplamBeklenen = Model.Tahakkuklar.Sum(t => t.ToplamTutar);
            decimal toplamOdenen   = Model.Tahakkuklar.Sum(t => t.OdenenTutar);
            decimal toplamKalan    = toplamBeklenen - toplamOdenen;
            int gecikmisSayisi     = Model.Tahakkuklar.Count(t => t.Durum == KiraTakip.Models.TahakkukDurumu.Gecikti);
            <div class="grid grid-cols-3 gap-3 mb-4">
                <div class="card text-center">
                    <div class="text-[11.5px] font-semibold text-muted uppercase mb-1.5">Toplam Beklenen</div>
                    <div class="text-xl font-bold">@toplamBeklenen.ToString("N0") ₺</div>
                    <div class="text-[11.5px] text-muted">@Model.Tahakkuklar.Count tahakkuk</div>
                </div>
                <div class="card text-center">
                    <div class="text-[11.5px] font-semibold text-muted uppercase mb-1.5">Tahsil Edilen</div>
                    <div class="text-xl font-bold text-[#065f46]">@toplamOdenen.ToString("N0") ₺</div>
                    @{ double pct = toplamBeklenen > 0 ? (double)(toplamOdenen / toplamBeklenen * 100) : 0; }
                    <div class="text-[11.5px] text-muted">%@pct.ToString("F0")</div>
                </div>
                <div class="card text-center @(toplamKalan > 0 ? "border-l-3 border-l-[#ef4444]" : "")">
                    <div class="text-[11.5px] font-semibold text-muted uppercase mb-1.5">Kalan / Gecikmiş</div>
                    <div class="text-xl font-bold @(toplamKalan > 0 ? "text-[#ef4444]" : "text-[#065f46]")">@toplamKalan.ToString("N0") ₺</div>
                    <div class="text-[11.5px] text-muted">@(gecikmisSayisi > 0 ? $"{gecikmisSayisi} gecikmiş" : "Gecikme yok")</div>
                </div>
            </div>

            <div class="card p-0 overflow-hidden">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Dönem</th>
                                <th>Vade</th>
                                <th>Beklenen</th>
                                <th>Ödenen</th>
                                <th>Durum</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody x-data="{ open: {} }">
                            @foreach (var t in Model.Tahakkuklar.OrderByDescending(x => x.DonemBaslangic))
                            {
                                string tDurumCls = t.Durum switch {
                                    KiraTakip.Models.TahakkukDurumu.TamOdendi    => "badge-kirali",
                                    KiraTakip.Models.TahakkukDurumu.KismenOdendi => "badge-surek",
                                    KiraTakip.Models.TahakkukDurumu.Gecikti      => "badge-gecmis",
                                    _                                              => "badge-bos"
                                };
                                string tDurumLabel = t.Durum switch {
                                    KiraTakip.Models.TahakkukDurumu.TamOdendi    => "Tam Ödendi",
                                    KiraTakip.Models.TahakkukDurumu.KismenOdendi => "Kısmi",
                                    KiraTakip.Models.TahakkukDurumu.Gecikti      => "Gecikti",
                                    _                                              => "Bekleniyor"
                                };
                                <tr @@click="open[@t.Id] = !open[@t.Id]" class="cursor-pointer">
                                    <td class="font-semibold">
                                        <svg x-show="open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1 inline-block align-middle"><polyline points="18 15 12 9 6 15"/></svg>
                                        <svg x-show="!open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1 inline-block align-middle"><polyline points="6 9 12 15 18 9"/></svg>
                                        @t.DonemBaslangic.ToString("MMMM yyyy")
                                    </td>
                                    <td class="text-[13px]">@t.VadeTarihi.ToString("dd.MM.yyyy")</td>
                                    <td class="font-semibold">@t.ToplamTutar.ToString("N0") ₺</td>
                                    <td class="text-[#065f46]">@t.OdenenTutar.ToString("N0") ₺</td>
                                    <td><span class="badge @tDurumCls">@tDurumLabel</span></td>
                                    <td @@click.stop="">
                                        <a href="/Odeme?tahakkukId=@t.Id" class="btn btn-sm btn-secondary">Ödemeler</a>
                                    </td>
                                </tr>
                                <tr x-show="open[@t.Id]" x-cloak class="bg-[#f7f8fb]">
                                    <td colspan="6" class="p-5 pb-3.5 px-5">
                                        @if (t.Kalemler.Any())
                                        {
                                            <div class="text-[11.5px] font-bold text-muted uppercase tracking-wider mb-2">Kalem Dökümü</div>
                                            <table class="w-full border-collapse text-[13px]">
                                                <thead>
                                                    <tr class="text-muted text-[11.5px] font-semibold uppercase tracking-wider">
                                                        <th class="px-2 py-1 text-left font-semibold">Kod</th>
                                                        <th class="px-2 py-1 text-left font-semibold">Açıklama</th>
                                                        <th class="px-2 py-1 text-right font-semibold">Birim Değer</th>
                                                        <th class="px-2 py-1 text-right font-semibold">Çarpan</th>
                                                        <th class="px-2 py-1 text-right font-semibold">Tutar</th>
                                                        <th class="px-2 py-1 text-right font-semibold">KDV</th>
                                                        <th class="px-2 py-1 text-right font-semibold">Toplam</th>
                                                        <th class="px-2 py-1 text-center font-semibold">Kaynak</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var k in t.Kalemler.OrderBy(k => k.BorcTipi.Sira))
                                                    {
                                                        string kaynakCls = k.KaynakTipi switch {
                                                            KalemKaynakTipi.TanimsizTarife    => "badge-bos",
                                                            KalemKaynakTipi.SozlesmeTarifesi  => "badge-surek",
                                                            KalemKaynakTipi.BirimTarifesi     => "badge-kirali",
                                                            KalemKaynakTipi.TasinmazTarifesi  => "badge-bireysel",
                                                            KalemKaynakTipi.GenelTarife       => "badge-bos",
                                                            KalemKaynakTipi.ManuelGiris       => "badge-surek",
                                                            KalemKaynakTipi.RezervasyonKurali => "badge-bireysel",
                                                            _                                 => "badge-bos"
                                                        };
                                                        string kaynakLabel = k.KaynakTipi switch {
                                                            KalemKaynakTipi.TanimsizTarife    => "Tanımsız Tarife",
                                                            KalemKaynakTipi.SozlesmeTarifesi  => "Sözleşme Tarifesi",
                                                            KalemKaynakTipi.BirimTarifesi     => "Birim Tarifesi",
                                                            KalemKaynakTipi.TasinmazTarifesi  => "Taşınmaz Tarifesi",
                                                            KalemKaynakTipi.GenelTarife       => "Genel Tarife",
                                                            KalemKaynakTipi.ManuelGiris       => "Manuel Giriş",
                                                            KalemKaynakTipi.RezervasyonKurali => "Rezervasyon Kuralı",
                                                            _                                 => "Bilinmiyor"
                                                        };
                                                        <tr class="border-t border-[var(--color-border)]">
                                                            <td class="px-2 py-1.5 font-mono font-bold text-xs">@k.BorcTipi.Kod</td>
                                                            <td class="px-2 py-1.5">@k.Aciklama</td>
                                                            <td class="px-2 py-1.5 text-right">@k.BirimDeger.ToString("N2") ₺@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "/m²" : "")</td>
                                                            <td class="px-2 py-1.5 text-right text-muted">@k.Carpan.ToString("F2")</td>
                                                            <td class="px-2 py-1.5 text-right font-semibold">@k.Tutar.ToString("N2") ₺</td>
                                                            <td class="px-2 py-1.5 text-right text-muted">@k.KdvTutari.ToString("N2") ₺</td>
                                                            <td class="px-2 py-1.5 text-right font-bold">@k.ToplamTutar.ToString("N2") ₺</td>
                                                            <td class="px-2 py-1.5 text-center"><span class="badge @kaynakCls text-[11px]">@kaynakLabel</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr class="border-t-2 border-[var(--color-border)] bg-[#eef0f4]">
                                                        <td colspan="6" class="px-2 py-1.5 font-bold text-xs">Toplam</td>
                                                        <td class="px-2 py-1.5 text-right font-bold">@t.ToplamTutar.ToString("N2") ₺</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-muted">Kalem bilgisi yok (eski tahakkuk).</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        </div>
    }

</div><!-- /#sozlesme-tabs -->

<!-- MODAL: Sözleşmeyi Uzat -->
<div x-show="showUzat" x-cloak
    class="fixed inset-0 bg-black/45 z-[1000] flex items-center justify-center p-5"
    @@click.self="showUzat = false">
    <div class="bg-white rounded-2xl w-full max-w-[520px] p-7 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-5">
            <div class="text-lg font-bold">Sözleşmeyi Uzat</div>
            <button @@click="showUzat = false" class="bg-none border-none cursor-pointer text-xl text-muted">✕</button>
        </div>

        <div class="bg-[#f7f8fa] rounded-lg px-3.5 py-2.5 mb-4.5 text-[13px]">
            Mevcut bitiş: <strong>@s.BitisTarihi.ToString("dd.MM.yyyy")</strong> •
            Mevcut kira: <strong>@TLFormat(aylikBedel)</strong>
        </div>

        <form method="post" action="/Sozlesme/Uzat/@s.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SozlesmeId" value="@s.Id" />

            <div class="form-group">
                <label class="form-label">Yeni Bitiş Tarihi *</label>
                <input type="date" name="YeniBitisTarihi" class="form-control"
                    value="@s.BitisTarihi.AddYears(1).ToString("yyyy-MM-dd")" required />
            </div>

            <!-- TÜFE bölümü -->
            <div class="form-group">
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                    <input type="checkbox" name="TufeUygulanacakMi" value="true"
                        x-model="tufeEnabled" @@change="applyTufe()"
                        class="w-4 h-4 cursor-pointer" />
                    TÜFE Artışı Uygula
                </label>
            </div>
            <div x-show="tufeEnabled" x-cloak class="bg-[#fffbeb] border border-[#fde68a] rounded-lg p-3.5 mb-3.5">
                <div class="form-group mb-2.5">
                    <label class="form-label">TÜFE Oranı (%)</label>
                    <input type="number" name="TufeOrani" step="0.01" min="0" class="form-control"
                        x-model="tufeOrani" @@change="applyTufe()" placeholder="Örn: 25" />
                </div>
                <div class="text-[13px] flex flex-col gap-1">
                    <div>Artış tutarı: <strong x-text="formatTl(tufeArtisTutari)"></strong></div>
                    <div>TÜFE sonrası kira: <strong x-text="formatTl(tufeSonrasiBedel)"></strong></div>
                </div>
            </div>

            <!-- KDV bölümü -->
            <div class="form-group">
                <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                    <input type="checkbox" name="KdvUygulanacakMi" value="true"
                        x-model="kdvEnabled"
                        class="w-4 h-4 cursor-pointer" />
                    KDV Uygula
                </label>
            </div>
            <div x-show="kdvEnabled" x-cloak class="bg-[#f0f9ff] border border-[#bae6fd] rounded-lg p-3.5 mb-3.5">
                <div class="form-group mb-2.5">
                    <label class="form-label">KDV Oranı (%)</label>
                    <input type="number" name="KdvOrani" step="0.01" min="0" max="100" class="form-control"
                        x-model="kdvOrani" value="20" />
                </div>
                <div class="text-[13px] flex flex-col gap-1">
                    <div>KDV Tutarı: <strong x-text="formatTl(kdvTutari)"></strong></div>
                    <div>KDV Dahil Toplam: <strong x-text="formatTl(kdvDahilToplam)"></strong></div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama</label>
                <textarea name="Aciklama" class="form-control" rows="2" placeholder="Opsiyonel açıklama"></textarea>
            </div>

            @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Sozlesme.OverrideRate) || User.IsInRole(RoleNames.Admin))
            {
                <div class="form-group mt-3">
                    <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                        <input type="checkbox" x-model="tarifeUzat"
                               @@change="if(tarifeUzat) fetchTarifeKalemler('uzat')"
                               class="w-4 h-4 cursor-pointer" />
                        Tarifeyi de güncelle
                    </label>
                </div>
                <div x-show="tarifeUzat" x-cloak class="border border-[var(--color-border)] rounded-lg p-3.5 mb-3.5">
                    <div class="text-xs text-muted mb-2.5">Yalnızca değiştirdiğiniz kalemler SözleşmeTarife olarak yazılır.</div>
                    <template x-for="(k, i) in uzatKalemler" :key="k.borcTipiId">
                        <div class="grid grid-cols-[1fr_110px_1fr_80px] gap-2 items-end mb-2">
                            <div class="text-[13px] font-medium self-center" x-text="k.borcTipiAd"></div>
                            <div>
                                <label class="form-label text-[11px] mb-[3px]">Yöntem</label>
                                <select class="form-control form-control-sm" x-model.number="k.hesaplamaYontemi"
                                        @@change="k.kullaniciDegistirdiMi = true">
                                    <option value="1">Sabit</option>
                                    <option value="2" :disabled="birimYuzolcumu === 0">m²</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label text-[11px] mb-[3px]">
                                    <span x-show="k.hesaplamaYontemi != 2">Tutar (₺)</span>
                                    <span x-show="k.hesaplamaYontemi == 2">₺ / m²</span>
                                </label>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       x-model.number="k.birimDeger"
                                       @@input="k.kullaniciDegistirdiMi = true">
                            </div>
                            <div>
                                <label class="form-label text-[11px] mb-[3px]">KDV (%)</label>
                                <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm"
                                       x-model.number="k.kdvOrani"
                                       @@input="k.kullaniciDegistirdiMi = true"
                                       :name="`SozlesmeKalemleri[${i}].KdvOrani`">
                            </div>
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].BorcTipiId`" :value="k.borcTipiId">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].BirimDeger`" :value="k.birimDeger">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].HesaplamaYontemi`" :value="k.hesaplamaYontemi">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].Tutar`" :value="hesaplaPopupTutar(k)">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].KullaniciDegistirdiMi`" :value="k.kullaniciDegistirdiMi">
                        </div>
                    </template>
                    <input type="hidden" name="TarifeyiGuncelle" :value="tarifeUzat">
                </div>
            }

            <div class="flex gap-2.5 mt-1">
                <button type="submit" class="btn btn-primary">Uzat</button>
                <button type="button" class="btn btn-secondary" @@click="showUzat = false">İptal</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Sözleşmeyi Feshet -->
<div x-show="showFesih" x-cloak
    class="fixed inset-0 bg-black/45 z-[1000] flex items-center justify-center p-5"
    @@click.self="showFesih = false">
    <div class="bg-white rounded-2xl w-full max-w-[460px] p-7">
        <div class="flex justify-between items-center mb-5">
            <div class="text-lg font-bold text-[#dc2626]">Sözleşmeyi Feshet</div>
            <button @@click="showFesih = false" class="bg-none border-none cursor-pointer text-xl text-muted">✕</button>
        </div>

        <div class="alert-danger mb-4.5 text-[13px]">
            Bu işlem geri alınamaz. Feshedilen sözleşme aktif gelir hesaplarına dahil edilmez ve birim yeniden kiralanabilir hale gelir.
        </div>

        <form method="post" action="/Sozlesme/Feshet/@s.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SozlesmeId" value="@s.Id" />

            <div class="form-group">
                <label class="form-label">Fesih Tarihi *</label>
                <input type="date" name="FesihTarihi" class="form-control"
                    value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-group">
                <label class="form-label">Fesih Nedeni *</label>
                <input type="text" name="FesihNedeni" class="form-control"
                    placeholder="Örn: Kiracı tarafından erken fesih" required />
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama</label>
                <textarea name="Aciklama" class="form-control" rows="2" placeholder="Opsiyonel ek not"></textarea>
            </div>

            <div class="flex gap-2.5 mt-1">
                <button type="submit" class="btn btn-danger">Feshet</button>
                <button type="button" class="btn btn-secondary" @@click="showFesih = false">İptal</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Tahakkuk Yeniden Üret -->
<div x-show="showYenidenUret" x-cloak
    class="fixed inset-0 bg-black/45 z-[1000] flex items-center justify-center p-5"
    @@click.self="showYenidenUret = false">
    <div class="bg-white rounded-2xl w-full max-w-[480px] p-7">
        <div class="flex justify-between items-center mb-5">
            <div class="text-lg font-bold">Tahakkuk Yeniden Üret</div>
            <button @@click="showYenidenUret = false" class="bg-none border-none cursor-pointer text-xl text-muted">✕</button>
        </div>

        <div class="bg-[#fffbeb] border border-[#fde68a] rounded-lg px-3.5 py-2.5 mb-4.5 text-[13px] text-[#92400e]">
            Seçilen tarihten itibaren <strong>ödeme alınmamış</strong> tahakkuklar silinip yeniden üretilir. Ödeme kaydı olan tahakkuklara dokunulmaz.
        </div>

        <form method="post" action="/Sozlesme/YenidenUret/@s.Id">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Başlangıç Tarihi *</label>
                <input type="date" name="baslangicTarihi" class="form-control"
                    value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                <div class="form-hint">Bu tarihten (dahil) itibaren ödenmemiş tahakkuklar etkilenir.</div>
            </div>

            @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Sozlesme.OverrideRate) || User.IsInRole(RoleNames.Admin))
            {
                <div class="form-group mt-3">
                    <label class="flex items-center gap-2 cursor-pointer text-sm font-medium">
                        <input type="checkbox" x-model="tarifeYenidenUret"
                               @@change="if(tarifeYenidenUret) fetchTarifeKalemler('yenidenUret')"
                               class="w-4 h-4 cursor-pointer" />
                        Tarifeyi de güncelle
                    </label>
                </div>
                <div x-show="tarifeYenidenUret" x-cloak class="border border-[var(--color-border)] rounded-lg p-3.5 mb-3.5">
                    <div class="text-xs text-muted mb-2.5">Yalnızca değiştirdiğiniz kalemler SözleşmeTarife olarak yazılır.</div>
                    <template x-for="(k, i) in yenidenUretKalemler" :key="k.borcTipiId">
                        <div class="grid grid-cols-[1fr_110px_1fr_80px] gap-2 items-end mb-2">
                            <div class="text-[13px] font-medium self-center" x-text="k.borcTipiAd"></div>
                            <div>
                                <label class="form-label text-[11px] mb-[3px]">Yöntem</label>
                                <select class="form-control form-control-sm" x-model.number="k.hesaplamaYontemi"
                                        @@change="k.kullaniciDegistirdiMi = true">
                                    <option value="1">Sabit</option>
                                    <option value="2" :disabled="birimYuzolcumu === 0">m²</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label text-[11px] mb-[3px]">
                                    <span x-show="k.hesaplamaYontemi != 2">Tutar (₺)</span>
                                    <span x-show="k.hesaplamaYontemi == 2">₺ / m²</span>
                                </label>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       x-model.number="k.birimDeger"
                                       @@input="k.kullaniciDegistirdiMi = true">
                            </div>
                            <div>
                                <label class="form-label text-[11px] mb-[3px]">KDV (%)</label>
                                <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm"
                                       x-model.number="k.kdvOrani"
                                       @@input="k.kullaniciDegistirdiMi = true"
                                       :name="`sozlesmeKalemleri[${i}].KdvOrani`">
                            </div>
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].BorcTipiId`" :value="k.borcTipiId">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].BirimDeger`" :value="k.birimDeger">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].HesaplamaYontemi`" :value="k.hesaplamaYontemi">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].Tutar`" :value="hesaplaPopupTutar(k)">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].KullaniciDegistirdiMi`" :value="k.kullaniciDegistirdiMi">
                        </div>
                    </template>
                    <input type="hidden" name="tarifeyiGuncelle" :value="tarifeYenidenUret">
                </div>
            }

            <div class="flex gap-2.5 mt-1">
                <button type="submit" class="btn btn-primary">Yeniden Üret</button>
                <button type="button" class="btn btn-secondary" @@click="showYenidenUret = false">İptal</button>
            </div>
        </form>
    </div>
</div>

</div><!-- /x-data -->

@section Scripts {
    <script>initTabs('sozlesme-tabs');</script>
}
