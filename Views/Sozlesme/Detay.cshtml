@model KiraTakip.Models.ViewModels.SozlesmeDetayViewModel
@using KiraTakip.Models
@using KiraTakip.Services.Interfaces
@using KiraTakip.Authorization
@using System.Globalization
@inject IIstatistikService Istatistik
@{
    ViewData["Title"] = $"Sözleşme #{Model.Sozlesme.Id}";
    var s = Model.Sozlesme;
    var kiraci = s.Kiraci;
    var birim = s.Birim;
    var tasinmaz = birim.Tasinmaz;
    var trCulture = new CultureInfo("tr-TR");

    bool feshedildi = s.Durum == SozlesmeDurumu.Feshedildi;
    bool sonaErdi = s.Durum == SozlesmeDurumu.SonaErdi;

    string sozlesmeDurumBadgeCls = s.Durum switch {
        SozlesmeDurumu.Feshedildi => "badge-gecmis",
        SozlesmeDurumu.SonaErdi   => "badge-bos",
        _                          => Model.Durum == KiraDurumu.SuresiDolmakUzere ? "badge-surek" : "badge-kirali"
    };
    string sozlesmeDurumLabel = s.Durum switch {
        SozlesmeDurumu.Feshedildi => "Feshedildi",
        SozlesmeDurumu.SonaErdi   => "Sona Erdi",
        _                          => Model.Durum == KiraDurumu.SuresiDolmakUzere ? "Süresi Dolmak Üzere" : "Aktif"
    };

    string gunBadgeCls = Model.KalanGun <= 10 ? "day-badge-red" : Model.KalanGun <= 30 ? "day-badge-amber" : "day-badge-green";
    string gunMesaj = feshedildi ? "Sözleşme feshedildi." : Model.KalanGun <= 0 ? "Sözleşme sona erdi." : Model.KalanGun <= 30 ? "Süresi dolmak üzere!" : "Sözleşme aktif.";

    string TLFormat(decimal v) => v.ToString("N2") + " ₺";
    bool canEdit = User.HasClaim("permission", "Sozlesme.Extend") || User.HasClaim("permission", "Sozlesme.Terminate");
    bool canRegenerate = User.HasClaim("permission", "Tahakkuk.Regenerate");

    decimal aylikBedel = Model.AylikBedel;
    decimal kdvTutari = s.KdvUygulanacakMi ? aylikBedel * s.KdvOrani / 100 : 0;
    decimal kdvDahilToplam = aylikBedel + kdvTutari;
    decimal aylikKdv = s.KdvUygulanacakMi ? aylikBedel * s.KdvOrani / 100 : 0;
}

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">✕ @TempData["Error"]</div>
}

@if (feshedildi)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">
        Bu sözleşme <strong>@s.FesihTarihi?.ToString("dd.MM.yyyy")</strong> tarihinde feshedildi.
        @if (!string.IsNullOrEmpty(s.FesihNedeni)) { <span> Neden: @s.FesihNedeni</span> }
    </div>
}

<div x-data="{
    showUzat: false,
    showFesih: false,
    showYenidenUret: false,
    tufeEnabled: false,
    birimYuzolcumu: @s.Birim.Yuzolcumu.ToString(System.Globalization.CultureInfo.InvariantCulture),
    sozlesmeBirimId: @s.BirimId,
    sozlesmeKiraciId: @s.KiraciId,
    sozlesmeId: @s.Id,
    tarifeYenidenUret: false,
    yenidenUretKalemler: [],
    yenidenUretKalemlerYuklendi: false,
    tarifeUzat: false,
    uzatKalemler: [],
    uzatKalemlerYuklendi: false,
    async fetchTarifeKalemler(hedef) {
        const yuklendi = hedef === 'yenidenUret' ? 'yenidenUretKalemlerYuklendi' : 'uzatKalemlerYuklendi';
        const kalemler = hedef === 'yenidenUret' ? 'yenidenUretKalemler' : 'uzatKalemler';
        if (this[yuklendi]) return;
        const res = await fetch(`/Sozlesme/GetVarsayilanKalemler?birimId=${this.sozlesmeBirimId}&kiraciId=${this.sozlesmeKiraciId}&baslangic=@DateTime.Today.ToString("yyyy-MM-dd")&sozlesmeId=${this.sozlesmeId}`);
        const data = await res.json();
        this[kalemler] = data.map(k => ({ ...k, originalBirimDeger: k.birimDeger, varsayilanHesaplamaYontemi: k.hesaplamaYontemi, _error: null }));
        this[yuklendi] = true;
    },
    hesaplaPopupTutar(k) {
        return k.hesaplamaYontemi == 2 ? k.birimDeger * this.birimYuzolcumu : k.birimDeger;
    },
    kdvEnabled: @(s.KdvUygulanacakMi ? "true" : "false"),
    tufeOrani: 25,
    kdvOrani: @s.KdvOrani.ToString(CultureInfo.InvariantCulture),
    currentBedel: @aylikBedel.ToString(CultureInfo.InvariantCulture),
    yeniKiraBedeli: @aylikBedel.ToString(CultureInfo.InvariantCulture),
    get tufeArtisTutari() { return this.tufeEnabled ? Math.round(this.currentBedel * this.tufeOrani / 100) : 0; },
    get tufeSonrasiBedel() { return this.currentBedel + this.tufeArtisTutari; },
    get kdvTutari() { return this.kdvEnabled ? Math.round(this.yeniKiraBedeli * this.kdvOrani / 100) : 0; },
    get kdvDahilToplam() { return this.yeniKiraBedeli + this.kdvTutari; },
    formatTl(v) { return new Intl.NumberFormat('tr-TR').format(v) + ' ₺'; },
    async applyTufe() {
        await this.fetchTarifeKalemler('uzat');
        if (this.tufeEnabled) {
            this.tarifeUzat = true;
            const oran = this.tufeOrani / 100;
            this.uzatKalemler.forEach(k => {
                k.birimDeger = Math.round(k.originalBirimDeger * (1 + oran) * 100) / 100;
                k.kullaniciDegistirdiMi = true;
            });
            this.yeniKiraBedeli = this.tufeSonrasiBedel;
        } else {
            this.uzatKalemler.forEach(k => {
                k.birimDeger = k.originalBirimDeger;
                k.kullaniciDegistirdiMi = false;
            });
            this.yeniKiraBedeli = this.currentBedel;
        }
    }
}">

<!-- Breadcrumb + Butonlar -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <a href="/Sozlesme" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;">← Sözleşmeler</a>
    <div style="display:flex;gap:10px;">
        @if (canRegenerate && !feshedildi)
        {
            <button class="btn btn-secondary" type="button" @@click="showYenidenUret = true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.43"/></svg>
                Tahakkuk Yeniden Üret
            </button>
        }
        @if (canEdit && !feshedildi)
        {
            <button class="btn btn-amber" type="button" @@click="showUzat = true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                Sözleşmeyi Uzat
            </button>
            <button class="btn btn-danger" type="button" @@click="showFesih = true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Sözleşmeyi Feshet
            </button>
        }
    </div>
</div>

<!-- Ana Kart -->
<div class="card" style="margin-bottom:16px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">
        <!-- Sol: Kiracı -->
        <div>
            <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;">Kiracı</div>
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                <div style="width:48px;height:48px;border-radius:50%;background:var(--color-primary);color:white;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:700;flex-shrink:0;">
                    @(kiraci.GosterimAdi.Split(' ').Where(p => p.Length > 0).Take(2).Select(p => p[0].ToString().ToUpper()).Aggregate("", (a, b) => a + b))
                </div>
                <div>
                    <div style="font-family:'Fraunces',Georgia,serif;font-size:22px;font-weight:700;line-height:1.1;">@kiraci.GosterimAdi</div>
                    <div style="margin-top:5px;display:flex;gap:6px;align-items:center;">
                        @if (kiraci.KiraciTuru == KiraciTuru.Tuzel)
                        { <span class="badge badge-kurumsal">Tüzel Kişi</span> }
                        else
                        { <span class="badge badge-bireysel">Gerçek Kişi</span> }
                        @if (kiraci.KiraciKategori != null)
                        {
                            <span class="badge badge-bos">@kiraci.KiraciKategori.Ad</span>
                        }
                    </div>
                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-muted);flex-shrink:0;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.61 4.59 2 2 0 0 1 3.58 2.41h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.52 17z"/></svg>
                    @kiraci.Telefon
                </div>
                <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-muted);flex-shrink:0;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    @kiraci.Email
                </div>
            </div>
            <div style="margin-top:12px;">
                <a href="/Kiraci/Detay/@kiraci.Id" class="btn btn-sm btn-secondary">Kiracı Profili</a>
            </div>
        </div>

        <!-- Sağ: Taşınmaz + Sözleşme Durumu -->
        <div style="text-align:right;">
            <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;">Taşınmaz</div>
            <div style="font-family:'Fraunces',Georgia,serif;font-size:20px;font-weight:700;margin-bottom:4px;">@tasinmaz.Ad</div>
            @if (birim.BirimTipi == BirimTipi.Birim)
            {
                <div style="font-size:14px;color:var(--color-muted);margin-bottom:4px;">Birim @birim.BirimNo@(birim.KatNo.HasValue ? $" • {birim.KatNo}. Kat" : "") • @birim.Yuzolcumu.ToString("N0") m²</div>
                <div style="font-size:13px;color:var(--color-muted);margin-bottom:10px;">@tasinmaz.Ilce, @tasinmaz.Il</div>
            }
            else
            {
                <div style="font-size:14px;color:var(--color-muted);margin-bottom:10px;">@birim.Ad • @tasinmaz.Ilce, @tasinmaz.Il</div>
            }
            <div style="margin-bottom:12px;">
                <span class="badge @sozlesmeDurumBadgeCls" style="font-size:12.5px;padding:5px 14px;">@sozlesmeDurumLabel</span>
            </div>
            <a href="/Tasinmaz/Detay/@tasinmaz.Id" class="btn btn-sm btn-secondary">Taşınmaz Detayı</a>
        </div>
    </div>
</div>

<!-- 3 Kolonlu Özet -->
<div class="three-col" style="margin-bottom:16px;">
    <!-- Kira Bedeli -->
    <div class="card">
        <div class="card-title">Kira Bedeli</div>
        <div style="margin-top:10px;">
            <div style="font-size:12px;color:var(--color-muted);margin-bottom:2px;">Aylık (KDV Hariç)</div>
            <div style="font-family:'Fraunces',Georgia,serif;font-size:26px;font-weight:700;color:var(--color-primary);">@TLFormat(aylikBedel)</div>
        </div>
        @if (s.KdvUygulanacakMi)
        {
            <div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--color-border);">
                <div style="font-size:11.5px;color:var(--color-muted);margin-bottom:2px;">KDV (%@s.KdvOrani.ToString("G"))</div>
                <div style="font-size:14px;font-weight:600;">+ @TLFormat(aylikKdv)</div>
                <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">KDV Dahil: <strong>@TLFormat(aylikBedel + aylikKdv)</strong></div>
            </div>
        }
        <div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--color-border);">
            <div style="font-size:11.5px;color:var(--color-muted);margin-bottom:2px;">Yıllık</div>
            <div style="font-size:16px;font-weight:700;">@TLFormat(Model.YillikBedel)</div>
        </div>
        <div style="margin-top:6px;font-size:11.5px;color:var(--color-muted);">
            Tam ay üzerinden
        </div>
    </div>

    <!-- Sözleşme Süresi -->
    <div class="card">
        <div class="card-title">Sözleşme Süresi</div>
        <div style="margin-top:10px;display:flex;align-items:center;gap:8px;font-size:13px;font-weight:500;">
            <span>@s.BaslangicTarihi.ToString("dd.MM.yyyy")</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-muted);flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <span>@s.BitisTarihi.ToString("dd.MM.yyyy")</span>
        </div>
        <div style="margin-top:14px;">
            <div style="display:flex;justify-content:space-between;font-size:11.5px;color:var(--color-muted);margin-bottom:5px;">
                <span>Geçen süre</span>
                <span>%@Model.SureYuzdesi.ToString("F0")</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill @(Model.SureYuzdesi > 85 ? "progress-fill-amber" : "")" style="width:@Model.SureYuzdesi.ToString("F0")%;"></div>
            </div>
        </div>
        <div style="margin-top:10px;font-size:12px;color:var(--color-muted);">
            Toplam @((int)(s.BitisTarihi - s.BaslangicTarihi).TotalDays) gün
        </div>
    </div>

    <!-- Kalan Gün -->
    <div class="card" style="text-align:center;">
        <div class="card-title" style="text-align:center;">Kalan Gün</div>
        <div style="margin-top:14px;">
            <div style="font-family:'Fraunces',Georgia,serif;font-size:52px;font-weight:700;line-height:1;
                color:@(feshedildi ? "#dc2626" : Model.KalanGun <= 10 ? "#dc2626" : Model.KalanGun <= 30 ? "#b45309" : "var(--color-primary)");">
                @(feshedildi ? "—" : Math.Max(0, Model.KalanGun).ToString())
            </div>
            <div style="font-size:13px;color:var(--color-muted);margin-top:4px;">@(feshedildi ? "" : "gün kaldı")</div>
        </div>
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--color-border);">
            <span style="font-size:13px;font-weight:600;color:@(feshedildi || Model.KalanGun <= 0 ? "#dc2626" : Model.KalanGun <= 30 ? "#b45309" : "#065f46");">
                @gunMesaj
            </span>
        </div>
    </div>
</div>

<!-- Aylık Tahakkuk Kalemleri -->
@if (Model.GuncelKalemler.Any())
{
    <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
            <div>
                <span style="font-size:12px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;">Aylık Tahakkuk Kalemleri</span>
                @if (Model.GuncelKalemDonemi.HasValue)
                {
                    <span style="font-size:12px;color:var(--color-muted);margin-left:8px;">— @Model.GuncelKalemDonemi.Value.ToString("MMMM yyyy", trCulture)</span>
                }
                <div style="font-size:11.5px;color:var(--color-muted);margin-top:2px;">İlk/son ay kıst uygulanır</div>
            </div>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Kalem</th>
                        <th>Yöntem</th>
                        <th style="text-align:right;">Birim Değer</th>
                        <th style="text-align:right;">Çarpan</th>
                        <th style="text-align:right;">Net Tutar</th>
                        <th style="text-align:right;">KDV</th>
                        <th style="text-align:right;">Toplam</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.GuncelKalemler)
                    {
                        <tr>
                            <td>
                                <span style="font-family:'JetBrains Mono',monospace;font-size:11px;background:#f1f5f9;padding:2px 7px;border-radius:4px;color:#475569;">@k.BorcTipi.Kod</span>
                                <span style="font-weight:500;margin-left:6px;font-size:13.5px;">@k.BorcTipi.Ad</span>
                            </td>
                            <td style="font-size:12.5px;color:var(--color-muted);">@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "m²" : "Sabit")</td>
                            <td style="text-align:right;font-size:13px;">@k.BirimDeger.ToString("N2") ₺</td>
                            <td style="text-align:right;font-size:13px;color:var(--color-muted);">
                                @if (k.Carpan == 1m) { <span>—</span> }
                                else { <span>× @k.Carpan.ToString("F2")</span> }
                            </td>
                            <td style="text-align:right;font-weight:600;">@k.Tutar.ToString("N2") ₺</td>
                            <td style="text-align:right;font-size:13px;color:var(--color-muted);">
                                @if (k.KdvOrani > 0) { <span>%@k.KdvOrani.ToString("G") → @k.KdvTutari.ToString("N2") ₺</span> }
                                else { <span>—</span> }
                            </td>
                            <td style="text-align:right;font-weight:700;color:var(--color-primary);">@k.ToplamTutar.ToString("N2") ₺</td>
                        </tr>
                    }
                    <tr style="background:#fafbfc;border-top:2px solid var(--color-border);">
                        <td colspan="4" style="font-weight:600;text-align:right;font-size:13px;padding-right:16px;color:var(--color-muted);">Toplam</td>
                        <td style="text-align:right;font-weight:700;">@Model.GuncelKalemler.Sum(k => k.Tutar).ToString("N2") ₺</td>
                        <td style="text-align:right;font-weight:600;font-size:13px;">@Model.GuncelKalemler.Sum(k => k.KdvTutari).ToString("N2") ₺</td>
                        <td style="text-align:right;font-weight:700;color:var(--color-primary);font-size:15px;">@Model.GuncelKalemler.Sum(k => k.ToplamTutar).ToString("N2") ₺</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Alt Tab'lı Bölüm -->
<div id="sozlesme-tabs">
    <div class="tabs">
        <button class="tab">Detaylar</button>
        <button class="tab">Birim Bilgisi</button>
        <button class="tab">Geçmiş Sözleşmeler (@Model.GecmisSozlesmeler.Count)</button>
        <button class="tab">İşlem Geçmişi (@s.IslemGecmisi.Count)</button>
        @if (Model.HasOdemeAccess)
        {
            <button class="tab">Ödemeler (@Model.Tahakkuklar.Count)</button>
        }
    </div>

    <!-- Tab 1: Detaylar -->
    <div class="tab-content">
        <div class="card">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;">
                @{
                    void Row(string label, string value) {
                        <div style="padding:12px 16px;border-bottom:1px solid var(--color-border);">
                            <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:4px;">@label</div>
                            <div style="font-size:14px;font-weight:500;">@value</div>
                        </div>
                    }
                }
                @{
                    Row("Sözleşme No", $"#{s.Id}");
                    Row("Kira Bedeli (KDV Hariç)", $"{aylikBedel.ToString("N0")} ₺ / ay");
                    Row("Depozito", s.Depozito.HasValue ? s.Depozito.Value.ToString("N0") + " ₺" : "—");
                    Row("Başlangıç", s.BaslangicTarihi.ToString("dd MMMM yyyy", trCulture));
                    Row("Bitiş", s.BitisTarihi.ToString("dd MMMM yyyy", trCulture));
                    if (s.KdvUygulanacakMi)
                    {
                        Row("KDV Oranı", "%" + s.KdvOrani.ToString("G"));
                        Row("KDV Tutarı", $"{kdvTutari.ToString("N0")} ₺ / ay");
                        Row("KDV Dahil Toplam", $"{kdvDahilToplam.ToString("N0")} ₺ / ay");
                    }
                    else
                    {
                        Row("KDV", "Uygulanmıyor");
                    }
                    if (feshedildi)
                    {
                        Row("Fesih Tarihi", s.FesihTarihi?.ToString("dd MMMM yyyy", trCulture) ?? "—");
                        Row("Fesih Nedeni", s.FesihNedeni ?? "—");
                    }
                }
            </div>
            @if (!string.IsNullOrEmpty(s.Notlar))
            {
                <div style="padding:14px 16px;background:#fafbfc;border-radius:0 0 12px 12px;">
                    <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Notlar</div>
                    <div style="font-size:14px;line-height:1.6;">@s.Notlar</div>
                </div>
            }
        </div>
    </div>

    <!-- Tab 2: Birim Bilgisi -->
    <div class="tab-content">
        <div class="card">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div>
                    <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:12px;">Birim</div>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                        <div>
                            <div style="font-size:12px;color:var(--color-muted);">Ad</div>
                            <div style="font-size:15px;font-weight:600;">@birim.Ad</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--color-muted);">Yüzölçüm</div>
                            <div style="font-size:15px;font-weight:600;">@birim.Yuzolcumu.ToString("N0") m²</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--color-muted);">Tip</div>
                            <div style="font-size:15px;font-weight:600;">
                                @if (birim.BirimTipi == BirimTipi.Birim)
                                {
                                    <span>Birim @birim.BirimNo</span>
                                    if (birim.KatNo.HasValue) { <span style="font-size:13px;font-weight:400;color:var(--color-muted);"> • @birim.KatNo. Kat</span> }
                                }
                                else { <span>Komple</span> }
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:12px;">Taşınmaz</div>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                        <div>
                            <div style="font-size:12px;color:var(--color-muted);">Ad</div>
                            <div style="font-size:15px;font-weight:600;">@tasinmaz.Ad</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--color-muted);">Konum</div>
                            <div style="font-size:15px;font-weight:600;">@tasinmaz.Mahalle, @tasinmaz.Ilce / @tasinmaz.Il</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--color-muted);">Adres</div>
                            <div style="font-size:14px;">@tasinmaz.AcikAdres</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 3: Geçmiş Sözleşmeler -->
    <div class="tab-content">
        @if (!Model.GecmisSozlesmeler.Any())
        {
            <div class="card" style="text-align:center;color:var(--color-muted);padding:32px;">Bu birime ait başka sözleşme yok.</div>
        }
        else
        {
            <div class="card" style="padding:0;overflow:hidden;">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Kiracı</th>
                                <th>Başlangıç</th>
                                <th>Bitiş</th>
                                <th>Aylık Bedel</th>
                                <th>Durum</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gs in Model.GecmisSozlesmeler)
                            {
                                bool gAktif = Istatistik.Aktif(gs);
                                bool gFesih = gs.Durum == SozlesmeDurumu.Feshedildi;
                                <tr>
                                    <td style="font-weight:600;">@gs.Kiraci.GosterimAdi</td>
                                    <td>@gs.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                                    <td>@gs.BitisTarihi.ToString("dd.MM.yyyy")</td>
                                    <td>@((await Istatistik.AylikBedelAsync(gs)).ToString("N0")) ₺</td>
                                    <td>
                                        @if (gFesih) { <span class="badge badge-gecmis">Feshedildi</span> }
                                        else if (gAktif) { <span class="badge badge-kirali">Aktif</span> }
                                        else { <span class="badge badge-gecmis">Geçmiş</span> }
                                    </td>
                                    <td><a href="/Sozlesme/Detay/@gs.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 4: İşlem Geçmişi -->
    <div class="tab-content">
        @if (!s.IslemGecmisi.Any())
        {
            <div class="card" style="text-align:center;color:var(--color-muted);padding:32px;">İşlem geçmişi yok.</div>
        }
        else
        {
            <div class="card" style="padding:0;overflow:hidden;">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>İşlem</th>
                                <th>Açıklama</th>
                                <th>Kira Değişimi</th>
                                <th>Süre Değişimi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var islem in s.IslemGecmisi.OrderByDescending(i => i.IslemTarihi))
                            {
                                string islemLabel = islem.IslemTipi switch {
                                    SozlesmeIslemTipi.Olusturma            => "Oluşturma",
                                    SozlesmeIslemTipi.SureUzatma           => "Süre Uzatma",
                                    SozlesmeIslemTipi.Fesih                => "Fesih",
                                    SozlesmeIslemTipi.TufeArtis            => "TÜFE Artış",
                                    SozlesmeIslemTipi.KdvGuncelleme        => "KDV Güncelleme",
                                    SozlesmeIslemTipi.TahakkukYenidenUretim => "Tahakkuk Yeniden Üretim",
                                    _ => islem.IslemTipi.ToString()
                                };
                                string islemBadgeCls = islem.IslemTipi switch {
                                    SozlesmeIslemTipi.Olusturma             => "badge-kirali",
                                    SozlesmeIslemTipi.SureUzatma            => "badge-surek",
                                    SozlesmeIslemTipi.Fesih                 => "badge-gecmis",
                                    SozlesmeIslemTipi.TahakkukYenidenUretim => "badge-surek",
                                    _ => "badge-bos"
                                };
                                <tr>
                                    <td style="font-size:13px;white-space:nowrap;">@islem.IslemTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="badge @islemBadgeCls">@islemLabel</span></td>
                                    <td style="font-size:13px;color:var(--color-muted);">@islem.Aciklama</td>
                                    <td style="font-size:13px;">
                                        @if (islem.EskiKiraBedeli.HasValue && islem.YeniKiraBedeli.HasValue)
                                        {
                                            <span>@islem.EskiKiraBedeli.Value.ToString("N0") ₺ → @islem.YeniKiraBedeli.Value.ToString("N0") ₺</span>
                                        }
                                        else if (islem.YeniKiraBedeli.HasValue)
                                        {
                                            <span>@islem.YeniKiraBedeli.Value.ToString("N0") ₺</span>
                                        }
                                        else { <span style="color:var(--color-muted);">—</span> }
                                    </td>
                                    <td style="font-size:13px;">
                                        @if (islem.EskiBitisTarihi.HasValue && islem.YeniBitisTarihi.HasValue)
                                        {
                                            <span>@islem.EskiBitisTarihi.Value.ToString("dd.MM.yyyy") → @islem.YeniBitisTarihi.Value.ToString("dd.MM.yyyy")</span>
                                        }
                                        else { <span style="color:var(--color-muted);">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 5: Ödemeler (tahakkuk özeti) -->
    @if (Model.HasOdemeAccess)
    {
        <div class="tab-content">
        @if (!Model.Tahakkuklar.Any())
        {
            <div class="card" style="text-align:center;color:var(--color-muted);padding:32px;">
                Bu sözleşme için henüz tahakkuk oluşturulmamış.
            </div>
        }
        else
        {
            decimal toplamBeklenen = Model.Tahakkuklar.Sum(t => t.ToplamTutar);
            decimal toplamOdenen   = Model.Tahakkuklar.Sum(t => t.OdenenTutar);
            decimal toplamKalan    = toplamBeklenen - toplamOdenen;
            int gecikmisSayisi     = Model.Tahakkuklar.Count(t => t.Durum == KiraTakip.Models.TahakkukDurumu.Gecikti);
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;">
                <div class="card" style="text-align:center;">
                    <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;margin-bottom:6px;">Toplam Beklenen</div>
                    <div style="font-size:20px;font-weight:700;">@toplamBeklenen.ToString("N0") ₺</div>
                    <div style="font-size:11.5px;color:var(--color-muted);">@Model.Tahakkuklar.Count tahakkuk</div>
                </div>
                <div class="card" style="text-align:center;">
                    <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;margin-bottom:6px;">Tahsil Edilen</div>
                    <div style="font-size:20px;font-weight:700;color:#065f46;">@toplamOdenen.ToString("N0") ₺</div>
                    @{ double pct = toplamBeklenen > 0 ? (double)(toplamOdenen / toplamBeklenen * 100) : 0; }
                    <div style="font-size:11.5px;color:var(--color-muted);">%@pct.ToString("F0")</div>
                </div>
                <div class="card" style="text-align:center;@(toplamKalan > 0 ? "border-left:3px solid #ef4444;" : "")">
                    <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;margin-bottom:6px;">Kalan / Gecikmiş</div>
                    <div style="font-size:20px;font-weight:700;color:@(toplamKalan > 0 ? "#ef4444" : "#065f46");">@toplamKalan.ToString("N0") ₺</div>
                    <div style="font-size:11.5px;color:var(--color-muted);">@(gecikmisSayisi > 0 ? $"{gecikmisSayisi} gecikmiş" : "Gecikme yok")</div>
                </div>
            </div>

            <div class="card" style="padding:0;overflow:hidden;">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Dönem</th>
                                <th>Vade</th>
                                <th>Beklenen</th>
                                <th>Ödenen</th>
                                <th>Durum</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody x-data="{ open: {} }">
                            @foreach (var t in Model.Tahakkuklar.OrderByDescending(x => x.DonemBaslangic))
                            {
                                string tDurumCls = t.Durum switch {
                                    KiraTakip.Models.TahakkukDurumu.TamOdendi    => "badge-kirali",
                                    KiraTakip.Models.TahakkukDurumu.KismenOdendi => "badge-surek",
                                    KiraTakip.Models.TahakkukDurumu.Gecikti      => "badge-gecmis",
                                    _                                              => "badge-bos"
                                };
                                string tDurumLabel = t.Durum switch {
                                    KiraTakip.Models.TahakkukDurumu.TamOdendi    => "Tam Ödendi",
                                    KiraTakip.Models.TahakkukDurumu.KismenOdendi => "Kısmi",
                                    KiraTakip.Models.TahakkukDurumu.Gecikti      => "Gecikti",
                                    _                                              => "Bekleniyor"
                                };
                                <tr @@click="open[@t.Id] = !open[@t.Id]" style="cursor:pointer;">
                                    <td style="font-weight:600;">
                                        <svg x-show="open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px;vertical-align:middle;"><polyline points="18 15 12 9 6 15"/></svg>
                                        <svg x-show="!open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px;vertical-align:middle;"><polyline points="6 9 12 15 18 9"/></svg>
                                        @t.DonemBaslangic.ToString("MMMM yyyy")
                                    </td>
                                    <td style="font-size:13px;">@t.VadeTarihi.ToString("dd.MM.yyyy")</td>
                                    <td style="font-weight:600;">@t.ToplamTutar.ToString("N0") ₺</td>
                                    <td style="color:#065f46;">@t.OdenenTutar.ToString("N0") ₺</td>
                                    <td><span class="badge @tDurumCls">@tDurumLabel</span></td>
                                    <td @@click.stop="">
                                        <a href="/Odeme?tahakkukId=@t.Id" class="btn btn-sm btn-secondary">Ödemeler</a>
                                    </td>
                                </tr>
                                <tr x-show="open[@t.Id]" x-cloak style="background:#f7f8fb;">
                                    <td colspan="6" style="padding:10px 20px 14px;">
                                        @if (t.Kalemler.Any())
                                        {
                                            <div style="font-size:11.5px;font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Kalem Dökümü</div>
                                            <table style="width:100%;border-collapse:collapse;font-size:13px;">
                                                <thead>
                                                    <tr style="color:var(--color-muted);font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">
                                                        <th style="padding:4px 8px;text-align:left;font-weight:600;">Kod</th>
                                                        <th style="padding:4px 8px;text-align:left;font-weight:600;">Açıklama</th>
                                                        <th style="padding:4px 8px;text-align:right;font-weight:600;">Birim Değer</th>
                                                        <th style="padding:4px 8px;text-align:right;font-weight:600;">Çarpan</th>
                                                        <th style="padding:4px 8px;text-align:right;font-weight:600;">Tutar</th>
                                                        <th style="padding:4px 8px;text-align:right;font-weight:600;">KDV</th>
                                                        <th style="padding:4px 8px;text-align:right;font-weight:600;">Toplam</th>
                                                        <th style="padding:4px 8px;text-align:center;font-weight:600;">Kaynak</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var k in t.Kalemler.OrderBy(k => k.BorcTipi.Sira))
                                                    {
                                                        string kaynakCls = k.KaynakTipi switch {
                                                            KalemKaynakTipi.TanimsizTarife    => "badge-bos",
                                                            KalemKaynakTipi.SozlesmeTarifesi  => "badge-surek",
                                                            KalemKaynakTipi.BirimTarifesi     => "badge-kirali",
                                                            KalemKaynakTipi.TasinmazTarifesi  => "badge-bireysel",
                                                            KalemKaynakTipi.GenelTarife       => "badge-bos",
                                                            KalemKaynakTipi.ManuelGiris       => "badge-surek",
                                                            KalemKaynakTipi.RezervasyonKurali => "badge-bireysel",
                                                            _                                 => "badge-bos"
                                                        };
                                                        string kaynakLabel = k.KaynakTipi switch {
                                                            KalemKaynakTipi.TanimsizTarife    => "Tanımsız Tarife",
                                                            KalemKaynakTipi.SozlesmeTarifesi  => "Sözleşme Tarifesi",
                                                            KalemKaynakTipi.BirimTarifesi     => "Birim Tarifesi",
                                                            KalemKaynakTipi.TasinmazTarifesi  => "Taşınmaz Tarifesi",
                                                            KalemKaynakTipi.GenelTarife       => "Genel Tarife",
                                                            KalemKaynakTipi.ManuelGiris       => "Manuel Giriş",
                                                            KalemKaynakTipi.RezervasyonKurali => "Rezervasyon Kuralı",
                                                            _                                 => "Bilinmiyor"
                                                        };
                                                        <tr style="border-top:1px solid var(--color-border);">
                                                            <td style="padding:5px 8px;font-family:monospace;font-weight:700;font-size:12px;">@k.BorcTipi.Kod</td>
                                                            <td style="padding:5px 8px;">@k.Aciklama</td>
                                                            <td style="padding:5px 8px;text-align:right;">@k.BirimDeger.ToString("N2") ₺@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "/m²" : "")</td>
                                                            <td style="padding:5px 8px;text-align:right;color:var(--color-muted);">@k.Carpan.ToString("F2")</td>
                                                            <td style="padding:5px 8px;text-align:right;font-weight:600;">@k.Tutar.ToString("N2") ₺</td>
                                                            <td style="padding:5px 8px;text-align:right;color:var(--color-muted);">@k.KdvTutari.ToString("N2") ₺</td>
                                                            <td style="padding:5px 8px;text-align:right;font-weight:700;">@k.ToplamTutar.ToString("N2") ₺</td>
                                                            <td style="padding:5px 8px;text-align:center;"><span class="badge @kaynakCls" style="font-size:11px;">@kaynakLabel</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr style="border-top:2px solid var(--color-border);background:#eef0f4;">
                                                        <td colspan="6" style="padding:5px 8px;font-weight:700;font-size:12px;">Toplam</td>
                                                        <td style="padding:5px 8px;text-align:right;font-weight:700;">@t.ToplamTutar.ToString("N2") ₺</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        }
                                        else
                                        {
                                            <span style="font-size:13px;color:var(--color-muted);">Kalem bilgisi yok (eski tahakkuk).</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        </div>
    }

</div><!-- /#sozlesme-tabs -->

<!-- MODAL: Sözleşmeyi Uzat -->
<div x-show="showUzat" x-cloak
    style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px;"
    @@click.self="showUzat = false">
    <div style="background:white;border-radius:16px;width:100%;max-width:520px;padding:28px;max-height:90vh;overflow-y:auto;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
            <div style="font-size:18px;font-weight:700;">Sözleşmeyi Uzat</div>
            <button @@click="showUzat = false" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--color-muted);">✕</button>
        </div>

        <div style="background:#f7f8fa;border-radius:8px;padding:10px 14px;margin-bottom:18px;font-size:13px;">
            Mevcut bitiş: <strong>@s.BitisTarihi.ToString("dd.MM.yyyy")</strong> •
            Mevcut kira: <strong>@TLFormat(aylikBedel)</strong>
        </div>

        <form method="post" action="/Sozlesme/Uzat/@s.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SozlesmeId" value="@s.Id" />

            <div class="form-group">
                <label class="form-label">Yeni Bitiş Tarihi *</label>
                <input type="date" name="YeniBitisTarihi" class="form-control"
                    value="@s.BitisTarihi.AddYears(1).ToString("yyyy-MM-dd")" required />
            </div>

            <!-- TÜFE bölümü -->
            <div class="form-group">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;font-weight:500;">
                    <input type="checkbox" name="TufeUygulanacakMi" value="true"
                        x-model="tufeEnabled" @@change="applyTufe()"
                        style="width:16px;height:16px;cursor:pointer;" />
                    TÜFE Artışı Uygula
                </label>
            </div>
            <div x-show="tufeEnabled" x-cloak style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:14px;margin-bottom:14px;">
                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">TÜFE Oranı (%)</label>
                    <input type="number" name="TufeOrani" step="0.01" min="0" class="form-control"
                        x-model="tufeOrani" @@change="applyTufe()" placeholder="Örn: 25" />
                </div>
                <div style="font-size:13px;display:flex;flex-direction:column;gap:4px;">
                    <div>Artış tutarı: <strong x-text="formatTl(tufeArtisTutari)"></strong></div>
                    <div>TÜFE sonrası kira: <strong x-text="formatTl(tufeSonrasiBedel)"></strong></div>
                </div>
            </div>

            <!-- KDV bölümü -->
            <div class="form-group">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;font-weight:500;">
                    <input type="checkbox" name="KdvUygulanacakMi" value="true"
                        x-model="kdvEnabled"
                        style="width:16px;height:16px;cursor:pointer;" />
                    KDV Uygula
                </label>
            </div>
            <div x-show="kdvEnabled" x-cloak style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:14px;margin-bottom:14px;">
                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">KDV Oranı (%)</label>
                    <input type="number" name="KdvOrani" step="0.01" min="0" max="100" class="form-control"
                        x-model="kdvOrani" value="20" />
                </div>
                <div style="font-size:13px;display:flex;flex-direction:column;gap:4px;">
                    <div>KDV Tutarı: <strong x-text="formatTl(kdvTutari)"></strong></div>
                    <div>KDV Dahil Toplam: <strong x-text="formatTl(kdvDahilToplam)"></strong></div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama</label>
                <textarea name="Aciklama" class="form-control" rows="2" placeholder="Opsiyonel açıklama"></textarea>
            </div>

            @if (User.HasClaim("permission", PermissionCatalog.Sozlesme.OverrideRate) || User.IsInRole("Admin"))
            {
                <div class="form-group" style="margin-top:12px;">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;font-weight:500;">
                        <input type="checkbox" x-model="tarifeUzat"
                               @@change="if(tarifeUzat) fetchTarifeKalemler('uzat')"
                               style="width:16px;height:16px;cursor:pointer;" />
                        Tarifeyi de güncelle
                    </label>
                </div>
                <div x-show="tarifeUzat" x-cloak style="border:1px solid var(--color-border);border-radius:8px;padding:14px;margin-bottom:14px;">
                    <div style="font-size:12px;color:var(--color-muted);margin-bottom:10px;">Yalnızca değiştirdiğiniz kalemler SözleşmeTarife olarak yazılır.</div>
                    <template x-for="(k, i) in uzatKalemler" :key="k.borcTipiId">
                        <div style="display:grid;grid-template-columns:1fr 110px 1fr 80px;gap:8px;align-items:end;margin-bottom:8px;">
                            <div style="font-size:13px;font-weight:500;align-self:center;" x-text="k.borcTipiAd"></div>
                            <div>
                                <label class="form-label" style="font-size:11px;margin-bottom:3px;">Yöntem</label>
                                <select class="form-control form-control-sm" x-model.number="k.hesaplamaYontemi"
                                        @@change="k.kullaniciDegistirdiMi = true">
                                    <option value="1">Sabit</option>
                                    <option value="2" :disabled="birimYuzolcumu === 0">m²</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label" style="font-size:11px;margin-bottom:3px;">
                                    <span x-show="k.hesaplamaYontemi != 2">Tutar (₺)</span>
                                    <span x-show="k.hesaplamaYontemi == 2">₺ / m²</span>
                                </label>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       x-model.number="k.birimDeger"
                                       @@input="k.kullaniciDegistirdiMi = true">
                            </div>
                            <div>
                                <label class="form-label" style="font-size:11px;margin-bottom:3px;">KDV (%)</label>
                                <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm"
                                       x-model.number="k.kdvOrani"
                                       @@input="k.kullaniciDegistirdiMi = true"
                                       :name="`SozlesmeKalemleri[${i}].KdvOrani`">
                            </div>
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].BorcTipiId`" :value="k.borcTipiId">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].BirimDeger`" :value="k.birimDeger">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].HesaplamaYontemi`" :value="k.hesaplamaYontemi">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].Tutar`" :value="hesaplaPopupTutar(k)">
                            <input type="hidden" :name="`SozlesmeKalemleri[${i}].KullaniciDegistirdiMi`" :value="k.kullaniciDegistirdiMi">
                        </div>
                    </template>
                    <input type="hidden" name="TarifeyiGuncelle" :value="tarifeUzat">
                </div>
            }

            <div style="display:flex;gap:10px;margin-top:4px;">
                <button type="submit" class="btn btn-primary">Uzat</button>
                <button type="button" class="btn btn-secondary" @@click="showUzat = false">İptal</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Sözleşmeyi Feshet -->
<div x-show="showFesih" x-cloak
    style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px;"
    @@click.self="showFesih = false">
    <div style="background:white;border-radius:16px;width:100%;max-width:460px;padding:28px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
            <div style="font-size:18px;font-weight:700;color:#dc2626;">Sözleşmeyi Feshet</div>
            <button @@click="showFesih = false" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--color-muted);">✕</button>
        </div>

        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;margin-bottom:18px;font-size:13px;color:#991b1b;">
            Bu işlem geri alınamaz. Feshedilen sözleşme aktif gelir hesaplarına dahil edilmez ve birim yeniden kiralanabilir hale gelir.
        </div>

        <form method="post" action="/Sozlesme/Feshet/@s.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SozlesmeId" value="@s.Id" />

            <div class="form-group">
                <label class="form-label">Fesih Tarihi *</label>
                <input type="date" name="FesihTarihi" class="form-control"
                    value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-group">
                <label class="form-label">Fesih Nedeni *</label>
                <input type="text" name="FesihNedeni" class="form-control"
                    placeholder="Örn: Kiracı tarafından erken fesih" required />
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama</label>
                <textarea name="Aciklama" class="form-control" rows="2" placeholder="Opsiyonel ek not"></textarea>
            </div>

            <div style="display:flex;gap:10px;margin-top:4px;">
                <button type="submit" class="btn btn-danger">Feshet</button>
                <button type="button" class="btn btn-secondary" @@click="showFesih = false">İptal</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Tahakkuk Yeniden Üret -->
<div x-show="showYenidenUret" x-cloak
    style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px;"
    @@click.self="showYenidenUret = false">
    <div style="background:white;border-radius:16px;width:100%;max-width:480px;padding:28px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
            <div style="font-size:18px;font-weight:700;">Tahakkuk Yeniden Üret</div>
            <button @@click="showYenidenUret = false" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--color-muted);">✕</button>
        </div>

        <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 14px;margin-bottom:18px;font-size:13px;color:#92400e;">
            Seçilen tarihten itibaren <strong>ödeme alınmamış</strong> tahakkuklar silinip yeniden üretilir. Ödeme kaydı olan tahakkuklara dokunulmaz.
        </div>

        <form method="post" action="/Sozlesme/YenidenUret/@s.Id">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Başlangıç Tarihi *</label>
                <input type="date" name="baslangicTarihi" class="form-control"
                    value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                <div class="form-hint">Bu tarihten (dahil) itibaren ödenmemiş tahakkuklar etkilenir.</div>
            </div>

            @if (User.HasClaim("permission", PermissionCatalog.Sozlesme.OverrideRate) || User.IsInRole("Admin"))
            {
                <div class="form-group" style="margin-top:12px;">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;font-weight:500;">
                        <input type="checkbox" x-model="tarifeYenidenUret"
                               @@change="if(tarifeYenidenUret) fetchTarifeKalemler('yenidenUret')"
                               style="width:16px;height:16px;cursor:pointer;" />
                        Tarifeyi de güncelle
                    </label>
                </div>
                <div x-show="tarifeYenidenUret" x-cloak style="border:1px solid var(--color-border);border-radius:8px;padding:14px;margin-bottom:14px;">
                    <div style="font-size:12px;color:var(--color-muted);margin-bottom:10px;">Yalnızca değiştirdiğiniz kalemler SözleşmeTarife olarak yazılır.</div>
                    <template x-for="(k, i) in yenidenUretKalemler" :key="k.borcTipiId">
                        <div style="display:grid;grid-template-columns:1fr 110px 1fr 80px;gap:8px;align-items:end;margin-bottom:8px;">
                            <div style="font-size:13px;font-weight:500;align-self:center;" x-text="k.borcTipiAd"></div>
                            <div>
                                <label class="form-label" style="font-size:11px;margin-bottom:3px;">Yöntem</label>
                                <select class="form-control form-control-sm" x-model.number="k.hesaplamaYontemi"
                                        @@change="k.kullaniciDegistirdiMi = true">
                                    <option value="1">Sabit</option>
                                    <option value="2" :disabled="birimYuzolcumu === 0">m²</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label" style="font-size:11px;margin-bottom:3px;">
                                    <span x-show="k.hesaplamaYontemi != 2">Tutar (₺)</span>
                                    <span x-show="k.hesaplamaYontemi == 2">₺ / m²</span>
                                </label>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                       x-model.number="k.birimDeger"
                                       @@input="k.kullaniciDegistirdiMi = true">
                            </div>
                            <div>
                                <label class="form-label" style="font-size:11px;margin-bottom:3px;">KDV (%)</label>
                                <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm"
                                       x-model.number="k.kdvOrani"
                                       @@input="k.kullaniciDegistirdiMi = true"
                                       :name="`sozlesmeKalemleri[${i}].KdvOrani`">
                            </div>
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].BorcTipiId`" :value="k.borcTipiId">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].BirimDeger`" :value="k.birimDeger">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].HesaplamaYontemi`" :value="k.hesaplamaYontemi">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].Tutar`" :value="hesaplaPopupTutar(k)">
                            <input type="hidden" :name="`sozlesmeKalemleri[${i}].KullaniciDegistirdiMi`" :value="k.kullaniciDegistirdiMi">
                        </div>
                    </template>
                    <input type="hidden" name="tarifeyiGuncelle" :value="tarifeYenidenUret">
                </div>
            }

            <div style="display:flex;gap:10px;margin-top:4px;">
                <button type="submit" class="btn btn-primary">Yeniden Üret</button>
                <button type="button" class="btn btn-secondary" @@click="showYenidenUret = false">İptal</button>
            </div>
        </form>
    </div>
</div>

</div><!-- /x-data -->

@section Scripts {
    <script>initTabs('sozlesme-tabs');</script>
    <style>[x-cloak]{display:none!important;}</style>
}
