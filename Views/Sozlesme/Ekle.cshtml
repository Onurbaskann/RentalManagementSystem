@model KiraTakip.Models.ViewModels.SozlesmeEkleViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Yeni Sözleşme";
}

<div class="page-header">
    <a href="/Sozlesme" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← Sözleşmeler</a>
    <div class="page-title">Yeni Sözleşme Oluştur</div>
</div>

<div class="max-w-[760px]" x-data="sozlesmeForm()" x-init="init()" x-cloak>
    <form asp-action="Ekle" method="post" id="sozlesmeForm">
        <div class="card">
            <div class="text-[15px] font-bold mb-4.5 pb-3.5 border-b border-[var(--color-border)]">Taşınmaz ve Kiracı</div>

            <div class="form-group">
                <label class="form-label">Birim *</label>
                <select asp-for="BirimId" class="form-control" x-model="birimId" id="birimSelect">
                    <option value="">— Boş birim seçin —</option>
                    @foreach (var b in Model.MevcutBirimler)
                    {
                        string birimLabel = b.BirimTipi == KiraTakip.Models.BirimTipi.Birim
                            ? $"{b.TasinmazAd} — Birim {b.BirimNo}{(b.KatNo.HasValue ? $" • {b.KatNo}. Kat" : "")} • {b.Yuzolcumu.ToString("N0")} m²"
                            : $"{b.TasinmazAd} — Komple • {b.Yuzolcumu.ToString("N0")} m² • {b.Ilce}";
                        <option value="@b.Id">@birimLabel</option>
                    }
                </select>
                <span asp-validation-for="BirimId" class="form-error"></span>
            </div>

            <!-- Birim info card -->
            <div x-show="birimId && birimler[birimId]" class="mb-4" x-cloak>
                <div class="info-card bg-primary/5 border border-primary/10 rounded-lg p-3">
                    <div class="text-[13.5px] font-medium text-primary" 
                         x-text="birimler[birimId] ? `${birimler[birimId].ad} • ${birimler[birimId].m2} • ${birimler[birimId].ilce}, ${birimler[birimId].il}` : ''"></div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Kiracı *</label>
                <select asp-for="KiraciId" class="form-control" x-model="kiraciId">
                    <option value="">— Kiracı seçin —</option>
                    @foreach (var k in Model.Kiraciler)
                    {
                        <option value="@k.Id">@k.GosterimAdi (@(k.KiraciTuru == KiraTakip.Models.KiraciTuru.Tuzel ? "Tüzel" : "Gerçek"))</option>
                    }
                </select>
            </div>
        </div>

        <div class="card mt-4">
            <div class="text-[15px] font-bold mb-4.5 pb-3.5 border-b border-[var(--color-border)]">Süre ve Bedel</div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                <div class="form-group mb-0">
                    <label class="form-label">Başlangıç Tarihi *</label>
                    <input asp-for="BaslangicTarihi" type="date" class="form-control" x-model="baslangicTarihi" id="baslangicInput" />
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Bitiş Tarihi *</label>
                    <input asp-for="BitisTarihi" type="date" class="form-control" x-model="bitisTarihi" id="bitisInput" />
                    <span asp-validation-for="BitisTarihi" class="form-error"></span>
                    <div class="text-red-500 text-xs mt-1.5 font-medium" x-show="bitisTarihi && baslangicTarihi && bitisTarihi <= baslangicTarihi" x-cloak>Bitiş tarihi başlangıçtan büyük olmalıdır.</div>
                </div>
            </div>
        </div>


        <!-- Sözleşme Kalemleri Bölümü -->
        <div class="card mt-4" x-show="birimId && kiraciId && baslangicTarihi" x-cloak>
            <div class="text-[15px] font-bold mb-4.5 pb-3.5 border-b border-[var(--color-border)] flex justify-between items-center">
                <span>Sözleşme Kalemleri</span>
                <div x-show="loading" class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
            </div>

            <div x-show="error" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-sm" x-text="error"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <template x-for="(k, index) in kalemler" :key="k.borcTipiId">
                    <div class="bg-slate-50/50 border border-[var(--color-border)] rounded-xl p-4 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-3">
                                <div class="text-sm font-bold text-slate-800" x-text="k.borcTipiAd"></div>
                                <div class="flex gap-1.5 flex-wrap justify-end max-w-[150px]">
                                    <!-- Kaynak Tipi Rozeti -->
                                    <span class="text-[10px] px-1.5 py-0.5 rounded font-bold uppercase tracking-tight"
                                          :class="k.kaynakTipi === 'SozlesmeTarifesi' ? 'bg-primary text-white' :
                                                  k.kaynakTipi === 'BirimTarifesi' ? 'bg-emerald-600 text-white' :
                                                  k.kaynakTipi === 'TasinmazTarifesi' ? 'bg-sky-500 text-white' :
                                                  k.kaynakTipi === 'GenelTarife' ? 'bg-amber-500 text-white' : 'bg-slate-500 text-white'"
                                          x-text="getKaynakTipiLabel(k.kaynakTipi)"></span>
                                    
                                    <!-- Durum Rozeti -->
                                    <span class="text-[10px] px-1.5 py-0.5 rounded font-bold uppercase tracking-tight"
                                          :class="k.kullaniciDegistirdiMi ? 'bg-rose-600 text-white' : 'bg-slate-800 text-white'"
                                          x-text="k.kullaniciDegistirdiMi ? 'Override' : 'Otomatik'"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-3 gap-2 items-end mb-2">
                                <div>
                                    <label class="text-[10px] text-muted font-bold mb-1 block">Yöntem</label>
                                    <select class="form-control form-control-sm"
                                            x-model.number="k.hesaplamaYontemi"
                                            @@change="k.kullaniciDegistirdiMi = true; validateKalem(k)">
                                        <option value="1">Sabit</option>
                                        <option value="2" :disabled="getBirimYuzolcumu() === 0">m²</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="text-[10px] text-muted font-bold mb-1 block">
                                        <span x-show="k.hesaplamaYontemi != 2">Tutar (₺)</span>
                                        <span x-show="k.hesaplamaYontemi == 2">₺ / m²</span>
                                    </label>
                                    <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                           x-model.number="k.birimDeger"
                                           @@input="k.kullaniciDegistirdiMi = true; validateKalem(k)">
                                </div>
                                <div>
                                    <label class="text-[10px] text-muted font-bold mb-1 block">KDV (%)</label>
                                    <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm"
                                           x-model.number="k.kdvOrani"
                                           @@input="k.kullaniciDegistirdiMi = true"
                                           :name="`SozlesmeKalemleri[${index}].KdvOrani`">
                                </div>
                            </div>
                            <div x-show="k.hesaplamaYontemi == 2" class="text-[11px] text-muted mb-2.5">
                                <span x-show="getBirimYuzolcumu() > 0">× <span x-text="getBirimYuzolcumu()"></span> m² = <strong x-text="hesaplaTutar(k).toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></strong></span>
                                <span x-show="getBirimYuzolcumu() === 0" class="text-red-600 font-semibold">Birim m² tanımlı değil.</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center mt-auto pt-3 border-t border-slate-200/50">
                            <!-- Hata Mesajı -->
                            <div class="text-red-600 text-[11px] font-semibold" x-show="k._error" x-text="k._error"></div>
                            <div x-show="!k._error"></div> <!-- spacer -->
                            
                            <!-- Sıfırla Butonu -->
                            <button type="button" class="px-2.5 py-1 text-[11px] font-bold text-slate-600 border border-slate-300 rounded bg-white hover:bg-slate-50 transition-colors"
                                    x-show="k.kullaniciDegistirdiMi"
                                    @@click="resetKalem(k)">Sıfırla</button>
                        </div>

                        <!-- Gizli Alanlar -->
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].BorcTipiId`" :value="k.borcTipiId">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].BorcTipiAd`" :value="k.borcTipiAd">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].BorcTipiKod`" :value="k.borcTipiKod">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].Davranis`" :value="k.davranis">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].BirimDeger`" :value="k.birimDeger">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].HesaplamaYontemi`" :value="k.hesaplamaYontemi">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].Tutar`" :value="hesaplaTutar(k)">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].VarsayilanTutar`" :value="k.varsayilanTutar">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].KullaniciDegistirdiMi`" :value="k.kullaniciDegistirdiMi">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].RateBulundu`" :value="k.rateBulundu">
                        <input type="hidden" :name="`SozlesmeKalemleri[${index}].KaynakTipi`" :value="k.kaynakTipi">
                    </div>
                </template>
            </div>
            
            <div x-show="!loading && kalemler.length === 0" class="text-muted text-sm mt-2 italic">
                Bu seçimlere uygun varsayılan kalem bulunamadı.
            </div>
        </div>

        <div class="card mt-4">
            <div class="form-group mb-0">
                <label class="form-label">Notlar</label>
                <textarea asp-for="Notlar" class="form-control" rows="3" placeholder="Sözleşmeye ait ek notlar..."></textarea>
            </div>
        </div>

        <div class="flex gap-3 mt-6">
            <button type="submit" class="btn btn-primary px-6 flex items-center gap-2" :disabled="isSubmitDisabled()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Sözleşme Oluştur
            </button>
            <a href="/Sozlesme" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('sozlesmeForm', () => ({
            birimId: @(Model.BirimId.HasValue ? Model.BirimId.Value.ToString() : "null"),
            kiraciId: @(Model.KiraciId != 0 ? Model.KiraciId.ToString() : "null"),
            baslangicTarihi: '@Model.BaslangicTarihi.ToString("yyyy-MM-dd")',
            bitisTarihi: '@Model.BitisTarihi.ToString("yyyy-MM-dd")',
            kalemler: [],
            loading: false,
            error: null,
            birimler: {
                @foreach (var b in Model.MevcutBirimler)
                {
                    string birimAd = b.BirimTipi == KiraTakip.Models.BirimTipi.Birim
                        ? $"{b.TasinmazAd} — Birim {b.BirimNo}"
                        : $"{b.TasinmazAd} — Komple";
                    string meta = b.BirimTipi == KiraTakip.Models.BirimTipi.Birim && b.KatNo.HasValue
                        ? $"{b.KatNo}. Kat • {b.Yuzolcumu.ToString("N0")} m²"
                        : $"{b.Yuzolcumu.ToString("N0")} m²";
                    @Html.Raw($"{b.Id}: {{ad: '{birimAd.Replace("'", "\\'")}', m2: '{meta.Replace("'", "\\'")}', ilce: '{b.Ilce.Replace("'", "\\'")}', il: '{b.Il.Replace("'", "\\'")}'}},")
                }
            },
            birimYuzolcumular: @Html.Raw(ViewBag.BirimYuzolcumular ?? "{}"),
            init() {
                this.$watch('birimId', () => this.fetchKalemler());
                this.$watch('kiraciId', () => this.fetchKalemler());
                this.$watch('baslangicTarihi', () => this.fetchKalemler());
                
                if (this.birimId && this.kiraciId && this.baslangicTarihi) {
                    this.fetchKalemler();
                }
            },
            async fetchKalemler() {
                console.log('fetchKalemler tetiklendi:', { birimId: this.birimId, kiraciId: this.kiraciId, baslangic: this.baslangicTarihi });
                if (!this.birimId || !this.kiraciId || !this.baslangicTarihi) {
                    this.kalemler = [];
                    return;
                }
                this.loading = true;
                this.error = null;
                try {
                    const url = `/Sozlesme/GetVarsayilanKalemler?birimId=${this.birimId}&kiraciId=${this.kiraciId}&baslangic=${this.baslangicTarihi}`;
                    console.log('API çağrılıyor:', url);
                    const response = await fetch(url);
                    if (!response.ok) throw new Error('Kalemler alınırken hata oluştu.');
                    const data = await response.json();
                    console.log('API cevabı:', data);
                    this.kalemler = data.map(k => ({
                        ...k,
                        varsayilanHesaplamaYontemi: k.hesaplamaYontemi,
                        _error: null
                    }));
                    



                } catch (err) {
                    console.error('Hata:', err);
                    this.error = err.message;
                } finally {
                    this.loading = false;
                }
            },
            getBirimYuzolcumu() {
                return this.birimYuzolcumular[this.birimId] ?? 0;
            },
            hesaplaTutar(k) {
                return k.hesaplamaYontemi == 2 ? k.birimDeger * this.getBirimYuzolcumu() : k.birimDeger;
            },
            resetKalem(k) {
                k.birimDeger = k.varsayilanBirimDeger;
                k.hesaplamaYontemi = k.varsayilanHesaplamaYontemi;
                k.tutar = k.varsayilanTutar;
                k.kullaniciDegistirdiMi = false;
                k._error = null;
            },
            validateKalem(k) {
                k._error = null;
                if (k.birimDeger < 0) k._error = 'Tutar negatif olamaz.';
                if (k.hesaplamaYontemi == 2 && this.getBirimYuzolcumu() === 0) k._error = 'Birim için m² tanımlı değil.';
            },
            getKaynakTipiLabel(val) {
                const map = {
                    'SozlesmeTarifesi':  'Sözleşme Tarifesi',
                    'BirimTarifesi':     'Birim Tarifesi',
                    'TasinmazTarifesi':  'Taşınmaz Tarifesi',
                    'GenelTarife':       'Genel Tarife',
                    'TanimsizTarife':    'Tanımsız Tarife'
                };
                return map[val] || 'Fiyat Tanımı Yok';
            },
            isSubmitDisabled() {
                const dateError = this.bitisTarihi && this.baslangicTarihi && this.bitisTarihi <= this.baslangicTarihi;
                const kalemError = this.kalemler.some(k => k._error);
                return dateError || kalemError;
            }
        }));
    });
</script>
}
