@model List<KiraTakip.Models.KiraSozlesmesi>
@using KiraTakip.Models
@using KiraTakip.Services.Interfaces
@inject IIstatistikService Istatistik
@{
    ViewData["Title"] = "Sözleşmeler";
    string filtre = ViewBag.Filtre ?? "tum";
    bool canEdit = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Sozlesme.Create);
}

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;border:1px solid #fca5a5;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">⚠ @TempData["Error"]</div>
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Sözleşmeler</div>
        <div class="page-subtitle">@Model.Count kayıt listeleniyor</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        @{
            int borcluSayisi = ViewBag.BorcluSayisi ?? 0;
        }
        @if (borcluSayisi > 0)
        {
            <form asp-controller="Sozlesme" asp-action="BorclularaMailGonder" method="post"
                  data-confirm="@borcluSayisi tahakkuka hatırlatma maili gönderilsin mi?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    Borçlulara Mail (@borcluSayisi)
                </button>
            </form>
        }
        @if (canEdit)
        {
            <a href="/Sozlesme/Ekle" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Yeni Sözleşme
            </a>
        }
    </div>
</div>

<!-- Filtreler -->
<div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;">
    @{
        var filters = new[] {
            ("tum",         "Tümü"),
            ("aktif",       "Aktif"),
            ("surek",       "Dolmak Üzere"),
            ("gecmis",      "Sona Erdi"),
            ("feshedildi",  "Feshedildi")
        };
    }
    @foreach (var (key, label) in filters)
    {
        string cls = filtre == key ? "btn btn-primary btn-sm" : "btn btn-secondary btn-sm";
        <a href="/Sozlesme?filtre=@key" class="@cls">@label</a>
    }
</div>

<div class="card" style="padding:0;overflow:hidden;" x-data="clientTable({ pageSize: 25 })" x-init="init()">
    <div class="table-toolbar">
        <input type="search" class="form-control toolbar-search" placeholder="Ara: kiracı, taşınmaz, birim…" x-model.debounce.250ms="q" />
        <span class="pagination-info" style="margin-left:auto;"><span x-text="total"></span> kayıt</span>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kiracı</th>
                    <th>Taşınmaz / Birim</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Aylık Bedel</th>
                    <th>Kalan</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody x-ref="tbody">
                @foreach (var s in Model)
                {
                    bool aktif = Istatistik.Aktif(s);
                    int kalanGun = Istatistik.KalanGun(s);
                    bool surek = aktif && kalanGun <= 30;
                    bool feshedildi = s.Durum == SozlesmeDurumu.Feshedildi;
                    string dayBadge = kalanGun <= 10 ? "day-badge-red" : kalanGun <= 30 ? "day-badge-amber" : "day-badge-green";
                    var search = $"{s.Id} {s.Kiraci.GosterimAdi} {s.Birim.Tasinmaz.Ad} {s.Birim.Ad}".ToLower();

                    <tr data-row data-search="@search">
                        <td style="color:var(--color-muted);font-size:12.5px;">@s.Id</td>
                        <td>
                            <div style="display:flex;align-items:center;gap:4px;">
                                <a href="/Kiraci/Detay/@s.KiraciId" style="font-weight:600;color:var(--color-primary);text-decoration:none;">@s.Kiraci.GosterimAdi</a>
                                @if (s.Kiraci.KiraciTuru == KiraciTuru.Tuzel) { <span class="badge badge-kurumsal" style="font-size:10.5px;">T</span> }
                            </div>
                            @if (s.Kiraci.KiraciKategori != null)
                            {
                                <div style="font-size:11.5px;color:var(--color-muted);margin-top:1px;font-weight:500;">@s.Kiraci.KiraciKategori.Ad</div>
                            }
                        </td>
                        <td>
                            <a href="/Tasinmaz/Detay/@s.Birim.TasinmazId" style="font-weight:500;color:var(--color-text);text-decoration:none;">@s.Birim.Tasinmaz.Ad</a>
                            <div style="font-size:12px;color:var(--color-muted);">@s.Birim.Ad</div>
                        </td>
                        <td style="font-size:13px;">@s.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                        <td style="font-size:13px;">@s.BitisTarihi.ToString("dd.MM.yyyy")</td>
                        <td style="font-weight:600;">@((await Istatistik.AylikBedelAsync(s)).ToString("N2")) ₺</td>
                        <td>
                            @if (feshedildi)
                            { <span style="color:var(--color-muted);font-size:12.5px;">Feshedildi</span> }
                            else if (aktif)
                            { <span class="day-badge @dayBadge">@kalanGun gün</span> }
                            else
                            { <span style="color:var(--color-muted);font-size:12.5px;">Sona erdi</span> }
                        </td>
                        <td>
                            @if (feshedildi) { <span class="badge badge-gecmis">Feshedildi</span> }
                            else if (surek) { <span class="badge badge-surek">Dolmak Üzere</span> }
                            else if (aktif) { <span class="badge badge-kirali">Aktif</span> }
                            else { <span class="badge badge-gecmis">Sona Erdi</span> }
                        </td>
                        <td><a href="/Sozlesme/Detay/@s.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" style="text-align:center;color:var(--color-muted);padding:32px;">Bu filtreye uygun sözleşme bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-wrap" x-show="totalPages > 1">
        <div class="pagination-info"><span x-text="from"></span>–<span x-text="to"></span> / <strong x-text="total"></strong></div>
        <nav class="pagination" aria-label="Sayfalar">
            <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === 1 }" :disabled="page === 1" @@click="prev()">‹</button>
            <template x-for="p in pageList" :key="p">
                <button type="button" class="page-btn" :class="{ 'page-btn-active': p === page }" @@click="goto(p)" x-text="p"></button>
            </template>
            <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === totalPages }" :disabled="page === totalPages" @@click="next()">›</button>
        </nav>
    </div>
    <div class="pagination-wrap" x-show="total === 0 && q.length > 0" x-cloak>
        <div class="pagination-info" style="margin:auto;">Aramaya uyan kayıt yok.</div>
    </div>
</div>
