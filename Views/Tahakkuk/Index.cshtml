@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.KiraTahakkuk>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Tahakkuklar";
    bool canCreate = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Odeme.Create);
    string durum = ViewBag.Durum ?? "tum";
    var q = (TableQuery)ViewBag.Query;
    var pagination = new PaginationModel { Page = Model.Page, Size = Model.Size, Total = Model.Total, BasePath = "/Tahakkuk", Extra = q.ToQueryDict() };
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Tahakkuklar</div>
        <div class="page-subtitle">@Model.Total dönem kaydı</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✕ @TempData["Error"]</div>
}

<!-- Filtreler -->
<div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;">
    @{
        var filters = new[] { ("tum","Tümü"), ("bekliyor","Bekliyor"), ("kismi","Kısmi"), ("tamodendi","Tam Ödendi"), ("gecikti","Gecikti") };
    }
    @foreach (var (key, label) in filters)
    {
        string cls = durum == key ? "btn btn-primary btn-sm" : "btn btn-secondary btn-sm";
        var url = key == "tum" ? "/Tahakkuk" : $"/Tahakkuk?durum={key}";
        <a href="@url" class="@cls">@label</a>
    }
</div>

<script>
    window._tahakkukBirimler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ((List<KiraTakip.Models.Birim>)ViewBag.Birimler)
            .Select(b => new { id = b.Id, ad = b.Ad, tasinmazId = b.TasinmazId })
    ));
</script>
<div class="card" style="padding:0;overflow:hidden;">
    <form method="get" class="table-toolbar" action="/Tahakkuk" style="gap:10px;padding:12px;"
          x-data="{
              tasinmazId: '@(q.TasinmazId?.ToString() ?? "")',
              birimId: '@(q.BirimId?.ToString() ?? "")',
              get filtrelenmisBirimler() {
                  if (!this.tasinmazId) return [];
                  var tid = parseInt(this.tasinmazId);
                  return window._tahakkukBirimler.filter(function(b) { return b.tasinmazId === tid; });
              }
          }">
        <input type="search" name="q" value="@q.Q" class="form-control toolbar-search" placeholder="Ara: kiracı, taşınmaz…" style="flex:1;min-width:150px;" />

        <select name="tasinmazId" x-model="tasinmazId" @@change="birimId = ''"
                class="form-control toolbar-input" style="width:160px;">
            <option value="">— Tüm Taşınmazlar —</option>
            @foreach (var t in (List<Tasinmaz>)ViewBag.Tasinmazlar)
            {
                <option value="@t.Id">@t.Ad</option>
            }
        </select>

        <select name="birimId" x-model="birimId" x-show="filtrelenmisBirimler.length > 0"
                class="form-control toolbar-input" style="width:160px;">
            <option value="">— Tüm Birimler —</option>
            <template x-for="b in filtrelenmisBirimler" :key="b.id">
                <option :value="b.id" x-text="b.ad" :selected="b.id.toString() === birimId"></option>
            </template>
        </select>

        <select name="kiraciId" class="form-control toolbar-input" style="width:160px;">
            <option value="">— Tüm Kiracılar —</option>
            @foreach (var k in (List<Kiraci>)ViewBag.Kiracilar)
            {
                <option value="@k.Id" selected="@(q.KiraciId == k.Id ? "selected" : null)">@k.GosterimAdi</option>
            }
        </select>

        <select name="kaynak" class="form-control toolbar-input" style="width:120px;">
            <option value="">— Kaynak —</option>
            <option value="sozlesme" selected="@(q.Kaynak == "sozlesme" ? "selected" : null)">Sözleşme</option>
            <option value="manuel" selected="@(q.Kaynak == "manuel" ? "selected" : null)">Manuel</option>
            <option value="rezervasyon" selected="@(q.Kaynak == "rezervasyon" ? "selected" : null)">Rezervasyon</option>
        </select>

        <select name="yil" class="form-control toolbar-input" style="width:100px;">
            <option value="">— Yıl —</option>
            @foreach (var y in (List<int>)ViewBag.MevcutYillar)
            {
                <option value="@y" selected="@(q.Yil == y ? "selected" : null)">@y</option>
            }
        </select>

        <input type="date" name="from" value="@(q.From?.ToString("yyyy-MM-dd"))" class="form-control toolbar-input" style="width:130px;" />
        <input type="date" name="to" value="@(q.To?.ToString("yyyy-MM-dd"))" class="form-control toolbar-input" style="width:130px;" />
        
        <div style="display:flex;gap:4px;">
            <input type="number" name="min" value="@q.Min?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control toolbar-input" placeholder="Min ₺" style="width:90px;" />
            <input type="number" name="max" value="@q.Max?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control toolbar-input" placeholder="Max ₺" style="width:90px;" />
        </div>

        @if (durum != "tum") { <input type="hidden" name="durum" value="@durum" /> }
        @{
            int aktifFiltreSayisi = (string.IsNullOrEmpty(q.Q) ? 0 : 1)
                + (q.TasinmazId.HasValue ? 1 : 0)
                + (q.BirimId.HasValue ? 1 : 0)
                + (q.KiraciId.HasValue ? 1 : 0)
                + (!string.IsNullOrEmpty(q.Kaynak) ? 1 : 0)
                + (q.Yil.HasValue ? 1 : 0)
                + (q.From.HasValue || q.To.HasValue ? 1 : 0)
                + (q.Min.HasValue || q.Max.HasValue ? 1 : 0);
        }
        <button type="submit" class="btn btn-primary btn-sm">
            Filtrele
            @if (aktifFiltreSayisi > 0)
            {
                <span style="display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;background:rgba(255,255,255,0.3);border-radius:50%;font-size:11px;font-weight:700;margin-left:4px;">@aktifFiltreSayisi</span>
            }
        </button>
        @if (aktifFiltreSayisi > 0)
        {
            <a href="/Tahakkuk@(durum != "tum" ? $"?durum={durum}" : "")" class="btn btn-secondary btn-sm">Temizle</a>
        }
    </form>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Dönem</th>
                    <th>Kiracı</th>
                    <th>Taşınmaz</th>
                    <th>Vade</th>
                    <th>Beklenen</th>
                    <th>Ödenen</th>
                    <th>Kalan</th>
                    <th>Durum</th>
                    <th>Kaynak</th>
                    <th></th>
                </tr>
            </thead>
            <tbody x-data="{ open: {} }">
                @foreach (var t in Model.Items)
                {
                    var kalan = t.ToplamTutar - t.OdenenTutar;
                    string durumCls = t.Durum switch {
                        TahakkukDurumu.TamOdendi    => "badge-kirali",
                        TahakkukDurumu.KismenOdendi => "badge-surek",
                        TahakkukDurumu.Gecikti      => "badge-gecmis",
                        TahakkukDurumu.IptalEdildi  => "badge-bos",
                        _                           => "badge-bos"
                    };
                    string durumLabel = t.Durum switch {
                        TahakkukDurumu.TamOdendi    => "Tam Ödendi",
                        TahakkukDurumu.KismenOdendi => "Kısmi Ödendi",
                        TahakkukDurumu.Gecikti      => "Gecikti",
                        TahakkukDurumu.IptalEdildi  => "İptal Edildi",
                        _                           => "Bekleniyor"
                    };
                    string durumTip = t.Durum switch {
                        TahakkukDurumu.TamOdendi    => "Toplam tutar tamamı tahsil edildi.",
                        TahakkukDurumu.KismenOdendi => $"Kısmi ödeme alındı; kalan {kalan:N2} ₺.",
                        TahakkukDurumu.Gecikti      => "Vade geçti, ödeme henüz alınmadı.",
                        TahakkukDurumu.IptalEdildi  => "Sözleşme feshi nedeniyle iptal edildi.",
                        _                           => "Vade gelmedi; ödeme bekleniyor."
                    };
                    string tahakkukKaynakCls = t.KaynakTipi switch {
                        TahakkukKaynakTipi.Manuel      => "badge-surek",
                        TahakkukKaynakTipi.Rezervasyon => "badge-bireysel",
                        _                              => "badge-bos"
                    };
                    string tahakkukKaynakLabel = t.KaynakTipi switch {
                        TahakkukKaynakTipi.Manuel      => "Manuel",
                        TahakkukKaynakTipi.Rezervasyon => "Rezervasyon",
                        _                              => "Sözleşme"
                    };
                    <tr @@click="open[@t.Id] = !open[@t.Id]" style="cursor:pointer;">
                        <td style="font-weight:600;">
                            <svg x-show="open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px;vertical-align:middle;"><polyline points="18 15 12 9 6 15"/></svg>
                            <svg x-show="!open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px;vertical-align:middle;"><polyline points="6 9 12 15 18 9"/></svg>
                            @t.DonemBaslangic.ToString("MMMM yyyy")
                        </td>
                        <td>@(t.KiraSozlesmesi?.Kiraci?.GosterimAdi ?? "Rezervasyon Ücreti")</td>
                        <td>
                            <div style="font-weight:500;">@(t.KiraSozlesmesi?.Birim?.Tasinmaz?.Ad ?? "Toplantı Salonu")</div>
                            <div style="font-size:12px;color:var(--color-muted);">@(t.KiraSozlesmesi?.Birim?.Ad ?? "Rezervasyon")</div>
                        </td>
                        <td style="font-size:13px;">@t.VadeTarihi.ToString("dd.MM.yyyy")</td>
                        <td style="font-weight:600;">@t.ToplamTutar.ToString("N2") ₺</td>
                        <td style="color:#065f46;font-weight:600;">@t.OdenenTutar.ToString("N2") ₺</td>
                        <td style="@(kalan > 0 ? "color:#991b1b;" : "")font-weight:600;">@kalan.ToString("N2") ₺</td>
                        <td><span class="badge @durumCls" data-tip="@durumTip">@durumLabel</span></td>
                        <td><span class="badge @tahakkukKaynakCls">@tahakkukKaynakLabel</span></td>
                        <td @@click.stop="">
                            <a href="/Tahakkuk/Detay/@t.Id" class="btn btn-sm btn-secondary">Detay</a>
                            <a href="/Odeme?tahakkukId=@t.Id" class="btn btn-sm btn-secondary" style="margin-left:4px;">Ödemeler</a>
                            @if (canCreate && t.Durum != TahakkukDurumu.TamOdendi && t.Durum != TahakkukDurumu.IptalEdildi)
                            {
                                <a href="/Odeme/Ekle?tahakkukId=@t.Id" class="btn btn-sm btn-primary" style="margin-left:4px;">Ödeme Ekle</a>
                            }
                        </td>
                    </tr>
                    <tr x-show="open[@t.Id]" x-cloak style="background:#f7f8fb;">
                        <td colspan="10" style="padding:10px 20px 14px;">
                            @if (t.Kalemler.Any())
                            {
                                <div style="font-size:11.5px;font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Kalem Dökümü</div>
                                <table style="width:100%;border-collapse:collapse;font-size:13px;">
                                    <thead>
                                        <tr style="color:var(--color-muted);font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">
                                            <th style="padding:4px 8px;text-align:left;font-weight:600;">Kod</th>
                                            <th style="padding:4px 8px;text-align:left;font-weight:600;">Açıklama</th>
                                            <th style="padding:4px 8px;text-align:right;font-weight:600;">Birim Değer</th>
                                            <th style="padding:4px 8px;text-align:right;font-weight:600;">Çarpan</th>
                                            <th style="padding:4px 8px;text-align:right;font-weight:600;">Tutar</th>
                                            <th style="padding:4px 8px;text-align:right;font-weight:600;">KDV</th>
                                            <th style="padding:4px 8px;text-align:right;font-weight:600;">Toplam</th>
                                            <th style="padding:4px 8px;text-align:center;font-weight:600;">Kaynak</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var k in t.Kalemler.OrderBy(k => k.BorcTipi.Sira))
                                        {
                                            string kaynakCls = k.KaynakTipi switch {
                                                KalemKaynakTipi.TanimsizTarife    => "badge-bos",
                                                KalemKaynakTipi.SozlesmeTarifesi  => "badge-surek",
                                                KalemKaynakTipi.BirimTarifesi     => "badge-kirali",
                                                KalemKaynakTipi.TasinmazTarifesi  => "badge-bireysel",
                                                KalemKaynakTipi.GenelTarife       => "badge-bos",
                                                KalemKaynakTipi.ManuelGiris       => "badge-surek",
                                                KalemKaynakTipi.RezervasyonKurali => "badge-bireysel",
                                                _                                 => "badge-bos"
                                            };
                                            string kaynakLabel = k.KaynakTipi switch {
                                                KalemKaynakTipi.TanimsizTarife    => "Tanımsız Tarife",
                                                KalemKaynakTipi.SozlesmeTarifesi  => "Sözleşme Tarifesi",
                                                KalemKaynakTipi.BirimTarifesi     => "Birim Tarifesi",
                                                KalemKaynakTipi.TasinmazTarifesi  => "Taşınmaz Tarifesi",
                                                KalemKaynakTipi.GenelTarife       => "Genel Tarife",
                                                KalemKaynakTipi.ManuelGiris       => "Manuel Giriş",
                                                KalemKaynakTipi.RezervasyonKurali => "Rezervasyon Kuralı",
                                                _                                 => "Bilinmiyor"
                                            };
                                            <tr style="border-top:1px solid var(--color-border);">
                                                <td style="padding:5px 8px;font-family:monospace;font-weight:700;font-size:12px;">@k.BorcTipi.Kod</td>
                                                <td style="padding:5px 8px;">@k.Aciklama</td>
                                                <td style="padding:5px 8px;text-align:right;">@k.BirimDeger.ToString("N2") ₺@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "/m²" : "")</td>
                                                <td style="padding:5px 8px;text-align:right;color:var(--color-muted);">@k.Carpan.ToString("F2")</td>
                                                <td style="padding:5px 8px;text-align:right;font-weight:600;">@k.Tutar.ToString("N2") ₺</td>
                                                <td style="padding:5px 8px;text-align:right;color:var(--color-muted);">@k.KdvTutari.ToString("N2") ₺</td>
                                                <td style="padding:5px 8px;text-align:right;font-weight:700;">@k.ToplamTutar.ToString("N2") ₺</td>
                                                <td style="padding:5px 8px;text-align:center;"><span class="badge @kaynakCls" style="font-size:11px;">@kaynakLabel</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr style="border-top:2px solid var(--color-border);background:#eef0f4;">
                                            <td colspan="6" style="padding:5px 8px;font-weight:700;font-size:12px;">Toplam</td>
                                            <td style="padding:5px 8px;text-align:right;font-weight:700;">@t.ToplamTutar.ToString("N2") ₺</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }
                            else
                            {
                                <span style="font-size:13px;color:var(--color-muted);">Kalem bilgisi yok (eski tahakkuk).</span>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Total == 0)
                {
                    <tr><td colspan="10" style="text-align:center;color:var(--color-muted);padding:32px;">Filtreye uygun tahakkuk bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
