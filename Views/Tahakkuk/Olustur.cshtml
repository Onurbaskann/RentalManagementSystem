@model KiraTakip.Models.ViewModels.TahakkukOlusturViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Tahakkuk Oluştur";
    var aylar = System.Globalization.CultureInfo.GetCultureInfo("tr-TR").DateTimeFormat.MonthNames
        .Take(12).Select((ad, i) => (Numara: i + 1, Ad: ad)).ToList();
}

<div class="page-header">
    <div>
        <a href="/Tahakkuk" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">← Tahakkuklar</a>
        <div class="page-title">Tahakkuk Oluştur</div>
        <div class="page-subtitle">Aktif sözleşme için aylık tahakkuk kaydı oluşturur.</div>
    </div>
</div>

<div style="max-width:520px;">
    <div class="card">
        <form method="post" action="/Tahakkuk/Olustur">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 14px;border-radius:8px;margin-bottom:18px;font-size:13px;"></div>
            }

            <div class="form-group">
                <label class="form-label">Sözleşme</label>
                <select asp-for="KiraSozlesmesiId" class="form-control">
                    <option value="">— Sözleşme seçin —</option>
                    @foreach (var s in Model.AktifSozlesmeler)
                    {
                        <option value="@s.Id">@s.Kiraci.GosterimAdi — @s.Birim.Tasinmaz.Ad / @s.Birim.Ad</option>
                    }
                </select>
                <span asp-validation-for="KiraSozlesmesiId" class="form-error"></span>
            </div>

            <div class="two-col" style="gap:12px;">
                <div class="form-group">
                    <label class="form-label">Yıl</label>
                    <input asp-for="DonemYil" type="number" class="form-control" min="2000" max="2100" />
                    <span asp-validation-for="DonemYil" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Ay</label>
                    <select asp-for="DonemAy" class="form-control">
                        @foreach (var (numara, ad) in aylar)
                        {
                            <option value="@numara">@ad</option>
                        }
                    </select>
                    <span asp-validation-for="DonemAy" class="form-error"></span>
                </div>
            </div>

            <div style="background:var(--color-bg);border-radius:8px;padding:12px 14px;font-size:13px;color:var(--color-muted);margin-bottom:18px;">
                Vade tarihi, seçilen ayın 1. günü olarak atanır. Kira bedeli sözleşmeden otomatik alınır.
            </div>

            <div style="display:flex;gap:10px;">
                <button type="submit" class="btn btn-primary">Oluştur</button>
                <a href="/Tahakkuk" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
