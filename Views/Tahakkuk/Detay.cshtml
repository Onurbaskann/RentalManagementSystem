@model KiraTakip.Models.KiraTahakkuk
@using KiraTakip.Models
@{
    ViewData["Title"] = $"Tahakkuk #{Model.Id}";
    var s = Model.KiraSozlesmesi;
    var kiraci = s?.Kiraci;
    var birim = s?.Birim;
    var tasinmaz = birim?.Tasinmaz;

    var kalan = Model.ToplamTutar - Model.OdenenTutar;

    string durumCls = Model.Durum switch {
        TahakkukDurumu.TamOdendi    => "badge-kirali",
        TahakkukDurumu.KismenOdendi => "badge-surek",
        TahakkukDurumu.Gecikti      => "badge-gecmis",
        TahakkukDurumu.IptalEdildi  => "badge-bos",
        _                           => "badge-bos"
    };
    string durumLabel = Model.Durum switch {
        TahakkukDurumu.TamOdendi    => "Tam Ödendi",
        TahakkukDurumu.KismenOdendi => "Kısmi Ödendi",
        TahakkukDurumu.Gecikti      => "Gecikti",
        TahakkukDurumu.IptalEdildi  => "İptal Edildi",
        _                           => "Bekleniyor"
    };

    bool canCreate = User.HasClaim("permission", "Odeme.Create");
    bool iptal = Model.Durum == TahakkukDurumu.IptalEdildi;
    bool tamOdendi = Model.Durum == TahakkukDurumu.TamOdendi;
}

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✕ @TempData["Error"]</div>
}

<!-- Breadcrumb -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <a href="/Tahakkuk" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;">← Tahakkuklar</a>
    <div style="display:flex;gap:8px;">
        @if (s != null)
        {
            <a href="/Sozlesme/Detay/@s.Id" class="btn btn-sm btn-secondary">Sözleşme Detayı</a>
        }
        @if (canCreate && !iptal && !tamOdendi)
        {
            <a href="/Odeme/Ekle?tahakkukId=@Model.Id" class="btn btn-sm btn-primary">Ödeme Ekle</a>
        }
    </div>
</div>

<!-- Özet kart -->
<div class="card" style="margin-bottom:16px;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:20px;">
        <div>
            <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">Dönem</div>
            <div style="font-family:'Fraunces',Georgia,serif;font-size:28px;font-weight:700;line-height:1.1;">@Model.DonemBaslangic.ToString("MMMM yyyy")</div>
            <div style="font-size:13px;color:var(--color-muted);margin-top:4px;">
                @Model.DonemBaslangic.ToString("dd.MM.yyyy") — @Model.DonemBitis.ToString("dd.MM.yyyy")
                &nbsp;•&nbsp; Vade: @Model.VadeTarihi.ToString("dd.MM.yyyy")
            </div>
            <div style="margin-top:8px;"><span class="badge @durumCls" style="font-size:12.5px;padding:5px 14px;">@durumLabel</span></div>
        </div>
        <div style="display:flex;gap:24px;flex-wrap:wrap;">
            <div style="text-align:center;">
                <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;margin-bottom:4px;">Beklenen</div>
                <div style="font-size:20px;font-weight:700;">@Model.ToplamTutar.ToString("N2") ₺</div>
            </div>
            <div style="text-align:center;">
                <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;margin-bottom:4px;">Ödenen</div>
                <div style="font-size:20px;font-weight:700;color:#065f46;">@Model.OdenenTutar.ToString("N2") ₺</div>
            </div>
            <div style="text-align:center;">
                <div style="font-size:11.5px;font-weight:600;color:var(--color-muted);text-transform:uppercase;margin-bottom:4px;">Kalan</div>
                <div style="font-size:20px;font-weight:700;color:@(kalan > 0 ? "#ef4444" : "#065f46");">@kalan.ToString("N2") ₺</div>
            </div>
        </div>
    </div>

    <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--color-border);display:flex;gap:32px;flex-wrap:wrap;font-size:13px;">
        <div>
            <span style="color:var(--color-muted);">Kiracı: </span>
            @if (kiraci != null) {
                <a href="/Kiraci/Detay/@kiraci.Id" style="font-weight:600;text-decoration:none;">@kiraci.GosterimAdi</a>
            } else {
                <span style="font-weight:600;">Rezervasyon Sahibi</span>
            }
        </div>
        <div>
            <span style="color:var(--color-muted);">Taşınmaz: </span>
            @if (tasinmaz != null) {
                <a href="/Tasinmaz/Detay/@tasinmaz.Id" style="font-weight:600;text-decoration:none;">@tasinmaz.Ad</a>
            } else {
                <span style="font-weight:600;">Toplantı Salonu</span>
            }
        </div>
        <div>
            <span style="color:var(--color-muted);">Birim: </span>
            <span style="font-weight:600;">@(birim?.Ad ?? "Rezervasyon")</span>
        </div>
        @if (s != null) {
            <div>
                <span style="color:var(--color-muted);">Sözleşme: </span>
                <a href="/Sozlesme/Detay/@s.Id" style="font-weight:600;text-decoration:none;">#@s.Id</a>
            </div>
        }
    </div>
</div>

<!-- Kalem Dökümü -->
<div class="card" style="padding:0;overflow:hidden;margin-bottom:16px;">
    <div style="padding:14px 20px;border-bottom:1px solid var(--color-border);">
        <div style="font-size:14px;font-weight:700;">Kalem Dökümü</div>
        <div style="font-size:12px;color:var(--color-muted);margin-top:2px;">Tahakkuk oluşturulma tarihi: @Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</div>
    </div>
    @if (Model.Kalemler.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width:80px;">Kod</th>
                        <th>Açıklama</th>
                        <th style="width:140px;">Hesaplama</th>
                        <th style="width:150px;text-align:right;">Birim Değer</th>
                        <th style="width:90px;text-align:right;">Çarpan</th>
                        <th style="width:120px;text-align:right;">Tutar</th>
                        <th style="width:100px;text-align:right;">KDV (%)</th>
                        <th style="width:120px;text-align:right;">KDV Tutarı</th>
                        <th style="width:130px;text-align:right;">Toplam</th>
                        <th style="width:90px;text-align:center;">Kaynak</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Kalemler.OrderBy(k => k.BorcTipi.Sira))
                    {
                        string kaynakCls = k.KaynakTipi switch {
                            KalemKaynakTipi.TanimsizTarife    => "badge-bos",
                            KalemKaynakTipi.SozlesmeTarifesi  => "badge-surek",
                            KalemKaynakTipi.BirimTarifesi     => "badge-kirali",
                            KalemKaynakTipi.TasinmazTarifesi  => "badge-bireysel",
                            KalemKaynakTipi.GenelTarife       => "badge-bos",
                            KalemKaynakTipi.ManuelGiris       => "badge-surek",
                            KalemKaynakTipi.RezervasyonKurali => "badge-bireysel",
                            _                                 => "badge-bos"
                        };
                        string kaynakLabel = k.KaynakTipi switch {
                            KalemKaynakTipi.TanimsizTarife    => "Tanımsız Tarife",
                            KalemKaynakTipi.SozlesmeTarifesi  => "Sözleşme Tarifesi",
                            KalemKaynakTipi.BirimTarifesi     => "Birim Tarifesi",
                            KalemKaynakTipi.TasinmazTarifesi  => "Taşınmaz Tarifesi",
                            KalemKaynakTipi.GenelTarife       => "Genel Tarife",
                            KalemKaynakTipi.ManuelGiris       => "Manuel Giriş",
                            KalemKaynakTipi.RezervasyonKurali => "Rezervasyon Kuralı",
                            _                                 => "Bilinmiyor"
                        };
                        string kaynakTip = k.KaynakTipi switch {
                            KalemKaynakTipi.TanimsizTarife    => "Fiyat tanımı bulunamadığı için 0₺ olarak üretildi.",
                            KalemKaynakTipi.SozlesmeTarifesi  => "Sözleşmeye özel tarife fiyatı kullanıldı.",
                            KalemKaynakTipi.BirimTarifesi     => "Birim düzeyinde özel fiyat kullanıldı.",
                            KalemKaynakTipi.TasinmazTarifesi  => "Taşınmaz ve kiracı kategorisine özel matris fiyatı kullanıldı.",
                            KalemKaynakTipi.GenelTarife       => "Genel tarife fiyatı uygulandı.",
                            KalemKaynakTipi.ManuelGiris       => "Kullanıcı tarafından manuel olarak girildi.",
                            KalemKaynakTipi.RezervasyonKurali => "Rezervasyon kuralından aktarıldı.",
                            _                                 => ""
                        };
                        <tr>
                            <td><span style="font-family:monospace;font-weight:700;font-size:12.5px;">@k.BorcTipi.Kod</span></td>
                            <td style="font-weight:500;">@k.Aciklama</td>
                            <td style="font-size:13px;color:var(--color-muted);">
                                @(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "m² Bazlı" : "Sabit")
                            </td>
                            <td style="text-align:right;font-size:13px;">
                                @k.BirimDeger.ToString("N2") ₺@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "/m²" : "")
                            </td>
                            <td style="text-align:right;font-size:13px;color:var(--color-muted);">@k.Carpan.ToString("F2")</td>
                            <td style="text-align:right;font-weight:600;">@k.Tutar.ToString("N2") ₺</td>
                            <td style="text-align:right;font-size:13px;color:var(--color-muted);">%@k.KdvOrani.ToString("G")</td>
                            <td style="text-align:right;font-size:13px;color:var(--color-muted);">@k.KdvTutari.ToString("N2") ₺</td>
                            <td style="text-align:right;font-weight:700;">@k.ToplamTutar.ToString("N2") ₺</td>
                            <td style="text-align:center;"><span class="badge @kaynakCls" style="font-size:11px;" data-tip="@kaynakTip">@kaynakLabel</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:#f0f2f5;font-weight:700;border-top:2px solid var(--color-border);">
                        <td colspan="5" style="padding:10px 14px;font-size:13px;">Toplam</td>
                        <td style="padding:10px 14px;text-align:right;">@Model.BeklenenTutar.ToString("N2") ₺</td>
                        <td></td>
                        <td style="padding:10px 14px;text-align:right;">@Model.KdvTutari.ToString("N2") ₺</td>
                        <td style="padding:10px 14px;text-align:right;font-size:14px;">@Model.ToplamTutar.ToString("N2") ₺</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div style="padding:32px;text-align:center;color:var(--color-muted);">Kalem bilgisi yok (eski tahakkuk).</div>
    }
</div>

<!-- Ödeme Geçmişi -->
<div class="card" style="padding:0;overflow:hidden;">
    <div style="padding:14px 20px;border-bottom:1px solid var(--color-border);">
        <div style="font-size:14px;font-weight:700;">Ödeme Geçmişi</div>
    </div>
    @if (Model.Odemeler.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Ödeme Tarihi</th>
                        <th style="text-align:right;">Tutar</th>
                        <th>Kanal</th>
                        <th>Durum</th>
                        <th>Giriş Tarihi</th>
                        <th>Açıklama</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Odemeler.OrderByDescending(o => o.OdemeTarihi))
                    {
                        string odCls = o.Durum switch {
                            OdemeDurumu.Onaylandi     => "badge-kirali",
                            OdemeDurumu.Reddedildi    => "badge-gecmis",
                            _                         => "badge-bos"
                        };
                        string odLabel = o.Durum switch {
                            OdemeDurumu.Onaylandi  => "Onaylandı",
                            OdemeDurumu.Reddedildi => "Reddedildi",
                            _                      => "Onay Bekliyor"
                        };
                        string kanalLabel = o.OdemeKanali switch {
                            OdemeKanali.Havale => "Havale",
                            OdemeKanali.EFT    => "EFT",
                            OdemeKanali.Nakit  => "Nakit",
                            _                  => "Diğer"
                        };
                        <tr>
                            <td style="font-weight:600;">@o.OdemeTarihi.ToString("dd.MM.yyyy")</td>
                            <td style="text-align:right;font-weight:700;@(o.Durum == OdemeDurumu.Onaylandi ? "color:#065f46;" : "")">@o.Tutar.ToString("N2") ₺</td>
                            <td style="font-size:13px;">@kanalLabel</td>
                            <td><span class="badge @odCls">@odLabel</span></td>
                            <td style="font-size:12px;color:var(--color-muted);">@o.GirisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td style="font-size:13px;color:var(--color-muted);">@o.Aciklama</td>
                            <td><a href="/Odeme/Detay/@o.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding:32px;text-align:center;color:var(--color-muted);">
            Bu dönem için henüz ödeme kaydı yok.
            @if (canCreate && !iptal && !tamOdendi)
            {
                <div style="margin-top:12px;"><a href="/Odeme/Ekle?tahakkukId=@Model.Id" class="btn btn-primary btn-sm">Ödeme Ekle</a></div>
            }
        </div>
    }
</div>
