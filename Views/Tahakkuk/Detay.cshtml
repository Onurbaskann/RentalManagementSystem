@model TahakkukDetayDto
@using KiraTakip.Models
@{
    ViewData["Title"] = $"Tahakkuk #{Model.Id}";

    var kalan = Model.ToplamTutar - Model.OdenenTutar;

    string durumCls = Model.Durum switch {
        TahakkukDurumu.TamOdendi    => "badge-kirali",
        TahakkukDurumu.KismenOdendi => "badge-surek",
        TahakkukDurumu.Gecikti      => "badge-gecmis",
        TahakkukDurumu.IptalEdildi  => "badge-bos",
        _                           => "badge-bos"
    };
    string durumLabel = Model.Durum switch {
        TahakkukDurumu.TamOdendi    => "Tam Ödendi",
        TahakkukDurumu.KismenOdendi => "Kısmi Ödendi",
        TahakkukDurumu.Gecikti      => "Gecikti",
        TahakkukDurumu.IptalEdildi  => "İptal Edildi",
        _                           => "Bekleniyor"
    };

    bool canCreate = User.HasPermission(PermissionCatalog.Odeme.Create);
    bool iptal = Model.Durum == TahakkukDurumu.IptalEdildi;
    bool tamOdendi = Model.Durum == TahakkukDurumu.TamOdendi;
}

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 px-4 rounded-lg mb-4 text-[13.5px]">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 px-4 rounded-lg mb-4 text-[13.5px]">✕ @TempData["Error"]</div>
}

<!-- Breadcrumb -->
<div class="flex items-center justify-between mb-5">
    <a href="/Tahakkuk" class="text-[12.5px] text-muted no-underline hover:text-primary transition-colors">← Tahakkuklar</a>
    <div class="flex gap-2">
        @if (Model.KiraSozlesmesiId != null)
        {
            <a href="/Sozlesme/Detay/@Model.KiraSozlesmesiId" class="btn btn-sm btn-secondary">Sözleşme Detayı</a>
        }
        @if (canCreate && !iptal && !tamOdendi)
        {
            <a href="/Odeme/Ekle?tahakkukId=@Model.Id" class="btn btn-sm btn-primary">Ödeme Ekle</a>
        }
    </div>
</div>

<!-- Özet kart -->
<div class="card mb-4">
    <div class="flex items-start justify-between flex-wrap gap-5">
        <div>
            <div class="text-[11.5px] font-bold text-muted uppercase tracking-wider mb-1.5">Dönem</div>
            <div class="font-serif text-[28px] font-bold leading-tight">@Model.DonemBaslangic.ToString("MMMM yyyy")</div>
            <div class="text-[13px] text-muted mt-1">
                @Model.DonemBaslangic.ToString("dd.MM.yyyy") — @Model.DonemBitis.ToString("dd.MM.yyyy")
                &nbsp;•&nbsp; Vade: @Model.VadeTarihi.ToString("dd.MM.yyyy")
            </div>
            <div class="mt-2"><span class="badge @durumCls text-[12.5px] px-3.5 py-1.5">@durumLabel</span></div>
        </div>
        <div class="flex gap-6 flex-wrap">
            <div class="text-center">
                <div class="text-[11.5px] font-bold text-muted uppercase mb-1">Beklenen</div>
                <div class="text-xl font-bold">@Model.ToplamTutar.ToString("N2") ₺</div>
            </div>
            <div class="text-center">
                <div class="text-[11.5px] font-bold text-muted uppercase mb-1">Ödenen</div>
                <div class="text-xl font-bold text-emerald-800">@Model.OdenenTutar.ToString("N2") ₺</div>
            </div>
            <div class="text-center">
                <div class="text-[11.5px] font-bold text-muted uppercase mb-1">Kalan</div>
                <div class="text-xl font-bold @(kalan > 0 ? "text-red-500" : "text-emerald-800")">@kalan.ToString("N2") ₺</div>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-3.5 border-t border-[var(--color-border)] flex gap-8 flex-wrap text-[13px]">
        <div>
            <span class="text-muted">Kiracı: </span>
            @if (Model.KiraciId != null) {
                <a href="/Kiraci/Detay/@Model.KiraciId" class="font-semibold no-underline hover:underline">@Model.KiraciGosterimAdi</a>
            } else {
                <span class="font-semibold">Rezervasyon Sahibi</span>
            }
        </div>
        <div>
            <span class="text-muted">Taşınmaz: </span>
            @if (Model.TasinmazId != null) {
                <a href="/Tasinmaz/Detay/@Model.TasinmazId" class="font-semibold no-underline hover:underline">@Model.TasinmazAd</a>
            } else {
                <span class="font-semibold">Toplantı Salonu</span>
            }
        </div>
        <div>
            <span class="text-muted">Birim: </span>
            <span class="font-semibold">@(Model.BirimAd ?? "Rezervasyon")</span>
        </div>
        @if (Model.KiraSozlesmesiId != null) {
            <div>
                <span class="text-muted">Sözleşme: </span>
                <a href="/Sozlesme/Detay/@Model.KiraSozlesmesiId" class="font-semibold no-underline hover:underline">#@Model.KiraSozlesmesiId</a>
            </div>
        }
    </div>
</div>

<!-- Kalem Dökümü -->
<div class="card p-0 overflow-hidden mb-4">
    <div class="p-[14px_20px] border-b border-[var(--color-border)]">
        <div class="text-sm font-bold">Kalem Dökümü</div>
        <div class="text-xs text-muted mt-0.5">Tahakkuk oluşturulma tarihi: @Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</div>
    </div>
    @if (Model.Kalemler.Any())
    {
        <div class="overflow-hidden rounded-lg border border-slate-200 bg-white m-4">
            <table class="w-full text-xs">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-slate-500 font-bold uppercase tracking-wider text-[9px]">
                        <th class="p-2 px-3 text-left">Açıklama</th>
                        <th class="p-2 px-3 text-left">Hesaplama</th>
                        <th class="p-2 px-3 text-right">Birim</th>
                        <th class="p-2 px-3 text-right">Tutar</th>
                        <th class="p-2 px-3 text-right text-muted">KDV (%)</th>
                        <th class="p-2 px-3 text-right text-muted">KDV Tutarı</th>
                        <th class="p-2 px-3 text-right">Toplam</th>
                        <th class="p-2 px-3 text-center">Kaynak</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Kalemler.OrderBy(k => k.BorcTipiSira))
                    {
                        string kaynakCls = k.KaynakTipi switch {
                            KalemKaynakTipi.TanimsizTarife    => "badge-bos",
                            KalemKaynakTipi.SozlesmeTarifesi  => "badge-surek",
                            KalemKaynakTipi.BirimTarifesi     => "badge-kirali",
                            KalemKaynakTipi.TasinmazTarifesi  => "badge-bireysel",
                            KalemKaynakTipi.GenelTarife       => "badge-bos",
                            KalemKaynakTipi.ManuelGiris       => "badge-surek",
                            KalemKaynakTipi.RezervasyonKurali => "badge-bireysel",
                            _                                 => "badge-bos"
                        };
                        string kaynakLabel = k.KaynakTipi switch {
                            KalemKaynakTipi.TanimsizTarife    => "Tanımsız Tarife",
                            KalemKaynakTipi.SozlesmeTarifesi  => "Sözleşme Tarifesi",
                            KalemKaynakTipi.BirimTarifesi     => "Birim Tarifesi",
                            KalemKaynakTipi.TasinmazTarifesi  => "Taşınmaz Tarifesi",
                            KalemKaynakTipi.GenelTarife       => "Genel Tarife",
                            KalemKaynakTipi.ManuelGiris       => "Manuel Giriş",
                            KalemKaynakTipi.RezervasyonKurali => "Rezervasyon Kuralı",
                            _                                 => "Bilinmiyor"
                        };
                        string kaynakTip = k.KaynakTipi switch {
                            KalemKaynakTipi.TanimsizTarife    => "Fiyat tanımı bulunamadığı için 0₺ olarak üretildi.",
                            KalemKaynakTipi.SozlesmeTarifesi  => "Sözleşmeye özel tarife fiyatı kullanıldı.",
                            KalemKaynakTipi.BirimTarifesi     => "Birim düzeyinde özel fiyat kullanıldı.",
                            KalemKaynakTipi.TasinmazTarifesi  => "Taşınmaz ve kiracı kategorisine özel matris fiyatı kullanıldı.",
                            KalemKaynakTipi.GenelTarife       => "Genel tarife fiyatı uygulandı.",
                            KalemKaynakTipi.ManuelGiris       => "Kullanıcı tarafından manuel olarak girildi.",
                            KalemKaynakTipi.RezervasyonKurali => "Rezervasyon kuralından aktarıldı.",
                            _                                 => ""
                        };
                        <tr class="border-t border-slate-100 last:border-0 hover:bg-slate-50/50 transition-colors">
                            <td class="p-2 px-3 text-slate-600 font-medium">@k.Aciklama</td>
                            <td class="p-2 px-3 text-slate-400">@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "m² Bazlı" : "Sabit")</td>
                            <td class="p-2 px-3 text-right text-slate-500">@k.BirimDeger.ToString("N2") ₺@(k.HesaplamaYontemi == HesaplamaYontemi.M2 ? "/m²" : "")</td>
                            <td class="p-2 px-3 text-right font-semibold text-slate-600">@k.Tutar.ToString("N2") ₺</td>
                            <td class="p-2 px-3 text-right text-slate-400/60">%@k.KdvOrani.ToString("G")</td>
                            <td class="p-2 px-3 text-right text-slate-400/60">@k.KdvTutari.ToString("N2") ₺</td>
                            <td class="p-2 px-3 text-right font-bold text-slate-700">@k.ToplamTutar.ToString("N2") ₺</td>
                            <td class="p-2 px-3 text-center"><span class="badge @kaynakCls text-[11px]" data-tip="@kaynakTip">@kaynakLabel</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-slate-50 border-t-2 border-slate-200">
                    <tr class="font-bold text-[9px] uppercase tracking-wider text-slate-500">
                        <td colspan="3" class="p-2 px-3">Toplam</td>
                        <td class="p-2 px-3 text-right text-slate-600">@Model.BeklenenTutar.ToString("N2") ₺</td>
                        <td></td>
                        <td class="p-2 px-3 text-right text-slate-400/60">@Model.KdvTutari.ToString("N2") ₺</td>
                        <td class="p-2 px-3 text-right text-slate-700">@Model.ToplamTutar.ToString("N2") ₺</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="p-8 text-center text-muted">Kalem bilgisi yok (eski tahakkuk).</div>
    }
</div>

<!-- Ödeme Geçmişi -->
<div class="card p-0 overflow-hidden">
    <div class="p-[14px_20px] border-b border-[var(--color-border)]">
        <div class="text-sm font-bold">Ödeme Geçmişi</div>
    </div>
    @if (Model.Odemeler.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Ödeme Tarihi</th>
                        <th class="text-right">Tutar</th>
                        <th>Kanal</th>
                        <th>Durum</th>
                        <th>Giriş Tarihi</th>
                        <th>Açıklama</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Odemeler.OrderByDescending(o => o.OdemeTarihi))
                    {
                        string odCls = o.Durum switch {
                            OdemeDurumu.Onaylandi     => "badge-kirali",
                            OdemeDurumu.Reddedildi    => "badge-gecmis",
                            _                         => "badge-bos"
                        };
                        string odLabel = o.Durum switch {
                            OdemeDurumu.Onaylandi  => "Onaylandı",
                            OdemeDurumu.Reddedildi => "Reddedildi",
                            _                      => "Onay Bekliyor"
                        };
                        string kanalLabel = o.OdemeKanali switch {
                            OdemeKanali.Havale => "Havale",
                            OdemeKanali.EFT    => "EFT",
                            OdemeKanali.Nakit  => "Nakit",
                            _                  => "Diğer"
                        };
                        <tr>
                            <td class="font-semibold">@o.OdemeTarihi.ToString("dd.MM.yyyy")</td>
                            <td class="text-right font-bold @(o.Durum == OdemeDurumu.Onaylandi ? "text-emerald-800" : "")">@o.Tutar.ToString("N2") ₺</td>
                            <td class="text-[13px]">@kanalLabel</td>
                            <td><span class="badge @odCls">@odLabel</span></td>
                            <td class="text-[12px] text-muted">@o.GirisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-[13px] text-muted">@o.Aciklama</td>
                            <td><a href="/Odeme/Detay/@o.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-8 text-center text-muted">
            <div class="mb-3">Bu dönem için henüz ödeme kaydı yok.</div>
            @if (canCreate && !iptal && !tamOdendi)
            {
                <a href="/Odeme/Ekle?tahakkukId=@Model.Id" class="btn btn-primary btn-sm">Ödeme Ekle</a>
            }
        </div>
    }
</div>
