@model KiraTakip.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Anasayfa";
    bool canEdit = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Sozlesme.Create);

    string TLFormat(decimal v) => v.ToString("N2") + " ₺";

    string DayBadgeCls(int gun) => gun <= 10 ? "day-badge-red" : gun <= 30 ? "day-badge-amber" : "day-badge-green";

    int toplamBirim = Model.KiraliBirim + Model.BosBirim + Model.SuresiDolmakUzereBirim;
    double kiraliPct = toplamBirim > 0 ? (double)Model.KiraliBirim / toplamBirim * 100 : 0;
    double surekPct = toplamBirim > 0 ? (double)Model.SuresiDolmakUzereBirim / toplamBirim * 100 : 0;
    double bosPct = toplamBirim > 0 ? (double)Model.BosBirim / toplamBirim * 100 : 0;
}

<div class="page-header">
    <div class="page-title">Genel Bakış</div>
    <div class="page-subtitle text-muted">Tüm taşınmazlarınızın özet durumu</div>
</div>

<!-- İstatistik Kartları -->
<div class="stats-grid">
    <div class="card">
        <div class="card-title">Toplam Taşınmaz</div>
        <div class="card-value">@Model.ToplamTasinmaz</div>
        <div class="card-sub text-muted">
            @string.Join(", ", Model.TipiDagilim.Select(kv => $"{kv.Value} {kv.Key}"))
        </div>
    </div>

    <div class="card">
        <div class="card-title">Toplam Birim</div>
        <div class="card-value">@Model.ToplamBirim</div>
        <div class="card-sub mt-2.5">
            <div class="flex gap-1.5 text-[11px] mb-1.5">
                <span class="badge badge-kirali">@Model.KiraliBirim Kiralı</span>
                <span class="badge badge-bos">@Model.BosBirim Boş</span>
                <span class="badge badge-surek">@Model.SuresiDolmakUzereBirim Dolmak Üzere</span>
            </div>
            <div class="progress-bar h-1.5 rounded-full overflow-hidden flex">
                <div class="bg-[#10b981]" style="width:@kiraliPct.ToString("F0")%"></div>
                <div class="bg-[#f59e0b]" style="width:@surekPct.ToString("F0")%"></div>
                <div class="bg-[#cbd5e1]" style="width:@bosPct.ToString("F0")%"></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-title">Aktif Sözleşme</div>
        <div class="card-value">@Model.AktifSozlesme</div>
        <div class="card-sub text-muted">Bu ay yenilenmesi gereken: <strong class="text-[var(--color-primary)]">@Model.BuAyYenilenecek</strong></div>
    </div>

    <div class="card">
        <div class="card-title">Aylık Kira Geliri</div>
        <div class="card-value text-[22px]">@TLFormat(Model.AylikToplamGelir)</div>
        <div class="card-sub text-muted">Tüm aktif sözleşmeler</div>
    </div>

    <div class="card">
        <div class="card-title">Yıllık Projeksiyon</div>
        <div class="card-value text-[22px]">@TLFormat(Model.YillikProj)</div>
        <div class="card-sub text-muted">Mevcut sözleşme bazlı</div>
    </div>
</div>

<!-- Ödeme KPI'ları -->
@if (Model.HasOdemeAccess)
{
    decimal kalanTahsilat = Model.BuAyBeklenenTahsilat - Model.BuAyTahsilEdilen;
    double tahsilPct = Model.BuAyBeklenenTahsilat > 0 ? (double)(Model.BuAyTahsilEdilen / Model.BuAyBeklenenTahsilat * 100) : 0;

    <div class="mb-6">
        <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">Ödeme Durumu</div>
        <div class="stats-grid">
            <!-- Bu Ay Tahsilat -->
            <div class="card">
                <div class="card-title">Bu Ay Beklenen Tahsilat</div>
                <div class="card-value text-[22px]">@TLFormat(Model.BuAyBeklenenTahsilat)</div>
                <div class="card-sub mt-2">
                    <div class="flex justify-between text-[11.5px] mb-1">
                        <span>Tahsil Edilen</span>
                        <span class="font-semibold text-[#10b981]">@TLFormat(Model.BuAyTahsilEdilen)</span>
                    </div>
                    <div class="progress-bar h-1.5 rounded-full overflow-hidden bg-[#f1f5f9]">
                        <div class="progress-fill h-full bg-[#10b981]" style="width:@Math.Min(tahsilPct,100).ToString("F0")%"></div>
                    </div>
                    @if (kalanTahsilat > 0)
                    {
                        <div class="text-[11px] text-muted mt-1">Kalan: @TLFormat(kalanTahsilat)</div>
                    }
                </div>
            </div>

            <!-- Gecikmiş -->
            <div class="card @(Model.GecikmisTahakkukAdet > 0 ? "border-l-4 border-red-500" : "")">
                <div class="card-title">Gecikmiş Tahakkuk</div>
                <div class="card-value @(Model.GecikmisTahakkukAdet > 0 ? "text-red-500" : "")">@Model.GecikmisTahakkukAdet</div>
                <div class="card-sub">
                    @if (Model.GecikmisTahakkukAdet > 0)
                    {
                        <span class="text-red-500 font-semibold">@TLFormat(Model.GecikmisTutarToplam)</span><span class="text-muted"> bekliyor</span>
                        <div class="mt-1.5"><a href="/Tahakkuk?durum=gecikti" class="text-xs text-red-500 no-underline hover:underline">Görüntüle →</a></div>
                    }
                    else
                    {
                        <span class="text-[#10b981]">Gecikmiş ödeme yok</span>
                    }
                </div>
            </div>

            <!-- Onay Bekleyen -->
            <div class="card @(Model.OnayBekleyenOdemeAdet > 0 ? "border-l-4 border-amber-500" : "")">
                <div class="card-title">Onay Bekleyen Ödeme</div>
                <div class="card-value @(Model.OnayBekleyenOdemeAdet > 0 ? "text-amber-500" : "")">@Model.OnayBekleyenOdemeAdet</div>
                <div class="card-sub">
                    @if (Model.OnayBekleyenOdemeAdet > 0)
                    {
                        <a href="/Odeme?durum=onaybekliyor" class="text-xs text-amber-500 no-underline hover:underline">İncele →</a>
                    }
                    else
                    {
                        <span class="text-muted">Bekleyen yok</span>
                    }
                </div>
            </div>

            <!-- Eşleşmemiş Banka Hareketi -->
            <div class="card @(Model.EslesmemisHareketAdet > 0 ? "border-l-4 border-indigo-500" : "")">
                <div class="card-title">Eşleşmemiş Banka Hareketi</div>
                <div class="card-value @(Model.EslesmemisHareketAdet > 0 ? "text-indigo-500" : "")">@Model.EslesmemisHareketAdet</div>
                <div class="card-sub">
                    @if (Model.EslesmemisHareketAdet > 0)
                    {
                        <a href="/BankaHareketi?durum=eslestirilmedi" class="text-xs text-indigo-500 no-underline hover:underline">Eşleştir →</a>
                    }
                    else
                    {
                        <span class="text-muted">Tümü eşleştirildi</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Rezervasyon ve Manuel Borç Metrikleri -->
@if (Model.HasOdemeAccess && (Model.BuAyManuelBorcToplami > 0 || Model.BuAyRezervasyonGeliri > 0 || Model.TahakkukaAktarilmamisRezervasyonAdet > 0))
{
    <div class="mb-6">
        <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">Rezervasyon & Manuel Borç</div>
        <div class="stats-grid">
            <div class="card">
                <div class="card-title">Bu Ay Manuel Borç</div>
                <div class="card-value text-[22px]">@TLFormat(Model.BuAyManuelBorcToplami)</div>
                <div class="card-sub">
                    <a href="/ManuelBorc" class="text-xs text-muted no-underline hover:underline">Tüm manuel borçlar →</a>
                </div>
            </div>

            <div class="card">
                <div class="card-title">Bu Ay Rezervasyon Geliri</div>
                <div class="card-value text-[22px]">@TLFormat(Model.BuAyRezervasyonGeliri)</div>
                <div class="card-sub">
                    <a href="/Rezervasyon" class="text-xs text-muted no-underline hover:underline">Tüm rezervasyonlar →</a>
                </div>
            </div>

            <div class="card @(Model.TahakkukaAktarilmamisRezervasyonAdet > 0 ? "border-l-4 border-amber-500" : "")">
                <div class="card-title">Aktarılmamış Ücretli Rezervasyon</div>
                <div class="card-value @(Model.TahakkukaAktarilmamisRezervasyonAdet > 0 ? "text-[#b45309]" : "")">@Model.TahakkukaAktarilmamisRezervasyonAdet</div>
                <div class="card-sub">
                    @if (Model.TahakkukaAktarilmamisRezervasyonAdet > 0)
                    {
                        <a href="/Rezervasyon" class="text-xs text-[#b45309] no-underline hover:underline">Tahakkuka aktar →</a>
                    }
                    else
                    {
                        <span class="text-muted">Bekleyen yok</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- İki Kolon: Süresi Dolmak Üzere + Boş Birimler -->
<div class="two-col mb-6">
    <!-- Sol: Süresi Dolmak Üzere -->
    <div class="card p-0 overflow-hidden">
        <div class="p-[18px_20px_14px] border-b border-[var(--color-border)] flex items-center justify-between">
            <div class="section-title">⏰ Süresi Dolmak Üzere</div>
            <a href="/Sozlesme?filtre=surek" class="btn btn-sm btn-secondary">Tümü</a>
        </div>
        @if (!Model.SuresiDolmakUzere.Any())
        {
            <div class="p-[32px_20px] text-center text-muted text-[13.5px]">Yakında dolacak sözleşme yok.</div>
        }
        else
        {
            <div>
                @foreach (var s in Model.SuresiDolmakUzere)
                {
                    <a href="/Sozlesme/Detay/@s.SozlesmeId" class="flex items-center justify-between p-[14px_20px] border-b border-[#f1f3f5] last:border-b-0 no-underline text-inherit transition-colors hover:bg-[#fafbfc]">
                        <div>
                            <div class="text-[13.5px] font-semibold">@s.KiraciAdi</div>
                            <div class="text-xs text-muted mt-0.5">@s.TasinmazAdi — @s.BirimAdi</div>
                            <div class="text-[11.5px] text-muted">Bitiş: @s.BitisTarihi.ToString("dd.MM.yyyy")</div>
                        </div>
                        <span class="day-badge @DayBadgeCls(s.KalanGun)">@s.KalanGun gün</span>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Sağ: Boş Birimler -->
    <div class="card p-0 overflow-hidden">
        <div class="p-[18px_20px_14px] border-b border-[var(--color-border)] flex items-center justify-between">
            <div class="section-title">🏢 Boş Birimler</div>
            @if (canEdit) { <a href="/Sozlesme/Ekle" class="btn btn-sm btn-primary">Kiraya Ver</a> }
        </div>
        @if (!Model.BosBirimler.Any())
        {
            <div class="p-[32px_20px] text-center text-muted text-[13.5px]">Tüm birimler kiralı!</div>
        }
        else
        {
            <div>
                @foreach (var b in Model.BosBirimler)
                {
                    <a href="/Sozlesme/Ekle?birimId=@b.BirimId" class="flex items-center justify-between p-[14px_20px] border-b border-[#f1f3f5] last:border-b-0 no-underline text-inherit transition-colors hover:bg-[#fafbfc]">
                        <div>
                            <div class="text-[13.5px] font-semibold">@b.TasinmazAdi</div>
                            <div class="text-xs text-muted mt-0.5">@b.BirimAdi • @b.Ilce</div>
                            <div class="text-[11.5px] text-muted">@b.Yuzolcumu m²</div>
                        </div>
                        <span class="badge badge-bos">Boş</span>
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- Doluluk Grafiği -->
<div class="card">
    <div class="section-header mb-5">
        <div class="section-title">Doluluk Dağılımı</div>
        <span class="text-[12.5px] text-muted">Birim bazında</span>
    </div>
    <div class="flex flex-col md:flex-row items-center gap-12">
        <!-- Donut Chart -->
        <div class="flex-shrink-0 relative w-40 h-40">
            <svg width="160" height="160" viewBox="0 0 160 160">
                @{
                    double total = Model.KiraliBirim + Model.SuresiDolmakUzereBirim + Model.BosBirim;
                    if (total == 0) { total = 1; }
                    double r = 60; double cx = 80; double cy = 80; double strokeW = 22;
                    double gap = 2;

                    double kiralAngle = (double)Model.KiraliBirim / total * 360;
                    double surekAngle = (double)Model.SuresiDolmakUzereBirim / total * 360;
                    double bosAngle = (double)Model.BosBirim / total * 360;

                    double Rad(double deg) => deg * Math.PI / 180;
                    string Arc(double startDeg, double sweepDeg, string color) {
                        if (sweepDeg <= 0) return "";
                        double endDeg = startDeg + sweepDeg - gap;
                        double x1 = cx + r * Math.Cos(Rad(startDeg - 90));
                        double y1 = cy + r * Math.Sin(Rad(startDeg - 90));
                        double x2 = cx + r * Math.Cos(Rad(endDeg - 90));
                        double y2 = cy + r * Math.Sin(Rad(endDeg - 90));
                        int large = sweepDeg - gap > 180 ? 1 : 0;
                        return FormattableString.Invariant($"<path d='M {x1:F2} {y1:F2} A {r} {r} 0 {large} 1 {x2:F2} {y2:F2}' fill='none' stroke='{color}' stroke-width='{strokeW}' stroke-linecap='round'/>");
                    }

                    double start = 0;
                    string arcKirali = Arc(start, kiralAngle, "#10b981"); start += kiralAngle;
                    string arcSurek = Arc(start, surekAngle, "#f59e0b"); start += surekAngle;
                    string arcBos = Arc(start, bosAngle, "#cbd5e1");
                }
                @Html.Raw(arcKirali)
                @Html.Raw(arcSurek)
                @Html.Raw(arcBos)
                <text x="80" y="74" text-anchor="middle" dominant-baseline="middle" class="text-2xl font-bold fill-[#1a2332] font-serif">@Model.ToplamBirim</text>
                <text x="80" y="95" text-anchor="middle" dominant-baseline="middle" class="text-[11px] fill-[#6b7c93]">Birim</text>
            </svg>
        </div>

        <!-- Legend -->
        <div class="flex flex-col gap-3.5">
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-[#10b981] flex-shrink-0"></div>
                <div>
                    <div class="text-[13.5px] font-semibold">Kiralı</div>
                    <div class="text-xs text-muted">@Model.KiraliBirim birim • %@kiraliPct.ToString("F0")</div>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-[#f59e0b] flex-shrink-0"></div>
                <div>
                    <div class="text-[13.5px] font-semibold">Süresi Dolmak Üzere</div>
                    <div class="text-xs text-muted">@Model.SuresiDolmakUzereBirim birim • %@surekPct.ToString("F0")</div>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-[#cbd5e1] flex-shrink-0"></div>
                <div>
                    <div class="text-[13.5px] font-semibold">Boş</div>
                    <div class="text-xs text-muted">@Model.BosBirim birim • %@bosPct.ToString("F0")</div>
                </div>
            </div>
        </div>

        <!-- Bar grafik -->
        <div class="flex-1 max-w-[400px] w-full">
            <div class="mb-3">
                <div class="flex justify-between text-[12.5px] font-medium mb-1">
                    <span>Kiralı</span><span>@Model.KiraliBirim/@Model.ToplamBirim</span>
                </div>
                <div class="progress-bar h-1.5 rounded-full overflow-hidden bg-[#f1f5f9]">
                    <div class="progress-fill h-full bg-[#10b981]" style="width:@kiraliPct.ToString("F0")%"></div>
                </div>
            </div>
            <div class="mb-3">
                <div class="flex justify-between text-[12.5px] font-medium mb-1">
                    <span>Süresi Dolmak Üzere</span><span>@Model.SuresiDolmakUzereBirim/@Model.ToplamBirim</span>
                </div>
                <div class="progress-bar h-1.5 rounded-full overflow-hidden bg-[#f1f5f9]">
                    <div class="progress-fill h-full bg-[#10b981]" style="width:@surekPct.ToString("F0")%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-[12.5px] font-medium mb-1">
                    <span>Boş</span><span>@Model.BosBirim/@Model.ToplamBirim</span>
                </div>
                <div class="progress-bar h-1.5 rounded-full overflow-hidden bg-[#f1f5f9]">
                    <div class="progress-fill h-full bg-[#cbd5e1]" style="width:@bosPct.ToString("F0")%"></div>
                </div>
            </div>
        </div>
    </div>
</div>
