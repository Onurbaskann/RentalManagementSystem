@model KiraTakip.Models.ViewModels.AdminKullaniciIndexViewModel
@using KiraTakip.Models.Entities
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

@if (TempData["Success"] != null)
{
    <div class="alert-success mb-4">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-danger mb-4">✕ @TempData["Error"]</div>
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Kullanıcı Yönetimi</div>
    </div>
    <a href="/Admin/Kullanicilar/Davet" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Davet Gönder
    </a>
</div>

<div x-data="{ tab: 'ic' }">
    <div class="flex gap-1 border-b border-gray-200 mb-4">
        <button type="button"
                class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
                :class="tab === 'ic' ? 'border-primary text-primary' : 'border-transparent text-muted hover:text-gray-700'"
                @@click="tab = 'ic'">
            İç Kullanıcılar
            <span class="ml-1.5 text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded-full">@Model.IcKullanicilar.Count</span>
        </button>
        <button type="button"
                class="px-4 py-2 text-sm font-medium border-b-2 transition-colors"
                :class="tab === 'kiraci' ? 'border-primary text-primary' : 'border-transparent text-muted hover:text-gray-700'"
                @@click="tab = 'kiraci'">
            Kiracı Kullanıcıları
            <span class="ml-1.5 text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded-full">@Model.KiraciKullanicilar.Count</span>
        </button>
    </div>

    @* İç Kullanıcılar *@
    <div x-show="tab === 'ic'" x-data="clientTable({ pageSize: 25 })" x-init="init()">
        <div class="card p-0 overflow-hidden">
            <div class="table-toolbar">
                <input type="search" class="form-control toolbar-search" placeholder="Ara: ad, e-posta, rol…" x-model.debounce.250ms="q" />
                <span class="pagination-info ml-auto"><span x-text="total"></span> kayıt</span>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>E-posta</th>
                            <th>Rol</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody x-ref="tbody">
                        @foreach (var u in Model.IcKullanicilar)
                        {
                            var search = $"{u.AdSoyad} {u.Email} {u.Rol}".ToLower();
                            <tr data-row data-search="@search">
                                <td class="font-semibold">@u.AdSoyad</td>
                                <td class="text-sm text-muted">@u.Email</td>
                                <td>
                                    @{
                                        string rolCls = u.Rol switch {
                                            "Admin" => "badge-kurumsal",
                                            "Yonetici" => "badge-kirali",
                                            _ => "badge-bos"
                                        };
                                        string rolLabel = u.Rol switch {
                                            _ => u.Rol
                                        };
                                    }
                                    <span class="badge @rolCls">@rolLabel</span>
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    { <span class="badge badge-kirali">Aktif</span> }
                                    else
                                    { <span class="badge badge-gecmis">Pasif</span> }
                                </td>
                                <td class="flex gap-1.5 justify-end">
                                    <a href="/Admin/Kullanicilar/Duzenle/@u.Id" class="btn btn-sm btn-secondary">Düzenle</a>
                                    <form method="post" action="/Admin/Kullanicilar/DurumDegistir/@u.Id"
                                          data-confirm="@(u.IsActive ? "Kullanıcı pasif yapılsın mı? Oturum açamaz." : "Kullanıcı aktif yapılsın mı?")" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-danger" : "btn-amber")">
                                            @(u.IsActive ? "Pasif Yap" : "Aktif Yap")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-wrap" x-show="totalPages > 1">
                <div class="pagination-info"><span x-text="from"></span>–<span x-text="to"></span> / <strong x-text="total"></strong></div>
                <nav class="pagination" aria-label="Sayfalar">
                    <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === 1 }" :disabled="page === 1" @@click="prev()">‹</button>
                    <template x-for="p in pageList" :key="p">
                        <button type="button" class="page-btn" :class="{ 'page-btn-active': p === page }" @@click="goto(p)" x-text="p"></button>
                    </template>
                    <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === totalPages }" :disabled="page === totalPages" @@click="next()">›</button>
                </nav>
            </div>
            <div class="pagination-wrap" x-show="total === 0 && q.length > 0" x-cloak>
                <div class="pagination-info m-auto">Aramaya uyan kayıt yok.</div>
            </div>
        </div>

        @if (Model.BekleyenDavetler.Any())
        {
            <div class="mt-6">
                <div class="page-header">
                    <div class="page-title text-base">Bekleyen Davetler</div>
                    <div class="page-subtitle">@Model.BekleyenDavetler.Count adet gönderilmiş, yanıt bekleyen davet</div>
                </div>
                <div class="card p-0 overflow-hidden">
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>E-posta</th>
                                    <th>Ad Soyad</th>
                                    <th>Son Geçerlilik</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.BekleyenDavetler)
                                {
                                    <tr>
                                        <td>@d.Email</td>
                                        <td class="text-sm text-muted">@(d.AdSoyad ?? "—")</td>
                                        <td class="text-sm text-muted">@d.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="flex gap-1.5 justify-end">
                                            <form method="post" action="/Admin/Kullanicilar/DavetYenidenGonder/@d.Id" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-secondary">Yeniden Gönder</button>
                                            </form>
                                            <form method="post" action="/Admin/Kullanicilar/DavetIptal/@d.Id"
                                                  data-confirm="Bu daveti iptal etmek istediğinizden emin misiniz?" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">İptal Et</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Kiracı Kullanıcıları *@
    <div x-show="tab === 'kiraci'" x-cloak x-data="clientTable({ pageSize: 25 })" x-init="init()">
        <div class="card p-0 overflow-hidden">
            <div class="table-toolbar">
                <input type="search" class="form-control toolbar-search" placeholder="Ara: ad, e-posta, kiracı…" x-model.debounce.250ms="q" />
                <span class="pagination-info ml-auto"><span x-text="total"></span> kayıt</span>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>E-posta</th>
                            <th>Kiracı</th>
                            <th>Rol</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody x-ref="tbody">
                        @foreach (var u in Model.KiraciKullanicilar)
                        {
                            var search = $"{u.AdSoyad} {u.Email} {u.KiraciAd} {u.RolAd}".ToLower();
                            <tr data-row data-search="@search">
                                <td class="font-semibold">@u.AdSoyad</td>
                                <td class="text-sm text-muted">@u.Email</td>
                                <td>
                                    <a href="/Admin/Kiracilar/@u.KiraciId/Kullanicilar" class="text-sm text-primary hover:underline">@u.KiraciAd</a>
                                </td>
                                <td><span class="badge badge-bos">@u.RolAd</span></td>
                                <td>
                                    @if (u.IsActive)
                                    { <span class="badge badge-kirali">Aktif</span> }
                                    else
                                    { <span class="badge badge-gecmis">Pasif</span> }
                                </td>
                                <td class="text-right">
                                    <a href="/Admin/Kiracilar/@u.KiraciId/Kullanicilar" class="btn btn-sm btn-secondary">Yönet</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-wrap" x-show="totalPages > 1">
                <div class="pagination-info"><span x-text="from"></span>–<span x-text="to"></span> / <strong x-text="total"></strong></div>
                <nav class="pagination" aria-label="Sayfalar">
                    <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === 1 }" :disabled="page === 1" @@click="prev()">‹</button>
                    <template x-for="p in pageList" :key="p">
                        <button type="button" class="page-btn" :class="{ 'page-btn-active': p === page }" @@click="goto(p)" x-text="p"></button>
                    </template>
                    <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === totalPages }" :disabled="page === totalPages" @@click="next()">›</button>
                </nav>
            </div>
            <div class="pagination-wrap" x-show="total === 0 && q.length > 0" x-cloak>
                <div class="pagination-info m-auto">Aramaya uyan kayıt yok.</div>
            </div>
        </div>
    </div>
</div>


