@model List<KiraTakip.Models.ViewModels.KullaniciListeViewModel>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">
        ✕ @TempData["Error"]
    </div>
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Kullanıcı Yönetimi</div>
        <div class="page-subtitle">@Model.Count kayıtlı kullanıcı</div>
    </div>
    <a href="/Admin/Kullanicilar/Ekle" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Kullanıcı
    </a>
</div>

<div class="card" style="padding:0;overflow:hidden;" x-data="clientTable({ pageSize: 25 })" x-init="init()">
    <div class="table-toolbar">
        <input type="search" class="form-control toolbar-search" placeholder="Ara: ad, e-posta, rol…" x-model.debounce.250ms="q" />
        <span class="pagination-info" style="margin-left:auto;"><span x-text="total"></span> kayıt</span>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody x-ref="tbody">
                @foreach (var u in Model)
                {
                    var search = $"{u.AdSoyad} {u.Email} {u.Rol}".ToLower();
                    <tr data-row data-search="@search">
                        <td style="font-weight:600;">@u.AdSoyad</td>
                        <td style="font-size:13px;color:var(--color-muted);">@u.Email</td>
                        <td>
                            @{
                                string rolCls = u.Rol switch {
                                    "Admin" => "badge-kurumsal",
                                    "Yonetici" => "badge-kirali",
                                    _ => "badge-bos"
                                };
                                string rolLabel = u.Rol switch {
                                    "Goruntuleyici" => "Görüntüleyici",
                                    _ => u.Rol
                                };
                            }
                            <span class="badge @rolCls">@rolLabel</span>
                        </td>
                        <td>
                            @if (u.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td style="display:flex;gap:6px;justify-content:flex-end;">
                            <a href="/Admin/Kullanicilar/Duzenle/@u.Id" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/Kullanicilar/DurumDegistir/@u.Id" data-confirm="@(u.IsActive ? "Kullanıcı pasif yapılsın mı? Oturum açamaz." : "Kullanıcı aktif yapılsın mı?")" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-danger" : "btn-amber")">
                                    @(u.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-wrap" x-show="totalPages > 1">
        <div class="pagination-info"><span x-text="from"></span>–<span x-text="to"></span> / <strong x-text="total"></strong></div>
        <nav class="pagination" aria-label="Sayfalar">
            <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === 1 }" :disabled="page === 1" @@click="prev()">‹</button>
            <template x-for="p in pageList" :key="p">
                <button type="button" class="page-btn" :class="{ 'page-btn-active': p === page }" @@click="goto(p)" x-text="p"></button>
            </template>
            <button type="button" class="page-btn" :class="{ 'page-btn-disabled': page === totalPages }" :disabled="page === totalPages" @@click="next()">›</button>
        </nav>
    </div>
    <div class="pagination-wrap" x-show="total === 0 && q.length > 0" x-cloak>
        <div class="pagination-info" style="margin:auto;">Aramaya uyan kayıt yok.</div>
    </div>
</div>
