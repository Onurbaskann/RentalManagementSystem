@model KiraTakip.Models.ViewModels.AdminUserInviteViewModel
@{
    ViewData["Title"] = "Davet Gönder";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header">
    <div>
        <a href="/Admin/Users" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Kullanıcı Yönetimi
        </a>
        <div class="page-title">Davet Gönder</div>
        <div class="page-subtitle">Yeni bir kullanıcıyı sisteme davet edin</div>
    </div>
</div>

<div class="card" x-data="{ seciliRolId: @(Model.RoleId > 0 ? Model.RoleId.ToString() : "0"), tumErisim: @(Model.HasAccessToAllProperties ? "true" : "false") }">
    <form method="post" action="/Admin/Users/Invite">
        @Html.AntiForgeryToken()


        <div class="form-group">
            <label class="form-label">E-posta <span class="text-red-500">*</span></label>
            <input asp-for="Email" class="form-control" type="email" placeholder="ornek@sirket.com" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Ad Soyad</label>
            <input asp-for="FullName" class="form-control" placeholder="Opsiyonel — davetiye e-postasında kullanılır" />
        </div>

        <div class="form-group">
            <label class="form-label">Rol <span class="text-red-500">*</span></label>
            <select asp-for="RoleId" class="form-control" x-model="seciliRolId">
                <option value="0">— Seçin —</option>
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
            <span asp-validation-for="RoleId" class="form-error"></span>
        </div>

        @if (Model.Properties.Any())
        {
            <div class="form-group" x-show="seciliRolId !== '0'" x-cloak>
                <label class="form-label">Taşınmaz Yetkileri</label>

                <label class="flex items-center gap-2 cursor-pointer mb-3">
                    <input type="checkbox" asp-for="HasAccessToAllProperties" x-model="tumErisim" class="rounded accent-blue-600" />
                    <span class="text-sm font-medium">Tüm Taşınmazlara Erişim</span>
                </label>

                <div x-show="!tumErisim" x-cloak class="grid grid-cols-1 gap-1.5 pl-1">
                    @for (int i = 0; i < Model.Properties.Count; i++)
                    {
                        <label class="flex items-center gap-2 cursor-pointer text-sm">
                            <input type="checkbox"
                                   name="SelectedPropertyIds"
                                   value="@Model.Properties[i].PropertyId"
                                   @(Model.Properties[i].Selected ? "checked" : "")
                                   class="rounded" />
                            <span class="font-medium">@Model.Properties[i].Name</span>
                            <span class="text-muted">— @Model.Properties[i].Location</span>
                        </label>
                    }
                </div>
            </div>
        }

        <div class="flex gap-2 mt-6">
            <button type="submit" class="btn btn-primary">Daveti Gönder</button>
            <a href="/Admin/Users" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
