@model KiraTakip.Models.ViewModels.KullaniciDuzenleViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    string[] roller = ViewBag.Roller;
}

<div class="page-header">
    <div>
        <a href="/Admin/Kullanicilar" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
            ← Kullanıcı Yönetimi
        </a>
        <div class="page-title">Kullanıcı Düzenle</div>
        <div class="page-subtitle">@Model.Email</div>
    </div>
</div>

@if (Model.IsCurrentUser)
{
    <div style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">
        Kendi hesabınızı düzenliyorsunuz. Rol değişikliği ve durum değişikliği uygulanmaz.
    </div>
}

<div style="max-width:620px;">
    <div class="card">
        <form method="post" action="/Admin/Kullanicilar/Duzenle/@Model.Id" x-data="{ seciliRol: '@Model.Rol' }">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 14px;border-radius:8px;margin-bottom:18px;font-size:13px;"></div>
            }

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsCurrentUser" />

            <div class="form-group">
                <label class="form-label">E-posta</label>
                <div class="form-control" style="background:#f7f8fa;color:var(--color-muted);cursor:default;">@Model.Email</div>
                <input type="hidden" asp-for="Email" />
            </div>

            <div class="form-group">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="AdSoyad" class="form-control" />
                <span asp-validation-for="AdSoyad" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Rol</label>
                @if (Model.IsCurrentUser)
                {
                    <div class="form-control" style="background:#f7f8fa;color:var(--color-muted);cursor:default;">
                        @(Model.Rol == "Goruntuleyici" ? "Görüntüleyici" : Model.Rol)
                    </div>
                    <input type="hidden" asp-for="Rol" />
                }
                else
                {
                    <select asp-for="Rol" class="form-control" x-model="seciliRol">
                        @foreach (var r in roller)
                        {
                            string label = r == "Goruntuleyici" ? "Görüntüleyici" : r;
                            <option value="@r">@label</option>
                        }
                    </select>
                    <span asp-validation-for="Rol" class="form-error"></span>
                }
            </div>

            <!-- Admin: tüm yetkiler otomatik -->
            <div x-show="seciliRol === 'Admin'" x-cloak style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:12px 16px;border-radius:8px;margin-top:4px;font-size:13.5px;">
                Admin rolü tüm yetkilere otomatik olarak sahiptir. Ayrıca izin ataması yapılmaz.
            </div>

            <!-- Yonetici: atanabilir permission'lar grup bazlı -->
            <div x-show="seciliRol === 'Yonetici'" x-cloak style="margin-top:16px;">
                <label class="form-label" style="margin-bottom:12px;">İzinler</label>
                <div style="display:flex;flex-direction:column;gap:14px;">
                    @foreach (var grup in Model.YoneticiPermissions)
                    {
                        <div style="background:var(--color-bg);border:1px solid var(--color-border);border-radius:8px;padding:12px 14px;">
                            <div style="font-size:11.5px;font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:10px;">@grup.GrupAdi</div>
                            <div style="display:flex;flex-wrap:wrap;gap:10px;">
                                @foreach (var p in grup.Permissions)
                                {
                                    <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;white-space:nowrap;">
                                        <input type="checkbox" name="SelectedPermissions" value="@p.Value"
                                               @(p.Selected ? "checked" : "")
                                               style="width:15px;height:15px;accent-color:var(--color-primary);" />
                                        @p.Etiket
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Goruntuleyici: sadece View izinleri + taşınmaz ataması -->
            <div x-show="seciliRol === 'Goruntuleyici'" x-cloak style="margin-top:16px;display:flex;flex-direction:column;gap:14px;">

                <!-- View permission'ları -->
                <div style="background:var(--color-bg);padding:14px;border-radius:8px;border:1px solid var(--color-border);">
                    <label class="form-label" style="margin-bottom:10px;">Görüntüleme İzinleri</label>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        @foreach (var p in Model.GoruntuleyiciPermissions)
                        {
                            <label style="display:flex;align-items:center;gap:8px;font-size:13.5px;cursor:pointer;">
                                <input type="checkbox" name="SelectedPermissions" value="@p.Value"
                                       @(p.Selected ? "checked" : "")
                                       style="width:15px;height:15px;accent-color:var(--color-primary);" />
                                @p.Etiket
                            </label>
                        }
                    </div>
                </div>

                <!-- Taşınmaz yetki ataması -->
                <div style="background:var(--color-bg);padding:14px;border-radius:8px;border:1px solid var(--color-border);">
                    <label class="form-label" style="margin-bottom:10px;">Taşınmaz Görüntüleme Yetkileri</label>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        @if(Model.Tasinmazlar != null && Model.Tasinmazlar.Any())
                        {
                            @for (int i = 0; i < Model.Tasinmazlar.Count; i++)
                            {
                                <label style="display:flex;align-items:center;gap:8px;font-size:13.5px;cursor:pointer;">
                                    <input type="checkbox" name="SelectedTasinmazIds" value="@Model.Tasinmazlar[i].TasinmazId" @(Model.Tasinmazlar[i].Selected ? "checked" : "") style="width:16px;height:16px;accent-color:var(--color-primary);" />
                                    <div>
                                        <span style="font-weight:600;color:var(--color-text);">@Model.Tasinmazlar[i].Ad</span>
                                        <span style="font-size:12px;color:var(--color-muted);margin-left:4px;">(@Model.Tasinmazlar[i].Konum)</span>
                                    </div>
                                </label>
                            }
                        }
                        else
                        {
                            <div style="font-size:12px;color:var(--color-muted);">Sistemde tanımlı taşınmaz bulunmuyor.</div>
                        }
                    </div>
                    <div class="form-hint" style="margin-top:8px;">Kullanıcı yalnızca seçilen taşınmazları ve bunlara bağlı bilgileri görebilir.</div>
                </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:24px;">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a href="/Admin/Kullanicilar" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
<style>
    [x-cloak] { display: none !important; }
</style>
