@model KiraTakip.Models.ViewModels.KullaniciDuzenleViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    var adminRolId = Model.Roller.FirstOrDefault(r => r.Ad == "Sistem Yöneticisi")?.Id.ToString() ?? "0";
}

<div class="page-header">
    <div>
        <a href="/Admin/Kullanicilar" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Kullanıcı Yönetimi
        </a>
        <div class="page-title">Kullanıcı Düzenle</div>
        <div class="page-subtitle">@Model.Email</div>
    </div>
</div>

@if (Model.IsCurrentUser)
{
    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-lg mb-4 text-[13.5px]">
        Kendi hesabınızı düzenliyorsunuz. Rol değişikliği uygulanmaz.
    </div>
}

<div class="card" x-data="{ seciliRolId: '@Model.RolId', globalErisim: @(Model.TumTasinmazlaraErisim ? "true" : "false") }">
    <form method="post" action="/Admin/Kullanicilar/Duzenle/@Model.Id">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-5 text-sm"></div>
        }

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsCurrentUser" />

        <div class="form-group">
            <label class="form-label">E-posta</label>
            <div class="form-control bg-slate-50 text-muted cursor-default">@Model.Email</div>
            <input type="hidden" asp-for="Email" />
        </div>

        <div class="form-group">
            <label class="form-label">Ad Soyad</label>
            <input asp-for="AdSoyad" class="form-control" />
            <span asp-validation-for="AdSoyad" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Rol</label>
            @if (Model.IsCurrentUser)
            {
                var mevcutRolAd = Model.Roller.FirstOrDefault(r => r.Id == Model.RolId)?.Ad ?? "—";
                <div class="form-control bg-slate-50 text-muted cursor-default">
                    @mevcutRolAd
                </div>
                <input type="hidden" asp-for="RolId" />
            }
            else
            {
                <select asp-for="RolId" class="form-control" x-model="seciliRolId">
                    <option value="0">— Seçin —</option>
                    @foreach (var r in Model.Roller)
                    {
                        <option value="@r.Id">@r.Ad</option>
                    }
                </select>
                <span asp-validation-for="RolId" class="form-error"></span>
            }
        </div>

        <div class="bg-slate-50 border border-slate-100 rounded-lg p-3 mt-1 text-[13px] text-slate-500"
             x-show="seciliRolId != '0'" x-cloak>
            İzinler bu rol için rol yönetiminde tanımlanır.
            <a href="/Admin/Roller" class="text-primary underline">Rolleri yönet →</a>
        </div>

        <!-- Kapsam ayarları: Admin rolünde gizli -->
        <div x-show="seciliRolId !== '@adminRolId'" x-cloak class="mt-5">
            <div class="bg-slate-50 border border-slate-100 rounded-xl p-4">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-indigo-400 rounded-full"></span>
                    Taşınmaz Erişim Kapsamı
                </div>

                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="checkbox" name="TumTasinmazlaraErisim" value="true"
                           @(Model.TumTasinmazlaraErisim ? "checked" : "")
                           @@change="globalErisim = $event.target.checked"
                           class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                    <input type="hidden" name="TumTasinmazlaraErisim" value="false" />
                    <span class="text-[13.5px] font-semibold text-slate-700">Tüm Taşınmazlara Erişim</span>
                </label>
                <p class="text-[11.5px] text-slate-400 mt-1.5 ml-6" x-show="globalErisim">
                    Kullanıcı sistemdeki tüm taşınmazlara erişebilir.
                </p>

                <!-- Spesifik taşınmaz / birim kapsamı: global toggle kapalıyken -->
                @if (Model.Tasinmazlar.Any() || Model.Birimler.Any())
                {
                    <div x-show="seciliRolId !== '@adminRolId' && seciliRolId !== '0' && !globalErisim" x-cloak class="mt-3">
                        @if (Model.Tasinmazlar.Any())
                        {
                            <div class="text-[11.5px] font-semibold text-slate-500 mb-2">Taşınmaz Bazlı</div>
                            <div class="flex flex-col gap-2.5">
                                @for (int i = 0; i < Model.Tasinmazlar.Count; i++)
                                {
                                    <label class="flex items-center gap-2.5 text-[13.5px] cursor-pointer group">
                                        <input type="checkbox" name="SelectedTasinmazIds"
                                               value="@Model.Tasinmazlar[i].TasinmazId"
                                               @(Model.Tasinmazlar[i].Selected ? "checked" : "")
                                               class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                        <div class="flex flex-col">
                                            <span class="font-semibold text-slate-700 group-hover:text-indigo-600 transition-colors">@Model.Tasinmazlar[i].Ad</span>
                                            <span class="text-[11px] text-slate-400">@Model.Tasinmazlar[i].Konum</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        }
                        @if (Model.Birimler.Any())
                        {
                            <div class="@(Model.Tasinmazlar.Any() ? "mt-4 pt-3 border-t border-slate-200/60" : "")">
                                <div class="text-[11.5px] font-semibold text-slate-500 mb-2">Birim Bazlı</div>
                                <div class="flex flex-col gap-2.5">
                                    @for (int i = 0; i < Model.Birimler.Count; i++)
                                    {
                                        <label class="flex items-center gap-2.5 text-[13.5px] cursor-pointer group">
                                            <input type="checkbox" name="SelectedBirimIds"
                                                   value="@Model.Birimler[i].BirimId"
                                                   @(Model.Birimler[i].Selected ? "checked" : "")
                                                   class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                            <div class="flex flex-col">
                                                <span class="font-semibold text-slate-700 group-hover:text-indigo-600 transition-colors">@Model.Birimler[i].Ad</span>
                                                <span class="text-[11px] text-slate-400">@Model.Birimler[i].TasinmazAd</span>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        <div class="text-[11px] text-slate-400 mt-4 pt-3 border-t border-slate-200/60 italic flex items-center gap-1.5">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            Kullanıcı yalnızca seçilen taşınmaz/birimlere bağlı bilgileri görebilir.
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex gap-2.5 mt-6">
            <button type="submit" class="btn btn-primary px-6">Kaydet</button>
            <a href="/Admin/Kullanicilar" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>


