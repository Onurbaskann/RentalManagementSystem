@model KiraTakip.Models.ViewModels.KullaniciDuzenleViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    string[] roller = ViewBag.Roller;
}

<div class="page-header">
    <div>
        <a href="/Admin/Kullanicilar" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Kullanıcı Yönetimi
        </a>
        <div class="page-title">Kullanıcı Düzenle</div>
        <div class="page-subtitle">@Model.Email</div>
    </div>
</div>

@if (Model.IsCurrentUser)
{
    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-lg mb-4 text-[13.5px]">
        Kendi hesabınızı düzenliyorsunuz. Rol değişikliği ve durum değişikliği uygulanmaz.
    </div>
}

<div class="max-w-[620px]">
    <div class="card">
        <form method="post" action="/Admin/Kullanicilar/Duzenle/@Model.Id" x-data="{ seciliRol: '@Model.Rol' }">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4.5 text-sm"></div>
            }

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsCurrentUser" />

            <div class="form-group">
                <label class="form-label">E-posta</label>
                <div class="form-control bg-slate-50 text-muted cursor-default">@Model.Email</div>
                <input type="hidden" asp-for="Email" />
            </div>

            <div class="form-group">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="AdSoyad" class="form-control" />
                <span asp-validation-for="AdSoyad" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Rol</label>
                @if (Model.IsCurrentUser)
                {
                    <div class="form-control bg-slate-50 text-muted cursor-default">
                        @(Model.Rol == "Goruntuleyici" ? "Görüntüleyici" : Model.Rol)
                    </div>
                    <input type="hidden" asp-for="Rol" />
                }
                else
                {
                    <select asp-for="Rol" class="form-control" x-model="seciliRol">
                        @foreach (var r in roller)
                        {
                            string label = r == "Goruntuleyici" ? "Görüntüleyici" : r;
                            <option value="@r">@label</option>
                        }
                    </select>
                    <span asp-validation-for="Rol" class="form-error"></span>
                }
            </div>

            <!-- Admin: tüm yetkiler otomatik -->
            <div x-show="seciliRol === 'Admin'" x-cloak class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mt-1 text-[13.5px]">
                Admin rolü tüm yetkilere otomatik olarak sahiptir. Ayrıca izin ataması yapılmaz.
            </div>

            <!-- Yonetici: atanabilir permission'lar grup bazlı -->
            <div x-show="seciliRol === 'Yonetici'" x-cloak class="mt-4.5">
                <label class="form-label mb-3">İzinler</label>
                <div class="flex flex-col gap-4">
                    @foreach (var grup in Model.YoneticiPermissions)
                    {
                        <div class="bg-slate-50 border border-slate-100 rounded-xl p-4">
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                                <span class="w-1.5 h-1.5 bg-indigo-400 rounded-full"></span>
                                @grup.GrupAdi
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2.5">
                                @foreach (var p in grup.Permissions)
                                {
                                    <label class="flex items-center gap-2 text-[13px] font-medium text-slate-600 cursor-pointer hover:text-indigo-600 transition-colors">
                                        <input type="checkbox" name="SelectedPermissions" value="@p.Value"
                                               @(p.Selected ? "checked" : "")
                                               class="w-4.5 h-4.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                        @p.Etiket
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Goruntuleyici: sadece View izinleri + taşınmaz ataması -->
            <div x-show="seciliRol === 'Goruntuleyici'" x-cloak class="mt-6 flex flex-col gap-4">

                <!-- View permission'ları -->
                <div class="bg-slate-50 border border-slate-100 rounded-xl p-4">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-indigo-400 rounded-full"></span>
                        Görüntüleme İzinleri
                    </label>
                    <div class="grid grid-cols-2 gap-x-4 gap-y-2.5">
                        @foreach (var p in Model.GoruntuleyiciPermissions)
                        {
                            <label class="flex items-center gap-2 text-[13px] font-medium text-slate-600 cursor-pointer hover:text-indigo-600 transition-colors">
                                <input type="checkbox" name="SelectedPermissions" value="@p.Value"
                                       @(p.Selected ? "checked" : "")
                                       class="w-4.5 h-4.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                @p.Etiket
                            </label>
                        }
                    </div>
                </div>

                <!-- Taşınmaz yetki ataması -->
                <div class="bg-slate-50 border border-slate-100 rounded-xl p-4">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-indigo-400 rounded-full"></span>
                        Taşınmaz Görüntüleme Yetkileri
                    </label>
                    <div class="flex flex-col gap-2.5">
                        @if(Model.Tasinmazlar != null && Model.Tasinmazlar.Any())
                        {
                            @for (int i = 0; i < Model.Tasinmazlar.Count; i++)
                            {
                                <label class="flex items-center gap-2.5 text-[13.5px] cursor-pointer group">
                                    <input type="checkbox" name="SelectedTasinmazIds" value="@Model.Tasinmazlar[i].TasinmazId" @(Model.Tasinmazlar[i].Selected ? "checked" : "") class="w-4.5 h-4.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-700 group-hover:text-indigo-600 transition-colors">@Model.Tasinmazlar[i].Ad</span>
                                        <span class="text-[11px] text-slate-400">@Model.Tasinmazlar[i].Konum</span>
                                    </div>
                                </label>
                            }
                        }
                        else
                        {
                            <div class="text-xs text-slate-400 italic">Sistemde tanımlı taşınmaz bulunmuyor.</div>
                        }
                    </div>
                    <div class="text-[11px] text-slate-400 mt-4 pt-3 border-t border-slate-200/60 italic flex items-center gap-1.5">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        Kullanıcı yalnızca seçilen taşınmazları ve bunlara bağlı bilgileri görebilir.
                    </div>
                </div>
            </div>

            <div class="flex gap-2.5 mt-6">
                <button type="submit" class="btn btn-primary px-6">Kaydet</button>
                <a href="/Admin/Kullanicilar" class="btn btn-secondary px-6">İptal</a>
            </div>
        </form>
    </div>
</div>
