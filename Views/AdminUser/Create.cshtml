@model KiraTakip.Models.ViewModels.KullaniciEkleViewModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
    string[] roller = ViewBag.Roller;
}

<div class="max-w-[800px] mx-auto"><div class="page-header flex items-center justify-between">
    <div>
        <a href="/Admin/Kullanicilar" class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-primary transition-colors mb-2">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Kullanıcı Yönetimi
        </a>
        <div class="page-title">Yeni Kullanıcı</div>
    </div>
</div>

<div>
    <div class="card p-6">
        <form method="post" action="/Admin/Kullanicilar/Ekle" x-data="{ seciliRol: '@Model.Rol' }">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 p-3.5 rounded-lg mb-5 text-sm font-medium"></div>
            }

            <div class="form-group">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="AdSoyad" class="form-control" placeholder="Ad Soyad" />
                <span asp-validation-for="AdSoyad" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">E-posta</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@kiratakip.local" />
                <span asp-validation-for="Email" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Şifre</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Şifre" />
                <span asp-validation-for="Password" class="form-error"></span>
                <div class="form-hint">En az 6 karakter, büyük harf ve rakam içermelidir.</div>
            </div>

            <div class="form-group">
                <label class="form-label">Rol</label>
                <select asp-for="Rol" class="form-control" x-model="seciliRol">
                    <option value="">— Rol Seçin —</option>
                    @foreach (var r in roller)
                    {
                        string label = r == "Goruntuleyici" ? "Görüntüleyici" : r;
                        <option value="@r">@label</option>
                    }
                </select>
                <span asp-validation-for="Rol" class="form-error"></span>
            </div>

            <div class="form-group border border-slate-200 bg-slate-50/50 p-4 rounded-xl mt-6" x-show="seciliRol === 'Goruntuleyici'" x-cloak>
                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-widest block mb-4">Taşınmaz Görüntüleme Yetkileri</label>
                <div class="flex flex-col gap-2.5">
                    @if(Model.Tasinmazlar != null && Model.Tasinmazlar.Any())
                    {
                        @for (int i = 0; i < Model.Tasinmazlar.Count; i++)
                        {
                            <label class="flex items-center gap-3 p-2 px-3 bg-white border border-slate-200 rounded-lg cursor-pointer hover:border-indigo-300 transition-colors group">
                                <input type="checkbox" name="SelectedTasinmazIds" value="@Model.Tasinmazlar[i].TasinmazId" @(Model.Tasinmazlar[i].Selected ? "checked" : "") class="w-4.5 h-4.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                <div>
                                    <div class="text-[13.5px] font-bold text-slate-700 group-hover:text-indigo-700">@Model.Tasinmazlar[i].Ad</div>
                                    <div class="text-[10px] text-muted font-medium">@Model.Tasinmazlar[i].Konum</div>
                                </div>
                            </label>
                        }
                    }
                    else
                    {
                        <div class="text-xs text-muted italic">Sistemde tanımlı taşınmaz bulunmuyor.</div>
                    }
                </div>
                <div class="text-[11px] text-slate-400 mt-4 leading-relaxed font-medium">
                    <span class="text-indigo-500 font-bold">NOT:</span> Kullanıcı yalnızca seçilen taşınmazları ve bunlara bağlı bilgileri (birimler, sözleşmeler, tahakkuklar) görebilir.
                </div>
            </div>

            <div class="flex items-center gap-3 mt-8">
                <button type="submit" class="btn btn-primary px-6">Kullanıcı Oluştur</button>
                <a href="/Admin/Kullanicilar" class="btn btn-secondary px-6">İptal</a>
            </div>
        </form>
    </div>
</div>
</div>
