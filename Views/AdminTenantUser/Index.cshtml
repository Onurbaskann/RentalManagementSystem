@model KiraTakip.Models.ViewModels.TenantUserListViewModel
@using KiraTakip.Models.Entities
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Kiracı Kullanıcıları";
    ViewData["UseCentralFeedback"] = true;
    var tenantId = ViewBag.TenantId as int? ?? 0;
    var tenantName = ViewBag.TenantName as string ?? "—";
    var basePath = $"/Admin/Tenants/{tenantId.ToHashId()}/Users";
    var pagination = PaginationModel.FromPaged(Model.Users, basePath, Model.Query.ToQueryDict());
}


<div class="page-header flex items-center justify-between">
    <div>
        <a href="/Tenant/Details/@tenantId" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← @tenantName
        </a>
        <div class="page-title">Kiracı Kullanıcıları</div>
    </div>
    <a href="/Admin/Tenants/@tenantId.ToHashId()/Users/Invite" class="btn btn-primary">+ Davet Gönder</a>
</div>

<div class="card p-0 overflow-hidden">
    <form method="get" action="@basePath" class="table-toolbar">
        <input type="hidden" name="size" value="@Model.Query.Size" />
        <input type="search" name="q" value="@Model.Query.Q" class="form-control toolbar-search" placeholder="Ara: ad, e-posta, rol…" />
        <button type="submit" class="btn btn-secondary">Ara</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query.Q))
        {
            <a href="@basePath?size=@Model.Query.Size" class="btn btn-secondary">Temizle</a>
        }
        <span class="pagination-info ml-auto"><strong>@Model.Users.Total</strong> kayıt</span>
    </form>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users.Items)
                {
                    <tr>
                        <td class="font-semibold">@u.FullName</td>
                        <td class="text-sm text-muted">@u.Email</td>
                        <td><span class="badge badge-bos">@u.RoleName</span></td>
                        <td>
                            @if (u.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <form method="post" action="/Admin/Tenants/@tenantId.ToHashId()/Users/ToggleActive/@u.Id"
                                  data-confirm="@(u.IsActive ? "Kullanıcı pasif yapılsın mı?" : "Kullanıcı aktif yapılsın mı?")" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-danger" : "btn-amber")">
                                    @(u.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Users.Items.Any())
    {
        <div class="p-8 text-center text-slate-400 font-medium">Aramaya uyan kullanıcı bulunamadı.</div>
    }
    @await Html.PartialAsync("_Pagination", pagination)
</div>

@if (Model.PendingInvitations.Any())
{
    <div class="mt-6">
        <div class="page-header">
            <div class="page-title text-base">Bekleyen Davetler</div>
        </div>
        <div class="card p-0 overflow-hidden">
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>E-posta</th>
                            <th>Ad Soyad</th>
                            <th>Rol</th>
                            <th>Gönderilme</th>
                            <th>Son Tarih</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.PendingInvitations)
                        {
                            <tr>
                                <td>@d.Email</td>
                                <td class="text-sm text-muted">@(d.FullName ?? "—")</td>
                                <td><span class="badge badge-bos">@d.RoleName</span></td>
                                <td class="text-sm text-muted">@d.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-sm @(d.ExpiresAt < DateTime.UtcNow.AddDays(1) ? "text-red-600" : "text-muted")">
                                    @d.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="flex gap-1.5 justify-end">
                                    <form method="post" action="/Admin/Tenants/@tenantId.ToHashId()/Users/Invitation/Resend/@d.Id" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-secondary">Yeniden Gönder</button>
                                    </form>
                                    <form method="post" action="/Admin/Tenants/@tenantId.ToHashId()/Users/Invitation/Cancel/@d.Id"
                                          data-confirm="Bu daveti iptal etmek istediğinizden emin misiniz?" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">İptal</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
