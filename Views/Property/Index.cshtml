@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.PropertyListItemDto>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Taşınmazlar";

    bool canEdit = User.HasPermission(PermissionCatalog.Property.Create);
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var pagination = PaginationModel.FromPaged(Model, "/Property", query.ToQueryDict());
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Taşınmazlar</div>
        <div class="page-subtitle">@Model.Total taşınmaz kayıtlı</div>
    </div>
    @if (canEdit)
    {
        <a href="/Property/Create" class="btn btn-primary flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Taşınmaz
        </a>
    }
</div>

<form method="get" action="/Property" class="card p-3 mb-4 flex items-center gap-3">
    <input type="hidden" name="size" value="@query.Size" />
    <input type="search" name="q" value="@query.Q" class="form-control w-full max-w-sm" placeholder="Ara: taşınmaz, şehir, ilçe veya tür…" />
    <button type="submit" class="btn btn-secondary">Ara</button>
    @if (!string.IsNullOrWhiteSpace(query.Q))
    {
        <a href="/Property?size=@query.Size" class="btn btn-secondary">Temizle</a>
    }
    <span class="ml-auto text-xs text-muted"><strong>@Model.Total</strong> kayıt</span>
</form>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    @foreach (var t in Model.Items)
    {
        var kiraliSayi = t.LeasedUnitCount;
        var surekSayi = t.ExpiringSoonUnitCount;
        var bosSayi = t.VacantUnitCount;

        <a href="/Property/Details/@t.Id.ToHashId()" class="group">
            <div class="card cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                <div class="flex items-start justify-between mb-3">
                    <div>
                        <div class="text-[15px] font-bold text-slate-800 group-hover:text-primary transition-colors">@t.Name</div>
                        <div class="text-xs text-muted mt-0.5">@t.District, @t.City</div>
                    </div>
                    <span class="badge badge-bos text-[10px] font-bold">@(string.IsNullOrEmpty(t.PropertyTypeName) ? "—" : t.PropertyTypeName)</span>
                </div>

                <div class="grid grid-cols-2 gap-2.5 mb-4">
                    @if (t.ClosedArea > 0)
                    {
                        <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                            <div class="text-[10px] text-muted font-bold uppercase tracking-wider mb-0.5">Kapalı Alan</div>
                            <div class="text-sm font-bold text-slate-700">@t.ClosedArea.M2()</div>
                        </div>
                    }
                    @if (t.OpenArea > 0)
                    {
                        <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                            <div class="text-[10px] text-muted font-bold uppercase tracking-wider mb-0.5">Açık Alan</div>
                            <div class="text-sm font-bold text-slate-700">@t.OpenArea.M2()</div>
                        </div>
                    }
                    @if (t.UnitStructure == UnitStructure.MultipleUnits)
                    {
                        <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                            <div class="text-[10px] text-muted font-bold uppercase tracking-wider mb-0.5">Ofis Sayısı</div>
                            <div class="text-sm font-bold text-slate-700">@t.UnitCount Ofis</div>
                        </div>
                    }
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                    <div class="flex gap-1.5 flex-wrap">
                        @if (kiraliSayi > 0) { <span class="badge badge-kirali text-[10px] font-bold px-1.5 py-0.5">@kiraliSayi Kiralı</span> }
                        @if (surekSayi > 0) { <span class="badge badge-surek text-[10px] font-bold px-1.5 py-0.5">@surekSayi Doluyor</span> }
                        @if (bosSayi > 0) { <span class="badge badge-bos text-[10px] font-bold px-1.5 py-0.5">@bosSayi Boş</span> }
                    </div>
                    <span class="text-[11px] font-semibold text-slate-400 group-hover:text-primary transition-colors flex items-center gap-1">
                        @t.UnitCount Birim
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="transition-transform group-hover:translate-x-0.5"><path d="M9 18l6-6-6-6"/></svg>
                    </span>
                </div>
            </div>
        </a>
    }
</div>

@await Html.PartialAsync("_Pagination", pagination)

