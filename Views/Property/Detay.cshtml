@model KiraTakip.Models.ViewModels.TasinmazDetayViewModel
@using KiraTakip.Models
@inject KiraTakip.Services.Interfaces.IStatisticsService Istatistik
@{
    ViewData["Title"] = Model.Property.Ad;
    bool canEdit = User.HasPermission(PermissionCatalog.Lease.Create) || User.HasPermission(PermissionCatalog.Reservation.Create);
    bool canDuzenle = User.HasPermission(PermissionCatalog.Property.Edit);
    bool canManageRate = User.HasPermission(PermissionCatalog.Unit.OverrideRate);
    bool canManageCarpan = User.HasPermission(PermissionCatalog.PropertyMultiplier.Edit);

    string DurumBadge(OccupancyStatus d) => d switch
    {
        OccupancyStatus.Leased => "<span class='badge badge-kirali'>Kiralı</span>",
        OccupancyStatus.ExpiringSoon => "<span class='badge badge-surek'>Süresi Dolmak Üzere</span>",
        _ => "<span class='badge badge-bos'>Boş</span>"
    };
}

@functions {
    string KatEtiketi(int? katNo) => katNo switch
    {
        null => "Kat Belirtilmemiş",
        0 => "Zemin Kat",
        < 0 => $"{Math.Abs(katNo.Value)}. Bodrum",
        _ => $"{katNo}. Kat"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert-success mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}

<div class="page-header flex items-start justify-between">
    <div>
        <a href="/Property" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Taşınmazlar
        </a>
        <div class="page-title">@Model.Property.Ad</div>
        <div class="page-subtitle">@Model.Property.Mahalle, @Model.Property.Ilce / @Model.Property.Il</div>
    </div>
    <div class="flex items-center gap-2">
        @if (canDuzenle)
        {
            <a href="/Property/Duzenle/@Model.Property.Id.ToHashId()" class="btn btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                Düzenle
            </a>
        }
        @if (canEdit)
        {
            <a href="/Lease/Ekle" class="btn btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Sözleşme Ekle
            </a>
        }
    </div>
</div>

<div id="detay-tabs">
    <div class="tabs">
        <button class="tab">Genel Bilgiler</button>
        <button class="tab">Units (@Model.Property.Units.Count)</button>
        <button class="tab">Sözleşme Geçmişi</button>
        <button class="tab">Rezervasyonlar (@Model.Property.Rezervasyonlar.Count)</button>
        <button class="tab">Kira Tarifeleri</button>
    </div>

    <!-- Tab 1: Genel Bilgiler -->
    <div class="tab-content">
        <div class="three-col">
            <div class="card">
                <div class="card-title">Taşınmaz Tipi</div>
                <div class="text-[18px] font-bold mb-1.5">@(Model.Property.TasinmazTipiAd)</div>
                <div class="text-[13px] text-muted">
                    @(Model.Property.RentalMode == RentalMode.UnitBased ? "Unit bazlı kiralama" : "Tek parça kiralama")
                </div>
            </div>
            <div class="card">
                <div class="card-title">Yüzölçüm</div>
                @if (Model.Property.KapaliYuzolcumu > 0)
                {
                    <div class="text-base font-bold">@Model.Property.KapaliYuzolcumu.ToString("N0") m² <span class="text-[13px] font-normal text-muted">kapalı</span></div>
                }
                @if (Model.Property.AcikYuzolcumu > 0)
                {
                    <div class="text-base font-bold mt-1">@Model.Property.AcikYuzolcumu.ToString("N0") m² <span class="text-[13px] font-normal text-muted">açık</span></div>
                }
            </div>
            @if (Model.Property.RentalMode == RentalMode.UnitBased)
            {
                var kiraliSayisi = Model.Property.Units.Count(b => b.Durum == OccupancyStatus.Leased || b.Durum == OccupancyStatus.ExpiringSoon);
                var toplamSayisi = Model.Property.Units.Count;
                var bosSayisi = toplamSayisi - kiraliSayisi;
                <div class="card">
                    <div class="card-title">Doluluk Durumu</div>
                    <div class="text-[22px] font-bold mt-1">@kiraliSayisi<span class="text-[15px] font-normal text-muted">/@toplamSayisi</span></div>
                    <div class="text-xs text-muted mt-0.5">unit kiralı</div>
                    <div class="flex gap-3 mt-2.5 text-xs">
                        <span class="text-[#065f46] font-semibold">● @kiraliSayisi kiralı</span>
                        <span class="text-[#6b7c93] font-semibold">● @bosSayisi boş</span>
                    </div>
                </div>
            }
            else
            {
                var komple = Model.Property.Units.FirstOrDefault();
                var hasAktifSozlesme = komple?.AktifSozlesmeId.HasValue == true;
                var durum = komple?.Durum ?? OccupancyStatus.Vacant;
                <div class="card">
                    <div class="card-title">Kira Durumu</div>
                    @if (hasAktifSozlesme)
                    {
                        <div class="mt-1.5">
                            <span class="inline-block bg-[#ecfdf5] text-[#065f46] text-xs font-bold px-2.5 py-0.5 rounded-[10px]">
                                @(durum == OccupancyStatus.ExpiringSoon ? "Süresi Dolmak Üzere" : "Kiralı")
                            </span>
                        </div>
                        <div class="text-sm font-semibold mt-2">@(komple.AktifSozlesmeKiraciGosterimAdi ?? "—")</div>
                        <div class="text-xs text-muted mt-0.5">
                            Bitiş: @komple.AktifSozlesmeBitisTarihi?.ToString("dd.MM.yyyy")
                        </div>
                    }
                    else
                    {
                        <div class="mt-1.5">
                            <span class="inline-block bg-[#f1f5f9] text-[#475569] text-xs font-bold px-2.5 py-0.5 rounded-[10px]">Müsait</span>
                        </div>
                        <div class="text-xs text-muted mt-2">Aktif sözleşme yok</div>
                    }
                </div>
            }
        </div>

        <div class="card mt-4">
            <div class="card-title mb-3.5">Adres Bilgileri</div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <div class="detail-label mb-0.5">İl</div>
                    <div class="text-sm font-medium">@Model.Property.Il</div>
                </div>
                <div>
                    <div class="detail-label mb-0.5">İlçe</div>
                    <div class="text-sm font-medium">@Model.Property.Ilce</div>
                </div>
                <div>
                    <div class="detail-label mb-0.5">Mahalle</div>
                    <div class="text-sm font-medium">@Model.Property.Mahalle</div>
                </div>
                <div>
                    <div class="detail-label mb-0.5">Açık Adres</div>
                    <div class="text-sm font-medium">@Model.Property.AcikAdres</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Property.Aciklama))
            {
                <div class="mt-3.5 pt-3.5 border-t border-[var(--color-border)]">
                    <div class="detail-label mb-1">Açıklama</div>
                    <div class="text-sm">@Model.Property.Aciklama</div>
                </div>
            }
        </div>
    </div>

    <!-- Tab 2: Units -->
    <div class="tab-content">
        @{
            bool isBirimBazli = Model.Property.RentalMode == RentalMode.UnitBased;
            int totalBirim = Model.Property.Units.Count;
            int kirali = Model.Property.Units.Count(b => b.Durum == OccupancyStatus.Leased || b.Durum == OccupancyStatus.ExpiringSoon);
            int bos = totalBirim - kirali;
        }

        <!-- Unit Özet Kartları -->
        <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="bg-white border border-[var(--color-border)] rounded-xl p-3.5 px-4.5">
                <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">Toplam Unit</div>
                <div class="font-serif text-[28px] font-bold mt-1">@totalBirim</div>
            </div>
            <div class="bg-white border border-[var(--color-border)] rounded-xl p-3.5 px-4.5">
                <div class="text-[11px] font-semibold text-[#065f46] uppercase tracking-wider">Kiralı</div>
                <div class="font-serif text-[28px] font-bold text-[#065f46] mt-1">@kirali</div>
            </div>
            <div class="bg-white border border-[var(--color-border)] rounded-xl p-3.5 px-4.5">
                <div class="text-[11px] font-semibold text-[#6b7c93] uppercase tracking-wider">Boş</div>
                <div class="font-serif text-[28px] font-bold text-[#6b7c93] mt-1">@bos</div>
            </div>
        </div>

        @if (isBirimBazli)
        {
            var katGruplari = Model.Property.Units
                .GroupBy(b => b.KatNo)
                .OrderByDescending(g => g.Key ?? int.MinValue)
                .ToList();

            var katBosMapRaw = katGruplari.ToDictionary(
                g => g.Key.HasValue ? g.Key.Value.ToString() : "none",
                g => !g.Any(b => b.AktifSozlesmeId.HasValue)
            );
            var katKiraliMapRaw = katGruplari.ToDictionary(
                g => g.Key.HasValue ? g.Key.Value.ToString() : "none",
                g => g.Any(b => b.AktifSozlesmeId.HasValue)
            );
            var katSearchDataMapRaw = katGruplari.ToDictionary(
                g => g.Key.HasValue ? g.Key.Value.ToString() : "none",
                g => g.Select(b => ((b.BirimNo ?? "") + " " + (b.Ad ?? "")).ToLowerInvariant()).ToList()
            );
            var katBosMapJson = System.Text.Json.JsonSerializer.Serialize(katBosMapRaw);
            var katKiraliMapJson = System.Text.Json.JsonSerializer.Serialize(katKiraliMapRaw);
            var katSearchDataMapJson = System.Text.Json.JsonSerializer.Serialize(katSearchDataMapRaw);

            <div x-data='{ "filter": "tum", "openFloors": {}, "search": "", "viewMode": "card", "katBosMap": @Html.Raw(katBosMapJson), "katKiraliMap": @Html.Raw(katKiraliMapJson), "katSearchDataMap": @Html.Raw(katSearchDataMapJson) }'
                 x-init="
                    $watch('filter', v => {
                        if (v !== 'tum') {
                            for (const [k, hasEmpty] of Object.entries(katBosMap)) {
                                if (v === 'bos') openFloors[k] = hasEmpty;
                                else if (v === 'kirali') openFloors[k] = katKiraliMap[k];
                                else openFloors[k] = false;
                            }
                        }
                    });
                    $watch('search', v => {
                        if (v !== '') {
                            for (const [k, terms] of Object.entries(katSearchDataMap)) {
                                if (terms.some(t => t.includes(v.toLowerCase()))) openFloors[k] = true;
                            }
                        }
                    })">

                <!-- Filtre Bar -->
                <div class="flex items-center gap-2.5 mb-6 flex-wrap">
                    <select x-model="filter" class="form-control w-auto min-w-[150px] text-[13px] py-1.5 px-2.5">
                        <option value="tum">Tüm Units</option>
                        <option value="bos">Boş</option>
                        <option value="kirali">Kiralı</option>
                    </select>
                    <input type="text" x-model="search" placeholder="Unit ara..." class="form-control w-[180px] text-[13px] py-1.5 px-2.5" />
                    <button type="button" class="btn btn-sm btn-secondary" x-show="viewMode === 'table'"
                        @@click="filter = 'tum'; Object.keys(katBosMap).forEach(k => { openFloors[k] = true })">
                        Tümünü Aç
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" x-show="viewMode === 'table'"
                        @@click="filter = 'tum'; Object.keys(katBosMap).forEach(k => { openFloors[k] = false })">
                        Tümünü Kapat
                    </button>
                    <div class="ml-auto flex items-center gap-1">
                        <button type="button" @@click="viewMode = 'table'" title="Tablo görünümü"
                                class="btn btn-sm w-8 h-8 p-0 flex items-center justify-center"
                                :class="viewMode === 'table' ? 'btn-primary' : 'btn-secondary'">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="17" width="18" height="4" rx="1"/>
                            </svg>
                        </button>
                        <button type="button" @@click="viewMode = 'card'" title="Kart görünümü"
                                class="btn btn-sm w-8 h-8 p-0 flex items-center justify-center"
                                :class="viewMode === 'card' ? 'btn-primary' : 'btn-secondary'">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                                <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Tablo Görünümü -->
                <div x-show="viewMode === 'table'">
                @foreach (var grup in katGruplari)
                {
                    var katKey = grup.Key.HasValue ? grup.Key.Value.ToString() : "none";
                    int katBirimSayisi = grup.Count();
                    int katBos = grup.Count(b => !b.AktifSozlesmeId.HasValue);
                    int katKirali = katBirimSayisi - katBos;
                    int katRez = grup.Count(b => b.RezervasyonYapilabilirMi);
                    int kiraliPct = katBirimSayisi > 0 ? katKirali * 100 / katBirimSayisi : 0;

                    <div class="mb-2 rounded-lg shadow-sm"
                         x-show="!(filter === 'kirali' && !katKiraliMap['@katKey']) &&
                                  !(filter === 'bos' && !katBosMap['@katKey']) &&
                                  !(search !== '' && !(katSearchDataMap['@katKey'] || []).some(t => t.includes(search.toLowerCase())))">
                        <!-- Accordion Header -->
                        <div @@click="openFloors['@katKey'] = !openFloors['@katKey']"
                            class="flex items-center gap-2.5 p-2.5 px-3.5 bg-white border border-[var(--color-border)] rounded-lg cursor-pointer select-none transition-colors duration-150"
                            :class="openFloors['@katKey'] ? 'rounded-b-none border-b-transparent bg-primary-light border-[#a3e0d2]' : 'hover:bg-[#fafbfc]'">
                            <svg :class="openFloors['@katKey'] ? 'rotate-90' : ''"
                                 class="transition-transform duration-200 flex-shrink-0"
                                 width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5">
                                <polyline points="9 18 15 12 9 6" />
                            </svg>
                            <span class="text-[13px] font-bold text-primary">@KatEtiketi(grup.Key)</span>
                            <span class="text-xs text-muted font-medium ml-0.5">@katBirimSayisi unit</span>
                            <div class="flex-1 flex items-center gap-2 min-w-0 mx-1">
                                <div class="flex-1 h-1.5 bg-[#e8f0ee] rounded-full overflow-hidden">
                                    <div class="h-full bg-[var(--color-primary)] rounded-full" style="width: @kiraliPct%"></div>
                                </div>
                                <span class="text-[11px] text-muted whitespace-nowrap">@katKirali/@katBirimSayisi kiralı@(katRez > 0 ? $" · {katRez} rez" : "")</span>
                            </div>
                        </div>

                        <!-- Accordion Body -->
                        <div x-show="openFloors['@katKey']" x-cloak>
                            <div class="card p-0 overflow-hidden rounded-t-none border-t-0">
                                <div class="table-wrapper m-0">
                                    <table class="table-fixed w-full">
                                        <colgroup>
                                            <col class="w-[72px]" />
                                            <col class="w-auto" />
                                            <col class="w-[80px]" />
                                            <col class="w-[130px]" />
                                            <col class="w-auto" />
                                            <col class="w-[125px]" />
                                            <col class="w-[140px]" />
                                            <col class="w-[110px]" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>No</th>
                                                <th>Ad</th>
                                                <th>m²</th>
                                                <th>Durum</th>
                                                <th>Kiracı</th>
                                                <th>Bitiş</th>
                                                <th>Bedel</th>
                                                <th class="text-right pr-3.5">İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var b in grup.OrderBy(x => x.BirimNo))
                                            {
                                                var durumData = b.AktifSozlesmeId.HasValue ? "kirali" : "bos";
                                                var searchData = ((b.BirimNo ?? "") + " " + (b.Ad ?? "")).ToLowerInvariant();
                                                var rowHref = b.AktifSozlesmeId.HasValue
                                                    ? $"/Lease/Detay/{b.AktifSozlesmeId}"
                                                    : (canEdit ? (b.RezervasyonYapilabilirMi ? $"/Reservation/Ekle?unitId={b.Id}" : $"/Lease/Ekle?unitId={b.Id}") : "");
                                                <tr data-durum="@durumData"
                                                    data-search="@searchData"
                                                    @Html.Raw(rowHref != "" ? $"data-href=\"{rowHref}\"" : "")
                                                    class="@(rowHref != "" ? "cursor-pointer hover:bg-[#f7f9fb]" : "") transition-colors duration-100"
                                                    @@click="$el.dataset.href && !$event.target.closest('a,[data-stop]') && (window.location.href = $el.dataset.href)"
                                                    x-show="(filter === 'tum' || $el.getAttribute('data-durum') === filter) && (search === '' || ($el.getAttribute('data-search') || '').includes(search.toLowerCase()))">
                                                    <td>
                                                        <span class="font-mono text-[13px] font-bold text-primary bg-primary-light px-2 py-0.5 rounded-md">@b.BirimNo</span>
                                                    </td>
                                                    <td class="font-semibold text-[13.5px]">@b.Ad</td>
                                                    <td>
                                                        <span class="font-mono text-[12.5px] text-muted">@b.Yuzolcumu.ToString("N0")</span>
                                                        <span class="text-[11px] text-muted">m²</span>
                                                    </td>
                                                    <td>@Html.Raw(DurumBadge(b.Durum))</td>
                                                    <td>
                                                        @if (b.AktifSozlesmeId.HasValue)
                                                        {
                                                            <a href="/Tenant/Detay/@b.AktifSozlesmeKiraciId.ToHashId()" class="font-semibold text-primary no-underline text-[13px] hover:underline">@b.AktifSozlesmeKiraciGosterimAdi</a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-[#c8cfd8]">—</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (b.AktifSozlesmeId.HasValue && b.AktifSozlesmeBitisTarihi.HasValue)
                                                        {
                                                            var kalanGun = (int)(b.AktifSozlesmeBitisTarihi.Value - DateTime.Now).TotalDays;
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="text-[13px] font-medium">@b.AktifSozlesmeBitisTarihi.Value.ToString("dd.MM.yyyy")</span>
                                                                @if (kalanGun <= 30)
                                                                {
                                                                    <span class="day-badge @(kalanGun <= 10 ? "day-badge-red" : "day-badge-amber") text-[10.5px] px-1.5 py-0.5">@kalanGun g</span>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-[#c8cfd8]">—</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (b.RezervasyonYapilabilirMi)
                                                        {
                                                            @if (b.RezKuralId.HasValue)
                                                            {
                                                                <span class="font-serif font-bold text-[13.5px]">@b.RezKuralPeriyotUcreti?.ToString("N0") ₺</span>
                                                                <span class="text-[11px] text-muted ml-0.5">/ @b.RezKuralUcretlendirmePeriyoduDakika dk</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-[#c8cfd8] text-xs">genel tarife</span>
                                                            }
                                                        }
                                                        else if (b.AktifSozlesmeId.HasValue)
                                                        {
                                                            <div>
                                                                <span class="font-serif font-bold text-sm">@b.AylikBedel.ToString("N0") ₺</span>
                                                                <span class="text-[11px] text-muted ml-0.5">/ay</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-[#c8cfd8]">—</span>
                                                        }
                                                    </td>
                                                    <td data-stop>
                                                        <div class="flex items-center justify-end gap-1.5">
                                                            @if (b.RezervasyonYapilabilirMi)
                                                            {
                                                                @if (canEdit)
                                                                {
                                                                    <a href="/Reservation/Ekle?unitId=@b.Id.ToHashId()" class="btn btn-sm btn-primary">Reservation</a>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                @if (b.AktifSozlesmeId.HasValue)
                                                                {
                                                                    <a href="/Lease/Detay/@b.AktifSozlesmeId.ToHashId()" class="btn btn-sm btn-secondary">Sözleşme</a>
                                                                }
                                                                else if (canEdit)
                                                                {
                                                                    <a href="/Lease/Ekle?unitId=@b.Id.ToHashId()" class="btn btn-sm btn-primary">Kiraya Ver</a>
                                                                }
                                                            }
                                                            @if (canManageRate)
                                                            {
                                                                <div x-data="{ open: false }" class="relative">
                                                                    <button type="button" @@click="open = !open"
                                                                            class="btn btn-sm btn-secondary w-7 h-[30px] p-0 flex items-center justify-center">
                                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                                                            <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
                                                                        </svg>
                                                                    </button>
                                                                    <div x-show="open" @@click.outside="open = false" x-cloak
                                                                         class="absolute right-0 mt-1 bg-white border border-[var(--color-border)] rounded-lg shadow-lg z-20 min-w-[150px] py-1">
                                                                        <a href="/Unit/@b.Id.ToHashId()/OzelFiyat"
                                                                           class="flex items-center gap-2 px-3 py-2 text-[13px] text-[var(--color-text)] hover:bg-[#f7f9fb] no-underline">
                                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                                                <line x1="12" y1="1" x2="12" y2="23"/>
                                                                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                                                            </svg>
                                                                            Özel Fiyat
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                </div>

                <!-- Kart Görünümü -->
                <div x-show="viewMode === 'card'" x-cloak>
                @foreach (var grup in katGruplari)
                {
                    var katKey = grup.Key.HasValue ? grup.Key.Value.ToString() : "none";

                    <div class="mb-5"
                         x-show="!(filter === 'kirali' && !katKiraliMap['@katKey']) &&
                                  !(filter === 'bos' && !katBosMap['@katKey']) &&
                                  !(search !== '' && !(katSearchDataMap['@katKey'] || []).some(t => t.includes(search.toLowerCase())))">
                        <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-2.5 px-0.5">@KatEtiketi(grup.Key)</div>
                        <div class="grid grid-cols-4 sm:grid-cols-5 lg:grid-cols-7 xl:grid-cols-9 gap-2">
                            @foreach (var b in grup.OrderBy(x => x.BirimNo))
                            {
                                var durumData = b.AktifSozlesmeId.HasValue ? "kirali" : "bos";
                                var searchData = ((b.BirimNo ?? "") + " " + (b.Ad ?? "")).ToLowerInvariant();
                                var cardHref = b.AktifSozlesmeId.HasValue
                                    ? $"/Lease/Detay/{b.AktifSozlesmeId}"
                                    : (canEdit ? (b.RezervasyonYapilabilirMi ? $"/Reservation/Ekle?unitId={b.Id}" : $"/Lease/Ekle?unitId={b.Id}") : "");
                                var cardBg = b.Durum switch {
                                    OccupancyStatus.Leased => "border-l-[var(--color-primary)] bg-[#f0faf7]",
                                    OccupancyStatus.ExpiringSoon => "border-l-amber-400 bg-[#fffbeb]",
                                    _ => "border-l-[#d1d9e0] bg-white"
                                };
                                <div @Html.Raw(cardHref != "" ? $"data-href=\"{cardHref}\"" : "")
                                     data-durum="@durumData"
                                     data-search="@searchData"
                                     class="relative border border-[var(--color-border)] border-l-4 @cardBg rounded-lg px-2.5 py-3 @(cardHref != "" ? "cursor-pointer hover:-translate-y-0.5 hover:shadow-md" : "") transition-all duration-200"
                                     @@click="$el.dataset.href && !$event.target.closest('a,[data-stop]') && (window.location.href = $el.dataset.href)"
                                     x-show="(filter === 'tum' || $el.getAttribute('data-durum') === filter) && (search === '' || ($el.getAttribute('data-search') || '').includes(search.toLowerCase()))">
                                    @if (canManageRate)
                                    {
                                        <a href="/Unit/@b.Id.ToHashId()/OzelFiyat" data-stop title="Özel Fiyat"
                                           class="absolute top-1.5 right-1.5 w-6 h-6 flex items-center justify-center rounded bg-white border border-[var(--color-border)] text-muted hover:text-primary hover:border-primary transition-colors text-[12px] font-bold no-underline leading-none">₺</a>
                                    }
                                    <div class="font-mono font-bold text-primary leading-none mb-1.5"
                                         style="font-size: clamp(15px, 2vw, 20px)">@b.BirimNo</div>
                                    <div class="text-[11.5px] text-muted font-medium">@b.Yuzolcumu.ToString("N0") m²</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                </div>

                <!-- Boş durum -->
                <div x-show="Object.keys(katBosMap).every(k =>
                        (filter === 'kirali' && !katKiraliMap[k]) ||
                        (filter === 'bos' && !katBosMap[k]) ||
                        (search !== '' && !(katSearchDataMap[k] || []).some(t => t.includes(search.toLowerCase())))
                    )" x-cloak
                     class="flex flex-col items-center justify-center py-14 text-muted">
                    <svg class="mb-3 opacity-25" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                    </svg>
                    <p class="text-sm font-medium">Bu filtreye uygun unit bulunamadı</p>
                </div>
            </div>
        }
        else
        {
            <div class="card p-0 overflow-hidden">
                <div class="table-wrapper m-0">
                    <table class="table-fixed w-full">
                        <colgroup>
                            <col class="w-auto" />
                            <col class="w-[90px]" />
                            <col class="w-[140px]" />
                            <col class="w-auto" />
                            <col class="w-[130px]" />
                            <col class="w-[140px]" />
                            <col class="w-[110px]" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Unit</th>
                                <th>Yüzölçüm</th>
                                <th>Durum</th>
                                <th>Kiracı</th>
                                <th>Bitiş Tarihi</th>
                                <th>Bedel</th>
                                <th class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Property.Units)
                            {
                                <tr>
                                    <td class="font-semibold">@b.Ad</td>
                                    <td>
                                        <span class="font-mono text-[12.5px] text-muted">@b.Yuzolcumu.ToString("N0")</span>
                                        <span class="text-[11px] text-muted">m²</span>
                                    </td>
                                    <td>@Html.Raw(DurumBadge(b.Durum))</td>
                                    <td>
                                        @if (b.AktifSozlesmeId.HasValue)
                                        {
                                            <a href="/Tenant/Detay/@b.AktifSozlesmeKiraciId.ToHashId()" class="font-semibold text-primary no-underline text-[13px] hover:underline">@b.AktifSozlesmeKiraciGosterimAdi</a>
                                        }
                                        else
                                        {

                                            <span class="text-[#c8cfd8]">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (b.AktifSozlesmeId.HasValue && b.AktifSozlesmeBitisTarihi.HasValue)
                                        {
                                            var kalanGun = (int)(b.AktifSozlesmeBitisTarihi.Value - DateTime.Now).TotalDays;
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-[13px] font-medium">@b.AktifSozlesmeBitisTarihi.Value.ToString("dd.MM.yyyy")</span>
                                                @if (kalanGun <= 30)
                                                {
                                                    <span class="day-badge @(kalanGun <= 10 ? "day-badge-red" : "day-badge-amber") text-[10.5px] px-1.5 py-0.5">@kalanGun g</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {

                                            <span class="text-[#c8cfd8]">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (b.RezervasyonYapilabilirMi)
                                        {
                                            @if (b.RezKuralId.HasValue)
                                            {
                                                <span class="font-serif font-bold text-[13.5px]">@b.RezKuralPeriyotUcreti?.ToString("N0") ₺</span>
                                                <span class="text-[11px] text-muted ml-0.5">/ @b.RezKuralUcretlendirmePeriyoduDakika dk</span>
                                            }
                                            else
                                            {

                                                <span class="text-[#c8cfd8] text-xs">genel tarife</span>
                                            }
                                        }
                                        else if (b.AktifSozlesmeId.HasValue)
                                        {
                                            <div>
                                                <span class="font-serif font-bold text-sm">@b.AylikBedel.ToString("N0") ₺</span>
                                                <span class="text-[11px] text-muted ml-0.5">/ay</span>
                                            </div>
                                        }
                                        else
                                        {

                                            <span class="text-[#c8cfd8]">—</span>
                                        }
                                    </td>
                                    <td class="text-center flex gap-1 justify-center flex-wrap">
                                        @if (b.RezervasyonYapilabilirMi)
                                        {
                                            @if (canEdit)
                                            {
                                                <a href="/Reservation/Ekle?unitId=@b.Id.ToHashId()" class="btn btn-sm btn-primary">Reservation</a>
                                            }
                                        }
                                        else
                                        {
                                            @if (b.AktifSozlesmeId.HasValue)
                                            {
                                                <a href="/Lease/Detay/@b.AktifSozlesmeId.ToHashId()" class="btn btn-sm btn-secondary">Sözleşme</a>
                                            }
                                            else if (canEdit)
                                            {
                                                <a href="/Lease/Ekle?unitId=@b.Id.ToHashId()" class="btn btn-sm btn-primary">Kiraya Ver</a>
                                            }
                                        }
                                        @if (canManageRate)
                                        {
                                            <a href="/Unit/@b.Id.ToHashId()/OzelFiyat" class="btn btn-sm btn-secondary" title="Özel Fiyatlar">₺</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 3: Sözleşme Geçmişi -->
    <div class="tab-content">
        @{
            var tumSozlesmeler = Model.Property.SozlesmeGecmisi
                .OrderByDescending(s => s.StartDate)
                .ToList();
        }
        @if (!tumSozlesmeler.Any())
        {
            <div class="p-8 text-center text-muted">Henüz sözleşme kaydı yok.</div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Unit</th>
                            <th>Kiracı</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Bedel <span class="text-[10.5px] font-normal text-muted">(tam ay)</span></th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in tumSozlesmeler)
                        {
                            bool aktif = s.StartDate <= DateTime.Now && s.EndDate >= DateTime.Now;
                            bool surek = aktif && (s.EndDate - DateTime.Now).TotalDays <= 30;
                            <tr>
                                <td class="font-semibold">@s.BirimAd</td>
                                <td>
                                    <a href="/Tenant/Detay/@s.KiraciId.ToHashId()" class="text-primary no-underline font-medium hover:underline">@s.KiraciGosterimAdi</a>
                                </td>
                                <td>@s.StartDate.ToString("dd.MM.yyyy")</td>
                                <td>@s.EndDate.ToString("dd.MM.yyyy")</td>
                                <td class="font-semibold">@s.AylikBedel.ToString("N0") ₺/ay</td>
                                <td>
                                    @if (surek)
                                    {
                                        <span class="badge badge-surek">Dolmak Üzere</span>
                                    }
                                    else if (aktif)
                                    {

                                        <span class="badge badge-kirali">Aktif</span>
                                    }
                                    else
                                    {

                                        <span class="badge badge-gecmis">Geçmiş</span>
                                    }
                                </td>
                                <td><a href="/Lease/Detay/@s.Id.ToHashId()" class="btn btn-sm btn-secondary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Tab 4: Rezervasyonlar -->
    <div class="tab-content">
        @if (!Model.Property.Rezervasyonlar.Any())
        {
            <div class="p-8 text-center text-muted">Henüz reservation kaydı yok.</div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Unit</th>
                            <th>Kiracı</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Süre</th>
                            <th>Amount</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Property.Rezervasyonlar)
                        {
                            var rezDurumBadge = r.Durum switch
                            {
                                ReservationStatus.Planned => "<span class='badge bg-blue-100 text-blue-800'>Planlandı</span>",
                                ReservationStatus.Completed => "<span class='badge badge-kirali'>Tamamlandı</span>",
                                ReservationStatus.Cancelled => "<span class='badge badge-gecmis'>İptal</span>",
                                ReservationStatus.TransferredToCharge => "<span class='badge badge-surek'>Aktarıldı</span>",
                                _ => "<span class='badge'>—</span>"
                            };
                            <tr>
                                <td class="font-semibold">@r.BirimAd</td>
                                <td>
                                    <a href="/Tenant/Detay/@r.KiraciId.ToHashId()" class="text-primary no-underline font-medium hover:underline">@r.KiraciGosterimAdi</a>
                                </td>
                                <td>@r.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@r.EndDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="font-mono text-[12.5px]">@r.TotalDurationMinutes dk</span>
                                    @if (r.FreeDurationMinutes > 0)
                                    {
                                        <span class="text-[11px] text-muted"> (@r.FreeDurationMinutes dk ücretsiz)</span>
                                    }
                                </td>
                                <td class="font-semibold">@r.ToplamTutar.ToString("N0") ₺</td>
                                <td>@Html.Raw(rezDurumBadge)</td>
                                <td><a href="/Reservation/Detay/@r.Id.ToHashId()" class="btn btn-sm btn-secondary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Tab 5: Kira Tarifeleri -->
    <div class="tab-content">

        <!-- Bölüm 1: Taşınmaz Tarifeleri (Genel Tarife) -->
        <div class="flex justify-between items-center mb-3.5 pb-3 border-b-2 border-[var(--color-border)]">
            <div>
                <div class="text-[15px] font-bold">Taşınmaz Tarifeleri</div>
                <div class="text-xs text-muted mt-1">Sözleşme oluşturulurken varsayılan olarak kullanılır. Unit bazlı özel fiyat tanımlıysa bu tarife geçersiz kalır.</div>
            </div>
        </div>

        <div class="table-wrapper overflow-x-auto m-0 mb-8">
            <table class="table table-bordered min-w-[800px]">
                <thead>
                    <tr>
                        <th class="w-[180px]">Kiracı Kategorisi</th>
                        @foreach (var col in Model.FiyatMatrisi.Kolonlar)
                        {
                            <th class="text-center">
                                <div class="text-[11px] text-muted mb-0.5">@col.ChargeTypeCode</div>
                                <div class="text-[13px]">@col.ChargeTypeName</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FiyatMatrisi?.Satirlar == null || Model.FiyatMatrisi.Satirlar.Count == 0)
                    {
                        <tr>
                            <td colspan="@(Model.FiyatMatrisi?.Kolonlar?.Count + 1 ?? 1)" class="text-center py-6 text-slate-400 text-sm">
                                Tanımlı fiyat parametresi bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var satir in Model.FiyatMatrisi.Satirlar)
                        {
                            <tr>
                                <td class="font-semibold align-middle bg-[#fafbfc]">@satir.KiraciKategoriAd</td>
                                @foreach (var hucre in satir.Hucreler)
                                {
                                    <td class="p-3 text-center @(hucre.RateVarMi ? "" : "bg-[#f9fafb]")">
                                        @if (hucre.RateVarMi)
                                        {
                                            <div class="font-serif font-bold text-[15px]">
                                                @hucre.UnitValue?.ToString("N2") ₺
                                                <small class="font-sans text-[11px] font-normal text-muted">
                                                    @(hucre.CalculationMethod == CalculationMethod.Fixed ? "/sabit" : "/m²")
                                                </small>
                                            </div>
                                            <div class="text-[11px] text-muted mt-1">KDV: %@hucre.KdvRate?.ToString("N0")</div>
                                        }
                                        else
                                        {
                                            <div class="text-[#c8cfd8] text-xs">Tanımsız</div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Bölüm 2: Unit Bazlı Özel Fiyatlar -->
        <div class="flex justify-between items-center mb-3.5 pb-3 border-b-2 border-[var(--color-border)]">
            <div>
                <div class="text-[15px] font-bold">Unit Bazlı Özel Fiyatlar</div>
                <div class="text-xs text-muted mt-1">Aşağıdaki birimler için taşınmaz tarifesi yerine bu özel fiyatlar geçerlidir.</div>
            </div>
        </div>

        @if (Model.Property.BirimOzelFiyatlari.Any())
        {
            <div class="mb-8">
                @foreach (var birimOzet in Model.Property.BirimOzelFiyatlari)
                {
                    <div class="card mb-2.5 p-0 overflow-hidden">
                        <div class="flex items-center justify-between p-2.5 px-4 bg-[#fafbfc] border-b border-[var(--color-border)]">
                            <div class="flex items-center gap-2.5">
                                @if (!string.IsNullOrEmpty(birimOzet.UnitNo))
                                {
                                    <span class="font-mono text-[13px] font-bold text-primary bg-primary-light px-2 py-0.5 rounded-md">@birimOzet.UnitNo</span>
                                }
                                <span class="text-[13.5px] font-bold">@(birimOzet.UnitName ?? "—")</span>
                                <span class="badge badge-kirali text-[10.5px]">@birimOzet.Rateler.Count özel fiyat</span>
                            </div>
                            @if (canManageRate)
                            {
                                <a href="/Unit/@birimOzet.UnitId.ToHashId()/OzelFiyat" class="btn btn-sm btn-secondary">Düzenle</a>
                            }
                        </div>
                        <div class="table-wrapper m-0">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Kiracı Kategorisi</th>
                                        <th>Ücret Tipi</th>
                                        <th>Hesaplama</th>
                                        <th>Fiyat</th>
                                        <th>KDV</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in birimOzet.Rateler)
                                    {
                                        <tr>
                                            <td class="font-semibold">@r.TenantCategoryName</td>
                                            <td>@r.ChargeTypeName</td>
                                            <td class="text-xs text-muted">@(r.CalculationMethod == CalculationMethod.Fixed ? "Sabit" : "m² bazlı")</td>
                                            <td class="font-serif font-bold">@r.UnitValue.ToString("N2") ₺</td>
                                            <td class="text-[12.5px] text-muted">%@r.KdvRate.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-3.5 px-4.5 bg-[#f9fafb] border border-[var(--color-border)] rounded-lg text-[13px] text-muted mb-8">
                Tüm birimler için taşınmaz tarifeleri geçerlidir. Unit bazlı özel fiyat tanımlı değil.
            </div>
        }

        <!-- Bölüm 3: Reservation Ücret Kuralları -->
        @{
            var rezBirimler = Model.Property.Units.Where(b => b.RezervasyonYapilabilirMi).ToList();
        }
        @if (rezBirimler.Any())
        {
            <div class="flex justify-between items-center mb-3.5 pb-3 border-b-2 border-[var(--color-border)]">
                <div>
                    <div class="text-[15px] font-bold">Reservation Ücret Kuralları</div>
                    <div class="text-xs text-muted mt-1">Reservation birimi olan birimlerin saatlik/periyotluk ücretlendirme kuralları.</div>
                </div>
            </div>
            <div class="table-wrapper m-0">
                <table>
                    <thead>
                        <tr>
                            <th>Unit</th>
                            <th>Kural</th>
                            <th>Periyot Ücreti</th>
                            <th>Periyot</th>
                            <th>Ücretsiz Süre</th>
                            <th>KDV</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in rezBirimler)
                        {
                            var ozelKural = Model.Property.BirimRezervasyonKurallari.FirstOrDefault(k => k.BirimId == b.Id);
                            var aktifKural = ozelKural;
                            <tr>
                                <td class="font-semibold">@(b.Ad ?? b.BirimNo)</td>
                                <td>
                                    @if (ozelKural != null)
                                    {
                                        <span class="badge badge-kirali">Özel</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted">Tanımsız</span>
                                    }
                                </td>
                                @if (aktifKural != null)
                                {
                                    <td class="font-semibold">@aktifKural.PeriyotUcreti.ToString("N0") ₺</td>
                                    <td>@aktifKural.UcretlendirmePeriyoduDakika dk</td>
                                    <td>@aktifKural.FreeDurationMinutes dk</td>
                                    <td>%@aktifKural.KdvRate.ToString("N0")</td>
                                }
                                else
                                {
                                    <td colspan="4" class="text-[#c8cfd8] text-xs">Kural tanımlı değil</td>
                                }
                                <td>
                                    @if (canManageRate)
                                    {
                                        <a href="/Unit/@b.Id.ToHashId()/OzelFiyat" class="btn btn-sm btn-secondary">Düzenle</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>initTabs('detay-tabs');</script>
}

