@model KiraTakip.Models.ViewModels.ReservationCreateViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Rezervasyon Ekle";
}

<div class="max-w-[1000px] mx-auto">
    <div class="page-header">
        <a href="/Reservation" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← Rezervasyonlar</a>
        <div class="page-title">Rezervasyon Ekle</div>
        <div class="page-subtitle">Seçilen birim için tarih ve saat belirleyin</div>
    </div>

    <div x-data="rezervasyonForm()" @@datechanged="onPickerChanged($event)">
    <form asp-action="Ekle" method="post" asp-form-write-permission="@PermissionCatalog.Reservation.Create">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="form-error bg-red-50 border border-red-200 rounded-lg p-3 mb-5"></div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Birim ve Kiracı</span>
            </div>

            <div class="form-group mb-5">
                <label asp-for="UnitId" class="form-label">Taşınmaz Birimi <span class="text-red-500">*</span></label>
                <select asp-for="UnitId" class="form-control" x-on:change="birimSecildi($event)">
                    <option value="">— Birim seçin —</option>
                    @foreach (var b in Model.Units)
                    {
                        <option value="@b.Id"
                            data-property="@b.PropertyName"
                            data-tur="@b.UnitTypeName">
                            @b.PropertyName — @b.Name
                            @if (!string.IsNullOrEmpty(b.UnitTypeName)) { <text>(@b.UnitTypeName)</text> }
                        </option>
                    }
                </select>
                <span asp-validation-for="UnitId" class="form-error"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-group mb-0">
                    <label asp-for="TenantId" class="form-label">Kiracı <span class="text-red-500">*</span></label>
                    <select asp-for="TenantId" class="form-control" x-model="tenantId" x-on:change="kiraciSecildi($event)">
                        <option value="">— Kiracı seçin —</option>
                        @foreach (var k in Model.Tenants)
                        {
                            <option value="@k.Id">@k.GosterimAdi</option>
                        }

                    </select>
                    <span asp-validation-for="TenantId" class="form-error"></span>
                </div>

            </div>
        </div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Tarih ve Saat</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label class="form-label">Başlangıç <span class="text-red-500">*</span></label>
                    @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                        { "Name",  "StartDate" },
                        { "Value", Model.StartDate.ToString("yyyy-MM-ddTHH:mm") },
                        { "Mode",  "datetime" },
                        { "Field", "baslangic" }
                    })
                    <span asp-validation-for="StartDate" class="form-error"></span>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Bitiş <span class="text-red-500">*</span></label>
                    @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                        { "Name",  "EndDate" },
                        { "Value", Model.EndDate.ToString("yyyy-MM-ddTHH:mm") },
                        { "Mode",  "datetime" },
                        { "Field", "bitis" }
                    })
                    <span asp-validation-for="EndDate" class="form-error"></span>
                </div>
            </div>

            <!-- Ücret Önizlemesi -->
            <template x-if="hesapSonucu">
                <div class="bg-slate-50 border border-[var(--color-border)] rounded-lg p-3.5 mt-1">
                    <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-2.5">Ücret Önizlemesi</div>
                    <div class="grid grid-cols-3 gap-3 mb-2.5">
                        <div>
                            <div class="text-[10px] text-muted">Toplam Süre</div>
                            <div class="font-semibold" x-text="hesapSonucu.toplamSureDakika + ' dk'"></div>
                        </div>
                        <div>
                            <div class="text-[10px] text-muted">Ücretsiz Süre</div>
                            <div class="font-semibold text-emerald-600" x-text="hesapSonucu.ucretsizSureDakika + ' dk'"></div>
                        </div>
                        <div>
                            <div class="text-[10px] text-muted">Ücretli Süre</div>
                            <div class="font-semibold" x-text="hesapSonucu.ucretliSureDakika + ' dk'"></div>
                        </div>
                    </div>
                    <template x-if="hesapSonucu.ucretTutar > 0">
                        <div>
                            <div class="flex justify-between text-[13px] mb-1">
                                <span class="text-muted">Ücret (<span x-text="hesapSonucu.ucretliPeriyotSayisi"></span> periyot × <span x-text="hesapSonucu.birimUcret.toLocaleString('tr-TR', {minimumFractionDigits:2})"></span> ₺)</span>
                                <span x-text="hesapSonucu.ucretTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                            <div class="flex justify-between text-[13px] mb-1.5">
                                <span class="text-muted">KDV (%<span x-text="hesapSonucu.kdvOrani"></span>)</span>
                                <span x-text="hesapSonucu.kdvTutari.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                            <div class="flex justify-between text-[15px] font-bold border-t border-[var(--color-border)] pt-2 mt-1">
                                <span>Toplam</span>
                                <span class="text-primary" x-text="hesapSonucu.toplamTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                        </div>
                    </template>
                    <template x-if="hesapSonucu.ucretTutar === 0">
                        <div class="text-sm font-semibold text-emerald-600 text-center py-1">✓ Ücretsiz kullanım — süre sınırı aşılmıyor</div>
                    </template>
                </div>
            </template>
            <template x-if="hataMessaji">
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-2.5 text-sm text-amber-800 mt-1" x-text="hataMessaji"></div>
            </template>
        </div>

        <div class="card mb-4">
            <div class="form-group mb-0">
                <label asp-for="Description" class="form-label">Açıklama <span class="text-muted font-normal">(opsiyonel)</span></label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Rezervasyon konusu, katılımcılar vb."></textarea>
            </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
            <a href="/Reservation" class="btn btn-secondary px-6">İptal</a>
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.Reservation.Create">Rezervasyon Oluştur</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
<script>
function rezervasyonForm() {
    return {
        unitId: @(Model.UnitId > 0 ? Model.UnitId.ToString() : "0"),
        tenantId: @(Model.TenantId > 0 ? Model.TenantId.ToString() : "0"),
        baslangic: '@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")',
        bitis: '@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")',
        hesapSonucu: null,
        hataMessaji: null,
        _timer: null,

        kiraciSecildi(e) {
            this.tenantId = e.target.value;
        },

        birimSecildi(e) {
            this.unitId = parseInt(e.target.value) || 0;
            this.hesapla();
        },

        onPickerChanged(e) {
            if (e.detail.field === 'baslangic') this.baslangic = e.detail.value;
            else if (e.detail.field === 'bitis') this.bitis = e.detail.value;
            this.hesapla();
        },

        hesapla() {
            clearTimeout(this._timer);
            if (!this.unitId || !this.baslangic || !this.bitis) {
                this.hesapSonucu = null;
                this.hataMessaji = null;
                return;
            }
            this._timer = setTimeout(() => this._fetchHesap(), 400);
        },

        async _fetchHesap() {
            try {
                const r = await fetch(`/Reservation/Hesapla?unitId=${this.unitId}&baslangic=${encodeURIComponent(this.baslangic)}&bitis=${encodeURIComponent(this.bitis)}`);
                const d = await r.json();
                if (d.hataMessaji) {
                    this.hataMessaji = d.hataMessaji;
                    this.hesapSonucu = d.kuralBulundu ? d : null;
                } else {
                    this.hataMessaji = null;
                    this.hesapSonucu = d;
                }
            } catch {
                this.hesapSonucu = null;
            }
        },

        init() {
            this.hesapla();
        }
    };
}
</script>
}

