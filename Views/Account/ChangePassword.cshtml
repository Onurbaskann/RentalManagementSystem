@model KiraTakip.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header">
    <div class="page-title">Şifre Değiştir</div>
    <div class="page-subtitle">Hesap güvenliğiniz için güçlü bir şifre belirleyin</div>
</div>

<div class="max-w-md">
    <div class="card">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Mevcut Şifre <span class="text-red-500">*</span></label>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" class="form-input" placeholder="••••••••" />
                <span asp-validation-for="CurrentPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Yeni Şifre <span class="text-red-500">*</span></label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" class="form-input" placeholder="En az 6 karakter" />
                <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Yeni Şifre Tekrar <span class="text-red-500">*</span></label>
                <input asp-for="NewPasswordConfirm" type="password" autocomplete="new-password" class="form-input" placeholder="••••••••" />
                <span asp-validation-for="NewPasswordConfirm" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex gap-3 mt-6">
                <button type="submit" class="btn btn-primary">Şifremi Güncelle</button>
                <a href="javascript:history.back()" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

