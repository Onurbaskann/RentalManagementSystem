@model KiraTakip.Models.ViewModels.InviteAcceptViewModel
@{
    Layout = null;
    ViewData["Title"] = "Davet Kabul";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kira Takip — Hesap Oluştur</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-stone-50 flex items-center justify-center p-4" style="font-family: 'Inter', sans-serif;">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-600 mb-4">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-stone-900" style="font-family: 'Fraunces', Georgia, serif;">Kira Takip</h1>
            <p class="text-stone-500 text-sm mt-1">Hesabınızı oluşturun</p>
        </div>

        <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-8">
            <h2 class="text-lg font-semibold text-stone-900 mb-1">Hesap Oluştur</h2>
            <p class="text-sm text-stone-500 mb-6"><strong>@Model.Email</strong> için davet bağlantısı doğrulandı.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm mb-5">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="mb-4">
                    <label class="block text-sm font-medium text-stone-700 mb-1.5">Ad Soyad <span class="text-red-500">*</span></label>
                    <input asp-for="FullName" class="w-full px-3.5 py-2.5 rounded-lg border border-stone-200 text-sm text-stone-900 bg-white placeholder-stone-400 outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all" />
                    <span asp-validation-for="FullName" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-stone-700 mb-1.5">Şifre <span class="text-red-500">*</span></label>
                    <input asp-for="Password" type="password" autocomplete="new-password"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-200 text-sm text-stone-900 bg-white placeholder-stone-400 outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all"
                        placeholder="En az 6 karakter, büyük/küçük harf, rakam ve özel karakter" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-stone-700 mb-1.5">Şifre Tekrar <span class="text-red-500">*</span></label>
                    <input asp-for="PasswordConfirm" type="password" autocomplete="new-password"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-200 text-sm text-stone-900 bg-white placeholder-stone-400 outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all"
                        placeholder="••••••••" />
                    <span asp-validation-for="PasswordConfirm" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <button type="submit"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm py-2.5 px-4 rounded-lg transition-colors">
                    Hesabımı Oluştur
                </button>
            </form>
        </div>
    </div>
</body>
</html>

