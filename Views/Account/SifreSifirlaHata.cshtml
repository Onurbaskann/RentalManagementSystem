@{
    Layout = null;
    ViewData["Title"] = "Geçersiz Bağlantı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kira Takip — Geçersiz Bağlantı</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-stone-50 flex items-center justify-center p-4" style="font-family: 'Inter', sans-serif;">
    <div class="w-full max-w-md text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-red-100 mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>
        <h1 class="text-xl font-semibold text-stone-900 mb-2" style="font-family: 'Fraunces', Georgia, serif;">Geçersiz Sıfırlama Bağlantısı</h1>
        <p class="text-stone-500 text-sm mb-6">@(ViewBag.Hata ?? "Bu şifre sıfırlama bağlantısı geçersiz veya süresi dolmuş.")</p>
        <a href="/Account/SifreUnuttum" class="text-emerald-600 hover:text-emerald-700 text-sm font-medium">Yeni sıfırlama bağlantısı iste</a>
    </div>
</body>
</html>
