@model KiraTakip.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
    string? returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kira Takip — Giriş</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-stone-50 flex items-center justify-center p-4 selection:bg-emerald-100 selection:text-emerald-900" style="font-family: 'Inter', sans-serif;">
    <div class="w-full max-w-md">
        <!-- Logo / Marka -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-600 mb-4">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-stone-900" style="font-family: 'Fraunces', Georgia, serif;">Kira Takip</h1>
            <p class="text-stone-500 text-sm mt-1">Yönetim Paneli</p>
        </div>

        <!-- Login Kartı -->
        <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-8">
            <h2 class="text-lg font-semibold text-stone-900 mb-1">Hesabınıza giriş yapın</h2>
            <p class="text-sm text-stone-500 mb-6">Devam etmek için e-posta ve şifrenizi girin.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm mb-5">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Login" method="post">
                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="block text-sm font-medium text-stone-700 mb-1.5">E-posta</label>
                    <input asp-for="Email" type="email" autocomplete="email"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-200 text-sm text-stone-900 bg-white placeholder-stone-400 outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all"
                        placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-5">
                    <label class="block text-sm font-medium text-stone-700 mb-1.5">Şifre</label>
                    <input asp-for="Password" type="password" autocomplete="current-password"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-200 text-sm text-stone-900 bg-white placeholder-stone-400 outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all"
                        placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between mb-6">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input asp-for="RememberMe" type="checkbox"
                            class="w-4 h-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
                        <span class="text-sm text-stone-600">Beni hatırla</span>
                    </label>
                </div>

                <button type="submit"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm py-2.5 px-4 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
                    Giriş Yap
                </button>
            </form>
        </div>


    </div>
</body>
</html>
