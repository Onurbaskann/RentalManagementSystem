@model KiraTakip.Models.ViewModels.TenantFormViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Yeni Kiracı";
    ViewData["UseCentralFeedback"] = true;
    var controllerName = nameof(KiraTakip.Controllers.TenantController).Replace("Controller", "");
    var indexUrl = Url.Action(nameof(KiraTakip.Controllers.TenantController.Index), controllerName)!;

    string[] errorKeys = new[] {
        "TenantNo","TenantCategoryId","SectorId",
        "Name","TaxNo","TaxOffice",
        "Phone","Email","Address"
    };
    var errorsDict = errorKeys.ToDictionary(
        key => char.ToLowerInvariant(key[0]) + key.Substring(1),
        key => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage ?? ""
    );
    var documentTypesForErrors = Model.DocumentTypes;
    if (documentTypesForErrors.Count > 0)
    {
        foreach (var documentType in documentTypesForErrors)
        {
            var key = $"dosya_{documentType.Id}";
            errorsDict[key] = ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage ?? "";
        }
    }
    var errorsJson = System.Text.Json.JsonSerializer.Serialize(errorsDict);
}

<div class="max-w-[800px] mx-auto">
    <div class="page-header">
        <a href="@indexUrl" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← Kiracılar</a>
        <div class="page-title">Yeni Kiracı Ekle</div>
    </div>
    <form asp-action="@nameof(KiraTakip.Controllers.TenantController.Create)" method="post" enctype="multipart/form-data"
          asp-form-write-permission="@PermissionCatalog.Tenant.Create"
          x-data="kiraciFormData()"
          x-cloak>
        @Html.AntiForgeryToken()

        <!-- Temel Bilgiler -->
        <div class="card mb-5">
            <div class="text-[15px] font-bold mb-5 pb-3 border-b border-slate-100 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                Temel Bilgiler
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-3.5 gap-y-4">
                <div class="form-group mb-0">
                    <label class="form-label">Kiracı No *</label>
                    <input asp-for="TenantNo" class="form-control font-mono" />
                    <span x-show="errors.tenantNo" x-text="errors.tenantNo" class="form-error"></span>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Kiracı Kategorisi *</label>
                    <select asp-for="TenantCategoryId" class="form-control">
                        <option value="">— Seçiniz —</option>
                        @foreach (var item in Model.TenantCategories)
                        {
                            <option value="@item.Id" selected="@(Model.TenantCategoryId == item.Id ? "selected" : null)">@item.Name</option>
                        }
                    </select>
                    <span x-show="errors.tenantCategoryId" x-text="errors.tenantCategoryId" class="form-error"></span>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Sektör *</label>
                    <select asp-for="SectorId" class="form-control">
                        <option value="">— Seçiniz —</option>
                        @foreach (var item in Model.Sectors)
                        {
                            <option value="@item.Id" selected="@(Model.SectorId == item.Id ? "selected" : null)">@item.Name</option>
                        }
                    </select>
                    <span x-show="errors.sectorId" x-text="errors.sectorId" class="form-error"></span>
                </div>
            </div>
        </div>

        <!-- Tüzel Kişi Bilgileri -->
        <div class="card mb-5">
            <div class="text-[15px] font-bold mb-5 pb-3 border-b border-slate-100 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                Tüzel Kişi Bilgileri
            </div>

            <div class="form-group mb-3.5">
                <label class="form-label">Firma / Kurum Adı *</label>
                <input asp-for="Name" class="form-control" placeholder="Örn: Yıldız Yazılım A.Ş." />
                <span x-show="errors.name" x-text="errors.name" class="form-error"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-3.5 gap-y-4">
                <div class="form-group">
                    <label class="form-label">Vergi No *</label>
                    <input asp-for="TaxNo" class="form-control" inputmode="numeric" placeholder="10 haneli" />
                    <span x-show="errors.taxNo" x-text="errors.taxNo" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Vergi Dairesi *</label>
                    <input asp-for="TaxOffice" class="form-control" placeholder="Örn: Bornova VD" />
                    <span x-show="errors.taxOffice" x-text="errors.taxOffice" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Ticaret Sicil No</label>
                    <input asp-for="TradeRegistryNo" class="form-control" placeholder="Opsiyonel" />
                </div>
                <div class="form-group">
                    <label class="form-label">Mersis No</label>
                    <input asp-for="MersisNo" class="form-control" placeholder="Opsiyonel" />
                </div>
            </div>
        </div>

        <!-- İletişim -->
        <div class="card mb-5">
            <div class="text-[15px] font-bold mb-5 pb-3 border-b border-slate-100 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                İletişim Bilgileri
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-3.5 gap-y-4">
                <div class="form-group">
                    <label class="form-label">Telefon *</label>
                    <input asp-for="Phone" class="form-control" placeholder="0532 111 2233" />
                    <span x-show="errors.phone" x-text="errors.phone" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">E-posta *</label>
                    <input asp-for="Email" type="text" class="form-control" placeholder="ornek@email.com" />
                    <span x-show="errors.email" x-text="errors.email" class="form-error"></span>
                </div>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Adres *</label>
                <textarea asp-for="Address" class="form-control" rows="2" placeholder="İl / ilçe / mahalle / cadde / no"></textarea>
                <span x-show="errors.address" x-text="errors.address" class="form-error"></span>
            </div>
        </div>

        @{
            var documentTypes = Model.DocumentTypes;
        }
        @await Html.PartialAsync("_BelgeEkleForm", documentTypes)

        <div class="card mt-4 bg-indigo-50/60 border border-indigo-100">
            <div class="text-sm font-semibold text-slate-700 mb-3">İlk Firma Yetkilisi Daveti <span class="text-muted font-normal">(opsiyonel)</span></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="form-label">E-posta</label>
                    <input asp-for="InitialRepresentativeEmail" type="text" class="form-control" placeholder="yetkili@firma.com" />
                    <span asp-validation-for="InitialRepresentativeEmail" class="form-error"></span>
                </div>
                <div>
                    <label class="form-label">Ad Soyad</label>
                    <input asp-for="InitialRepresentativeFullName" type="text" class="form-control" placeholder="Ad Soyad" />
                    <span asp-validation-for="InitialRepresentativeFullName" class="form-error"></span>
                </div>
            </div>
            <div class="text-xs text-muted mt-2">Girilirse, kiracı oluşturulduktan hemen sonra Firma Yetkilisi rolüyle davet e-postası gönderilir.</div>
        </div>

        <div class="flex gap-3 mt-6">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.Tenant.Create">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Kaydet
            </button>
            <a href="@indexUrl" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
function kiraciFormData() {
    return {
        errors: @Html.Raw(errorsJson)
    };
}
</script>
}

