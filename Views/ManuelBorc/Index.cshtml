@model List<KiraTakip.Models.Dtos.ManuelBorcListItemDto>
@using KiraTakip.Models
@{
    ViewData["Title"] = "Manuel Borçlar";
    bool canCreate = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.ManuelBorc.Create);
    bool canCancel = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.ManuelBorc.Cancel);
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Manuel Borçlar</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    @if (canCreate)
    {
        <a href="/ManuelBorc/Ekle" class="btn btn-primary flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Manuel Borç Ekle
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✕ @TempData["Error"]
    </div>
}

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th>Kiracı</th>
                    <th>Taşınmaz / Birim</th>
                    <th class="w-24 text-center">Tip</th>
                    <th>Açıklama</th>
                    <th class="w-28 text-right">Tutar</th>
                    <th class="w-24 text-right text-muted">KDV</th>
                    <th class="w-32 text-right">Toplam</th>
                    <th class="w-28 text-center">Vade</th>
                    <th class="w-32">Durum</th>
                    <th class="w-48 text-right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    var kalan = t.ToplamTutar - t.OdenenTutar;
                    string durumCls = t.Durum switch {
                        TahakkukDurumu.TamOdendi    => "badge-kirali",
                        TahakkukDurumu.KismenOdendi => "badge-surek",
                        TahakkukDurumu.Gecikti      => "badge-gecmis",
                        TahakkukDurumu.IptalEdildi  => "badge-bos",
                        _                           => "badge-bos"
                    };
                    string durumLabel = t.Durum switch {
                        TahakkukDurumu.TamOdendi    => "Tam Ödendi",
                        TahakkukDurumu.KismenOdendi => "Kısmi Ödendi",
                        TahakkukDurumu.Gecikti      => "Gecikti",
                        TahakkukDurumu.IptalEdildi  => "İptal Edildi",
                        _                           => "Bekleniyor"
                    };
                    <tr>
                        <td>
                            <div class="font-semibold text-slate-800">@(t.KiraciGosterimAdi ?? "-")</div>
                        </td>
                        <td>
                            <div class="font-medium text-slate-700">@(t.TasinmazAd ?? "-")</div>
                            <div class="text-[11px] text-muted">@(t.BirimAd ?? "-")</div>
                        </td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(t.BorcTipiKod))
                            {
                                <span class="font-mono text-[11px] font-bold bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200">@t.BorcTipiKod</span>
                            }
                        </td>
                        <td class="text-xs text-muted max-w-[200px] truncate">@(t.IlkKalemAciklama ?? "-")</td>
                        <td class="text-right text-xs text-slate-600">@t.BeklenenTutar.ToString("N2") ₺</td>
                        <td class="text-right text-[11px] text-muted/60">@t.KdvTutari.ToString("N2") ₺</td>
                        <td class="text-right font-bold text-slate-700">@t.ToplamTutar.ToString("N2") ₺</td>
                        <td class="text-center text-xs">@t.VadeTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge @durumCls text-[10px] font-bold">@durumLabel.ToUpper()</span>
                            @if (!string.IsNullOrEmpty(t.IptalNotu))
                            {
                                <div class="text-[10px] text-muted mt-1 italic truncate max-w-[100px]" title="@t.IptalNotu">⤵ @t.IptalNotu</div>
                            }
                        </td>
                        <td class="text-right">
                            <div class="flex gap-1.5 justify-end items-center">
                                <a href="/Tahakkuk/Detay/@t.Id" class="btn btn-sm btn-secondary py-1 px-2.5 text-[11px]">Detay</a>
                                @if (t.Durum != TahakkukDurumu.IptalEdildi && t.Durum != TahakkukDurumu.TamOdendi)
                                {
                                    <a href="/Odeme/Ekle?tahakkukId=@t.Id" class="btn btn-sm btn-primary py-1 px-2.5 text-[11px]">Ödeme</a>
                                }
                                @if (canCancel && t.Durum != TahakkukDurumu.IptalEdildi && t.Durum != TahakkukDurumu.TamOdendi)
                                {
                                    <button type="button" class="btn btn-sm bg-red-50 text-red-600 border-red-200 hover:bg-red-600 hover:text-white py-1 px-2.5 text-[11px]"
                                        data-confirm="Bu manuel borcu iptal etmek istediğinize emin misiniz?"
                                        data-confirm-title="Manuel Borç İptali"
                                        data-confirm-action="/ManuelBorc/Iptal/@t.Id"
                                        data-confirm-method="POST"
                                        data-confirm-needs-reason="true"
                                        data-confirm-reason-label="İptal nedeni">
                                        İptal
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="py-16 text-center">
                            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 text-slate-300 mb-4">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                            </div>
                            <div class="text-slate-500 font-bold">Manuel borç kaydı bulunamadı</div>
                            @if (canCreate)
                            {
                                <div class="text-xs text-muted mt-1">
                                    <a href="/ManuelBorc/Ekle" class="text-primary font-semibold hover:underline">Manuel Borç Ekle</a> butonuyla ilk kaydı oluşturun.
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('[data-confirm]').forEach(btn => {
    btn.addEventListener('click', function() {
        const needsReason = this.dataset.confirmNeedsReason === 'true';
        const action = this.dataset.confirmAction;
        const title = this.dataset.confirmTitle || 'Onay';
        const message = this.dataset.confirm;
        const reasonLabel = this.dataset.confirmReasonLabel || 'Neden';

        if (needsReason) {
            const neden = prompt(`${title}\n\n${message}\n\n${reasonLabel}:`);
            if (neden === null || neden.trim() === '') return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = action;

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const t = document.createElement('input');
                t.type = 'hidden';
                t.name = '__RequestVerificationToken';
                t.value = token.value;
                form.appendChild(t);
            }

            const n = document.createElement('input');
            n.type = 'hidden';
            n.name = 'neden';
            n.value = neden.trim();
            form.appendChild(n);

            document.body.appendChild(form);
            form.submit();
        }
    });
});
</script>
@Html.AntiForgeryToken()
}
