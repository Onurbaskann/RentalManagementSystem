@model List<KiraTakip.Models.KiraTahakkuk>
@using KiraTakip.Models
@{
    ViewData["Title"] = "Manuel Borçlar";
    bool canCreate = User.HasClaim("permission", "ManuelBorc.Create");
    bool canCancel = User.HasClaim("permission", "ManuelBorc.Cancel");
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Manuel Borçlar</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    @if (canCreate)
    {
        <a href="/ManuelBorc/Ekle" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Manuel Borç Ekle
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✕ @TempData["Error"]</div>
}

<div class="card" style="padding:0;overflow:hidden;">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Kiracı</th>
                    <th>Taşınmaz / Birim</th>
                    <th>Borç Tipi</th>
                    <th>Açıklama</th>
                    <th>Tutar</th>
                    <th>KDV</th>
                    <th>Toplam</th>
                    <th>Vade</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    var kalan = t.ToplamTutar - t.OdenenTutar;
                    string durumCls = t.Durum switch {
                        TahakkukDurumu.TamOdendi    => "badge-kirali",
                        TahakkukDurumu.KismenOdendi => "badge-surek",
                        TahakkukDurumu.Gecikti      => "badge-gecmis",
                        TahakkukDurumu.IptalEdildi  => "badge-bos",
                        _                           => "badge-bos"
                    };
                    string durumLabel = t.Durum switch {
                        TahakkukDurumu.TamOdendi    => "Tam Ödendi",
                        TahakkukDurumu.KismenOdendi => "Kısmi Ödendi",
                        TahakkukDurumu.Gecikti      => "Gecikti",
                        TahakkukDurumu.IptalEdildi  => "İptal Edildi",
                        _                           => "Bekleniyor"
                    };
                    var ilkKalem = t.Kalemler.FirstOrDefault();
                    <tr>
                        <td>
                            <div style="font-weight:600;">@t.KiraSozlesmesi.Kiraci.GosterimAdi</div>
                        </td>
                        <td>
                            <div style="font-weight:500;">@t.KiraSozlesmesi.Birim.Tasinmaz.Ad</div>
                            <div style="font-size:12px;color:var(--color-muted);">@t.KiraSozlesmesi.Birim.Ad</div>
                        </td>
                        <td>
                            @if (ilkKalem != null)
                            {
                                <span style="font-family:monospace;font-size:12px;font-weight:700;background:#f1f5f9;padding:2px 6px;border-radius:4px;">@ilkKalem.BorcTipi.Kod</span>
                            }
                        </td>
                        <td style="font-size:13px;color:var(--color-muted);">@(ilkKalem?.Aciklama ?? "-")</td>
                        <td style="font-weight:600;">@t.BeklenenTutar.ToString("N2") ₺</td>
                        <td style="font-size:13px;color:var(--color-muted);">@t.KdvTutari.ToString("N2") ₺</td>
                        <td style="font-weight:700;">@t.ToplamTutar.ToString("N2") ₺</td>
                        <td style="font-size:13px;">@t.VadeTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge @durumCls">@durumLabel</span>
                            @if (!string.IsNullOrEmpty(t.IptalNotu))
                            {
                                <div style="font-size:11px;color:var(--color-muted);margin-top:3px;" data-tip="@t.IptalNotu">↳ @(t.IptalNotu.Length > 30 ? t.IptalNotu[..30] + "…" : t.IptalNotu)</div>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:4px;flex-wrap:nowrap;">
                                <a href="/Tahakkuk/Detay/@t.Id" class="btn btn-sm btn-secondary">Detay</a>
                                @if (t.Durum != TahakkukDurumu.IptalEdildi && t.Durum != TahakkukDurumu.TamOdendi)
                                {
                                    <a href="/Odeme/Ekle?tahakkukId=@t.Id" class="btn btn-sm btn-primary">Ödeme Ekle</a>
                                }
                                @if (canCancel && t.Durum != TahakkukDurumu.IptalEdildi && t.Durum != TahakkukDurumu.TamOdendi)
                                {
                                    <button type="button" class="btn btn-sm btn-danger"
                                        data-confirm="Bu manuel borcu iptal etmek istediğinize emin misiniz?"
                                        data-confirm-title="Manuel Borç İptali"
                                        data-confirm-action="/ManuelBorc/Iptal/@t.Id"
                                        data-confirm-method="POST"
                                        data-confirm-needs-reason="true"
                                        data-confirm-reason-label="İptal nedeni">
                                        İptal
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="10" style="text-align:center;color:var(--color-muted);padding:40px;">
                        <div style="font-size:32px;margin-bottom:8px;">📋</div>
                        <div style="font-weight:600;margin-bottom:4px;">Manuel borç kaydı bulunamadı</div>
                        @if (canCreate)
                        {
                            <div style="font-size:13px;">
                                <a href="/ManuelBorc/Ekle" style="color:var(--color-primary);font-weight:600;">Manuel Borç Ekle</a> butonuyla ilk kaydı oluşturun.
                            </div>
                        }
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('[data-confirm]').forEach(btn => {
    btn.addEventListener('click', function() {
        const needsReason = this.dataset.confirmNeedsReason === 'true';
        const action = this.dataset.confirmAction;
        const title = this.dataset.confirmTitle || 'Onay';
        const message = this.dataset.confirm;
        const reasonLabel = this.dataset.confirmReasonLabel || 'Neden';

        if (needsReason) {
            const neden = prompt(`${title}\n\n${message}\n\n${reasonLabel}:`);
            if (neden === null || neden.trim() === '') return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = action;

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const t = document.createElement('input');
                t.type = 'hidden';
                t.name = '__RequestVerificationToken';
                t.value = token.value;
                form.appendChild(t);
            }

            const n = document.createElement('input');
            n.type = 'hidden';
            n.name = 'neden';
            n.value = neden.trim();
            form.appendChild(n);

            document.body.appendChild(form);
            form.submit();
        }
    });
});
</script>
@Html.AntiForgeryToken()
}
