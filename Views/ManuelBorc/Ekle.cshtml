@model KiraTakip.Models.ViewModels.ManuelBorcCreateViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Manuel Borç Ekle";
}

<div class="max-w-[1000px] mx-auto">
    <div class="page-header flex items-center justify-between">
        <div>
            <div class="page-title">Manuel Borç Ekle</div>
            <div class="page-subtitle">Aktif sözleşmeye tek seferlik borç kalemi ekleyin</div>
        </div>
        <a href="/ManuelBorc" class="btn btn-secondary">← Geri</a>
    </div>

    <div x-data="manuelBorcForm()">
    <form asp-action="Ekle" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="form-error bg-red-50 border border-red-200 rounded-lg p-3 mb-5"></div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Sözleşme Seçimi</span>
            </div>

            <div class="form-group mb-5">
                <label asp-for="SozlesmeId" class="form-label">Sözleşme <span class="text-red-500">*</span></label>
                <select asp-for="SozlesmeId" class="form-control" x-on:change="sozlesmeSecildi($event)">
                    <option value="">— Sözleşme seçin —</option>
                    @foreach (var s in Model.AktifSozlesmeler)
                    {
                        <option value="@s.Id"
                            data-kiraci="@s.KiraciGosterimAdi"
                            data-birim="@(s.TasinmazAd) — @s.BirimAd">
                            @s.KiraciGosterimAdi — @s.TasinmazAd / @s.BirimAd
                        </option>
                    }
                </select>
                <span asp-validation-for="SozlesmeId" class="form-error"></span>
            </div>

            <template x-if="sozlesme.kiraci">
                <div class="bg-primary/5 border border-primary/10 rounded-lg p-3.5 text-sm flex gap-6">
                    <div><span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-0.5">Kiracı</span><strong x-text="sozlesme.kiraci"></strong></div>
                    <div><span class="text-[11px] font-bold text-muted uppercase tracking-wider block mb-0.5">Taşınmaz / Birim</span><strong x-text="sozlesme.birim"></strong></div>
                </div>
            </template>
        </div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Borç Detayı</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label asp-for="BorcTipiId" class="form-label">Borç Tipi <span class="text-red-500">*</span></label>
                    <select asp-for="BorcTipiId" class="form-control">
                        <option value="">— Borç tipi seçin —</option>
                        @foreach (var bt in Model.BorcTipleri)
                        {
                            <option value="@bt.Id">@bt.Ad (@bt.Kod)</option>
                        }
                    </select>
                    <span asp-validation-for="BorcTipiId" class="form-error"></span>
                </div>

                <div class="form-group mb-0">
                    <label asp-for="VadeTarihi" class="form-label">Vade Tarihi <span class="text-red-500">*</span></label>
                    @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                        { "Name",  "VadeTarihi" },
                        { "Value", Model.VadeTarihi.ToString("yyyy-MM-dd") },
                        { "Mode",  "date" },
                        { "Field", "vadeTarihi" }
                    })
                    <span asp-validation-for="VadeTarihi" class="form-error"></span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Aciklama" class="form-label">Açıklama <span class="text-red-500">*</span></label>
                <input asp-for="Aciklama" type="text" class="form-control" placeholder="Ör: Anahtar bedeli, hasar tazminatı…" />
                <span asp-validation-for="Aciklama" class="form-error"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label asp-for="Tutar" class="form-label">Tutar (₺) <span class="text-red-500">*</span></label>
                    <input asp-for="Tutar" type="number" step="0.01" min="0.01" class="form-control"
                           placeholder="0,00" x-model.number="tutar" x-on:input="hesapla()" />
                    <span asp-validation-for="Tutar" class="form-error"></span>
                </div>

                <div class="form-group mb-0">
                    <label class="form-label">KDV</label>
                    <div class="flex items-center gap-4 pt-1">
                        <label class="flex items-center gap-2 cursor-pointer text-[13.5px] font-medium">
                            <input asp-for="KdvUygulanacakMi" type="checkbox" x-model="kdvAktif" x-on:change="hesapla()" class="w-4 h-4 accent-primary cursor-pointer" />
                            KDV uygula
                        </label>
                        <template x-if="kdvAktif">
                            <div class="flex items-center gap-1.5">
                                <input asp-for="KdvOrani" type="number" step="1" min="0" max="100" class="form-control w-20"
                                       x-model.number="kdvOrani" x-on:input="hesapla()" />
                                <span class="text-sm text-muted">%</span>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <template x-if="tutar > 0">
                <div class="bg-slate-50 border border-[var(--color-border)] rounded-lg p-3.5 mb-4">
                    <div class="flex justify-between text-[13px] mb-1">
                        <span class="text-muted">Ara Toplam</span>
                        <span x-text="tutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                    </div>
                    <template x-if="kdvAktif">
                        <div class="flex justify-between text-[13px] mb-1">
                            <span class="text-muted">KDV (<span x-text="kdvOrani"></span>%)</span>
                            <span x-text="kdvTutari.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                        </div>
                    </template>
                    <div class="flex justify-between text-[15px] font-bold border-t border-[var(--color-border)] pt-2 mt-1">
                        <span>Toplam</span>
                        <span class="text-primary" x-text="toplamTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                    </div>
                </div>
            </template>

            <div class="form-group mb-0">
                <label asp-for="Not" class="form-label">Not <span class="text-muted font-normal">(opsiyonel)</span></label>
                <textarea asp-for="Not" class="form-control" rows="2" placeholder="İç not, açıklama…"></textarea>
                <span asp-validation-for="Not" class="form-error"></span>
            </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
            <a href="/ManuelBorc" class="btn btn-secondary px-6">İptal</a>
            <button type="submit" class="btn btn-primary px-6">Manuel Borç Oluştur</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
<script>
function manuelBorcForm() {
    return {
        sozlesme: { kiraci: '', birim: '' },
        tutar: @(Model.Tutar > 0 ? Model.Tutar.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0"),
        kdvAktif: @(Model.KdvUygulanacakMi ? "true" : "false"),
        kdvOrani: @Model.KdvOrani.ToString("F0", System.Globalization.CultureInfo.InvariantCulture),
        kdvTutari: 0,
        toplamTutar: 0,

        init() {
            this.hesapla();
            const sel = document.querySelector('select[name="SozlesmeId"]');
            if (sel && sel.value) this.sozlesmeSecildi({ target: sel });
        },

        sozlesmeSecildi(e) {
            const opt = e.target.selectedOptions[0];
            if (!opt || !opt.value) {
                this.sozlesme = { kiraci: '', birim: '' };
                return;
            }
            this.sozlesme = {
                kiraci: opt.dataset.kiraci,
                birim: opt.dataset.birim
            };
        },

        hesapla() {
            const t = parseFloat(this.tutar) || 0;
            const oran = parseFloat(this.kdvOrani) || 0;
            this.kdvTutari = this.kdvAktif ? Math.round(t * oran / 100 * 100) / 100 : 0;
            this.toplamTutar = t + this.kdvTutari;
        }
    };
}
</script>
}
