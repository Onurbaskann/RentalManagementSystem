@model KiraTakip.Models.TasinmazKategoriCarpan
@{
    ViewData["Title"] = "Kategori Çarpanı Düzenle";
}

<div class="page-header">
    <div>
        <a href="/Tasinmaz/Detay/@ViewBag.TasinmazId#tab-carpanlar" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
            ← @ViewBag.TasinmazAd
        </a>
        <div class="page-title">Kategori Çarpanı Düzenle</div>
    </div>
</div>

<div style="max-width:560px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TasinmazId" />
        <input type="hidden" asp-for="OlusturmaTarihi" />

        <div class="card" style="margin-bottom:16px;">
            <div style="display:flex;flex-direction:column;gap:16px;">

                <div>
                    <label class="form-label">Kiracı Kategorisi <span style="color:var(--color-danger);">*</span></label>
                    <select asp-for="KiraciKategoriId" class="form-control" required>
                        <option value="">— Seçiniz —</option>
                        @foreach (var k in ViewBag.KiraciKategorileri as List<KiraTakip.Models.KiraciKategori>)
                        {
                            <option value="@k.Id" selected="@(k.Id == Model.KiraciKategoriId)">@k.Ad</option>
                        }
                    </select>
                    <span asp-validation-for="KiraciKategoriId" class="field-error"></span>
                </div>

                <div>
                    <label class="form-label">Çarpan (₺/m²) <span style="color:var(--color-danger);">*</span></label>
                    <input asp-for="Carpan" type="number" step="0.01" min="0.01" class="form-control" required />
                    <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Kira = Birim m² × Çarpan</div>
                    <span asp-validation-for="Carpan" class="field-error"></span>
                </div>

                <div>
                    <label class="form-label">Açıklama</label>
                    <input asp-for="Aciklama" type="text" class="form-control" />
                    <span asp-validation-for="Aciklama" class="field-error"></span>
                </div>

                <div style="display:flex;align-items:center;gap:10px;">
                    <input asp-for="Aktif" type="checkbox" style="width:16px;height:16px;accent-color:var(--color-primary);" />
                    <label asp-for="Aktif" class="form-label" style="margin:0;">Aktif</label>
                </div>
            </div>
        </div>

        <div style="display:flex;gap:10px;">
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a href="/Tasinmaz/Detay/@ViewBag.TasinmazId#tab-carpanlar" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
