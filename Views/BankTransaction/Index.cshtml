@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.BankTransactionListItemDto>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@using KiraTakip.Models.Dtos
@{
    ViewData["Title"] = "Banka Hareketleri";
    ViewData["UseCentralFeedback"] = true;
    string status = ViewBag.Status ?? "tum";
    var query = (TableQuery)ViewBag.Query;
    bool canImport = User.HasPermission(PermissionCatalog.Payment.ImportBankStatement);
    bool canMatch  = User.HasPermission(PermissionCatalog.Payment.MatchBankTransaction);
    var pagination = new PaginationModel { Page = Model.Page, Size = Model.Size, Total = Model.Total, BasePath = "/BankTransaction", Extra = query.ToQueryDict() };
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Banka Hareketleri</div>
        <div class="page-subtitle">@Model.Total kayıt</div>
    </div>
    @if (canImport)
    {
        <a href="/BankTransaction/Import" class="btn btn-primary flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            CSV İçe Aktar
        </a>
    }
</div>


<!-- Filtreler -->
<div class="flex gap-1.5 flex-wrap mb-5">
    @{
        var filters = new[] { ("tum","Tümü"), ("eslestirilmedi","Eşleştirilmedi"), ("eslesti","Eşleşti"), ("manuel","Manuel Eşleşti") };
    }
    @foreach (var (key, label) in filters)
    {
        bool isActive = status == key;
        var url = key == "tum" ? "/BankTransaction" : $"/BankTransaction?status={key}";
        <a href="@url" class="btn btn-sm @(isActive ? "btn-primary" : "btn-secondary text-slate-600 bg-white border-slate-200")">@label</a>
    }
</div>

<div class="card p-0 overflow-hidden">
    <form method="get" class="flex flex-wrap items-center gap-3 p-3 bg-slate-50/50 border-b border-slate-200" action="/BankTransaction">
        <input type="search" name="q" value="@query.Q" class="form-control w-full max-w-xs text-xs font-medium" placeholder="Ara: açıklama, karşı taraf…" />
        <div class="flex items-center gap-2">
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                { "Name", "from" }, { "Value", query.From?.ToString("yyyy-MM-dd") ?? "" },
                { "Mode", "date" }, { "Field", "from" }, { "Compact", true }, { "WrapperClass", "w-36" }
            })
            <span class="text-muted">–</span>
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                { "Name", "to" }, { "Value", query.To?.ToString("yyyy-MM-dd") ?? "" },
                { "Mode", "date" }, { "Field", "to" }, { "Compact", true }, { "WrapperClass", "w-36" }
            })
        </div>
        <div class="flex items-center gap-2">
            <input type="number" name="min" value="@query.Min" step="0.01" class="form-control w-24 text-xs font-medium" placeholder="Min ₺" />
            <input type="number" name="max" value="@query.Max" step="0.01" class="form-control w-24 text-xs font-medium" placeholder="Max ₺" />
        </div>
        @if (status != "tum") { <input type="hidden" name="status" value="@status" /> }
        <button type="submit" class="btn btn-primary btn-sm px-4">Filtrele</button>
        @if (!string.IsNullOrEmpty(query.Q) || query.From.HasValue || query.To.HasValue || query.Min.HasValue || query.Max.HasValue)
        {
            <a href="/BankTransaction@(status != "tum" ? $"?status={status}" : "")" class="btn btn-secondary btn-sm text-slate-500">Temizle</a>
        }
    </form>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-28">Tarih</th>
                    <th>Açıklama</th>
                    <th class="w-48">Karşı Taraf</th>
                    <th class="w-32 num">Tutar</th>
                    <th class="w-24 cell-center">Banka</th>
                    <th class="w-32">Durum</th>
                    @if (canMatch) { <th class="w-24"></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model.Items)
                {
                    string matchClass = transaction.MatchStatus switch {
                        BankMatchStatus.Matched        => "badge-kirali",
                        BankMatchStatus.ManuallyMatched  => "badge-kirali",
                        _                                 => "badge-bos"
                    };
                    string matchLabel = transaction.MatchStatus switch {
                        BankMatchStatus.Matched        => "Eşleşti",
                        BankMatchStatus.ManuallyMatched  => "Manuel",
                        _                                 => "Bekliyor"
                    };
                    <tr>
                        <td>@transaction.TransactionDate.ToString("dd.MM.yyyy")</td>
                        <td class="max-w-[300px] truncate" title="@transaction.Description">@transaction.Description</td>
                        <td class="text-muted truncate max-w-[150px]">@(transaction.SenderInfo ?? transaction.SenderIban ?? "—")</td>
                        <td class="num">@transaction.TransactionAmount.ToString("N2") ₺</td>
                        <td class="cell-center">@transaction.BankCode</td>
                        <td><span class="badge @matchClass">@matchLabel</span></td>
                        @if (canMatch)
                        {
                            <td class="text-right">
                                @if (transaction.MatchStatus == BankMatchStatus.Unmatched)
                                {
                                    <a href="/BankTransaction/SelectMatch/@transaction.Id.ToHashId()" class="btn btn-sm btn-primary">Eşleştir</a>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (Model.Total == 0)
                {
                    <tr><td colspan="7" class="text-center py-12 text-muted italic">Filtreye uygun hareket bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>

