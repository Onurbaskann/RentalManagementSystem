@model KiraTakip.Models.ViewModels.UnitCustomRateViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = $"{Model.UnitName} — Özel Fiyatlar";
    ViewData["UseCentralFeedback"] = true;
    var unitControllerName = nameof(KiraTakip.Controllers.UnitController)
        .Replace("Controller", string.Empty);
    var ratesActionName = nameof(KiraTakip.Controllers.UnitController.Rates);
    var saveReservationRuleActionName = nameof(KiraTakip.Controllers.UnitController.SaveReservationRule);
    var clearReservationRuleActionName = nameof(KiraTakip.Controllers.UnitController.ClearReservationRule);
    var propertyControllerName = nameof(KiraTakip.Controllers.PropertyController)
        .Replace("Controller", string.Empty);
    var propertyDetailsActionName = nameof(KiraTakip.Controllers.PropertyController.Details);
    var subtitle = Model.IsLeasable
        ? ""
        : "Bu birim için özel rezervasyon ücreti kuralı tanımlayın";
}

<div class="@(Model.IsLeasable ? "max-w-[1200px]" : "max-w-[600px]") mx-auto">
    <div class="page-header flex items-center justify-between">
        <div>
            <a asp-controller="@propertyControllerName" asp-action="@propertyDetailsActionName"
               asp-route-id="@Model.PropertyId.ToHashId()"
               class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
                ← @Model.PropertyName
            </a>
            <div class="page-title">@Model.UnitName — Özel Fiyatlar</div>
            @if (!string.IsNullOrEmpty(subtitle))
            {
                <div class="page-subtitle">@subtitle</div>
            }
        </div>
    </div>

@if (Model.IsLeasable)
{
    <!-- Senaryo A: Kiralanabilir unit — KiraciKategori × ChargeType matrisi -->
    @if (Model.ParentRate != null)
    {
        <div class="mb-2.5">
            <div class="text-xs text-muted mb-1">İşaretlenmemiş hücreler için geçerli üst tarife:</div>
            @await Html.PartialAsync("_ParentRateCard", Model.ParentRate)
        </div>
    }

    <form asp-controller="@unitControllerName" asp-action="@ratesActionName"
          asp-route-id="@Model.UnitId.ToHashId()" method="post">
        @Html.AntiForgeryToken()


        @if (Model.Rows == null || !Model.Rows.Any())
        {
            <div class="card p-6 text-center text-muted">
                Aktif kiracı kategorisi veya borç tipi bulunamadı.
            </div>
        }
        else
        {
            <div class="bg-indigo-50 border border-indigo-200 text-indigo-900 p-4 rounded-xl mb-5 flex items-start gap-3 shadow-sm">
                <svg class="text-indigo-600 mt-0.5 flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <div class="text-[13.5px] leading-relaxed">
                    <strong>Bilgi:</strong> İşaretlenen hücreler için tarife yerine bu özel fiyatlar kullanılır. İşaretlenmeyen hücrelerde ise yukarıda listelenen varsayılan üst tarifeler geçerli olmaya devam eder.
                </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 items-start mb-3.5">
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    <div class="card p-4 fiyat-kategori-blok">
                        <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-slate-100">
                            <span class="text-sm font-bold text-slate-800">@row.TenantCategoryName</span>
                            <button type="button" onclick="applyVatRateToGroup(this, 20)"
                                    class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-white border border-slate-200 rounded px-2.5 py-1 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition-all">
                                KDV %20 Yap
                            </button>
                        </div>

                        <input type="hidden" name="Rows[@i].TenantCategoryId" value="@row.TenantCategoryId" />
                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[550px]">
                                <thead>
                                    <tr>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-left border-b border-slate-100">Borç Tipi</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-center border-b border-slate-100 w-10">Aktif</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-center border-b border-slate-100 w-36">Tutar (₺)</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-left border-b border-slate-100 w-24">Yöntem</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-left border-b border-slate-100 w-28">KDV %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                     @for (int j = 0; j < row.Cells.Count; j++)
                                     {
                                         var cell = row.Cells[j];
                                         var column = Model.Columns[j];
                                         var isFirstMonth = column.ChargeTypeBehavior == ChargeTypeBehavior.FirstMonthOneTime;
                                         var isDeposit = isFirstMonth;
                                         <tr data-deposit="@(isDeposit ? "true" : "false")"
                                             x-data="{ active: @cell.IsCustomRateActive.ToString().ToLower() }"
                                             class="border-t border-slate-50">
                                             <td class="py-2.5 pr-2">
                                                 <input type="hidden" name="Rows[@i].Cells[@j].TenantCategoryId" value="@cell.TenantCategoryId" />
                                                 <input type="hidden" name="Rows[@i].Cells[@j].ChargeTypeId" value="@cell.ChargeTypeId" />
                                                 <div class="flex items-center gap-2.5">
                                                     <span :class="active ? 'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.4)]' : 'bg-slate-300'"
                                                           class="w-1.5 h-1.5 rounded-full flex-shrink-0 transition-all"></span>
                                                     <div class="overflow-hidden">
                                                         <div class="flex items-center gap-1.5 mb-1">
                                                             <span class="text-[9px] text-slate-400 font-bold uppercase tracking-tight">@column.ChargeTypeCode</span>
                                                             @if (isFirstMonth)
                                                             {
                                                                 <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-100 uppercase">İlk Ay</span>
                                                             }
                                                             else
                                                             {
                                                                 <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-100 uppercase">Aylık</span>
                                                             }
                                                         </div>
                                                         <div class="text-[13px] font-bold text-slate-700 leading-tight truncate">@column.ChargeTypeName</div>
                                                     </div>
                                                 </div>
                                             </td>
                                             <td class="text-center py-2.5">
                                                 <input type="checkbox" name="Rows[@i].Cells[@j].IsCustomRateActive" value="true"
                                                        @(cell.IsCustomRateActive ? "checked" : "")
                                                        class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                                                        x-model="active" />
                                             </td>
                                             <td class="text-center py-2.5">
                                                 <div class="flex items-stretch border border-slate-200 rounded-lg overflow-hidden bg-white w-28 mx-auto transition-all" 
                                                      :class="!active ? 'opacity-30 grayscale pointer-events-none' : 'focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100'">
                                                     <span class="px-2 bg-slate-50 text-[10px] font-bold text-slate-400 border-r border-slate-200 flex items-center">₺</span>
                                                     <input type="number" step="0.01"
                                                            class="border-none outline-none p-1.5 px-2 text-xs bg-transparent flex-1 min-w-0 text-center font-bold text-slate-700"
                                                            name="Rows[@i].Cells[@j].UnitValue"
                                                            value="@(cell.IsCustomRateActive ? cell.UnitValue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                            placeholder="@cell.DefaultUnitValue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                            :disabled="!active" />
                                                 </div>
                                             </td>
                                             <td class="py-2.5 pr-2">
                                                 @if (isDeposit)
                                                 {
                                                     <input type="hidden" name="Rows[@i].Cells[@j].CalculationMethod" value="@((int)CalculationMethod.Fixed)" />
                                                     <select class="form-control form-control-sm w-full opacity-30 cursor-not-allowed text-[11px] font-bold uppercase tracking-tighter" disabled>
                                                         <option>Sabit</option>
                                                     </select>
                                                 }
                                                 else
                                                 {
                                                     <select class="form-control form-control-sm w-full text-[11px] font-bold uppercase tracking-tighter transition-all"
                                                             name="Rows[@i].Cells[@j].CalculationMethod"
                                                             :disabled="!active" :class="!active ? 'opacity-30 grayscale pointer-events-none' : ''">
                                                         <option value="@((int)CalculationMethod.Fixed)" selected="@(cell.CalculationMethod == CalculationMethod.Fixed)">Sabit</option>
                                                         <option value="@((int)CalculationMethod.M2)" selected="@(cell.CalculationMethod == CalculationMethod.M2)">m²</option>
                                                     </select>
                                                 }
                                             </td>
                                             <td class="py-2.5">
                                                 <div class="flex items-stretch border border-slate-200 rounded-lg overflow-hidden bg-white transition-all w-24" 
                                                      :class="!active ? 'opacity-30 grayscale pointer-events-none' : 'focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100'">
                                                     <input type="number" step="0.01" min="0" max="100"
                                                            class="border-none outline-none p-1.5 px-2 text-xs bg-transparent w-full min-w-0 text-right font-bold text-slate-700"
                                                            name="Rows[@i].Cells[@j].KdvRate"
                                                            value="@(cell.IsCustomRateActive ? cell.KdvRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                            placeholder="@cell.DefaultKdvRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                            :disabled="!active" />
                                                     <span class="px-2 bg-slate-50 text-[10px] font-bold text-slate-400 border-l border-slate-200 flex items-center">%</span>
                                                 </div>
                                             </td>
                                         </tr>
                                     }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <div class="flex gap-2 mt-1">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-controller="@propertyControllerName" asp-action="@propertyDetailsActionName"
                   asp-route-id="@Model.PropertyId.ToHashId()" class="btn btn-secondary">İptal</a>
            </div>
        }
    </form>

    <script>
        function applyVatRateToGroup(button, value) {
            const group = button.closest('.fiyat-kategori-blok');
            group.querySelectorAll('tr[data-deposit="false"] input[name*="KdvRate"]').forEach(function(input) {
                input.value = value;
            });
        }
    </script>
}
else if (Model.IsReservable)
{
    <!-- Senaryo B: Reservation birimi — ReservationRateOverride formu -->
    @if (Model.ParentReservationRateOverride != null)
    {
        <div class="mb-3.5">
            <div class="text-xs text-muted mb-1">Tanımlanmamışsa geçerli olan tarife:</div>
            <partial name="_ParentReservationRateOverrideCard" model="Model.ParentReservationRateOverride" />
        </div>
    }

    @if (Model.CustomReservationRule == null)
    {
        <form asp-controller="@unitControllerName" asp-action="@saveReservationRuleActionName"
              asp-route-id="@Model.UnitId.ToHashId()" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RuleId" value="0" />
            @{
                var parentRow = Model.ParentReservationRateOverride?.Rows
                    .FirstOrDefault(row => row.UnitTypeName == Model.UnitTypeName);
                
                var defaultBillingPeriod = parentRow?.BillingPeriodMinutes ?? 60;
                var defaultFreeDuration = parentRow?.FreeDurationMinutes ?? 0;
                var defaultPeriodRate = parentRow?.PeriodRate ?? 0;
                var defaultVatRate = parentRow?.VatRate ?? 20;
            }
            <div class="card p-6">
                <div class="text-base font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
                    Özel Kural Tanımla
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Ücretsiz Süre (dk)</label>
                        @Html.TextBox(
                            "FreeDurationMinutes",
                            defaultFreeDuration,
                            new { type = "number", @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ücret Periyodu (dk)</label>
                        @Html.TextBox(
                            "BillingPeriodMinutes",
                            defaultBillingPeriod,
                            new { type = "number", @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Periyot Ücreti (₺)</label>
                        @Html.TextBox(
                            "PeriodRate",
                            defaultPeriodRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                            new { type = "number", @class = "form-control", step = "0.01" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">KDV Oranı (%)</label>
                        @Html.TextBox(
                            "KdvRate",
                            defaultVatRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                            new { type = "number", @class = "form-control", min = "0", max = "100", step = "0.01" })
                    </div>
                </div>

                <div class="form-group mt-2">
                    <label class="form-label">Açıklama</label>
                    @Html.TextBox(
                        "Description",
                        null,
                        new { @class = "form-control", placeholder = "Opsiyonel açıklama..." })
                </div>

                <input type="hidden" name="IsActive" value="true" />

                <div class="flex items-center gap-3 mt-8">
                    <button type="submit" class="btn btn-primary px-6">Kaydet</button>
                    <a asp-controller="@propertyControllerName" asp-action="@propertyDetailsActionName"
                       asp-route-id="@Model.PropertyId.ToHashId()" class="btn btn-secondary px-6">İptal</a>
                </div>
            </div>
        </form>
    }
    else
    {
        <form asp-controller="@unitControllerName" asp-action="@saveReservationRuleActionName"
              asp-route-id="@Model.UnitId.ToHashId()" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RuleId" value="@Model.CustomReservationRule.Id" />
            <div class="card p-6">
                <div class="text-base font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
                    Özel Rezervasyon Kuralı
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Ücretsiz Süre (dk)</label>
                        @Html.TextBox(
                            "FreeDurationMinutes",
                            Model.CustomReservationRule.FreeDurationMinutes,
                            new { type = "number", @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ücret Periyodu (dk)</label>
                        @Html.TextBox(
                            "BillingPeriodMinutes",
                            Model.CustomReservationRule.BillingPeriodMinutes,
                            new { type = "number", @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Periyot Ücreti (₺)</label>
                        @Html.TextBox(
                            "PeriodRate",
                            Model.CustomReservationRule.PeriodRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                            new { type = "number", @class = "form-control", step = "0.01" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">KDV Oranı (%)</label>
                        @Html.TextBox(
                            "KdvRate",
                            Model.CustomReservationRule.KdvRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                            new { type = "number", @class = "form-control", min = "0", max = "100", step = "0.01" })
                    </div>
                </div>

                <div class="form-group my-2">
                    <label class="flex items-center gap-2.5 cursor-pointer bg-slate-50 p-3 rounded-lg border border-slate-200 hover:border-indigo-300 transition-colors">
                        @Html.CheckBox(
                            "IsActive",
                            Model.CustomReservationRule.IsActive,
                            new { @class = "w-4.5 h-4.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" })
                        <span class="text-sm font-bold text-slate-700">Kural Aktif</span>
                    </label>
                </div>

                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    @Html.TextBox(
                        "Description",
                        Model.CustomReservationRule.Description,
                        new { @class = "form-control", placeholder = "Opsiyonel açıklama..." })
                </div>

                <div class="flex items-center gap-3 mt-8">
                    <button type="submit" class="btn btn-primary px-6">Kaydet</button>
                    <a asp-controller="@propertyControllerName" asp-action="@propertyDetailsActionName"
                       asp-route-id="@Model.PropertyId.ToHashId()" class="btn btn-secondary px-6">İptal</a>
                </div>
            </div>
        </form>

        <form asp-controller="@unitControllerName" asp-action="@clearReservationRuleActionName"
              asp-route-id="@Model.UnitId.ToHashId()" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="text-xs font-bold text-red-500 bg-red-50 border border-red-100 rounded-lg px-4 py-2 hover:bg-red-100 transition-all flex items-center gap-2"
                    data-confirm="Özel kural silinecek. Genel tarife devreye girecek. Onaylıyor musunuz?">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                Sıfırla (Genel Tarifeyi Kullan)
            </button>
        </form>
    }
}
else
{
    <!-- Senaryo C: Hibrit — hata kartı -->
    <div class="card border-red-100 bg-red-50/50 p-6 flex flex-col items-center text-center">
        <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="text-base font-bold text-red-800 mb-2">Birim Türü Hatalı Tanımlı</div>
        <p class="text-sm text-red-700/70 leading-relaxed max-w-sm mb-6">
            Bu birim türünde hem <b>Kiralanabilir</b> hem de <b>Rezervasyon</b> yapılabilir işaretli değil veya her ikisi de işaretli. Lütfen yöneticiye bildirin.
        </p>
        <a asp-controller="@propertyControllerName" asp-action="@propertyDetailsActionName"
           asp-route-id="@Model.PropertyId.ToHashId()" class="btn btn-secondary px-8">Geri Dön</a>
    </div>
}
</div>
