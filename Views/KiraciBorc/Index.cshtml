@model List<KiraTakip.Models.Entities.KiraTahakkuk>
@using KiraTakip.Models
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Borçlarım";
}

<div class="page-header">
    <div>
        <div class="page-title">Borçlarım</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
</div>

<div class="card p-0 overflow-hidden" x-data="clientTable({ pageSize: 25 })" x-init="init()">
    <div class="table-toolbar">
        <input type="search" class="form-control toolbar-search" placeholder="Ara…" x-model.debounce.250ms="q" />
        <span class="pagination-info ml-auto"><span x-text="total"></span> kayıt</span>
    </div>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Dönem</th>
                    <th>Birim</th>
                    <th>Vade Tarihi</th>
                    <th>Tutar</th>
                    <th>Ödenen</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody x-ref="tbody">
                @foreach (var t in Model)
                {
                    var birimAd = t.KiraSozlesmesi?.Birim?.Ad ?? "—";
                    var search = $"{birimAd} {t.DonemBaslangic:MM.yyyy}".ToLower();
                    var durumClass = t.Durum switch {
                        TahakkukDurumu.TamOdendi => "badge-kirali",
                        TahakkukDurumu.Bekleniyor => "badge-bos",
                        TahakkukDurumu.KismenOdendi => "badge-surek",
                        _ => "badge-gecmis"
                    };
                    var durumLabel = t.Durum switch {
                        TahakkukDurumu.TamOdendi => "Ödendi",
                        TahakkukDurumu.Bekleniyor => "Bekliyor",
                        TahakkukDurumu.KismenOdendi => "Kısmi",
                        TahakkukDurumu.IptalEdildi => "İptal",
                        _ => t.Durum.ToString()
                    };
                    var gecikmisMi = t.Durum == TahakkukDurumu.Bekleniyor && t.VadeTarihi < DateTime.Now;
                    <tr data-row data-search="@search">
                        <td class="text-sm">@t.DonemBaslangic.ToString("MM.yyyy") – @t.DonemBitis.ToString("MM.yyyy")</td>
                        <td class="font-semibold">@birimAd</td>
                        <td class="text-sm @(gecikmisMi ? "text-red-600 font-medium" : "")">@t.VadeTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="text-sm font-medium">@t.ToplamTutar.ToString("N2") ₺</td>
                        <td class="text-sm">@t.OdenenTutar.ToString("N2") ₺</td>
                        <td>
                            <span class="badge @durumClass">@durumLabel</span>
                            @if (gecikmisMi)
                            { <span class="badge badge-gecmis ml-1">Gecikmiş</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
