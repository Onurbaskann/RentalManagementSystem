@model KiraTakip.Models.ViewModels.RezervasyonCreateViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Rezervasyon Ekle";
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Rezervasyon Ekle</div>
        <div class="page-subtitle">Seçilen birim için tarih ve saat belirleyin</div>
    </div>
    <a href="/Rezervasyon" class="btn btn-secondary">← Geri</a>
</div>

<div class="max-w-[680px]" x-data="rezervasyonForm()">
    <form asp-action="Ekle" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="form-error bg-red-50 border border-red-200 rounded-lg p-3 mb-5"></div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5">Birim ve Kiracı</div>

            <div class="form-group mb-5">
                <label asp-for="BirimId" class="form-label">Taşınmaz Birimi <span class="text-red-500">*</span></label>
                <select asp-for="BirimId" class="form-control" x-on:change="birimSecildi($event)">
                    <option value="">— Birim seçin —</option>
                    @foreach (var b in Model.RezervasyonBirimleri)
                    {
                        <option value="@b.Id"
                            data-tasinmaz="@b.TasinmazAd"
                            data-tur="@b.BirimTuruAd">
                            @b.TasinmazAd — @b.Ad
                            @if (!string.IsNullOrEmpty(b.BirimTuruAd)) { <text>(@b.BirimTuruAd)</text> }
                        </option>
                    }
                </select>
                <span asp-validation-for="BirimId" class="form-error"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-group mb-0">
                    <label asp-for="KiraciId" class="form-label">Kiracı <span class="text-red-500">*</span></label>
                    <select asp-for="KiraciId" class="form-control" x-model="kiraciId" x-on:change="kiraciSecildi($event)">
                        <option value="">— Kiracı seçin —</option>
                        @foreach (var k in Model.Kiraciler)
                        {
                            <option value="@k.Id">@k.GosterimAdi</option>
                        }

                    </select>
                    <span asp-validation-for="KiraciId" class="form-error"></span>
                </div>

                <div class="form-group mb-0">
                    <label asp-for="KiraSozlesmesiId" class="form-label">Sözleşme <span class="text-muted font-normal">(opsiyonel)</span></label>
                    <select asp-for="KiraSozlesmesiId" class="form-control">
                        <option value="">— Sözleşme seçin —</option>
                        <template x-for="s in filtrelenmisSozlesmeler" :key="s.id">
                            <option :value="s.id" x-text="s.label"></option>
                        </template>
                    </select>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5">Tarih ve Saat</div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label asp-for="BaslangicTarihi" class="form-label">Başlangıç <span class="text-red-500">*</span></label>
                    <input asp-for="BaslangicTarihi" type="datetime-local" class="form-control"
                           value="@Model.BaslangicTarihi.ToString("yyyy-MM-ddTHH:mm")"
                           x-model="baslangic" x-on:change="hesapla()" />
                    <span asp-validation-for="BaslangicTarihi" class="form-error"></span>
                </div>
                <div class="form-group mb-0">
                    <label asp-for="BitisTarihi" class="form-label">Bitiş <span class="text-red-500">*</span></label>
                    <input asp-for="BitisTarihi" type="datetime-local" class="form-control"
                           value="@Model.BitisTarihi.ToString("yyyy-MM-ddTHH:mm")"
                           x-model="bitis" x-on:change="hesapla()" />
                    <span asp-validation-for="BitisTarihi" class="form-error"></span>
                </div>
            </div>

            <!-- Ücret Önizlemesi -->
            <template x-if="hesapSonucu">
                <div class="bg-slate-50 border border-[var(--color-border)] rounded-lg p-3.5 mt-1">
                    <div class="text-[11px] font-bold uppercase tracking-wider text-muted mb-2.5">Ücret Önizlemesi</div>
                    <div class="grid grid-cols-3 gap-3 mb-2.5">
                        <div>
                            <div class="text-[10px] text-muted">Toplam Süre</div>
                            <div class="font-semibold" x-text="hesapSonucu.toplamSureDakika + ' dk'"></div>
                        </div>
                        <div>
                            <div class="text-[10px] text-muted">Ücretsiz Süre</div>
                            <div class="font-semibold text-emerald-600" x-text="hesapSonucu.ucretsizSureDakika + ' dk'"></div>
                        </div>
                        <div>
                            <div class="text-[10px] text-muted">Ücretli Süre</div>
                            <div class="font-semibold" x-text="hesapSonucu.ucretliSureDakika + ' dk'"></div>
                        </div>
                    </div>
                    <template x-if="hesapSonucu.ucretTutar > 0">
                        <div>
                            <div class="flex justify-between text-[13px] mb-1">
                                <span class="text-muted">Ücret (<span x-text="hesapSonucu.ucretliPeriyotSayisi"></span> periyot × <span x-text="hesapSonucu.birimUcret.toLocaleString('tr-TR', {minimumFractionDigits:2})"></span> ₺)</span>
                                <span x-text="hesapSonucu.ucretTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                            <div class="flex justify-between text-[13px] mb-1.5">
                                <span class="text-muted">KDV (%<span x-text="hesapSonucu.kdvOrani"></span>)</span>
                                <span x-text="hesapSonucu.kdvTutari.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                            <div class="flex justify-between text-[15px] font-bold border-t border-[var(--color-border)] pt-2 mt-1">
                                <span>Toplam</span>
                                <span class="text-primary" x-text="hesapSonucu.toplamTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                        </div>
                    </template>
                    <template x-if="hesapSonucu.ucretTutar === 0">
                        <div class="text-sm font-semibold text-emerald-600 text-center py-1">✓ Ücretsiz kullanım — süre sınırı aşılmıyor</div>
                    </template>
                </div>
            </template>
            <template x-if="hataMessaji">
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-2.5 text-sm text-amber-800 mt-1" x-text="hataMessaji"></div>
            </template>
        </div>

        <div class="card mb-4">
            <div class="form-group mb-0">
                <label asp-for="Aciklama" class="form-label">Açıklama <span class="text-muted font-normal">(opsiyonel)</span></label>
                <textarea asp-for="Aciklama" class="form-control" rows="2" placeholder="Rezervasyon konusu, katılımcılar vb."></textarea>
            </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
            <a href="/Rezervasyon" class="btn btn-secondary px-6">İptal</a>
            <button type="submit" class="btn btn-primary px-6">Rezervasyon Oluştur</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
function rezervasyonForm() {
    return {
        birimId: @(Model.BirimId > 0 ? Model.BirimId.ToString() : "0"),
        kiraciId: @(Model.KiraciId > 0 ? Model.KiraciId.ToString() : "0"),
        baslangic: '@Model.BaslangicTarihi.ToString("yyyy-MM-ddTHH:mm")',
        bitis: '@Model.BitisTarihi.ToString("yyyy-MM-ddTHH:mm")',
        hesapSonucu: null,
        hataMessaji: null,
        sozlesmeler: [
            @foreach (var s in Model.Sozlesmeler)
            {
                <text>{ id: @s.Id, kiraciId: @s.KiraciId, label: '@s.TasinmazAd / @s.BirimAd (@s.BaslangicTarihi.ToString("dd.MM.yyyy"))' },</text>
            }
        ],
        _timer: null,

        get filtrelenmisSozlesmeler() {
            if (!this.kiraciId) return [];
            return this.sozlesmeler.filter(s => s.kiraciId == this.kiraciId);
        },

        kiraciSecildi(e) {
            this.kiraciId = e.target.value;
            // Kiracı değiştiğinde seçili sözleşmeyi sıfırla
            document.querySelector('select[name="KiraSozlesmesiId"]').value = "";
        },

        birimSecildi(e) {
            this.birimId = parseInt(e.target.value) || 0;
            this.hesapla();
        },

        hesapla() {
            clearTimeout(this._timer);
            if (!this.birimId || !this.baslangic || !this.bitis) {
                this.hesapSonucu = null;
                this.hataMessaji = null;
                return;
            }
            this._timer = setTimeout(() => this._fetchHesap(), 400);
        },

        async _fetchHesap() {
            try {
                const r = await fetch(`/Rezervasyon/Hesapla?birimId=${this.birimId}&baslangic=${encodeURIComponent(this.baslangic)}&bitis=${encodeURIComponent(this.bitis)}`);
                const d = await r.json();
                if (d.hataMessaji) {
                    this.hataMessaji = d.hataMessaji;
                    this.hesapSonucu = d.kuralBulundu ? d : null;
                } else {
                    this.hataMessaji = null;
                    this.hesapSonucu = d;
                }
            } catch {
                this.hesapSonucu = null;
            }
        },

        init() {
            this.hesapla();
        }
    };
}
</script>
}
