@model KiraTakip.Models.ViewModels.RezervasyonCreateViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Rezervasyon Ekle";
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Rezervasyon Ekle</div>
        <div class="page-subtitle">Toplantı salonu için tarih ve saat belirleyin</div>
    </div>
    <a href="/Rezervasyon" class="btn btn-secondary">← Geri</a>
</div>

<div style="max-width:680px;" x-data="rezervasyonForm()">
    <form asp-action="Ekle" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="form-error" style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;margin-bottom:20px;"></div>

        <div class="card">
            <div class="section-title" style="margin-bottom:20px;">Salon ve Kiracı</div>

            <div class="form-group">
                <label asp-for="BirimId" class="form-label">Toplantı Salonu <span style="color:#dc2626;">*</span></label>
                <select asp-for="BirimId" class="form-control" x-on:change="birimSecildi($event)">
                    <option value="">— Salon seçin —</option>
                    @foreach (var b in Model.RezervasyonBirimleri)
                    {
                        <option value="@b.Id"
                            data-tasinmaz="@b.Tasinmaz.Ad"
                            data-tur="@(b.BirimTuru?.Ad ?? "")">
                            @b.Tasinmaz.Ad — @b.Ad
                            @if (b.BirimTuru != null) { <text>(@b.BirimTuru.Ad)</text> }
                        </option>
                    }
                </select>
                <span asp-validation-for="BirimId" class="form-error"></span>
            </div>

            <div class="two-col">
                <div class="form-group">
                    <label asp-for="KiraciId" class="form-label">Kiracı <span style="color:#dc2626;">*</span></label>
                    <select asp-for="KiraciId" class="form-control">
                        <option value="">— Kiracı seçin —</option>
                        @foreach (var k in Model.Kiraciler)
                        {
                            <option value="@k.Id">@k.GosterimAdi</option>
                        }
                    </select>
                    <span asp-validation-for="KiraciId" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="KiraSozlesmesiId" class="form-label">Sözleşme <span style="color:var(--color-muted);font-weight:400;">(opsiyonel)</span></label>
                    <select asp-for="KiraSozlesmesiId" class="form-control">
                        <option value="">— Sözleşme seçin —</option>
                        @foreach (var s in Model.Sozlesmeler)
                        {
                            <option value="@s.Id">@s.Kiraci.GosterimAdi — @s.Birim.Tasinmaz.Ad / @s.Birim.Ad</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card" style="margin-top:16px;">
            <div class="section-title" style="margin-bottom:20px;">Tarih ve Saat</div>

            <div class="two-col">
                <div class="form-group">
                    <label asp-for="BaslangicTarihi" class="form-label">Başlangıç <span style="color:#dc2626;">*</span></label>
                    <input asp-for="BaslangicTarihi" type="datetime-local" class="form-control"
                           value="@Model.BaslangicTarihi.ToString("yyyy-MM-ddTHH:mm")"
                           x-model="baslangic" x-on:change="hesapla()" />
                    <span asp-validation-for="BaslangicTarihi" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="BitisTarihi" class="form-label">Bitiş <span style="color:#dc2626;">*</span></label>
                    <input asp-for="BitisTarihi" type="datetime-local" class="form-control"
                           value="@Model.BitisTarihi.ToString("yyyy-MM-ddTHH:mm")"
                           x-model="bitis" x-on:change="hesapla()" />
                    <span asp-validation-for="BitisTarihi" class="form-error"></span>
                </div>
            </div>

            <!-- Ücret Önizlemesi -->
            <template x-if="hesapSonucu">
                <div style="background:#f7f8fa;border:1px solid var(--color-border);border-radius:8px;padding:14px 16px;margin-top:4px;">
                    <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-muted);margin-bottom:10px;">Ücret Önizlemesi</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:10px;">
                        <div>
                            <div style="font-size:11px;color:var(--color-muted);">Toplam Süre</div>
                            <div style="font-weight:600;" x-text="hesapSonucu.toplamSureDakika + ' dk'"></div>
                        </div>
                        <div>
                            <div style="font-size:11px;color:var(--color-muted);">Ücretsiz Süre</div>
                            <div style="font-weight:600;color:#059669;" x-text="hesapSonucu.ucretsizSureDakika + ' dk'"></div>
                        </div>
                        <div>
                            <div style="font-size:11px;color:var(--color-muted);">Ücretli Süre</div>
                            <div style="font-weight:600;" x-text="hesapSonucu.ucretliSureDakika + ' dk'"></div>
                        </div>
                    </div>
                    <template x-if="hesapSonucu.ucretTutar > 0">
                        <div>
                            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;">
                                <span style="color:var(--color-muted);">Ücret (<span x-text="hesapSonucu.ucretliPeriyotSayisi"></span> periyot × <span x-text="hesapSonucu.birimUcret.toLocaleString('tr-TR', {minimumFractionDigits:2})"></span> ₺)</span>
                                <span x-text="hesapSonucu.ucretTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px;">
                                <span style="color:var(--color-muted);">KDV (%<span x-text="hesapSonucu.kdvOrani"></span>)</span>
                                <span x-text="hesapSonucu.kdvTutari.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:15px;font-weight:700;border-top:1px solid var(--color-border);padding-top:8px;">
                                <span>Toplam</span>
                                <span style="color:var(--color-primary);" x-text="hesapSonucu.toplamTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                            </div>
                        </div>
                    </template>
                    <template x-if="hesapSonucu.ucretTutar === 0">
                        <div style="font-size:14px;font-weight:600;color:#059669;text-align:center;padding:4px 0;">✓ Ücretsiz kullanım — süre sınırı aşılmıyor</div>
                    </template>
                </div>
            </template>
            <template x-if="hataMessaji">
                <div style="background:#fef3c7;border:1px solid #fde68a;border-radius:8px;padding:10px 14px;font-size:13px;color:#92400e;margin-top:4px;" x-text="hataMessaji"></div>
            </template>
        </div>

        <div class="card" style="margin-top:16px;">
            <div class="form-group" style="margin-bottom:0;">
                <label asp-for="Aciklama" class="form-label">Açıklama <span style="color:var(--color-muted);font-weight:400;">(opsiyonel)</span></label>
                <textarea asp-for="Aciklama" class="form-control" rows="2" placeholder="Toplantı konusu, katılımcılar vb."></textarea>
            </div>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;">
            <a href="/Rezervasyon" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary">Rezervasyon Oluştur</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
function rezervasyonForm() {
    return {
        birimId: @(Model.BirimId > 0 ? Model.BirimId.ToString() : "0"),
        baslangic: '@Model.BaslangicTarihi.ToString("yyyy-MM-ddTHH:mm")',
        bitis: '@Model.BitisTarihi.ToString("yyyy-MM-ddTHH:mm")',
        hesapSonucu: null,
        hataMessaji: null,
        _timer: null,

        birimSecildi(e) {
            this.birimId = parseInt(e.target.value) || 0;
            this.hesapla();
        },

        hesapla() {
            clearTimeout(this._timer);
            if (!this.birimId || !this.baslangic || !this.bitis) {
                this.hesapSonucu = null;
                this.hataMessaji = null;
                return;
            }
            this._timer = setTimeout(() => this._fetchHesap(), 400);
        },

        async _fetchHesap() {
            try {
                const r = await fetch(`/Rezervasyon/Hesapla?birimId=${this.birimId}&baslangic=${encodeURIComponent(this.baslangic)}&bitis=${encodeURIComponent(this.bitis)}`);
                const d = await r.json();
                if (d.hataMessaji) {
                    this.hataMessaji = d.hataMessaji;
                    this.hesapSonucu = d.kuralBulundu ? d : null;
                } else {
                    this.hataMessaji = null;
                    this.hesapSonucu = d;
                }
            } catch {
                this.hesapSonucu = null;
            }
        },

        init() {
            this.hesapla();
        }
    };
}
</script>
}
