@model KiraTakip.Models.ViewModels.TenantPaymentPortalViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Teşekkürler";
}

<div class="bg-white rounded-2xl shadow-xl border border-slate-200/60 overflow-hidden">
    <div class="px-8 py-10 text-center">
        <div class="mx-auto w-16 h-16 rounded-full bg-emerald-50 flex items-center justify-center mb-5">
            <svg class="text-emerald-500" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
        </div>
        <h1 class="text-xl font-bold text-slate-800 mb-2">Sayın @Model.TenantName</h1>
        <p class="text-sm text-slate-600 leading-relaxed mb-1">
            Şu an için vadesi yaklaşan, gelmiş veya geçmiş bir borcunuz bulunmamaktadır.
        </p>
        <p class="text-sm text-slate-500 leading-relaxed mb-5">
            Hassasiyetiniz için teşekkür ederiz.
        </p>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Tüm ödemeleriniz günceldir
        </div>
    </div>
    <div class="px-8 py-4 bg-slate-50 border-t border-slate-100 text-center">
        <span class="text-xs text-slate-500">Bu sayfayı güvenle kapatabilirsiniz.</span>
    </div>
</div>

