@model List<KiraTakip.Models.BankaHareketi>
@using KiraTakip.Models
@{
    ViewData["Title"] = "Banka Hareketleri";
    string durum = ViewBag.Durum ?? "tum";
    bool canImport = User.HasClaim("permission", "Odeme.ImportBankStatement");
    bool canMatch  = User.HasClaim("permission", "Odeme.MatchBankTransaction");
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Banka Hareketleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    @if (canImport)
    {
        <a href="/BankaHareketi/Import" class="btn btn-primary">CSV İçe Aktar</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✓ @TempData["Success"]</div>
}

<!-- Filtreler -->
<div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;">
    @{
        var filters = new[] { ("tum","Tümü"), ("eslestirilmedi","Eşleştirilmedi"), ("eslesti","Eşleşti"), ("manuel","Manuel Eşleşti") };
    }
    @foreach (var (key, label) in filters)
    {
        string cls = durum == key ? "btn btn-primary btn-sm" : "btn btn-secondary btn-sm";
        <a href="/BankaHareketi?durum=@key" class="@cls">@label</a>
    }
</div>

<div class="card" style="padding:0;overflow:hidden;">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Açıklama</th>
                    <th>Karşı Taraf</th>
                    <th>Tutar</th>
                    <th>Banka</th>
                    <th>Durum</th>
                    @if (canMatch) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    string eslesmeCls = b.EslesmeDurumu switch {
                        BankaEslesmeDurumu.Eslesti        => "badge-kirali",
                        BankaEslesmeDurumu.ManuelEslesti  => "badge-kirali",
                        _                                 => "badge-bos"
                    };
                    string eslesmeLabel = b.EslesmeDurumu switch {
                        BankaEslesmeDurumu.Eslesti        => "Eşleşti",
                        BankaEslesmeDurumu.ManuelEslesti  => "Manuel",
                        _                                 => "Eşleştirilmedi"
                    };
                    <tr>
                        <td style="font-size:13px;">@b.HareketTarihi.ToString("dd.MM.yyyy")</td>
                        <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;">@b.Aciklama</td>
                        <td style="font-size:12.5px;color:var(--color-muted);">@(b.KarsiUnvan ?? b.KarsiHesap ?? "—")</td>
                        <td style="font-weight:700;">@b.Tutar.ToString("N0") ₺</td>
                        <td style="font-size:12.5px;">@b.BankaKodu</td>
                        <td><span class="badge @eslesmeCls">@eslesmeLabel</span></td>
                        @if (canMatch)
                        {
                            <td>
                                @if (b.EslesmeDurumu == BankaEslesmeDurumu.Eslestirilmedi)
                                {
                                    <a href="/BankaHareketi/EslestirSec/@b.Id" class="btn btn-primary btn-sm">Eşleştir</a>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" style="text-align:center;color:var(--color-muted);padding:32px;">Hareket bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
