@model KiraTakip.Models.Common.PagedResult<BankaHareketi>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Banka Hareketleri";
    string durum = ViewBag.Durum ?? "tum";
    var q = (TableQuery)ViewBag.Query;
    bool canImport = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Odeme.ImportBankStatement);
    bool canMatch  = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Odeme.MatchBankTransaction);
    var pagination = new PaginationModel { Page = Model.Page, Size = Model.Size, Total = Model.Total, BasePath = "/BankaHareketi", Extra = q.ToQueryDict() };
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Banka Hareketleri</div>
        <div class="page-subtitle">@Model.Total kayıt</div>
    </div>
    @if (canImport)
    {
        <a href="/BankaHareketi/Import" class="btn btn-primary flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            CSV İçe Aktar
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}

<!-- Filtreler -->
<div class="flex gap-1.5 flex-wrap mb-5">
    @{
        var filters = new[] { ("tum","Tümü"), ("eslestirilmedi","Eşleştirilmedi"), ("eslesti","Eşleşti"), ("manuel","Manuel Eşleşti") };
    }
    @foreach (var (key, label) in filters)
    {
        bool isActive = durum == key;
        var url = key == "tum" ? "/BankaHareketi" : $"/BankaHareketi?durum={key}";
        <a href="@url" class="btn btn-sm @(isActive ? "btn-primary" : "btn-secondary text-slate-600 bg-white border-slate-200")">@label</a>
    }
</div>

<div class="card p-0 overflow-hidden">
    <form method="get" class="flex flex-wrap items-center gap-3 p-3 bg-slate-50/50 border-b border-slate-200" action="/BankaHareketi">
        <input type="search" name="q" value="@q.Q" class="form-control w-full max-w-xs" placeholder="Ara: açıklama, karşı taraf…" />
        <div class="flex items-center gap-2">
            <input type="date" name="from" value="@(q.From?.ToString("yyyy-MM-dd"))" class="form-control w-36 text-xs" title="Başlangıç" />
            <span class="text-muted">–</span>
            <input type="date" name="to" value="@(q.To?.ToString("yyyy-MM-dd"))" class="form-control w-36 text-xs" title="Bitiş" />
        </div>
        <div class="flex items-center gap-2">
            <input type="number" name="min" value="@q.Min" step="0.01" class="form-control w-24 text-xs" placeholder="Min ₺" />
            <input type="number" name="max" value="@q.Max" step="0.01" class="form-control w-24 text-xs" placeholder="Max ₺" />
        </div>
        @if (durum != "tum") { <input type="hidden" name="durum" value="@durum" /> }
        <button type="submit" class="btn btn-primary btn-sm px-4">Filtrele</button>
        @if (!string.IsNullOrEmpty(q.Q) || q.From.HasValue || q.To.HasValue || q.Min.HasValue || q.Max.HasValue)
        {
            <a href="/BankaHareketi@(durum != "tum" ? $"?durum={durum}" : "")" class="btn btn-secondary btn-sm text-slate-500">Temizle</a>
        }
    </form>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-28">Tarih</th>
                    <th>Açıklama</th>
                    <th class="w-48">Karşı Taraf</th>
                    <th class="w-32 text-right">Tutar</th>
                    <th class="w-24 text-center">Banka</th>
                    <th class="w-32">Durum</th>
                    @if (canMatch) { <th class="w-24"></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Items)
                {
                    string eslesmeCls = b.EslesmeDurumu switch {
                        BankaEslesmeDurumu.Eslesti        => "badge-kirali",
                        BankaEslesmeDurumu.ManuelEslesti  => "badge-kirali",
                        _                                 => "badge-bos"
                    };
                    string eslesmeLabel = b.EslesmeDurumu switch {
                        BankaEslesmeDurumu.Eslesti        => "Eşleşti",
                        BankaEslesmeDurumu.ManuelEslesti  => "Manuel",
                        _                                 => "Bekliyor"
                    };
                    <tr>
                        <td class="text-xs text-slate-600">@b.HareketTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="text-xs text-slate-700 max-w-[300px] truncate" title="@b.Aciklama">@b.Aciklama</td>
                        <td class="text-[11px] text-muted truncate max-w-[150px]">@(b.KarsiUnvan ?? b.KarsiHesap ?? "—")</td>
                        <td class="text-right font-bold text-slate-700">@b.Tutar.ToString("N2") ₺</td>
                        <td class="text-center text-[11px] font-bold text-slate-500">@b.BankaKodu</td>
                        <td><span class="badge @eslesmeCls text-[10px] font-bold">@eslesmeLabel.ToUpper()</span></td>
                        @if (canMatch)
                        {
                            <td class="text-right">
                                @if (b.EslesmeDurumu == BankaEslesmeDurumu.Eslestirilmedi)
                                {
                                    <a href="/BankaHareketi/EslestirSec/@b.Id" class="btn btn-sm btn-primary py-1 px-2.5 text-[11px]">Eşleştir</a>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (Model.Total == 0)
                {
                    <tr><td colspan="7" class="text-center py-12 text-muted italic">Filtreye uygun hareket bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
