@model KiraTakip.Models.ViewModels.BankaImportViewModel
@{
    ViewData["Title"] = "Banka Hareketi İçe Aktar";
}

<div class="max-w-[600px] mx-auto">
    <div class="page-header">
        <div>
            <a href="/BankaHareketi" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">← Banka Hareketleri</a>
            <div class="page-title">CSV İçe Aktar</div>
            <div class="page-subtitle">Bankanızdan indirdiğiniz CSV dosyasını yükleyin.</div>
        </div>
    </div>

    <div>
    <div class="card">
        <form method="post" action="/BankaHareketi/Import" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 14px;border-radius:8px;margin-bottom:18px;font-size:13px;"></div>
            }

            <div class="form-group">
                <label class="form-label">Banka</label>
                <select asp-for="BankaKodu" class="form-control">
                    <option value="AKBANK">Akbank</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">CSV Dosyası</label>
                <input type="file" asp-for="Dosya" class="form-control" accept=".csv,.txt" />
                <div class="form-hint">Noktalı virgülle (;) ayrılmış CSV formatı. Başlık satırı içermeli.</div>
            </div>

            <div style="background:var(--color-bg);border-radius:8px;padding:12px 14px;margin-bottom:18px;font-size:13px;color:var(--color-muted);">
                <strong style="color:var(--color-text);display:block;margin-bottom:6px;">Beklenen kolon sırası (Akbank):</strong>
                Tarih · Açıklama · Borç · Alacak · Bakiye · Karşı Hesap · Karşı Unvan
            </div>

            <div style="display:flex;gap:10px;">
                <button type="submit" class="btn btn-primary">İçe Aktar</button>
                <a href="/BankaHareketi" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
    </div>
</div>

