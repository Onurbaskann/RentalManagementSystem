@model List<KiraTakip.Models.Tarife>
@{
    ViewData["Title"] = "Tarifeler";
}

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">
        ✓ @TempData["Success"]
    </div>
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Tarifeler</div>
        <div class="page-subtitle">Yıllık borç tipi tarifeleri</div>
    </div>
    <a href="/Admin/Tarife/YilEkle" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yıl Ekle
    </a>
</div>

<div class="card" style="padding:0;overflow:hidden;">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th style="width:80px;">Yıl</th>
                    <th>Açıklama</th>
                    <th style="width:100px;">Kalem Sayısı</th>
                    <th style="width:100px;">Durum</th>
                    <th style="width:180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td style="font-weight:700;font-size:15px;">@t.Yil</td>
                        <td style="color:var(--color-muted);font-size:13px;">@(t.Aciklama ?? "—")</td>
                        <td style="text-align:center;">@t.Kalemler.Count</td>
                        <td>
                            @if (t.Aktif)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td style="display:flex;gap:6px;justify-content:flex-end;">
                            <a href="/Admin/Tarife/Yil/@t.Yil" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/Tarife/DurumDegistir/@t.Id"
                                  data-confirm="@(t.Aktif ? $"{t.Yil} yılı pasif yapılsın mı?" : $"{t.Yil} yılı aktif yapılsın mı?")"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(t.Aktif ? "btn-danger" : "btn-amber")">
                                    @(t.Aktif ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--color-muted);">Henüz tarife tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
