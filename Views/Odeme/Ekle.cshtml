@model KiraTakip.Models.ViewModels.OdemeEkleViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Ödeme Ekle";
    var t = Model.Tahakkuk;
    var kalan = t != null ? t.ToplamTutar - t.OdenenTutar : 0;
}

<div class="max-w-[600px] mx-auto">
    <div class="page-header">
        <div>
            <a href="/Tahakkuk" class="text-xs text-muted no-underline inline-flex items-center gap-1 mb-2">← Tahakkuklar</a>
            <div class="page-title">Ödeme Ekle</div>
            @if (t != null)
            {
                <div class="page-subtitle">@t.KiraciGosterimAdi — @t.DonemBaslangic.ToString("MMMM yyyy")</div>
            }
        </div>
    </div>

    @if (t != null)
    {
        <div class="flex gap-3 mb-5 flex-wrap">
            <div class="card card-sm flex-1 min-w-[9.375rem]">
                <div class="card-title">Toplam Tahakkuk</div>
                <div class="card-value" style="font-size: 1.375rem;">@t.ToplamTutar.ToString("N0") ₺</div>
            </div>
            <div class="card card-sm flex-1 min-w-[9.375rem]">
                <div class="card-title">Ödenen</div>
                <div class="card-value" style="font-size: 1.375rem; color: #065f46;">@t.OdenenTutar.ToString("N0") ₺</div>
            </div>
            <div class="card card-sm flex-1 min-w-[9.375rem]">
                <div class="card-title">Kalan</div>
                <div class="card-value" style="font-size: 1.375rem; @(kalan > 0 ? "color: #991b1b;" : "color: #065f46;")">@kalan.ToString("N0") ₺</div>
            </div>
        </div>
    }

    <div>
    <div class="card">
        <form method="post" action="/Odeme/Ekle">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="KiraTahakkukId" />
            <input type="hidden" asp-for="KiraSozlesmesiId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert-danger mb-4"></div>
            }

            <div class="form-group">
                <label class="form-label">Ödeme Tarihi</label>
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                    { "Name",  "OdemeTarihi" },
                    { "Value", Model.OdemeTarihi.ToString("yyyy-MM-dd") },
                    { "Mode",  "date" },
                    { "Field", "odemeTarihi" }
                })
                <span asp-validation-for="OdemeTarihi" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Tutar (₺)</label>
                <input asp-for="Tutar" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Tutar" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Ödeme Kanalı</label>
                <select asp-for="OdemeKanali" class="form-control">
                    <option value="2">EFT</option>
                    <option value="1">Havale</option>
                    <option value="3">Nakit</option>
                    <option value="4">Diğer</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama <span class="text-muted font-normal">(opsiyonel)</span></label>
                <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
            </div>

            <div style="background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 0.625rem 0.875rem; border-radius: 0.5rem; margin-bottom: 1.125rem; font-size: 0.8125rem;">
                Ödeme kaydedildikten sonra yetkilinin onayı beklenecektir.
            </div>

            <div class="flex gap-2.5">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a href="/Tahakkuk" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
</div>
