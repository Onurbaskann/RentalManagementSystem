@model KiraTakip.Models.ViewModels.OdemeEkleViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Ödeme Ekle";
    var t = Model.Tahakkuk;
    var kalan = t != null ? t.ToplamTutar - t.OdenenTutar : 0;
}

<div class="page-header">
    <div>
        <a href="/Tahakkuk" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">← Tahakkuklar</a>
        <div class="page-title">Ödeme Ekle</div>
        @if (t != null)
        {
            <div class="page-subtitle">@t.KiraciGosterimAdi — @t.DonemBaslangic.ToString("MMMM yyyy")</div>
        }
    </div>
</div>

@if (t != null)
{
    <div style="display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap;">
        <div class="card card-sm" style="flex:1;min-width:150px;">
            <div class="card-title">Toplam Tahakkuk</div>
            <div class="card-value" style="font-size:22px;">@t.ToplamTutar.ToString("N0") ₺</div>
        </div>
        <div class="card card-sm" style="flex:1;min-width:150px;">
            <div class="card-title">Ödenen</div>
            <div class="card-value" style="font-size:22px;color:#065f46;">@t.OdenenTutar.ToString("N0") ₺</div>
        </div>
        <div class="card card-sm" style="flex:1;min-width:150px;">
            <div class="card-title">Kalan</div>
            <div class="card-value" style="font-size:22px;@(kalan > 0 ? "color:#991b1b;" : "color:#065f46;")">@kalan.ToString("N0") ₺</div>
        </div>
    </div>
}

<div style="max-width:480px;">
    <div class="card">
        <form method="post" action="/Odeme/Ekle">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="KiraTahakkukId" />
            <input type="hidden" asp-for="KiraSozlesmesiId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 14px;border-radius:8px;margin-bottom:18px;font-size:13px;"></div>
            }

            <div class="form-group">
                <label class="form-label">Ödeme Tarihi</label>
                <input asp-for="OdemeTarihi" type="date" class="form-control" />
                <span asp-validation-for="OdemeTarihi" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Tutar (₺)</label>
                <input asp-for="Tutar" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Tutar" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Ödeme Kanalı</label>
                <select asp-for="OdemeKanali" class="form-control">
                    <option value="2">EFT</option>
                    <option value="1">Havale</option>
                    <option value="3">Nakit</option>
                    <option value="4">Diğer</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama <span style="color:var(--color-muted);font-weight:400;">(opsiyonel)</span></label>
                <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
            </div>

            <div style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;padding:10px 14px;border-radius:8px;margin-bottom:18px;font-size:13px;">
                Ödeme kaydedildikten sonra yetkilinin onayı beklenecektir.
            </div>

            <div style="display:flex;gap:10px;">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a href="/Tahakkuk" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
