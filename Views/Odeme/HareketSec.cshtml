@model KiraTakip.Models.ViewModels.OdemeHareketSecViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Banka Hareketi Eşleştir";
    var o = Model.Odeme;
}

<div class="page-header flex items-center justify-between">
    <div>
        <a href="/Odeme/Detay/@o.Id.ToHashId()" class="text-xs text-muted no-underline inline-flex items-center gap-1 mb-2">← Ödeme #@o.Id</a>
        <div class="page-title">Banka Hareketi Eşleştir</div>
        <div class="page-subtitle">Bu ödemeye karşılık gelen banka hareketini seçin</div>
    </div>
</div>

<!-- Ödeme bilgileri -->
<div class="card mb-5">
    <div class="section-title mb-3">Ödeme</div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 0.875rem;">
        <div>
            <div class="detail-label">Kiracı</div>
            <div class="font-semibold">@o.KiraciGosterimAdi</div>
        </div>
        <div>
            <div class="detail-label">Dönem</div>
            <div>@o.TahakkukDonemBaslangic.ToString("MMMM yyyy")</div>
        </div>
        <div>
            <div class="detail-label">Ödeme Tarihi</div>
            <div class="font-semibold">@o.OdemeTarihi.ToString("dd.MM.yyyy")</div>
        </div>
        <div>
            <div class="detail-label">Tutar</div>
            <div style="font-size: 1.125rem; font-family: 'Fraunces', Georgia, serif;" class="font-bold">@o.Tutar.ToString("N0") ₺</div>
        </div>
    </div>
</div>

<!-- Aday hareketler -->
<div class="card p-0 overflow-hidden">
    <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-border);">
        <div class="section-title m-0">Eşleşmemiş Banka Hareketleri (@Model.HareketAdaylari.Count)</div>
    </div>
    @if (Model.HareketAdaylari.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Açıklama</th>
                        <th>Karşı Taraf</th>
                        <th>Tutar</th>
                        <th>Uyum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sira = 0;
                        foreach (var b in Model.HareketAdaylari)
                        {
                            bool tutarExact = b.IslemTutari == o.Tutar;
                            bool tutarClose = Math.Abs(b.IslemTutari - o.Tutar) <= o.Tutar * 0.02m;
                            int gunFark = Math.Abs((b.IslemTarihi - o.OdemeTarihi).Days);

                            string uyumLabel, uyumCls, uyumTip;
                            if (tutarExact && gunFark <= 15)      { uyumLabel = "Yüksek"; uyumCls = "badge-kirali"; uyumTip = $"Tutar birebir eşleşiyor • Tarih farkı {gunFark} gün (≤15)"; }
                            else if (tutarExact)                   { uyumLabel = "Orta";   uyumCls = "badge-surek";  uyumTip = $"Tutar birebir eşleşiyor • Tarih farkı {gunFark} gün (>15)"; }
                            else if (tutarClose && gunFark <= 15)  { uyumLabel = "Zayıf";  uyumCls = "badge-bos";    uyumTip = $"Tutar %2 toleransta • Tarih farkı {gunFark} gün"; }
                            else                                   { uyumLabel = "Düşük";  uyumCls = "badge-gecmis"; uyumTip = $"Tutar farkı %2'den fazla veya tarih uzak ({gunFark} gün)"; }
                            sira++;
                        <tr class="@(sira == 1 ? "bg-green-50" : "")">
                            <td class="font-semibold">@b.IslemTarihi.ToString("dd.MM.yyyy")</td>
                            <td style="max-width: 13.75rem; font-size: 0.8125rem;" class="truncate">@b.Aciklama</td>
                            <td class="text-xs text-muted">@(b.GonderenBilgisi ?? b.GonderenIban ?? "—")</td>
                            <td class="@(tutarExact ? "font-bold" : "font-normal")">
                                @b.IslemTutari.ToString("N0") ₺
                                @if (!tutarExact)
                                {
                                    <span class="text-muted-sm"> (fark: @Math.Abs(b.IslemTutari - o.Tutar).ToString("N0") ₺)</span>
                                }
                            </td>
                            <td><span class="badge @uyumCls" data-tip="@uyumTip">@uyumLabel</span></td>
                            <td>
                                <form method="post" action="/BankaHareketi/Eslestir">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="OdemeId" value="@o.Id" />
                                    <input type="hidden" name="BankaHareketiId" value="@b.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">Eşleştir</button>
                                </form>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-8 text-center text-muted text-sm">
            Eşleştirilmemiş banka hareketi bulunamadı. CSV içe aktarın ve tekrar deneyin.
        </div>
    }
</div>

