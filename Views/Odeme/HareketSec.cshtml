@model KiraTakip.Models.ViewModels.OdemeHareketSecViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Banka Hareketi Eşleştir";
    var o = Model.Odeme;
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <a href="/Odeme/Detay/@o.Id" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">← Ödeme #@o.Id</a>
        <div class="page-title">Banka Hareketi Eşleştir</div>
        <div class="page-subtitle">Bu ödemeye karşılık gelen banka hareketini seçin</div>
    </div>
</div>

<!-- Ödeme bilgileri -->
<div class="card" style="margin-bottom:20px;">
    <div class="section-title" style="margin-bottom:12px;">Ödeme</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;">
        <div>
            <div style="font-size:11.5px;color:var(--color-muted);font-weight:600;text-transform:uppercase;margin-bottom:3px;">Kiracı</div>
            <div style="font-weight:600;">@(o.KiraTahakkuk.KiraSozlesmesi?.Kiraci.GosterimAdi ?? "Rezervasyon Ödemesi")</div>
        </div>
        <div>
            <div style="font-size:11.5px;color:var(--color-muted);font-weight:600;text-transform:uppercase;margin-bottom:3px;">Dönem</div>
            <div>@o.KiraTahakkuk.DonemBaslangic.ToString("MMMM yyyy")</div>
        </div>
        <div>
            <div style="font-size:11.5px;color:var(--color-muted);font-weight:600;text-transform:uppercase;margin-bottom:3px;">Ödeme Tarihi</div>
            <div style="font-weight:600;">@o.OdemeTarihi.ToString("dd.MM.yyyy")</div>
        </div>
        <div>
            <div style="font-size:11.5px;color:var(--color-muted);font-weight:600;text-transform:uppercase;margin-bottom:3px;">Tutar</div>
            <div style="font-size:18px;font-weight:700;font-family:'Fraunces',serif;">@o.Tutar.ToString("N0") ₺</div>
        </div>
    </div>
</div>

<!-- Aday hareketler -->
<div class="card" style="padding:0;overflow:hidden;">
    <div style="padding:16px 20px;border-bottom:1px solid var(--color-border);">
        <div class="section-title" style="margin:0;">Eşleşmemiş Banka Hareketleri (@Model.HareketAdaylari.Count)</div>
    </div>
    @if (Model.HareketAdaylari.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Açıklama</th>
                        <th>Karşı Taraf</th>
                        <th>Tutar</th>
                        <th>Uyum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sira = 0;
                        foreach (var b in Model.HareketAdaylari)
                        {
                            bool tutarExact = b.Tutar == o.Tutar;
                            bool tutarClose = Math.Abs(b.Tutar - o.Tutar) <= o.Tutar * 0.02m;
                            int gunFark = Math.Abs((b.HareketTarihi - o.OdemeTarihi).Days);

                            string uyumLabel, uyumCls, uyumTip;
                            if (tutarExact && gunFark <= 15)      { uyumLabel = "Yüksek"; uyumCls = "badge-kirali"; uyumTip = $"Tutar birebir eşleşiyor • Tarih farkı {gunFark} gün (≤15)"; }
                            else if (tutarExact)                   { uyumLabel = "Orta";   uyumCls = "badge-surek";  uyumTip = $"Tutar birebir eşleşiyor • Tarih farkı {gunFark} gün (>15)"; }
                            else if (tutarClose && gunFark <= 15)  { uyumLabel = "Zayıf";  uyumCls = "badge-bos";    uyumTip = $"Tutar %2 toleransta • Tarih farkı {gunFark} gün"; }
                            else                                   { uyumLabel = "Düşük";  uyumCls = "badge-gecmis"; uyumTip = $"Tutar farkı %2'den fazla veya tarih uzak ({gunFark} gün)"; }
                            sira++;
                        <tr style="@(sira == 1 ? "background:#f0fdf4;" : "")">
                            <td style="font-weight:600;">@b.HareketTarihi.ToString("dd.MM.yyyy")</td>
                            <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;">@b.Aciklama</td>
                            <td style="font-size:12.5px;color:var(--color-muted);">@(b.KarsiUnvan ?? b.KarsiHesap ?? "—")</td>
                            <td style="font-weight:@(tutarExact ? "700" : "400");">
                                @b.Tutar.ToString("N0") ₺
                                @if (!tutarExact)
                                {
                                    <span style="font-size:11px;color:var(--color-muted);"> (fark: @Math.Abs(b.Tutar - o.Tutar).ToString("N0") ₺)</span>
                                }
                            </td>
                            <td><span class="badge @uyumCls" data-tip="@uyumTip">@uyumLabel</span></td>
                            <td>
                                <form method="post" action="/BankaHareketi/Eslestir">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="OdemeId" value="@o.Id" />
                                    <input type="hidden" name="BankaHareketiId" value="@b.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">Eşleştir</button>
                                </form>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding:32px;text-align:center;color:var(--color-muted);font-size:13.5px;">
            Eşleştirilmemiş banka hareketi bulunamadı. CSV içe aktarın ve tekrar deneyin.
        </div>
    }
</div>
