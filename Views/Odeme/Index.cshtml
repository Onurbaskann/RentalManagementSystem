@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.OdemeListItemDto>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Ödemeler";
    int? tahakkukId = ViewBag.TahakkukId;
    string durum = ViewBag.Durum ?? "tum";
    var q = (TableQuery)ViewBag.Query;
    bool canApprove = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Odeme.Approve);

    var extra = q.ToQueryDict();
    if (tahakkukId.HasValue) extra["tahakkukId"] = tahakkukId.Value.ToString();
    var pagination = new PaginationModel { Page = Model.Page, Size = Model.Size, Total = Model.Total, BasePath = "/Odeme", Extra = extra };
}

<div class="page-header flex items-center justify-between">
    <div>
        @if (tahakkukId.HasValue)
        {
            <a href="/Tahakkuk" class="text-[12.5px] text-muted hover:text-primary transition-colors inline-flex items-center gap-1 mb-2 no-underline">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Tahakkuklar
            </a>
        }
        <div class="page-title">Ödemeler</div>
        <div class="page-subtitle">@Model.Total kayıt</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}

@if (!tahakkukId.HasValue)
{
    <div class="flex gap-1.5 flex-wrap mb-5">
        @{
            var oFilters = new[] { ("tum","Tümü"), ("onaybekliyor","Onay Bekliyor"), ("onaylandi","Onaylandı"), ("reddedildi","Reddedildi") };
        }
        @foreach (var (key, label) in oFilters)
        {
            bool isActive = durum == key;
            var url = key == "tum" ? "/Odeme" : $"/Odeme?durum={key}";
            <a href="@url" class="btn btn-sm @(isActive ? "btn-primary" : "btn-secondary text-slate-600 bg-white border-slate-200")">@label</a>
        }
    </div>
}

<div class="card p-0 overflow-hidden">
    <form method="get" class="flex flex-wrap items-center gap-3 p-3 bg-slate-50/50 border-b border-slate-200" action="/Odeme">
        <input type="search" name="q" value="@q.Q" class="form-control w-full max-w-xs text-xs font-medium" placeholder="Ara: kiracı, açıklama…" />
        <div class="flex items-center gap-2">
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                { "Name", "from" }, { "Value", q.From?.ToString("yyyy-MM-dd") ?? "" },
                { "Mode", "date" }, { "Field", "from" }, { "Compact", true }, { "WrapperClass", "w-36" }
            })
            <span class="text-muted">–</span>
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                { "Name", "to" }, { "Value", q.To?.ToString("yyyy-MM-dd") ?? "" },
                { "Mode", "date" }, { "Field", "to" }, { "Compact", true }, { "WrapperClass", "w-36" }
            })
        </div>
        <div class="flex items-center gap-2">
            <input type="number" name="min" value="@q.Min?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control w-24 text-xs font-medium" placeholder="Min ₺" />
            <input type="number" name="max" value="@q.Max?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control w-24 text-xs font-medium" placeholder="Max ₺" />
        </div>
        @if (durum != "tum") { <input type="hidden" name="durum" value="@durum" /> }
        @if (tahakkukId.HasValue) { <input type="hidden" name="tahakkukId" value="@tahakkukId" /> }
        <button type="submit" class="btn btn-primary btn-sm px-4">Filtrele</button>
        @if (!string.IsNullOrEmpty(q.Q) || q.From.HasValue || q.To.HasValue || q.Min.HasValue || q.Max.HasValue)
        {
            <a href="/Odeme@(durum != "tum" ? $"?durum={durum}" : "")" class="btn btn-secondary btn-sm text-slate-500">Temizle</a>
        }
    </form>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-28">Tarih</th>
                    <th>Kiracı</th>
                    <th class="w-32">Dönem</th>
                    <th class="w-32 num">Tutar</th>
                    <th class="w-24 cell-center">Kanal</th>
                    <th class="w-32">Giren</th>
                    <th class="w-36">Durum</th>
                    <th class="w-20"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    string durumCls = o.Durum switch {
                        OdemeDurumu.Onaylandi    => "badge-kirali",
                        OdemeDurumu.Reddedildi   => "badge-gecmis",
                        _                        => "badge-surek"
                    };
                    string durumLabel = o.Durum switch {
                        OdemeDurumu.Onaylandi    => "Onaylandı",
                        OdemeDurumu.Reddedildi   => "Reddedildi",
                        _                        => "Onay Bekliyor"
                    };
                    string kanalLabel = o.OdemeKanali switch {
                        OdemeKanali.Havale => "Havale",
                        OdemeKanali.EFT    => "EFT",
                        OdemeKanali.Nakit  => "Nakit",
                        _                  => "Diğer"
                    };
                    <tr>
                        <td>@o.OdemeTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="font-semibold">@o.KiraciGosterimAdi</td>
                        <td class="text-muted">@o.TahakkukDonemBaslangic.ToString("MMMM yyyy")</td>
                        <td class="num">@o.Tutar.ToString("N2") ₺</td>
                        <td class="cell-center">@kanalLabel</td>
                        <td class="text-muted truncate max-w-[120px]">@(o.GirenUserGosterimAdi ?? "—")</td>
                        <td><span class="badge @durumCls">@durumLabel</span></td>
                        <td class="text-right"><a href="/Odeme/Detay/@o.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                    </tr>
                }
                @if (Model.Total == 0)
                {
                    <tr><td colspan="8" class="text-center py-12 text-muted italic">Filtreye uygun ödeme kaydı bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
