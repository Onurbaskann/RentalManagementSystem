@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.KiraOdeme>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Ödemeler";
    int? tahakkukId = ViewBag.TahakkukId;
    string durum = ViewBag.Durum ?? "tum";
    var q = (TableQuery)ViewBag.Query;
    bool canApprove = User.HasClaim("permission", "Odeme.Approve");

    var extra = q.ToQueryDict();
    if (tahakkukId.HasValue) extra["tahakkukId"] = tahakkukId.Value.ToString();
    var pagination = new PaginationModel { Page = Model.Page, Size = Model.Size, Total = Model.Total, BasePath = "/Odeme", Extra = extra };
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        @if (tahakkukId.HasValue)
        {
            <a href="/Tahakkuk" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">← Tahakkuklar</a>
        }
        <div class="page-title">Ödemeler</div>
        <div class="page-subtitle">@Model.Total kayıt</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;">✓ @TempData["Success"]</div>
}

@if (!tahakkukId.HasValue)
{
    <div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;">
        @{
            var oFilters = new[] { ("tum","Tümü"), ("onaybekliyor","Onay Bekliyor"), ("onaylandi","Onaylandı"), ("reddedildi","Reddedildi") };
        }
        @foreach (var (key, label) in oFilters)
        {
            string cls = durum == key ? "btn btn-primary btn-sm" : "btn btn-secondary btn-sm";
            var url = key == "tum" ? "/Odeme" : $"/Odeme?durum={key}";
            <a href="@url" class="@cls">@label</a>
        }
    </div>
}

<div class="card" style="padding:0;overflow:hidden;">
    <form method="get" class="table-toolbar" action="/Odeme">
        <input type="search" name="q" value="@q.Q" class="form-control toolbar-search" placeholder="Ara: kiracı, açıklama…" />
        <input type="date" name="from" value="@(q.From?.ToString("yyyy-MM-dd"))" class="form-control toolbar-input" data-tip="Ödeme tarihi başlangıç" />
        <input type="date" name="to" value="@(q.To?.ToString("yyyy-MM-dd"))" class="form-control toolbar-input" data-tip="Ödeme tarihi bitiş" />
        <input type="number" name="min" value="@q.Min?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control toolbar-input" placeholder="Min ₺" />
        <input type="number" name="max" value="@q.Max?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control toolbar-input" placeholder="Max ₺" />
        @if (durum != "tum") { <input type="hidden" name="durum" value="@durum" /> }
        @if (tahakkukId.HasValue) { <input type="hidden" name="tahakkukId" value="@tahakkukId" /> }
        <button type="submit" class="btn btn-primary btn-sm">Filtrele</button>
        @if (!string.IsNullOrEmpty(q.Q) || q.From.HasValue || q.To.HasValue || q.Min.HasValue || q.Max.HasValue)
        {
            <a href="/Odeme@(durum != "tum" ? $"?durum={durum}" : "")" class="btn btn-secondary btn-sm">Temizle</a>
        }
    </form>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Kiracı</th>
                    <th>Dönem</th>
                    <th>Tutar</th>
                    <th>Kanal</th>
                    <th>Giren</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    string durumCls = o.Durum switch {
                        OdemeDurumu.Onaylandi    => "badge-kirali",
                        OdemeDurumu.Reddedildi   => "badge-gecmis",
                        _                        => "badge-surek"
                    };
                    string durumLabel = o.Durum switch {
                        OdemeDurumu.Onaylandi    => "Onaylandı",
                        OdemeDurumu.Reddedildi   => "Reddedildi",
                        _                        => "Onay Bekliyor"
                    };
                    string durumTip = o.Durum switch {
                        OdemeDurumu.Onaylandi    => "Ödeme onaylandı; tahakkuk kapandı.",
                        OdemeDurumu.Reddedildi   => "Ödeme reddedildi; tahakkuk açık kalır.",
                        _                        => "Onay yetkisi olan kullanıcı bekleniyor."
                    };
                    string kanalLabel = o.OdemeKanali switch {
                        OdemeKanali.Havale => "Havale",
                        OdemeKanali.EFT    => "EFT",
                        OdemeKanali.Nakit  => "Nakit",
                        _                  => "Diğer"
                    };
                    <tr>
                        <td style="font-size:13px;">@o.OdemeTarihi.ToString("dd.MM.yyyy")</td>
                        <td style="font-weight:500;">@o.KiraSozlesmesi.Kiraci.GosterimAdi</td>
                        <td style="font-size:13px;color:var(--color-muted);">@o.KiraTahakkuk.DonemBaslangic.ToString("MMM yyyy")</td>
                        <td style="font-weight:700;">@o.Tutar.ToString("N0") ₺</td>
                        <td style="font-size:12.5px;">@kanalLabel</td>
                        <td style="font-size:12.5px;color:var(--color-muted);">@(o.GirenUser?.AdSoyad ?? o.GirenUser?.Email ?? "—")</td>
                        <td><span class="badge @durumCls" data-tip="@durumTip">@durumLabel</span></td>
                        <td><a href="/Odeme/Detay/@o.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                    </tr>
                }
                @if (Model.Total == 0)
                {
                    <tr><td colspan="8" style="text-align:center;color:var(--color-muted);padding:32px;">Filtreye uygun ödeme kaydı yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
