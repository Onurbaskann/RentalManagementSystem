@model List<KiraTakip.Models.Dtos.KiraciListItemDto>
@using KiraTakip.Models
@using KiraTakip.Services.Interfaces
@inject IIstatistikService Istatistik
@{
    ViewData["Title"] = "Kiracılar";
    bool canEdit = User.HasPermission(PermissionCatalog.Kiraci.Create) || User.HasPermission(PermissionCatalog.Kiraci.Edit);
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Kiracılar</div>
        <div class="page-subtitle">@Model.Count kayıtlı kiracı</div>
    </div>
    @if (canEdit)
    {
        <a href="/Kiraci/Ekle" class="btn btn-primary flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Kiracı
        </a>
    }
</div>

<div class="card p-0 overflow-hidden" x-data="clientTable({ pageSize: 25 })" x-init="init()">
    <div class="flex items-center gap-4 p-3 bg-slate-50/50 border-b border-slate-200">
        <input type="search" class="form-control w-full max-w-sm" placeholder="Ara: ad, no, telefon, e-posta…" x-model.debounce.250ms="q" />
        <span class="ml-auto text-xs text-muted">
            <span x-text="total" class="font-bold"></span> kayıt
        </span>
    </div>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-24">No</th>
                    <th>Kiracı Bilgisi</th>
                    <th class="w-32">Kategori</th>
                    <th class="w-32">İletişim</th>
                    <th class="w-32">Sözleşme</th>
                    <th class="w-28 cell-center">Kayıt Tarihi</th>
                    <th class="w-36"></th>
                </tr>
            </thead>
            <tbody x-ref="tbody">
                @foreach (var k in Model)
                {
                    var aktifSozlesmeCount = ((Dictionary<int,int>)ViewBag.AktifSozlesme).GetValueOrDefault(k.Id, 0);
                    var search = $"{k.KiraciNo} {k.GosterimAdi} {k.VergiNo} {k.Telefon} {k.Email}".ToLower();
                    <tr data-row data-search="@search" data-href="/Kiraci/Detay/@k.Id.ToHashId()"
                        class="cursor-pointer hover:bg-slate-50 transition-colors"
                        @@click="$el.dataset.href && !$event.target.closest('a,[data-stop]') && (window.location.href = $el.dataset.href)">
                        <td class="font-mono text-xs text-muted">@k.KiraciNo</td>
                        <td>
                            <div class="font-semibold">@k.GosterimAdi</div>
                            @if (!string.IsNullOrEmpty(k.VergiNo))
                            {
                                <span class="cell-sub">VKN: @k.VergiNo</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(k.KiraciKategoriAd))
                            {
                                <span class="inline-block bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md text-[11px] font-medium border border-slate-200">@k.KiraciKategoriAd</span>
                            }
                            else
                            {
                                <span class="text-slate-300 text-xs">—</span>
                            }
                        </td>
                        <td>
                            <div>@k.Telefon</div>
                            <span class="cell-sub truncate max-w-[120px]">@k.Email</span>
                        </td>
                        <td>
                            @if (aktifSozlesmeCount > 0)
                            {
                                <span class="badge badge-kirali">@aktifSozlesmeCount Sözleşme</span>
                            }
                            else
                            {
                                <span class="badge badge-bos">Yok</span>
                            }
                        </td>
                        <td class="cell-center whitespace-nowrap">@k.KayitTarihi.ToString("dd.MM.yyyy")</td>
                        @if (canEdit)
                        {
                            <td class="text-right">
                                <a href="/Kiraci/Duzenle/@k.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="flex items-center justify-between p-3 bg-slate-50/50 border-t border-slate-200" x-show="totalPages > 1">
        <div class="text-xs text-muted font-medium">
            <span x-text="from"></span>–<span x-text="to"></span> / <strong x-text="total"></strong> kayıt
        </div>
        <nav class="flex gap-1" aria-label="Sayfalar">
            <button type="button" class="w-8 h-8 flex items-center justify-center rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" :disabled="page === 1" @@click="prev()">‹</button>
            <template x-for="p in pageList" :key="p">
                <button type="button" class="w-8 h-8 flex items-center justify-center rounded border font-medium text-xs transition-colors" 
                        :class="p === page ? 'bg-primary text-white border-primary' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'" 
                        @@click="goto(p)" x-text="p"></button>
            </template>
            <button type="button" class="w-8 h-8 flex items-center justify-center rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" :disabled="page === totalPages" @@click="next()">›</button>
        </nav>
    </div>
    <div class="p-8 text-center" x-show="total === 0" x-cloak>
        <div class="text-slate-400 font-medium">Aramaya uyan kayıt bulunamadı.</div>
    </div>
</div>

