@model KiraTakip.Models.ViewModels.KiraciDetayViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = Model.Kiraci.GosterimAdi;
    var k = Model.Kiraci;
    bool canEdit = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Kiraci.Edit);
    bool isTuzel = k.KiraciTuru == KiraciTuru.Tuzel;
}

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 px-4 rounded-lg mb-4 text-[13.5px] font-medium">✓ @TempData["Success"]</div>
}

<div class="page-header flex flex-wrap items-start justify-between mb-1 gap-4">
    <div>
        <a href="/Kiraci" class="text-[12.5px] text-muted no-underline mb-2.5 inline-block transition-colors hover:text-primary">← Kiracılar</a>
        <div class="flex items-center gap-3">
            <div class="page-title m-0">@k.GosterimAdi</div>
            <span class="text-[12px] text-muted font-mono bg-[var(--color-surface-muted)] p-0.5 px-2 rounded border border-[var(--color-border)]">@k.KiraciNo</span>
        </div>
        <div class="mt-2.5 flex gap-2 items-center">
            @if (isTuzel)
            { <span class="badge badge-kurumsal p-1 px-3 text-[12px]">Tüzel Kişi</span> }
            else
            { <span class="badge badge-bireysel p-1 px-3 text-[12px]">Gerçek Kişi</span> }
            
            @if (!string.IsNullOrEmpty(k.KiraciKategoriAd))
            {
                <div class="w-1 h-1 rounded-full bg-slate-300"></div>
                <span class="badge bg-slate-50 text-slate-600 border border-slate-200 p-1 px-3 text-[12px] font-semibold">@k.KiraciKategoriAd</span>
            }
        </div>
    </div>
    @if (canEdit)
    {
        <div class="flex gap-2">
            <a href="/Kiraci/Duzenle/@k.Id" class="btn btn-secondary">Düzenle</a>
            <a href="/Sozlesme/Ekle" class="btn btn-primary">Sözleşme Ekle</a>
        </div>
    }
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
    <!-- İletişim -->
    <div class="card">
        <div class="card-title">İletişim</div>
        <div class="flex flex-col gap-2 mt-2">
            <div class="flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.61 4.59 2 2 0 0 1 3.58 2.41h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.52 17z"/></svg>
                <span class="text-[13.5px]">@k.Telefon</span>
            </div>
            <div class="flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <span class="text-[13.5px]">@k.Email</span>
            </div>
            @if (!string.IsNullOrEmpty(k.Adres))
            {
                <div class="flex items-start gap-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted shrink-0 mt-1"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span class="text-[13.5px]">@k.Adres</span>
                </div>
            }
        </div>
    </div>

    <!-- Kimlik Bilgisi -->
    <div class="card">
        <div class="card-title">@(isTuzel ? "Kurum Bilgisi" : "Kimlik Bilgisi")</div>
        <div class="mt-2 flex flex-col gap-2.5">
            @if (isTuzel)
            {
                @if (!string.IsNullOrEmpty(k.VergiNo))
                {
                    <div>
                        <div class="text-[11.5px] text-muted mb-0.5">Vergi No</div>
                        <div class="text-sm font-bold font-mono tracking-wider">@k.VergiNo</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(k.VergiDairesi))
                {
                    <div>
                        <div class="text-[11.5px] text-muted mb-0.5">Vergi Dairesi</div>
                        <div class="text-sm font-medium">@k.VergiDairesi</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(k.TicaretSicilNo))
                {
                    <div>
                        <div class="text-[11.5px] text-muted mb-0.5">Ticaret Sicil No</div>
                        <div class="text-sm font-medium font-mono">@k.TicaretSicilNo</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(k.MersisNo))
                {
                    <div>
                        <div class="text-[11.5px] text-muted mb-0.5">Mersis No</div>
                        <div class="text-[13px] font-mono">@k.MersisNo</div>
                    </div>
                }
            }
            else
            {
                @if (!string.IsNullOrEmpty(k.TcKimlikNo))
                {
                    <div>
                        <div class="text-[11.5px] text-muted mb-0.5">TC Kimlik No</div>
                        <div class="text-base font-bold tracking-[0.08em] font-mono text-slate-700">@k.TcKimlikNo</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(k.Unvan))
                {
                    <div>
                        <div class="text-[11.5px] text-muted mb-0.5">Ünvan</div>
                        <div class="text-sm font-medium">@k.Unvan</div>
                    </div>
                }
                @if (k.DogumTarihi.HasValue)
                {
                    <div>
                        <div class="text-[11.5px] text-muted mb-0.5">Doğum Tarihi</div>
                        <div class="text-sm font-medium">@k.DogumTarihi.Value.ToString("dd.MM.yyyy")</div>
                    </div>
                }
            }
            @if (!string.IsNullOrEmpty(k.KiraciKategoriAd))
            {
                <div>
                    <div class="text-[11.5px] text-muted mb-0.5">Kategori</div>
                    <div class="text-[13px] font-medium">@k.KiraciKategoriAd</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(k.SektorAd))
            {
                <div>
                    <div class="text-[11.5px] text-muted mb-0.5">Sektör</div>
                    <div class="text-[13px] font-medium">@k.SektorAd</div>
                </div>
            }
        </div>
    </div>

    <!-- Sözleşme Özeti -->
    <div class="card">
        <div class="card-title">Sözleşme Özeti</div>
        @{
            var aktifler = Model.Sozlesmeler.Where(s => s.Aktif).ToList();
            decimal toplamAylik = 0m;
            foreach (var aks in aktifler)
                toplamAylik += aks.AylikBedel;
        }
        <div class="card-value text-2xl mt-2 font-bold">@aktifler.Count</div>
        <div class="card-sub text-muted text-xs">aktif sözleşme</div>
        @if (toplamAylik > 0)
        {
            <div class="mt-2.5 pt-2.5 border-t border-[var(--color-border)] text-[13.5px] font-bold text-primary">
                @toplamAylik.ToString("N0") ₺/ay
            </div>
        }
    </div>
</div>

<!-- Sözleşmeler tablosu -->
<div class="card p-0 overflow-hidden">
    <div class="p-[18px_20px_14px] border-b border-[var(--color-border)]">
        <div class="section-title">Sözleşmeler</div>
    </div>
    @if (!Model.Sozlesmeler.Any())
    {
        <div class="p-8 text-center text-muted">Bu kiracıya ait sözleşme yok.</div>
    }
    else
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Taşınmaz / Birim</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th>Aylık Bedel</th>
                        <th>Depozito</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Sozlesmeler)
                    {
                        bool aktif = s.Aktif;
                        int kalanGun = s.KalanGun;
                        bool surek = aktif && kalanGun <= 30;
                        bool feshedildi = s.Durum == SozlesmeDurumu.Feshedildi;
                        <tr>
                            <td>
                                <div class="font-semibold">@s.TasinmazAd</div>
                                <div class="text-xs text-muted">@s.BirimAd</div>
                            </td>
                            <td>@s.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                            <td>
                                @s.BitisTarihi.ToString("dd.MM.yyyy")
                                @if (surek) { <span class="day-badge day-badge-amber ml-1.5 text-[11px]">@kalanGun g</span> }
                            </td>
                            <td class="font-bold">@s.AylikBedel.ToString("N0") ₺</td>
                            <td>@(Model.DepozitoTutarlari.TryGetValue(s.Id, out var dep) && dep.HasValue ? dep.Value.ToString("N0") + " ₺" : "—")</td>
                            <td>
                                @if (feshedildi) { <span class="badge badge-gecmis">Feshedildi</span> }
                                else if (surek) { <span class="badge badge-surek">Dolmak Üzere</span> }
                                else if (aktif) { <span class="badge badge-kirali">Aktif</span> }
                                else { <span class="badge badge-gecmis">Geçmiş</span> }
                            </td>
                            <td><a href="/Sozlesme/Detay/@s.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
