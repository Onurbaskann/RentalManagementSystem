@model KiraTakip.Models.ViewModels.RolDuzenleViewModel
@{
    ViewData["Title"] = "Rol Düzenle";
}

<div class="page-header">
    <div>
        <a href="/Admin/Roller" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Rol Yönetimi
        </a>
        <div class="page-title">Rol Düzenle</div>
        <div class="page-subtitle">@Model.Ad</div>
    </div>
</div>

@if (Model.IsSystemRole)
{
    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-lg mb-4 text-[13.5px]">
        Bu bir sistem rolüdür. Adı değiştirilemez; yalnızca açıklama ve izinler düzenlenebilir.
    </div>
}

<div class="card">
    <form method="post" action="/Admin/Roller/Duzenle/@Model.Id">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsSystemRole" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-5 text-sm"></div>
        }

        <div class="form-group">
            <label class="form-label">Rol Adı</label>
            @if (Model.IsSystemRole)
            {
                <div class="form-control bg-slate-50 text-muted cursor-default">@Model.Ad</div>
                <input type="hidden" asp-for="Ad" />
            }
            else
            {
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="form-error"></span>
            }
        </div>

        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <input asp-for="Aciklama" class="form-control" placeholder="Opsiyonel" />
        </div>

        @if (Model.Ad != "Admin")
        {
            <div class="mt-5">
                <label class="form-label mb-3">İzinler</label>
                <div class="flex flex-col gap-4">
                    @foreach (var grup in Model.Permissions)
                    {
                        <div class="bg-slate-50 border border-slate-100 rounded-xl p-4">
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                                <span class="w-1.5 h-1.5 bg-indigo-400 rounded-full"></span>
                                @grup.GrupAdi
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2.5">
                                @foreach (var p in grup.Permissions)
                                {
                                    <label class="flex items-center gap-2 text-[13px] font-medium text-slate-600 cursor-pointer hover:text-indigo-600 transition-colors">
                                        <input type="checkbox" name="SelectedPermissions" value="@p.Value"
                                               @(p.Selected ? "checked" : "")
                                               class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                        @p.Etiket
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mt-4 text-[13.5px]">
                Admin rolü tüm izinlere otomatik olarak sahiptir. İzin düzenleme uygulanmaz.
            </div>
        }

        <div class="flex gap-2 mt-6">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Admin/Roller" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
