@model KiraTakip.Models.ViewModels.KiraciKullaniciDuzenleViewModel
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="page-header">
    <div>
        <a href="/Kiraci/Kullanicilar" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Kullanıcılar
        </a>
        <div class="page-title">Kullanıcı Düzenle</div>
        <div class="page-subtitle">@Model.Email</div>
    </div>
</div>

@if (Model.IsCurrentUser)
{
    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-lg mb-4 text-[13.5px]">
        Kendi hesabınızı bu ekrandan değiştiremezsiniz.
    </div>
}

<div class="card">
    <form method="post" action="/Kiraci/Kullanicilar/Duzenle/@Model.Id" asp-form-write-permission="@PermissionCatalog.TenantPortal.System.User.Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsCurrentUser" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-5 text-sm"></div>
        }

        <div class="form-group">
            <label class="form-label">E-posta</label>
            <div class="form-control bg-slate-50 text-muted cursor-default">@Model.Email</div>
            <input type="hidden" asp-for="Email" />
        </div>

        <div class="form-group">
            <label class="form-label">Ad Soyad</label>
            <input asp-for="AdSoyad" class="form-control" />
            <span asp-validation-for="AdSoyad" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Rol</label>
            @if (Model.IsCurrentUser)
            {
                var mevcutRolAd = Model.Roller.FirstOrDefault(r => r.Id == Model.RolId)?.Ad ?? "—";
                <div class="form-control bg-slate-50 text-muted cursor-default">@mevcutRolAd</div>
                <input type="hidden" asp-for="RolId" />
            }
            else
            {
                <select asp-for="RolId" class="form-control">
                    <option value="0">— Seçin —</option>
                    @foreach (var r in Model.Roller)
                    {
                        <option value="@r.Id">@r.Ad</option>
                    }
                </select>
                <span asp-validation-for="RolId" class="form-error"></span>
            }
        </div>

        <div class="flex gap-2.5 mt-6">
            @if (Model.IsCurrentUser)
            {
                <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.TenantPortal.System.User.Edit" disabled>Kaydet</button>
            }
            else
            {
                <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.TenantPortal.System.User.Edit">Kaydet</button>
            }
            <a href="/Kiraci/Kullanicilar" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>


