@model KiraTakip.Models.ViewModels.TenantRoleFormViewModel
@using System.Text.Json
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Rol Düzenle";
    ViewData["UseCentralFeedback"] = true;
    var controllerName = nameof(KiraTakip.Controllers.TenantRoleController)
        .Replace("Controller", string.Empty);
    var indexActionName = nameof(KiraTakip.Controllers.TenantRoleController.Index);
    var editActionName = nameof(KiraTakip.Controllers.TenantRoleController.Edit);

    var riskSegments = new HashSet<string> { "Delete", "Cancel", "Terminate", "OverrideRate", "Approve", "Reject" };

    var treeData = Model.Permissions.Select(g =>
    {
        var moduleItem = g.Permissions.FirstOrDefault();
        return new
        {
            path = moduleItem?.Value ?? "",
            name = g.GroupName,
            @checked = moduleItem?.Selected ?? false,
            actions = g.Permissions.Skip(1).Select(p => new
            {
                value = p.Value,
                label = p.Label,
                @checked = p.Selected,
                danger = riskSegments.Contains(p.Value.Split('.').LastOrDefault() ?? "")
            }).ToList()
        };
    }).ToList();

    var treeJson = JsonSerializer.Serialize(treeData);
}

<div class="page-header">
    <div>
        <a asp-controller="@controllerName" asp-action="@indexActionName" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Rol Yönetimi
        </a>
        <div class="page-title">Rol Düzenle</div>
        <div class="page-subtitle">@Model.Name</div>
    </div>
</div>

<div class="card">
    <form asp-controller="@controllerName" asp-action="@editActionName"
          asp-route-id="@Model.Id!.Value.ToHashId()" method="post"
          asp-form-write-permission="@PermissionCatalog.TenantPortal.System.Role.Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label class="form-label">Rol Adı</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <input asp-for="Description" class="form-control" placeholder="Opsiyonel" />
        </div>

        <div class="mt-5">
            <label class="form-label mb-2">İzinler</label>
            @await Html.PartialAsync("_PermissionTreePicker", new ViewDataDictionary(ViewData) { { "TreeJson", treeJson } })
        </div>

        <div class="flex gap-2 mt-6">
            <button type="submit" class="btn btn-primary" asp-permission="@PermissionCatalog.TenantPortal.System.Role.Edit">Kaydet</button>
            <a asp-controller="@controllerName" asp-action="@indexActionName" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
