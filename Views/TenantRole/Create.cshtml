@model KiraTakip.Models.ViewModels.RolOlusturViewModel
@using System.Text.Json
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Yeni Rol";

    var riskSegments = new HashSet<string> { "Delete", "Cancel", "Terminate", "OverrideRate", "Approve", "Reject" };

    var treeData = Model.Permissions.Select(g =>
    {
        var moduleItem = g.Permissions.FirstOrDefault();
        return new
        {
            path = moduleItem?.Value ?? "",
            name = g.GrupAdi,
            @checked = moduleItem?.Selected ?? false,
            actions = g.Permissions.Skip(1).Select(p => new
            {
                value = p.Value,
                label = p.Etiket,
                @checked = p.Selected,
                danger = riskSegments.Contains(p.Value.Split('.').LastOrDefault() ?? "")
            }).ToList()
        };
    }).ToList();

    var treeJson = JsonSerializer.Serialize(treeData);
}

<div class="page-header">
    <div>
        <a href="/Tenant/Roller" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Rol Yönetimi
        </a>
        <div class="page-title">Yeni Rol</div>
        <div class="page-subtitle">Kiracıya özel rol tanımlayın</div>
    </div>
</div>

<div class="card">
    <form method="post" action="/Tenant/Roller/Ekle" asp-form-write-permission="@PermissionCatalog.TenantPortal.System.Role.Create">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-5 text-sm"></div>
        }

        <div class="form-group">
            <label class="form-label">Rol Adı *</label>
            <input asp-for="Ad" class="form-control" />
            <span asp-validation-for="Ad" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <input asp-for="Aciklama" class="form-control" placeholder="Opsiyonel" />
        </div>

        <div class="mt-5">
            <label class="form-label mb-2">İzinler</label>
            @await Html.PartialAsync("_PermissionTreePicker", new ViewDataDictionary(ViewData) { { "TreeJson", treeJson } })
        </div>

        <div class="flex gap-2 mt-6">
            <button type="submit" class="btn btn-primary" asp-permission="@PermissionCatalog.TenantPortal.System.Role.Create">Oluştur</button>
            <a href="/Tenant/Roller" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

