@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.RoleListItemDto>
@using KiraTakip.Authorization
@using KiraTakip.Models.Common
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Rol Yönetimi";
    ViewData["UseCentralFeedback"] = true;
    var controllerName = nameof(KiraTakip.Controllers.TenantRoleController)
        .Replace("Controller", string.Empty);
    var createActionName = nameof(KiraTakip.Controllers.TenantRoleController.Create);
    var editActionName = nameof(KiraTakip.Controllers.TenantRoleController.Edit);
    var deleteActionName = nameof(KiraTakip.Controllers.TenantRoleController.Delete);
    var canCreate = User.HasPermission(PermissionCatalog.TenantPortal.System.Role.Create);
    var canEdit = User.HasPermission(PermissionCatalog.TenantPortal.System.Role.Edit);
    var canDelete = User.HasPermission(PermissionCatalog.TenantPortal.System.Role.Delete);
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var pagination = PaginationModel.FromPaged(Model, "/Tenant/Roles", query.ToQueryDict());
}


<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Rol Yönetimi</div>
        <div class="page-subtitle">@Model.Total rol tanımlı</div>
    </div>
    @if (canCreate)
    {
        <a asp-controller="@controllerName" asp-action="@createActionName" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Rol
        </a>
    }
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Rol Adı</th>
                    <th>Açıklama</th>
                    <th>Kullanıcılar</th>
                    <th>İzinler</th>
                    <th>Tür</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.Items)
                {
                    <tr>
                        <td class="font-semibold">@role.Name</td>
                        <td class="text-sm text-muted">@(role.Description ?? "—")</td>
                        <td class="text-sm">@role.UserCount kullanıcı</td>
                        <td class="text-sm">@role.PermissionCount izin</td>
                        <td>
                             @if (role.IsSystemRole)
                            { <span class="badge badge-kurumsal">Sistem</span> }
                            else
                            { <span class="badge badge-bos">Özel</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end items-center">
                            @if (role.IsSystemRole)
                            {
                                <span class="inline-flex items-center gap-1 text-[11.5px] text-muted px-2 py-1" title="Sistem rolleri düzenlenemez">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    Kilitli
                                </span>
                            }
                            else if (canEdit)
                            {
                                <a asp-controller="@controllerName" asp-action="@editActionName"
                                   asp-route-id="@role.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            }
                            @if (canDelete && !role.IsSystemRole)
                            {
                                <form asp-controller="@controllerName" asp-action="@deleteActionName"
                                      asp-route-id="@role.Id.ToHashId()" method="post"
                                      data-confirm="'@role.Name' rolünü silmek istediğinizden emin misiniz?" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
