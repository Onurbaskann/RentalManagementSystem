@model KiraTakip.Models.ViewModels.RolDuzenleViewModel
@using System.Text.Json
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Rol Düzenle";

    var riskSegments = new HashSet<string> { "Delete", "Cancel", "Terminate", "OverrideRate", "Approve", "Reject" };

    var treeData = Model.Permissions.Select(g =>
    {
        var moduleItem = g.Permissions.FirstOrDefault();
        return new
        {
            path = moduleItem?.Value ?? "",
            name = g.GrupAdi,
            @checked = moduleItem?.Selected ?? false,
            actions = g.Permissions.Skip(1).Select(p => new
            {
                value = p.Value,
                label = p.Etiket,
                @checked = p.Selected,
                danger = riskSegments.Contains(p.Value.Split('.').LastOrDefault() ?? "")
            }).ToList()
        };
    }).ToList();

    var treeJson = JsonSerializer.Serialize(treeData);
}

<div class="page-header">
    <div>
        <a href="/Kiraci/Roller" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Rol Yönetimi
        </a>
        <div class="page-title">Rol Düzenle</div>
        <div class="page-subtitle">@Model.Ad</div>
    </div>
</div>

@if (Model.IsSystemRole)
{
    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-lg mb-4 text-[13.5px]">
        Bu bir sistem rolüdür. Adı değiştirilemez; yalnızca açıklama ve izinler düzenlenebilir.
    </div>
}

<div class="card">
    <form method="post" action="/Kiraci/Roller/Duzenle/@Model.Id.ToHashId()" asp-form-write-permission="@PermissionCatalog.KiraciPortal.System.Rol.Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsSystemRole" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-5 text-sm"></div>
        }

        <div class="form-group">
            <label class="form-label">Rol Adı</label>
            @if (Model.IsSystemRole)
            {
                <div class="form-control bg-slate-50 text-muted cursor-default">@Model.Ad</div>
                <input type="hidden" asp-for="Ad" />
            }
            else
            {
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="form-error"></span>
            }
        </div>

        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <input asp-for="Aciklama" class="form-control" placeholder="Opsiyonel" />
        </div>

        <div class="mt-5">
            <label class="form-label mb-2">İzinler</label>
            @await Html.PartialAsync("_PermissionTreePicker", new ViewDataDictionary(ViewData) { { "TreeJson", treeJson } })
        </div>

        <div class="flex gap-2 mt-6">
            <button type="submit" class="btn btn-primary" asp-permission="@PermissionCatalog.KiraciPortal.System.Rol.Edit">Kaydet</button>
            <a href="/Kiraci/Roller" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

