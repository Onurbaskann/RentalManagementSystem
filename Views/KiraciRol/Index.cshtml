@model List<KiraTakip.Models.ViewModels.RolListeViewModel>
@using KiraTakip.Authorization
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Rol Yönetimi";
    var canCreate = User.HasPermission(PermissionCatalog.KiraciPortal.System.Rol.Create);
    var canDelete = User.HasPermission(PermissionCatalog.KiraciPortal.System.Rol.Delete);
}

@if (TempData["Success"] != null)
{
    <div class="alert-success mb-4">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-danger mb-4">✕ @TempData["Error"]</div>
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Rol Yönetimi</div>
        <div class="page-subtitle">@Model.Count rol tanımlı</div>
    </div>
    @if (canCreate)
    {
        <a href="/Kiraci/Roller/Ekle" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Rol
        </a>
    }
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Rol Adı</th>
                    <th>Açıklama</th>
                    <th>Kullanıcılar</th>
                    <th>İzinler</th>
                    <th>Tür</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="font-semibold">@r.Ad</td>
                        <td class="text-sm text-muted">@(r.Aciklama ?? "—")</td>
                        <td class="text-sm">@r.KullaniciSayisi kullanıcı</td>
                        <td class="text-sm">@r.IzinSayisi izin</td>
                        <td>
                            @if (r.IsSystemRole)
                            { <span class="badge badge-kurumsal">Sistem</span> }
                            else
                            { <span class="badge badge-bos">Özel</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end items-center">
                            @if (r.IsSystemRole)
                            {
                                <span class="inline-flex items-center gap-1 text-[11.5px] text-muted px-2 py-1" title="Sistem rolleri düzenlenemez">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    Kilitli
                                </span>
                            }
                            else
                            {
                                <a href="/Kiraci/Roller/Duzenle/@r.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            }
                            @if (canDelete && !r.IsSystemRole)
                            {
                                <form method="post" action="/Kiraci/Roller/Sil/@r.Id.ToHashId()"
                                      data-confirm="'@r.Ad' rolünü silmek istediğinizden emin misiniz?" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

