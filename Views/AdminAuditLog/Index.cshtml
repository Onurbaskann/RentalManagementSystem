@using KiraTakip.Infrastructure
@using KiraTakip.Models.Common
@using System.Text.Json
@model KiraTakip.Models.ViewModels.AuditLogFilterViewModel
@{
    ViewData["Title"] = "Hareket Geçmişi";
    var baslangicStr = Model.Query.From.HasValue ? Model.Query.From.Value.ToString("yyyy-MM-dd") : string.Empty;
    var bitisStr     = Model.Query.To.HasValue ? Model.Query.To.Value.ToString("yyyy-MM-dd") : string.Empty;
    var emailStr     = Model.UserEmail ?? string.Empty;
    var paginationExtra = Model.Query.ToQueryDict();
    paginationExtra["eventType"] = Model.EventType;
    paginationExtra["entityType"] = Model.EntityType;
    paginationExtra["userEmail"] = Model.UserEmail;
    var pagination = PaginationModel.FromPaged(Model.Records, "/Admin/AuditLog", paginationExtra);
}

<div x-data="auditModal()" @@keydown.escape.window="close()">

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Hareket Geçmişi</div>
        <div class="page-subtitle">@Model.Records.Total kayıt</div>
    </div>
</div>

<div class="card mb-4">
    <form method="get" action="/Admin/AuditLog" class="flex flex-wrap gap-3 items-end">
        <input type="hidden" name="size" value="@Model.Query.Size" />
        <div class="flex-1 min-w-[180px]">
            <label class="form-label">Olay Türü</label>
            <select name="eventType" class="form-control">
                <option value="">— Tümü —</option>
                @foreach (var et in Model.AvailableEventTypes)
                {
                    <option value="@et" selected="@(Model.EventType == et ? "selected" : null)">@AuditDisplayNames.EventDisplay(et)</option>
                }
            </select>
        </div>
        <div class="flex-1 min-w-[160px]">
            <label class="form-label">Varlık Türü</label>
            <select name="entityType" class="form-control">
                <option value="">— Tümü —</option>
                @foreach (var et in Model.AvailableEntityTypes)
                {
                    <option value="@et" selected="@(Model.EntityType == et ? "selected" : null)">@AuditDisplayNames.EntityDisplay(et)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Başlangıç</label>
            <input type="date" name="from" class="form-control" value="@baslangicStr" />
        </div>
        <div>
            <label class="form-label">Bitiş</label>
            <input type="date" name="to" class="form-control" value="@bitisStr" />
        </div>
        <div class="flex-1 min-w-[180px]">
            <label class="form-label">Kullanıcı E-posta</label>
            <input type="text" name="userEmail" class="form-control" placeholder="ornek@@..."
                   value="@emailStr" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Filtrele</button>
            <a href="/Admin/AuditLog" class="btn btn-secondary">Temizle</a>
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.UserNotFoundMessage))
    {
        <div class="mt-3 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
            @Model.UserNotFoundMessage
        </div>
    }
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Olay</th>
                    <th>Varlık</th>
                    <th>ID</th>
                    <th>Kullanıcı</th>
                    <th>IP</th>
                    <th>Detay</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Records.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-6">Kayıt bulunamadı.</td></tr>
                }
                @foreach (var k in Model.Records.Items)
                {
                    var payload = new
                    {
                        date      = k.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss"),
                        @event    = AuditDisplayNames.EventDisplay(k.EventType),
                        eventRaw  = k.EventType,
                        entity    = AuditDisplayNames.EntityDisplay(k.EntityType),
                        entityRaw = k.EntityType,
                        id        = k.EntityId,
                        user      = k.UserFullName ?? "—",
                        ip        = k.IpAddress ?? "—",
                        details   = k.Details
                    };
                    var payloadJson = JsonSerializer.Serialize(payload);
                    <tr>
                        <td class="text-sm whitespace-nowrap">@k.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>
                            <span class="badge @(k.EventType.StartsWith("Entity.") ? "badge-bos" : "badge-kirali") text-xs">
                                @AuditDisplayNames.EventDisplay(k.EventType)
                            </span>
                        </td>
                        <td class="text-sm text-muted">@AuditDisplayNames.EntityDisplay(k.EntityType)</td>
                        <td class="text-sm text-muted font-mono">@(k.EntityId ?? "—")</td>
                        <td class="text-sm">@(k.UserFullName ?? "—")</td>
                        <td class="text-sm text-muted font-mono">@(k.IpAddress ?? "—")</td>
                        <td class="text-sm">
                            @if (!string.IsNullOrWhiteSpace(k.Details))
                            {
                                <button type="button"
                                        class="text-primary text-xs underline hover:no-underline cursor-pointer"
                                        data-payload='@payloadJson'
                                        @@click="open(JSON.parse($event.currentTarget.dataset.payload))">
                                    Görüntüle
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", pagination)
</div>

<div x-show="isOpen"
     x-cloak
     x-transition.opacity
     class="fixed inset-0 bg-slate-900/60 backdrop-blur-[2px] z-[9999] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl overflow-hidden flex flex-col"
         @@click.outside="close()"
         x-transition.scale.origin.center>
        <div class="p-5 border-b border-slate-100">
            <div class="flex items-center justify-between">
                <div class="text-lg font-bold text-slate-800">Hareket Detayı</div>
                <button type="button" class="text-slate-400 hover:text-slate-700 text-xl leading-none" @@click="close()" aria-label="Kapat">×</button>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-2 mt-4 text-xs">
                <div><span class="text-muted">Tarih:</span> <span class="font-medium" x-text="row.date"></span></div>
                <div><span class="text-muted">Olay:</span> <span class="font-medium" x-text="row.event"></span></div>
                <div><span class="text-muted">Varlık:</span> <span class="font-medium" x-text="row.entity"></span></div>
                <div><span class="text-muted">ID:</span> <span class="font-mono" x-text="row.id || '—'"></span></div>
                <div><span class="text-muted">Kullanıcı:</span> <span class="font-medium" x-text="row.user"></span></div>
                <div><span class="text-muted">IP:</span> <span class="font-mono" x-text="row.ip"></span></div>
            </div>
        </div>
        <div class="p-5 overflow-auto" style="max-height: 60vh;">
            <template x-if="details.type === 'changes-modified'">
                <table class="w-full text-xs border-collapse">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="text-left p-2 border-b border-slate-200 font-semibold">Alan</th>
                            <th class="text-left p-2 border-b border-slate-200 font-semibold">Eski Değer</th>
                            <th class="text-left p-2 border-b border-slate-200 font-semibold">Yeni Değer</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(ch, i) in details.items" :key="i">
                            <tr class="border-b border-slate-100 last:border-0">
                                <td class="p-2 font-mono text-slate-700" x-text="ch.prop"></td>
                                <td class="p-2 font-mono text-slate-500 break-all" x-text="formatValue(ch.old)"></td>
                                <td class="p-2 font-mono text-slate-700 break-all" x-text="formatValue(ch.new)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </template>
            <template x-if="details.type === 'changes-single'">
                <table class="w-full text-xs border-collapse">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="text-left p-2 border-b border-slate-200 font-semibold">Alan</th>
                            <th class="text-left p-2 border-b border-slate-200 font-semibold" x-text="details.valueHeader"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(ch, i) in details.items" :key="i">
                            <tr class="border-b border-slate-100 last:border-0">
                                <td class="p-2 font-mono text-slate-700" x-text="ch.prop"></td>
                                <td class="p-2 font-mono text-slate-700 break-all" x-text="formatValue(details.valueKey === 'new' ? ch.new : ch.old)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </template>
            <template x-if="details.type === 'raw'">
                <pre class="text-xs bg-slate-50 rounded-lg p-3 overflow-x-auto whitespace-pre-wrap break-all" x-text="details.raw"></pre>
            </template>
            <template x-if="details.type === 'empty'">
                <div class="text-muted text-sm">Detay bilgisi yok.</div>
            </template>
        </div>
        <div class="p-4 flex justify-end bg-slate-50 border-t border-slate-100">
            <button type="button" class="btn btn-secondary" @@click="close()">Kapat</button>
        </div>
    </div>
</div>

</div>

@section Scripts {
<script>
function auditModal() {
    return {
        isOpen: false,
        row: { date: '', event: '', entity: '', id: '', user: '', ip: '' },
        details: { type: 'empty', items: [], raw: null, valueHeader: '', valueKey: '' },
        open(payload) {
            this.row = payload;
            this.parseDetails(payload.details);
            this.isOpen = true;
        },
        close() { this.isOpen = false; },
        parseDetails(raw) {
            if (!raw) { this.details = { type: 'empty' }; return; }
            try {
                const obj = JSON.parse(raw);
                if (obj && Array.isArray(obj.changes)) {
                    if (obj.action === 'Modified') {
                        this.details = { type: 'changes-modified', items: obj.changes };
                        return;
                    }
                    if (obj.action === 'Added') {
                        this.details = { type: 'changes-single', items: obj.changes, valueHeader: 'Yeni Değer', valueKey: 'new' };
                        return;
                    }
                    if (obj.action === 'Deleted') {
                        this.details = { type: 'changes-single', items: obj.changes, valueHeader: 'Silinen Değer', valueKey: 'old' };
                        return;
                    }
                }
                this.details = { type: 'raw', raw: JSON.stringify(obj, null, 2) };
            } catch {
                this.details = { type: 'raw', raw: raw };
            }
        },
        formatValue(v) {
            if (v === null || v === undefined) return '—';
            if (v === '') return '(boş)';
            return String(v);
        }
    };
}
</script>
}
