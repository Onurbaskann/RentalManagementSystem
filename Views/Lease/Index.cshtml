@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.LeaseListItemDto>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Sözleşmeler";
    ViewData["UseCentralFeedback"] = true;
    string filtre = ViewBag.Filter ?? "tum";
    bool canEdit = User.HasPermission(PermissionCatalog.Lease.Create);
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var paginationExtra = query.ToQueryDict();
    paginationExtra["filter"] = filtre;
    var pagination = PaginationModel.FromPaged(Model, "/Lease", paginationExtra);
}


<div class="page-header flex flex-wrap items-center justify-between gap-3">
    <div>
        <div class="page-title">Sözleşmeler</div>
        <div class="page-subtitle">@Model.Total kayıt listeleniyor</div>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
        @{
            int borcluSayisi = ViewBag.DebtorCount ?? 0;
        }
        @if (borcluSayisi > 0 && User.HasPermission(PermissionCatalog.Notification.BorcHatirlatma))
        {
            <form asp-controller="ChargeReminder" asp-action="SendDebtorEmails" method="post"
                  data-confirm="@borcluSayisi kiracıya borç hatırlatma e-postası gönderilsin mi?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary flex items-center gap-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    Borçlulara E-posta (@borcluSayisi)
                </button>
            </form>
        }
        @if (canEdit)
        {
            <a href="/Lease/Create" class="btn btn-primary flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Yeni Sözleşme Başvurusu
            </a>
        }
    </div>
</div>

<!-- Filtreler -->
<div class="flex gap-1.5 flex-wrap mb-5">
    @{
        var filters = new[] {
            ("tum",         "Tümü"),
            ("aktif",       "Aktif"),
            ("onaybekliyor", "Onay Bekleyen"),
            ("revizyon",     "Revizyon İstenen"),
            ("surek",       "Dolmak Üzere"),
            ("gecmis",      "Sona Erdi"),
            ("feshedildi",  "Feshedildi")
        };
    }
    @foreach (var (key, label) in filters)
    {
        bool isActive = filtre == key;
        <a href="/Lease?filter=@key&q=@Uri.EscapeDataString(query.Q ?? string.Empty)&size=@query.Size"
           class="btn btn-sm @(isActive ? "btn-primary" : "btn-secondary text-slate-600 bg-white border-slate-200")">@label</a>
    }
</div>

<div class="card p-0 overflow-hidden">
    <form method="get" asp-controller="Lease" asp-action="Index" class="flex items-center gap-3 p-3 bg-slate-50/50 border-b border-slate-200">
        <input type="hidden" name="filter" value="@filtre" />
        <input type="hidden" name="size" value="@query.Size" />
        <input type="search" name="q" value="@query.Q" class="form-control w-full max-w-sm" placeholder="Ara: kiracı, taşınmaz, birim…" />
        <button type="submit" class="btn btn-secondary">Ara</button>
        @if (!string.IsNullOrWhiteSpace(query.Q))
        {
            <a asp-controller="Lease" asp-action="Index" asp-route-filter="@filtre" asp-route-size="@query.Size" class="btn btn-secondary">Temizle</a>
        }
        <span class="ml-auto text-xs text-muted"><strong>@Model.Total</strong> kayıt</span>
    </form>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16">#</th>
                    <th>Kiracı</th>
                    <th>Taşınmaz / Birim</th>
                    <th class="w-28 cell-center">Başlangıç</th>
                    <th class="w-28 cell-center">Bitiş</th>
                    <th class="w-32 num">Aylık Bedel</th>
                    <th class="w-24 cell-center">Kalan</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    bool aktif = s.IsActive;
                    int kalanGun = s.RemainingDays;
                    bool surek = aktif && kalanGun <= 30;
                    bool feshedildi = s.Status == LeaseStatus.Terminated;
                    bool draft = s.Status == LeaseStatus.Draft;
                    bool revisionRequested = s.Status == LeaseStatus.RevisionRequested;
                    string dayBadgeClass = kalanGun <= 10 ? "bg-red-50 text-red-700 border-red-200" : kalanGun <= 30 ? "bg-amber-50 text-amber-700 border-amber-200" : "bg-emerald-50 text-emerald-700 border-emerald-200";
                    string statusSearch = draft ? "onay bekliyor taslak" : revisionRequested ? "revizyon istendi" : string.Empty;
                    var search = $"{s.Id} {s.TenantDisplayName} {s.PropertyName} {s.UnitName} {statusSearch}".ToLower();
                    string rowHref = draft || revisionRequested
                        ? $"/Lease/Draft/{s.Id.ToHashId()}"
                        : $"/Lease/Details/{s.Id.ToHashId()}";

                    <tr data-row data-search="@search" data-href="@rowHref"
                        class="cursor-pointer hover:bg-slate-50 transition-colors"
                        @@click="$el.dataset.href && !$event.target.closest('a,[data-stop]') && (window.location.href = $el.dataset.href)">
                        <td class="text-xs text-muted font-mono">@s.Id</td>
                        <td>
                            <a href="/Tenant/Details/@s.TenantId.ToHashId()" class="font-semibold text-primary hover:underline">@s.TenantDisplayName</a>
                            @if (!string.IsNullOrEmpty(s.TenantCategoryName))
                            {
                                <div class="cell-sub">@s.TenantCategoryName</div>
                            }
                        </td>
                        <td>
                            <a href="/Property/Details/@s.PropertyId.ToHashId()" class="font-medium hover:text-primary transition-colors">@s.PropertyName</a>
                            <span class="cell-sub">@s.UnitName</span>
                        </td>
                        <td class="cell-center">@s.StartDate.Tarih()</td>
                        <td class="cell-center">@s.EndDate.Tarih()</td>
                        <td class="num">@s.MonthlyAmount.Tl()</td>
                        <td class="cell-center">
                            @if (draft)
                            { <span class="px-2 py-0.5 rounded text-[10px] font-bold border bg-amber-50 text-amber-800 border-amber-200">ONAY BEKLİYOR</span> }
                            else if (revisionRequested)
                            { <span class="px-2 py-0.5 rounded text-[10px] font-bold border bg-rose-50 text-rose-800 border-rose-200">REVİZYON İSTENDİ</span> }
                            else if (feshedildi)
                            { <span class="text-muted text-[11px] italic" title="Durum: Feshedildi">Feshedildi</span> }
                            else if (aktif)
                            { <span class="px-2 py-0.5 rounded text-[10px] font-bold border @dayBadgeClass" title="Durum: @(surek ? "Doluyor" : "Aktif")">@kalanGun GÜN</span> }
                            else
                            { <span class="text-muted text-[11px] italic" title="Durum: Sona Erdi">Sona erdi</span> }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center py-12 text-muted italic">Bu filtreye uygun sözleşme bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>

