@model KiraTakip.Models.ViewModels.BirimOzelFiyatViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = $"{Model.BirimAd} — Özel Fiyatlar";
    var subtitle = Model.KiralanabilirMi
        ? ""
        : "Bu birim için özel rezervasyon ücreti kuralı tanımlayın";
}

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 px-4 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 px-4 rounded-lg mb-4 text-[13.5px] font-medium">
        ✗ @TempData["Error"]
    </div>
}

<div class="@(Model.KiralanabilirMi ? "max-w-[1200px]" : "max-w-[600px]") mx-auto">
    <div class="page-header flex items-center justify-between">
        <div>
            <a href="/Tasinmaz/Detay/@Model.TasinmazId.ToHashId()" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
                ← @Model.TasinmazAd
            </a>
            <div class="page-title">@Model.BirimAd — Özel Fiyatlar</div>
            @if (!string.IsNullOrEmpty(subtitle))
            {
                <div class="page-subtitle">@subtitle</div>
            }
        </div>
    </div>

@if (Model.KiralanabilirMi)
{
    <!-- Senaryo A: Kiralanabilir birim — KiraciKategori × BorcTipi matrisi -->
    @if (Model.ParentTarife != null)
    {
        <div class="mb-2.5">
            <div class="text-xs text-muted mb-1">İşaretlenmemiş hücreler için geçerli üst tarife:</div>
            @await Html.PartialAsync("_ParentTarifeKart", Model.ParentTarife)
        </div>
    }

    <form method="post" action="/Birim/@Model.BirimId.ToHashId()/OzelFiyat">
        @Html.AntiForgeryToken()
        <input type="hidden" name="BirimId" value="@Model.BirimId" />
        <input type="hidden" name="TasinmazId" value="@Model.TasinmazId" />

        @if (Model.Satirlar == null || !Model.Satirlar.Any())
        {
            <div class="card p-6 text-center text-muted">
                Aktif kiracı kategorisi veya borç tipi bulunamadı.
            </div>
        }
        else
        {
            <div class="bg-indigo-50 border border-indigo-200 text-indigo-900 p-4 rounded-xl mb-5 flex items-start gap-3 shadow-sm">
                <svg class="text-indigo-600 mt-0.5 flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <div class="text-[13.5px] leading-relaxed">
                    <strong>Bilgi:</strong> İşaretlenen hücreler için tarife yerine bu özel fiyatlar kullanılır. İşaretlenmeyen hücrelerde ise yukarıda listelenen varsayılan üst tarifeler geçerli olmaya devam eder.
                </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 items-start mb-3.5">
                @for (int i = 0; i < Model.Satirlar.Count; i++)
                {
                    var satir = Model.Satirlar[i];
                    <div class="card p-4 fiyat-kategori-blok">
                        <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-slate-100">
                            <span class="text-sm font-bold text-slate-800">@satir.KiraciKategoriAd</span>
                            <button type="button" onclick="topluKdvAta(this, 20)"
                                    class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-white border border-slate-200 rounded px-2.5 py-1 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition-all">
                                KDV %20 Yap
                            </button>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[550px]">
                                <thead>
                                    <tr>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-left border-b border-slate-100">Borç Tipi</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-center border-b border-slate-100 w-10">Aktif</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-center border-b border-slate-100 w-36">Tutar (₺)</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-left border-b border-slate-100 w-24">Yöntem</th>
                                        <th class="text-[10px] font-bold text-slate-400 uppercase tracking-widest pb-2 text-left border-b border-slate-100 w-28">KDV %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                     @for (int j = 0; j < satir.Hucreler.Count; j++)
                                     {
                                         var hucre = satir.Hucreler[j];
                                         var kolon = Model.Kolonlar[j];
                                         var isIlkAy = kolon.ChargeTypeBehavior == ChargeTypeBehavior.FirstMonthOneTime;
                                         var isDepozito = isIlkAy;
                                         <tr data-depozito="@(isDepozito ? "true" : "false")"
                                             x-data="{ aktif: @hucre.OzelFiyatAktif.ToString().ToLower() }"
                                             class="border-t border-slate-50">
                                             <td class="py-2.5 pr-2">
                                                 <input type="hidden" name="Satirlar[@i].Hucreler[@j].KiraciKategoriId" value="@hucre.KiraciKategoriId" />
                                                 <input type="hidden" name="Satirlar[@i].Hucreler[@j].BorcTipiId" value="@hucre.BorcTipiId" />
                                                 <input type="hidden" name="Satirlar[@i].Hucreler[@j].RateId" value="@hucre.RateId" />
                                                 <div class="flex items-center gap-2.5">
                                                     <span :class="aktif ? 'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.4)]' : 'bg-slate-300'"
                                                           class="w-1.5 h-1.5 rounded-full flex-shrink-0 transition-all"></span>
                                                     <div class="overflow-hidden">
                                                         <div class="flex items-center gap-1.5 mb-1">
                                                             <span class="text-[9px] text-slate-400 font-bold uppercase tracking-tight">@kolon.BorcTipiKod</span>
                                                             @if (isIlkAy)
                                                             {
                                                                 <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-100 uppercase">İlk Ay</span>
                                                             }
                                                             else
                                                             {
                                                                 <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-100 uppercase">Aylık</span>
                                                             }
                                                         </div>
                                                         <div class="text-[13px] font-bold text-slate-700 leading-tight truncate">@kolon.BorcTipiAd</div>
                                                     </div>
                                                 </div>
                                             </td>
                                             <td class="text-center py-2.5">
                                                 <input type="checkbox" name="Satirlar[@i].Hucreler[@j].OzelFiyatAktif" value="true"
                                                        @(hucre.OzelFiyatAktif ? "checked" : "")
                                                        class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                                                        x-model="aktif" />
                                             </td>
                                             <td class="text-center py-2.5">
                                                 <div class="flex items-stretch border border-slate-200 rounded-lg overflow-hidden bg-white w-28 mx-auto transition-all" 
                                                      :class="!aktif ? 'opacity-30 grayscale pointer-events-none' : 'focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100'">
                                                     <span class="px-2 bg-slate-50 text-[10px] font-bold text-slate-400 border-r border-slate-200 flex items-center">₺</span>
                                                     <input type="number" step="0.01" min="0"
                                                             class="border-none outline-none p-1.5 px-2 text-xs bg-transparent flex-1 min-w-0 text-center font-bold text-slate-700"
                                                             name="Satirlar[@i].Hucreler[@j].BirimDeger"
                                                             value="@(hucre.OzelFiyatAktif ? hucre.BirimDeger.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                             placeholder="@hucre.VarsayilanBirimDeger.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                             :disabled="!aktif" />
                                                 </div>
                                             </td>
                                             <td class="py-2.5 pr-2">
                                                 @if (isDepozito)
                                                 {
                                                     <input type="hidden" name="Satirlar[@i].Hucreler[@j].CalculationMethod" value="@((int)CalculationMethod.Fixed)" />
                                                     <select class="form-control form-control-sm w-full opacity-30 cursor-not-allowed text-[11px] font-bold uppercase tracking-tighter" disabled>
                                                         <option>Sabit</option>
                                                     </select>
                                                 }
                                                 else
                                                 {
                                                     <select class="form-control form-control-sm w-full text-[11px] font-bold uppercase tracking-tighter transition-all"
                                                             name="Satirlar[@i].Hucreler[@j].CalculationMethod"
                                                             :disabled="!aktif" :class="!aktif ? 'opacity-30 grayscale pointer-events-none' : ''">
                                                         <option value="@((int)CalculationMethod.Fixed)" selected="@(hucre.CalculationMethod == CalculationMethod.Fixed)">Sabit</option>
                                                         <option value="@((int)CalculationMethod.M2)" selected="@(hucre.CalculationMethod == CalculationMethod.M2)">m²</option>
                                                     </select>
                                                 }
                                             </td>
                                             <td class="py-2.5">
                                                 <div class="flex items-stretch border border-slate-200 rounded-lg overflow-hidden bg-white transition-all w-24" 
                                                      :class="!aktif ? 'opacity-30 grayscale pointer-events-none' : 'focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100'">
                                                     <input type="number" step="0.01" min="0" max="100"
                                                             class="border-none outline-none p-1.5 px-2 text-xs bg-transparent w-full min-w-0 text-right font-bold text-slate-700"
                                                             name="Satirlar[@i].Hucreler[@j].KdvOrani"
                                                             value="@(hucre.OzelFiyatAktif ? hucre.KdvOrani.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                             placeholder="@hucre.VarsayilanKdvOrani.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                             :disabled="!aktif" />
                                                     <span class="px-2 bg-slate-50 text-[10px] font-bold text-slate-400 border-l border-slate-200 flex items-center">%</span>
                                                 </div>
                                             </td>
                                         </tr>
                                     }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <div class="flex gap-2 mt-1">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a href="/Tasinmaz/Detay/@Model.TasinmazId.ToHashId()" class="btn btn-secondary">İptal</a>
            </div>
        }
    </form>

    <script>
        function topluKdvAta(btn, value) {
            const blok = btn.closest('.fiyat-kategori-blok');
            blok.querySelectorAll('tr[data-depozito="false"] input[name*="KdvOrani"]').forEach(function(inp) {
                inp.value = value;
            });
        }
    </script>
}
else if (Model.RezervasyonYapilabilirMi)
{
    <!-- Senaryo B: Rezervasyon birimi — RezervasyonTarifeKural formu -->
    @if (Model.ParentRezervasyonTarife != null)
    {
        <div class="mb-3.5">
            <div class="text-xs text-muted mb-1">Tanımlanmamışsa geçerli olan tarife:</div>
            <partial name="_ParentRezervasyonTarifeKart" model="Model.ParentRezervasyonTarife" />
        </div>
    }

    @if (Model.OzelRezervasyonKural == null)
    {
        <form method="post" action="/Birim/@Model.BirimId.ToHashId()/RezKuralKaydet" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="0" />
            @{
                var parentSatir = Model.ParentRezervasyonTarife?.Satirlar
                    .FirstOrDefault(s => s.UnitTypeAd == Model.UnitTypeAd);
                
                int defPeriyot = parentSatir?.UcretlendirmePeriyoduDakika ?? 60;
                int defUcretsiz = parentSatir?.UcretsizSureDakika ?? 0;
                decimal defUcret = parentSatir?.PeriyotUcreti ?? 0;
                decimal defKdv   = parentSatir?.KdvOrani ?? 20;
            }
            <div class="card p-6">
                <div class="text-base font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
                    Özel Kural Tanımla
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Ücretsiz Süre (dk)</label>
                        <input type="number" name="UcretsizSureDakika" value="@defUcretsiz" class="form-control" min="0" max="1440" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ücret Periyodu (dk)</label>
                        <input type="number" name="UcretlendirmePeriyoduDakika" value="@defPeriyot" class="form-control" min="1" max="1440" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Periyot Ücreti (₺)</label>
                        <input type="number" name="PeriyotUcreti" value="@defUcret.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" min="0" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">KDV Oranı (%)</label>
                        <input type="number" name="KdvOrani" value="@defKdv.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" min="0" max="100" step="0.01" />
                    </div>
                </div>

                <div class="form-group mt-2">
                    <label class="form-label">Açıklama</label>
                    <input type="text" name="Aciklama" class="form-control" placeholder="Opsiyonel açıklama..." maxlength="300" />
                </div>

                <input type="hidden" name="Aktif" value="true" />

                <div class="flex items-center gap-3 mt-8">
                    <button type="submit" class="btn btn-primary px-6">Kaydet</button>
                    <a href="/Tasinmaz/Detay/@Model.TasinmazId.ToHashId()" class="btn btn-secondary px-6">İptal</a>
                </div>
            </div>
        </form>
    }
    else
    {
        <form method="post" action="/Birim/@Model.BirimId.ToHashId()/RezKuralKaydet">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.OzelRezervasyonKural.Id" />
            <div class="card p-6">
                <div class="text-base font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
                    Özel Rezervasyon Kuralı
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Ücretsiz Süre (dk)</label>
                        <input type="number" name="UcretsizSureDakika" value="@Model.OzelRezervasyonKural.UcretsizSureDakika" class="form-control" min="0" max="1440" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ücret Periyodu (dk)</label>
                        <input type="number" name="UcretlendirmePeriyoduDakika" value="@Model.OzelRezervasyonKural.UcretlendirmePeriyoduDakika" class="form-control" min="1" max="1440" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Periyot Ücreti (₺)</label>
                        <input type="number" name="PeriyotUcreti" value="@Model.OzelRezervasyonKural.PeriyotUcreti.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" min="0" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">KDV Oranı (%)</label>
                        <input type="number" name="KdvOrani" value="@Model.OzelRezervasyonKural.KdvOrani.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" min="0" max="100" step="0.01" />
                    </div>
                </div>

                <div class="form-group my-2">
                    <label class="flex items-center gap-2.5 cursor-pointer bg-slate-50 p-3 rounded-lg border border-slate-200 hover:border-indigo-300 transition-colors">
                        <input type="checkbox" name="Aktif" value="true" @(Model.OzelRezervasyonKural.IsActive ? "checked" : "") class="w-4.5 h-4.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                        <span class="text-sm font-bold text-slate-700">Kural Aktif</span>
                    </label>
                </div>

                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    <input type="text" name="Aciklama" value="@Model.OzelRezervasyonKural.Aciklama" class="form-control" placeholder="Opsiyonel açıklama..." maxlength="300" />
                </div>

                <div class="flex items-center gap-3 mt-8">
                    <button type="submit" class="btn btn-primary px-6">Kaydet</button>
                    <a href="/Tasinmaz/Detay/@Model.TasinmazId.ToHashId()" class="btn btn-secondary px-6">İptal</a>
                </div>
            </div>
        </form>

        <form method="post" action="/Birim/@Model.BirimId.ToHashId()/RezKuralSifirla" class="mt-4">
            @Html.AntiForgeryToken()
            <button type="submit" class="text-xs font-bold text-red-500 bg-red-50 border border-red-100 rounded-lg px-4 py-2 hover:bg-red-100 transition-all flex items-center gap-2"
                    data-confirm="Özel kural silinecek. Genel tarife devreye girecek. Onaylıyor musunuz?">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                Sıfırla (Genel Tarifeyi Kullan)
            </button>
        </form>
    }
}
else
{
    <!-- Senaryo C: Hibrit — hata kartı -->
    <div class="card border-red-100 bg-red-50/50 p-6 flex flex-col items-center text-center">
        <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="text-base font-bold text-red-800 mb-2">Birim Türü Hatalı Tanımlı</div>
        <p class="text-sm text-red-700/70 leading-relaxed max-w-sm mb-6">
            Bu birim türünde hem <b>Kiralanabilir</b> hem de <b>Rezervasyon</b> yapılabilir işaretli değil veya her ikisi de işaretli. Lütfen yöneticiye bildirin.
        </p>
        <a href="/Tasinmaz/Detay/@Model.TasinmazId.ToHashId()" class="btn btn-secondary px-8">Geri Dön</a>
    </div>
}
</div>

