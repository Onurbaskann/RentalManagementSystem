@model KiraTakip.Models.ViewModels.BirimOzelFiyatViewModel
@{
    ViewData["Title"] = $"{Model.BirimAd} — Özel Fiyatlar";
}

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">
        ✓ @TempData["Success"]
    </div>
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <a href="/Tasinmaz/Detay/@Model.TasinmazId" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
            ← @Model.TasinmazAd
        </a>
        <div class="page-title">@Model.BirimAd — Özel Fiyatlar</div>
        <div class="page-subtitle">İşaretlenen borç tipleri için tarife yerine bu fiyatlar kullanılır</div>
    </div>
</div>

<form method="post" action="/Birim/@Model.BirimId/OzelFiyat">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BirimId" value="@Model.BirimId" />
    <input type="hidden" name="TasinmazId" value="@Model.TasinmazId" />

    <div class="card" style="padding:0;overflow:hidden;margin-bottom:16px;">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width:48px;">Aktif</th>
                        <th style="width:100px;">Kod</th>
                        <th>Borç Tipi</th>
                        <th style="width:160px;">Hesaplama Yöntemi</th>
                        <th style="width:160px;">Birim Değer (₺)</th>
                        <th style="width:130px;">KDV Oranı (%)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Kalemler.Count; i++)
                    {
                        var k = Model.Kalemler[i];
                        <tr x-data="{ aktif: @k.OzelFiyatAktif.ToString().ToLower() }">
                            <td style="text-align:center;">
                                <input type="hidden" name="Kalemler[@i].BorcTipiId" value="@k.BorcTipiId" />
                                <input type="hidden" name="Kalemler[@i].RateId"     value="@k.RateId" />
                                <input type="checkbox" name="Kalemler[@i].OzelFiyatAktif" value="true"
                                       @(k.OzelFiyatAktif ? "checked" : "")
                                       x-model="aktif" />
                            </td>
                            <td><span style="font-family:monospace;font-weight:600;font-size:13px;">@k.BorcTipiKod</span></td>
                            <td style="font-weight:500;">@k.BorcTipiAd</td>
                            <td>
                                <select name="Kalemler[@i].HesaplamaYontemi" class="form-control form-control-sm"
                                        :disabled="!aktif" x-bind:style="!aktif ? 'opacity:.4' : ''">
                                    @if (k.HesaplamaYontemi == KiraTakip.Models.HesaplamaYontemi.Sabit)
                                    {
                                        <option value="1" selected>Sabit</option>
                                        <option value="2">m²</option>
                                    }
                                    else
                                    {
                                        <option value="1">Sabit</option>
                                        <option value="2" selected>m²</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" name="Kalemler[@i].BirimDeger" value="@k.BirimDeger"
                                       class="form-control form-control-sm" step="0.0001" min="0"
                                       :disabled="!aktif" x-bind:style="!aktif ? 'opacity:.4' : ''" />
                            </td>
                            <td>
                                <input type="number" name="Kalemler[@i].KdvOrani" value="@k.KdvOrani"
                                       class="form-control form-control-sm" step="0.01" min="0" max="100"
                                       :disabled="!aktif" x-bind:style="!aktif ? 'opacity:.4' : ''" />
                            </td>
                        </tr>
                    }
                    @if (!Model.Kalemler.Any())
                    {
                        <tr><td colspan="6" style="text-align:center;padding:24px;color:var(--color-muted);">Aktif borç tipi bulunmuyor.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Kalemler.Any())
    {
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Tasinmaz/Detay/@Model.TasinmazId" class="btn btn-secondary">İptal</a>
        </div>
    }
</form>
