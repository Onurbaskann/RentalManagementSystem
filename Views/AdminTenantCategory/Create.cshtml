@model KiraTakip.Models.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Yeni Kiracı Kategorisi";
    ViewData["UseCentralFeedback"] = true;
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div>
        <div class="page-title">Yeni Kiracı Kategorisi</div>
    </div>
</div>

<div class="card">
    <form method="post" action="/Admin/TenantCategory/Create" asp-form-write-permission="@PermissionCatalog.TenantCategory.Create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="Akademisyen" />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Order" type="number" class="form-control w-24" />
            <span asp-validation-for="Order" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.TenantCategory.Create">Kaydet</button>
            <a href="/Admin/TenantCategory" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
</div>
