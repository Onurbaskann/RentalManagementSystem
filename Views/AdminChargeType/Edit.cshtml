@model KiraTakip.Models.ViewModels.ChargeTypeFormViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Borç Tipi Düzenle";
    ViewData["UseCentralFeedback"] = true;
    var sistemKilidi = Model.IsSystem;
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div>
        <div class="page-title">Borç Tipi Düzenle</div>
    </div>
</div>

<div class="card">
    <form method="post" action="/Admin/ChargeType/Edit/@Model.Id.ToHashId()" asp-form-write-permission="@PermissionCatalog.ChargeType.Edit">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="IsSystem" type="hidden" />

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Davranış <span class="text-red-500">*</span></label>
            @if (sistemKilidi)
            {
                <input asp-for="Behavior" type="hidden" />
                <select class="form-control bg-slate-100 text-slate-500" disabled>
                    <option value="@((int)ChargeTypeBehavior.MonthlyFixed)" selected="@(Model.Behavior == ChargeTypeBehavior.MonthlyFixed)">Aylık Sabit — Her ay tahakkuka eklenir</option>
                    <option value="@((int)ChargeTypeBehavior.FirstMonthOneTime)" selected="@(Model.Behavior == ChargeTypeBehavior.FirstMonthOneTime)">İlk Ay Tek Seferlik — Sadece sözleşmenin ilk ayında eklenir (ör. depozito)</option>
                    <option value="@((int)ChargeTypeBehavior.UserManual)" selected="@(Model.Behavior == ChargeTypeBehavior.UserManual)">Kullanıcı Manuel — Kullanıcı tarafından manuel eklenir</option>
                    <option value="@((int)ChargeTypeBehavior.ReservationSpecific)" selected="@(Model.Behavior == ChargeTypeBehavior.ReservationSpecific)">Rezervasyon Özel — Yalnızca rezervasyon akışı tarafından oluşturulur</option>
                </select>
                <div class="text-xs text-muted mt-1">🔒 Sistem kaydı — davranış değiştirilemez.</div>
            }
            else
            {
                <select asp-for="Behavior" class="form-control">
                    <option value="@((int)ChargeTypeBehavior.MonthlyFixed)">Aylık Sabit — Her ay tahakkuka eklenir</option>
                    <option value="@((int)ChargeTypeBehavior.FirstMonthOneTime)">İlk Ay Tek Seferlik — Sadece sözleşmenin ilk ayında eklenir (ör. depozito)</option>
                    <option value="@((int)ChargeTypeBehavior.UserManual)">Kullanıcı Manuel — Kullanıcı tarafından manuel eklenir</option>
                    <option value="@((int)ChargeTypeBehavior.ReservationSpecific)">Rezervasyon Özel — Yalnızca rezervasyon akışı tarafından oluşturulur</option>
                </select>
                <div class="text-xs text-muted mt-1">Borç kaleminin tahakkuklarda nasıl oluşturulacağını belirler.</div>
                <span asp-validation-for="Behavior" class="text-red-500 text-xs mt-1"></span>
            }
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="SortOrder" type="number" class="form-control w-24" min="1" />
            <div class="text-xs text-muted mt-1">Arayüz listeleri, fiyat matrisi kolonları ve fatura kalemlerindeki sıralama düzenini belirler.</div>
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.ChargeType.Edit">Kaydet</button>
            <a href="/Admin/ChargeType" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

