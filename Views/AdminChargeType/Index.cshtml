@model List<KiraTakip.Models.Dtos.ChargeTypeListItemDto>
@using KiraTakip.Models
@{
    ViewData["Title"] = "Borç Tipleri";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Borç Tipleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    <a href="/Admin/ChargeType/Create" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Borç Tipi
    </a>
</div>

<div x-data="chargeTypeFilter()" class="mb-3">
    <div class="flex flex-wrap gap-2">
        <button @@click="filter=''" :class="filter==='' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Tümü</button>
        <button @@click="filter='MonthlyFixed'" :class="filter==='MonthlyFixed' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Aylık Sabit</button>
        <button @@click="filter='FirstMonthOneTime'" :class="filter==='FirstMonthOneTime' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">İlk Ay Tek Seferlik</button>
        <button @@click="filter='UserManual'" :class="filter==='UserManual' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Kullanıcı Manuel</button>
        <button @@click="filter='ReservationSpecific'" :class="filter==='ReservationSpecific' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Rezervasyon Özel</button>
    </div>

    <div class="card p-0 overflow-hidden mt-3">
        <div class="table-wrapper">
            <table class="w-full">
                <thead>
                    <tr>
                        <th class="w-20 text-center">Sıra</th>
                        <th>Ad</th>
                        <th class="w-40">Davranış</th>
                        <th class="w-24">Durum</th>
                        <th class="w-48"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bt in Model)
                    {
                        var behaviorKey = bt.Behavior.ToString();
                        var (behaviorLabel, behaviorColorClass) = bt.Behavior switch
                        {
                            ChargeTypeBehavior.MonthlyFixed        => ("Aylık Sabit",         "text-blue-700"),
                            ChargeTypeBehavior.FirstMonthOneTime  => ("İlk Ay Tek Seferlik", "text-purple-700"),
                            ChargeTypeBehavior.UserManual   => ("Kullanıcı Manuel",    "text-amber-700"),
                            ChargeTypeBehavior.ReservationSpecific   => ("Rezervasyon Özel",    "text-teal-700"),
                            _                                   => (bt.Behavior.ToString(), "text-slate-700")
                        };
                        <tr x-show="filter==='' || filter==='@behaviorKey'" x-cloak>
                            <td class="text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <form method="post" action="/Admin/ChargeType/ChangeSortOrder/@bt.Id.ToHashId()" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="newSortOrder" value="@(bt.SortOrder - 1)" />
                                        <button type="submit" class="btn btn-sm btn-secondary px-1.5 py-0.5 text-[10px] leading-tight" title="Yukarı taşı" @(bt.SortOrder <= 1 ? "disabled" : "")>▲</button>
                                    </form>
                                    <span class="text-muted text-xs min-w-[1.25rem] text-center">@bt.SortOrder</span>
                                    <form method="post" action="/Admin/ChargeType/ChangeSortOrder/@bt.Id.ToHashId()" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="newSortOrder" value="@(bt.SortOrder + 1)" />
                                        <button type="submit" class="btn btn-sm btn-secondary px-1.5 py-0.5 text-[10px] leading-tight" title="Aşağı taşı">▼</button>
                                    </form>
                                </div>
                            </td>
                            <td class="font-medium text-slate-700">
                                @bt.Name
                                @if (bt.IsSystem)
                                {
                                    <span class="ml-1.5 text-[9px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded align-middle" title="Sistem kaydı: kod ve pasifleştirme kilitli">Sistem</span>
                                }
                            </td>
                            <td>
                                <span class="text-xs font-bold @behaviorColorClass">@behaviorLabel</span>
                            </td>
                            <td>
                                @if (bt.IsActive)
                                { <span class="badge badge-kirali">Aktif</span> }
                                else
                                { <span class="badge badge-gecmis">Pasif</span> }
                            </td>
                            <td class="flex gap-1.5 justify-end">
                                <a href="/Admin/ChargeType/Edit/@bt.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                                @if (!bt.IsSystem)
                                {
                                    <form method="post" action="/Admin/ChargeType/ToggleStatus/@bt.Id.ToHashId()"
                                          data-confirm="@(bt.IsActive ? $"'{bt.Name}' pasif yapılsın mı?" : $"'{bt.Name}' aktif yapılsın mı?")"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(bt.IsActive ? "btn-danger" : "btn-amber")">
                                            @(bt.IsActive ? "Pasif Yap" : "Aktif Yap")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs text-muted px-2 py-1" title="Sistem kayıtları pasifleştirilemez">🔒</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-8 text-muted">Henüz borç tipi tanımlanmamış.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function chargeTypeFilter() {
            return { filter: '' };
        }
    </script>
}

