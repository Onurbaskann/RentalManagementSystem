@model List<KiraTakip.Models.Dtos.BorcTipiListItemDto>
@using KiraTakip.Models
@{
    ViewData["Title"] = "Borç Tipleri";
}

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✕ @TempData["Error"]
    </div>
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Borç Tipleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    <a href="/Admin/ChargeType/Ekle" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Borç Tipi
    </a>
</div>

<div x-data="borcTipiFilter()" class="mb-3">
    <div class="flex flex-wrap gap-2">
        <button @@click="filtre=''" :class="filtre==='' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Tümü</button>
        <button @@click="filtre='AylikSabit'" :class="filtre==='AylikSabit' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Aylık Sabit</button>
        <button @@click="filtre='IlkAyTekSeferlik'" :class="filtre==='IlkAyTekSeferlik' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">İlk Ay Tek Seferlik</button>
        <button @@click="filtre='KullaniciManuel'" :class="filtre==='KullaniciManuel' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Kullanıcı Manuel</button>
        <button @@click="filtre='RezervasyonOzel'" :class="filtre==='RezervasyonOzel' ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'">Reservation Özel</button>
    </div>

    <div class="card p-0 overflow-hidden mt-3">
        <div class="table-wrapper">
            <table class="w-full">
                <thead>
                    <tr>
                        <th class="w-20 text-center">Sıra</th>
                        <th>Ad</th>
                        <th class="w-40">Davranış</th>
                        <th class="w-24">Durum</th>
                        <th class="w-48"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bt in Model)
                    {
                        var davranisKey = bt.Davranis.ToString();
                        var (davranisLabel, davranisColorClass) = bt.Davranis switch
                        {
                            ChargeTypeBehavior.MonthlyFixed        => ("Aylık Sabit",         "text-blue-700"),
                            ChargeTypeBehavior.FirstMonthOneTime  => ("İlk Ay Tek Seferlik", "text-purple-700"),
                            ChargeTypeBehavior.UserManual   => ("Kullanıcı Manuel",    "text-amber-700"),
                            ChargeTypeBehavior.ReservationSpecific   => ("Reservation Özel",    "text-teal-700"),
                            _                                   => (bt.Davranis.ToString(), "text-slate-700")
                        };
                        <tr x-show="filtre==='' || filtre==='@davranisKey'" x-cloak>
                            <td class="text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <form method="post" action="/Admin/ChargeType/SiraDegistir/@bt.Id.ToHashId()" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="yeniSira" value="@(bt.Sira - 1)" />
                                        <button type="submit" class="btn btn-sm btn-secondary px-1.5 py-0.5 text-[10px] leading-tight" title="Yukarı taşı" @(bt.Sira <= 1 ? "disabled" : "")>▲</button>
                                    </form>
                                    <span class="text-muted text-xs min-w-[1.25rem] text-center">@bt.Sira</span>
                                    <form method="post" action="/Admin/ChargeType/SiraDegistir/@bt.Id.ToHashId()" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="yeniSira" value="@(bt.Sira + 1)" />
                                        <button type="submit" class="btn btn-sm btn-secondary px-1.5 py-0.5 text-[10px] leading-tight" title="Aşağı taşı">▼</button>
                                    </form>
                                </div>
                            </td>
                            <td class="font-medium text-slate-700">
                                @bt.Ad
                                @if (bt.Sistem)
                                {
                                    <span class="ml-1.5 text-[9px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded align-middle" title="Sistem kaydı: kod ve pasifleştirme kilitli">Sistem</span>
                                }
                            </td>
                            <td>
                                <span class="text-xs font-bold @davranisColorClass">@davranisLabel</span>
                            </td>
                            <td>
                                @if (bt.Aktif)
                                { <span class="badge badge-kirali">Aktif</span> }
                                else
                                { <span class="badge badge-gecmis">Pasif</span> }
                            </td>
                            <td class="flex gap-1.5 justify-end">
                                <a href="/Admin/ChargeType/Duzenle/@bt.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                                @if (!bt.Sistem)
                                {
                                    <form method="post" action="/Admin/ChargeType/DurumDegistir/@bt.Id.ToHashId()"
                                          data-confirm="@(bt.Aktif ? $"'{bt.Ad}' pasif yapılsın mı?" : $"'{bt.Ad}' aktif yapılsın mı?")"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(bt.Aktif ? "btn-danger" : "btn-amber")">
                                            @(bt.Aktif ? "Pasif Yap" : "Aktif Yap")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs text-muted px-2 py-1" title="Sistem kayıtları pasifleştirilemez">🔒</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-8 text-muted">Henüz borç tipi tanımlanmamış.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function borcTipiFilter() {
            return { filtre: '' };
        }
    </script>
}

