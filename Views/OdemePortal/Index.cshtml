@model KiraTakip.Models.ViewModels.KiraciOdemePortalViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Ödeme Portalı";
    ViewData["WideLayout"] = true;

    var trCulture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var amountDict = string.Join(",", Model.Borclar.Select(b => $"{b.TahakkukId}: '{b.KalanTutar.ToString("N2", trCulture)}'"));
}

<div class="portal-card max-w-none shadow-xl border-0 overflow-hidden flex-1 min-h-0 flex bg-white rounded-2xl"
     x-data="{ selected: @Model.DefaultSelectedId, amounts: { @Html.Raw(amountDict) } }">
    <div class="grid lg:grid-cols-2 w-full min-h-0">
        <!-- Left Panel: Payment Form (UI Only) -->
        <div class="p-6 lg:p-8 bg-white flex flex-col overflow-y-auto min-h-0">
            <div class="mb-6 shrink-0">
                <div class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1">KiraTakip Güvenli Ödeme</div>
                <h1 class="text-xl font-bold text-slate-800">Kart Bilgileri</h1>
            </div>

            <div class="space-y-4 shrink-0">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Kart Üzerindeki İsim</label>
                    <input type="text" class="form-control w-full bg-slate-50 border-slate-200 focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors" placeholder="Ad Soyad" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Kart Numarası</label>
                    <div class="relative">
                        <input type="text" maxlength="19" class="form-control w-full bg-slate-50 border-slate-200 pl-10 font-mono tracking-wider focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors" placeholder="0000 0000 0000 0000" />
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Son Kullanma</label>
                        <input type="text" maxlength="5" class="form-control w-full bg-slate-50 border-slate-200 font-mono tracking-wider focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors" placeholder="AA/YY" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">CVV</label>
                        <input type="text" inputmode="numeric" maxlength="4" autocomplete="off" class="form-control w-full bg-slate-50 border-slate-200 font-mono tracking-wider focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-colors" placeholder="123" />
                    </div>
                </div>
            </div>

            <div class="mt-auto pt-6 shrink-0">
                <div class="rounded-xl bg-gradient-to-r from-slate-50 to-blue-50/40 border border-slate-200/70 px-5 py-4 mb-4">
                    <div class="flex items-end justify-between">
                        <div>
                            <div class="text-[11px] text-slate-500 font-semibold uppercase tracking-wider">Toplam Ödenecek</div>
                            <div class="text-[10px] text-slate-400 mt-0.5">Seçili tahakkuk için</div>
                        </div>
                        <div class="text-2xl font-bold text-slate-800"><span x-text="amounts[String(selected)] || '0,00'"></span> <span class="text-base text-slate-500 font-semibold">₺</span></div>
                    </div>
                </div>

                <div title="Online ödeme yakında aktif olacak. Ödemeniz için lütfen yönetiminizle iletişime geçin." class="cursor-not-allowed">
                    <button type="button" disabled class="w-full btn py-3.5 text-sm font-bold text-white rounded-xl bg-gradient-to-r from-blue-600 to-blue-500 shadow-lg shadow-blue-500/25 disabled:opacity-60 disabled:cursor-not-allowed pointer-events-none flex justify-center items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Ödemeyi Tamamla
                    </button>
                </div>
                <div class="mt-3 flex items-start gap-2 text-[11px] text-slate-500 leading-relaxed">
                    <svg class="shrink-0 text-slate-400 mt-0.5" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>Ödeme altyapısı entegrasyonu devam etmektedir. Şimdilik sadece borçlarınızı görüntüleyebilirsiniz.</span>
                </div>
            </div>
        </div>

        <!-- Right Panel: Debt Selection -->
        <div class="p-6 lg:p-8 bg-slate-50 lg:border-l border-slate-200/60 flex flex-col min-h-0">
            <div class="mb-4 shrink-0">
                <div class="text-base font-bold text-slate-800 mb-0.5">Sayın @Model.Ad @Model.Soyad</div>
                <div class="text-xs text-slate-500">Lütfen ödemek istediğiniz tahakkuku seçin.</div>
            </div>

            <div class="space-y-3 overflow-y-auto overflow-x-hidden pr-4 pt-3 pb-3 min-h-0 flex-1">
                @foreach (var b in Model.Borclar)
                {
                    bool isOverdue = b.VadeTarihi < DateTime.Today;
                    bool isPartiallyPaid = b.OdenenTutar > 0;

                    <div role="button" tabindex="0" class="block relative p-4 rounded-xl border-2 transition-all cursor-pointer focus:outline-none"
                         @@click="selected = @b.TahakkukId"
                         @@keydown.enter.prevent="selected = @b.TahakkukId"
                         @@keydown.space.prevent="selected = @b.TahakkukId"
                         :class="selected === @b.TahakkukId ? 'border-blue-500 bg-blue-50/50 shadow-md shadow-blue-500/10' : 'border-slate-200 bg-white hover:border-slate-300'">

                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <div class="font-semibold text-slate-800 text-sm">@b.TasinmazAdi / @b.BirimAdi</div>
                                <div class="text-[11px] text-slate-500 font-medium">@b.DonemBaslangic.ToString("MMMM yyyy") Dönemi</div>
                            </div>
                            <div class="text-right">
                                <div class="font-bold text-base text-slate-800">@b.KalanTutar.ToString("N2") ₺</div>
                                @if (isPartiallyPaid)
                                {
                                    <div class="text-[10px] text-slate-400 font-medium">(Kalan)</div>
                                }
                            </div>
                        </div>

                        <div class="flex items-center justify-between mt-3">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold border @(isOverdue ? "bg-red-50 text-red-600 border-red-200" : "bg-slate-100 text-slate-600 border-slate-200")">
                                    VADE: @b.VadeTarihi.ToString("dd.MM.yyyy")
                                </span>
                                @if (isOverdue)
                                {
                                    <span class="text-[10px] font-bold text-red-600 tracking-wide uppercase">Gecikmiş</span>
                                }
                            </div>

                            @if (isPartiallyPaid)
                            {
                                <div class="text-[10px] text-slate-500">
                                    Toplam: @b.ToplamTutar.ToString("N0") ₺ • Ödenen: <span class="text-emerald-600 font-semibold">@b.OdenenTutar.ToString("N0") ₺</span>
                                </div>
                            }
                        </div>

                        <div class="absolute -right-2 -top-2 w-6 h-6 bg-blue-500 text-white rounded-full flex items-center justify-center shadow-sm transition-transform scale-0"
                             :class="selected === @b.TahakkukId ? 'scale-100' : 'scale-0'">
                             <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
