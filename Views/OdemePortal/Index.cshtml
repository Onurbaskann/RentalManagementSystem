@model KiraTakip.Models.ViewModels.OdemePortalViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Ödeme";
}

<div class="portal-card">
    <div class="portal-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
            <line x1="1" y1="10" x2="23" y2="10"/>
        </svg>
        <span>Ödeme Bilgisi</span>
    </div>
    <div class="portal-body">
        <div style="margin-bottom:20px;">
            <div style="font-size:13px;color:#64748b;">Sayın</div>
            <div style="font-size:18px;font-weight:700;">@Model.KiraciAdi</div>
        </div>

        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px 20px;margin-bottom:20px;">
            <div class="row">
                <span class="label">Taşınmaz / Birim</span>
                <span class="value">@Model.TasinmazAdi / @Model.BirimAdi</span>
            </div>
            <div class="row">
                <span class="label">Dönem Başlangıcı</span>
                <span class="value">@Model.DonemBaslangic.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="row">
                <span class="label">Son Ödeme Tarihi</span>
                <span class="value" style="color:#dc2626;">@Model.VadeTarihi.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="row">
                <span class="label">Toplam Tutar</span>
                <span class="value">@Model.ToplamTutar.ToString("N2") ₺</span>
            </div>
            @if (Model.OdenenTutar > 0)
            {
                <div class="row">
                    <span class="label">Ödenen</span>
                    <span class="value" style="color:#16a34a;">@Model.OdenenTutar.ToString("N2") ₺</span>
                </div>
            }
            <div class="row" style="margin-top:6px;">
                <span class="label" style="font-weight:600;">Kalan Tutar</span>
                <span class="amount">@Model.KalanTutar.ToString("N2") ₺</span>
            </div>
        </div>

        <div class="badge-info">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Online ödeme yakında aktif olacak. Ödemeniz için lütfen yönetiminizle iletişime geçin.
        </div>
    </div>
    <div class="portal-footer">
        Bu sayfa yalnızca bilgilendirme amaçlıdır.
    </div>
</div>
