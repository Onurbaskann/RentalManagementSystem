@model string
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Geçersiz Link";
}

<div class="bg-white rounded-2xl shadow-xl border border-slate-200/60 overflow-hidden">
    <div class="px-8 py-10 text-center">
        <div class="mx-auto w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mb-5">
            <svg class="text-red-500" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>
        <h1 class="text-xl font-bold text-slate-800 mb-2">Bağlantı doğrulanamadı</h1>
        <p class="text-sm text-slate-600 leading-relaxed mb-1">
            @(Model ?? "Bu ödeme linki geçerli değil.")
        </p>
        <p class="text-sm text-slate-500 leading-relaxed">
            Link süresi dolmuş veya değiştirilmiş olabilir.
        </p>
    </div>
    <div class="px-8 py-4 bg-slate-50 border-t border-slate-100 text-center">
        <span class="text-xs text-slate-500">Yeni bir ödeme linki için lütfen yönetiminizle iletişime geçin.</span>
    </div>
</div>

