@model KiraTakip.Models.TasinmazTipi
@{
    ViewData["Title"] = "Yeni Taşınmaz Tipi";
    var secili = (int[])(ViewBag.SeciliKiralamaSekilleri ?? new int[] { (int)KiraTakip.Models.KiralamaSekli.TekParca });
}

<div class="page-header">
    <div class="page-title">Yeni Taşınmaz Tipi</div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:20px;max-width:480px;">
        <ul style="margin:0;padding-left:20px;font-size:13px;">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@e.ErrorMessage</li> }
        </ul>
    </div>
}

<div class="card" style="max-width:480px;">
    <form method="post" action="/Admin/TasinmazTipi/Ekle">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Ad <span style="color:red">*</span></label>
            <input asp-for="Ad" class="form-control" placeholder="Bina" />
            <span asp-validation-for="Ad" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Kod <span style="color:red">*</span></label>
            <input asp-for="Kod" class="form-control" placeholder="BINA" style="font-family:monospace;text-transform:uppercase;" maxlength="20" />
            <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Kısa tanımlayıcı (büyük harf, boşluksuz). Ör: BINA, ARAZI, OTOMAT</div>
            <span asp-validation-for="Kod" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="form-group">
            <label class="form-label">İzinli Kiralama Şekilleri <span style="color:red">*</span></label>
            <div style="display:flex;flex-direction:column;gap:8px;padding:10px 12px;border:1px solid var(--color-border);border-radius:8px;background:#fafbfc;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;">
                    <input type="checkbox" name="kiralamaSekilleri" value="@((int)KiraTakip.Models.KiralamaSekli.TekParca)" @(secili.Contains((int)KiraTakip.Models.KiralamaSekli.TekParca) ? "checked" : "") />
                    <span>Tek Parça</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;">
                    <input type="checkbox" name="kiralamaSekilleri" value="@((int)KiraTakip.Models.KiralamaSekli.BirimBazli)" @(secili.Contains((int)KiraTakip.Models.KiralamaSekli.BirimBazli) ? "checked" : "") />
                    <span>Birim Bazlı</span>
                </label>
            </div>
            <div style="font-size:12px;color:var(--color-muted);margin-top:4px;">Bu tipte taşınmaz oluşturulurken kullanılabilecek kiralama şekilleri.</div>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Sira" type="number" class="form-control" min="1" style="width:100px;" />
        </div>

        <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                <input asp-for="Aktif" type="checkbox" />
                <span class="form-label" style="margin:0;">Aktif</span>
            </label>
        </div>

        <div style="display:flex;gap:8px;margin-top:8px;">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Admin/TasinmazTipi" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
