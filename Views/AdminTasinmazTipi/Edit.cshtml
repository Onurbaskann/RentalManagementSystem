@model KiraTakip.Models.ViewModels.TasinmazTipiFormViewModel
@{
    ViewData["Title"] = "Taşınmaz Tipi Düzenle";
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div class="page-title">Taşınmaz Tipi Düzenle</div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-5 max-w-[480px]">
        <ul class="list-disc pl-5 m-0 text-[13px]">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@e.ErrorMessage</li> }
        </ul>
    </div>
}

<div class="card">
    <form method="post" action="/Admin/TasinmazTipi/Duzenle/@Model.Id.ToHashId()" asp-form-write-permission="@PermissionCatalog.PropertyType.Edit">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Ad" class="form-control" />
            <span asp-validation-for="Ad" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">İzinli Kiralama Şekilleri <span class="text-red-500">*</span></label>
            <div class="flex flex-col gap-2 p-3 border border-[var(--color-border)] rounded-lg bg-slate-50/50">
                <label class="flex items-center gap-2 cursor-pointer text-[13.5px]">
                    <input asp-for="TekParcaDestekli" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span>Tek Parça</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-[13.5px]">
                    <input asp-for="BirimBazliDestekli" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span>Unit Bazlı</span>
                </label>
            </div>
            <div class="text-xs text-muted mt-1">Bu tipte taşınmaz oluşturulurken kullanılabilecek kiralama şekilleri.</div>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Sira" type="number" class="form-control w-24" min="1" />
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="Aktif" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.PropertyType.Edit">Kaydet</button>
            <a href="/Admin/TasinmazTipi" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

