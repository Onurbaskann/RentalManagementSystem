@model List<KiraTakip.Models.Dtos.KategoriListItemDto>
@{
    ViewData["Title"] = "Taşınmaz Tipleri";
}

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✕ @TempData["Error"]
    </div>
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Taşınmaz Tipleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    <a href="/Admin/TasinmazTipi/Ekle" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Taşınmaz Tipi
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th class="w-32">Kod</th>
                    <th>Ad</th>
                    <th class="w-56">Kiralama Şekilleri</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tt in Model)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@tt.Sira</td>
                        <td><span class="font-mono font-semibold text-[13px]">@tt.Kod</span></td>
                        <td class="font-medium text-slate-700">@tt.Ad</td>
                        <td>
                            @if (!tt.TekParcaDestekli && !tt.BirimBazliDestekli)
                            {
                                <span class="text-muted text-xs">—</span>
                            }
                            else
                            {
                                <div class="flex gap-1.5 flex-wrap">
                                    @if (tt.TekParcaDestekli) { <span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full text-[10px] font-bold">Tek Parça</span> }
                                    @if (tt.BirimBazliDestekli) { <span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full text-[10px] font-bold">Birim Bazlı</span> }
                                </div>
                            }
                        </td>
                        <td>
                            @if (tt.Aktif)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/TasinmazTipi/Duzenle/@tt.Id" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/TasinmazTipi/DurumDegistir/@tt.Id"
                                  data-confirm="@(tt.Aktif ? $"'{tt.Ad}' pasif yapılsın mı?" : $"'{tt.Ad}' aktif yapılsın mı?")"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(tt.Aktif ? "btn-danger" : "btn-amber")">
                                    @(tt.Aktif ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-8 text-muted">Henüz taşınmaz tipi tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
