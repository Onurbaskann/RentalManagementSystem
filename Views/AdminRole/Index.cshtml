@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.RoleListItemDto>
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Rol Yönetimi";
    ViewData["UseCentralFeedback"] = true;
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var pagination = PaginationModel.FromPaged(Model, "/Admin/Roles", query.ToQueryDict());
}


<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Rol Yönetimi</div>
        <div class="page-subtitle">@Model.Total rol tanımlı</div>
    </div>
    <a href="/Admin/Roles/Create" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Rol
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Rol Adı</th>
                    <th>Açıklama</th>
                    <th>Kullanıcılar</th>
                    <th>İzinler</th>
                    <th>Tür</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td class="font-semibold">@r.Name</td>
                        <td class="text-sm text-muted">@(r.Description ?? "—")</td>
                        <td class="text-sm">@r.UserCount kullanıcı</td>
                        <td class="text-sm">
                            @if (r.Name == "Admin")
                            { <span class="text-muted text-xs">Tümü (otomatik)</span> }
                            else
                            { <span>@r.PermissionCount izin</span> }
                        </td>
                        <td>
                            @if (r.IsSystemRole)
                            { <span class="badge badge-kurumsal">Sistem</span> }
                            else
                            { <span class="badge badge-bos">Özel</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/Roles/Edit/@r.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            @if (!r.IsSystemRole)
                            {
                                <form method="post" action="/Admin/Roles/Delete/@r.Id.ToHashId()"
                                      data-confirm="'@r.Name' rolünü silmek istediğinizden emin misiniz?" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
