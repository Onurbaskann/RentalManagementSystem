@model KiraTakip.Models.ViewModels.TenantUserListViewModel
@using KiraTakip.Infrastructure.Hashids
@using KiraTakip.Models.Common
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Kullanıcılar";
    ViewData["UseCentralFeedback"] = true;
    var controllerName = nameof(KiraTakip.Controllers.TenantUserController).Replace("Controller", "");
    var pagination = PaginationModel.FromPaged(Model.Users, "/Tenant/Users", Model.Query.ToQueryDict());
}


<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Kullanıcılar</div>
        <div class="page-subtitle">@Model.Users.Total kayıtlı kullanıcı</div>
    </div>
    @if (Model.CanInvite)
    {
        <a asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.Invite)" class="btn btn-primary">Davet Gönder</a>
    }
</div>

<div class="card p-0 overflow-hidden">
    <form method="get" asp-controller="@controllerName" asp-action="Index" class="table-toolbar">
        <input type="hidden" name="size" value="@Model.Query.Size" />
        <input type="search" name="q" value="@Model.Query.Q" class="form-control toolbar-search" placeholder="Ara: ad, e-posta, rol…" />
        <button type="submit" class="btn btn-secondary">Ara</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query.Q))
        {
            <a asp-controller="@controllerName" asp-action="Index" asp-route-size="@Model.Query.Size" class="btn btn-secondary">Temizle</a>
        }
        <span class="pagination-info ml-auto"><strong>@Model.Users.Total</strong> kayıt</span>
    </form>
    <div class="table-wrapper">
        <table>
            <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Rol</th><th>Durum</th><th></th></tr></thead>
            <tbody>
            @foreach (var user in Model.Users.Items)
            {
                <tr>
                    <td class="font-semibold">@user.FullName @if (user.IsCurrentUser) { <span class="text-xs text-muted ml-1">(siz)</span> }</td>
                    <td class="text-sm text-muted">@user.Email</td>
                    <td><span class="badge badge-bos">@user.RoleName</span></td>
                    <td>@if (user.IsActive) { <span class="badge badge-kirali">Aktif</span> } else { <span class="badge badge-gecmis">Pasif</span> }</td>
                    <td class="flex gap-1.5 justify-end">
                    @if (!user.IsCurrentUser)
                    {
                        @if (Model.CanEdit)
                        {
                            <a asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.Edit)" asp-route-id="@user.Id" class="btn btn-sm btn-secondary">Düzenle</a>
                        }
                        @if (Model.CanDeactivate)
                        {
                            <form method="post" asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.ToggleStatus)" asp-route-id="@user.Id"
                                  data-confirm="@(user.IsActive ? "Kullanıcı pasif yapılsın mı?" : "Kullanıcı aktif yapılsın mı?")" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-danger" : "btn-amber")">@(user.IsActive ? "Pasif Yap" : "Aktif Yap")</button>
                            </form>
                        }
                    }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Users.Items.Any())
    {
        <div class="p-8 text-center text-slate-400 font-medium">Aramaya uyan kullanıcı bulunamadı.</div>
    }
    @await Html.PartialAsync("_Pagination", pagination)
</div>

@if (Model.PendingInvitations.Any())
{
    <div class="mt-6">
        <div class="page-header"><div class="page-title text-base">Bekleyen Davetler</div></div>
        <div class="card p-0 overflow-hidden"><div class="table-wrapper"><table>
            <thead><tr><th>E-posta</th><th>Ad Soyad</th><th>Rol</th><th>Gönderilme</th><th>Son Tarih</th><th></th></tr></thead>
            <tbody>
            @foreach (var invitation in Model.PendingInvitations)
            {
                <tr>
                    <td>@invitation.Email</td>
                    <td class="text-sm text-muted">@(invitation.FullName ?? "—")</td>
                    <td><span class="badge badge-bos">@invitation.RoleName</span></td>
                    <td class="text-sm text-muted">@invitation.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-sm @(invitation.ExpiresAt < DateTime.UtcNow.AddDays(1) ? "text-red-600" : "text-muted")">@invitation.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="flex gap-1.5 justify-end">
                    @if (Model.CanInvite)
                    {
                        <form method="post" asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.ResendInvite)" asp-route-id="@invitation.Id.ToHashId()" class="inline">
                            @Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-secondary">Yeniden Gönder</button>
                        </form>
                        <form method="post" asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.CancelInvite)" asp-route-id="@invitation.Id.ToHashId()" data-confirm="Bu daveti iptal etmek istediğinizden emin misiniz?" class="inline">
                            @Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-danger">İptal</button>
                        </form>
                    }
                    </td>
                </tr>
            }
            </tbody>
        </table></div></div>
    </div>
}
