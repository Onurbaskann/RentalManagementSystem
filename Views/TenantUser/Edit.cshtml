@model KiraTakip.Models.ViewModels.TenantUserEditViewModel
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Kullanıcı Düzenle";
    ViewData["UseCentralFeedback"] = true;
    var controllerName = nameof(KiraTakip.Controllers.TenantUserController).Replace("Controller", "");
}
<div class="page-header"><div><a asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.Index)" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">← Kullanıcılar</a><div class="page-title">Kullanıcı Düzenle</div><div class="page-subtitle">@Model.Email</div></div></div>
<div class="card">
<form method="post" asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.Edit)" asp-route-id="@Model.Id" asp-form-write-permission="@PermissionCatalog.TenantPortal.System.User.Edit">
    @Html.AntiForgeryToken()<input type="hidden" asp-for="Id" />

    <div class="form-group"><label class="form-label">E-posta</label><div class="form-control bg-slate-50 text-muted cursor-default">@Model.Email</div><input type="hidden" asp-for="Email" /></div>
    <div class="form-group"><label class="form-label">Ad Soyad</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="form-error"></span></div>
    <div class="form-group"><label class="form-label">Rol</label><select asp-for="RoleId" class="form-control"><option value="0">— Seçin —</option>@foreach (var role in Model.Roles) { <option value="@role.Id">@role.Name</option> }</select><span asp-validation-for="RoleId" class="form-error"></span></div>
    <div class="flex gap-2.5 mt-6"><button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.TenantPortal.System.User.Edit">Kaydet</button><a asp-controller="@controllerName" asp-action="@nameof(KiraTakip.Controllers.TenantUserController.Index)" class="btn btn-secondary px-6">İptal</a></div>
</form>
</div>