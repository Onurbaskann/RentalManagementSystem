@model KiraTakip.Models.ViewModels.TasinmazFiyatMatrisiViewModel
@{
    ViewData["Title"] = $"{Model.TasinmazAd} - Parametreler";
    var currentPage = ViewBag.Page ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
}


<div class="card p-0 overflow-hidden">
    <div class="flex items-center justify-between p-4 bg-slate-50 border-b border-slate-200">
        <div>
            <div class="text-lg font-bold text-slate-800">@Model.TasinmazAd — Fiyat Parametreleri</div>
            <div class="text-xs text-muted font-medium mt-0.5">Salt-okunur parametre matrisi</div>
        </div>
        <div class="text-[11px] text-slate-400 bg-white border border-slate-200 px-3 py-1.5 rounded-lg font-medium italic">
            Düzenleme için taşınmaz düzenleme ekranını kullanın.
        </div>
    </div>

    <div class="table-wrapper">
        <table class="w-full min-w-[600px]">
            <thead>
                <tr>
                    <th class="w-48 bg-slate-50/50">Kiracı Kategorisi</th>
                    @foreach (var col in Model.Kolonlar)
                    {
                        <th class="text-center bg-slate-50/50 border-l border-slate-100">
                            <div class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mb-1">@col.BorcTipiKod</div>
                            <div class="text-[13px] text-slate-700">@col.BorcTipiAd</div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Satirlar == null || !Model.Satirlar.Any())
                {
                    <tr>
                        <td colspan="@(Model.Kolonlar.Count + 1)" class="text-center py-8 text-slate-400">
                            Tanımlı fiyat parametresi bulunmuyor.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var satir in Model.Satirlar)
                    {
                        <tr class="hover:bg-slate-50/30 transition-colors">
                            <td class="font-bold text-slate-800 bg-slate-50/20">@satir.KiraciKategoriAd</td>
                            @foreach (var hucre in satir.Hucreler)
                            {
                                <td class="p-4 text-center border-l border-slate-50 @(hucre.RateVarMi ? "bg-white" : "bg-slate-50/40")">
                                    @if (hucre.RateVarMi)
                                    {
                                        <div class="text-base font-bold text-slate-800 flex items-baseline justify-center gap-1">
                                            @hucre.BirimDeger?.ToString("N2") <span class="text-xs font-normal">₺</span>
                                            <span class="text-[10px] font-medium text-slate-400 uppercase ml-0.5">
                                                @(hucre.HesaplamaYontemi == KiraTakip.Models.HesaplamaYontemi.Sabit ? "Sbt" : "m²")
                                            </span>
                                        </div>
                                        <div class="text-[10px] font-bold text-indigo-500 uppercase tracking-tighter mt-1">
                                            KDV %@hucre.KdvOrani?.ToString("N0")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-[10px] text-slate-300 font-bold uppercase tracking-widest">BOŞ</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalRows > pageSize)
    {
        <div class="flex items-center justify-between p-4 bg-slate-50 border-t border-slate-200">
            <div class="text-xs text-muted font-medium">
                Sayfa @currentPage / @Math.Ceiling((double)Model.TotalRows / pageSize)
            </div>
            <div class="flex gap-1.5">
                @if (currentPage > 1)
                {
                    <a class="btn btn-sm btn-secondary text-xs px-4" asp-action="Index" asp-route-tasinmazId="@Model.TasinmazId" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">← Önceki</a>
                }
                @if (currentPage * pageSize < Model.TotalRows)
                {
                    <a class="btn btn-sm btn-secondary text-xs px-4" asp-action="Index" asp-route-tasinmazId="@Model.TasinmazId" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Sonraki →</a>
                }
            </div>
        </div>
    }
</div>

