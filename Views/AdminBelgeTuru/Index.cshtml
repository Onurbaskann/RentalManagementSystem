@model List<KiraTakip.Models.Entities.BelgeTuru>
@using KiraTakip.Models.Entities
@{
    ViewData["Title"] = "Belge Türleri";
}

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-[13.5px] font-medium">
        ✕ @TempData["Error"]
    </div>
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Belge Türleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    <a href="/Admin/BelgeTuru/Ekle" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Belge Türü
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th>Ad</th>
                    <th class="w-28">Hedef</th>
                    <th class="w-20 text-center">Zorunlu</th>
                    <th class="w-44">İzin Verilen</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bt in Model)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@bt.Sira</td>
                        <td>
                            <span class="font-medium text-slate-700">@bt.Ad</span>
                            @if (bt.Sistem)
                            {
                                <span class="ml-1.5 text-[9px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded align-middle" title="Sistem kaydı: kod ve pasifleştirme kilitli">Sistem</span>
                            }
                            @if (!string.IsNullOrEmpty(bt.Aciklama))
                            {
                                <div class="text-xs text-muted mt-0.5">@bt.Aciklama</div>
                            }
                        </td>
                        <td class="text-[13px]">
                            @(bt.HedefEntite == BelgeOwnerTipi.Kiraci ? "Kiracı" : (bt.HedefEntite == BelgeOwnerTipi.Odeme ? "Ödeme" : bt.HedefEntite.ToString()))
                        </td>
                        <td class="text-center">
                            @if (bt.Zorunlu) { <span class="badge badge-kirali">Zorunlu</span> }
                            else { <span class="text-muted text-xs">—</span> }
                        </td>
                        <td class="text-[12.5px] text-muted font-mono">@bt.IzinVerilenUzantilar (max @bt.MaxBoyutMb MB)</td>
                        <td>
                            @if (bt.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/BelgeTuru/Duzenle/@bt.Id" class="btn btn-sm btn-secondary">Düzenle</a>
                            @if (!bt.Sistem)
                            {
                                <form method="post" action="/Admin/BelgeTuru/DurumDegistir/@bt.Id"
                                      data-confirm="@(bt.IsActive ? $"'{bt.Ad}' pasif yapılsın mı?" : $"'{bt.Ad}' aktif yapılsın mı?")"
                                      class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(bt.IsActive ? "btn-danger" : "btn-amber")">
                                        @(bt.IsActive ? "Pasif Yap" : "Aktif Yap")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-xs text-muted px-2 py-1" title="Sistem kayıtları pasifleştirilemez">🔒</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-8 text-muted">Henüz belge türü tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
