@model List<KiraTakip.Models.Dtos.PropertyType.PropertyTypeListItemDto>
@{
    ViewData["Title"] = "Taşınmaz Tipleri";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Taşınmaz Tipleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    <a href="/Admin/PropertyType/Create" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Taşınmaz Tipi
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th>Ad</th>
                    <th class="w-56">Birim Yapıları</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pt in Model)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@pt.SortOrder</td>
                        <td class="font-medium text-slate-700">@pt.Name</td>
                        <td>
                            @if (!pt.SupportsSingleUnit && !pt.SupportsMultipleUnits)
                            {
                                <span class="text-muted text-xs">—</span>
                            }
                            else
                            {
                                <div class="flex gap-1.5 flex-wrap">
                                    @if (pt.SupportsSingleUnit) { <span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full text-[10px] font-bold">Tek Birim</span> }
                                    @if (pt.SupportsMultipleUnits) { <span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full text-[10px] font-bold">Çoklu Birim</span> }
                                </div>
                            }
                        </td>
                        <td>
                            @if (pt.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/PropertyType/Edit/@pt.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/PropertyType/ToggleStatus/@pt.Id.ToHashId()"
                                  data-confirm="@(pt.IsActive ? $"'{pt.Name}' pasif yapılsın mı?" : $"'{pt.Name}' aktif yapılsın mı?")"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(pt.IsActive ? "btn-danger" : "btn-amber")">
                                    @(pt.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center py-8 text-muted">Henüz taşınmaz tipi tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
