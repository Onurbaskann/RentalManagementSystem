@model KiraTakip.Models.ViewModels.PropertyTypeFormViewModel
@{
    ViewData["Title"] = "Yeni Taşınmaz Tipi";
    ViewData["UseCentralFeedback"] = true;
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div class="page-title">Yeni Taşınmaz Tipi</div>
</div>

<div class="card">
    <form method="post" action="/Admin/PropertyType/Create" asp-form-write-permission="@PermissionCatalog.PropertyType.Create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="Bina" />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">İzinli Birim Yapıları <span class="text-red-500">*</span></label>
            <div class="flex flex-col gap-2 p-3 border border-[var(--color-border)] rounded-lg bg-slate-50/50">
                <label class="flex items-center gap-2 cursor-pointer text-[13.5px]">
                    <input asp-for="SupportsSingleUnit" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span>Tek Birim</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-[13.5px]">
                    <input asp-for="SupportsMultipleUnits" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span>Çoklu Birim</span>
                </label>
            </div>
            <div class="text-xs text-muted mt-1">Bu tipte taşınmaz oluşturulurken kullanılabilecek kiralama şekilleri.</div>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="SortOrder" type="number" class="form-control w-24" min="1" />
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.PropertyType.Create">Kaydet</button>
            <a href="/Admin/PropertyType" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
