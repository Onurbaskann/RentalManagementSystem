@model KiraTakip.Models.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Sektör Düzenle";
    ViewData["UseCentralFeedback"] = true;
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div>
        <div class="page-title">Sektör Düzenle</div>
    </div>
</div>

<div class="card">
    <form method="post" action="/Admin/Sector/Edit/@Model.Id.ToHashId()" asp-form-write-permission="@PermissionCatalog.Sector.Edit">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Order" type="number" class="form-control w-24" />
            <span asp-validation-for="Order" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.Sector.Edit">Kaydet</button>
            <a href="/Admin/Sector" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
</div>
