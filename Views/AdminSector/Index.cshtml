@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.CategoryListItemDto>
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Sektörler";
    ViewData["UseCentralFeedback"] = true;
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var pagination = PaginationModel.FromPaged(Model, "/Admin/Sector", query.ToQueryDict());
}


<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Sektörler</div>
        <div class="page-subtitle">@Model.Total kayıt — kiracı sektör bilgisi</div>
    </div>
    <a href="/Admin/Sector/Create" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Sektör
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th>Ad</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@s.Order</td>
                        <td class="font-medium text-slate-700">@s.Name</td>
                        <td>
                            @if (s.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/Sector/Edit/@s.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/Sector/ToggleStatus/@s.Id.ToHashId()"
                                  data-confirm="@(s.IsActive ? $"'{s.Name}' pasif yapılsın mı?" : $"'{s.Name}' aktif yapılsın mı?")"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-danger" : "btn-amber")">
                                    @(s.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="4" class="text-center py-8 text-muted">Henüz sektör tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
