@model KiraTakip.Models.ViewModels.DocumentTypeFormViewModel
@using KiraTakip.Models.Entities
@using KiraTakip.Models
@{
    ViewData["Title"] = "Belge Türü Düzenle";
    ViewData["UseCentralFeedback"] = true;
}

<div class="max-w-[680px] mx-auto">
    <div class="page-header">
        <a href="/Admin/DocumentType" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← Belge Türleri</a>
        <div class="page-title">Belge Türü Düzenle</div>
    </div>

    <form asp-action="Edit" asp-hashid="@Model.Id" method="post" asp-form-write-permission="@PermissionCatalog.DocumentType.Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsSystem" />

        <div class="card mb-4">
            <div class="text-[15px] font-bold mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                Temel Bilgiler
            </div>

            <div class="form-group mb-0">
                <label class="form-label">Ad *</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>

            <div class="form-group mt-4 mb-0">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>
        </div>

        <div class="card mb-4">
            <div class="text-[15px] font-bold mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                Kural & Kısıtlamalar
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-4 gap-y-4">
                <div class="form-group mb-0">
                    <label class="form-label">Hedef Kayıt Tipi *</label>
                    @if (Model.IsSystem)
                    {
                        <input type="hidden" asp-for="TargetEntity" />
                        <select class="form-control bg-slate-100 text-slate-500" disabled>
                            @if (Model.TargetEntity == DocumentOwnerType.Tenant)
                            {
                                <option value="@((int)DocumentOwnerType.Tenant)" selected>Kiracı</option>
                            }
                            else if (Model.TargetEntity == DocumentOwnerType.Payment)
                            {
                                <option value="@((int)DocumentOwnerType.Payment)" selected>Ödeme</option>
                            }
                            else if (Model.TargetEntity == DocumentOwnerType.Lease)
                            {
                                <option value="@((int)DocumentOwnerType.Lease)" selected>Sözleşme</option>
                            }
                            else if (Model.TargetEntity == DocumentOwnerType.Template)
                            {
                                <option value="@((int)DocumentOwnerType.Template)" selected>Şablon</option>
                            }
                        </select>
                        <div class="text-xs text-muted mt-1">🔒 Sistem kaydı — hedef kayıt tipi değiştirilemez.</div>
                    }
                    else
                    {
                        <select asp-for="TargetEntity" class="form-control">
                            <option value="@((int)DocumentOwnerType.Tenant)">Kiracı</option>
                            <option value="@((int)DocumentOwnerType.Lease)">Sözleşme</option>
                            <option value="@((int)DocumentOwnerType.Payment)">Ödeme</option>
                        </select>
                        <span asp-validation-for="TargetEntity" class="form-error"></span>
                    }
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">İzin Verilen Uzantılar *</label>
                    <input asp-for="AllowedExtensions" class="form-control font-mono" />
                    <span asp-validation-for="AllowedExtensions" class="form-error"></span>
                    <div class="text-xs text-muted mt-1">Virgülle ayırın. Küçük harf.</div>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Maks. Boyut (MB) *</label>
                    <input asp-for="MaxSizeMb" type="number" min="1" max="100" class="form-control" />
                    <span asp-validation-for="MaxSizeMb" class="form-error"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-4 mt-4">
                <div class="form-group mb-0">
                    <label class="form-label">Sıra *</label>
                    <input asp-for="SortOrder" type="number" min="1" class="form-control" />
                    <span asp-validation-for="SortOrder" class="form-error"></span>
                </div>
                <div class="flex flex-col gap-2 mt-auto pb-1">
                    <label class="flex items-center gap-2 cursor-pointer select-none text-sm">
                        <input asp-for="Required" type="checkbox" class="w-4 h-4 rounded" />
                        Zorunlu belge
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer select-none text-sm">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded" />
                        Aktif
                    </label>
                </div>
            </div>
        </div>

        <div class="flex gap-3 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.DocumentType.Edit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Kaydet
            </button>
            <a href="/Admin/DocumentType" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
