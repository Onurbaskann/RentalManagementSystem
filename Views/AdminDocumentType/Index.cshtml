@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Entities.DocumentType>
@using KiraTakip.Models.Entities
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Belge Türleri";
    ViewData["UseCentralFeedback"] = true;
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var pagination = PaginationModel.FromPaged(Model, "/Admin/DocumentType", query.ToQueryDict());
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Belge Türleri</div>
        <div class="page-subtitle">@Model.Total kayıt</div>
    </div>
    <a href="/Admin/DocumentType/Create" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Belge Türü
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th>Ad</th>
                    <th class="w-28">Hedef</th>
                    <th class="w-20 text-center">Zorunlu</th>
                    <th class="w-44">İzin Verilen</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dt in Model.Items)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@dt.SortOrder</td>
                        <td>
                            <span class="font-medium text-slate-700">@dt.Name</span>
                            @if (dt.IsSystem)
                            {
                                <span class="ml-1.5 text-[9px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded align-middle" title="Sistem kaydı: kod ve pasifleştirme kilitli">Sistem</span>
                            }
                            @if (!string.IsNullOrEmpty(dt.Description))
                            {
                                <div class="text-xs text-muted mt-0.5">@dt.Description</div>
                            }
                        </td>
                        <td class="text-[13px]">
                            @(dt.TargetEntity == DocumentOwnerType.Tenant ? "Kiracı" : dt.TargetEntity == DocumentOwnerType.Lease ? "Sözleşme" : dt.TargetEntity == DocumentOwnerType.Payment ? "Ödeme" : dt.TargetEntity.ToString())
                        </td>
                        <td class="text-center">
                            @if (dt.Required) { <span class="badge badge-kirali">Zorunlu</span> }
                            else { <span class="text-muted text-xs">—</span> }
                        </td>
                        <td class="text-[12.5px] text-muted font-mono">@dt.AllowedExtensions (max @dt.MaxSizeMb MB)</td>
                        <td>
                            @if (dt.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/DocumentType/Edit/@dt.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            @if (!dt.IsSystem)
                            {
                                <form method="post" action="/Admin/DocumentType/ToggleStatus/@dt.Id.ToHashId()"
                                      data-confirm="@(dt.IsActive ? $"'{dt.Name}' pasif yapılsın mı?" : $"'{dt.Name}' aktif yapılsın mı?")"
                                      class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(dt.IsActive ? "btn-danger" : "btn-amber")">
                                        @(dt.IsActive ? "Pasif Yap" : "Aktif Yap")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-xs text-muted px-2 py-1" title="Sistem kayıtları pasifleştirilemez">🔒</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center py-8 text-muted">Henüz belge türü tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
