@model KiraTakip.Models.ViewModels.TenantLeaseDetailsViewModel
@using KiraTakip.Models
@using KiraTakip.Models.Entities
@using System.Globalization
@{
    Layout = "_KiraciLayout";
    var leaseDetails = Model.Lease;
    ViewData["Title"] = $"Sözleşme #{leaseDetails.Id}";
    ViewData["UseCentralFeedback"] = true;
    var trCulture = new CultureInfo("tr-TR");
    var tenantLeaseControllerName = nameof(KiraTakip.Controllers.TenantLeaseController).Replace("Controller", string.Empty);
    var tenantProfileControllerName = nameof(KiraTakip.Controllers.TenantProfileController).Replace("Controller", string.Empty);
    var leaseIndexUrl = Url.Action(nameof(KiraTakip.Controllers.TenantLeaseController.Index), tenantLeaseControllerName)!;
    var tenantProfileUrl = Url.Action(nameof(KiraTakip.Controllers.TenantProfileController.Index), tenantProfileControllerName)!;

    bool isTerminated = leaseDetails.Status == LeaseStatus.Terminated;
    bool hasChargeAccess = Model.HasChargeAccess;

    string leaseStatusBadgeClass = isTerminated
        ? "badge-gecmis"
        : !Model.IsActive
            ? "badge-bos"
            : Model.UnitStatus == OccupancyStatus.ExpiringSoon
                ? "badge-surek"
                : "badge-kirali";
    string leaseStatusLabel = isTerminated
        ? "Feshedildi"
        : !Model.IsActive
            ? "Sona Erdi"
            : Model.UnitStatus == OccupancyStatus.ExpiringSoon
                ? "Süresi Dolmak Üzere"
                : "Aktif";

    decimal monthlyAmount = Model.MonthlyAmount;
    decimal vatAmount = leaseDetails.IsVatApplied ? monthlyAmount * Model.EffectiveVatRate / 100 : 0;
    decimal vatIncludedTotal = monthlyAmount + vatAmount;
    decimal monthlyVatAmount = vatAmount;

    var leaseCharges = Model.Charges
        .Where(t => t.SourceType == ChargeSourceType.Lease && t.Status != ChargeStatus.Cancelled)
        .ToList();
    int paidChargeCount  = leaseCharges.Count(t => t.Status == ChargeStatus.Paid);
    int pendingChargeCount = leaseCharges.Count(t => t.Status == ChargeStatus.Pending || t.Status == ChargeStatus.PartiallyPaid);
    int overdueChargeCount = leaseCharges.Count(t => t.Status == ChargeStatus.Overdue);
    int totalChargeCount  = leaseCharges.Count;
    decimal totalChargeAmount = leaseCharges.Sum(t => t.TotalAmount);
    decimal paidChargeAmount = leaseCharges.Sum(t => t.PaidAmount);
    decimal pendingChargeAmount = leaseCharges
        .Where(t => t.Status == ChargeStatus.Pending || t.Status == ChargeStatus.PartiallyPaid)
        .Sum(t => t.TotalAmount - t.PaidAmount);
    decimal overdueChargeAmount = leaseCharges
        .Where(t => t.Status == ChargeStatus.Overdue)
        .Sum(t => t.TotalAmount - t.PaidAmount);
    decimal paymentRate = totalChargeAmount > 0 ? Math.Round(paidChargeAmount / totalChargeAmount * 100, 0) : 0;
    DateTime? nextDueDate = leaseCharges
        .Where(t => t.Status == ChargeStatus.Pending || t.Status == ChargeStatus.PartiallyPaid)
        .OrderBy(t => t.DueDate)
        .Select(t => (DateTime?)t.DueDate)
        .FirstOrDefault();
    string chargeHealthColor = paymentRate >= 90 ? "var(--color-primary)" : paymentRate >= 70 ? "#b45309" : "#dc2626";
}

<!-- Üst: Geri dön linki -->
<div class="mb-5">
    <a href="@leaseIndexUrl" class="text-[12.5px] text-muted no-underline hover:text-primary transition-colors">← Sözleşmeler</a>
</div>

@if (isTerminated)
{
    <div class="alert-danger mb-4 text-[13.5px]">
        Bu sözleşme <strong>@leaseDetails.TerminationDate.Tarih()</strong> tarihinde feshedildi.
        @if (!string.IsNullOrEmpty(leaseDetails.TerminationReason)) { <span> Neden: @leaseDetails.TerminationReason</span> }
    </div>
}

<!-- Ana Kart: Kiracı + Unit/Taşınmaz -->
<div class="card mb-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
        <!-- Sol: Kiracı (firma) -->
        <div>
            <div class="text-[11.5px] font-semibold text-muted uppercase tracking-wider mb-2.5">Kiracı</div>
            <div class="flex items-center gap-3.5 mb-3.5">
                <div class="w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center text-[17px] font-bold flex-shrink-0">
                    @(leaseDetails.TenantDisplayName.Split(' ').Where(p => p.Length > 0).Take(2).Select(p => p[0].ToString().ToUpper()).Aggregate("", (a, b) => a + b))
                </div>
                <div>
                    <div class="font-serif text-[22px] font-bold leading-tight">@leaseDetails.TenantDisplayName</div>
                    <div class="mt-1 flex gap-1.5 items-center">
                        <span class="badge badge-kurumsal">Tüzel Kişi</span>
                        @if (!string.IsNullOrEmpty(leaseDetails.TenantCategoryName))
                        {
                            <span class="badge badge-bos">@leaseDetails.TenantCategoryName</span>
                        }
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-1.5">
                @if (!string.IsNullOrEmpty(leaseDetails.TenantPhone))
                {
                    <div class="flex items-center gap-2 text-[13px]">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.61 4.59 2 2 0 0 1 3.58 2.41h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.52 17z"/></svg>
                        @leaseDetails.TenantPhone
                    </div>
                }
                @if (!string.IsNullOrEmpty(leaseDetails.TenantEmail))
                {
                    <div class="flex items-center gap-2 text-[13px]">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted flex-shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        @leaseDetails.TenantEmail
                    </div>
                }
            </div>
            <div class="mt-3">
                <a href="@tenantProfileUrl" class="btn btn-sm btn-secondary">Kiracı Profili</a>
            </div>
        </div>

        <!-- Sağ: Unit/Taşınmaz + Durum -->
        <div class="text-right">
            <div class="text-[11.5px] font-semibold text-muted uppercase tracking-wider mb-2.5">Taşınmaz</div>
            <div class="font-serif text-xl font-bold mb-1">@leaseDetails.PropertyName</div>
            @if (leaseDetails.UnitStructure == UnitStructure.MultipleUnits)
            {
                <div class="text-sm text-muted mb-1">Birim @leaseDetails.UnitNo@(leaseDetails.UnitFloorNo.HasValue ? $" • {leaseDetails.UnitFloorNo}. Kat" : "") • @leaseDetails.UnitArea.M2()</div>
                <div class="text-[13px] text-muted mb-2.5">@leaseDetails.PropertyDistrict, @leaseDetails.PropertyCity</div>
            }
            else
            {
                <div class="text-sm text-muted mb-2.5">@leaseDetails.UnitName • @leaseDetails.PropertyDistrict, @leaseDetails.PropertyCity</div>
            }
            <div>
                <span class="badge @leaseStatusBadgeClass text-[12.5px] px-3.5 py-1.5">@leaseStatusLabel</span>
            </div>
        </div>
    </div>
</div>

<!-- 3 Kolonlu Özet -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <!-- Kira Bedeli -->
    <div class="card">
        <div class="card-title">Kira Bedeli</div>
        <div class="mt-2.5">
            <div class="text-xs text-muted mb-0.5">Aylık (KDV Hariç)</div>
            <div class="font-serif text-[26px] font-bold text-primary">@monthlyAmount.Tl()</div>
        </div>
        @if (leaseDetails.IsVatApplied)
        {
            <div class="mt-2 pt-2 border-t border-[var(--color-border)]">
                <div class="text-[11.5px] text-muted mb-0.5">KDV (@Model.EffectiveVatRate.Yuzde(0))</div>
                <div class="text-sm font-semibold">+ @monthlyVatAmount.Tl()</div>
                <div class="text-xs text-muted mt-1">KDV Dahil: <strong>@( (monthlyAmount + monthlyVatAmount).Tl() )</strong></div>
            </div>
        }
        <div class="mt-2 pt-2 border-t border-[var(--color-border)]">
            <div class="text-[11.5px] text-muted mb-0.5">Yıllık</div>
            <div class="text-base font-bold">@Model.AnnualAmount.Tl()</div>
        </div>
        <div class="mt-1.5 text-[11.5px] text-muted">Tam ay üzerinden</div>
    </div>

    <!-- Sözleşme Süresi -->
    <div class="card">
        <div class="flex items-center justify-between">
            <div class="card-title">Sözleşme Süresi</div>
            <span class="badge @leaseStatusBadgeClass text-[11px]">@leaseStatusLabel</span>
        </div>
        <div class="mt-2.5 flex items-center gap-2 text-[13px] font-medium">
            <span>@leaseDetails.StartDate.Tarih()</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted flex-shrink-0"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <span>@leaseDetails.EndDate.Tarih()</span>
        </div>
        <div class="mt-3.5">
            <div class="flex justify-between text-[11.5px] text-muted mb-1">
                <span>Geçen süre</span>
                <span>@Model.DurationPercentage.Yuzde(0)</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill @(Model.DurationPercentage > 85 ? "progress-fill-amber" : "")" style="width:@Model.DurationPercentage.Yuzde(0).TrimStart('%')%;"></div>
            </div>
        </div>
        <div class="mt-2.5 flex items-baseline justify-between">
            <div class="text-xs text-muted">Toplam @((int)(leaseDetails.EndDate - leaseDetails.StartDate).TotalDays) gün</div>
            <div class="text-[13px] font-semibold"
                 style="color:@(isTerminated || Model.RemainingDays <= 0 ? "#dc2626" : Model.RemainingDays <= 30 ? "#b45309" : "var(--color-primary)");">
                @if (isTerminated) { <span>—</span> }
                else { <span>@Math.Max(0, Model.RemainingDays) gün kaldı</span> }
            </div>
        </div>
        <div class="mt-3 pt-3 border-t border-[var(--color-border)]">
            <div class="text-[11.5px] text-muted">Vade Kuralı</div>
            <div class="text-[13px] font-semibold mt-0.5">
                @if (leaseDetails.DueDateRuleType == DueDateRuleType.FixedDayOfMonth)
                {
                    <span>Her ayın @leaseDetails.DueDay</span><span>'i</span>
                }
                else
                {
                    <span>Dönem başı + @(leaseDetails.DueDay - 1) gün</span>
                }
            </div>
        </div>
    </div>

    <!-- Tahakkuk Sağlığı -->
    @if (hasChargeAccess)
    {
    <div class="card">
        <div class="flex items-center justify-between">
            <div class="card-title">Tahakkuk Sağlığı</div>
            <span class="text-[11px] text-muted">@totalChargeCount tahakkuk</span>
        </div>
        @if (totalChargeCount == 0)
        {
            <div class="mt-4 text-center text-muted text-[13px] italic py-6">Henüz tahakkuk üretilmedi.</div>
        }
        else
        {
            <div class="mt-2.5 flex items-baseline gap-2">
                <div class="font-serif text-[40px] font-bold leading-none" style="color:@chargeHealthColor">
                    @paymentRate.Yuzde(0)
                </div>
                <div class="text-[12px] text-muted">ödeme oranı</div>
            </div>

            <div class="mt-3.5 flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#10b981"></span>
                        <span class="text-[12px] text-muted">Ödendi</span>
                        <span class="text-[10.5px] text-muted bg-slate-100 px-1.5 py-0.5 rounded-full font-medium">@paidChargeCount</span>
                    </div>
                    <span class="text-[13px] font-semibold">@paidChargeAmount.Tl()</span>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#94a3b8"></span>
                        <span class="text-[12px] text-muted">Bekleyen</span>
                        <span class="text-[10.5px] text-muted bg-slate-100 px-1.5 py-0.5 rounded-full font-medium">@pendingChargeCount</span>
                    </div>
                    <span class="text-[13px] font-semibold">@pendingChargeAmount.Tl()</span>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#dc2626"></span>
                        <span class="text-[12px] text-muted">Geciken</span>
                        <span class="text-[10.5px] px-1.5 py-0.5 rounded-full font-medium @(overdueChargeCount > 0 ? "bg-red-50 text-[#dc2626]" : "bg-slate-100 text-muted")">@overdueChargeCount</span>
                    </div>
                    <span class="text-[13px] font-semibold @(overdueChargeCount > 0 ? "text-[#dc2626]" : "")">@overdueChargeAmount.Tl()</span>
                </div>
            </div>

            <div class="mt-3 pt-3 border-t border-[var(--color-border)] flex items-center justify-between">
                <div>
                    <div class="text-[11.5px] text-muted">Sonraki Vade</div>
                    <div class="text-[13px] font-semibold mt-0.5">@nextDueDate.Tarih()</div>
                </div>
                <button type="button" class="btn btn-sm btn-secondary inline-flex items-center gap-1"
                        onclick="document.querySelector('#lease-tabs [data-tab=&quot;odemeler&quot;]').click(); document.getElementById('lease-tabs').scrollIntoView({ behavior: 'smooth', block: 'start' });">
                    Ödemelere Git
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </button>
            </div>
        }
    </div>
    }
</div>

<!-- Aylık Tahakkuk Kalemleri -->
@if (hasChargeAccess && Model.CurrentLineItems.Any())
{
    <div class="card mb-4">
        <div class="flex justify-between items-center mb-3.5">
            <div>
                <span class="text-xs font-semibold text-muted uppercase tracking-wider">Aylık Tahakkuk Kalemleri</span>
                @if (Model.CurrentLineItemPeriod.HasValue)
                {
                    <span class="text-xs text-muted ml-2">— @Model.CurrentLineItemPeriod.Value.ToString("MMMM yyyy", trCulture)</span>
                }
                <div class="text-[11.5px] text-muted mt-0.5">İlk/son ay kıst uygulanır</div>
            </div>
        </div>
        <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
            <table class="w-full text-xs">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-slate-500 font-bold uppercase tracking-wider text-[9px]">
                        <th class="p-2 px-3 text-left">Açıklama</th>
                        <th class="p-2 px-3 text-left">Hesaplama</th>
                        <th class="p-2 px-3 text-right">Birim</th>
                        <th class="p-2 px-3 text-right">Tutar</th>
                        <th class="p-2 px-3 text-right text-muted">KDV</th>
                        <th class="p-2 px-3 text-right">Toplam</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.CurrentLineItems)
                    {
                        <tr class="border-t border-slate-100 last:border-0 hover:bg-slate-50/50 transition-colors">
                            <td class="p-2 px-3 text-slate-600 font-medium">@k.ChargeType.Name</td>
                            <td class="p-2 px-3 text-slate-400">@(k.CalculationMethod == CalculationMethod.M2 ? "m² Bazlı" : "Sabit")</td>
                            <td class="p-2 px-3 text-right text-slate-500">@k.UnitValue.Tl()@(k.CalculationMethod == CalculationMethod.M2 ? "/m²" : "")</td>
                            <td class="p-2 px-3 text-right font-semibold text-slate-600">@k.Amount.Tl()</td>
                            <td class="p-2 px-3 text-right text-slate-400/60">
                                @if (k.KdvRate > 0) { <span>@k.KdvRate.Yuzde(0) → @k.KdvAmount.Tl()</span> }
                                else { <span>—</span> }
                            </td>
                            <td class="p-2 px-3 text-right font-bold text-slate-700">@k.TotalAmount.Tl()</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-slate-50 border-t-2 border-slate-200">
                    <tr class="font-bold text-[9px] uppercase tracking-wider text-slate-500">
                        <td colspan="3" class="p-2 px-3">Toplam</td>
                        <td class="p-2 px-3 text-right text-slate-600">@Model.CurrentLineItems.Sum(k => k.Amount).Tl()</td>
                        <td class="p-2 px-3 text-right text-slate-400/60">@Model.CurrentLineItems.Sum(k => k.KdvAmount).Tl()</td>
                        <td class="p-2 px-3 text-right text-slate-700">@Model.CurrentLineItems.Sum(k => k.TotalAmount).Tl()</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- Tab'lı Bölüm -->
<div id="lease-tabs">
    <div class="tabs">
        <button class="tab">Detaylar</button>
        <button class="tab">Birim Bilgisi</button>
        @if (hasChargeAccess)
        {
            <button class="tab" data-tab="odemeler">Ödemeler (@Model.Charges.Count)</button>
        }
        @if (Model.DocumentTypes.Any())
        {
            <button class="tab" data-tab="belgeler">Belgeler (@Model.Documents.Count / @Model.DocumentTypes.Count)</button>
        }
    </div>

    <!-- Tab 1: Detaylar -->
    <div class="tab-content">
        <div class="card">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                @{
                    void Row(string label, string value) {
                        <div class="px-4 py-3 border-b border-[var(--color-border)]">
                            <div class="detail-label">@label</div>
                            <div class="text-sm font-medium">@value</div>
                        </div>
                    }
                    Row("Sözleşme No", $"#{leaseDetails.Id}");
                    Row("Kira Bedeli (KDV Hariç)", $"{monthlyAmount.Tl(0)} / ay");
                    Row("Depozito", Model.DepositAmount.Tl(0));
                    Row("Başlangıç", leaseDetails.StartDate.Tarih());
                    Row("Bitiş", leaseDetails.EndDate.Tarih());
                    if (leaseDetails.IsVatApplied)
                    {
                        Row("KDV Oranı", Model.EffectiveVatRate.Yuzde(0));
                        Row("KDV Tutarı", $"{vatAmount.Tl(0)} / ay");
                        Row("KDV Dahil Toplam", $"{vatIncludedTotal.Tl(0)} / ay");
                    }
                    else
                    {
                        Row("KDV", "Uygulanmıyor");
                    }
                    if (isTerminated)
                    {
                        Row("Fesih Tarihi", leaseDetails.TerminationDate.Tarih());
                        Row("Fesih Nedeni", leaseDetails.TerminationReason ?? "—");
                    }
                }
            </div>
            @if (!string.IsNullOrEmpty(leaseDetails.Description))
            {
                <div class="px-4 py-3.5 bg-[#fafbfc] rounded-b-xl">
                    <div class="detail-label mb-1.5">Açıklama</div>
                    <div class="text-sm leading-relaxed">@leaseDetails.Description</div>
                </div>
            }
        </div>
    </div>

    <!-- Tab 2: Unit Bilgisi -->
    <div class="tab-content">
        <div class="card">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <div class="detail-label mb-3">Birim</div>
                    <div class="flex flex-col gap-2.5">
                        <div>
                            <div class="text-xs text-muted">Ad</div>
                            <div class="text-[15px] font-semibold">@leaseDetails.UnitName</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Yüzölçüm</div>
                            <div class="text-[15px] font-semibold">@leaseDetails.UnitArea.M2()</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Tip</div>
                            <div class="text-[15px] font-semibold">
                                @if (leaseDetails.UnitStructure == UnitStructure.MultipleUnits)
                                {
                                    <span>Birim @leaseDetails.UnitNo</span>
                                    if (leaseDetails.UnitFloorNo.HasValue) { <span class="text-[13px] font-normal text-muted"> • @leaseDetails.UnitFloorNo. Kat</span> }
                                }
                                else { <span>Komple</span> }
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="detail-label mb-3">Taşınmaz</div>
                    <div class="flex flex-col gap-2.5">
                        <div>
                            <div class="text-xs text-muted">Ad</div>
                            <div class="text-[15px] font-semibold">@leaseDetails.PropertyName</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Konum</div>
                            <div class="text-[15px] font-semibold">@leaseDetails.PropertyNeighborhood, @leaseDetails.PropertyDistrict / @leaseDetails.PropertyCity</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Adres</div>
                            <div class="text-sm">@leaseDetails.PropertyAddress</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 3: Ödemeler -->
    @if (hasChargeAccess)
    {
    <div class="tab-content">
        @if (!Model.Charges.Any())
        {
            <div class="card text-center text-muted p-8">Bu sözleşme için henüz tahakkuk oluşturulmamış.</div>
        }
        else
        {
            var allCharges      = Model.Charges.Where(t => t.Status != ChargeStatus.Cancelled).ToList();
            decimal totalExpected  = allCharges.Sum(t => t.TotalAmount);
            decimal totalPaid    = allCharges.Sum(t => t.PaidAmount);
            decimal totalRemaining     = totalExpected - totalPaid;
            decimal overdueAmount   = allCharges.Where(t => t.Status == ChargeStatus.Overdue).Sum(t => t.TotalAmount - t.PaidAmount);
            int overdueCount      = allCharges.Count(t => t.Status == ChargeStatus.Overdue);
            int pendingCount      = allCharges.Count(t => t.Status == ChargeStatus.Pending || t.Status == ChargeStatus.PartiallyPaid);
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                <div class="card text-center">
                    <div class="text-[11.5px] font-semibold text-muted uppercase mb-1.5">Toplam Borç</div>
                    <div class="text-xl font-bold">@totalExpected.Tl(0)</div>
                    <div class="text-[11.5px] text-muted">@allCharges.Count tahakkuk</div>
                </div>
                <div class="card text-center">
                    <div class="text-[11.5px] font-semibold text-muted uppercase mb-1.5">Ödenen</div>
                    <div class="text-xl font-bold text-[#065f46]">@totalPaid.Tl(0)</div>
                    @{ double paidPercentage = totalExpected > 0 ? (double)(totalPaid / totalExpected * 100) : 0; }
                    <div class="text-[11.5px] text-muted">@paidPercentage.Yuzde(0)</div>
                </div>
                <div class="card text-center">
                    <div class="text-[11.5px] font-semibold text-muted uppercase mb-1.5">Kalan</div>
                    <div class="text-xl font-bold text-[#2563eb]">@totalRemaining.Tl(0)</div>
                    <div class="text-[11.5px] text-muted">@pendingCount bekleyen</div>
                </div>
                <div class="card text-center @(overdueCount > 0 ? "border-l-[3px] border-l-[#ef4444]" : "")">
                    <div class="text-[11.5px] font-semibold text-muted uppercase mb-1.5">Gecikmiş</div>
                    <div class="text-xl font-bold @(overdueCount > 0 ? "text-[#ef4444]" : "text-muted")">@overdueAmount.Tl(0)</div>
                    <div class="text-[11.5px] text-muted">@(overdueCount > 0 ? $"{overdueCount} tahakkuk" : "Gecikme yok")</div>
                </div>
            </div>

            <div class="card p-0 overflow-hidden">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Dönem</th>
                                <th>Vade Tarihi</th>
                                <th class="w-24">Gecikme</th>
                                <th class="num">Borç</th>
                                <th class="num">Ödenen</th>
                                 <th class="num">Kalan</th>
                                <th class="pl-4">Durum</th>
                            </tr>
                        </thead>
                        <tbody x-data="{ open: {} }">
                            @foreach (var t in Model.Charges.OrderByDescending(x => x.PeriodStart))
                            {
                                string chargeStatusClass = t.Status switch {
                                    ChargeStatus.Paid    => "badge-kirali",
                                    ChargeStatus.PartiallyPaid => "badge-surek",
                                    ChargeStatus.Overdue      => "badge-gecmis",
                                    ChargeStatus.Cancelled    => "badge-bos",
                                    _                            => "badge-bos"
                                };
                                string chargeStatusLabel = t.Status switch {
                                    ChargeStatus.Paid    => "Tam Ödendi",
                                    ChargeStatus.PartiallyPaid => "Kısmi",
                                    ChargeStatus.Overdue      => "Gecikti",
                                    ChargeStatus.Cancelled    => "İptal Edildi",
                                    _                            => "Bekleniyor"
                                };
                                decimal remainingAmount = t.TotalAmount - t.PaidAmount;
                                int overdueDays = (t.Status != ChargeStatus.Paid && t.DueDate.Date < DateTime.Today)
                                    ? (DateTime.Today - t.DueDate.Date).Days : 0;
                                string overdueColor = overdueDays > 7 ? "#dc2626" : overdueDays > 0 ? "#b45309" : "";
                                <tr @@click="open[@t.Id] = !open[@t.Id]" class="cursor-pointer">
                                    <td>
                                        <svg x-show="open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1 inline-block align-middle"><polyline points="18 15 12 9 6 15"/></svg>
                                        <svg x-show="!open[@t.Id]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-1 inline-block align-middle"><polyline points="6 9 12 15 18 9"/></svg>
                                        @t.PeriodStart.ToString("MMMM yyyy", trCulture)
                                    </td>
                                    <td>@t.DueDate.Tarih()</td>
                                    <td>
                                        @if (overdueDays > 0)
                                        {
                                            <span class="text-[12.5px] font-semibold" style="color:@overdueColor">+@overdueDays gün</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="num">@t.TotalAmount.Tl(0)</td>
                                    <td class="num num-positive">@t.PaidAmount.Tl(0)</td>
                                    <td class="num @(remainingAmount > 0 ? "font-semibold" : "text-muted")" style="@(remainingAmount > 0 ? "color:#dc2626" : "")">
                                        @(remainingAmount > 0 ? remainingAmount.Tl(0) : "—")
                                    </td>
                                    <td class="pl-4">
                                        @if (t.PendingPaymentCount > 0)
                                        {
                                            <span class="badge badge-surek">Ödeme Onayı Bekleniyor</span>
                                        }
                                        else
                                        {
                                            <span class="badge @chargeStatusClass">@chargeStatusLabel</span>
                                        }
                                    </td>
                                </tr>
                                <tr x-show="open[@t.Id]" x-cloak class="bg-[#f7f8fb]">
                                    <td colspan="7" class="p-5 pb-3 px-5">
                                        @if (t.LineItems.Any())
                                        {
                                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Kalem Detayları</div>
                                            <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
                                                <table class="w-full text-xs">
                                                    <thead class="bg-slate-50 border-b border-slate-200">
                                                        <tr class="text-slate-500 font-bold uppercase tracking-wider text-[9px]">
                                                            <th class="p-2 px-3 text-left">Açıklama</th>
                                                            <th class="p-2 px-3 text-right">Birim</th>
                                                            <th class="p-2 px-3 text-right">Tutar</th>
                                                            <th class="p-2 px-3 text-right text-muted">KDV</th>
                                                            <th class="p-2 px-3 text-right">Toplam</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var k in t.LineItems.OrderBy(k => k.ChargeTypeSortOrder))
                                                        {
                                                            <tr class="border-t border-slate-100 last:border-0">
                                                                <td class="p-2 px-3 text-slate-600">@k.Description</td>
                                                                <td class="p-2 px-3 text-right text-slate-500">@k.UnitValue.Tl()@(k.CalculationMethod == CalculationMethod.M2 ? "/m²" : "")</td>
                                                                <td class="p-2 px-3 text-right font-semibold text-slate-600">@k.Amount.Tl()</td>
                                                                <td class="p-2 px-3 text-right text-slate-400/60">@k.VatAmount.Tl()</td>
                                                                <td class="p-2 px-3 text-right font-bold text-slate-700">@k.TotalAmount.Tl()</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-xs text-muted italic">Kalem bilgisi bulunmuyor.</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    }

    <!-- Tab: Belgeler -->
    @if (Model.DocumentTypes.Any())
    {
    <div class="tab-content" data-tab="belgeler">
        @await Html.PartialAsync("_DocumentPanel", new KiraTakip.Models.ViewModels.DocumentPanelViewModel
        {
            OwnerType    = DocumentOwnerType.Lease,
            OwnerId      = leaseDetails.Id,
            DocumentTypes = Model.DocumentTypes,
            Documents = Model.Documents,
            CanEdit      = false
        })
    </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initTabs('lease-tabs');
        });
    </script>
}

