@model List<KiraTakip.Models.Dtos.LeaseListItemDto>
@using KiraTakip.Models
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Sözleşmelerim";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header">
    <div>
        <div class="page-title">Sözleşmelerim</div>
        <div class="page-subtitle">@Model.Count sözleşme</div>
    </div>
</div>

<div class="card p-0 overflow-hidden" x-data="clientTable({ pageSize: 25 })" x-init="init()">
    <div class="flex items-center gap-4 p-3 bg-slate-50/50 border-b border-slate-200">
        <input type="search" class="form-control w-full max-w-sm" placeholder="Ara: birim, taşınmaz…" x-model.debounce.250ms="q" />
        <span class="ml-auto text-xs text-muted">
            <span x-text="total" class="font-bold"></span> kayıt
        </span>
    </div>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th>Birim</th>
                    <th>Taşınmaz</th>
                    <th class="w-28 cell-center">Başlangıç</th>
                    <th class="w-28 cell-center">Bitiş</th>
                    <th class="w-32 num">Aylık Bedel</th>
                    <th class="w-24 cell-center">Kalan</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lease in Model)
                {
                    bool isActive = lease.IsActive;
                    int remainingDays = lease.RemainingDays;
                    bool isExpiringSoon = isActive && remainingDays <= 30;
                    bool isTerminated = lease.Status == LeaseStatus.Terminated;
                    string dayBadgeClass = remainingDays <= 10 ? "bg-red-50 text-red-700 border-red-200" : remainingDays <= 30 ? "bg-amber-50 text-amber-700 border-amber-200" : "bg-emerald-50 text-emerald-700 border-emerald-200";
                    var search = $"{lease.UnitName} {lease.PropertyName}".ToLower();
                    var detailsHref = Url.Action(
                        nameof(KiraTakip.Controllers.TenantLeaseController.Details),
                        nameof(KiraTakip.Controllers.TenantLeaseController).Replace("Controller", string.Empty),
                        new { id = lease.Id.ToHashId() });

                    <tr data-row data-search="@search" data-href="@detailsHref"
                        class="cursor-pointer hover:bg-slate-50 transition-colors"
                        @@click="$el.dataset.href && !$event.target.closest('a,[data-stop]') && (window.location.href = $el.dataset.href)">
                        <td class="font-semibold">@lease.UnitName</td>
                        <td class="text-sm text-muted">@lease.PropertyName</td>
                        <td class="cell-center text-sm">@lease.StartDate.Tarih()</td>
                        <td class="cell-center text-sm">@lease.EndDate.Tarih()</td>
                        <td class="num text-sm font-medium">@lease.MonthlyAmount.Tl()</td>
                        <td class="cell-center">
                            @if (isTerminated)
                            { <span class="text-muted text-[11px] italic" title="Durum: Feshedildi">Feshedildi</span> }
                            else if (isActive)
                            { <span class="px-2 py-0.5 rounded text-[10px] font-bold border @dayBadgeClass" title="Durum: @(isExpiringSoon ? "Doluyor" : "Aktif")">@remainingDays GÜN</span> }
                            else
                            { <span class="text-muted text-[11px] italic" title="Durum: Sona Erdi">Sona erdi</span> }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-12 text-muted italic">Henüz sözleşmeniz yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="flex items-center justify-between p-3 bg-slate-50/50 border-t border-slate-200" x-show="totalPages > 1">
        <div class="text-xs text-muted font-medium">
            <span x-text="from"></span>–<span x-text="to"></span> / <strong x-text="total"></strong> kayıt
        </div>
        <nav class="flex gap-1" aria-label="Sayfalar">
            <button type="button" class="w-8 h-8 flex items-center justify-center rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" :disabled="page === 1" @@click="prev()">‹</button>
            <template x-for="p in pageList" :key="p">
                <button type="button" class="w-8 h-8 flex items-center justify-center rounded border font-medium text-xs transition-colors"
                        :class="p === page ? 'bg-primary text-white border-primary' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'"
                        @@click="goto(p)" x-text="p"></button>
            </template>
            <button type="button" class="w-8 h-8 flex items-center justify-center rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" :disabled="page === totalPages" @@click="next()">›</button>
        </nav>
    </div>
    <div class="p-8 text-center" x-show="total === 0 && q.length > 0" x-cloak>
        <div class="text-slate-400 font-medium">Aramaya uyan kayıt bulunamadı.</div>
    </div>
</div>

