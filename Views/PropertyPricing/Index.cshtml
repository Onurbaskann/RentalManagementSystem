@model KiraTakip.Models.ViewModels.PropertyPricingMatrixViewModel
@{
    ViewData["Title"] = $"{Model.PropertyName} - Parametreler";
}


<div class="card p-0 overflow-hidden">
    <div class="flex items-center justify-between p-4 bg-slate-50 border-b border-slate-200">
        <div>
            <div class="text-lg font-bold text-slate-800">@Model.PropertyName — Fiyat Parametreleri</div>
            <div class="text-xs text-muted font-medium mt-0.5">Salt-okunur parametre matrisi</div>
        </div>
        <div class="text-[11px] text-slate-400 bg-white border border-slate-200 px-3 py-1.5 rounded-lg font-medium italic">
            Düzenleme için taşınmaz düzenleme ekranını kullanın.
        </div>
    </div>

    <div class="table-wrapper">
        <table class="w-full min-w-[600px]">
            <thead>
                <tr>
                    <th class="w-48 bg-slate-50/50">Kiracı Kategorisi</th>
                    @foreach (var col in Model.Columns)
                    {
                        <th class="text-center bg-slate-50/50 border-l border-slate-100">
                            <div class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mb-1">@col.ChargeTypeCode</div>
                            <div class="text-[13px] text-slate-700">@col.ChargeTypeName</div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows == null || !Model.Rows.Any())
                {
                    <tr>
                        <td colspan="@(Model.Columns.Count + 1)" class="text-center py-8 text-slate-400">
                            Tanımlı fiyat parametresi bulunmuyor.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="hover:bg-slate-50/30 transition-colors">
                            <td class="font-bold text-slate-800 bg-slate-50/20">@row.TenantCategoryName</td>
                            @foreach (var cell in row.Cells)
                            {
                                <td class="p-4 text-center border-l border-slate-50 @(cell.HasRate ? "bg-white" : "bg-slate-50/40")">
                                    @if (cell.HasRate)
                                    {
                                        <div class="text-base font-bold text-slate-800 flex items-baseline justify-center gap-1">
                                            @cell.UnitValue?.ToString("N2") <span class="text-xs font-normal">₺</span>
                                            <span class="text-[10px] font-medium text-slate-400 uppercase ml-0.5">
                                                @(cell.CalculationMethod == KiraTakip.Models.CalculationMethod.Fixed ? "Sbt" : "m²")
                                            </span>
                                        </div>
                                        <div class="text-[10px] font-bold text-indigo-500 uppercase tracking-tighter mt-1">
                                            KDV %@cell.VatRate?.ToString("N0")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-[10px] text-slate-300 font-bold uppercase tracking-widest">BOŞ</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalRows > Model.PageSize)
    {
        <div class="flex items-center justify-between p-4 bg-slate-50 border-t border-slate-200">
            <div class="text-xs text-muted font-medium">
                Sayfa @Model.CurrentPage / @Math.Ceiling((double)Model.TotalRows / Model.PageSize)
            </div>
            <div class="flex gap-1.5">
                @if (Model.CurrentPage > 1)
                {
                    <a class="btn btn-sm btn-secondary text-xs px-4" asp-action="Index" asp-route-propertyId="@Model.PropertyId" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize">← Önceki</a>
                }
                @if (Model.CurrentPage * Model.PageSize < Model.TotalRows)
                {
                    <a class="btn btn-sm btn-secondary text-xs px-4" asp-action="Index" asp-route-propertyId="@Model.PropertyId" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize">Sonraki →</a>
                }
            </div>
        </div>
    }
</div>


