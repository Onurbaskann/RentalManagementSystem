@model KiraTakip.Models.ViewModels.TasinmazEkleViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = "Yeni Taşınmaz";
}

<div class="page-header">
    <a href="/Tasinmaz" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">← Taşınmazlar</a>
    <div class="page-title">Yeni Taşınmaz Ekle</div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 px-4 rounded-lg mb-5">
        <div class="font-bold mb-2 text-sm">Lütfen aşağıdaki hataları düzeltiniz:</div>
        <ul class="m-0 pl-5 text-[13px] list-disc">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="max-w-[760px]" x-data="tasinmazFormData()" x-cloak>

    <form asp-action="Ekle" method="post" @@submit.prevent="handleSubmit($event)">
        <div class="card">
            <div class="text-[15px] font-bold mb-4.5 pb-3.5 border-b border-[var(--color-border)]">Temel Bilgiler</div>

            <div class="form-group">
                <label class="form-label">Taşınmaz Adı *</label>
                <input asp-for="Ad" class="form-control" placeholder="Örn: Teknokent A Blok" />
                <span asp-validation-for="Ad" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Taşınmaz Tipi *</label>
                <select asp-for="TasinmazTipiId" class="form-control" x-model="tasinmazTipiId" @@change="onTasinmazTipiChange()">
                    <option value="">— Seçiniz —</option>
                    @foreach (var tt in (IEnumerable<Kategori>)ViewBag.TasinmazTipleri)
                    {
                        <option value="@tt.Id">@tt.Ad</option>
                    }
                </select>
                <span asp-validation-for="TasinmazTipiId" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Kiralama Şekli *</label>
                <div class="radio-group">
                    <label class="radio-option" :class="!izinli(1) ? 'opacity-40 cursor-not-allowed' : ''">
                        <input type="radio" asp-for="KiralamaSekli" value="1" x-model="sekli" :disabled="!izinli(1)" />
                        <span>Tek Parça</span>
                    </label>
                    <label class="radio-option" :class="!izinli(2) ? 'opacity-40 cursor-not-allowed' : ''">
                        <input type="radio" asp-for="KiralamaSekli" value="2" x-model="sekli" :disabled="!izinli(2)" />
                        <span>Birim Bazlı</span>
                    </label>
                </div>
                <div class="form-hint" x-show="!tasinmazTipiId">Önce taşınmaz tipi seçiniz.</div>
                <div class="form-hint text-red-800" x-show="tasinmazTipiId && izinliSet().length === 0">Bu taşınmaz tipi için kiralama şekli tanımlanmamış. Lütfen yöneticiye bildiriniz.</div>
                <div class="form-hint" x-show="sekli == '2' && izinli(2)">Taşınmaz içindeki birimler ayrı ayrı kiralanabilir. Birimleri aşağıda tanımlayın.</div>
                <span asp-validation-for="KiralamaSekli" class="form-error"></span>
            </div>

            <div class="grid grid-cols-2 gap-3.5 mb-3">
                <div class="form-group">
                    <label class="form-label">Kapalı Alan (m²)</label>
                    <input asp-for="KapaliYuzolcumu" type="number" min="0" step="0.01" class="form-control" placeholder="0" />
                </div>
                <div class="form-group">
                    <label class="form-label">Açık Alan (m²)</label>
                    <input asp-for="AcikYuzolcumu" type="number" min="0" step="0.01" class="form-control" placeholder="0" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Aciklama" class="form-control" rows="2" placeholder="Opsiyonel not..."></textarea>
            </div>
        </div>



        <!-- Birim Bazlı bölümü -->
        <template x-if="sekli == '2'">
        <div class="card mt-4">
            <div class="flex items-center justify-between mb-4.5 pb-3.5 border-b border-[var(--color-border)]">
                <div class="text-[15px] font-bold">Birimler</div>
                <button type="button" class="btn btn-secondary btn-sm" @@click="addBirim()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Birim Ekle
                </button>
            </div>

            <template x-for="(birim, i) in birimler" :key="i">
                <div class="bg-[#fafbfc] border border-[var(--color-border)] rounded-lg p-3.5 px-4 mb-3 relative">
                    <!-- Sil butonu -->
                    <button type="button" class="btn btn-sm text-red-600 border-red-200 bg-red-50 hover:bg-red-100 transition-colors absolute top-2.5 right-2.5"
                            @@click="removeBirim(i)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                    </button>

                    <div class="grid grid-cols-3 gap-3 mb-3 mr-10">
                        <div>
                            <div class="form-label mb-1">Birim No *</div>
                            <input class="form-control" :name="'Birimler['+i+'].BirimNo'" x-model="birim.birimNo"
                                   placeholder="101" @@blur="autoAd(birim)" />
                            <span x-show="birimErrors[i]?.birimNo" x-text="birimErrors[i]?.birimNo" class="form-error"></span>
                        </div>
                        <div>
                            <div class="form-label mb-1">Kat No *</div>
                            <input class="form-control" type="number" :name="'Birimler['+i+'].KatNo'" x-model="birim.katNo" placeholder="1" />
                            <span x-show="birimErrors[i]?.katNo" x-text="birimErrors[i]?.katNo" class="form-error"></span>
                        </div>
                        <div>
                            <div class="form-label mb-1">Birim Türü *</div>
                            <select class="form-control" :name="'Birimler['+i+'].BirimTuruId'" x-model="birim.birimTuruId">
                                <option value="">— Seçiniz —</option>
                                @foreach (var bt in (IEnumerable<BirimTuru>)ViewBag.BirimTurleri)
                                {
                                    <option value="@bt.Id">@bt.Ad</option>
                                }
                            </select>
                            <span x-show="birimErrors[i]?.birimTuruId" x-text="birimErrors[i]?.birimTuruId" class="form-error"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-[1fr_100px_2fr] gap-3">
                        <div>
                            <div class="form-label mb-1">Ad *</div>
                            <input class="form-control" :name="'Birimler['+i+'].Ad'" x-model="birim.ad" placeholder="Boşsa otomatik doldurulur" />
                            <span x-show="birimErrors[i]?.ad" x-text="birimErrors[i]?.ad" class="form-error"></span>
                        </div>
                        <div>
                            <div class="form-label mb-1">m² *</div>
                            <input class="form-control" type="number" min="1" step="0.01" :name="'Birimler['+i+'].Yuzolcumu'" x-model="birim.yuzolcumu" placeholder="0" />
                            <span x-show="birimErrors[i]?.yuzolcumu" x-text="birimErrors[i]?.yuzolcumu" class="form-error"></span>
                        </div>
                        <div>
                            <div class="form-label mb-1">Açıklama</div>
                            <input class="form-control" :name="'Birimler['+i+'].Aciklama'" x-model="birim.aciklama" placeholder="Opsiyonel" />
                        </div>
                    </div>
                </div>
            </template>

            <template x-if="birimler.length === 0">
                <div class="text-center py-6 text-muted text-[13.5px]">
                    Henüz birim eklenmedi. Yukarıdaki "Birim Ekle" butonu ile birim tanımlayınız.
                </div>
            </template>

            <span asp-validation-for="Birimler" class="form-error block mt-1"></span>

            <template x-if="birimler.length > 0">
                <div class="text-[12.5px] text-muted mt-1">
                    Birim No aynı bina içinde benzersiz olmalıdır. Ad boş bırakılırsa "Birim {BirimNo}" olarak oluşturulur.
                </div>
            </template>
        </div>
        </template>

        @if (Model.ParentTarife != null)
        {
            <div class="mt-4">
                <div class="text-xs text-muted mb-1">Aşağıda tanımlama yapmazsanız genel tarife uygulanır:</div>
                @await Html.PartialAsync("_ParentTarifeKart", Model.ParentTarife)
            </div>
        }

        <!-- Fiyat Parametreleri Kartı -->
        <div class="card mt-4">
            <div class="text-[15px] font-bold mb-4.5 pb-3.5 border-b border-[var(--color-border)]">Fiyat Parametreleri (Genel Tarife)</div>
            <div class="text-[12.5px] text-muted mb-4">Sözleşme eklerken bu matristeki fiyatlar otomatik olarak getirilir.</div>

            <div>
                @for (int i = 0; i < Model.FiyatMatrisi.Satirlar.Count; i++)
                {
                    var satir = Model.FiyatMatrisi.Satirlar[i];
                    <div class="fiyat-kategori-blok mb-5">
                        <!-- Kategori başlığı + toplu KDV butonu -->
                        <div class="flex justify-between items-center py-1.5 mb-2 border-b border-[var(--color-border)]">
                            <div class="text-[13px] font-bold text-[var(--color-text)]">@satir.KiraciKategoriAd</div>
                            <button type="button" onclick="topluKdvAta(this, 20)"
                                    class="text-[11px] text-muted bg-transparent border border-[var(--color-border)] rounded-md cursor-pointer p-1 px-2.5 leading-tight hover:bg-primary-light transition-colors">
                                Tüm KDV'leri 20 yap
                            </button>
                        </div>
                        <input type="hidden" name="FiyatMatrisi.Satirlar[@i].KiraciKategoriId" value="@satir.Hucreler[0].KiraciKategoriId" />
                        <table class="w-full border-collapse">
                            <thead>
                                <tr>
                                    <th class="text-left text-[11px] text-muted font-medium p-1 pr-3 pb-1.5">Borç Tipi</th>
                                    <th class="text-left text-[11px] text-muted font-medium p-1 px-3 pb-1.5 w-[145px]">Tutar</th>
                                    <th class="text-left text-[11px] text-muted font-medium p-1 px-3 pb-1.5 w-[110px]">Yöntem</th>
                                    <th class="text-left text-[11px] text-muted font-medium p-1 pl-3 pb-1.5 w-[105px]">KDV %</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int j = 0; j < satir.Hucreler.Count; j++)
                                {
                                    var hucre = satir.Hucreler[j];
                                    var kolon = Model.FiyatMatrisi.Kolonlar[j];
                                    var isIlkAy = kolon.BorcTipiDavranisi == BorcTipiDavranisi.IlkAyTekSeferlik;
                                    var isDepozito = isIlkAy;
                                    <tr data-depozito="@(isDepozito ? "true" : "false")">
                                        <!-- Borç Tipi: nokta + davranış rozeti + ad -->
                                        <td class="p-1.5 pr-3 align-middle">
                                            <input type="hidden" name="FiyatMatrisi.Satirlar[@i].Hucreler[@j].KiraciKategoriId" value="@hucre.KiraciKategoriId" />
                                            <input type="hidden" name="FiyatMatrisi.Satirlar[@i].Hucreler[@j].BorcTipiId" value="@hucre.BorcTipiId" />
                                            <div class="flex items-center gap-2">
                                                <!-- RateVarMi göstergesi -->
                                                <span title="@(hucre.RateVarMi ? "Kayıtlı fiyat" : "Varsayılan — henüz kaydedilmedi")"
                                                      class="w-2 h-2 rounded-full flex-shrink-0 @(hucre.RateVarMi ? "bg-green-500" : "bg-gray-300")"></span>
                                                <div>
                                                    <div class="flex items-center gap-1.5 mb-0.5">
                                                        <span class="text-[10px] text-muted uppercase">@kolon.BorcTipiKod</span>
                                                        @if (isIlkAy)
                                                        {
                                                            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-orange-100 text-orange-800">İlk Ay</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-100 text-blue-800">Aylık</span>
                                                        }
                                                    </div>
                                                    <div class="text-[12.5px] font-semibold">@kolon.BorcTipiAd</div>
                                                </div>
                                            </div>
                                        </td>
                                        <!-- Tutar — ₺ prefix -->
                                        <td class="p-1.5 px-3 align-middle">
                                            <div class="flex items-stretch border border-[#ced4da] rounded-md overflow-hidden bg-white focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/20 transition-all">
                                                <span class="px-2 bg-[#f8f9fa] text-xs text-[#6c757d] border-r border-[#ced4da] flex items-center">₺</span>
                                                <input type="number" step="0.01" min="0"
                                                       class="border-none outline-none p-1.5 px-2 w-[85px] text-[13px] bg-transparent"
                                                       name="FiyatMatrisi.Satirlar[@i].Hucreler[@j].BirimDeger" value="@hucre.BirimDeger.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                            </div>
                                        </td>
                                        <!-- Yöntem — DEPOZITO için kilitli -->
                                        <td class="p-1.5 px-3 align-middle">
                                            @if (isDepozito)
                                            {
                                                <input type="hidden" name="FiyatMatrisi.Satirlar[@i].Hucreler[@j].HesaplamaYontemi" value="@((int)HesaplamaYontemi.Sabit)" />
                                                <select class="form-control form-control-sm w-[90px] opacity-50 cursor-not-allowed" disabled>
                                                    <option>Sabit</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <select class="form-control form-control-sm w-[90px]"
                                                        name="FiyatMatrisi.Satirlar[@i].Hucreler[@j].HesaplamaYontemi">
                                                    <option value="@((int)HesaplamaYontemi.Sabit)" selected="@(hucre.HesaplamaYontemi == HesaplamaYontemi.Sabit)">Sabit</option>
                                                    <option value="@((int)HesaplamaYontemi.M2)" selected="@(hucre.HesaplamaYontemi == HesaplamaYontemi.M2)">m²</option>
                                                </select>
                                            }
                                        </td>
                                        <!-- KDV — % suffix -->
                                        <td class="p-1.5 pl-3 align-middle">
                                            <div class="flex items-stretch border border-[#ced4da] rounded-md overflow-hidden bg-white focus-within:border-primary focus-within:ring-1 focus-within:ring-primary/20 transition-all">
                                                <input type="number" step="0.01" min="0" max="100"
                                                       class="border-none outline-none p-1.5 px-2 w-[60px] text-[13px] bg-transparent text-right"
                                                       name="FiyatMatrisi.Satirlar[@i].Hucreler[@j].KdvOrani" value="@hucre.KdvOrani.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                <span class="px-2 bg-[#f8f9fa] text-xs text-[#6c757d] border-l border-[#ced4da] flex items-center">%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            <script>
                function topluKdvAta(btn, value) {
                    const blok = btn.closest('.fiyat-kategori-blok');
                    blok.querySelectorAll('tr[data-depozito="false"] input[name*="KdvOrani"]').forEach(function(inp) {
                        inp.value = value;
                    });
                }
            </script>
            </div>
        </div>

        @if (Model.ParentRezervasyonTarife != null)
        {
            <div class="mt-4">
                <div class="text-xs text-muted mb-1">Aşağıda tanımlama yapmazsanız genel tarife uygulanır:</div>
                <partial name="_ParentRezervasyonTarifeKart" model="Model.ParentRezervasyonTarife" />
            </div>
        }

        <!-- Rezervasyon Alanları -->
        <div class="card mt-4">
            <div class="flex items-center justify-between mb-4.5 pb-3.5 border-b border-[var(--color-border)]">
                <div>
                    <div class="text-[15px] font-bold">Rezervasyon Alanları</div>
                    <div class="text-[12.5px] text-muted mt-0.5">Toplantı salonu, etkinlik alanı gibi rezerve edilebilen ortak alanlar</div>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" @@click="addRezAlani()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Alan Ekle
                </button>
            </div>

            <template x-for="(alan, i) in rezAlanlari" :key="i">
                <div class="bg-[#fafbfc] border border-[var(--color-border)] rounded-lg p-3.5 px-4 mb-3 relative">
                    <!-- Sil butonu sağ üst -->
                    <button type="button" class="btn btn-sm text-red-600 border-red-200 bg-red-50 hover:bg-red-100 transition-colors absolute top-2.5 right-2.5"
                            @@click="removeRezAlani(i)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                    </button>
                    <!-- Üst satır: Temel bilgiler -->
                    <div class="grid grid-cols-[1fr_100px_1fr] gap-3 mb-3 mr-10">
                        <div>
                            <div class="form-label mb-1">Alan Adı *</div>
                            <input class="form-control" :name="'RezervasyonAlanlari['+i+'].Ad'" x-model="alan.ad" placeholder="Toplantı Salonu A" />
                            <span x-show="rezErrors[i]?.ad" x-text="rezErrors[i]?.ad" class="form-error"></span>
                        </div>
                        <div>
                            <div class="form-label mb-1">m² *</div>
                            <input class="form-control" type="number" min="0" :name="'RezervasyonAlanlari['+i+'].Yuzolcumu'" x-model="alan.yuzolcumu" placeholder="0" />
                            <span x-show="rezErrors[i]?.yuzolcumu" x-text="rezErrors[i]?.yuzolcumu" class="form-error"></span>
                        </div>
                        <div>
                            <div class="form-label mb-1">Alan Türü *</div>
                            <select class="form-control" :name="'RezervasyonAlanlari['+i+'].BirimTuruId'" x-model="alan.birimTuruId">
                                <option value="">— Seçiniz —</option>
                                @foreach (var bt in (IEnumerable<BirimTuru>)ViewBag.RezervasyonBirimTurleri)
                                {
                                    <option value="@bt.Id">@bt.Ad</option>
                                }
                            </select>
                            <span x-show="rezErrors[i]?.birimTuruId" x-text="rezErrors[i]?.birimTuruId" class="form-error"></span>
                        </div>
                    </div>
                    <!-- Alt satır: Ücretlendirme -->
                    <div class="grid grid-cols-[120px_120px_80px_1fr] gap-3">
                        <div>
                            <div class="form-label mb-1">Ücretsiz Süre (Dk)</div>
                            <input class="form-control" type="number" min="0" :name="'RezervasyonAlanlari['+i+'].UcretsizSureDakika'" x-model="alan.ucretsizSureDakika" placeholder="60" />
                        </div>
                        <div>
                            <div class="form-label mb-1">Saatlik Ücret (₺)</div>
                            <input class="form-control" type="number" min="0" step="0.01" :name="'RezervasyonAlanlari['+i+'].SaatlikUcret'" x-model="alan.saatlikUcret" placeholder="500" />
                        </div>
                        <div>
                            <div class="form-label mb-1">KDV %</div>
                            <input class="form-control" type="number" min="0" :name="'RezervasyonAlanlari['+i+'].KdvOrani'" x-model="alan.kdvOrani" placeholder="20" />
                        </div>
                        <div>
                            <div class="form-label mb-1">Açıklama</div>
                            <input class="form-control" :name="'RezervasyonAlanlari['+i+'].Aciklama'" x-model="alan.aciklama" placeholder="Opsiyonel" />
                        </div>
                    </div>
                </div>
            </template>

            <template x-if="rezAlanlari.length === 0">
                <div class="text-center py-6 text-muted text-[13.5px]">
                    Henüz rezervasyon alanı eklenmedi. "Alan Ekle" ile tanımlayabilirsiniz.
                </div>
            </template>
        </div>

        <!-- Adres Kartı -->
        <div class="card mt-4">
            <div class="text-[15px] font-bold mb-4.5 pb-3.5 border-b border-[var(--color-border)]">Adres Bilgileri</div>
            
            <div class="grid grid-cols-2 gap-3.5 mb-3.5">
                <div class="form-group">
                    <label class="form-label">İl *</label>
                    <input asp-for="Il" class="form-control" placeholder="Örn: İstanbul" />
                    <span asp-validation-for="Il" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">İlçe *</label>
                    <input asp-for="Ilce" class="form-control" placeholder="Örn: Şişli" />
                    <span asp-validation-for="Ilce" class="form-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Mahalle *</label>
                <input asp-for="Mahalle" class="form-control" placeholder="Örn: Cumhuriyet Mah." />
                <span asp-validation-for="Mahalle" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Açık Adres *</label>
                <textarea asp-for="AcikAdres" class="form-control" rows="2" placeholder="Sokak, Bina No, Kapı No..."></textarea>
                <span asp-validation-for="AcikAdres" class="form-error"></span>
            </div>
        </div>

        <div class="flex gap-3 mt-5">
            <button type="submit" class="btn btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Kaydet
            </button>
            <a href="/Tasinmaz" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
@{
    var birimlerJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Birimler.Count > 0
            ? (IEnumerable<object>)Model.Birimler.Select(b => new {
                birimNo = b.BirimNo ?? "",
                katNo = b.KatNo?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                ad = b.Ad ?? "",
                yuzolcumu = b.Yuzolcumu.ToString(System.Globalization.CultureInfo.InvariantCulture),
                aciklama = b.Aciklama ?? "",
                birimTuruId = b.BirimTuruId?.ToString() ?? ""
              })
            : (IEnumerable<object>)Array.Empty<object>()
    );
    var rezAlanlariJson = System.Text.Json.JsonSerializer.Serialize(
        Model.RezervasyonAlanlari.Count > 0
            ? (IEnumerable<object>)Model.RezervasyonAlanlari.Select(r => new {
                ad = r.Ad ?? "",
                yuzolcumu = r.Yuzolcumu.ToString(System.Globalization.CultureInfo.InvariantCulture),
                birimTuruId = r.BirimTuruId?.ToString() ?? "",
                aciklama = r.Aciklama ?? "",
                ucretsizSureDakika = r.UcretsizSureDakika,
                saatlikUcret = r.SaatlikUcret.ToString(System.Globalization.CultureInfo.InvariantCulture),
                kdvOrani = r.KdvOrani.ToString(System.Globalization.CultureInfo.InvariantCulture)
              })
            : (IEnumerable<object>)Array.Empty<object>()
    );
    var birimErrorsJson = System.Text.Json.JsonSerializer.Serialize(
        Enumerable.Range(0, Model.Birimler.Count).Select(i => new {
            birimNo = ViewData.ModelState[$"Birimler[{i}].BirimNo"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
            katNo   = ViewData.ModelState[$"Birimler[{i}].KatNo"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
            birimTuruId = ViewData.ModelState[$"Birimler[{i}].BirimTuruId"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
            ad      = ViewData.ModelState[$"Birimler[{i}].Ad"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
            yuzolcumu = ViewData.ModelState[$"Birimler[{i}].Yuzolcumu"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
        }).ToList()
    );
    var rezErrorsJson = System.Text.Json.JsonSerializer.Serialize(
        Enumerable.Range(0, Model.RezervasyonAlanlari.Count).Select(i => new {
            ad      = ViewData.ModelState[$"RezervasyonAlanlari[{i}].Ad"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
            yuzolcumu = ViewData.ModelState[$"RezervasyonAlanlari[{i}].Yuzolcumu"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
            birimTuruId = ViewData.ModelState[$"RezervasyonAlanlari[{i}].BirimTuruId"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "",
        }).ToList()
    );
    var initSekli = (int)Model.KiralamaSekli;
    var initTasinmazTipiId = Model.TasinmazTipiId?.ToString() ?? "";
    var tipKiralamaJson = System.Text.Json.JsonSerializer.Serialize(
        (Dictionary<int, int[]>)(ViewBag.TasinmazTipiKiralamaSekilleri ?? new Dictionary<int, int[]>())
    );
}
<script>
    function tasinmazFormData() {
        return {
            sekli: '@initSekli',
            tasinmazTipiId: '@initTasinmazTipiId',
            tipKiralamaMap: @Html.Raw(tipKiralamaJson),
            birimler: @Html.Raw(birimlerJson),
            rezAlanlari: @Html.Raw(rezAlanlariJson),
            birimErrors: @Html.Raw(birimErrorsJson),
            rezErrors: @Html.Raw(rezErrorsJson),
            izinliSet() {
                if (!this.tasinmazTipiId) return [];
                return this.tipKiralamaMap[this.tasinmazTipiId] || [];
            },
            izinli(v) {
                if (!this.tasinmazTipiId) return false;
                return this.izinliSet().includes(parseInt(v));
            },
            onTasinmazTipiChange() {
                var set = this.izinliSet();
                if (set.length === 1) {
                    this.sekli = set[0].toString();
                } else if (set.length === 0 || !set.includes(parseInt(this.sekli))) {
                    this.sekli = '';
                }
            },
            addBirim() {
                this.birimler.push({ birimNo: '', katNo: '', ad: '', yuzolcumu: '', aciklama: '', birimTuruId: '' });
                this.birimErrors.push({});
            },
            removeBirim(i) {
                this.birimler.splice(i, 1);
                this.birimErrors.splice(i, 1);
            },
            autoAd(b) { if (!b.ad && b.birimNo) b.ad = 'Birim ' + b.birimNo; },
            addRezAlani() {
                this.rezAlanlari.push({ ad: '', yuzolcumu: '', birimTuruId: '', aciklama: '', ucretsizSureDakika: 0, saatlikUcret: 0, kdvOrani: 20 });
                this.rezErrors.push({});
            },
            removeRezAlani(i) {
                this.rezAlanlari.splice(i, 1);
                this.rezErrors.splice(i, 1);
            },
            validate() {
                var ok = true;
                this.birimler.forEach(b => {
                    if (!b.ad?.trim() && b.birimNo?.trim()) b.ad = 'Birim ' + b.birimNo;
                });
                this.birimErrors = this.birimler.map(b => {
                    var e = {};
                    if (!b.birimNo?.trim()) e.birimNo = 'Birim No zorunludur.';
                    if (b.katNo === '' || b.katNo === null || b.katNo === undefined) e.katNo = 'Kat No zorunludur.';
                    if (!b.birimTuruId) e.birimTuruId = 'Birim Türü zorunludur.';
                    if (!b.ad?.trim()) e.ad = 'Ad zorunludur.';
                    if (!b.yuzolcumu || parseFloat(b.yuzolcumu) <= 0) e.yuzolcumu = 'Yüzölçümü 0\'dan büyük olmalıdır.';
                    if (Object.keys(e).length) ok = false;
                    return e;
                });
                this.rezErrors = this.rezAlanlari.map(a => {
                    var e = {};
                    if (!a.ad?.trim()) e.ad = 'Alan Adı zorunludur.';
                    if (!a.yuzolcumu || parseFloat(a.yuzolcumu) <= 0) e.yuzolcumu = 'Yüzölçümü 0\'dan büyük olmalıdır.';
                    if (!a.birimTuruId) e.birimTuruId = 'Alan Türü zorunludur.';
                    if (Object.keys(e).length) ok = false;
                    return e;
                });
                return ok;
            },
            handleSubmit(ev) {
                if (this.validate()) ev.target.submit();
            }
        };
    }
</script>
}
