@model List<KiraTakip.Models.Dtos.TasinmazListItemDto>
@using KiraTakip.Models
@{
    ViewData["Title"] = "Taşınmazlar";

    bool canEdit = User.HasPermission(PermissionCatalog.Property.Create);
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Taşınmazlar</div>
        <div class="page-subtitle">@Model.Count taşınmaz kayıtlı</div>
    </div>
    @if (canEdit)
    {
        <a href="/Tasinmaz/Ekle" class="btn btn-primary flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Taşınmaz
        </a>
    }
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    @foreach (var t in Model)
    {
        var kiraliSayi = t.KiraliBirimSayisi;
        var surekSayi = t.SuresiDolmakUzereBirimSayisi;
        var bosSayi = t.BosBirimSayisi;

        <a href="/Tasinmaz/Detay/@t.Id.ToHashId()" class="group">
            <div class="card cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                <div class="flex items-start justify-between mb-3">
                    <div>
                        <div class="text-[15px] font-bold text-slate-800 group-hover:text-primary transition-colors">@t.Ad</div>
                        <div class="text-xs text-muted mt-0.5">@t.Ilce, @t.Il</div>
                    </div>
                    <span class="badge badge-bos text-[10px] font-bold">@(string.IsNullOrEmpty(t.TasinmazTipiAd) ? "—" : t.TasinmazTipiAd)</span>
                </div>

                <div class="grid grid-cols-2 gap-2.5 mb-4">
                    @if (t.KapaliYuzolcumu > 0)
                    {
                        <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                            <div class="text-[10px] text-muted font-bold uppercase tracking-wider mb-0.5">Kapalı Alan</div>
                            <div class="text-sm font-bold text-slate-700">@t.KapaliYuzolcumu.ToString("N0") m²</div>
                        </div>
                    }
                    @if (t.AcikYuzolcumu > 0)
                    {
                        <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                            <div class="text-[10px] text-muted font-bold uppercase tracking-wider mb-0.5">Açık Alan</div>
                            <div class="text-sm font-bold text-slate-700">@t.AcikYuzolcumu.ToString("N0") m²</div>
                        </div>
                    }
                    @if (t.RentalMode == RentalMode.UnitBased)
                    {
                        <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                            <div class="text-[10px] text-muted font-bold uppercase tracking-wider mb-0.5">Ofis Sayısı</div>
                            <div class="text-sm font-bold text-slate-700">@t.BirimSayisi Ofis</div>
                        </div>
                    }
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                    <div class="flex gap-1.5 flex-wrap">
                        @if (kiraliSayi > 0) { <span class="badge badge-kirali text-[10px] font-bold px-1.5 py-0.5">@kiraliSayi Kiralı</span> }
                        @if (surekSayi > 0) { <span class="badge badge-surek text-[10px] font-bold px-1.5 py-0.5">@surekSayi Doluyor</span> }
                        @if (bosSayi > 0) { <span class="badge badge-bos text-[10px] font-bold px-1.5 py-0.5">@bosSayi Boş</span> }
                    </div>
                    <span class="text-[11px] font-semibold text-slate-400 group-hover:text-primary transition-colors flex items-center gap-1">
                        @t.BirimSayisi Birim
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="transition-transform group-hover:translate-x-0.5"><path d="M9 18l6-6-6-6"/></svg>
                    </span>
                </div>
            </div>
        </a>
    }
</div>

