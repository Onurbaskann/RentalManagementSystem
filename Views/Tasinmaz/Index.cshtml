@model List<KiraTakip.Models.Tasinmaz>
@using KiraTakip.Models
@using KiraTakip.Services.Interfaces
@inject IIstatistikService Istatistik
@{
    ViewData["Title"] = "Taşınmazlar";

    bool canEdit = User.HasClaim("permission", "Tasinmaz.Create");
}

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <div>
        <div class="page-title">Taşınmazlar</div>
        <div class="page-subtitle">@Model.Count taşınmaz kayıtlı</div>
    </div>
    @if (canEdit)
    {
        <a href="/Tasinmaz/Ekle" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Taşınmaz
        </a>
    }
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;">
    @foreach (var t in Model)
    {
        var tumBirimDurumlari = t.Birimler.Select(b => Istatistik.GetBirimDurumu(b)).ToList();
        var kiraliSayi = tumBirimDurumlari.Count(d => d == KiraDurumu.Kirali);
        var surekSayi = tumBirimDurumlari.Count(d => d == KiraDurumu.SuresiDolmakUzere);
        var bosSayi = tumBirimDurumlari.Count(d => d == KiraDurumu.Bos);

        string durumLabel = bosSayi == t.Birimler.Count ? "Boş" : (surekSayi > 0 ? "Kısmi Dolmak Üzere" : (kiraliSayi == t.Birimler.Count ? "Tam Dolu" : "Kısmi Kiralı"));

        <a href="/Tasinmaz/Detay/@t.Id" style="text-decoration:none;color:inherit;">
            <div class="card" style="cursor:pointer;transition:box-shadow 0.15s,transform 0.15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;">
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--color-text);">@t.Ad</div>
                        <div style="font-size:12px;color:var(--color-muted);margin-top:3px;">@t.Ilce, @t.Il</div>
                    </div>
                    <span class="badge badge-bos">@(t.TasinmazTipi?.Ad ?? "—")</span>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;">
                    @if (t.KapaliYuzolcumu > 0)
                    {
                        <div style="background:#f7f8fa;border-radius:8px;padding:8px 10px;">
                            <div style="font-size:11px;color:var(--color-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">Kapalı Alan</div>
                            <div style="font-size:14px;font-weight:700;">@t.KapaliYuzolcumu.ToString("N0") m²</div>
                        </div>
                    }
                    @if (t.AcikYuzolcumu > 0)
                    {
                        <div style="background:#f7f8fa;border-radius:8px;padding:8px 10px;">
                            <div style="font-size:11px;color:var(--color-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">Açık Alan</div>
                            <div style="font-size:14px;font-weight:700;">@t.AcikYuzolcumu.ToString("N0") m²</div>
                        </div>
                    }
                    @if (t.KiralamaSekli == KiralamaSekli.BirimBazli)
                    {
                        <div style="background:#f7f8fa;border-radius:8px;padding:8px 10px;">
                            <div style="font-size:11px;color:var(--color-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.04em;">Ofis Sayısı</div>
                            <div style="font-size:14px;font-weight:700;">@t.Birimler.Count ofis</div>
                        </div>
                    }
                </div>

                <div style="display:flex;align-items:center;justify-content:space-between;padding-top:12px;border-top:1px solid var(--color-border);">
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                        @if (kiraliSayi > 0) { <span class="badge badge-kirali" style="font-size:11px;">@kiraliSayi Kiralı</span> }
                        @if (surekSayi > 0) { <span class="badge badge-surek" style="font-size:11px;">@surekSayi Dolmak Üzere</span> }
                        @if (bosSayi > 0) { <span class="badge badge-bos" style="font-size:11px;">@bosSayi Boş</span> }
                    </div>
                    <span style="font-size:12px;color:var(--color-muted);">@t.Birimler.Count birim →</span>
                </div>
            </div>
        </a>
    }
</div>
