@model KiraTakip.Models.ViewModels.TasinmazDetayViewModel
@using KiraTakip.Models
@inject KiraTakip.Services.Interfaces.IIstatistikService Istatistik
@{
    ViewData["Title"] = Model.Tasinmaz.Ad;
    bool canEdit = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Sozlesme.Create) || User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Rezervasyon.Create);
    bool canManageRate = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.Birim.ManageRate);
    bool canManageCarpan = User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.TasinmazCarpanPerm.Manage);

    string DurumBadge(KiraDurumu d) => d switch {
        KiraDurumu.Kirali => "<span class='badge badge-kirali'>Kiralı</span>",
        KiraDurumu.SuresiDolmakUzere => "<span class='badge badge-surek'>Süresi Dolmak Üzere</span>",
        _ => "<span class='badge badge-bos'>Boş</span>"
    };
}

@functions {
    string KatEtiketi(int? katNo) => katNo switch
    {
        null  => "Kat Belirtilmemiş",
        0     => "Zemin Kat",
        < 0   => $"{Math.Abs(katNo.Value)}. Bodrum",
        _     => $"{katNo}. Kat"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert-success mb-4 text-[13.5px] font-medium">
        ✓ @TempData["Success"]
    </div>
}

<div class="page-header flex items-start justify-between">
    <div>
        <a href="/Tasinmaz" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Taşınmazlar
        </a>
        <div class="page-title">@Model.Tasinmaz.Ad</div>
        <div class="page-subtitle">@Model.Tasinmaz.Mahalle, @Model.Tasinmaz.Ilce / @Model.Tasinmaz.Il</div>
    </div>
    @if (canEdit)
    {
        <a href="/Sozlesme/Ekle" class="btn btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Sözleşme Ekle
        </a>
    }
</div>

<div id="detay-tabs">
    <div class="tabs">
        <button class="tab">Genel Bilgiler</button>
        <button class="tab">Birimler (@Model.Birimler.Count)</button>
        <button class="tab">Sözleşme Geçmişi</button>
        <button class="tab">Rezervasyonlar (@Model.Rezervasyonlar.Count)</button>
        <button class="tab">Kira Tarifeleri</button>
    </div>

    <!-- Tab 1: Genel Bilgiler -->
    <div class="tab-content">
        <div class="three-col">
            <div class="card">
                <div class="card-title">Taşınmaz Tipi</div>
                <div class="text-[18px] font-bold mb-1.5">@(Model.Tasinmaz.TasinmazTipi?.Ad ?? "—")</div>
                <div class="text-[13px] text-muted">
                    @(Model.Tasinmaz.KiralamaSekli == KiralamaSekli.BirimBazli ? "Birim bazlı kiralama" : "Tek parça kiralama")
                </div>
            </div>
            <div class="card">
                <div class="card-title">Yüzölçüm</div>
                @if (Model.Tasinmaz.KapaliYuzolcumu > 0)
                {
                    <div class="text-base font-bold">@Model.Tasinmaz.KapaliYuzolcumu.ToString("N0") m² <span class="text-[13px] font-normal text-muted">kapalı</span></div>
                }
                @if (Model.Tasinmaz.AcikYuzolcumu > 0)
                {
                    <div class="text-base font-bold mt-1">@Model.Tasinmaz.AcikYuzolcumu.ToString("N0") m² <span class="text-[13px] font-normal text-muted">açık</span></div>
                }
            </div>
            @if (Model.Tasinmaz.KiralamaSekli == KiralamaSekli.BirimBazli)
            {
                var kiraliSayisi = Model.Birimler.Count(b => b.Durum == KiraDurumu.Kirali || b.Durum == KiraDurumu.SuresiDolmakUzere);
                var toplamSayisi = Model.Birimler.Count;
                var bosSayisi = toplamSayisi - kiraliSayisi;
                <div class="card">
                    <div class="card-title">Doluluk Durumu</div>
                    <div class="text-[22px] font-bold mt-1">@kiraliSayisi<span class="text-[15px] font-normal text-muted">/@toplamSayisi</span></div>
                    <div class="text-xs text-muted mt-0.5">birim kiralı</div>
                    <div class="flex gap-3 mt-2.5 text-xs">
                        <span class="text-[#065f46] font-semibold">● @kiraliSayisi kiralı</span>
                        <span class="text-[#6b7c93] font-semibold">● @bosSayisi boş</span>
                    </div>
                </div>
            }
            else
            {
                var komple = Model.Birimler.FirstOrDefault();
                var aktif = komple?.AktifSozlesme;
                var durum = komple?.Durum ?? KiraDurumu.Bos;
                <div class="card">
                    <div class="card-title">Kira Durumu</div>
                    @if (aktif != null)
                    {
                        <div class="mt-1.5">
                            <span class="inline-block bg-[#ecfdf5] text-[#065f46] text-xs font-bold px-2.5 py-0.5 rounded-[10px]">
                                @(durum == KiraDurumu.SuresiDolmakUzere ? "Süresi Dolmak Üzere" : "Kiralı")
                            </span>
                        </div>
                        <div class="text-sm font-semibold mt-2">@(aktif.Kiraci?.GosterimAdi ?? "—")</div>
                        <div class="text-xs text-muted mt-0.5">
                            Bitiş: @aktif.BitisTarihi.ToString("dd.MM.yyyy")
                        </div>
                    }
                    else
                    {
                        <div class="mt-1.5">
                            <span class="inline-block bg-[#f1f5f9] text-[#475569] text-xs font-bold px-2.5 py-0.5 rounded-[10px]">Müsait</span>
                        </div>
                        <div class="text-xs text-muted mt-2">Aktif sözleşme yok</div>
                    }
                </div>
            }
        </div>

        <div class="card mt-4">
            <div class="card-title mb-3.5">Adres Bilgileri</div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <div class="detail-label mb-0.5">İl</div>
                    <div class="text-sm font-medium">@Model.Tasinmaz.Il</div>
                </div>
                <div>
                    <div class="detail-label mb-0.5">İlçe</div>
                    <div class="text-sm font-medium">@Model.Tasinmaz.Ilce</div>
                </div>
                <div>
                    <div class="detail-label mb-0.5">Mahalle</div>
                    <div class="text-sm font-medium">@Model.Tasinmaz.Mahalle</div>
                </div>
                <div>
                    <div class="detail-label mb-0.5">Açık Adres</div>
                    <div class="text-sm font-medium">@Model.Tasinmaz.AcikAdres</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Tasinmaz.Aciklama))
            {
                <div class="mt-3.5 pt-3.5 border-t border-[var(--color-border)]">
                    <div class="detail-label mb-1">Açıklama</div>
                    <div class="text-sm">@Model.Tasinmaz.Aciklama</div>
                </div>
            }
        </div>
    </div>

    <!-- Tab 2: Birimler -->
    <div class="tab-content">
        @{
            bool isBirimBazli = Model.Tasinmaz.KiralamaSekli == KiralamaSekli.BirimBazli;
            int totalBirim = Model.Birimler.Count;
            int kirali = Model.Birimler.Count(b => b.Durum == KiraDurumu.Kirali || b.Durum == KiraDurumu.SuresiDolmakUzere);
            int bos = totalBirim - kirali;
        }

        <!-- Birim Özet Kartları -->
        <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="bg-white border border-[var(--color-border)] rounded-xl p-3.5 px-4.5">
                <div class="text-[11px] font-semibold text-muted uppercase tracking-wider">Toplam Birim</div>
                <div class="font-serif text-[28px] font-bold mt-1">@totalBirim</div>
            </div>
            <div class="bg-white border border-[var(--color-border)] rounded-xl p-3.5 px-4.5">
                <div class="text-[11px] font-semibold text-[#065f46] uppercase tracking-wider">Kiralı</div>
                <div class="font-serif text-[28px] font-bold text-[#065f46] mt-1">@kirali</div>
            </div>
            <div class="bg-white border border-[var(--color-border)] rounded-xl p-3.5 px-4.5">
                <div class="text-[11px] font-semibold text-[#6b7c93] uppercase tracking-wider">Boş</div>
                <div class="font-serif text-[28px] font-bold text-[#6b7c93] mt-1">@bos</div>
            </div>
        </div>

        @if (isBirimBazli)
        {
            var katGruplari = Model.Birimler
                .GroupBy(b => b.Birim.KatNo)
                .OrderByDescending(g => g.Key ?? int.MinValue)
                .ToList();

            var katBosMapRaw = katGruplari.ToDictionary(
                g => g.Key.HasValue ? g.Key.Value.ToString() : "none",
                g => g.Any(b => b.AktifSozlesme == null)
            );
            var katKiraliMapRaw = katGruplari.ToDictionary(
                g => g.Key.HasValue ? g.Key.Value.ToString() : "none",
                g => g.Any(b => b.AktifSozlesme != null)
            );
            var katBosMapJson = System.Text.Json.JsonSerializer.Serialize(katBosMapRaw);
            var katKiraliMapJson = System.Text.Json.JsonSerializer.Serialize(katKiraliMapRaw);

            <div x-data='{ "filter": "tum", "openFloors": {}, "search": "", "katBosMap": @Html.Raw(katBosMapJson), "katKiraliMap": @Html.Raw(katKiraliMapJson) }'
                 x-init="$watch('filter', v => {
                     if (v !== 'tum') {
                         for (const [k, hasEmpty] of Object.entries(katBosMap)) {
                             if (v === 'bos') openFloors[k] = hasEmpty;
                             else if (v === 'kirali') openFloors[k] = katKiraliMap[k];
                             else openFloors[k] = false;
                         }
                     }
                 })">

                <!-- Filtre Bar -->
                <div class="flex items-center gap-2.5 mb-6 flex-wrap">
                    <select x-model="filter" class="form-control w-auto min-w-[150px] text-[13px] py-1.5 px-2.5">
                        <option value="tum">Tüm Birimler</option>
                        <option value="bos">Boş</option>
                        <option value="kirali">Kiralı</option>
                    </select>
                    <input type="text" x-model="search" placeholder="Birim ara..." class="form-control w-[180px] text-[13px] py-1.5 px-2.5" />
                    <button type="button" class="btn btn-sm btn-secondary"
                            @@click="filter = 'tum'; Object.keys(katBosMap).forEach(k => { openFloors[k] = true })">
                        Tümünü Aç
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary"
                            @@click="filter = 'tum'; Object.keys(katBosMap).forEach(k => { openFloors[k] = false })">
                        Tümünü Kapat
                    </button>
                </div>

                <!-- Kat Accordion'ları -->
                @foreach (var grup in katGruplari)
                {
                    var katKey = grup.Key.HasValue ? grup.Key.Value.ToString() : "none";
                    int katBirimSayisi = grup.Count();
                    int katBos = grup.Count(b => b.AktifSozlesme == null);
                    int katRez = grup.Count(b => b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true);

                    <div class="mb-2">
                        <!-- Accordion Header -->
                        <div @@click="openFloors['@katKey'] = !openFloors['@katKey']"
                             class="flex items-center gap-2.5 p-2.5 px-3.5 bg-primary-light border border-[#a3e0d2] rounded-lg cursor-pointer select-none"
                             :class="openFloors['@katKey'] ? 'rounded-b-none border-b-transparent' : ''">
                            <svg :class="openFloors['@katKey'] ? 'rotate-90' : ''"
                                 class="transition-transform duration-200 flex-shrink-0"
                                 width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5">
                                 <polyline points="9 18 15 12 9 6"/>
                            </svg>
                            <span class="text-[13px] font-bold text-primary">@KatEtiketi(grup.Key)</span>
                            <span class="text-xs text-muted font-medium">
                                @katBirimSayisi birim@(katBos > 0 ? $" · {katBos} boş" : "")@(katRez > 0 ? $" · {katRez} rezervasyon" : "")
                            </span>
                            <div class="h-[1px] flex-1 bg-[#a3e0d2]"></div>
                        </div>

                        <!-- Accordion Body -->
                        <div x-show="openFloors['@katKey']" x-cloak>
                            <div class="card p-0 overflow-hidden rounded-t-none border-t-0">
                                <div class="table-wrapper m-0">
                                    <table class="table-fixed w-full">
                                        <colgroup>
                                            <col class="w-[72px]" />
                                            <col class="w-auto" />
                                            <col class="w-[80px]" />
                                            <col class="w-[130px]" />
                                            <col class="w-auto" />
                                            <col class="w-[125px]" />
                                            <col class="w-[140px]" />
                                            <col class="w-[110px]" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>No</th>
                                                <th>Ad</th>
                                                <th>m²</th>
                                                <th>Durum</th>
                                                <th>Kiracı</th>
                                                <th>Bitiş</th>
                                                <th>Bedel</th>
                                                <th class="text-center">İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var b in grup.OrderBy(x => x.Birim.BirimNo))
                                            {
                                                var durumData = b.AktifSozlesme != null ? "kirali" : "bos";
                                                var searchData = ((b.Birim.BirimNo ?? "") + " " + (b.Birim.Ad ?? "")).ToLowerInvariant();
                                                <tr data-durum="@durumData"
                                                    data-search="@searchData"
                                                    x-show="(filter === 'tum' || $el.getAttribute('data-durum') === filter) && (search === '' || $el.getAttribute('data-search').includes(search.toLowerCase()))">
                                                    <td>
                                                        <span class="font-mono text-[13px] font-bold text-primary bg-primary-light px-2 py-0.5 rounded-md">@b.Birim.BirimNo</span>
                                                    </td>
                                                    <td class="font-semibold text-[13.5px]">@b.Birim.Ad</td>
                                                    <td>
                                                        <span class="font-mono text-[12.5px] text-muted">@b.Birim.Yuzolcumu.ToString("N0")</span>
                                                        <span class="text-[11px] text-muted">m²</span>
                                                    </td>
                                                    <td>@Html.Raw(DurumBadge(b.Durum))</td>
                                                    <td>
                                                        @if (b.AktifSozlesme != null)
                                                        {
                                                            <a href="/Kiraci/Detay/@b.AktifSozlesme.KiraciId" class="font-semibold text-primary no-underline text-[13px] hover:underline">@b.AktifSozlesme.Kiraci.GosterimAdi</a>
                                                        }
                                                        else { <span class="text-[#c8cfd8]">—</span> }
                                                    </td>
                                                    <td>
                                                        @if (b.AktifSozlesme != null)
                                                        {
                                                            var kalanGun = (int)(b.AktifSozlesme.BitisTarihi - DateTime.Now).TotalDays;
                                                            <div class="flex items-center gap-1.5">
                                                                <span class="text-[13px] font-medium">@b.AktifSozlesme.BitisTarihi.ToString("dd.MM.yyyy")</span>
                                                                @if (kalanGun <= 30) { <span class="day-badge @(kalanGun <= 10 ? "day-badge-red" : "day-badge-amber") text-[10.5px] px-1.5 py-0.5">@kalanGun g</span> }
                                                            </div>
                                                        }
                                                        else { <span class="text-[#c8cfd8]">—</span> }
                                                    </td>
                                                    <td>
                                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                                        {
                                                            @if (b.RezKural != null)
                                                            {
                                                                <span class="font-serif font-bold text-[13.5px]">@b.RezKural.PeriyotUcreti.ToString("N0") ₺</span>
                                                                <span class="text-[11px] text-muted ml-0.5">/ @b.RezKural.UcretlendirmePeriyoduDakika dk</span>
                                                            }
                                                            else { <span class="text-[#c8cfd8] text-xs">genel tarife</span> }
                                                        }
                                                        else if (b.AktifSozlesme != null)
                                                        {
                                                            <div>
                                                                <span class="font-serif font-bold text-sm">@b.AylikBedel.ToString("N0") ₺</span>
                                                                <span class="text-[11px] text-muted ml-0.5">/ay</span>
                                                            </div>
                                                        }
                                                        else { <span class="text-[#c8cfd8]">—</span> }
                                                    </td>
                                                    <td class="text-center flex gap-1 justify-center flex-wrap">
                                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                                        {
                                                            @if (canEdit)
                                                            {
                                                                <a href="/Rezervasyon/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Rezervasyon</a>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (b.AktifSozlesme != null)
                                                            {
                                                                <a href="/Sozlesme/Detay/@b.AktifSozlesme.Id" class="btn btn-sm btn-secondary">Sözleşme</a>
                                                            }
                                                            else if (canEdit)
                                                            {
                                                                <a href="/Sozlesme/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Kiraya Ver</a>
                                                            }
                                                        }
                                                        @if (canManageRate)
                                                        {
                                                            <a href="/Birim/@b.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary" title="Özel Fiyatlar">₺</a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card p-0 overflow-hidden">
                <div class="table-wrapper m-0">
                    <table class="table-fixed w-full">
                        <colgroup>
                            <col class="w-auto" />
                            <col class="w-[90px]" />
                            <col class="w-[140px]" />
                            <col class="w-auto" />
                            <col class="w-[130px]" />
                            <col class="w-[140px]" />
                            <col class="w-[110px]" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Birim</th>
                                <th>Yüzölçüm</th>
                                <th>Durum</th>
                                <th>Kiracı</th>
                                <th>Bitiş Tarihi</th>
                                <th>Bedel</th>
                                <th class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Birimler)
                            {
                                <tr>
                                    <td class="font-semibold">@b.Birim.Ad</td>
                                    <td>
                                        <span class="font-mono text-[12.5px] text-muted">@b.Birim.Yuzolcumu.ToString("N0")</span>
                                        <span class="text-[11px] text-muted">m²</span>
                                    </td>
                                    <td>@Html.Raw(DurumBadge(b.Durum))</td>
                                    <td>
                                        @if (b.AktifSozlesme != null)
                                        {
                                            <a href="/Kiraci/Detay/@b.AktifSozlesme.KiraciId" class="font-semibold text-primary no-underline text-[13px] hover:underline">@b.AktifSozlesme.Kiraci.GosterimAdi</a>
                                        }
                                        else { <span class="text-[#c8cfd8]">—</span> }
                                    </td>
                                    <td>
                                        @if (b.AktifSozlesme != null)
                                        {
                                            var kalanGun = (int)(b.AktifSozlesme.BitisTarihi - DateTime.Now).TotalDays;
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-[13px] font-medium">@b.AktifSozlesme.BitisTarihi.ToString("dd.MM.yyyy")</span>
                                                @if (kalanGun <= 30) { <span class="day-badge @(kalanGun <= 10 ? "day-badge-red" : "day-badge-amber") text-[10.5px] px-1.5 py-0.5">@kalanGun g</span> }
                                            </div>
                                        }
                                        else { <span class="text-[#c8cfd8]">—</span> }
                                    </td>
                                    <td>
                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                        {
                                            @if (b.RezKural != null)
                                            {
                                                <span class="font-serif font-bold text-[13.5px]">@b.RezKural.PeriyotUcreti.ToString("N0") ₺</span>
                                                <span class="text-[11px] text-muted ml-0.5">/ @b.RezKural.UcretlendirmePeriyoduDakika dk</span>
                                            }
                                            else { <span class="text-[#c8cfd8] text-xs">genel tarife</span> }
                                        }
                                        else if (b.AktifSozlesme != null)
                                        {
                                            <div>
                                                <span class="font-serif font-bold text-sm">@b.AylikBedel.ToString("N0") ₺</span>
                                                <span class="text-[11px] text-muted ml-0.5">/ay</span>
                                            </div>
                                        }
                                        else { <span class="text-[#c8cfd8]">—</span> }
                                    </td>
                                    <td class="text-center flex gap-1 justify-center flex-wrap">
                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                        {
                                            @if (canEdit)
                                            {
                                                <a href="/Rezervasyon/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Rezervasyon</a>
                                            }
                                        }
                                        else
                                        {
                                            @if (b.AktifSozlesme != null)
                                            {
                                                <a href="/Sozlesme/Detay/@b.AktifSozlesme.Id" class="btn btn-sm btn-secondary">Sözleşme</a>
                                            }
                                            else if (canEdit)
                                            {
                                                <a href="/Sozlesme/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Kiraya Ver</a>
                                            }
                                        }
                                        @if (canManageRate)
                                        {
                                                            <a href="/Birim/@b.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary" title="Özel Fiyatlar">₺</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 3: Sözleşme Geçmişi -->
    <div class="tab-content">
        @{
            var tumSozlesmeler = Model.Birimler
                .SelectMany(b => b.Birim.Sozlesmeler)
                .OrderByDescending(s => s.BaslangicTarihi)
                .ToList();
        }
        @if (!tumSozlesmeler.Any())
        {
            <div class="p-8 text-center text-muted">Henüz sözleşme kaydı yok.</div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Birim</th>
                            <th>Kiracı</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Bedel <span class="text-[10.5px] font-normal text-muted">(tam ay)</span></th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in tumSozlesmeler)
                        {
                            bool aktif = s.BaslangicTarihi <= DateTime.Now && s.BitisTarihi >= DateTime.Now;
                            bool surek = aktif && (s.BitisTarihi - DateTime.Now).TotalDays <= 30;
                            <tr>
                                <td class="font-semibold">@s.Birim.Ad</td>
                                <td>
                                    <a href="/Kiraci/Detay/@s.KiraciId" class="text-primary no-underline font-medium hover:underline">@s.Kiraci.GosterimAdi</a>
                                </td>
                                <td>@s.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                                <td>@s.BitisTarihi.ToString("dd.MM.yyyy")</td>
                                <td class="font-semibold">@((Model.SozlesmeAylikBedelleri.TryGetValue(s.Id, out var sBedel) ? sBedel : 0m).ToString("N0")) ₺/ay</td>
                                <td>
                                    @if (surek) { <span class="badge badge-surek">Dolmak Üzere</span> }
                                    else if (aktif) { <span class="badge badge-kirali">Aktif</span> }
                                    else { <span class="badge badge-gecmis">Geçmiş</span> }
                                </td>
                                <td><a href="/Sozlesme/Detay/@s.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Tab 4: Rezervasyonlar -->
    <div class="tab-content">
        @if (!Model.Rezervasyonlar.Any())
        {
            <div class="p-8 text-center text-muted">Henüz rezervasyon kaydı yok.</div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Birim</th>
                            <th>Kiracı</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Süre</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rezervasyonlar)
                        {
                            var rezDurumBadge = r.Durum switch {
                                KiraTakip.Models.RezervasyonDurumu.Planlandi         => "<span class='badge bg-blue-100 text-blue-800'>Planlandı</span>",
                                KiraTakip.Models.RezervasyonDurumu.Tamamlandi        => "<span class='badge badge-kirali'>Tamamlandı</span>",
                                KiraTakip.Models.RezervasyonDurumu.IptalEdildi       => "<span class='badge badge-gecmis'>İptal</span>",
                                KiraTakip.Models.RezervasyonDurumu.TahakkukaAktarildi => "<span class='badge badge-surek'>Aktarıldı</span>",
                                _ => "<span class='badge'>—</span>"
                            };
                            <tr>
                                <td class="font-semibold">@r.Birim.Ad</td>
                                <td>
                                    <a href="/Kiraci/Detay/@r.KiraciId" class="text-primary no-underline font-medium hover:underline">@r.Kiraci.GosterimAdi</a>
                                </td>
                                <td>@r.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@r.BitisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="font-mono text-[12.5px]">@r.ToplamSureDakika dk</span>
                                    @if (r.UcretsizSureDakika > 0)
                                    {
                                        <span class="text-[11px] text-muted"> (@r.UcretsizSureDakika dk ücretsiz)</span>
                                    }
                                </td>
                                <td class="font-semibold">@r.ToplamTutar.ToString("N0") ₺</td>
                                <td>@Html.Raw(rezDurumBadge)</td>
                                <td><a href="/Rezervasyon/Detay/@r.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Tab 5: Kira Tarifeleri -->
    <div class="tab-content">

        <!-- Bölüm 1: Taşınmaz Tarifeleri (Genel Tarife) -->
        <div class="flex justify-between items-center mb-3.5 pb-3 border-b-2 border-[var(--color-border)]">
            <div>
                <div class="text-[15px] font-bold">Taşınmaz Tarifeleri</div>
                <div class="text-xs text-muted mt-1">Sözleşme oluşturulurken varsayılan olarak kullanılır. Birim bazlı özel fiyat tanımlıysa bu tarife geçersiz kalır.</div>
            </div>
        </div>

        <div class="table-wrapper overflow-x-auto m-0 mb-8">
            <table class="table table-bordered min-w-[800px]">
                <thead>
                    <tr>
                        <th class="w-[180px]">Kiracı Kategorisi</th>
                        @foreach (var col in Model.FiyatMatrisi.Kolonlar)
                        {
                            <th class="text-center">
                                <div class="text-[11px] text-muted mb-0.5">@col.BorcTipiKod</div>
                                <div class="text-[13px]">@col.BorcTipiAd</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var satir in Model.FiyatMatrisi.Satirlar)
                    {
                        <tr>
                            <td class="font-semibold align-middle bg-[#fafbfc]">@satir.KiraciKategoriAd</td>
                            @foreach (var hucre in satir.Hucreler)
                            {
                                <td class="p-3 text-center @(hucre.RateVarMi ? "" : "bg-[#f9fafb]")">
                                    @if (hucre.RateVarMi)
                                    {
                                        <div class="font-serif font-bold text-[15px]">
                                            @hucre.BirimDeger.ToString("N2") ₺
                                            <small class="font-sans text-[11px] font-normal text-muted">
                                                @(hucre.HesaplamaYontemi == HesaplamaYontemi.Sabit ? "/sabit" : "/m²")
                                            </small>
                                        </div>
                                        <div class="text-[11px] text-muted mt-1">KDV: %@hucre.KdvOrani.ToString("N0")</div>
                                    }
                                    else
                                    {
                                        <div class="text-[#c8cfd8] text-xs">Tanımsız</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Bölüm 2: Birim Bazlı Özel Fiyatlar -->
        <div class="flex justify-between items-center mb-3.5 pb-3 border-b-2 border-[var(--color-border)]">
            <div>
                <div class="text-[15px] font-bold">Birim Bazlı Özel Fiyatlar</div>
                <div class="text-xs text-muted mt-1">Aşağıdaki birimler için taşınmaz tarifesi yerine bu özel fiyatlar geçerlidir.</div>
            </div>
        </div>

        @if (Model.BirimOzelFiyatlari.Any())
        {
            <div class="mb-8">
                @foreach (var birimOzet in Model.BirimOzelFiyatlari)
                {
                    <div class="card mb-2.5 p-0 overflow-hidden">
                        <div class="flex items-center justify-between p-2.5 px-4 bg-[#fafbfc] border-b border-[var(--color-border)]">
                            <div class="flex items-center gap-2.5">
                                @if (!string.IsNullOrEmpty(birimOzet.Birim.BirimNo))
                                {
                                    <span class="font-mono text-[13px] font-bold text-primary bg-primary-light px-2 py-0.5 rounded-md">@birimOzet.Birim.BirimNo</span>
                                }
                                <span class="text-[13.5px] font-bold">@(birimOzet.Birim.Ad ?? "—")</span>
                                <span class="badge badge-kirali text-[10.5px]">@birimOzet.Rateler.Count özel fiyat</span>
                            </div>
                            @if (canManageRate)
                            {
                                <a href="/Birim/@birimOzet.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary">Düzenle</a>
                            }
                        </div>
                        <div class="table-wrapper m-0">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Kiracı Kategorisi</th>
                                        <th>Ücret Tipi</th>
                                        <th>Hesaplama</th>
                                        <th>Fiyat</th>
                                        <th>KDV</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in birimOzet.Rateler)
                                    {
                                        <tr>
                                            <td class="font-semibold">@r.KiraciKategori.Ad</td>
                                            <td>@r.BorcTipi.Ad</td>
                                            <td class="text-xs text-muted">@(r.HesaplamaYontemi == HesaplamaYontemi.Sabit ? "Sabit" : "m² bazlı")</td>
                                            <td class="font-serif font-bold">@r.BirimDeger.ToString("N2") ₺</td>
                                            <td class="text-[12.5px] text-muted">%@r.KdvOrani.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-3.5 px-4.5 bg-[#f9fafb] border border-[var(--color-border)] rounded-lg text-[13px] text-muted mb-8">
                Tüm birimler için taşınmaz tarifeleri geçerlidir. Birim bazlı özel fiyat tanımlı değil.
            </div>
        }

        <!-- Bölüm 3: Rezervasyon Ücret Kuralları -->
        @{
            var rezBirimler = Model.Birimler.Where(b => b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true).ToList();
        }
        @if (rezBirimler.Any())
        {
            <div class="flex justify-between items-center mb-3.5 pb-3 border-b-2 border-[var(--color-border)]">
                <div>
                    <div class="text-[15px] font-bold">Rezervasyon Ücret Kuralları</div>
                    <div class="text-xs text-muted mt-1">Rezervasyon birimi olan birimlerin saatlik/periyotluk ücretlendirme kuralları.</div>
                </div>
            </div>
            <div class="table-wrapper m-0">
                <table>
                    <thead>
                        <tr>
                            <th>Birim</th>
                            <th>Kural</th>
                            <th>Periyot Ücreti</th>
                            <th>Periyot</th>
                            <th>Ücretsiz Süre</th>
                            <th>KDV</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in rezBirimler)
                        {
                            var ozelKural = Model.BirimRezervasyonKurallari.FirstOrDefault(k => k.BirimId == b.Birim.Id);
                            var aktifKural = ozelKural ?? Model.GlobalRezervasyonKural;
                            <tr>
                                <td class="font-semibold">@(b.Birim.Ad ?? b.Birim.BirimNo)</td>
                                <td>
                                    @if (ozelKural != null)
                                    {
                                        <span class="badge badge-kirali">Özel</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted">Global</span>
                                    }
                                </td>
                                @if (aktifKural != null)
                                {
                                    <td class="font-semibold">@aktifKural.PeriyotUcreti.ToString("N0") ₺</td>
                                    <td>@aktifKural.UcretlendirmePeriyoduDakika dk</td>
                                    <td>@aktifKural.UcretsizSureDakika dk</td>
                                    <td>%@aktifKural.KdvOrani.ToString("N0")</td>
                                }
                                else
                                {
                                    <td colspan="4" class="text-[#c8cfd8] text-xs">Kural tanımlı değil</td>
                                }
                                <td>
                                    @if (canManageRate)
                                    {
                                        <a href="/Birim/@b.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary">Düzenle</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>initTabs('detay-tabs');</script>
}
