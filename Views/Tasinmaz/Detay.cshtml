@model KiraTakip.Models.ViewModels.TasinmazDetayViewModel
@using KiraTakip.Models
@{
    ViewData["Title"] = Model.Tasinmaz.Ad;
    bool canEdit = User.IsInRole("Admin") || User.IsInRole("Yonetici");
    bool canManageRate = User.IsInRole("Admin") || User.HasClaim("permission", "Birim.ManageRate");
    bool canManageCarpan = User.HasClaim("permission", "TasinmazCarpan.Manage");

    string DurumBadge(KiraDurumu d) => d switch {
        KiraDurumu.Kirali => "<span class='badge badge-kirali'>Kiralı</span>",
        KiraDurumu.SuresiDolmakUzere => "<span class='badge badge-surek'>Süresi Dolmak Üzere</span>",
        _ => "<span class='badge badge-bos'>Boş</span>"
    };
}

@functions {
    string KatEtiketi(int? katNo) => katNo switch
    {
        null  => "Kat Belirtilmemiş",
        0     => "Zemin Kat",
        < 0   => $"{Math.Abs(katNo.Value)}. Bodrum",
        _     => $"{katNo}. Kat"
    };
}

@if (TempData["Success"] != null)
{
    <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13.5px;font-weight:500;">
        ✓ @TempData["Success"]
    </div>
}

<div class="page-header" style="display:flex;align-items:flex-start;justify-content:space-between;">
    <div>
        <a href="/Tasinmaz" style="font-size:12.5px;color:var(--color-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;">
            ← Taşınmazlar
        </a>
        <div class="page-title">@Model.Tasinmaz.Ad</div>
        <div class="page-subtitle">@Model.Tasinmaz.Mahalle, @Model.Tasinmaz.Ilce / @Model.Tasinmaz.Il</div>
    </div>
    @if (canEdit)
    {
        <a href="/Sozlesme/Ekle" class="btn btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Sözleşme Ekle
        </a>
    }
</div>

<div id="detay-tabs">
    <div class="tabs">
        <button class="tab">Genel Bilgiler</button>
        <button class="tab">Birimler (@Model.Birimler.Count)</button>
        <button class="tab">Sözleşme Geçmişi</button>
        <button class="tab">Rezervasyonlar (@Model.Rezervasyonlar.Count)</button>
        <button class="tab">Kira Tarifeleri</button>
    </div>

    <!-- Tab 1: Genel Bilgiler -->
    <div class="tab-content">
        <div class="three-col">
            <div class="card">
                <div class="card-title">Taşınmaz Tipi</div>
                <div style="font-size:18px;font-weight:700;margin-bottom:6px;">@(Model.Tasinmaz.TasinmazTipi?.Ad ?? "—")</div>
                <div style="font-size:13px;color:var(--color-muted);">
                    @(Model.Tasinmaz.KiralamaSekli == KiralamaSekli.BirimBazli ? "Birim bazlı kiralama" : "Tek parça kiralama")
                </div>
            </div>
            <div class="card">
                <div class="card-title">Yüzölçüm</div>
                @if (Model.Tasinmaz.KapaliYuzolcumu > 0)
                {
                    <div style="font-size:16px;font-weight:700;">@Model.Tasinmaz.KapaliYuzolcumu.ToString("N0") m² <span style="font-size:13px;font-weight:400;color:var(--color-muted);">kapalı</span></div>
                }
                @if (Model.Tasinmaz.AcikYuzolcumu > 0)
                {
                    <div style="font-size:16px;font-weight:700;margin-top:4px;">@Model.Tasinmaz.AcikYuzolcumu.ToString("N0") m² <span style="font-size:13px;font-weight:400;color:var(--color-muted);">açık</span></div>
                }
            </div>
            @if (Model.Tasinmaz.KatSayisi.HasValue)
            {
                <div class="card">
                    <div class="card-title">Kat Sayısı <span style="font-size:11px;font-weight:400;color:var(--color-muted);">(bilgi)</span></div>
                    <div class="card-value">@Model.Tasinmaz.KatSayisi</div>
                    <div style="font-size:13px;color:var(--color-muted);">kat</div>
                </div>
            }
        </div>

        <div class="card" style="margin-top:16px;">
            <div class="card-title" style="margin-bottom:14px;">Adres Bilgileri</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div>
                    <div style="font-size:12px;color:var(--color-muted);font-weight:600;margin-bottom:3px;">İl</div>
                    <div style="font-size:14px;font-weight:500;">@Model.Tasinmaz.Il</div>
                </div>
                <div>
                    <div style="font-size:12px;color:var(--color-muted);font-weight:600;margin-bottom:3px;">İlçe</div>
                    <div style="font-size:14px;font-weight:500;">@Model.Tasinmaz.Ilce</div>
                </div>
                <div>
                    <div style="font-size:12px;color:var(--color-muted);font-weight:600;margin-bottom:3px;">Mahalle</div>
                    <div style="font-size:14px;font-weight:500;">@Model.Tasinmaz.Mahalle</div>
                </div>
                <div>
                    <div style="font-size:12px;color:var(--color-muted);font-weight:600;margin-bottom:3px;">Açık Adres</div>
                    <div style="font-size:14px;font-weight:500;">@Model.Tasinmaz.AcikAdres</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Tasinmaz.Aciklama))
            {
                <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--color-border);">
                    <div style="font-size:12px;color:var(--color-muted);font-weight:600;margin-bottom:4px;">Açıklama</div>
                    <div style="font-size:14px;">@Model.Tasinmaz.Aciklama</div>
                </div>
            }
        </div>
    </div>

    <!-- Tab 2: Birimler -->
    <div class="tab-content">
        @{
            bool isOfisBazli = Model.Tasinmaz.KiralamaSekli == KiralamaSekli.BirimBazli;
            int totalBirim = Model.Birimler.Count;
            int kirali = Model.Birimler.Count(b => b.Durum == KiraDurumu.Kirali || b.Durum == KiraDurumu.SuresiDolmakUzere);
            int bos = totalBirim - kirali;
        }

        <!-- Birim Özet Kartları -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px;">
            <div style="background:white;border:1px solid var(--color-border);border-radius:10px;padding:14px 18px;">
                <div style="font-size:11px;font-weight:600;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;">Toplam Birim</div>
                <div style="font-family:'Fraunces',Georgia,serif;font-size:28px;font-weight:700;margin-top:4px;">@totalBirim</div>
            </div>
            <div style="background:white;border:1px solid var(--color-border);border-radius:10px;padding:14px 18px;">
                <div style="font-size:11px;font-weight:600;color:#065f46;text-transform:uppercase;letter-spacing:0.05em;">Kiralı</div>
                <div style="font-family:'Fraunces',Georgia,serif;font-size:28px;font-weight:700;color:#065f46;margin-top:4px;">@kirali</div>
            </div>
            <div style="background:white;border:1px solid var(--color-border);border-radius:10px;padding:14px 18px;">
                <div style="font-size:11px;font-weight:600;color:#6b7c93;text-transform:uppercase;letter-spacing:0.05em;">Boş</div>
                <div style="font-family:'Fraunces',Georgia,serif;font-size:28px;font-weight:700;color:#6b7c93;margin-top:4px;">@bos</div>
            </div>
        </div>

        @if (isOfisBazli)
        {
            var katGruplari = Model.Birimler
                .GroupBy(b => b.Birim.KatNo)
                .OrderByDescending(g => g.Key ?? int.MinValue)
                .ToList();

            var katBosMapRaw = katGruplari.ToDictionary(
                g => g.Key.HasValue ? g.Key.Value.ToString() : "none",
                g => g.Any(b => b.AktifSozlesme == null)
            );
            var katKiraliMapRaw = katGruplari.ToDictionary(
                g => g.Key.HasValue ? g.Key.Value.ToString() : "none",
                g => g.Any(b => b.AktifSozlesme != null)
            );
            var katBosMapJson = System.Text.Json.JsonSerializer.Serialize(katBosMapRaw);
            var katKiraliMapJson = System.Text.Json.JsonSerializer.Serialize(katKiraliMapRaw);

            <div x-data='{ "filter": "tum", "openFloors": {}, "search": "", "katBosMap": @Html.Raw(katBosMapJson), "katKiraliMap": @Html.Raw(katKiraliMapJson) }'
                 x-init="$watch('filter', v => {
                     if (v !== 'tum') {
                         for (const [k, hasEmpty] of Object.entries(katBosMap)) {
                             if (v === 'bos') openFloors[k] = hasEmpty;
                             else if (v === 'kirali') openFloors[k] = katKiraliMap[k];
                             else openFloors[k] = false;
                         }
                     }
                 })">

                <!-- Filtre Bar -->
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap;">
                    <select x-model="filter" class="form-control" style="width:auto;min-width:150px;font-size:13px;padding:6px 10px;">
                        <option value="tum">Tüm Birimler</option>
                        <option value="bos">Boş</option>
                        <option value="kirali">Kiralı</option>
                    </select>
                    <input type="text" x-model="search" placeholder="Birim ara..." class="form-control" style="width:180px;font-size:13px;padding:6px 10px;" />
                    <button type="button" class="btn btn-sm btn-secondary"
                            @@click="filter = 'tum'; Object.keys(katBosMap).forEach(k => { openFloors[k] = true })">
                        Tümünü Aç
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary"
                            @@click="filter = 'tum'; Object.keys(katBosMap).forEach(k => { openFloors[k] = false })">
                        Tümünü Kapat
                    </button>
                </div>

                <!-- Kat Accordion'ları -->
                @foreach (var grup in katGruplari)
                {
                    var katKey = grup.Key.HasValue ? grup.Key.Value.ToString() : "none";
                    int katBirimSayisi = grup.Count();
                    int katBos = grup.Count(b => b.AktifSozlesme == null);
                    int katRez = grup.Count(b => b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true);

                    <div style="margin-bottom:8px;">
                        <!-- Accordion Header -->
                        <div @@click="openFloors['@katKey'] = !openFloors['@katKey']"
                             style="display:flex;align-items:center;gap:10px;padding:9px 14px;background:var(--color-primary-light);border:1px solid #a3e0d2;border-radius:8px;cursor:pointer;user-select:none;"
                             :style="openFloors['@katKey'] ? 'border-radius:8px 8px 0 0;border-bottom-color:transparent;' : ''">
                            <svg :style="openFloors['@katKey'] ? 'transform:rotate(90deg)' : ''"
                                 style="transition:transform 0.18s;flex-shrink:0;"
                                 width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                            <span style="font-size:13px;font-weight:700;color:var(--color-primary);">@KatEtiketi(grup.Key)</span>
                            <span style="font-size:12px;color:var(--color-muted);font-weight:500;">
                                @katBirimSayisi birim@(katBos > 0 ? $" · {katBos} boş" : "")@(katRez > 0 ? $" · {katRez} rezervasyon" : "")
                            </span>
                            <div style="height:1px;flex:1;background:#a3e0d2;"></div>
                        </div>

                        <!-- Accordion Body -->
                        <div x-show="openFloors['@katKey']" style="display:none;">
                            <div class="card" style="padding:0;overflow:hidden;border-radius:0 0 8px 8px;border-top:none;">
                                <div class="table-wrapper" style="margin:0;">
                                    <table style="table-layout:fixed;width:100%;">
                                        <colgroup>
                                            <col style="width:72px;" />
                                            <col style="width:auto;" />
                                            <col style="width:80px;" />
                                            <col style="width:130px;" />
                                            <col style="width:auto;" />
                                            <col style="width:125px;" />
                                            <col style="width:140px;" />
                                            <col style="width:110px;" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>No</th>
                                                <th>Ad</th>
                                                <th>m²</th>
                                                <th>Durum</th>
                                                <th>Kiracı</th>
                                                <th>Bitiş</th>
                                                <th>Bedel</th>
                                                <th style="text-align:center;">İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var b in grup.OrderBy(x => x.Birim.OfisNo))
                                            {
                                                var durumData = b.AktifSozlesme != null ? "kirali" : "bos";
                                                var searchData = ((b.Birim.OfisNo ?? "") + " " + (b.Birim.Ad ?? "")).ToLowerInvariant();
                                                <tr data-durum="@durumData"
                                                    data-search="@searchData"
                                                    x-show="(filter === 'tum' || $el.getAttribute('data-durum') === filter) && (search === '' || $el.getAttribute('data-search').includes(search.toLowerCase()))">
                                                    <td>
                                                        <span style="font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--color-primary);background:var(--color-primary-light);padding:3px 8px;border-radius:6px;">@b.Birim.OfisNo</span>
                                                    </td>
                                                    <td style="font-weight:600;font-size:13.5px;">@b.Birim.Ad</td>
                                                    <td>
                                                        <span style="font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--color-muted);">@b.Birim.Yuzolcumu.ToString("N0")</span>
                                                        <span style="font-size:11px;color:var(--color-muted);">m²</span>
                                                    </td>
                                                    <td>@Html.Raw(DurumBadge(b.Durum))</td>
                                                    <td>
                                                        @if (b.AktifSozlesme != null)
                                                        {
                                                            <a href="/Kiraci/Detay/@b.AktifSozlesme.KiraciId" style="font-weight:600;color:var(--color-primary);text-decoration:none;font-size:13px;">@b.AktifSozlesme.Kiraci.GosterimAdi</a>
                                                        }
                                                        else { <span style="color:#c8cfd8;">—</span> }
                                                    </td>
                                                    <td>
                                                        @if (b.AktifSozlesme != null)
                                                        {
                                                            var kalanGun = (int)(b.AktifSozlesme.BitisTarihi - DateTime.Now).TotalDays;
                                                            <div style="display:flex;align-items:center;gap:6px;">
                                                                <span style="font-size:13px;font-weight:500;">@b.AktifSozlesme.BitisTarihi.ToString("dd.MM.yyyy")</span>
                                                                @if (kalanGun <= 30) { <span class="day-badge @(kalanGun <= 10 ? "day-badge-red" : "day-badge-amber")" style="font-size:10.5px;padding:2px 7px;">@kalanGun g</span> }
                                                            </div>
                                                        }
                                                        else { <span style="color:#c8cfd8;">—</span> }
                                                    </td>
                                                    <td>
                                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                                        {
                                                            @if (b.RezKural != null)
                                                            {
                                                                <span style="font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:13.5px;">@b.RezKural.PeriyotUcreti.ToString("N0") ₺</span>
                                                                <span style="font-size:11px;color:var(--color-muted);margin-left:1px;">/ @b.RezKural.UcretlendirmePeriyoduDakika dk</span>
                                                            }
                                                            else { <span style="color:#c8cfd8;font-size:12px;">genel tarife</span> }
                                                        }
                                                        else if (b.AktifSozlesme != null)
                                                        {
                                                            <div>
                                                                <span style="font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:14px;">@b.AktifSozlesme.KiraBedeli.ToString("N0") ₺</span>
                                                                <span style="font-size:11px;color:var(--color-muted);margin-left:1px;">/@(b.AktifSozlesme.Periyot == KiraPeriyodu.Aylik ? "ay" : "yıl")</span>
                                                            </div>
                                                        }
                                                        else { <span style="color:#c8cfd8;">—</span> }
                                                    </td>
                                                    <td style="text-align:center;display:flex;gap:4px;justify-content:center;flex-wrap:wrap;">
                                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                                        {
                                                            @if (canEdit)
                                                            {
                                                                <a href="/Rezervasyon/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Rezervasyon Yap</a>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (b.AktifSozlesme != null)
                                                            {
                                                                <a href="/Sozlesme/Detay/@b.AktifSozlesme.Id" class="btn btn-sm btn-secondary">Sözleşme</a>
                                                            }
                                                            else if (canEdit)
                                                            {
                                                                <a href="/Sozlesme/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Kiraya Ver</a>
                                                            }
                                                        }
                                                        @if (canManageRate)
                                                        {
                                                            <a href="/Birim/@b.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary" title="Özel Fiyatlar">₺</a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card" style="padding:0;overflow:hidden;">
                <div class="table-wrapper">
                    <table style="table-layout:fixed;width:100%;">
                        <colgroup>
                            <col style="width:auto;" />
                            <col style="width:90px;" />
                            <col style="width:140px;" />
                            <col style="width:auto;" />
                            <col style="width:130px;" />
                            <col style="width:140px;" />
                            <col style="width:110px;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Birim</th>
                                <th>Yüzölçüm</th>
                                <th>Durum</th>
                                <th>Kiracı</th>
                                <th>Bitiş Tarihi</th>
                                <th>Bedel</th>
                                <th style="text-align:center;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Birimler)
                            {
                                <tr>
                                    <td style="font-weight:600;">@b.Birim.Ad</td>
                                    <td>
                                        <span style="font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--color-muted);">@b.Birim.Yuzolcumu.ToString("N0")</span>
                                        <span style="font-size:11px;color:var(--color-muted);">m²</span>
                                    </td>
                                    <td>@Html.Raw(DurumBadge(b.Durum))</td>
                                    <td>
                                        @if (b.AktifSozlesme != null)
                                        {
                                            <a href="/Kiraci/Detay/@b.AktifSozlesme.KiraciId" style="font-weight:600;color:var(--color-primary);text-decoration:none;font-size:13px;">@b.AktifSozlesme.Kiraci.GosterimAdi</a>
                                        }
                                        else { <span style="color:#c8cfd8;">—</span> }
                                    </td>
                                    <td>
                                        @if (b.AktifSozlesme != null)
                                        {
                                            var kalanGun = (int)(b.AktifSozlesme.BitisTarihi - DateTime.Now).TotalDays;
                                            <div style="display:flex;align-items:center;gap:6px;">
                                                <span style="font-size:13px;font-weight:500;">@b.AktifSozlesme.BitisTarihi.ToString("dd.MM.yyyy")</span>
                                                @if (kalanGun <= 30) { <span class="day-badge @(kalanGun <= 10 ? "day-badge-red" : "day-badge-amber")" style="font-size:10.5px;padding:2px 7px;">@kalanGun g</span> }
                                            </div>
                                        }
                                        else { <span style="color:#c8cfd8;">—</span> }
                                    </td>
                                    <td>
                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                        {
                                            @if (b.RezKural != null)
                                            {
                                                <span style="font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:13.5px;">@b.RezKural.PeriyotUcreti.ToString("N0") ₺</span>
                                                <span style="font-size:11px;color:var(--color-muted);margin-left:1px;">/ @b.RezKural.UcretlendirmePeriyoduDakika dk</span>
                                            }
                                            else { <span style="color:#c8cfd8;font-size:12px;">genel tarife</span> }
                                        }
                                        else if (b.AktifSozlesme != null)
                                        {
                                            <div>
                                                <span style="font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:14px;">@b.AktifSozlesme.KiraBedeli.ToString("N0") ₺</span>
                                                <span style="font-size:11px;color:var(--color-muted);margin-left:1px;">/@(b.AktifSozlesme.Periyot == KiraPeriyodu.Aylik ? "ay" : "yıl")</span>
                                            </div>
                                        }
                                        else { <span style="color:#c8cfd8;">—</span> }
                                    </td>
                                    <td style="text-align:center;display:flex;gap:4px;justify-content:center;flex-wrap:wrap;">
                                        @if (b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true)
                                        {
                                            @if (canEdit)
                                            {
                                                <a href="/Rezervasyon/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Rezervasyon Yap</a>
                                            }
                                        }
                                        else
                                        {
                                            @if (b.AktifSozlesme != null)
                                            {
                                                <a href="/Sozlesme/Detay/@b.AktifSozlesme.Id" class="btn btn-sm btn-secondary">Sözleşme</a>
                                            }
                                            else if (canEdit)
                                            {
                                                <a href="/Sozlesme/Ekle?birimId=@b.Birim.Id" class="btn btn-sm btn-primary">Kiraya Ver</a>
                                            }
                                        }
                                        @if (canManageRate)
                                        {
                                            <a href="/Birim/@b.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary" title="Özel Fiyatlar">₺</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 3: Sözleşme Geçmişi -->
    <div class="tab-content">
        @{
            var tumSozlesmeler = Model.Birimler
                .SelectMany(b => b.Birim.Sozlesmeler)
                .OrderByDescending(s => s.BaslangicTarihi)
                .ToList();
        }
        @if (!tumSozlesmeler.Any())
        {
            <div style="padding:32px;text-align:center;color:var(--color-muted);">Henüz sözleşme kaydı yok.</div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Birim</th>
                            <th>Kiracı</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Bedel</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in tumSozlesmeler)
                        {
                            bool aktif = s.BaslangicTarihi <= DateTime.Now && s.BitisTarihi >= DateTime.Now;
                            bool surek = aktif && (s.BitisTarihi - DateTime.Now).TotalDays <= 30;
                            <tr>
                                <td style="font-weight:600;">@s.Birim.Ad</td>
                                <td>
                                    <a href="/Kiraci/Detay/@s.KiraciId" style="color:var(--color-primary);text-decoration:none;font-weight:500;">@s.Kiraci.GosterimAdi</a>
                                </td>
                                <td>@s.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                                <td>@s.BitisTarihi.ToString("dd.MM.yyyy")</td>
                                <td style="font-weight:600;">@s.KiraBedeli.ToString("N0") ₺/@(s.Periyot == KiraPeriyodu.Aylik ? "ay" : "yıl")</td>
                                <td>
                                    @if (surek) { <span class="badge badge-surek">Dolmak Üzere</span> }
                                    else if (aktif) { <span class="badge badge-kirali">Aktif</span> }
                                    else { <span class="badge badge-gecmis">Geçmiş</span> }
                                </td>
                                <td><a href="/Sozlesme/Detay/@s.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Tab 4: Rezervasyonlar -->
    <div class="tab-content">
        @if (!Model.Rezervasyonlar.Any())
        {
            <div style="padding:32px;text-align:center;color:var(--color-muted);">Henüz rezervasyon kaydı yok.</div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Birim</th>
                            <th>Kiracı</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Süre</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rezervasyonlar)
                        {
                            var rezDurumBadge = r.Durum switch {
                                KiraTakip.Models.RezervasyonDurumu.Planlandi         => "<span class='badge' style='background:#e3f2fd;color:#1565c0;'>Planlandı</span>",
                                KiraTakip.Models.RezervasyonDurumu.Tamamlandi        => "<span class='badge badge-kirali'>Tamamlandı</span>",
                                KiraTakip.Models.RezervasyonDurumu.IptalEdildi       => "<span class='badge badge-gecmis'>İptal</span>",
                                KiraTakip.Models.RezervasyonDurumu.TahakkukaAktarildi => "<span class='badge badge-surek'>Aktarıldı</span>",
                                _ => "<span class='badge'>—</span>"
                            };
                            <tr>
                                <td style="font-weight:600;">@r.Birim.Ad</td>
                                <td>
                                    <a href="/Kiraci/Detay/@r.KiraciId" style="color:var(--color-primary);text-decoration:none;font-weight:500;">@r.Kiraci.GosterimAdi</a>
                                </td>
                                <td>@r.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@r.BitisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span style="font-family:'JetBrains Mono',monospace;font-size:12.5px;">@r.ToplamSureDakika dk</span>
                                    @if (r.UcretsizSureDakika > 0)
                                    {
                                        <span style="font-size:11px;color:var(--color-muted);"> (@r.UcretsizSureDakika dk ücretsiz)</span>
                                    }
                                </td>
                                <td style="font-weight:600;">@r.ToplamTutar.ToString("N0") ₺</td>
                                <td>@Html.Raw(rezDurumBadge)</td>
                                <td><a href="/Rezervasyon/Detay/@r.Id" class="btn btn-sm btn-secondary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Tab 5: Kira Tarifeleri -->
    <div class="tab-content">

        <!-- Bölüm 1: Taşınmaz Tarifeleri (Genel Tarife) -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:12px;border-bottom:2px solid var(--color-border);">
            <div>
                <div style="font-size:15px;font-weight:700;">Taşınmaz Tarifeleri</div>
                <div style="font-size:12px;color:var(--color-muted);margin-top:3px;">Sözleşme oluşturulurken varsayılan olarak kullanılır. Birim bazlı özel fiyat tanımlıysa bu tarife geçersiz kalır.</div>
            </div>
        </div>

        <div class="table-wrapper" style="overflow-x:auto;margin:0 0 32px;">
            <table class="table table-bordered" style="min-width:800px;">
                <thead>
                    <tr>
                        <th style="width:180px;">Kiracı Kategorisi</th>
                        @foreach (var col in Model.FiyatMatrisi.Kolonlar)
                        {
                            <th style="text-align:center;">
                                <div style="font-size:11px;color:var(--color-muted);margin-bottom:2px;">@col.BorcTipiKod</div>
                                <div style="font-size:13px;">@col.BorcTipiAd</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var satir in Model.FiyatMatrisi.Satirlar)
                    {
                        <tr>
                            <td style="font-weight:600;vertical-align:middle;background:#fafbfc;">@satir.KiraciKategoriAd</td>
                            @foreach (var hucre in satir.Hucreler)
                            {
                                <td style="padding:12px;text-align:center;background:@(hucre.RateVarMi ? "transparent" : "#f9fafb");">
                                    @if (hucre.RateVarMi)
                                    {
                                        <div style="font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:15px;">
                                            @hucre.BirimDeger.ToString("N2") ₺
                                            <small style="font-family:sans-serif;font-size:11px;font-weight:400;color:var(--color-muted);">
                                                @(hucre.HesaplamaYontemi == HesaplamaYontemi.Sabit ? "/sabit" : "/m²")
                                            </small>
                                        </div>
                                        <div style="font-size:11px;color:var(--color-muted);margin-top:4px;">KDV: %@hucre.KdvOrani.ToString("N0")</div>
                                    }
                                    else
                                    {
                                        <div style="color:#c8cfd8;font-size:12px;">Tanımsız</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Bölüm 2: Birim Bazlı Özel Fiyatlar -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:12px;border-bottom:2px solid var(--color-border);">
            <div>
                <div style="font-size:15px;font-weight:700;">Birim Bazlı Özel Fiyatlar</div>
                <div style="font-size:12px;color:var(--color-muted);margin-top:3px;">Aşağıdaki birimler için taşınmaz tarifesi yerine bu özel fiyatlar geçerlidir.</div>
            </div>
        </div>

        @if (Model.BirimOzelFiyatlari.Any())
        {
            <div style="margin-bottom:32px;">
                @foreach (var birimOzet in Model.BirimOzelFiyatlari)
                {
                    <div class="card" style="margin-bottom:10px;padding:0;overflow:hidden;">
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:#fafbfc;border-bottom:1px solid var(--color-border);">
                            <div style="display:flex;align-items:center;gap:10px;">
                                @if (!string.IsNullOrEmpty(birimOzet.Birim.OfisNo))
                                {
                                    <span style="font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--color-primary);background:var(--color-primary-light);padding:2px 8px;border-radius:6px;">@birimOzet.Birim.OfisNo</span>
                                }
                                <span style="font-size:13.5px;font-weight:700;">@(birimOzet.Birim.Ad ?? "—")</span>
                                <span class="badge badge-kirali" style="font-size:10.5px;">@birimOzet.Rateler.Count özel fiyat</span>
                            </div>
                            @if (canManageRate)
                            {
                                <a href="/Birim/@birimOzet.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary">Düzenle</a>
                            }
                        </div>
                        <div class="table-wrapper" style="margin:0;">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Kiracı Kategorisi</th>
                                        <th>Ücret Tipi</th>
                                        <th>Hesaplama</th>
                                        <th>Fiyat</th>
                                        <th>KDV</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in birimOzet.Rateler)
                                    {
                                        <tr>
                                            <td style="font-weight:600;">@r.KiraciKategori.Ad</td>
                                            <td>@r.BorcTipi.Ad</td>
                                            <td style="font-size:12px;color:var(--color-muted);">@(r.HesaplamaYontemi == HesaplamaYontemi.Sabit ? "Sabit" : "m² bazlı")</td>
                                            <td style="font-family:'Fraunces',Georgia,serif;font-weight:700;">@r.BirimDeger.ToString("N2") ₺</td>
                                            <td style="font-size:12.5px;color:var(--color-muted);">%@r.KdvOrani.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding:14px 18px;background:#f9fafb;border:1px solid var(--color-border);border-radius:8px;font-size:13px;color:var(--color-muted);margin-bottom:32px;">
                Tüm birimler için taşınmaz tarifeleri geçerlidir. Birim bazlı özel fiyat tanımlı değil.
            </div>
        }

        <!-- Bölüm 3: Rezervasyon Ücret Kuralları -->
        @{
            var rezBirimler = Model.Birimler.Where(b => b.Birim.BirimTuru?.RezervasyonYapilabilirMi == true).ToList();
        }
        @if (rezBirimler.Any())
        {
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:12px;border-bottom:2px solid var(--color-border);">
                <div>
                    <div style="font-size:15px;font-weight:700;">Rezervasyon Ücret Kuralları</div>
                    <div style="font-size:12px;color:var(--color-muted);margin-top:3px;">Rezervasyon birimi olan birimlerin saatlik/periyotluk ücretlendirme kuralları.</div>
                </div>
            </div>
            <div class="table-wrapper" style="margin:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Birim</th>
                            <th>Kural</th>
                            <th>Periyot Ücreti</th>
                            <th>Periyot</th>
                            <th>Ücretsiz Süre</th>
                            <th>KDV</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in rezBirimler)
                        {
                            var ozelKural = Model.BirimRezervasyonKurallari.FirstOrDefault(k => k.BirimId == b.Birim.Id);
                            var aktifKural = ozelKural ?? Model.GlobalRezervasyonKural;
                            <tr>
                                <td style="font-weight:600;">@(b.Birim.Ad ?? b.Birim.OfisNo)</td>
                                <td>
                                    @if (ozelKural != null)
                                    {
                                        <span class="badge badge-kirali">Özel</span>
                                    }
                                    else
                                    {
                                        <span style="font-size:12px;color:var(--color-muted);">Global</span>
                                    }
                                </td>
                                @if (aktifKural != null)
                                {
                                    <td style="font-weight:600;">@aktifKural.PeriyotUcreti.ToString("N0") ₺</td>
                                    <td>@aktifKural.UcretlendirmePeriyoduDakika dk</td>
                                    <td>@aktifKural.UcretsizSureDakika dk</td>
                                    <td>%@aktifKural.KdvOrani.ToString("N0")</td>
                                }
                                else
                                {
                                    <td colspan="4" style="color:#c8cfd8;font-size:12px;">Kural tanımlı değil</td>
                                }
                                <td>
                                    @if (canManageRate)
                                    {
                                        <a href="/Birim/@b.Birim.Id/OzelFiyat" class="btn btn-sm btn-secondary">Düzenle</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>


</div>

@section Scripts {
    <script>initTabs('detay-tabs');</script>
}
