@model KiraTakip.Models.Dtos.OdemeDetayDto
@using KiraTakip.Models
@using KiraTakip.Models.Entities
@{
    ViewData["Title"] = $"Ödeme #{Model.Id}";
    bool canApprove    = User.HasPermission(PermissionCatalog.Payment.Approve);
    bool canReject     = User.HasPermission(PermissionCatalog.Payment.Reject);
    bool canUpload     = User.HasPermission(PermissionCatalog.Payment.UploadReceipt);
    bool canMatch      = User.HasPermission(PermissionCatalog.Payment.MatchBankTransaction);
    bool bekliyor      = Model.Durum == PaymentStatus.PendingApproval;
    var belgeler        = (ViewBag.Belgeler    as List<Document>)    ?? [];
    var belgeTurleri    = (ViewBag.DocumentTypes as List<DocumentType>) ?? [];

    string durumCls = Model.Durum switch {
        PaymentStatus.Approved  => "badge-kirali",
        PaymentStatus.Rejected => "badge-gecmis",
        _                      => "badge-surek"
    };
    string durumLabel = Model.Durum switch {
        PaymentStatus.Approved  => "Onaylandı",
        PaymentStatus.Rejected => "Reddedildi",
        _                      => "Onay Bekliyor"
    };
    string durumTip = Model.Durum switch {
        PaymentStatus.Approved  => "Ödeme onaylandı; charge kapandı.",
        PaymentStatus.Rejected => "Ödeme reddedildi; charge açık kalır.",
        _                      => "Onay yetkisi olan kullanıcı bekleniyor."
    };
    string kanalLabel = Model.PaymentChannel switch {
        PaymentChannel.BankTransfer => "Havale",
        PaymentChannel.Eft    => "EFT",
        PaymentChannel.Cash  => "Nakit",
        _                  => "Diğer"
    };
}

<div class="page-header flex items-center justify-between">
    <div>
        <a href="/Payment" class="text-[12.5px] text-slate-400 font-bold uppercase tracking-tight no-underline inline-flex items-center gap-1 mb-2 hover:text-indigo-600 transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Ödemeler
        </a>
        <div class="page-title">Ödeme #@Model.Id</div>
        <div class="page-subtitle">@Model.KiraciGosterimAdi — @Model.TahakkukDonemBaslangic.ToString("MMMM yyyy")</div>
    </div>
    @{
        string bgCls = Model.Durum switch {
            PaymentStatus.Approved  => "bg-emerald-50 text-emerald-700 border-emerald-100",
            PaymentStatus.Rejected => "bg-red-50 text-red-700 border-red-100",
            _                      => "bg-amber-50 text-amber-700 border-amber-100"
        };
    }
    <span class="px-4 py-1.5 rounded-full border @bgCls text-xs font-bold shadow-sm" data-tip="@durumTip">@durumLabel</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 px-4 rounded-lg mb-4 text-[13.5px]">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 px-4 rounded-lg mb-4 text-[13.5px]">✕ @TempData["Error"]</div>
}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start">
    <!-- Sol: Ödeme bilgileri -->
    <div class="flex flex-col gap-4">
        <div class="card p-6">
            <div class="text-base font-bold text-slate-800 mb-6 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                Ödeme Bilgileri
            </div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-6">
                <div>
                    <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1">Amount</div>
                    <div class="text-2xl font-bold text-slate-900">@Model.Amount.ToString("N2") <span class="text-base font-medium text-slate-400 ml-1">₺</span></div>
                </div>
                <div>
                    <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1">Ödeme Tarihi</div>
                    <div class="text-base font-bold text-slate-700">@Model.PaymentDate.ToString("dd.MM.yyyy")</div>
                </div>
                <div>
                    <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1">Kanal</div>
                    <div class="text-[14px] font-bold text-slate-600 bg-slate-50 px-2 py-1 rounded-md border border-slate-100 inline-block">@kanalLabel</div>
                </div>
                <div>
                    <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1">Giriş Tarihi</div>
                    <div class="text-[14px] font-medium text-slate-500">@Model.EntryDate.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div>
                    <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1">Giriş Yapan</div>
                    <div class="text-[14px] font-medium text-slate-600">@(Model.GirenUserGosterimAdi ?? "—")</div>
                </div>
                @if (Model.Durum == PaymentStatus.Approved)
                {
                    <div>
                        <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-1">Onaylayan</div>
                        <div class="text-[14px] font-bold text-emerald-600">@(Model.OnaylayanUserGosterimAdi ?? "—")</div>
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.Aciklama))
            {
                <div class="mt-6 pt-5 border-t border-slate-100">
                    <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-2">Açıklama</div>
                    <div class="text-[13.5px] text-slate-600 leading-relaxed bg-slate-50/50 p-3 rounded-lg border border-slate-100 italic">"@Model.Aciklama"</div>
                </div>
            }
            @if (Model.Durum == PaymentStatus.Rejected && !string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="mt-5 p-4 bg-red-50 rounded-xl border border-red-100">
                    <div class="text-[10px] text-red-400 font-bold mb-2 uppercase tracking-widest flex items-center gap-1.5">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Red Nedeni
                    </div>
                    <div class="text-[13.5px] text-red-800 font-medium">@Model.RejectionReason</div>
                </div>
            }
        </div>

        <!-- Onay / Red -->
        @if (bekliyor && (canApprove || canReject))
        {
            <div class="card p-6" x-data="{ showRedForm: false }">
                <div class="text-base font-bold text-slate-800 mb-5 flex items-center gap-2">
                    <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                    Ödeme İşlemi
                </div>
                <div class="flex gap-3 flex-wrap">
                    @if (canApprove)
                    {
                        <form method="post" action="/Payment/Onayla/@Model.Id.ToHashId()"
                              data-confirm="Bu ödemeyi onaylamak istediğinize emin misiniz?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary px-8">✓ Onayla</button>
                        </form>
                    }
                    @if (canReject)
                    {
                        <button type="button" class="btn bg-red-50 text-red-600 border-red-100 hover:bg-red-600 hover:text-white px-8 transition-all" @@click="showRedForm=!showRedForm">✕ Reddet</button>
                    }
                </div>
                @if (canReject)
                {
                    <div x-show="showRedForm" x-cloak x-transition class="mt-5 pt-5 border-t border-slate-100">
                        <form method="post" action="/Payment/Reddet">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OdemeId" value="@Model.Id" />
                            <div class="form-group mb-4">
                                <label class="form-label">Red Nedeni *</label>
                                <textarea name="Neden" class="form-control" rows="3" required placeholder="Neden reddedildiğini açıklayın..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger w-full">Reddi Onayla</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sağ: Belgeler -->
    <div class="flex flex-col gap-4">
        <div>
        @await Html.PartialAsync("_BelgePanel", new KiraTakip.Models.ViewModels.BelgePanelViewModel
        {
            OwnerType    = KiraTakip.Models.DocumentOwnerType.Payment,
            OwnerId      = Model.Id,
            DocumentTypes = belgeTurleri,
            Belgeler     = belgeler,
            CanEdit      = canUpload
        })
        </div>

        <!-- Banka eşleşmeleri -->
        <div class="card p-5">
            <div class="flex items-center justify-between mb-5">
                <div class="text-[15px] font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-1.5 h-4 bg-emerald-500 rounded-full"></span>
                    Banka Eşleşmeleri (@Model.BankMatches.Count)
                </div>
                @if (canMatch)
                {
                    <a href="/Payment/HareketSec/@Model.Id.ToHashId()" class="text-xs font-bold text-indigo-600 hover:text-indigo-700 hover:underline transition-all">+ Yeni Eşleşme</a>
                }
            </div>
            @if (Model.BankMatches.Any())
            {
                <div class="flex flex-col gap-2.5">
                    @foreach (var e in Model.BankMatches)
                    {
                        <div class="p-3 bg-slate-50 border border-slate-100 rounded-xl group hover:border-emerald-200 transition-all">
                            <div class="flex items-center justify-between mb-1.5">
                                <div class="text-[13px] font-bold text-slate-700">@e.BankaHareketiTutar.ToString("N2") ₺</div>
                                <div class="text-[11px] font-bold text-slate-400">@e.BankaHareketiTarih.ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="text-slate-500 text-[11.5px] leading-relaxed truncate mb-2" title="@e.BankaHareketiAciklama">@e.BankaHareketiAciklama</div>
                            <div class="flex items-center justify-between mt-2 pt-2 border-t border-slate-200/60">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">@(e.MatchType == MatchType.Manual ? "Manuel Eşleşme" : "Otomatik")</span>
                                @if (canMatch)
                                {
                                    <form method="post" action="/Payment/BankaEslesmeKaldir" data-confirm="Banka eşleşmesi kaldırılsın mı?" class="shrink-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="eslesmeId" value="@e.Id" />
                                        <input type="hidden" name="odemeId" value="@Model.Id" />
                                        <button type="submit" class="text-[10px] font-bold text-red-400 hover:text-red-600 uppercase tracking-widest transition-colors">Eşleşmeyi Kaldır</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-slate-50 border border-dashed border-slate-200 rounded-xl p-6 text-center text-slate-400 text-xs font-medium">
                    Banka hareketi eşleşmesi bulunamadı.
                </div>
            }
        </div>
    </div>
</div>

