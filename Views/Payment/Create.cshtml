@model KiraTakip.Models.ViewModels.CreatePaymentViewModel
@using KiraTakip.Models
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Ödeme Ekle";
    ViewData["UseCentralFeedback"] = true;
    var charge = Model.Charge;
    var remainingAmount = charge != null ? charge.TotalAmount - charge.PaidAmount : 0;
    var payableLineItems = charge?.LineItems
        .Where(item => item.AvailableAmount > 0)
        .OrderBy(item => item.ChargeTypeSortOrder)
        .ToList() ?? new List<KiraTakip.Models.Dtos.ChargeLineItemDto>();
    var payableLineItemsJson = JsonSerializer.Serialize(
        payableLineItems.Select(item => new { id = item.Id, available = item.AvailableAmount }));
}

<div class="max-w-[600px] mx-auto">
    <div class="page-header">
        <div>
            <a href="/Charge" class="text-xs text-muted no-underline inline-flex items-center gap-1 mb-2">← Tahakkuklar</a>
            <div class="page-title">Ödeme Ekle</div>
            @if (charge != null)
            {
                <div class="page-subtitle">@charge.TenantDisplayName — @charge.PeriodStart.ToString("MMMM yyyy")</div>
            }
        </div>
    </div>

    @if (charge != null)
    {
        <div class="flex gap-3 mb-5 flex-wrap">
            <div class="card card-sm flex-1 min-w-[9.375rem]">
                <div class="card-title">Toplam Tahakkuk</div>
                <div class="card-value" style="font-size: 1.375rem;">@charge.TotalAmount.Tl(0)</div>
            </div>
            <div class="card card-sm flex-1 min-w-[9.375rem]">
                <div class="card-title">Ödenen</div>
                <div class="card-value" style="font-size: 1.375rem; color: #065f46;">@charge.PaidAmount.Tl(0)</div>
            </div>
            <div class="card card-sm flex-1 min-w-[9.375rem]">
                <div class="card-title">Kalan</div>
                <div class="card-value" style="font-size: 1.375rem; @(remainingAmount > 0 ? "color: #991b1b;" : "color: #065f46;")">@remainingAmount.Tl(0)</div>
            </div>
        </div>

        <details class="mb-5 group">
            <summary class="list-none cursor-pointer flex items-center gap-2.5 p-2 px-3 bg-slate-50 border border-slate-200 rounded-lg select-none group-open:rounded-b-none hover:bg-slate-100/50 transition-all">
                <span class="text-[9px] font-bold uppercase tracking-widest bg-indigo-50 text-indigo-600 border border-indigo-100 rounded px-1.5 py-0.5">Kalem Bazında</span>
                <span class="text-[11px] text-slate-500 font-medium">@charge.LineItems.Count kalem</span>
                <span class="ml-auto text-[10px] text-slate-300 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="border border-slate-200 border-t-0 rounded-b-lg bg-white p-3">
                <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 gap-y-1.5 text-xs items-center">
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest pb-1 border-b border-slate-100">Kalem</span>
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest pb-1 border-b border-slate-100 text-right">Toplam</span>
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest pb-1 border-b border-slate-100 text-right">Ödenen</span>
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest pb-1 border-b border-slate-100 text-right">Kalan</span>
                    @foreach (var item in charge.LineItems.OrderBy(item => item.ChargeTypeSortOrder))
                    {
                        <span class="text-slate-700 font-medium">
                            @item.ChargeTypeName
                            <span class="block text-[10px] text-muted font-normal">@item.Description</span>
                        </span>
                        <span class="text-right font-bold text-slate-600 font-mono">@item.TotalAmount.Tl()</span>
                        <span class="text-right font-bold text-emerald-700 font-mono">@item.PaidAmount.Tl()</span>
                        <span class="text-right font-bold font-mono @(item.RemainingAmount > 0 ? "text-red-500" : "text-emerald-700")">@item.RemainingAmount.Tl()</span>
                    }
                </div>
            </div>
        </details>
    }

    <div>
    <div class="card">
        <form method="post" action="/Payment/Create" asp-form-write-permission="@PermissionCatalog.Payment.Create" x-data="odemeKalemSecimi()">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ChargeId" />

            @if (payableLineItems.Count == 0)
            {
                <div style="background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 0.625rem 0.875rem; border-radius: 0.5rem; margin-bottom: 1.125rem; font-size: 0.8125rem;">
                    Bu tahakkukta şu anda ödenebilir kalem bulunmuyor. Onay bekleyen ödemeler kalan borcun tamamını karşılıyor.
                </div>
            }
            else
            {
                <div class="form-group">
                    <label class="form-label">Ödeme Yapılacak Kalem <span class="text-red-500">*</span></label>
                    @foreach (var item in payableLineItems)
                    {
                        <label class="flex items-start justify-between gap-3 cursor-pointer border border-slate-200 rounded-lg px-3 py-2 mb-2 hover:border-blue-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50/40 transition-colors">
                            <span class="flex items-start gap-2">
                                <input type="radio" name="ChargeLineItemId" value="@item.Id" class="accent-blue-600 mt-0.5"
                                       checked="@(Model.ChargeLineItemId == item.Id)"
                                       x-model.number="lineItemId" @@change="secimiUygula()" />
                                <span>
                                    <span class="text-[13px] font-semibold block">@item.ChargeTypeName</span>
                                    <span class="text-xs text-muted block">@item.Description</span>
                                </span>
                            </span>
                            <span class="text-right shrink-0">
                                <span class="text-[10px] text-muted uppercase block">Kalan</span>
                                <span class="text-[13px] font-bold">@item.RemainingAmount.Tl()</span>
                                @if (item.PendingAmount > 0)
                                {
                                    <span class="block text-[10px] text-amber-600 font-medium mt-0.5">⏳ @item.PendingAmount.Tl() onay bekliyor — @item.AvailableAmount.Tl() girilebilir</span>
                                }
                            </span>
                        </label>
                    }
                    <span asp-validation-for="ChargeLineItemId" class="text-red-500 text-xs"></span>
                </div>
            }

            <div class="form-group">
                <label class="form-label">Ödeme Tarihi</label>
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                    { "Name",  "PaymentDate" },
                    { "Value", Model.PaymentDate.ToString("yyyy-MM-dd") },
                    { "Mode",  "date" },
                    { "Field", "odemeTarihi" }
                })
                <span asp-validation-for="PaymentDate" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Tutar (₺)</label>
                <input asp-for="Amount" type="number" step="0.01" class="form-control" x-model.number="amount" :max="maxAmount" />
                <span asp-validation-for="Amount" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Ödeme Kanalı</label>
                <select asp-for="PaymentChannel" class="form-control">
                    <option value="@((int)PaymentChannel.Eft)">EFT</option>
                    <option value="@((int)PaymentChannel.BankTransfer)">Havale</option>
                    <option value="@((int)PaymentChannel.Cash)">Nakit</option>
                    <option value="@((int)PaymentChannel.Other)">Diğer</option>
                </select>
                <span asp-validation-for="PaymentChannel" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Açıklama <span class="text-muted font-normal">(opsiyonel)</span></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <div style="background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 0.625rem 0.875rem; border-radius: 0.5rem; margin-bottom: 1.125rem; font-size: 0.8125rem;">
                Ödeme kaydedildikten sonra yetkilinin onayı beklenecektir.
            </div>

            <div class="flex gap-2.5">
                <button type="submit" class="btn btn-primary" asp-permission="@PermissionCatalog.Payment.Create" disabled="@(payableLineItems.Count == 0)">Kaydet</button>
                <a href="/Charge" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
<script>
function odemeKalemSecimi() {
    return {
        items: @Html.Raw(payableLineItemsJson),
        lineItemId: @(Model.ChargeLineItemId?.ToString(CultureInfo.InvariantCulture) ?? "null"),
        amount: @Model.Amount.ToString(CultureInfo.InvariantCulture),
        get maxAmount() {
            const item = this.items.find(i => i.id === this.lineItemId);
            return item ? item.available : 0;
        },
        secimiUygula() { this.amount = this.maxAmount; }
    };
}
</script>
}

