@model KiraTakip.Models.ViewModels.AylikRaporViewModel
@{
    ViewData["Title"] = "Tahsilat Raporu";
    string TLFormat(decimal v) => v.ToString("N2") + " ₺";
    var yillar = ViewBag.MevcutYillar as List<int> ?? new List<int> { Model.Yil };
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Tahsilat Raporu</div>
        <div class="page-subtitle">@Model.Yil yılı aylık tahakkuk özeti</div>
    </div>
    <div>
        <form method="get" class="flex items-center">
            <select name="yil" class="form-control w-32 font-bold" onchange="this.form.submit()">
                @foreach (var y in yillar)
                {
                    <option value="@y" selected="@(y == Model.Yil ? "selected" : null)">@y Yılı</option>
                }
            </select>
        </form>
    </div>
</div>

<!-- Özet Kartlar -->
<!-- Özet Kartlar -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="card bg-white border border-slate-200">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Yıllık Beklenen</div>
        <div class="text-2xl font-bold text-slate-800">@TLFormat(Model.ToplamBeklenen)</div>
        <div class="text-[11px] text-muted font-medium mt-1">@Model.Satirlar.Sum(s => s.TahakkukSayisi) tahakkuk kaydı</div>
    </div>
    <div class="card bg-emerald-50/50 border border-emerald-100">
        <div class="text-[11px] font-bold text-emerald-600/60 uppercase tracking-wider mb-1">Yıllık Tahsil Edilen</div>
        <div class="text-2xl font-bold text-emerald-700">@TLFormat(Model.ToplamTahsil)</div>
        <div class="text-[11px] text-emerald-600/80 font-bold mt-1 flex items-center gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            %@Model.GenelTahsilOrani.ToString("F0") tahsilat başarısı
        </div>
    </div>
    <div class="card bg-red-50/50 border border-red-100">
        <div class="text-[11px] font-bold text-red-600/60 uppercase tracking-wider mb-1">Tahsil Edilemeyen</div>
        <div class="text-2xl font-bold text-red-700">@TLFormat(Model.ToplamBeklenen - Model.ToplamTahsil)</div>
        <div class="text-[10px] text-red-600/80 font-bold mt-1">
            @Model.ToplamGecikmiş gecikmiş · @TLFormat(Model.ToplamGecikmisTutar) toplam gecikme
        </div>
    </div>
</div>

<!-- Aylık Tablo -->
<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-32">Ay</th>
                    <th class="w-24 cell-center">Charge</th>
                    <th class="w-40 num">Beklenen</th>
                    <th class="w-40 num">Tahsil Edilen</th>
                    <th class="w-40 num">Kalan</th>
                    <th class="w-48">Tahsilat Oranı</th>
                    <th class="w-48 cell-center" title="Vade tarihi geçmiş ve henüz tamamı tahsil edilmemiş tahakkukların adedi ve kalan toplam tutarı.">
                        Gecikmiş Charge
                        <span class="inline-flex items-center justify-center w-3.5 h-3.5 leading-[14px] text-center rounded-full bg-slate-200 text-slate-500 text-[9px] font-bold ml-1 cursor-help">i</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var satir in Model.Satirlar)
                {
                    bool buAy = satir.Ay == DateTime.Today.Month && Model.Yil == DateTime.Today.Year;
                    decimal kalan = satir.Beklenen - satir.TahsilEdilen;
                    <tr class="@(buAy ? "bg-amber-50/40" : "")">
                        <td class="@(buAy ? "font-bold text-slate-800" : "font-medium text-slate-700")">
                            @satir.AyAdi
                            @if (buAy) { <span class="badge badge-surek ml-1">Bu Ay</span> }
                        </td>
                        <td class="cell-center text-muted">
                            @(satir.TahakkukSayisi > 0 ? satir.TahakkukSayisi.ToString() : "—")
                        </td>
                        <td class="num">
                            @(satir.Beklenen > 0 ? TLFormat(satir.Beklenen) : "—")
                        </td>
                        <td class="num num-positive">
                            @(satir.TahsilEdilen > 0 ? TLFormat(satir.TahsilEdilen) : (satir.Beklenen > 0 ? "0,00 ₺" : "—"))
                        </td>
                        <td class="num @(kalan > 0 ? "num-negative" : "num-positive")">
                            @(satir.Beklenen > 0 ? TLFormat(kalan) : "—")
                        </td>
                        <td>
                            @if (satir.Beklenen > 0)
                            {
                                string barColorCls = satir.TahsilOrani >= 100 ? "bg-emerald-500" : satir.TahsilOrani >= 50 ? "bg-amber-500" : "bg-red-500";
                                string textColorCls = satir.TahsilOrani >= 100 ? "text-emerald-600" : satir.TahsilOrani >= 50 ? "text-amber-600" : "text-red-600";
                                <div class="flex items-center gap-2">
                                    <div class="h-1.5 flex-1 bg-slate-100 rounded-full overflow-hidden border border-slate-200/50">
                                        <div class="h-full transition-all duration-700 @barColorCls" style="width:@Math.Min(satir.TahsilOrani,100).ToString("F0")%;"></div>
                                    </div>
                                    <span class="text-[11px] font-bold w-10 @textColorCls text-right">%@satir.TahsilOrani.ToString("F0")</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted text-xs">—</span>
                            }
                        </td>
                        <td class="cell-center">
                            @if (satir.GecikmisTahakkukAdet > 0)
                            {
                                var ayBas = new DateTime(Model.Yil, satir.Ay, 1).ToString("yyyy-MM-dd");
                                var aySon = new DateTime(Model.Yil, satir.Ay, DateTime.DaysInMonth(Model.Yil, satir.Ay)).ToString("yyyy-MM-dd");
                                var drillUrl = $"/Charge?durum=gecikti&from={ayBas}&to={aySon}";
                                <a href="@drillUrl" class="no-underline inline-flex flex-col items-center group" title="@satir.AyAdi ayının gecikmiş tahakkuklarını görüntüle">
                                    <span class="badge badge-gecmis group-hover:scale-110 transition-transform">@satir.GecikmisTahakkukAdet Adet</span>
                                    <span class="text-[10px] text-red-700 font-bold mt-0.5">@TLFormat(satir.GecikmisTutar)</span>
                                </a>
                            }
                            else if (satir.TahakkukSayisi > 0)
                            {
                                <span class="text-emerald-500 text-sm font-bold">✓</span>
                            }
                            else
                            {
                                <span class="text-muted text-xs">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="bg-slate-50 border-t-2 border-slate-200">
                    <td class="font-bold">Yıllık Toplam</td>
                    <td class="cell-center font-bold">@Model.Satirlar.Sum(s => s.TahakkukSayisi)</td>
                    <td class="num font-bold">@TLFormat(Model.ToplamBeklenen)</td>
                    <td class="num num-positive font-bold">@TLFormat(Model.ToplamTahsil)</td>
                    <td class="num num-negative font-bold">@TLFormat(Model.ToplamBeklenen - Model.ToplamTahsil)</td>
                    <td>
                        <div class="flex items-center gap-2">
                            <div class="h-2 flex-1 bg-white rounded-full border border-slate-200 overflow-hidden">
                                <div class="h-full bg-emerald-500" style="width:@Math.Min(Model.GenelTahsilOrani,100).ToString("F0")%;"></div>
                            </div>
                            <span class="text-xs font-bold text-emerald-600">%@Model.GenelTahsilOrani.ToString("F0")</span>
                        </div>
                    </td>
                    <td class="cell-center">
                        @if (Model.ToplamGecikmiş > 0)
                        {
                            var yilBas = new DateTime(Model.Yil, 1, 1).ToString("yyyy-MM-dd");
                            var yilSon = new DateTime(Model.Yil, 12, 31).ToString("yyyy-MM-dd");
                            var drillUrlTotal = $"/Charge?durum=gecikti&from={yilBas}&to={yilSon}";
                            <a href="@drillUrlTotal" class="no-underline inline-flex flex-col items-center group" title="@Model.Yil yılının gecikmiş tahakkuklarını görüntüle">
                                <span class="badge badge-gecmis group-hover:scale-110 transition-transform">@Model.ToplamGecikmiş Toplam</span>
                                <span class="text-[10px] text-red-700 font-bold mt-0.5">@TLFormat(Model.ToplamGecikmisTutar)</span>
                            </a>
                        }
                        else
                        {
                            <span class="text-emerald-500 font-bold">✓</span>
                        }
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

