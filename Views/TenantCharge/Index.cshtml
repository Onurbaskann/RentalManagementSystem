@model KiraTakip.Models.ViewModels.TenantChargeIndexViewModel
@using KiraTakip.Models
@using KiraTakip.Models.Entities
@using KiraTakip.Models.Common
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Tahakkuklarım";
    ViewData["UseCentralFeedback"] = true;
    string status = Model.Status;
    var query = Model.Query;
    var charges = Model.Charges;
    var controllerName = nameof(KiraTakip.Controllers.TenantChargeController).Replace("Controller", "");
    var indexUrl = Url.Action(nameof(KiraTakip.Controllers.TenantChargeController.Index), controllerName)!;
    var reportPaymentUrl = Url.Action(nameof(KiraTakip.Controllers.TenantChargeController.ReportPayment), controllerName)!;
    var pagination = new PaginationModel { Page = charges.Page, Size = charges.Size, Total = charges.Total, BasePath = indexUrl, Extra = query.ToQueryDict() };

    decimal totalChargeAmount = Model.TotalChargeAmount;
    decimal collectedAmount = Model.CollectedAmount;
    decimal remainingDebtAmount = Model.RemainingDebtAmount;
    decimal overdueRemainingAmount = Model.OverdueRemainingAmount;
}


<div class="page-header">
    <div class="page-title">Tahakkuklarım</div>
    <div class="page-subtitle">Toplam yükümlülük, tahsilat ve gecikmiş bakiye özeti</div>
</div>

<!-- Mutabakat Özeti -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3.5 mb-5">
    <div class="card bg-gradient-to-br from-slate-50 to-white border-slate-200">
        <div class="text-[11.5px] font-bold text-muted uppercase tracking-wider mb-2">Toplam Tahakkuk</div>
        <div class="text-2xl font-bold text-slate-800">@totalChargeAmount.Tl()</div>
        <div class="text-[11px] text-muted mt-1">Tüm dönemlerin brüt yükümlülüğü</div>
    </div>
    <div class="card bg-gradient-to-br from-emerald-50/60 to-white border-emerald-100">
        <div class="text-[11.5px] font-bold text-emerald-700 uppercase tracking-wider mb-2">Ödenen</div>
        <div class="text-2xl font-bold text-emerald-700">@collectedAmount.Tl()</div>
        <div class="text-[11px] text-muted mt-1">Onaylanmış toplam ödeme</div>
    </div>
    <div class="card bg-gradient-to-br @(remainingDebtAmount > 0 ? "from-slate-50 to-white border-slate-200" : "from-emerald-50/60 to-white border-emerald-100")">
        <div class="text-[11.5px] font-bold text-muted uppercase tracking-wider mb-2">Kalan Borç</div>
        <div class="text-2xl font-bold @(remainingDebtAmount > 0 ? "text-slate-800" : "text-emerald-700")">@remainingDebtAmount.Tl()</div>
        <div class="text-[11px] text-muted mt-1">@(remainingDebtAmount > 0 ? "Toplam tahakkuk − tahsil edilen" : "Tüm tahakkuklar karşılandı")</div>
    </div>
    <div class="card bg-gradient-to-br @(overdueRemainingAmount > 0 ? "from-red-50/60 to-white border-red-100" : "from-emerald-50/60 to-white border-emerald-100")">
        <div class="text-[11.5px] font-bold uppercase tracking-wider mb-2 @(overdueRemainingAmount > 0 ? "text-red-700" : "text-emerald-700")">Gecikmiş Bakiye</div>
        <div class="text-2xl font-bold @(overdueRemainingAmount > 0 ? "text-red-700" : "text-emerald-700")">@overdueRemainingAmount.Tl()</div>
        <div class="text-[11px] text-muted mt-1">@(overdueRemainingAmount > 0 ? "Vadesi geçmiş ödenmemiş tutar" : "Gecikmiş borç yok")</div>
    </div>
</div>

<!-- Durum Sekmeleri -->
<div class="flex gap-1.5 mb-4 flex-wrap">
    @{
        var filters = new[] {
            ("tum","Tümü"),
            ("bekliyor","Bekliyor"),
            ("kismi","Kısmi"),
            ("tamodendi","Tam Ödendi"),
            ("gecikti","Gecikti"),
            ("odeme_onay","Ödeme Onayı Bekleyen")
        };
    }
    @foreach (var (key, label) in filters)
    {
        bool isActive = status == key;
        var url = key == "tum"
            ? indexUrl
            : Url.Action(nameof(KiraTakip.Controllers.TenantChargeController.Index), controllerName, new { status = key });
        <a href="@url" class="btn btn-sm @(isActive ? "btn-primary" : "btn-secondary text-slate-600 bg-white border-slate-200")">@label</a>
    }
</div>

<div x-data="{ open: {}, odemeYapModal: false, modalCtx: null, odemeTab: 'havale' }">

<div class="card p-0 overflow-hidden">
    <form method="get" class="flex flex-col gap-2.5 p-3 bg-slate-50/50 border-b border-slate-200" action="@indexUrl">
        <input type="search" name="q" value="@query.Q" class="form-control w-full max-w-xs text-xs font-medium" placeholder="Ara: dönem, taşınmaz…" />

        <div class="flex flex-wrap items-center gap-2.5">
        <select name="unitId" class="form-control w-44 text-xs font-medium">
            <option value="">— Tüm Birimler —</option>
            @foreach (var unit in Model.Units)
            {
                <option value="@unit.Id" selected="@(query.UnitId == unit.Id ? "selected" : null)">@unit.Name</option>
            }
        </select>

        <select name="source" class="form-control w-32 text-xs font-medium">
            <option value="">— Kaynak —</option>
            <option value="lease" selected="@(query.Source == "lease" ? "selected" : null)">Sözleşme</option>
            <option value="manuel" selected="@(query.Source == "manuel" ? "selected" : null)">Manuel</option>
            <option value="reservation" selected="@(query.Source == "reservation" ? "selected" : null)">Rezervasyon</option>
        </select>

        <select name="year" class="form-control w-24 text-xs font-medium">
            <option value="">— Yıl —</option>
            @foreach (var year in Model.AvailableYears)
            {
                <option value="@year" selected="@(query.Year == year ? "selected" : null)">@year</option>
            }
        </select>

        @if (status != "tum") { <input type="hidden" name="status" value="@status" /> }
        <button type="submit" class="btn btn-primary btn-sm px-4">Filtrele</button>
        <a href="@Url.Action(nameof(KiraTakip.Controllers.TenantChargeController.Index), controllerName, status != "tum" ? new { status } : null)" class="btn btn-secondary btn-sm text-slate-500">Temizle</a>
        </div>
    </form>

    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-36">Dönem</th>
                    <th>Birim</th>
                    <th class="w-28 cell-center">Vade</th>
                    <th class="w-32 num">Borç</th>
                    <th class="w-32 num">Ödenen</th>
                    <th class="w-32 num">Kalan</th>
                    <th class="w-32">Durum</th>
                    <th class="w-28">Kaynak</th>
                    <th class="w-20"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var charge in charges.Items)
                {
                    var remainingAmount = charge.TotalAmount - charge.PaidAmount;
                    var availablePaymentAmount = Math.Max(0, remainingAmount - charge.PendingPaymentAmount);
                    bool canPay = Model.CanReportPayment && availablePaymentAmount > 0 && charge.Status != ChargeStatus.Cancelled;
                    string statusCssClass = charge.Status switch {
                        ChargeStatus.Paid    => "badge-kirali",
                        ChargeStatus.PartiallyPaid => "badge-surek",
                        ChargeStatus.Overdue      => "badge-gecmis",
                        ChargeStatus.Cancelled  => "badge-bos",
                        _                           => "badge-bos"
                    };
                    string statusLabel = charge.Status switch {
                        ChargeStatus.Paid    => "Tam Ödendi",
                        ChargeStatus.PartiallyPaid => "Kısmi Ödendi",
                        ChargeStatus.Overdue      => "Gecikti",
                        ChargeStatus.Cancelled  => "İptal Edildi",
                        _                           => "Bekleniyor"
                    };
                    string sourceCssClass = charge.SourceType switch {
                        ChargeSourceType.Manual      => "badge-surek",
                        ChargeSourceType.Reservation => "badge-bireysel",
                        _                              => "badge-bos"
                    };
                    string sourceLabel = charge.SourceType switch {
                        ChargeSourceType.Manual      => "Manuel",
                        ChargeSourceType.Reservation => "Rezervasyon",
                        _                              => "Sözleşme"
                    };
                    <tr @@click="open[@charge.Id] = !open[@charge.Id]" class="cursor-pointer transition-colors hover:bg-slate-50">
                        <td>
                            <div class="flex items-center gap-2">
                                <span class="text-slate-300 transition-transform duration-200" :class="open[@charge.Id] ? 'rotate-180' : ''">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
                                </span>
                                @charge.PeriodStart.ToString("MMMM yyyy")
                            </div>
                        </td>
                        <td>
                            @(charge.PropertyName ?? "—")
                            @if (!string.IsNullOrEmpty(charge.UnitName))
                            {
                                <span class="cell-sub">@charge.UnitName</span>
                            }
                        </td>
                        <td class="cell-center">@charge.DueDate.Tarih()</td>
                        <td class="num">@charge.TotalAmount.Tl()</td>
                        <td class="num num-positive">@charge.PaidAmount.Tl()</td>
                        <td class="num @(remainingAmount > 0 ? "num-negative" : "num-positive")">@remainingAmount.Tl()</td>
                        <td>
                            @if (charge.PendingPaymentCount > 0)
                            {
                                <span class="badge badge-surek">Ödeme Onayı Bekleniyor</span>
                            }
                            else
                            {
                                <span class="badge @statusCssClass">@statusLabel</span>
                            }
                        </td>
                        <td><span class="badge @sourceCssClass">@sourceLabel</span></td>
                        <td @@click.stop="" class="num">
                            <div class="flex gap-1 justify-end">
                                <a href="@Url.Action(nameof(KiraTakip.Controllers.TenantChargeController.Details), controllerName, new { id = charge.Id.ToHashId() })" class="btn btn-sm btn-secondary p-1" title="Detay">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </a>
                                @if (canPay)
                                {
                                    <button type="button"
                                            @@click='odemeYapModal = true; odemeTab = "havale"; modalCtx = { chargeId: @charge.Id, kalan: @availablePaymentAmount.ToString(System.Globalization.CultureInfo.InvariantCulture), kalanLabel: "@availablePaymentAmount.Tl()", donem: "@charge.PeriodStart.ToString("MMMM yyyy")" }'
                                            class="btn btn-sm btn-primary">Ödeme Yap</button>
                                }
                            </div>
                        </td>
                    </tr>
                    <tr x-show="open[@charge.Id]" x-cloak class="bg-slate-50/80 border-b border-slate-200">
                        <td colspan="9" class="p-4 px-12">
                            @if (charge.LineItems.Any())
                            {
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Kalem Detayları</div>
                                <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
                                    <table class="w-full text-xs">
                                        <thead class="bg-slate-50 border-b border-slate-200">
                                            <tr class="text-slate-500 font-bold uppercase tracking-wider text-[9px]">
                                                <th class="p-2 px-3 text-left">Açıklama</th>
                                                <th class="p-2 px-3 text-right">Birim</th>
                                                <th class="p-2 px-3 text-right">Tutar</th>
                                                <th class="p-2 px-3 text-right text-muted">KDV</th>
                                                <th class="p-2 px-3 text-right">Toplam</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var lineItem in charge.LineItems.OrderBy(lineItem => lineItem.ChargeTypeSortOrder))
                                            {
                                                <tr class="border-t border-slate-100 last:border-0">
                                                    <td class="p-2 px-3 text-slate-600">@lineItem.Description</td>
                                                    <td class="p-2 px-3 text-right text-slate-500">@lineItem.UnitValue.Tl()</td>
                                                    <td class="p-2 px-3 text-right font-semibold text-slate-600">@lineItem.Amount.Tl()</td>
                                                    <td class="p-2 px-3 text-right text-slate-400/60">@lineItem.VatAmount.Tl()</td>
                                                    <td class="p-2 px-3 text-right font-bold text-slate-700">@lineItem.TotalAmount.Tl()</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-xs text-muted italic">Kalem bilgisi bulunmuyor.</div>
                            }
                        </td>
                    </tr>
                }
                @if (charges.Total == 0)
                {
                    <tr><td colspan="9" class="text-center py-16 text-muted italic">Filtreye uygun tahakkuk kaydı bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>

<!-- Ödeme Yap Modal -->
<div x-show="odemeYapModal" x-cloak @@keydown.escape.window="odemeYapModal = false"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
    <div @@click.outside="odemeYapModal = false" class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col">
        <div class="p-5 border-b border-slate-200 flex items-center justify-between shrink-0">
            <div>
                <div class="text-sm font-bold text-slate-800">Ödeme</div>
                <div class="text-[12px] text-muted mt-0.5"><span x-text="modalCtx?.donem"></span> — Kalan: <span class="font-bold text-red-600" x-text="modalCtx?.kalanLabel"></span></div>
            </div>
            <button type="button" @@click="odemeYapModal = false" class="text-slate-400 hover:text-slate-700 transition-colors">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>

        <div class="flex border-b border-slate-200 shrink-0">
            <button type="button" @@click="odemeTab = 'havale'"
                    :class="odemeTab === 'havale' ? 'border-blue-600 text-blue-700 bg-blue-50/40' : 'border-transparent text-slate-500 hover:text-slate-700'"
                    class="flex-1 px-4 py-3 border-b-2 text-[13px] font-bold transition-colors flex items-center justify-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6l9 4 9-4M3 18V8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                Havale / EFT Bildir
            </button>
            <button type="button" @@click="odemeTab = 'pos'"
                    :class="odemeTab === 'pos' ? 'border-blue-600 text-blue-700 bg-blue-50/40' : 'border-transparent text-slate-500 hover:text-slate-700'"
                    class="flex-1 px-4 py-3 border-b-2 text-[13px] font-bold transition-colors flex items-center justify-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                Kart ile Öde
                <span class="text-[9px] font-bold bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded">YAKINDA</span>
            </button>
        </div>

        <div class="p-6 overflow-y-auto">
            <!-- HAVALE TAB -->
            <div x-show="odemeTab === 'havale'">
                <form method="post" action="@reportPaymentUrl" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ChargeId" :value="modalCtx?.chargeId" />

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Tutar (₺) *</label>
                            <input type="number" name="Amount" step="0.01" :value="modalCtx?.kalan" class="form-control w-full" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Ödeme Tarihi *</label>
                            <input type="date" name="PaymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control w-full" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Ödeme Kanalı *</label>
                        <div class="grid grid-cols-4 gap-2">
                            <label class="flex items-center gap-2 cursor-pointer border border-slate-200 rounded-lg px-3 py-2 hover:border-blue-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50/40 transition-colors">
                                <input type="radio" name="PaymentChannel" value="@((int)PaymentChannel.BankTransfer)" checked class="accent-blue-600" />
                                <span class="text-[13px] font-medium">Havale</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer border border-slate-200 rounded-lg px-3 py-2 hover:border-blue-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50/40 transition-colors">
                                <input type="radio" name="PaymentChannel" value="@((int)PaymentChannel.Eft)" class="accent-blue-600" />
                                <span class="text-[13px] font-medium">EFT</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer border border-slate-200 rounded-lg px-3 py-2 hover:border-blue-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50/40 transition-colors">
                                <input type="radio" name="PaymentChannel" value="@((int)PaymentChannel.Cash)" class="accent-blue-600" />
                                <span class="text-[13px] font-medium">Nakit</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer border border-slate-200 rounded-lg px-3 py-2 hover:border-blue-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50/40 transition-colors">
                                <input type="radio" name="PaymentChannel" value="@((int)PaymentChannel.Other)" class="accent-blue-600" />
                                <span class="text-[13px] font-medium">Diğer</span>
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Dekont *</label>
                        <input type="file" name="Receipt" accept=".pdf,.jpg,.jpeg,.png" class="form-control w-full" />
                        <div class="text-[11px] text-muted mt-1">PDF, JPG veya PNG (zorunlu)</div>
                    </div>

                    <div class="mb-5">
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Açıklama</label>
                        <textarea name="Description" rows="2" class="form-control w-full" placeholder="Opsiyonel not"></textarea>
                    </div>

                    <div class="bg-blue-50/60 border border-blue-100 text-blue-800 p-3 rounded-lg text-[12px] mb-5 flex items-start gap-2">
                        <svg class="shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>Ödemeniz yönetici onayı sonrası tahakkuka işlenecektir.</span>
                    </div>

                    <div class="flex gap-2 justify-end">
                        <button type="button" @@click="odemeYapModal = false" class="btn btn-secondary">İptal</button>
                        <button type="submit" class="btn btn-primary">Ödemeyi Bildir</button>
                    </div>
                </form>
            </div>

            <!-- POS TAB (Placeholder) -->
            <div x-show="odemeTab === 'pos'" x-cloak>
                <div class="space-y-4 opacity-60 pointer-events-none">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Kart Üzerindeki İsim</label>
                        <input type="text" disabled class="form-control w-full bg-slate-50 border-slate-200" placeholder="Ad Soyad" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Kart Numarası</label>
                        <input type="text" disabled maxlength="19" class="form-control w-full bg-slate-50 border-slate-200 font-mono tracking-wider" placeholder="0000 0000 0000 0000" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">Son Kullanma</label>
                            <input type="text" disabled maxlength="5" class="form-control w-full bg-slate-50 border-slate-200 font-mono tracking-wider" placeholder="AA/YY" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wide">CVV</label>
                            <input type="text" disabled maxlength="4" class="form-control w-full bg-slate-50 border-slate-200 font-mono tracking-wider" placeholder="123" />
                        </div>
                    </div>
                </div>

                <div class="rounded-xl bg-gradient-to-r from-slate-50 to-blue-50/40 border border-slate-200/70 px-5 py-4 mt-5">
                    <div class="flex items-end justify-between">
                        <div class="text-[11px] text-slate-500 font-semibold uppercase tracking-wider">Toplam Ödenecek</div>
                        <div class="text-2xl font-bold text-slate-800"><span x-text="modalCtx?.kalanLabel"></span></div>
                    </div>
                </div>

                <div title="Online ödeme yakında aktif olacak." class="cursor-not-allowed mt-4">
                    <button type="button" disabled class="w-full btn py-3 text-sm font-bold text-white rounded-xl bg-gradient-to-r from-blue-600 to-blue-500 disabled:opacity-60 disabled:cursor-not-allowed pointer-events-none flex justify-center items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Ödemeyi Tamamla
                    </button>
                </div>

                <div class="mt-3 bg-amber-50/60 border border-amber-100 text-amber-800 p-3 rounded-lg text-[12px] flex items-start gap-2">
                    <svg class="shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <span>Online kart ödeme altyapısı entegrasyon aşamasındadır. Şimdilik <strong>Havale/EFT</strong> sekmesinden ödeme bildirimi yapabilirsiniz.</span>
                </div>
            </div>
        </div>
    </div>
</div>

</div>
