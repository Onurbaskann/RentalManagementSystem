@model KiraTakip.Models.Common.PagedResult<TahakkukListItemDto>
@using KiraTakip.Models
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Charges";
    bool canCreate = User.HasPermission(PermissionCatalog.Payment.Create);
    string durum = ViewBag.Durum ?? "tum";
    var q = (TableQuery)ViewBag.Query;
    int iptalEdildiSayisi = ViewBag.IptalEdildiSayisi ?? 0;
    var pagination = new PaginationModel { Page = Model.Page, Size = Model.Size, Total = Model.Total, BasePath = "/Charge", Extra = q.ToQueryDict() };
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Charges</div>
        <div class="page-subtitle">@Model.Total dönem kaydı listeleniyor</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 px-4 rounded-lg mb-4 text-[13.5px]">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 p-3 px-4 rounded-lg mb-4 text-[13.5px]">✕ @TempData["Error"]</div>
}

<!-- Filtreler -->
<div class="flex gap-1.5 mb-4 flex-wrap items-center">
    @{
        var filters = new[] {
            ("tum","Tümü"),
            ("bekliyor","Bekliyor"),
            ("kismi","Kısmi"),
            ("tamodendi","Tam Ödendi"),
            ("gecikti","Gecikti"),
            ("odeme_onay","Ödeme Onayı Bekleyen")
        };
    }
    @foreach (var (key, label) in filters)
    {
        bool isActive = durum == key;
        var url = key == "tum" ? "/Charge" : $"/Charge?durum={key}";
        <a href="@url" class="btn btn-sm @(isActive ? "btn-primary" : "btn-secondary text-slate-600 bg-white border-slate-200")">@label</a>
    }
</div>
@if (iptalEdildiSayisi > 0 && (durum == "tum" || string.IsNullOrEmpty(durum)))
{
    <div class="text-[12px] text-slate-400 mb-4 -mt-2">
        @iptalEdildiSayisi iptal edilmiş kayıt varsayılan görünümde gizleniyor.
        <a href="/Charge?durum=iptal" class="text-slate-500 hover:text-primary underline ml-1">Görüntüle →</a>
    </div>
}

<script>
    window._tahakkukBirimler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ((List<Unit>)ViewBag.Units)
            .Select(b => new { id = b.Id, ad = b.Name, propertyId = b.PropertyId })
    ));
</script>
<div class="card p-0 overflow-hidden">
    <form method="get" class="flex flex-col gap-2.5 p-3 bg-slate-50/50 border-b border-slate-200" action="/Charge"
          x-data="{
              propertyId: '@(q.TasinmazId?.ToString() ?? "")',
              unitId: '@(q.BirimId?.ToString() ?? "")',
              get filtrelenmisBirimler() {
                  if (!this.propertyId) return [];
                  var tid = parseInt(this.propertyId);
                  return window._tahakkukBirimler.filter(function(b) { return b.propertyId === tid; });
              }
          }">
        <input type="search" name="q" value="@q.Q" class="form-control w-full max-w-xs text-xs font-medium" placeholder="Ara: kiracı, taşınmaz…" />

        <div class="flex flex-wrap items-center gap-2.5">
        <select name="propertyId" x-model="propertyId" @@change="unitId = ''"
                class="form-control w-44 text-xs font-medium">
            <option value="">— Tüm Taşınmazlar —</option>
            @foreach (var t in (List<Property>)ViewBag.Properties)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>

        <select name="unitId" x-model="unitId" x-show="filtrelenmisBirimler.length > 0"
                class="form-control w-44 text-xs font-medium" x-cloak>
            <option value="">— Tüm Units —</option>
            <template x-for="b in filtrelenmisBirimler" :key="b.id">
                <option :value="b.id" x-text="b.ad" :selected="b.id.toString() === unitId"></option>
            </template>
        </select>

        <select name="tenantId" class="form-control w-44 text-xs font-medium">
            <option value="">— Tüm Kiracılar —</option>
            @foreach (var k in (List<Tenant>)ViewBag.Kiracilar)
            {
                <option value="@k.Id" selected="@(q.KiraciId == k.Id ? "selected" : null)">@k.DisplayName</option>
            }
        </select>

        <select name="kaynak" class="form-control w-32 text-xs font-medium">
            <option value="">— Kaynak —</option>
            <option value="lease" selected="@(q.Kaynak == "lease" ? "selected" : null)">Sözleşme</option>
            <option value="manuel" selected="@(q.Kaynak == "manuel" ? "selected" : null)">Manuel</option>
            <option value="reservation" selected="@(q.Kaynak == "reservation" ? "selected" : null)">Reservation</option>
        </select>

        <select name="yil" class="form-control w-24 text-xs font-medium">
            <option value="">— Yıl —</option>
            @foreach (var y in (List<int>)ViewBag.MevcutYillar)
            {
                <option value="@y" selected="@(q.Yil == y ? "selected" : null)">@y</option>
            }
        </select>

        <div class="flex items-center gap-1.5">
            <span class="text-xs font-medium" style="color:var(--color-muted)">Vade:</span>
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                { "Name", "from" }, { "Value", q.From?.ToString("yyyy-MM-dd") ?? "" },
                { "Mode", "date" }, { "Field", "from" }, { "Compact", true }, { "WrapperClass", "w-36" }
            })
            <span class="text-muted">–</span>
            @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                { "Name", "to" }, { "Value", q.To?.ToString("yyyy-MM-dd") ?? "" },
                { "Mode", "date" }, { "Field", "to" }, { "Compact", true }, { "WrapperClass", "w-36" }
            })
        </div>
        
        <div class="flex items-center gap-1.5">
            <span class="text-xs font-medium" style="color:var(--color-muted)">Borç:</span>
            <input type="number" name="min" value="@q.Min?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control w-24 text-xs font-medium" placeholder="Min ₺" />
            <span class="text-muted">–</span>
            <input type="number" name="max" value="@q.Max?.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control w-24 text-xs font-medium" placeholder="Max ₺" />
        </div>

        @if (durum != "tum") { <input type="hidden" name="durum" value="@durum" /> }
        @{
            int aktifFiltreSayisi = (string.IsNullOrEmpty(q.Q) ? 0 : 1)
                + (q.TasinmazId.HasValue ? 1 : 0)
                + (q.BirimId.HasValue ? 1 : 0)
                + (q.KiraciId.HasValue ? 1 : 0)
                + (!string.IsNullOrEmpty(q.Kaynak) ? 1 : 0)
                + (q.Yil.HasValue ? 1 : 0)
                + (q.From.HasValue || q.To.HasValue ? 1 : 0)
                + (q.Min.HasValue || q.Max.HasValue ? 1 : 0);
        }
        <button type="submit" class="btn btn-primary btn-sm px-4 flex items-center gap-2">
            Filtrele
            @if (aktifFiltreSayisi > 0)
            {
                <span class="flex items-center justify-center min-w-[18px] h-[18px] bg-white/20 rounded-full text-[10px] font-bold">@aktifFiltreSayisi</span>
            }
        </button>
        @if (aktifFiltreSayisi > 0)
        {
            <a href="/Charge@(durum != "tum" ? $"?durum={durum}" : "")" class="btn btn-secondary btn-sm text-slate-500">Temizle</a>
        }
        </div>
    </form>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-36">Dönem</th>
                    <th>Kiracı</th>
                    <th>Taşınmaz / Unit</th>
                    <th class="w-28 cell-center">Vade</th>
                    <th class="w-32 num">Borç</th>
                    <th class="w-32 num">Ödenen</th>
                    <th class="w-32 num">Kalan</th>
                    <th class="w-32">Durum</th>
                    <th class="w-28">Kaynak</th>
                    <th class="w-20"></th>
                </tr>
            </thead>
            <tbody x-data="{ open: {} }">
                @foreach (var t in Model.Items)
                {
                    var kalan = t.ToplamTutar - t.PaidAmount;
                    string durumCls = t.Durum switch {
                        ChargeStatus.Paid    => "badge-kirali",
                        ChargeStatus.PartiallyPaid => "badge-surek",
                        ChargeStatus.Overdue      => "badge-gecmis",
                        ChargeStatus.Cancelled  => "badge-bos",
                        _                           => "badge-bos"
                    };
                    string durumLabel = t.Durum switch {
                        ChargeStatus.Paid    => "Tam Ödendi",
                        ChargeStatus.PartiallyPaid => "Kısmi Ödendi",
                        ChargeStatus.Overdue      => "Gecikti",
                        ChargeStatus.Cancelled  => "İptal Edildi",
                        _                           => "Bekleniyor"
                    };
                    string tahakkukKaynakCls = t.SourceType switch {
                        ChargeSourceType.Manual      => "badge-surek",
                        ChargeSourceType.Reservation => "badge-bireysel",
                        _                              => "badge-bos"
                    };
                    string tahakkukKaynakLabel = t.SourceType switch {
                        ChargeSourceType.Manual      => "Manuel",
                        ChargeSourceType.Reservation => "Reservation",
                        _                              => "Sözleşme"
                    };
                    <tr @@click="open[@t.Id] = !open[@t.Id]" class="cursor-pointer transition-colors hover:bg-slate-50">
                        <td>
                            <div class="flex items-center gap-2">
                                <span class="text-slate-300 transition-transform duration-200" :class="open[@t.Id] ? 'rotate-180' : ''">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
                                </span>
                                @t.PeriodStart.ToString("MMMM yyyy")
                            </div>
                        </td>
                        <td>@(t.KiraciGosterimAdi ?? "Toplantı Salonu Rez.")</td>
                        <td>
                            @(t.TasinmazAd ?? "Toplantı Salonu")
                            <span class="cell-sub">@(t.BirimAd ?? "Ortak Alan")</span>
                        </td>
                        <td class="cell-center">@t.DueDate.ToString("dd.MM.yyyy")</td>
                        <td class="num">@t.ToplamTutar.ToString("N2") ₺</td>
                        <td class="num num-positive">@t.PaidAmount.ToString("N2") ₺</td>
                        <td class="num @(kalan > 0 ? "num-negative" : "num-positive")">@kalan.ToString("N2") ₺</td>
                        <td>
                            @if (t.BekleyenOdemeSayisi > 0)
                            {
                                <a href="/Payment?tahakkukId=@t.Id.ToHashId()&durum=onaybekliyor" class="badge badge-surek hover:opacity-80 transition-opacity">Ödeme Onayı Bekleniyor</a>
                            }
                            else
                            {
                                <span class="badge @durumCls">@durumLabel</span>
                            }
                        </td>
                        <td><span class="badge @tahakkukKaynakCls">@tahakkukKaynakLabel</span></td>
                        <td @@click.stop="" class="num">
                            <div class="flex gap-1 justify-end">
                                <a href="/Charge/Detay/@t.Id.ToHashId()" class="btn btn-sm btn-secondary p-1" title="Detay"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
                                @if (canCreate && t.Durum != ChargeStatus.Paid && t.Durum != ChargeStatus.Cancelled)
                                {
                                    <a href="/Payment/Ekle?tahakkukId=@t.Id.ToHashId()" class="btn btn-sm btn-primary">Ödeme</a>
                                }
                            </div>
                        </td>
                    </tr>
                            <tr x-show="open[@t.Id]" x-cloak class="bg-slate-50/80 border-b border-slate-200">
                                <td colspan="10" class="p-4 px-12">
                                    @if (t.LineItems.Any())
                                    {
                                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Kalem Detayları</div>
                                        <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
                                            <table class="w-full text-xs">
                                                <thead class="bg-slate-50 border-b border-slate-200">
                                                    <tr class="text-slate-500 font-bold uppercase tracking-wider text-[9px]">
                                                        <th class="p-2 px-3 text-left">Açıklama</th>
                                                        <th class="p-2 px-3 text-right">Unit</th>
                                                        <th class="p-2 px-3 text-right">Amount</th>
                                                        <th class="p-2 px-3 text-right text-muted">KDV</th>
                                                        <th class="p-2 px-3 text-right">Toplam</th>
                                                        <th class="p-2 px-3 text-center">Kaynak</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var k in t.LineItems.OrderBy(k => k.BorcTipiSira))
                                                    {
                                                        string kaynakCls = k.SourceType switch {
                                                            LineItemSourceType.UndefinedRate    => "badge-bos",
                                                            LineItemSourceType.LeaseRateOverride  => "badge-surek",
                                                            LineItemSourceType.UnitRateOverride     => "badge-kirali",
                                                            LineItemSourceType.PropertyRateOverride  => "badge-bireysel",
                                                            LineItemSourceType.RateSchedule       => "badge-bos",
                                                            LineItemSourceType.ManualInput       => "badge-surek",
                                                            LineItemSourceType.ReservationRule => "badge-bireysel",
                                                            _                                 => "badge-bos"
                                                        };
                                                        string kaynakLabel = k.SourceType switch {
                                                            LineItemSourceType.UndefinedRate    => "Tarife Yok",
                                                            LineItemSourceType.LeaseRateOverride  => "Sözleşme",
                                                            LineItemSourceType.UnitRateOverride     => "Unit",
                                                            LineItemSourceType.PropertyRateOverride  => "Taşınmaz",
                                                            LineItemSourceType.RateSchedule       => "Genel",
                                                            LineItemSourceType.ManualInput       => "Manuel",
                                                            LineItemSourceType.ReservationRule => "Reservation",
                                                            _                                 => "Bilinmiyor"
                                                        };
                                                        <tr class="border-t border-slate-100 last:border-0 hover:bg-slate-50/50 transition-colors">
                                                            <td class="p-2 px-3 text-slate-600">@k.Aciklama</td>
                                                            <td class="p-2 px-3 text-right text-slate-500">@k.UnitValue.ToString("N2") ₺@(k.CalculationMethod == CalculationMethod.M2 ? "/m²" : "")</td>
                                                            <td class="p-2 px-3 text-right font-semibold text-slate-600">@k.Amount.ToString("N2") ₺</td>
                                                            <td class="p-2 px-3 text-right text-slate-400/60">@k.KdvTutari.ToString("N2") ₺</td>
                                                            <td class="p-2 px-3 text-right font-bold text-slate-700">@k.ToplamTutar.ToString("N2") ₺</td>
                                                            <td class="p-2 px-3 text-center"><span class="badge @kaynakCls text-[9px] font-bold">@kaynakLabel.ToUpper()</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-muted italic">Kalem bilgisi bulunmuyor.</div>
                                    }
                                </td>
                            </tr>
                }
                @if (Model.Total == 0)
                {
                    <tr><td colspan="10" class="text-center py-16 text-muted italic">Filtreye uygun charge kaydı bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>

