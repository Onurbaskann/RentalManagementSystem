@model ChargeDetailDto
@using KiraTakip.Models
@{
    ViewData["Title"] = $"Tahakkuk #{Model.Id}";
    ViewData["UseCentralFeedback"] = true;

    var remainingAmount = Model.TotalAmount - Model.PaidAmount;

    string statusClass = Model.Status switch {
        ChargeStatus.Paid    => "badge-kirali",
        ChargeStatus.PartiallyPaid => "badge-surek",
        ChargeStatus.Overdue      => "badge-gecmis",
        ChargeStatus.Cancelled  => "badge-bos",
        _                           => "badge-bos"
    };
    string statusLabel = Model.Status switch {
        ChargeStatus.Paid    => "Tam Ödendi",
        ChargeStatus.PartiallyPaid => "Kısmi Ödendi",
        ChargeStatus.Overdue      => "Gecikti",
        ChargeStatus.Cancelled  => "İptal Edildi",
        _                           => "Bekleniyor"
    };

    bool canCreate = User.HasPermission(PermissionCatalog.Payment.Create);
    bool isCancelled = Model.Status == ChargeStatus.Cancelled;
    bool isFullyPaid = Model.Status == ChargeStatus.Paid;
}


<!-- Breadcrumb -->
<div class="flex items-center justify-between mb-5">
    <a href="/Charge" class="text-[12.5px] text-muted no-underline hover:text-primary transition-colors">← Tahakkuklar</a>
    <div class="flex gap-2">
        @if (Model.LeaseId != null)
        {
            <a href="/Lease/Details/@Model.LeaseId.ToHashId()" class="btn btn-sm btn-secondary">Sözleşme Detayı</a>
        }
        @if (canCreate && !isCancelled && !isFullyPaid)
        {
            <a href="/Payment/Create?chargeId=@Model.Id.ToHashId()" class="btn btn-sm btn-primary">Ödeme Ekle</a>
        }
    </div>
</div>

<!-- Özet kart -->
<div class="card mb-4">
    <div class="flex items-start justify-between flex-wrap gap-5">
        <div>
            <div class="text-[11.5px] font-bold text-muted uppercase tracking-wider mb-1.5">Dönem</div>
            <div class="font-serif text-[28px] font-bold leading-tight">@Model.PeriodStart.ToString("MMMM yyyy")</div>
            <div class="text-[13px] text-muted mt-1">
                @Model.PeriodStart.Tarih() — @Model.PeriodEnd.Tarih()
                &nbsp;•&nbsp; Vade: @Model.DueDate.Tarih()
            </div>
            <div class="mt-2"><span class="badge @statusClass text-[12.5px] px-3.5 py-1.5">@statusLabel</span></div>
        </div>
        <div class="flex gap-6 flex-wrap">
            <div class="text-center">
                <div class="text-[11.5px] font-bold text-muted uppercase mb-1">Beklenen</div>
                <div class="text-xl font-bold">@Model.TotalAmount.Tl()</div>
            </div>
            <div class="text-center">
                <div class="text-[11.5px] font-bold text-muted uppercase mb-1">Ödenen</div>
                <div class="text-xl font-bold text-emerald-800">@Model.PaidAmount.Tl()</div>
            </div>
            <div class="text-center">
                <div class="text-[11.5px] font-bold text-muted uppercase mb-1">Kalan</div>
                <div class="text-xl font-bold @(remainingAmount > 0 ? "text-red-500" : "text-emerald-800")">@remainingAmount.Tl()</div>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-3.5 border-t border-slate-200 flex gap-8 flex-wrap text-[13px]">
        <div>
            <span class="text-muted">Kiracı: </span>
            @if (Model.TenantId != null && Model.TenantId > 0) {
                <a href="/Tenant/Details/@Model.TenantId.ToHashId()" class="font-semibold no-underline hover:underline">@Model.TenantDisplayName</a>
            } else {
                <span class="font-semibold">Rezervasyon Sahibi</span>
            }
        </div>
        <div>
            <span class="text-muted">Taşınmaz: </span>
            @if (Model.PropertyId != null) {
                <a href="/Property/Details/@Model.PropertyId.ToHashId()" class="font-semibold no-underline hover:underline">@Model.PropertyName</a>
            } else {
                <span class="font-semibold">Toplantı Salonu</span>
            }
        </div>
        <div>
            <span class="text-muted">Birim: </span>
            <span class="font-semibold">@(Model.UnitName ?? "Rezervasyon")</span>
        </div>
        @if (Model.LeaseId != null) {
            <div>
                <span class="text-muted">Sözleşme: </span>
                <a href="/Lease/Details/@Model.LeaseId.ToHashId()" class="font-semibold no-underline hover:underline">#@Model.LeaseId</a>
            </div>
        }
    </div>
</div>

<!-- Kalem Dökümü -->
<div class="card p-0 overflow-hidden mb-4">
    <div class="p-[14px_20px] border-b border-slate-200">
        <div class="text-sm font-bold">Kalem Dökümü</div>
        <div class="text-xs text-muted mt-0.5">Tahakkuk oluşturulma tarihi: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
    </div>
    @if (Model.LineItems.Any())
    {
        <div class="overflow-hidden rounded-lg border border-slate-200 bg-white m-4">
            <table class="w-full text-xs">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr class="text-slate-500 font-bold uppercase tracking-wider text-[9px]">
                        <th class="p-2 px-3 text-left">Açıklama</th>
                        <th class="p-2 px-3 text-left">Hesaplama</th>
                        <th class="p-2 px-3 text-right">Birim</th>
                        <th class="p-2 px-3 text-right">Tutar</th>
                        <th class="p-2 px-3 text-right text-muted">KDV (%)</th>
                        <th class="p-2 px-3 text-right text-muted">KDV Tutarı</th>
                        <th class="p-2 px-3 text-right">Toplam</th>
                        <th class="p-2 px-3 text-center">Kaynak</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lineItem in Model.LineItems.OrderBy(item => item.ChargeTypeSortOrder))
                    {
                        string sourceClass = lineItem.SourceType switch {
                            LineItemSourceType.UndefinedRate    => "badge-bos",
                            LineItemSourceType.LeaseRateOverride  => "badge-surek",
                            LineItemSourceType.UnitRateOverride     => "badge-kirali",
                            LineItemSourceType.PropertyRateOverride  => "badge-bireysel",
                            LineItemSourceType.RateSchedule       => "badge-bos",
                            LineItemSourceType.ManualInput       => "badge-surek",
                            LineItemSourceType.ReservationRule => "badge-bireysel",
                            _                                 => "badge-bos"
                        };
                        string sourceLabel = lineItem.SourceType switch {
                            LineItemSourceType.UndefinedRate    => "Tanımsız Tarife",
                            LineItemSourceType.LeaseRateOverride  => "Sözleşme Tarifesi",
                            LineItemSourceType.UnitRateOverride     => "Birim Tarifesi",
                            LineItemSourceType.PropertyRateOverride  => "Taşınmaz Tarifesi",
                            LineItemSourceType.RateSchedule       => "Genel Tarife",
                            LineItemSourceType.ManualInput       => "Manuel Giriş",
                            LineItemSourceType.ReservationRule => "Rezervasyon Kuralı",
                            _                                 => "Bilinmiyor"
                        };
                        string sourceTooltip = lineItem.SourceType switch {
                            LineItemSourceType.UndefinedRate    => "Fiyat tanımı bulunamadığı için 0₺ olarak üretildi.",
                            LineItemSourceType.LeaseRateOverride  => "Sözleşmeye özel tarife fiyatı kullanıldı.",
                            LineItemSourceType.UnitRateOverride     => "Birim düzeyinde özel fiyat kullanıldı.",
                            LineItemSourceType.PropertyRateOverride  => "Taşınmaz ve kiracı kategorisine özel matris fiyatı kullanıldı.",
                            LineItemSourceType.RateSchedule       => "Genel tarife fiyatı uygulandı.",
                            LineItemSourceType.ManualInput       => "Kullanıcı tarafından manuel olarak girildi.",
                            LineItemSourceType.ReservationRule => "Rezervasyon kuralından aktarıldı.",
                            _                                 => ""
                        };
                        <tr class="border-t border-slate-100 last:border-0 hover:bg-slate-50/50 transition-colors">
                            <td class="p-2 px-3 text-slate-600 font-medium">@lineItem.Description</td>
                            <td class="p-2 px-3 text-slate-400">@(lineItem.CalculationMethod == CalculationMethod.M2 ? "m² Bazlı" : "Sabit")</td>
                            <td class="p-2 px-3 text-right text-slate-500">@lineItem.UnitValue.Tl()@(lineItem.CalculationMethod == CalculationMethod.M2 ? "/m²" : "")</td>
                            <td class="p-2 px-3 text-right font-semibold text-slate-600">@lineItem.Amount.Tl()</td>
                            <td class="p-2 px-3 text-right text-slate-400/60">@lineItem.KdvRate.Yuzde(0)</td>
                            <td class="p-2 px-3 text-right text-slate-400/60">@lineItem.VatAmount.Tl()</td>
                            <td class="p-2 px-3 text-right font-bold text-slate-700">@lineItem.TotalAmount.Tl()</td>
                            <td class="p-2 px-3 text-center"><span class="badge @sourceClass text-[11px]" data-tip="@sourceTooltip">@sourceLabel</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-slate-50 border-t-2 border-slate-200">
                    <tr class="font-bold text-[9px] uppercase tracking-wider text-slate-500">
                        <td colspan="3" class="p-2 px-3">Toplam</td>
                        <td class="p-2 px-3 text-right text-slate-600">@Model.ExpectedAmount.Tl()</td>
                        <td></td>
                        <td class="p-2 px-3 text-right text-slate-400/60">@Model.VatAmount.Tl()</td>
                        <td class="p-2 px-3 text-right text-slate-700">@Model.TotalAmount.Tl()</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="p-8 text-center text-muted">Kalem bilgisi yok (eski tahakkuk).</div>
    }
</div>

<!-- Ödeme Geçmişi -->
<div class="card p-0 overflow-hidden">
    <div class="p-[14px_20px] border-b border-slate-200">
        <div class="text-sm font-bold">Ödeme Geçmişi</div>
    </div>
    @if (Model.Allocations.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Ödeme Tarihi</th>
                        <th class="text-right">Tutar</th>
                        <th>Kanal</th>
                        <th>Durum</th>
                        <th>Giriş Tarihi</th>
                        <th>Açıklama</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Allocations.OrderByDescending(item => item.PaymentDate))
                    {
                        string paymentStatusClass = payment.Status switch {
                            PaymentStatus.Approved     => "badge-kirali",
                            PaymentStatus.Rejected    => "badge-gecmis",
                            _                         => "badge-bos"
                        };
                        string paymentStatusLabel = payment.Status switch {
                            PaymentStatus.Approved  => "Onaylandı",
                            PaymentStatus.Rejected => "Reddedildi",
                            _                      => "Onay Bekliyor"
                        };
                        string channelLabel = payment.PaymentChannel switch {
                            PaymentChannel.BankTransfer => "Havale",
                            PaymentChannel.Eft    => "EFT",
                            PaymentChannel.Cash  => "Nakit",
                            _                  => "Diğer"
                        };
                        <tr>
                            <td class="font-semibold">@payment.PaymentDate.Tarih()</td>
                            <td class="text-right font-bold @(payment.Status == PaymentStatus.Approved ? "text-emerald-800" : "")">@payment.Amount.Tl()</td>
                            <td class="text-[13px]">@channelLabel</td>
                            <td><span class="badge @paymentStatusClass">@paymentStatusLabel</span></td>
                            <td class="text-[12px] text-muted">@payment.EntryDate.Tarih() @payment.EntryDate.ToString("HH:mm")</td>
                            <td class="text-[13px] text-muted">@payment.Description</td>
                            <td><a href="/Payment/Details/@payment.Id.ToHashId()" class="btn btn-sm btn-secondary">Detay</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-8 text-center text-muted">
            <div class="mb-3">Bu dönem için henüz ödeme kaydı yok.</div>
            @if (canCreate && !isCancelled && !isFullyPaid)
            {
                <a href="/Payment/Create?chargeId=@Model.Id.ToHashId()" class="btn btn-primary btn-sm">Ödeme Ekle</a>
            }
        </div>
    }
</div>
