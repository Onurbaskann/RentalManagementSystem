@model KiraTakip.Models.ViewModels.ManuelBorcCreateViewModel
@using KiraTakip.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Manuel Borç Ekle";

    var sozlesmeJson = JsonSerializer.Serialize(Model.AktifSozlesmeler.Select(s => new {
        id = s.Id,
        tenantId = s.TenantId,
        unitId = s.UnitId,
        kiraciAdi = s.TenantDisplayName,
        birimAdi = s.PropertyName + " / " + s.UnitName
    }));
}

<div class="max-w-[1000px] mx-auto">
    <div class="page-header">
        <a href="/ManualCharge" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← Manuel Borçlar</a>
        <div class="page-title">Manuel Borç Ekle</div>
        <div class="page-subtitle">Kiracı için tek seferlik borç kalemi oluşturun</div>
    </div>

    <div x-data="manuelBorcForm()">
    <form asp-action="Ekle" method="post" asp-form-write-permission="@PermissionCatalog.ManualCharge.Create">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="form-error bg-red-50 border border-red-200 rounded-lg p-3 mb-5"></div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Kiracı ve Sözleşme</span>
            </div>

            <input type="hidden" name="KiraciId" :value="tenantId" />
            <input type="hidden" name="SozlesmeId" :value="leaseId || ''" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label class="form-label">Kiracı <span class="text-red-500">*</span></label>
                    <select class="form-control" x-model="tenantId" @@change="kiraciDegisti()">
                        <option value="0">— Kiracı seçin —</option>
                        <template x-for="k in benzersizKiraciler" :key="k.id">
                            <option :value="k.id" x-text="k.kiraciAdi"></option>
                        </template>
                    </select>
                    <span class="form-error" x-show="@(ViewData.ModelState["KiraciId"]?.Errors.Count > 0 ? "true" : "false")">
                        @(ViewData.ModelState["KiraciId"]?.Errors.FirstOrDefault()?.ErrorMessage)
                    </span>
                </div>

                <div class="form-group mb-0">
                    <label class="form-label">Sözleşme <span class="text-muted font-normal">(opsiyonel)</span></label>
                    <select class="form-control" x-model.number="leaseId" @@change="sozlesmeDegisti()">
                        <option value="0">— Sözleşme seçmeyin —</option>
                        <template x-for="s in filtreliSozlesmeler" :key="s.id">
                            <option :value="s.id" x-text="s.birimAdi"></option>
                        </template>
                    </select>
                </div>
            </div>

            <template x-if="leaseId > 0 && unitId > 0 && unitId != sozlesmeBirimId">
                <div class="flex items-start gap-2 bg-amber-50 border border-amber-200 rounded-lg p-3 text-[13px] text-amber-800 mb-1">
                    <svg class="w-4 h-4 mt-0.5 shrink-0 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                    <span>Seçilen unit, sözleşmenin unit'inden farklı. Bu doğruysa devam edebilirsiniz.</span>
                </div>
            </template>
        </div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Unit</span>
            </div>

            <div class="form-group mb-0">
                <label class="form-label">Unit <span class="text-red-500">*</span></label>
                <select class="form-control" name="BirimId" x-model.number="unitId">
                    <option value="0">— Unit seçin —</option>
                    @foreach (var b in Model.Units)
                    {
                        <option value="@b.Id">@b.TasinmazAd — @b.Ad@(b.BirimNo != null ? " (" + b.BirimNo + ")" : "")</option>
                    }
                </select>
                <span asp-validation-for="BirimId" class="form-error"></span>
            </div>
        </div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Borç Detayı</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label asp-for="ChargeTypeId" class="form-label">Borç Tipi <span class="text-red-500">*</span></label>
                    <select asp-for="ChargeTypeId" class="form-control">
                        <option value="">— Borç tipi seçin —</option>
                        @foreach (var bt in Model.ChargeTypes)
                        {
                            <option value="@bt.Id">@bt.Ad (@bt.Kod)</option>
                        }
                    </select>
                    <span asp-validation-for="ChargeTypeId" class="form-error"></span>
                </div>

                <div class="form-group mb-0">
                    <label asp-for="DueDate" class="form-label">Vade Tarihi <span class="text-red-500">*</span></label>
                    @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                        { "Name",  "DueDate" },
                        { "Value", Model.DueDate.ToString("yyyy-MM-dd") },
                        { "Mode",  "date" },
                        { "Field", "vadeTarihi" }
                    })
                    <span asp-validation-for="DueDate" class="form-error"></span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Aciklama" class="form-label">Açıklama <span class="text-red-500">*</span></label>
                <input asp-for="Aciklama" type="text" class="form-control" placeholder="Ör: Anahtar bedeli, hasar tazminatı…" />
                <span asp-validation-for="Aciklama" class="form-error"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label asp-for="Amount" class="form-label">Amount (₺) <span class="text-red-500">*</span></label>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control"
                           placeholder="0,00" x-model.number="tutar" x-on:input="hesapla()" />
                    <span asp-validation-for="Amount" class="form-error"></span>
                </div>

                <div class="form-group mb-0">
                    <label class="form-label">KDV</label>
                    <div class="flex items-center gap-4 pt-1">
                        <label class="flex items-center gap-2 cursor-pointer text-[13.5px] font-medium">
                            <input asp-for="KdvUygulanacakMi" type="checkbox" x-model="kdvAktif" x-on:change="hesapla()" class="w-4 h-4 accent-primary cursor-pointer" />
                            KDV uygula
                        </label>
                        <template x-if="kdvAktif">
                            <div class="flex items-center gap-1.5">
                                <input asp-for="KdvRate" type="number" step="1" min="0" max="100" class="form-control w-20"
                                       x-model.number="kdvOrani" x-on:input="hesapla()" />
                                <span class="text-sm text-muted">%</span>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <template x-if="tutar > 0">
                <div class="bg-slate-50 border border-[var(--color-border)] rounded-lg p-3.5 mb-4">
                    <div class="flex justify-between text-[13px] mb-1">
                        <span class="text-muted">Ara Toplam</span>
                        <span x-text="tutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                    </div>
                    <template x-if="kdvAktif">
                        <div class="flex justify-between text-[13px] mb-1">
                            <span class="text-muted">KDV (<span x-text="kdvOrani"></span>%)</span>
                            <span x-text="kdvTutari.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                        </div>
                    </template>
                    <div class="flex justify-between text-[15px] font-bold border-t border-[var(--color-border)] pt-2 mt-1">
                        <span>Toplam</span>
                        <span class="text-primary" x-text="toplamTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                    </div>
                </div>
            </template>

            <div class="form-group mb-0">
                <label asp-for="Not" class="form-label">Not <span class="text-muted font-normal">(opsiyonel)</span></label>
                <textarea asp-for="Not" class="form-control" rows="2" placeholder="İç not, açıklama…"></textarea>
                <span asp-validation-for="Not" class="form-error"></span>
            </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
            <a href="/ManualCharge" class="btn btn-secondary px-6">İptal</a>
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.ManualCharge.Create">Manuel Borç Oluştur</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
<script>
(function() {
    const sozlesmeler = @Html.Raw(sozlesmeJson);

    function manuelBorcForm() {
        return {
            tenantId: @Model.KiraciId,
            leaseId: @(Model.SozlesmeId.HasValue ? Model.SozlesmeId.Value.ToString() : "0"),
            unitId: @Model.BirimId,
            tutar: @(Model.Amount > 0 ? Model.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0"),
            kdvAktif: @(Model.KdvUygulanacakMi ? "true" : "false"),
            kdvOrani: @Model.KdvRate.ToString("F0", System.Globalization.CultureInfo.InvariantCulture),
            kdvTutari: 0,
            toplamTutar: 0,

            get benzersizKiraciler() {
                const seen = new Set();
                return sozlesmeler.filter(s => {
                    if (seen.has(s.tenantId)) return false;
                    seen.add(s.tenantId);
                    return true;
                });
            },

            get filtreliSozlesmeler() {
                if (!this.tenantId || this.tenantId == 0) return sozlesmeler;
                return sozlesmeler.filter(s => s.tenantId == this.tenantId);
            },

            get sozlesmeBirimId() {
                if (!this.leaseId || this.leaseId == 0) return 0;
                const s = sozlesmeler.find(x => x.id == this.leaseId);
                return s ? s.unitId : 0;
            },

            init() {
                this.hesapla();
            },

            kiraciDegisti() {
                if (this.leaseId > 0) {
                    const s = sozlesmeler.find(x => x.id == this.leaseId);
                    if (s && s.tenantId != this.tenantId) {
                        this.leaseId = 0;
                    }
                }
            },

            sozlesmeDegisti() {
                if (this.leaseId > 0) {
                    const s = sozlesmeler.find(x => x.id == this.leaseId);
                    if (s) {
                        this.tenantId = s.tenantId;
                        this.unitId = s.unitId;
                    }
                }
            },

            hesapla() {
                const t = parseFloat(this.tutar) || 0;
                const oran = parseFloat(this.kdvOrani) || 0;
                this.kdvTutari = this.kdvAktif ? Math.round(t * oran / 100 * 100) / 100 : 0;
                this.toplamTutar = t + this.kdvTutari;
            }
        };
    }

    window.manuelBorcForm = manuelBorcForm;
})();
</script>
}

