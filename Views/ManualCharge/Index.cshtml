@model List<KiraTakip.Models.Dtos.ManualChargeListItemDto>
@using KiraTakip.Models
@{
    ViewData["Title"] = "Manuel Borçlar";
    ViewData["UseCentralFeedback"] = true;
    bool canCreate = User.HasPermission(PermissionCatalog.ManualCharge.Create);
    bool canCancel = User.HasPermission(PermissionCatalog.ManualCharge.Cancel);
    string activeStatus = ViewBag.Status ?? "tum";
    string activeRelation = ViewBag.Relation ?? "";
    int cancelledCount = ViewBag.CancelledCount ?? 0;
    int? leaseId = ViewBag.LeaseId;

    string ButtonClass(string status) => activeStatus == status
        ? "btn btn-sm bg-primary text-white border-primary"
        : "btn btn-sm btn-secondary";
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Manuel Borçlar</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    @if (canCreate)
    {
        <a href="/ManualCharge/Create" class="btn btn-primary flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Manuel Borç Ekle
        </a>
    }
</div>


@* Durum filtre butonları *@
<div class="flex items-center gap-2 mb-3 flex-wrap">
    <a href="/ManualCharge?status=tum&relation=@activeRelation" class="@ButtonClass("tum")">Tümü</a>
    <a href="/ManualCharge?status=bekliyor&relation=@activeRelation" class="@ButtonClass("bekliyor")">Bekliyor</a>
    <a href="/ManualCharge?status=kismi&relation=@activeRelation" class="@ButtonClass("kismi")">Kısmi</a>
    <a href="/ManualCharge?status=tamodendi&relation=@activeRelation" class="@ButtonClass("tamodendi")">Tam Ödendi</a>
    <a href="/ManualCharge?status=gecikti&relation=@activeRelation" class="@ButtonClass("gecikti")">Gecikti</a>

    @if (cancelledCount > 0 && activeStatus != "iptal")
    {
        <span class="ml-2 text-xs text-muted">
            @cancelledCount iptal edilmiş kayıt gizleniyor
            <a href="/ManualCharge?status=iptal&relation=@activeRelation" class="text-primary font-semibold hover:underline ml-1">Görüntüle →</a>
        </span>
    }
    @if (activeStatus == "iptal")
    {
        <a href="/ManualCharge?status=iptal&relation=@activeRelation" class="@ButtonClass("iptal")">İptal Edildi</a>
    }
</div>

@* Filtre formu *@
<form method="get" action="/ManualCharge" class="card p-3 mb-3 flex flex-wrap items-center gap-3">
    <input type="hidden" name="status" value="@activeStatus" />
    <select name="relation" class="form-control w-40 text-sm" onchange="this.form.submit()">
        <option value="" selected="@(activeRelation == "")">Bağlantı: Hepsi</option>
        <option value="sozlesmeli" selected="@(activeRelation == "sozlesmeli")">Sözleşmeli</option>
        <option value="sozlesmesiz" selected="@(activeRelation == "sozlesmesiz")">Sözleşmesiz</option>
    </select>
    @if (leaseId.HasValue)
    {
        <input type="hidden" name="leaseId" value="@leaseId" />
        <span class="text-xs bg-blue-50 text-blue-700 border border-blue-200 px-2 py-1 rounded-md">
            Sözleşme #@leaseId filtreli
            <a href="/ManualCharge?status=@activeStatus" class="ml-1 font-bold hover:underline">✕</a>
        </span>
    }
</form>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th>Kiracı</th>
                    <th>Taşınmaz / Birim</th>
                    <th class="w-24 cell-center">Tip</th>
                    <th>Açıklama</th>
                    <th class="w-28 num">Tutar</th>
                    <th class="w-24 num">KDV</th>
                    <th class="w-32 num">Toplam</th>
                    <th class="w-28 cell-center">Vade</th>
                    <th class="w-40">Bağlı Sözleşme</th>
                    <th class="w-32">Durum</th>
                    <th class="w-36 text-right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var manualCharge in Model)
                {
                    var remainingAmount = manualCharge.TotalAmount - manualCharge.PaidAmount;
                    string statusClass = manualCharge.Status switch {
                        ChargeStatus.Paid    => "badge-kirali",
                        ChargeStatus.PartiallyPaid => "badge-surek",
                        ChargeStatus.Overdue      => "badge-gecmis",
                        ChargeStatus.Cancelled  => "badge-bos",
                        _                           => "badge-bos"
                    };
                    string statusLabel = manualCharge.Status switch {
                        ChargeStatus.Paid    => "Tam Ödendi",
                        ChargeStatus.PartiallyPaid => "Kısmi Ödendi",
                        ChargeStatus.Overdue      => "Gecikti",
                        ChargeStatus.Cancelled  => "İptal Edildi",
                        _                           => "Bekleniyor"
                    };
                    <tr class="cursor-pointer hover:bg-slate-50 transition-colors"
                        onclick="if(!event.target.closest('a,button,[data-stop]'))window.location.href='/Charge/Details/@manualCharge.Id.ToHashId()'">
                        <td>
                            @if (manualCharge.TenantId > 0)
                            {
                                <a href="/Tenant/Details/@manualCharge.TenantId.ToHashId()" class="font-semibold text-primary hover:underline">@manualCharge.TenantDisplayName</a>
                            }
                            else
                            {
                                <div class="font-semibold">@(manualCharge.TenantDisplayName ?? "-")</div>
                            }
                            @if (!string.IsNullOrEmpty(manualCharge.TenantCategoryName))
                            {
                                <div class="cell-sub">@manualCharge.TenantCategoryName</div>
                            }
                        </td>
                        <td>
                            <div>@(manualCharge.PropertyName ?? "-")</div>
                            <span class="cell-sub">@(manualCharge.UnitName ?? "-")</span>
                        </td>
                        <td class="cell-center">
                            @if (!string.IsNullOrEmpty(manualCharge.ChargeTypeCode))
                            {
                                <span class="font-mono text-[11px] font-bold bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200">@manualCharge.ChargeTypeCode</span>
                            }
                        </td>
                        <td class="text-muted max-w-[200px] truncate">@(manualCharge.FirstLineItemDescription ?? "-")</td>
                        <td class="num">@manualCharge.ExpectedAmount.ToString("N2") ₺</td>
                        <td class="num num-muted">@manualCharge.VatAmount.ToString("N2") ₺</td>
                        <td class="num">@manualCharge.TotalAmount.ToString("N2") ₺</td>
                        <td class="cell-center">@manualCharge.DueDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (manualCharge.LeaseId.HasValue)
                            {
                                <a href="/Lease/Details/@manualCharge.LeaseId.ToHashId()" data-stop class="font-mono text-xs text-primary hover:underline">#@manualCharge.LeaseId</a>
                            }
                            else
                            {
                                <span class="text-slate-300 text-xs">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge @statusClass">@statusLabel</span>
                            @if (!string.IsNullOrEmpty(manualCharge.CancellationNote))
                            {
                                <div class="text-[10px] text-muted mt-1 italic truncate max-w-[100px]" title="@manualCharge.CancellationNote">⤵ @manualCharge.CancellationNote</div>
                            }
                        </td>
                        <td class="text-right">
                            <div class="flex gap-1.5 justify-end items-center">
                                @if (manualCharge.Status != ChargeStatus.Cancelled && manualCharge.Status != ChargeStatus.Paid)
                                {
                                    <a href="/Payment/Create?chargeId=@manualCharge.Id.ToHashId()" class="btn btn-sm btn-primary">Ödeme</a>
                                }
                                @if (canCancel && manualCharge.Status != ChargeStatus.Cancelled && manualCharge.Status != ChargeStatus.Paid)
                                {
                                    <button type="button" class="btn btn-sm bg-red-50 text-red-600 border-red-200 hover:bg-red-600 hover:text-white"
                                        data-confirm="Bu manuel borcu iptal etmek istediğinize emin misiniz?"
                                        data-confirm-title="Manuel Borç İptali"
                                        data-confirm-action="/ManualCharge/Cancel/@manualCharge.Id.ToHashId()"
                                        data-confirm-method="POST"
                                        data-confirm-needs-reason="true"
                                        data-confirm-reason-label="İptal nedeni">
                                        İptal
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="11" class="py-16 text-center">
                            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 text-slate-300 mb-4">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                            </div>
                            <div class="text-slate-500 font-bold">Manuel borç kaydı bulunamadı</div>
                            @if (canCreate)
                            {
                                <div class="text-xs text-muted mt-1">
                                    <a href="/ManualCharge/Create" class="text-primary font-semibold hover:underline">Manuel Borç Ekle</a> butonuyla ilk kaydı oluşturun.
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('[data-confirm]').forEach(btn => {
    btn.addEventListener('click', async function() {
        const needsReason = this.dataset.confirmNeedsReason === 'true';
        if (!needsReason) return;

        const action = this.dataset.confirmAction;
        const title = this.dataset.confirmTitle || 'Onay';
        const message = this.dataset.confirm;
        const reasonLabel = this.dataset.confirmReasonLabel || 'Neden';

        const neden = await window.Alpine.store('confirm').ask(message, title, true, reasonLabel);
        if (!neden) return;

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = action;

        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            const t = document.createElement('input');
            t.type = 'hidden';
            t.name = '__RequestVerificationToken';
            t.value = token.value;
            form.appendChild(t);
        }

        const n = document.createElement('input');
        n.type = 'hidden';
        n.name = 'Reason';
        n.value = neden;
        form.appendChild(n);

        document.body.appendChild(form);
        form.submit();
    });
});
</script>
@Html.AntiForgeryToken()
}

