@model KiraTakip.Models.ViewModels.CreateManualChargeViewModel
@using KiraTakip.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Manuel Borç Ekle";
    ViewData["UseCentralFeedback"] = true;

    var leasesJson = JsonSerializer.Serialize(Model.ActiveLeases.Select(lease => new {
        id = lease.Id,
        tenantId = lease.TenantId,
        unitId = lease.UnitId,
        tenantName = lease.TenantDisplayName,
        unitName = lease.PropertyName + " / " + lease.UnitName
    }));
}

<div class="max-w-[1000px] mx-auto">
    <div class="page-header">
        <a href="/ManualCharge" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← Manuel Borçlar</a>
        <div class="page-title">Manuel Borç Ekle</div>
        <div class="page-subtitle">Kiracı için tek seferlik borç kalemi oluşturun</div>
    </div>

    <div x-data="manuelBorcForm()">
    <form asp-action="Create" method="post" asp-form-write-permission="@PermissionCatalog.ManualCharge.Create">
        @Html.AntiForgeryToken()


        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Kiracı ve Sözleşme</span>
            </div>

            <input type="hidden" name="TenantId" :value="tenantId" />
            <input type="hidden" name="LeaseId" :value="leaseId || ''" />

            <div class="form-group mb-4">
                <label class="form-label">Kiracı <span class="text-red-500">*</span></label>
                <select class="form-control" x-model.number="tenantId" @@change="kiraciDegisti()">
                    <option value="0">— Kiracı seçin —</option>
                    <template x-for="k in benzersizKiraciler" :key="k.tenantId">
                        <option :value="k.tenantId" x-text="k.tenantName"></option>
                    </template>
                </select>
                <span class="form-error" x-show="@(ViewData.ModelState["TenantId"]?.Errors.Count > 0 ? "true" : "false")">
                    @(ViewData.ModelState["TenantId"]?.Errors.FirstOrDefault()?.ErrorMessage)
                </span>
            </div>

            <template x-if="tenantId > 0 && filtreliSozlesmeler.length > 0">
                <div class="form-group mb-0">
                    <label class="form-label">Sözleşme <span class="text-muted font-normal">(opsiyonel)</span></label>
                    <select class="form-control" x-model.number="leaseId" @@change="sozlesmeDegisti()">
                        <option value="0">— Sözleşme seçmeyin —</option>
                        <template x-for="s in filtreliSozlesmeler" :key="s.id">
                            <option :value="s.id" x-text="s.unitName"></option>
                        </template>
                    </select>
                    <div class="form-hint">Sözleşme seçilirse birim otomatik dolar.</div>
                </div>
            </template>
            <template x-if="tenantId > 0 && filtreliSozlesmeler.length === 0">
                <div class="text-[12.5px] text-muted italic">Bu kiracının aktif sözleşmesi bulunmuyor.</div>
            </template>

        </div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Birim</span>
            </div>

            <div class="form-group mb-0">
                <label class="form-label">Birim <span class="text-red-500">*</span></label>
                <select class="form-control" name="UnitId" x-model.number="unitId">
                    <option value="0">— Birim seçin —</option>
                    @foreach (var unit in Model.Units)
                    {
                        <option value="@unit.Id">@unit.PropertyName — @unit.Name@(unit.UnitNo != null ? " (" + unit.UnitNo + ")" : "")</option>
                    }
                </select>
                <span asp-validation-for="UnitId" class="form-error"></span>
            </div>
        </div>

        <div class="card mb-4">
            <div class="text-lg font-bold mb-5 flex items-center gap-2">
                <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
                <span>Borç Detayı</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label asp-for="ChargeTypeId" class="form-label">Borç Tipi <span class="text-red-500">*</span></label>
                    <select asp-for="ChargeTypeId" class="form-control">
                        <option value="">— Borç tipi seçin —</option>
                        @foreach (var chargeType in Model.ChargeTypes)
                        {
                            <option value="@chargeType.Id">@chargeType.Name (@chargeType.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="ChargeTypeId" class="form-error"></span>
                </div>

                <div class="form-group mb-0">
                    <label asp-for="DueDate" class="form-label">Vade Tarihi <span class="text-red-500">*</span></label>
                    @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData) {
                        { "Name",  "DueDate" },
                        { "Value", Model.DueDate.ToString("yyyy-MM-dd") },
                        { "Mode",  "date" },
                        { "Field", "vadeTarihi" }
                    })
                    <span asp-validation-for="DueDate" class="form-error"></span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="form-label">Açıklama <span class="text-red-500">*</span></label>
                <input asp-for="Description" type="text" class="form-control" placeholder="Ör: Anahtar bedeli, hasar tazminatı…" />
                <span asp-validation-for="Description" class="form-error"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-group mb-0">
                    <label asp-for="Amount" class="form-label">Tutar (₺) <span class="text-red-500">*</span></label>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control"
                           placeholder="0,00" x-model.number="tutar" x-on:input="hesapla()" />
                    <span asp-validation-for="Amount" class="form-error"></span>
                </div>

                <div class="form-group mb-0">
                    <label class="form-label">KDV</label>
                    <div class="flex items-center gap-4 pt-1">
                        <label class="flex items-center gap-2 cursor-pointer text-[13.5px] font-medium">
                            <input asp-for="IsVatApplied" type="checkbox" x-model="kdvAktif" x-on:change="hesapla()" class="w-4 h-4 accent-primary cursor-pointer" />
                            KDV uygula
                        </label>
                        <template x-if="kdvAktif">
                            <div class="flex items-center gap-1.5">
                                <input asp-for="VatRate" type="number" step="1" min="0" max="100" class="form-control w-20"
                                       x-model.number="kdvOrani" x-on:input="hesapla()" />
                                <span class="text-sm text-muted">%</span>
                                <span asp-validation-for="VatRate" class="form-error"></span>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <template x-if="tutar > 0">
                <div class="bg-slate-50 border border-[var(--color-border)] rounded-lg p-3.5 mb-4">
                    <div class="flex justify-between text-[13px] mb-1">
                        <span class="text-muted">Ara Toplam</span>
                        <span x-text="tutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                    </div>
                    <template x-if="kdvAktif">
                        <div class="flex justify-between text-[13px] mb-1">
                            <span class="text-muted">KDV (<span x-text="kdvOrani"></span>%)</span>
                            <span x-text="kdvTutari.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                        </div>
                    </template>
                    <div class="flex justify-between text-[15px] font-bold border-t border-[var(--color-border)] pt-2 mt-1">
                        <span>Toplam</span>
                        <span class="text-primary" x-text="toplamTutar.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺'"></span>
                    </div>
                </div>
            </template>

            <div class="form-group mb-0">
                <label asp-for="Note" class="form-label">Not <span class="text-muted font-normal">(opsiyonel)</span></label>
                <textarea asp-for="Note" class="form-control" rows="2" placeholder="İç not, açıklama…"></textarea>
                <span asp-validation-for="Note" class="form-error"></span>
            </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
            <a href="/ManualCharge" class="btn btn-secondary px-6">İptal</a>
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.ManualCharge.Create">Manuel Borç Oluştur</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
<script>
(function() {
    const sozlesmeler = @Html.Raw(leasesJson);

    function manuelBorcForm() {
        return {
            tenantId: @Model.TenantId,
            leaseId: @(Model.LeaseId.HasValue ? Model.LeaseId.Value.ToString() : "0"),
            unitId: @Model.UnitId,
            tutar: @(Model.Amount > 0 ? Model.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0"),
            kdvAktif: @(Model.IsVatApplied ? "true" : "false"),
            kdvOrani: @Model.VatRate.ToString("F0", System.Globalization.CultureInfo.InvariantCulture),
            kdvTutari: 0,
            toplamTutar: 0,

            get benzersizKiraciler() {
                const seen = new Set();
                return sozlesmeler.filter(s => {
                    if (seen.has(s.tenantId)) return false;
                    seen.add(s.tenantId);
                    return true;
                });
            },

            get filtreliSozlesmeler() {
                if (!this.tenantId || this.tenantId == 0) return [];
                return sozlesmeler.filter(s => s.tenantId == this.tenantId);
            },

            init() {
                this.hesapla();
            },

            kiraciDegisti() {
                this.leaseId = 0;
            },

            sozlesmeDegisti() {
                if (this.leaseId > 0) {
                    const s = sozlesmeler.find(x => x.id == this.leaseId);
                    if (s) {
                        this.tenantId = s.tenantId;
                        this.unitId = s.unitId;
                    }
                }
            },

            hesapla() {
                const t = parseFloat(this.tutar) || 0;
                const oran = parseFloat(this.kdvOrani) || 0;
                this.kdvTutari = this.kdvAktif ? Math.round(t * oran / 100 * 100) / 100 : 0;
                this.toplamTutar = t + this.kdvTutari;
            }
        };
    }

    window.manuelBorcForm = manuelBorcForm;
})();
</script>
}

