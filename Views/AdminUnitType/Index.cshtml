@model List<KiraTakip.Models.Dtos.UnitTypeListItemDto>
@{
    ViewData["Title"] = "Birim Türleri";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Birim Türleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    <a href="/Admin/UnitType/Create" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Birim Türü
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th>Ad</th>
                    <th>Kullanım Türü</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unitType in Model)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@unitType.SortOrder</td>
                        <td class="font-medium text-slate-700">@unitType.Name</td>
                        <td>
                            @if (unitType.CanBeRented)
                            {
                                <span class="badge badge-kirali">Kiralanabilir</span>
                            }
                            else if (unitType.CanBeReserved)
                            {
                                <span class="badge badge-surek">Rezervasyon Yapılabilir</span>
                            }
                            else
                            {
                                <span class="badge badge-bos">Kiralanamaz</span>
                            }
                        </td>
                        <td>
                            @if (unitType.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/UnitType/Edit/@unitType.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/UnitType/ToggleStatus/@unitType.Id.ToHashId()"
                                  data-confirm="@(unitType.IsActive ? $"'{unitType.Name}' pasif yapılsın mı?" : $"'{unitType.Name}' aktif yapılsın mı?")"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(unitType.IsActive ? "btn-danger" : "btn-amber")">
                                    @(unitType.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-8 text-muted">Henüz birim türü tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

