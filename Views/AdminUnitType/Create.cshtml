@model KiraTakip.Models.ViewModels.UnitTypeFormViewModel
@{
    ViewData["Title"] = "Yeni Birim Türü";
    ViewData["UseCentralFeedback"] = true;
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div>
        <div class="page-title">Yeni Birim Türü</div>
    </div>
</div>

<div class="card" x-data="{ tur: '@(Model.Usage == KiraTakip.Models.UnitTypeUsage.Reservable ? "rez" : (Model.Usage == KiraTakip.Models.UnitTypeUsage.Rentable ? "kira" : "kiralanamaz"))' }">
    <form method="post" action="/Admin/UnitType/Create" asp-form-write-permission="@PermissionCatalog.UnitType.Create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="Ofis" />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="SortOrder" type="number" class="form-control w-24" />
            <span asp-validation-for="SortOrder" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Kullanım Türü <span class="text-red-500">*</span></label>
            <div class="flex flex-col gap-2">
                <input type="hidden" name="Usage" :value="tur === 'kira' ? 'Rentable' : (tur === 'rez' ? 'Reservable' : 'NonRentable')" />

                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="usage_selector" value="kira" 
                           x-model="tur" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span class="text-sm">Kiralanabilir <span class="text-muted text-xs">(kira sözleşmesine bağlanabilir)</span></span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="usage_selector" value="rez" 
                           x-model="tur" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span class="text-sm">Rezervasyon yapılabilir <span class="text-muted text-xs">(sözleşmeye bağlı değil)</span></span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="usage_selector" value="kiralanamaz" 
                           x-model="tur" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span class="text-sm">Kiralanamaz <span class="text-muted text-xs">(sadece bilgi amaçlı)</span></span>
                </label>
                <div class="text-xs text-muted mt-1">Tam olarak bir seçenek işaretli olmalıdır.</div>
                <span asp-validation-for="Usage" class="text-red-500 text-xs mt-1"></span>
            </div>
        </div>

        <div class="form-group" x-show="tur === 'rez'" x-cloak>
            <label class="form-label">Tahakkuk Borç Tipi <span class="text-red-500">*</span></label>
            <select asp-for="ChargeTypeId" class="form-control">
                <option value="">-- Borç Tipi Seçin --</option>
                @foreach (var chargeType in Model.ChargeTypeCandidates)
                {
                    <option value="@chargeType.Id">@chargeType.Name (@chargeType.Code)</option>
                }
            </select>
            <div class="text-xs text-muted mt-1">Rezervasyonlar tahakkuka aktarılırken bu borç tipi kullanılacaktır.</div>
            <span asp-validation-for="ChargeTypeId" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.UnitType.Create">Kaydet</button>
            <a href="/Admin/UnitType" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
</div>

