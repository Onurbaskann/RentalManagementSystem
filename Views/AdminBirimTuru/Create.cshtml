@model KiraTakip.Models.ViewModels.BirimTuruFormViewModel
@{
    ViewData["Title"] = "Yeni Birim Türü";
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div>
        <div class="page-title">Yeni Birim Türü</div>
    </div>
</div>

<div class="card" x-data="{ tur: '@(Model.RezervasyonYapilabilirMi ? "rez" : "kira")' }">
    <form method="post" action="/Admin/BirimTuru/Ekle" asp-form-write-permission="@PermissionCatalog.BirimTuru.Create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Ad <span class="text-red-500">*</span></label>
            <input asp-for="Ad" class="form-control" placeholder="Ofis" required />
            <span asp-validation-for="Ad" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Sıra</label>
            <input asp-for="Sira" type="number" class="form-control w-24" min="1" />
        </div>

        <div class="form-group">
            <label class="form-label">Kullanım Türü <span class="text-red-500">*</span></label>
            <div class="flex flex-col gap-2">
                <input type="hidden" name="KiralanabilirMi" :value="tur === 'kira' ? 'True' : 'False'" />
                <input type="hidden" name="RezervasyonYapilabilirMi" :value="tur === 'rez' ? 'True' : 'False'" />

                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="usage_selector" value="kira" 
                           x-model="tur" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span class="text-sm">Kiralanabilir <span class="text-muted text-xs">(kira sözleşmesine bağlanabilir)</span></span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="usage_selector" value="rez" 
                           x-model="tur" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span class="text-sm">Rezervasyon yapılabilir <span class="text-muted text-xs">(sözleşmeye bağlı değil)</span></span>
                </label>
                <div class="text-xs text-muted mt-1">Tam olarak bir seçenek işaretli olmalıdır.</div>
            </div>
        </div>

        <div class="form-group" x-show="tur === 'rez'" x-cloak>
            <label class="form-label">Tahakkuk Borç Tipi <span class="text-red-500">*</span></label>
            <select asp-for="BorcTipiId" class="form-control" :required="tur === 'rez'">
                <option value="">-- Borç Tipi Seçin --</option>
                @foreach (var bt in Model.BorcTipiAdaylari)
                {
                    <option value="@bt.Id">@bt.Ad (@bt.Kod)</option>
                }
            </select>
            <div class="text-xs text-muted mt-1">Rezervasyonlar tahakkuka aktarılırken bu borç tipi kullanılacaktır.</div>
            <span asp-validation-for="BorcTipiId" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="Aktif" type="checkbox" class="w-4 h-4 accent-primary cursor-pointer" />
                <span class="form-label mb-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-6" asp-permission="@PermissionCatalog.BirimTuru.Create">Kaydet</button>
            <a href="/Admin/BirimTuru" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
