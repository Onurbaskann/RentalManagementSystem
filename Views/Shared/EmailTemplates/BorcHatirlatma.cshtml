@model KiraTakip.Models.ViewModels.KiraciBorcHatirlatmaMailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Ödeme Hatırlatması</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:Arial,'Helvetica Neue',sans-serif;color:#1e293b;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f6f9;padding:32px 16px;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,0.08);">
        <tr>
          <td style="background:#2563eb;padding:24px 32px;">
            <span style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.3px;">KiraTakip</span>
          </td>
        </tr>
        <tr>
          <td style="padding:32px;">
            <p style="margin:0 0 16px;font-size:15px;color:#334155;">Sayın <strong>@Model.Ad @Model.Soyad</strong>,</p>
            <p style="margin:0 0 24px;font-size:14px;color:#64748b;line-height:1.6;">
              Aşağıdaki tahakkuklara ait ödemelerinizin vadesi yaklaşmaktadır veya geçmiştir. Ödemenizi zamanında yapmak için lütfen detayları inceleyin.
            </p>

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin-bottom:24px;">
              <thead>
                <tr>
                  <th style="padding:10px;border-bottom:2px solid #e2e8f0;text-align:left;font-size:13px;color:#64748b;">Taşınmaz / Birim</th>
                  <th style="padding:10px;border-bottom:2px solid #e2e8f0;text-align:left;font-size:13px;color:#64748b;">Dönem</th>
                  <th style="padding:10px;border-bottom:2px solid #e2e8f0;text-align:left;font-size:13px;color:#64748b;">Vade</th>
                  <th style="padding:10px;border-bottom:2px solid #e2e8f0;text-align:right;font-size:13px;color:#64748b;">Kalan Tutar</th>
                </tr>
              </thead>
              <tbody>
                @foreach(var b in Model.Borclar)
                {
                    <tr>
                      <td style="padding:10px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#1e293b;font-weight:600;">@b.TasinmazAdi / @b.BirimAdi</td>
                      <td style="padding:10px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#334155;">@b.DonemBaslangic.ToString("MM/yyyy")</td>
                      <td style="padding:10px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#dc2626;">@b.VadeTarihi.ToString("dd.MM.yyyy")</td>
                      <td style="padding:10px;border-bottom:1px solid #e2e8f0;text-align:right;font-size:14px;font-weight:700;color:#2563eb;">
                          @b.KalanTutar.ToString("N2") ₺
                          @if(b.OdenenTutar > 0) {
                              <br/><span style="font-size:11px;color:#64748b;font-weight:normal;">(Ödenen: @b.OdenenTutar.ToString("N2") ₺)</span>
                          }
                      </td>
                    </tr>
                }
              </tbody>
            </table>

            <table cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 24px;">
              <tr>
                <td align="center" style="border-radius:8px;background:#2563eb;">
                  <a href="@Model.OdemeLink"
                     target="_blank"
                     style="display:inline-block;padding:14px 36px;color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;border-radius:8px;letter-spacing:0.2px;">
                    Portal'a Git ve Ödeme Yap →
                  </a>
                </td>
              </tr>
            </table>

            <p style="margin:0 0 8px;font-size:12.5px;color:#94a3b8;text-align:center;">
              Link <strong>7 gün</strong> geçerlidir. Tarayıcınıza kopyalayabilirsiniz:
            </p>
            <p style="margin:0;font-size:11.5px;color:#64748b;text-align:center;word-break:break-all;">
              @Model.OdemeLink
            </p>
          </td>
        </tr>
        <tr>
          <td style="background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 32px;">
            <p style="margin:0;font-size:11.5px;color:#94a3b8;text-align:center;">
              Bu mail, KiraTakip yönetim sistemi tarafından otomatik olarak gönderilmiştir.<br />
              Ödeme ile ilgili bir sorun yaşıyorsanız yöneticinizle iletişime geçin.
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
