@model KiraTakip.Services.DavetiyeMailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>KiraTakip Davetiyesi</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:Arial,'Helvetica Neue',sans-serif;color:#1e293b;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f6f9;padding:32px 16px;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,0.08);">
        <tr>
          <td style="background:#2563eb;padding:24px 32px;">
            <span style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.3px;">KiraTakip</span>
          </td>
        </tr>
        <tr>
          <td style="padding:32px;">
            <p style="margin:0 0 16px;font-size:15px;color:#334155;">Sayın <strong>@Model.AdSoyad</strong>,</p>
            <p style="margin:0 0 24px;font-size:14px;color:#64748b;line-height:1.6;">
              KiraTakip sistemine davet edildiniz. Hesabınızı oluşturmak için aşağıdaki düğmeye tıklayın.
            </p>
            <table cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
              <tr>
                <td style="background:#2563eb;border-radius:6px;padding:12px 24px;">
                  <a href="@Model.DavetLink" style="color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;">Hesabımı Oluştur</a>
                </td>
              </tr>
            </table>
            <p style="margin:0 0 8px;font-size:12px;color:#94a3b8;">
              Bu link <strong>@Model.SonTarih.ToString("dd.MM.yyyy HH:mm")</strong> tarihine kadar geçerlidir.
            </p>
            <p style="margin:0;font-size:12px;color:#94a3b8;">
              Düğme çalışmıyorsa aşağıdaki adresi tarayıcınıza yapıştırın:<br />
              <span style="word-break:break-all;">@Model.DavetLink</span>
            </p>
          </td>
        </tr>
        <tr>
          <td style="background:#f8fafc;padding:16px 32px;border-top:1px solid #e2e8f0;">
            <p style="margin:0;font-size:11px;color:#94a3b8;">Bu e-postayı siz talep etmediyseniz dikkate almayın.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>

