@{
    var dpName         = ViewData["Name"]?.ToString() ?? "";
    var dpValue        = ViewData["Value"]?.ToString() ?? "";
    var dpMode         = ViewData["Mode"]?.ToString() ?? "datetime";
    var dpField        = ViewData["Field"]?.ToString() ?? dpName.ToLower();
    var dpCompact      = ViewData["Compact"] as bool? ?? false;
    var dpWrapperClass = ViewData["WrapperClass"]?.ToString() ?? "";
    var btnClass = dpCompact
        ? "form-control w-full text-left flex items-center gap-1.5 cursor-pointer text-xs font-medium"
        : "form-control w-full text-left flex items-center gap-2 cursor-pointer";
}

<div class="relative @dpWrapperClass"
     x-data="datetimePicker({ value: '@dpValue', mode: '@dpMode', field: '@dpField' })"
     @@set-date-value.window="if ($event.detail && $event.detail.field === field) setValue($event.detail.value)"
     @@click.outside="open = false">

    <input type="hidden" name="@dpName" :value="isoValue" />

    <button type="button"
            class="@btnClass"
            @@click="toggle()">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" style="color:var(--color-muted)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span x-show="hasValue" x-text="displayValue" class="flex-1"></span>
        <span x-show="!hasValue" class="flex-1" style="color:var(--color-muted)">@(dpCompact ? "Tarih" : "Tarih seçin")</span>
        <span x-show="hasValue"
              @@click.stop="clearValue()"
              class="shrink-0 flex items-center justify-center w-4 h-4 rounded-full hover:bg-gray-200 transition-colors cursor-pointer"
              style="color:var(--color-muted)">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </span>
        <svg x-show="!hasValue" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 transition-transform" :class="open ? 'rotate-180' : ''" style="color:var(--color-muted)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </button>

    <div x-show="open" x-cloak
         x-transition:enter="transition ease-out duration-100"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-75"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="absolute z-50 bg-white border border-gray-200 rounded-xl shadow-lg p-3 mt-1"
         style="width:17rem; top:100%; left:0;">

        <!-- Navigasyon başlığı (tüm view'larda ortak) -->
        <div class="flex items-center justify-between mb-2.5">
            <button type="button" @@click="prevNav()"
                    class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-gray-100 text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button"
                    @@click="headerClick()"
                    :disabled="!headerClickable"
                    class="text-sm font-semibold text-gray-800 select-none px-2 py-0.5 rounded-lg transition-colors"
                    :class="headerClickable ? 'hover:bg-gray-100 cursor-pointer' : 'cursor-default'"
                    x-text="headerLabel">
            </button>
            <button type="button" @@click="nextNav()"
                    class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-gray-100 text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>

        <!-- Gün görünümü -->
        <template x-if="view === 'day'">
            <div>
                <div class="grid grid-cols-7 mb-1">
                    <template x-for="dn in dayNames" :key="dn">
                        <div class="text-center text-[10px] font-semibold select-none py-0.5" style="color:var(--color-muted)" x-text="dn"></div>
                    </template>
                </div>
                <div class="grid grid-cols-7 gap-y-0.5">
                    <template x-for="(d, i) in calendarDays" :key="i">
                        <button type="button"
                                @@click="selectDay(d)"
                                class="h-8 w-full text-xs rounded-lg flex items-center justify-center transition-colors select-none"
                                :class="{
                                    'text-white font-semibold': d.sel,
                                    'font-bold': d.today && !d.sel,
                                    'text-gray-300 hover:bg-gray-50': !d.cur && !d.sel,
                                    'hover:bg-gray-100': d.cur && !d.sel
                                }"
                                :style="d.sel ? 'background:var(--color-primary)' : (d.today && !d.sel ? 'color:var(--color-primary); outline:1.5px solid var(--color-primary); outline-offset:-1px;' : '')">
                            <span x-text="d.n"></span>
                        </button>
                    </template>
                </div>
            </div>
        </template>

        <!-- Ay görünümü -->
        <template x-if="view === 'month'">
            <div class="grid grid-cols-3 gap-1">
                <template x-for="(mo, i) in months" :key="i">
                    <button type="button"
                            @@click="selectMonth(i)"
                            class="h-9 text-xs rounded-lg flex items-center justify-center transition-colors select-none font-medium"
                            :class="{
                                'text-white': i === viewMonth && viewYear === year,
                                'hover:bg-gray-100 text-gray-700': !(i === viewMonth && viewYear === year)
                            }"
                            :style="(i === viewMonth && viewYear === year) ? 'background:var(--color-primary)' : (i === month && viewYear === year ? 'color:var(--color-primary);outline:1.5px solid var(--color-primary);outline-offset:-1px;border-radius:0.5rem;' : '')"
                            x-text="mo">
                    </button>
                </template>
            </div>
        </template>

        <!-- Yıl görünümü -->
        <template x-if="view === 'year'">
            <div class="grid grid-cols-4 gap-1">
                <template x-for="yr in calendarYears" :key="yr">
                    <button type="button"
                            @@click="selectYear(yr)"
                            class="h-9 text-xs rounded-lg flex items-center justify-center transition-colors select-none font-medium"
                            :class="{
                                'text-white': yr === viewYear,
                                'hover:bg-gray-100 text-gray-700': yr !== viewYear
                            }"
                            :style="yr === viewYear ? 'background:var(--color-primary)' : (yr === year ? 'color:var(--color-primary);outline:1.5px solid var(--color-primary);outline-offset:-1px;border-radius:0.5rem;' : '')"
                            x-text="yr">
                    </button>
                </template>
            </div>
        </template>

        <!-- Saat seçici (datetime modu, sadece gün görünümünde) -->
        <template x-if="mode === 'datetime' && view === 'day'">
            <div class="mt-2.5 pt-2.5 border-t border-gray-100">
                <div class="flex items-center justify-center gap-2">

                    <div class="flex flex-col items-center gap-0.5">
                        <button type="button" @@click="adjustHour(1)"
                                class="w-8 h-5 flex items-center justify-center rounded hover:bg-gray-100 text-gray-400 text-[10px]">▲</button>
                        <input type="text"
                               :value="String(hour).padStart(2,'0')"
                               @@change="onHourInput($event)"
                               @@focus="$event.target.select()"
                               class="w-10 h-9 text-center font-mono text-base font-bold border border-gray-200 rounded-lg focus:outline-none"
                               maxlength="2" inputmode="numeric" />
                        <button type="button" @@click="adjustHour(-1)"
                                class="w-8 h-5 flex items-center justify-center rounded hover:bg-gray-100 text-gray-400 text-[10px]">▼</button>
                    </div>

                    <span class="text-xl font-bold text-gray-300 pb-0.5">:</span>

                    <div class="flex flex-col items-center gap-0.5">
                        <button type="button" @@click="adjustMinute(5)"
                                class="w-8 h-5 flex items-center justify-center rounded hover:bg-gray-100 text-gray-400 text-[10px]">▲</button>
                        <input type="text"
                               :value="String(minute).padStart(2,'0')"
                               @@change="onMinuteInput($event)"
                               @@focus="$event.target.select()"
                               class="w-10 h-9 text-center font-mono text-base font-bold border border-gray-200 rounded-lg focus:outline-none"
                               maxlength="2" inputmode="numeric" />
                        <button type="button" @@click="adjustMinute(-5)"
                                class="w-8 h-5 flex items-center justify-center rounded hover:bg-gray-100 text-gray-400 text-[10px]">▼</button>
                    </div>

                    <button type="button" @@click="confirm()"
                            class="ml-2 px-3 py-1.5 text-white text-xs font-semibold rounded-lg transition-opacity hover:opacity-90"
                            style="background:var(--color-primary)">
                        Tamam
                    </button>
                </div>
            </div>
        </template>
    </div>
</div>

