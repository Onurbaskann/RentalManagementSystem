@* Global onay diyaloğu — _Layout içinden bir kere mount edilir.
   Kullanım: <form data-confirm="Eşleşme kaldırılsın mı?" method="post">...</form> *@
<div x-data
     x-show="$store.confirm.open"
     x-cloak
     x-transition.opacity
     class="fixed inset-0 bg-slate-900/60 backdrop-blur-[2px] z-[9999] flex items-center justify-center p-4"
     @@keydown.escape.window="$store.confirm.answer(false)">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden"
         @@click.outside="$store.confirm.answer(false)"
         x-transition.scale.origin.center>
        <div class="p-6 pb-2">
            <div class="text-lg font-bold text-slate-800" x-text="$store.confirm.title"></div>
            <div class="text-[13.5px] text-slate-500 mt-2 leading-relaxed font-medium" x-text="$store.confirm.message"></div>
            
            <template x-if="$store.confirm.needsInput">
                <div class="mt-4">
                    <label class="block text-xs font-semibold text-slate-500 mb-1.5" x-text="$store.confirm.inputLabel"></label>
                    <input type="text" 
                           class="form-control w-full text-sm rounded-lg border-slate-200 focus:border-indigo-500 focus:ring-indigo-500" 
                           x-model="$store.confirm.inputValue" 
                           placeholder="Açıklama giriniz..."
                           @@keydown.enter.prevent="$store.confirm.inputValue.trim() && $store.confirm.answer(true)" />
                </div>
            </template>
        </div>
        <div class="p-5 flex items-center justify-end gap-2 bg-slate-50/50">
            <button type="button" class="btn btn-secondary px-5 py-2 text-xs" @@click="$store.confirm.answer(false)">İptal</button>
            <button type="button" 
                    class="btn bg-red-600 hover:bg-red-700 text-white border-0 px-5 py-2 text-xs font-bold shadow-lg shadow-red-200 disabled:opacity-50 disabled:cursor-not-allowed" 
                    @@click="$store.confirm.answer(true)" 
                    :disabled="$store.confirm.needsInput && !$store.confirm.inputValue.trim()"
                    x-ref="confirmBtn">Onayla</button>
        </div>
    </div>
</div>

