@* Global onay diyaloğu — _Layout içinden bir kere mount edilir.
   Kullanım: <form data-confirm="Eşleşme kaldırılsın mı?" method="post">...</form> *@
<div x-data
     x-show="$store.confirm.open"
     x-cloak
     x-transition.opacity
     class="modal-overlay"
     @@keydown.escape.window="$store.confirm.answer(false)"
     style="position:fixed;inset:0;background:rgba(15,23,42,0.5);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div class="modal-card"
         @@click.outside="$store.confirm.answer(false)"
         style="background:#fff;border-radius:12px;max-width:420px;width:100%;box-shadow:0 24px 64px rgba(0,0,0,0.18);overflow:hidden;">
        <div style="padding:20px 22px 8px;">
            <div style="font-family:'Fraunces',Georgia,serif;font-size:18px;font-weight:700;color:var(--color-text);" x-text="$store.confirm.title"></div>
            <div style="font-size:13.5px;color:var(--color-text);margin-top:8px;line-height:1.5;" x-text="$store.confirm.message"></div>
        </div>
        <div style="padding:14px 22px 20px;display:flex;gap:8px;justify-content:flex-end;">
            <button type="button" class="btn btn-secondary btn-sm" @@click="$store.confirm.answer(false)">İptal</button>
            <button type="button" class="btn btn-danger btn-sm" @@click="$store.confirm.answer(true)" x-ref="confirmBtn">Onayla</button>
        </div>
    </div>
</div>
