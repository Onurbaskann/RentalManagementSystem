@using Microsoft.AspNetCore.Identity
@using KiraTakip.Models
@using KiraTakip.Authorization
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    ApplicationUser? currentUser = null;
    string userInitials = "KT";
    string userAdSoyad = "Kullanıcı";
    string userRole = "Kiracı";

    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            userAdSoyad = currentUser.AdSoyad ?? currentUser.Email ?? "Kullanıcı";
            userInitials = string.Join("", userAdSoyad.Split(' ')
                .Where(p => p.Length > 0).Take(2).Select(p => char.ToUpper(p[0])));
        }
    }

    if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Kullanici.Manage))
        userRole = "Firma Yetkilisi";
    else if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Odeme.View))
        userRole = "Finans Yetkilisi";
}

<aside class="sidebar" :class="{ 'is-open': $store.ui.sidebarOpen }">
    <div class="sidebar-header flex items-center gap-3">
        <div class="sidebar-logo flex-shrink-0">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="28" height="28" rx="8" class="fill-indigo-600"/>
                <path d="M7 20V11L14 7L21 11V20H17V15H11V20H7Z" fill="white"/>
            </svg>
        </div>
        <div class="overflow-hidden">
            <div class="sidebar-title leading-tight">Kira Takip</div>
            <div class="sidebar-subtitle leading-tight">Kiracı Portalı</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <a asp-controller="KiraciPanel" asp-action="Index"
           class="nav-item @(currentController == "KiraciPanel" ? "nav-item-active" : "")">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Panel
        </a>

        @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Sozlesme.View))
        {
            <a asp-controller="KiraciSozlesme" asp-action="Index"
               class="nav-item @(currentController == "KiraciSozlesme" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                Sözleşmelerim
            </a>
        }

        @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Borc.View)
          || User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Odeme.View)
          || User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Mutabakat.Manage))
        {
            <div class="nav-separator"></div>
            <div class="nav-group-label">Finans</div>
            @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Borc.View))
            {
                <a asp-controller="KiraciBorc" asp-action="Index"
                   class="nav-item @(currentController == "KiraciBorc" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                    Borçlarım
                </a>
            }
            @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Odeme.View))
            {
                <a asp-controller="KiraciOdeme" asp-action="Index"
                   class="nav-item @(currentController == "KiraciOdeme" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                    Ödemelerim
                </a>
            }
            @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Mutabakat.Manage))
            {
                <a asp-controller="KiraciMutabakat" asp-action="Index"
                   class="nav-item @(currentController == "KiraciMutabakat" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Cari Mutabakat
                </a>
            }
        }

        @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Rezervasyon.View))
        {
            <div class="nav-separator"></div>
            <a asp-controller="KiraciRezervasyonum" asp-action="Index"
               class="nav-item @(currentController == "KiraciRezervasyonum" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Rezervasyonlarım
            </a>
        }

        <div class="nav-separator"></div>
        <a asp-controller="KiraciProfil" asp-action="Index"
           class="nav-item @(currentController == "KiraciProfil" ? "nav-item-active" : "")">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2v-5a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            Firma Profili
        </a>

        @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Kullanici.View)
          || User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Rol.View))
        {
            <div class="nav-separator"></div>
            <div class="nav-group-label">Yönetim</div>
            @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Kullanici.View))
            {
                <a asp-controller="KiraciKullanici" asp-action="Index"
                   class="nav-item @(currentController == "KiraciKullanici" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Kullanıcılar
                </a>
            }
            @if (User.HasClaim(AppClaimTypes.Permission, PermissionCatalog.KiraciPortal.Rol.View))
            {
                <a asp-controller="KiraciRol" asp-action="Index"
                   class="nav-item @(currentController == "KiraciRol" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/><polyline points="15 11 17 13 21 9"/></svg>
                    Roller
                </a>
            }
        }
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user flex items-center gap-3">
            <div class="sidebar-avatar flex-shrink-0">@userInitials</div>
            <div class="flex-1 min-w-0">
                <div class="sidebar-user-name truncate">@userAdSoyad</div>
                <div class="sidebar-user-role truncate text-[10px] uppercase font-bold opacity-60 tracking-wider">@userRole</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="flex-shrink-0">
                @Html.AntiForgeryToken()
                <button type="submit" title="Çıkış Yap"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-red-500 hover:bg-red-50 transition-all flex items-center justify-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</aside>
