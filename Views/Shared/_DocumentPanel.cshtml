@model KiraTakip.Models.ViewModels.DocumentPanelViewModel
@using KiraTakip.Models.Entities
@using System.Linq

@if (!Model.DocumentTypes.Any()) { return; }

@{
    var uploadedCount = Model.DocumentTypes.Count(documentType => Model.Documents.Any(document => document.DocumentTypeId == documentType.Id));
    var missingRequiredDocuments = Model.DocumentTypes
        .Where(documentType => documentType.Required && !Model.Documents.Any(document => document.DocumentTypeId == documentType.Id))
        .ToList();
}

<div class="card p-0 overflow-hidden mb-5">
    <div class="p-[18px_20px_14px] border-b border-[var(--color-border)] flex items-center gap-2">
        <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
        <span class="section-title">Belgeler</span>
        <span class="text-[12px] text-muted font-normal">(@uploadedCount / @Model.DocumentTypes.Count yüklendi)</span>
    </div>

    <div class="divide-y divide-[var(--color-border)]">
        @foreach (var documentType in Model.DocumentTypes)
        {
            var currentDocument = Model.Documents.FirstOrDefault(document => document.DocumentTypeId == documentType.Id);
            var acceptAttribute = string.Join(",", documentType.AllowedExtensions.Split(',').Select(extension => "." + extension.Trim()));
            <div x-data="{ showForm: false }" class="px-5 py-4">
                <div class="flex items-center justify-between gap-4">
                    <!-- Sol: ikon + bilgi -->
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 @(currentDocument != null ? "bg-emerald-50 border border-emerald-200 text-emerald-600" : "bg-slate-50 border border-slate-200 text-slate-400")">
                            @if (currentDocument != null)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            }
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="text-[13.5px] font-semibold text-slate-800">@documentType.Name</span>
                                @if (documentType.Required)
                                {
                                    <span class="text-[10px] font-bold bg-red-50 text-red-600 px-1.5 py-0.5 rounded-md border border-red-100 leading-tight">Zorunlu</span>
                                }
                            </div>
                            @if (currentDocument != null)
                            {
                                <div class="text-[11.5px] text-muted mt-0.5 truncate">
                                    @currentDocument.FileName
                                    · @(currentDocument.FileSize < 1024 * 1024 ? $"{currentDocument.FileSize / 1024.0:F0} KB" : $"{currentDocument.FileSize / 1024.0 / 1024.0:F1} MB")
                                    · @currentDocument.CreatedAt.ToString("dd.MM.yyyy")
                                </div>
                            }
                            else
                            {
                                <div class="text-[11.5px] text-slate-400 italic mt-0.5">Henüz yüklenmedi</div>
                            }
                        </div>
                    </div>
                    <!-- Sağ: butonlar -->
                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        @if (currentDocument != null)
                        {
                            <a href="/Document/Download/@currentDocument.Id.ToHashId()" target="_blank"
                               class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all" title="İndir">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            </a>
                            @if (Model.CanEdit && !documentType.Required)
                            {
                                <form method="post" action="/Document/Delete/@currentDocument.Id.ToHashId()" data-confirm="Bu belge silinsin mi?" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Sil">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </form>
                            }
                        }
                        @if (Model.CanEdit)
                        {
                            <button type="button" @@click="showForm = !showForm"
                                    class="btn btn-sm btn-secondary flex items-center gap-1.5 transition-all"
                                    :class="showForm ? 'bg-slate-200 border-slate-300' : ''">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                     x-show="!showForm">
                                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                                </svg>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                     x-show="showForm" x-cloak>
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                                <span x-text="showForm ? 'İptal' : '@(currentDocument != null ? "Güncelle" : "Yükle")'"></span>
                            </button>
                        }
                    </div>
                </div>

                @if (Model.CanEdit)
                {
                    <div x-show="showForm" x-cloak class="mt-3 pt-3 border-t border-slate-100">
                        <form method="post" action="/Document/Upload" enctype="multipart/form-data"
                              class="flex flex-col sm:flex-row items-start sm:items-end gap-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ownerType" value="@((int)Model.OwnerType)" />
                            <input type="hidden" name="ownerId"   value="@Model.OwnerId" />
                            <input type="hidden" name="documentTypeId" value="@documentType.Id" />
                            <div class="flex-1 w-full">
                                <input type="file" name="file" class="form-control text-xs
                                       file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0
                                       file:text-[11px] file:font-bold file:bg-indigo-50 file:text-indigo-700
                                       hover:file:bg-indigo-100 transition-all"
                                       accept="@acceptAttribute" />
                                <div class="text-[10.5px] text-muted mt-1.5">
                                    İzin verilen: @documentType.AllowedExtensions · Maks. @documentType.MaxSizeMb MB
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm px-5 flex-shrink-0">Kaydet</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>

    @if (missingRequiredDocuments.Any())
    {
        <div class="px-5 py-3 border-t border-amber-100 bg-amber-50 flex items-center gap-2 text-amber-700 text-[12.5px]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><span class="font-semibold">Eksik zorunlu belgeler:</span> @string.Join(", ", missingRequiredDocuments.Select(document => document.Name))</span>
        </div>
    }
</div>

