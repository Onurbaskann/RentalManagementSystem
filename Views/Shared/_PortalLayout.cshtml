<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — KiraTakip Ödeme</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; padding: 0; background: #f4f6f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; color: #1e293b; }
        .portal-wrap { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px 16px; }
        .portal-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); width: 100%; max-width: 520px; overflow: hidden; }
        .portal-header { background: #2563eb; padding: 20px 28px; display: flex; align-items: center; gap: 10px; }
        .portal-header span { color: #fff; font-size: 18px; font-weight: 700; }
        .portal-body { padding: 32px 28px; }
        .portal-footer { padding: 14px 28px; background: #f8fafc; border-top: 1px solid #e2e8f0; text-align: center; font-size: 12px; color: #94a3b8; }
        .row { display: flex; justify-content: space-between; align-items: flex-start; padding: 8px 0; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
        .row:last-child { border-bottom: none; }
        .row .label { color: #64748b; }
        .row .value { font-weight: 600; text-align: right; }
        .amount { font-size: 26px; font-weight: 700; color: #2563eb; }
        .btn-primary { display: inline-block; padding: 12px 32px; background: #2563eb; color: #fff; border-radius: 8px; font-size: 15px; font-weight: 700; text-decoration: none; margin-top: 8px; }
        .badge-info { display: inline-block; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 10px 16px; font-size: 13.5px; margin-top: 16px; width: 100%; text-align: center; }
    </style>
</head>
<body>
<div class="portal-wrap">
    @RenderBody()
    <p style="margin-top:20px;font-size:12px;color:#94a3b8;text-align:center;">KiraTakip &copy; @DateTime.Now.Year</p>
</div>
</body>
</html>
