<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — KiraTakip Ödeme</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-100 font-sans text-slate-800">
@if (ViewData["WideLayout"] != null)
{
    <div class="h-screen overflow-hidden flex flex-col p-4 lg:p-6">
        <div class="w-full max-w-6xl mx-auto flex-1 min-h-0 flex flex-col">
            @RenderBody()
            <p class="mt-3 text-xs text-slate-400 text-center font-medium uppercase tracking-widest shrink-0">KiraTakip &copy; @DateTime.Now.Year</p>
        </div>
    </div>
}
else
{
    <div class="min-h-screen flex flex-col items-center justify-center p-6">
        <div class="w-full max-w-[520px]">
            @RenderBody()
            <p class="mt-6 text-xs text-slate-400 text-center font-medium uppercase tracking-widest">KiraTakip &copy; @DateTime.Now.Year</p>
        </div>
    </div>
}
</body>
</html>

