@using KiraTakip.Models
@model OccupancyStatus

@{
    var (cls, label) = Model switch
    {
        OccupancyStatus.Leased => ("badge-kirali", "Kiralı"),
        OccupancyStatus.ExpiringSoon => ("badge-surek", "Süresi Dolmak Üzere"),
        OccupancyStatus.Vacant => ("badge-bos", "Boş"),
        _ => ("badge-bos", "Bilinmiyor")
    };
}
<span class="badge @cls">@label</span>

