@using KiraTakip.Models
@using System.Linq
@model KiraTakip.Models.ViewModels.ParentTarifeKartViewModel

@{
    var gruplar = Model.Satirlar.GroupBy(s => s.KategoriAd).ToList();
}

<style>
    .parent-tarife-kart > summary::-webkit-details-marker { display: none; }
    .parent-tarife-kart > summary::marker { display: none; }
    .parent-tarife-kart[open] > summary { border-radius: 6px 6px 0 0 !important; }
</style>

<details class="parent-tarife-kart" style="margin-bottom:12px;">
    <summary style="
        cursor:pointer;
        display:flex;
        align-items:center;
        gap:8px;
        padding:6px 10px;
        background:#eef3fd;
        border:1px solid #c7d8f8;
        border-radius:6px;
        user-select:none;
    ">
        <span style="font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#4b6cb7;background:#dbeafe;border:1px solid #bfdbfe;border-radius:3px;padding:1px 6px;">
            @Model.KaynakAdi
        </span>
        @if (!Model.Satirlar.Any())
        {
            <span style="font-size:11.5px;color:var(--color-muted);font-style:italic;">— tarife tanımlanmamış</span>
        }
        else
        {
            <span style="font-size:11px;color:var(--color-muted);">@gruplar.Count kategori · @Model.Satirlar.Count kalem</span>
        }
        @if (Model.Aciklama != null)
        {
            <span style="font-size:11px;color:var(--color-muted);">— @Model.Aciklama</span>
        }
        <span style="margin-left:auto;font-size:10px;color:#9aabcf;">▼</span>
    </summary>

    <div style="border:1px solid #c7d8f8;border-top:none;border-radius:0 0 6px 6px;background:#f8faff;padding:10px 12px;">
        @if (!Model.Satirlar.Any())
        {
            <p style="margin:0;font-size:12px;color:var(--color-muted);font-style:italic;">
                Bu yıl için tarife tanımlanmamış. Kalemler 0₺ olarak hesaplanacak.
            </p>
        }
        else
        {
            @foreach (var (grup, idx) in gruplar.Select((g, i) => (g, i)))
            {
                <div style="@(idx > 0 ? "margin-top:10px;" : "")">
                    <div style="font-size:10.5px;font-weight:700;color:#4b6cb7;letter-spacing:.4px;text-transform:uppercase;padding-bottom:3px;border-bottom:1px dashed #c7d8f8;margin-bottom:4px;">
                        @grup.Key
                    </div>
                    <div style="display:grid;grid-template-columns:1fr auto auto auto;column-gap:12px;row-gap:3px;font-size:12px;padding:0 2px;">
                        @foreach (var satir in grup)
                        {
                            <span style="color:var(--color-text);">@satir.BorcTipiAd</span>
                            <span style="color:var(--color-muted);white-space:nowrap;">@(satir.HesaplamaYontemi == HesaplamaYontemi.M2 ? "m²" : "Sabit")</span>
                            <span style="text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;">@satir.BirimDeger.ToString("N2") ₺</span>
                            <span style="text-align:right;color:var(--color-muted);white-space:nowrap;">%@satir.KdvOrani.ToString("N0")</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</details>
