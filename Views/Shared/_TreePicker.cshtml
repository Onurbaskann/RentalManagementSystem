@model KiraTakip.Models.ViewModels.TreePickerViewModel
@using System.Text.Json
@{
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var nodesJson = JsonSerializer.Serialize(Model.Nodes, jsonOptions);
    var configJson = JsonSerializer.Serialize(new
    {
        Model.InputName,
        Model.SearchPlaceholder,
        Model.EmptyChildrenText,
        Model.NoMatchesText,
        Model.EmptySelectionText,
        Model.NodeCountLabel,
        Model.ChildCountLabel,
        Model.SummarySuffix,
        Model.HighlightTitle
    }, jsonOptions);
}

<div data-tree-picker-nodes="@nodesJson"
     data-tree-picker-config="@configJson"
     x-data="treePicker(JSON.parse($el.dataset.treePickerNodes), JSON.parse($el.dataset.treePickerConfig))"
     class="relative">

    <button type="button" @@click.prevent="open = !open"
            class="w-full flex items-center justify-between gap-3 px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-700 hover:border-[#1a6b5c] focus:outline-none focus:ring-2 focus:ring-[#1a6b5c]/30 transition-all">
        <span class="text-left" x-text="summary"></span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
             class="flex-shrink-0 text-slate-400 transition-transform" :class="open ? 'rotate-180' : ''">
            <polyline points="6 9 12 15 18 9"/>
        </svg>
    </button>

    <div x-show="open" @@click.outside="open = false" x-cloak
         class="absolute z-50 mt-1 w-full bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden">

        <div class="px-3 py-2.5 border-b border-slate-100">
            <input x-model="query" type="text" :placeholder="config.searchPlaceholder"
                   class="w-full text-[13px] px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-[#1a6b5c]/40 placeholder-slate-400" />
        </div>

        <div class="overflow-y-auto p-2" style="max-height: 250px;">
            <template x-for="node in filteredNodes" :key="node.value">
                <div class="mb-1">
                    <div x-show="node.groupLabel && isFirstInGroup(node)"
                         class="px-2 pt-2 pb-1 text-[11px] font-bold uppercase tracking-wide text-slate-400"
                         x-text="node.groupLabel"></div>

                    <div class="flex items-center rounded-lg hover:bg-slate-50 transition-colors"
                         :class="node.groupLabel ? 'ml-3' : ''">
                        <label class="flex flex-1 items-center gap-2 px-2 py-1.5 cursor-pointer">
                            <input type="checkbox"
                                   :checked="node.selected"
                                   :indeterminate.prop="isIndeterminate(node)"
                                   @@change="toggleNode(node)"
                                   class="w-4 h-4 rounded border-slate-300 accent-[#1a6b5c] cursor-pointer" />
                            <span class="text-[13px] font-semibold text-slate-700" x-text="node.label"></span>
                            <span x-show="node.children.length === 0 && config.emptyChildrenText"
                                  class="ml-auto text-[11px] text-slate-400 font-normal italic"
                                  x-text="config.emptyChildrenText"></span>
                        </label>

                        <button x-show="node.children.length > 0"
                                type="button"
                                @@click.stop="toggleExpanded(node)"
                                :aria-expanded="node.expanded || !!query.trim()"
                                class="mr-1 p-1.5 rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-100"
                                title="Alt seçenekleri göster veya gizle">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5"
                                 class="transition-transform"
                                 :class="node.expanded || query.trim() ? 'rotate-180' : ''">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                    </div>

                    <template x-if="node.children.length > 0">
                        <div x-show="node.expanded || query.trim()"
                             x-transition
                             class="ml-4 border-l border-slate-100 pl-2 mt-0.5"
                             :class="node.groupLabel ? 'ml-7' : ''">
                            <template x-for="child in node.children" :key="child.value">
                                <label x-show="childVisible(node, child)"
                                       class="flex items-center gap-2 px-2 py-1 rounded-lg cursor-pointer hover:bg-slate-50 transition-colors">
                                    <input type="checkbox"
                                           :checked="child.selected"
                                           @@change="toggleChild(node, child)"
                                           class="w-3.5 h-3.5 rounded border-slate-300 accent-[#1a6b5c] cursor-pointer" />
                                    <span class="text-[12.5px] text-slate-600" x-text="child.label"></span>
                                    <span x-show="child.highlighted"
                                          class="ml-0.5 w-1.5 h-1.5 rounded-full bg-amber-400 flex-shrink-0"
                                          :title="config.highlightTitle"></span>
                                </label>
                            </template>
                        </div>
                    </template>
                </div>
            </template>

            <div x-show="filteredNodes.length === 0" class="text-center text-[13px] text-slate-400 py-6"
                 x-text="config.noMatchesText"></div>
        </div>
    </div>

    <template x-for="node in nodes" :key="'node_' + node.value">
        <template x-if="node.selected">
            <input type="hidden" :name="config.inputName" :value="node.value" />
        </template>
    </template>
    <template x-for="node in nodes" :key="'children_' + node.value">
        <template x-for="child in node.children" :key="child.value">
            <template x-if="child.selected">
                <input type="hidden" :name="config.inputName" :value="child.value" />
            </template>
        </template>
    </template>
</div>

<script>
function treePicker(initialNodes, config) {
    return {
        open: false,
        query: '',
        nodes: initialNodes.map(node => ({ ...node, expanded: false })),
        config,

        get filteredNodes() {
            if (!this.query.trim()) return this.nodes;
            const query = this.query.toLocaleLowerCase('tr-TR');
            return this.nodes.filter(node =>
                node.label.toLocaleLowerCase('tr-TR').includes(query) ||
                node.children.some(child => child.label.toLocaleLowerCase('tr-TR').includes(query))
            );
        },

        get summary() {
            const selectedNodes = this.nodes.filter(node => node.selected).length;
            const selectedChildren = this.nodes.flatMap(node => node.children)
                .filter(child => child.selected).length;
            if (selectedNodes === 0) return this.config.emptySelectionText;
            const childText = selectedChildren > 0
                ? `, ${selectedChildren} ${this.config.childCountLabel}`
                : '';
            const suffix = this.config.summarySuffix ? ` ${this.config.summarySuffix}` : '';
            return `${selectedNodes} ${this.config.nodeCountLabel}${childText}${suffix}`;
        },

        isIndeterminate(node) {
            if (!node.selected || node.children.length === 0) return false;
            const selectedCount = node.children.filter(child => child.selected).length;
            return selectedCount > 0 && selectedCount < node.children.length;
        },

        childVisible(node, child) {
            if (!this.query.trim()) return true;
            const query = this.query.toLocaleLowerCase('tr-TR');
            return child.label.toLocaleLowerCase('tr-TR').includes(query)
                || node.label.toLocaleLowerCase('tr-TR').includes(query);
        },

        isFirstInGroup(node) {
            return this.filteredNodes.findIndex(item => item.groupLabel === node.groupLabel)
                === this.filteredNodes.indexOf(node);
        },

        toggleNode(node) {
            node.selected = !node.selected;
            node.children.forEach(child => child.selected = node.selected);
        },

        toggleExpanded(node) {
            node.expanded = !node.expanded;
        },

        toggleChild(node, child) {
            child.selected = !child.selected;
            if (child.selected && !node.selected) node.selected = true;
        }
    };
}
</script>
