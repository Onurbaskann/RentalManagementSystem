@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.ReservationListItemDto>
@using KiraTakip.Models.Common
@using KiraTakip.Models.Enums
@{
    ViewData["Title"] = "Rezervasyonlar";
    ViewData["UseCentralFeedback"] = true;
    bool canCreate = await PermissionService.HasPermissionAsync(PermissionCatalog.Reservation.Create);
    bool canEdit = await PermissionService.HasPermissionAsync(PermissionCatalog.Reservation.Edit);
    bool canTransfer = await PermissionService.HasPermissionAsync(PermissionCatalog.Reservation.TransferToCharge);
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var activeStatus = string.IsNullOrWhiteSpace(query.Status) ? "tum" : query.Status;
    var cancelledCount = ViewBag.CancelledCount is int count ? count : 0;
    var pagination = PaginationModel.FromPaged(Model, "/Reservation", query.ToQueryDict());
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Rezervasyon Yönetimi</div>
        <div class="page-subtitle">@Model.Total kayıt</div>
    </div>
    <div class="flex gap-2">
        <a asp-controller="Reservation" asp-action="Calendar" class="btn btn-secondary">Takvim</a>
        @if (canCreate)
        {
            <a href="@Url.Action(
                               nameof(KiraTakip.Web.Controllers.ReservationController.Create),
                               nameof(KiraTakip.Web.Controllers.ReservationController).Replace("Controller", ""))"
               class="btn btn-primary flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Rezervasyon Ekle
            </a>
        }
    </div>
</div>

<div class="flex gap-1.5 flex-wrap @(activeStatus != "iptal" && cancelledCount > 0 ? "mb-2" : "mb-5")">
    @{
        var statusFilters = new[] {
            ("tum", "Tümü"),
            ("onaylandi", "Onaylandı"),
            ("onaybekliyor", "Onay Bekliyor"),
            ("tamamlandi", "Tamamlandı"),
            ("reddedildi", "Reddedildi")
        };
    }
    @foreach (var (key, label) in statusFilters)
    {
        var isActive = activeStatus == key;
        <a href="/Reservation?status=@key&q=@Uri.EscapeDataString(query.Q ?? string.Empty)&size=@query.Size"
           class="btn btn-sm @(isActive ? "btn-primary" : "btn-secondary text-slate-600 bg-white border-slate-200")">@label</a>
    }
    @if (activeStatus == "iptal")
    {
        <a href="/Reservation?status=iptal&q=@Uri.EscapeDataString(query.Q ?? string.Empty)&size=@query.Size" class="btn btn-sm btn-primary">İptal Edildi</a>
    }
</div>
@if (activeStatus != "iptal" && cancelledCount > 0)
{
    <div class="text-xs text-muted mb-5">
        @cancelledCount iptal edilmiş kayıt gizleniyor
        <a href="/Reservation?status=iptal&size=@query.Size" class="link-more ml-1">Görüntüle</a>
    </div>
}

<div class="card p-0 overflow-hidden">
    <form method="get" action="/Reservation" class="flex items-center gap-3 p-3 bg-slate-50/50 border-b border-slate-200">
        <input type="hidden" name="status" value="@activeStatus" />
        <input type="hidden" name="size" value="@query.Size" />
        <input type="search" name="q" value="@query.Q" class="form-control w-full max-w-sm" placeholder="Ara: taşınmaz, birim veya kiracı…" />
        <button type="submit" class="btn btn-secondary">Ara</button>
        @if (!string.IsNullOrWhiteSpace(query.Q))
        {
            <a href="/Reservation?status=@activeStatus&size=@query.Size" class="btn btn-secondary">Temizle</a>
        }
        <span class="ml-auto text-xs text-muted"><strong>@Model.Total</strong> kayıt</span>
    </form>
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-28">No</th>
                    <th>Başlık</th>
                    <th>Taşınmaz / Birim</th>
                    <th>Kiracı</th>
                    <th class="w-36">Zaman Dilimi</th>
                    <th class="w-24 cell-center">Toplam</th>
                    <th class="w-24 cell-center">Ücretsiz</th>
                    <th class="w-24 cell-center">Ücretli</th>
                    <th class="w-32 num">Tutar</th>
                    <th class="w-32">Durum</th>
                    <th class="w-32 text-right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    string statusClass = r.Status.GetBadgeCssClass();
                    string statusLabel = r.Status.GetDisplayLabel();
                    var reservationControllerName = nameof(KiraTakip.Web.Controllers.ReservationController).Replace("Controller", "");
                    var detailsUrl = Url.Action(nameof(KiraTakip.Web.Controllers.ReservationController.Details), reservationControllerName, new { id = r.Id.ToHashId() })!;
                    var editUrl = Url.Action(nameof(KiraTakip.Web.Controllers.ReservationController.Edit), reservationControllerName, new { id = r.Id.ToHashId() })!;

                    <tr data-href="@detailsUrl"
                        class="cursor-pointer hover:bg-slate-50 transition-colors"
                        @@click="$el.dataset.href && !$event.target.closest('a,[data-stop]') && (window.location.href = $el.dataset.href)">
                        <td class="font-mono text-muted-sm">@r.ReservationNo</td>
                        <td><a href="@detailsUrl" class="cell-link">@(string.IsNullOrWhiteSpace(r.Title) ? "—" : r.Title)</a></td>
                        <td>
                            @r.PropertyName
                            <span class="cell-sub">@r.UnitName</span>
                        </td>
                        <td>@r.TenantDisplayName</td>
                        <td>
                            <div>@r.StartDate.ToString("dd.MM HH:mm")</div>
                            <span class="cell-sub">@r.EndDate.ToString("dd.MM HH:mm")</span>
                        </td>
                        <td class="cell-center">@r.TotalDurationMinutes dk</td>
                        <td class="cell-center">@r.FreeDurationMinutes dk</td>
                        <td class="cell-center">@r.PaidDurationMinutes dk</td>
                        <td class="num">
                            @if (r.TotalAmount > 0)
                            {
                                <text>@r.TotalAmount.Tl()</text>
                            }
                            else
                            {

                                <span class="text-muted italic">Ücretsiz</span>
                            }
                        </td>
                        <td>
                            <span class="badge @statusClass">@statusLabel</span>
                            @if (r.Status == ReservationStatus.Cancelled && !string.IsNullOrEmpty(r.CancellationReason))
                            {
                                <div class="text-[10px] text-muted mt-1 italic truncate max-w-[100px]" title="@r.CancellationReason">⤵ @r.CancellationReason</div>
                            }
                        </td>
                        <td class="text-right">
                            <div class="flex gap-1.5 justify-end items-center">
                                @if (canTransfer && r.Status == ReservationStatus.Confirmed && r.TotalAmount > 0 && r.ChargeId == null)
                                {
                                    <form method="post"
                                          action="@Url.Action(
                                                                                      nameof(KiraTakip.Web.Controllers.ReservationController.TransferToCharge),
                                                                                      nameof(KiraTakip.Web.Controllers.ReservationController).Replace("Controller", ""),
                                                                                      new { id = r.Id.ToHashId() })"
                                          class="inline" data-stop
                                          data-confirm="Bu rezervasyonu tahakkuka aktarmak istediğinize emin misiniz?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-primary">Aktar</button>
                                    </form>
                                }
                                @if (canEdit && r.Status is ReservationStatus.PendingApproval or ReservationStatus.Confirmed)
                                {
                                    <a href="@editUrl" class="icon-btn" data-tip="Düzenle" aria-label="Düzenle">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="11" class="py-16 text-center">
                            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 text-slate-300 mb-4">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                            </div>
                            <div class="text-slate-500 font-bold">Rezervasyon bulunamadı</div>
                            @if (canCreate)
                            {
                                <div class="text-xs text-muted mt-1">
                                    <a href="@Url.Action(
                                                                                nameof(KiraTakip.Web.Controllers.ReservationController.Create),
                                                                                nameof(KiraTakip.Web.Controllers.ReservationController).Replace("Controller", ""))"
                                       class="text-primary font-semibold hover:underline">Rezervasyon Ekle</a> butonuyla ilk kaydı oluşturun.
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>

