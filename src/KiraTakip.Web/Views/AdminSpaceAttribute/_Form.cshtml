@model SpaceAttributeFormViewModel
@{
    var isEdit = Model.Id != 0;
    var action = isEdit ? $"/Admin/SpaceAttribute/Edit/{Model.Id.ToHashId()}" : "/Admin/SpaceAttribute/Create";
    var permission = isEdit ? PermissionCatalog.SpaceAttribute.Edit : PermissionCatalog.SpaceAttribute.Create;
}

<div class="max-w-[600px] mx-auto">
    <div class="page-header">
        <div class="page-title">@(isEdit ? "Alan Özelliğini Düzenle" : "Yeni Alan Özelliği")</div>
    </div>

    <div class="card" x-data="{ type: '@Model.DataType' }">
        <form method="post" action="@action" asp-form-write-permission="@permission">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Kod <span class="text-red-500">*</span></label>
                <input name="Code" value="@Model.Code" class="form-control" maxlength="50" />
            </div>
            <div class="form-group">
                <label class="form-label">Ad <span class="text-red-500">*</span></label>
                <input name="Name" value="@Model.Name" class="form-control" maxlength="150" />
            </div>
            <div class="form-group">
                <label class="form-label">Veri Tipi <span class="text-red-500">*</span></label>
                <select name="DataType" class="form-control" x-model="type">
                    @foreach (var dataType in new[] { AttributeDataType.Text, AttributeDataType.Number, AttributeDataType.Boolean, AttributeDataType.List })
                    {
                        <option value="@dataType" selected="@(dataType == Model.DataType)">@SpaceDisplay.DataType(dataType)</option>
                    }
                </select>
            </div>
            <div class="form-group" x-show="type === 'List'" x-cloak>
                <label class="form-label">Seçenekler</label>
                <textarea name="Options" rows="4" class="form-control">@Model.Options</textarea>
                <div class="text-xs text-muted mt-1">Her satıra bir seçenek yazın.</div>
            </div>

            <div class="flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-6" asp-permission="@permission">Kaydet</button>
                <a href="/Admin/SpaceAttribute" class="btn btn-secondary px-6">İptal</a>
            </div>
        </form>
    </div>
</div>
