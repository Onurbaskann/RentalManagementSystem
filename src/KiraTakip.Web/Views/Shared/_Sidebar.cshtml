@using KiraTakip.Web.Extensions
@using KiraTakip.Services.Interfaces.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IUserRoleService UserRoleService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    ApplicationUser? currentUser = null;
    string userInitials = "KT";
    string userEmail = string.Empty;
    string userAdSoyad = "Demo Kullanıcı";
    string userRole = "Kullanıcı";

    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            userAdSoyad = currentUser.AdSoyad ?? currentUser.Email ?? "Kullanıcı";
            userEmail = currentUser.Email ?? string.Empty;
            userInitials = string.Join("", userAdSoyad.Split(' ')
                .Where(p => p.Length > 0).Take(2).Select(p => char.ToUpper(p[0])));

            var roles = await UserRoleService.GetUserRolesAsync(currentUser.Id);
            userRole = roles.FirstOrDefault() ?? "Kullanıcı";
        }
    }

    var hasAnyParamAccess = await PermissionService.HasModuleAccessAsync(PermissionCatalog.Parameter.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.UnitType.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.TenantCategory.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.Sector.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.ChargeType.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.Store.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.PaymentRouting.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.PropertyType.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.RateSchedule.Module) ||
                            await PermissionService.HasModuleAccessAsync(PermissionCatalog.DocumentType.Module);
}

<aside class="sidebar" :class="{ 'is-open': $store.ui.sidebarOpen }">
    <div class="sidebar-header flex items-center gap-3">
        <div class="sidebar-logo flex-shrink-0">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="28" height="28" rx="8" class="fill-accent" />
                <path d="M7 20V11L14 7L21 11V20H17V15H11V20H7Z" fill="white" />
            </svg>
        </div>
        <div class="overflow-hidden sidebar-brand-text">
            <div class="sidebar-title leading-tight">UniTeknopark</div>
            <div class="sidebar-subtitle leading-tight">Yönetim Paneli</div>
        </div>
        <button type="button" class="sidebar-collapse-btn" @@click="$store.ui.toggleCollapse()"
                :aria-label="$store.ui.collapsed ? 'Menüyü genişlet' : 'Menüyü daralt'"
                :data-tip="$store.ui.collapsed ? 'Menüyü genişlet' : 'Menüyü daralt'" data-tip-side="right">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /></svg>
        </button>
    </div>

    <nav class="sidebar-nav">
        <a href="/" class="nav-item @(currentController == "Home" ? "nav-item-active" : "")">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
            <span class="nav-label">Anasayfa</span>
        </a>
        @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Property.Module))
        {
            <a href="/Property" class="nav-item @(currentController == "Property" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
                <span class="nav-label">Taşınmazlar</span>
            </a>
        }
        @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Tenant.Module))
        {
            <a href="/Tenant" class="nav-item @(currentController == "Tenant" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                <span class="nav-label">Kiracılar</span>
            </a>
        }
        @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Lease.Module))
        {
            <a href="/Lease" class="nav-item @(currentController == "Lease" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                <span class="nav-label">Sözleşmeler</span>
            </a>
        }
        @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Reservation.Module))
        {
            <a href="@Url.Action(
                                   nameof(KiraTakip.Web.Controllers.ReservationController.Index),
                                   nameof(KiraTakip.Web.Controllers.ReservationController).Replace("Controller", ""))"
               class="nav-item @(currentController == "Reservation" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                <span class="nav-label">Rezervasyonlar</span>
            </a>
        }
        @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Payment.Module))
        {
            <a href="/Charge" class="nav-item @(currentController == "Charge" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                <span class="nav-label">Tahakkuklar</span>
            </a>
            <a href="/Payment" class="nav-item nav-item-sub @(currentController == "Payment" ? "nav-item-active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path d="M6 12h.01M18 12h.01" /></svg>
                <span class="nav-label">Ödemeler</span>
            </a>
            <a href="/BankTransaction" class="nav-item nav-item-sub @(currentController == "BankTransaction" ? "nav-item-active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
                <span class="nav-label">Banka Hareketleri</span>
            </a>
            <a href="@Url.Action(
                                   nameof(KiraTakip.Web.Controllers.ReportController.Index),
                                   nameof(KiraTakip.Web.Controllers.ReportController).Replace("Controller", ""))"
               class="nav-item nav-item-sub @(currentController == "Report" ? "nav-item-active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                <span class="nav-label">Tahsilat Raporu</span>
            </a>
        }
        @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.ManualCharge.Module))
        {
            <a href="/ManualCharge" class="nav-item @(currentController == "ManualCharge" ? "nav-item-active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="12" y1="18" x2="12" y2="12" /><line x1="9" y1="15" x2="15" y2="15" /></svg>
                <span class="nav-label">Manuel Borçlar</span>
            </a>
        }

        @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.User.Module) || await PermissionService.HasModuleAccessAsync(PermissionCatalog.Role.Module) || await PermissionService.HasModuleAccessAsync(PermissionCatalog.Audit.Module))
        {
            <div class="nav-separator"></div>
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.User.Module))
            {
                <a href="/Admin/Users" class="nav-item @(currentController == "AdminUser" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                    <span class="nav-label">Kullanıcı Yönetimi</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Role.Module))
            {
                <a href="/Admin/Roles" class="nav-item @(currentController == "AdminRole" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" /><polyline points="15 11 17 13 21 9" /></svg>
                    <span class="nav-label">Rol Yönetimi</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Audit.Module))
            {
                <a href="/Admin/AuditLog" class="nav-item @(currentController == "AdminAuditLog" ? "nav-item-active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
                    <span class="nav-label">Hareket Geçmişi</span>
                </a>
            }
        }

        @if (hasAnyParamAccess)
        {
            <div class="nav-separator"></div>
            <div class="nav-group-label">Parametreler</div>
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.UnitType.Module))
            {
                <a href="/Admin/UnitType" class="nav-item nav-item-sub @(currentController == "AdminUnitType" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
                    <span class="nav-label">Birim Türleri</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.TenantCategory.Module))
            {
                <a href="/Admin/TenantCategory" class="nav-item nav-item-sub @(currentController == "AdminTenantCategory" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    <span class="nav-label">Kiracı Kategorileri</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Sector.Module))
            {
                <a href="/Admin/Sector" class="nav-item nav-item-sub @(currentController == "AdminSector" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                    <span class="nav-label">Sektörler</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.ChargeType.Module))
            {
                <a href="/Admin/ChargeType" class="nav-item nav-item-sub @(currentController == "AdminChargeType" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" /><rect x="9" y="3" width="6" height="4" rx="1" /><line x1="9" y1="12" x2="15" y2="12" /><line x1="9" y1="16" x2="13" y2="16" /></svg>
                    <span class="nav-label">Borç Tipleri</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Store.Module))
            {
                <a href="/Admin/Store" class="nav-item nav-item-sub @(currentController == "AdminStore" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9h18l-2-5H5L3 9Z" /><path d="M5 9v10h14V9" /><path d="M9 19v-6h6v6" /></svg>
                    <span class="nav-label">Mağazalar</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.PaymentRouting.Module))
            {
                <a href="/Admin/PaymentStoreRouting" class="nav-item nav-item-sub @(currentController == "AdminPaymentStoreRouting" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h10M4 17h7" /><circle cx="18" cy="16" r="3" /><path d="m20 18 2 2" /></svg>
                    <span class="nav-label">Ödeme Yönlendirmeleri</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.PropertyType.Module))
            {
                <a href="/Admin/PropertyType" class="nav-item nav-item-sub @(currentController == "AdminPropertyType" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    <span class="nav-label">Taşınmaz Tipleri</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.RateSchedule.Module))
            {
                <a href="/Admin/Rate" class="nav-item nav-item-sub @(currentController == "AdminRate" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                    <span class="nav-label">Yıllık Tarifeler</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.DocumentType.Module))
            {
                <a href="/Admin/DocumentType" class="nav-item nav-item-sub @(currentController == "AdminDocumentType" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
                    <span class="nav-label">Belge Türleri</span>
                </a>
            }
            @if (await PermissionService.HasModuleAccessAsync(PermissionCatalog.Parameter.Module))
            {
                <a href="/Admin/SystemSetting" class="nav-item nav-item-sub @(currentController == "AdminSystemSetting" ? "nav-item-active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1z" /></svg>
                    <span class="nav-label">Sistem Ayarları</span>
                </a>
            }
        }

        @{
            var canAddTasinmaz = await PermissionService.HasPermissionAsync(PermissionCatalog.Property.Create);
            var canAddKiraci = await PermissionService.HasPermissionAsync(PermissionCatalog.Tenant.Create);
            var canAddSozlesme = await PermissionService.HasPermissionAsync(PermissionCatalog.Lease.Create);
            var canAddReservation = await PermissionService.HasPermissionAsync(PermissionCatalog.Reservation.Create);
            var hasAnyQuickAdd = canAddTasinmaz || canAddKiraci || canAddSozlesme || canAddReservation;
        }

        @if (hasAnyQuickAdd)
        {
            <div class="nav-separator"></div>
            <div class="nav-group-label">Hızlı Ekle</div>
            @if (canAddTasinmaz)
            {
                <a href="/Property/Create" class="nav-item nav-item-sub">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="13" height="18" rx="2" /><path d="M2 9h13M8 21V9" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                    <span class="nav-label">Taşınmaz Ekle</span>
                </a>
            }
            @if (canAddKiraci)
            {
                <a href="/Tenant/Create" class="nav-item nav-item-sub">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                    <span class="nav-label">Kiracı Ekle</span>
                </a>
            }
            @if (canAddSozlesme)
            {
                <a href="/Lease/Create" class="nav-item nav-item-sub">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="12" y1="18" x2="12" y2="12" /><line x1="9" y1="15" x2="15" y2="15" /></svg>
                    <span class="nav-label">Sözleşme Ekle</span>
                </a>
            }
            @if (canAddReservation)
            {
                <a href="@Url.Action(
                                           nameof(KiraTakip.Web.Controllers.ReservationController.Create),
                                           nameof(KiraTakip.Web.Controllers.ReservationController).Replace("Controller", ""))"
                   class="nav-item nav-item-sub">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="12" y1="14" x2="12" y2="18" /><line x1="10" y1="16" x2="14" y2="16" /></svg>
                    <span class="nav-label">Rezervasyon Ekle</span>
                </a>
            }
        }
    </nav>

    <div class="sidebar-footer">
        <div x-data="{ open: false }" @@keydown.escape.window="open = false" class="relative">
            <button type="button" class="user-trigger" :class="{ 'is-open': open }" @@click="open = !open"
                    aria-haspopup="menu" :aria-expanded="open"
                    data-tip="@userAdSoyad" data-tip-side="right" data-tip-when="sidebar-collapsed">
                <div class="sidebar-avatar flex-shrink-0">@userInitials</div>
                <div class="sidebar-user-text">
                    <div class="sidebar-user-name truncate">@userAdSoyad</div>
                    <div class="sidebar-user-role truncate">@userRole</div>
                </div>
                <svg class="user-trigger-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6" /></svg>
            </button>

            <div class="user-menu" x-show="open" x-cloak @@click.outside="open = false" role="menu"
                 x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="opacity-0 translate-y-1"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-100"
                 x-transition:leave-start="opacity-100"
                 x-transition:leave-end="opacity-0">
                <div class="user-menu-head">
                    <div class="user-menu-avatar">@userInitials</div>
                    <div class="min-w-0">
                        <div class="user-menu-name truncate">@userAdSoyad</div>
                        @if (!string.IsNullOrEmpty(userEmail))
                        {
                            <div class="user-menu-email truncate">@userEmail</div>
                        }
                        <span class="user-menu-role">@userRole</span>
                    </div>
                </div>
                <a href="/Account/ChangePassword" class="user-menu-item" role="menuitem">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    Şifre Değiştir
                </a>
                <div class="user-menu-sep"></div>
                <form asp-controller="Account" asp-action="Logout" method="post">
