@using KiraTakip.Web.Models.ViewModels
@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hata — UniTeknopark</title>
    @await Html.PartialAsync("_BrandHead")
    </head>
    <body class="bg-canvas min-h-screen flex items-center justify-center">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 p-8 text-center">
            <div class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" class="stroke-danger" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            </div>
            <div class="text-lg font-bold text-slate-800 mb-2">Beklenmeyen Bir Hata Oluştu</div>
            <p class="text-sm text-slate-500 mb-6">
                İşleminiz gerçekleştirilirken bir sorun yaşandı. Lütfen tekrar deneyin;
                sorun devam ederse sistem yöneticinize başvurun.
            </p>
            @if (Model.ShowRequestId)
            {
                <p class="text-[11px] text-slate-400 mb-6">Referans: <code>@Model.RequestId</code></p>
            }
            <div class="flex justify-center gap-3">
                <button type="button" onclick="history.back()" class="px-5 py-2 text-sm font-semibold rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors">← Geri Dön</button>
                <a href="/" class="px-5 py-2 text-sm font-semibold rounded-lg bg-brand-button text-white hover:brightness-110 transition-colors no-underline">Ana Sayfa</a>
            </div>
        </div>
    </body>
</html>
