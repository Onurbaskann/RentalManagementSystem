@model List<KiraTakip.Models.Entities.DocumentType>
@using System.Linq
@{
    bool enforceRequired = ViewData["EnforceRequired"] as bool? ?? true;
}

@if (!Model.Any()) { return; }

@{
    var zorunlular    = Model.Where(bt => bt.Required).ToList();
    var opsiyoneller  = Model.Where(bt => !bt.Required).ToList();
}

<div class="card mb-5">
    <div class="text-[15px] font-bold mb-5 pb-3 border-b border-slate-100 flex items-center gap-2">
        <span class="w-1.5 h-4 bg-indigo-600 rounded-full"></span>
        Belgeler
        @if (zorunlular.Any())
        {
            <span class="text-[11.5px] font-normal text-muted">(@zorunlular.Count zorunlu)</span>
        }
    </div>

    @if (zorunlular.Any())
    {
        <div class="flex flex-col gap-4">
            @foreach (var bt in zorunlular)
            {
                var acceptAttr = string.Join(",", bt.AllowedExtensions.Split(',').Select(e => "." + e.Trim()));
                <div>
                    <label class="form-label">
                        @bt.Name <span class="text-red-500 font-bold ml-0.5">*</span>
                        <span class="text-muted font-normal text-[11.5px] ml-1.5">(@bt.AllowedExtensions · maks. @bt.MaxSizeMb MB)</span>
                    </label>
                    @if (!string.IsNullOrEmpty(bt.Description))
                    {
                        <div class="text-xs text-muted mb-1.5">@bt.Description</div>
                    }
                    <input type="file" name="dosya_@bt.Id"
                           class="form-control text-xs file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-[11px] file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100"
                           data-belge-zorunlu="@(enforceRequired ? "1" : "0")" data-belge-ad="@bt.Name"
                           accept="@acceptAttr" />
                    @Html.ValidationMessage($"dosya_{bt.Id}", null, new { @class = "form-error" })
                </div>
            }
        </div>
    }

    @if (opsiyoneller.Any())
    {
        <div x-data="{ acik: false }" class="@(zorunlular.Any() ? "mt-5 pt-4 border-t border-slate-100" : "")">
            <button type="button" @@click="acik = !acik"
                    class="flex items-center gap-2 text-[13px] font-medium text-slate-600 hover:text-primary transition-colors select-none">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                     class="transition-transform duration-200" :class="acik ? 'rotate-90' : ''">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
                Ek Belgeler
                <span class="text-muted font-normal">— opsiyonel (@opsiyoneller.Count belge türü)</span>
            </button>

            <div x-show="acik" x-cloak class="flex flex-col gap-4 mt-4">
                @foreach (var bt in opsiyoneller)
                {
                    var acceptAttr = string.Join(",", bt.AllowedExtensions.Split(',').Select(e => "." + e.Trim()));
                    <div>
                        <label class="form-label">
                            @bt.Name
                            <span class="text-muted font-normal text-[11.5px] ml-1.5">(@bt.AllowedExtensions · maks. @bt.MaxSizeMb MB)</span>
                        </label>
                        @if (!string.IsNullOrEmpty(bt.Description))
                        {
                            <div class="text-xs text-muted mb-1.5">@bt.Description</div>
                        }
                        <input type="file" name="dosya_@bt.Id"
                               class="form-control text-xs file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-[11px] file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100"
                               accept="@acceptAttr" />
                    </div>
                }
            </div>
        </div>
    }
</div>

