@model KiraTakip.Web.Models.ViewModels.UnitCapacityPageViewModel
@{
    ViewData["Title"] = "Kontenjanı Değiştir";
    ViewData["UseCentralFeedback"] = true;
    var unitHash = Model.UnitId.ToHashId();
    var backUrl = $"/Property/Details/{Model.PropertyId.ToHashId()}";
}

<div class="max-w-[1100px] mx-auto">
    <div class="page-header">
        <a href="@backUrl" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">← @Model.PropertyName</a>
        <div class="page-title">Kontenjanı Değiştir</div>
        <div class="page-subtitle">@Model.UnitName</div>
    </div>

    @Html.AntiForgeryToken()

    <div x-data="unitCapacityPage()" x-init="init()" x-cloak>
        <div class="text-[13px] text-muted mb-4">
            Kontenjanı değiştirin, sözleşmelerin fiziksel alanlarını kontrol edin ve kaydedin. Kaydetmeden hiçbir değişiklik uygulanmaz.
        </div>

        <div asp-validation-summary="All" class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-3 text-[13px] mb-4"></div>

        <div class="card">
            <div class="text-[14px] font-bold mb-3">1. Kontenjan kaç kişi olsun?</div>
            <div class="flex flex-wrap items-center gap-4">
                <input id="newCapacity" type="number" min="1" step="1" aria-label="Kontenjan"
                       class="form-control !w-28 !text-[22px] font-bold text-center"
                       x-model.number="capacity" x-on:input="schedule()" />
                <div class="text-[13px] text-muted">
                    <span title="Ofisin m² olarak tamamı">Birim toplam alanı <b x-text="fmt(preview.unitArea) + ' m²'"></b></span>
                    · <span title="Aynı anda açık olabilecek sözleşme sayısı">Şu anki kontenjan <b x-text="preview.currentCapacity"></b></span>
                    · Azami kontenjan <b x-text="preview.maximumCapacity"></b>
                    · Kişi başı asgari fiziksel alan <b x-text="fmt(preview.minimumUsageArea) + ' m²'"></b>
                </div>
            </div>
            <div class="text-[13px] mt-3" title="Birim toplam alanının kontenjana bölünmesiyle bulunur">
                Kontenjan başına ideal alan: <b x-text="fmt(preview.norm) + ' m²'"></b>
            </div>
        </div>

        <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-3 text-[13px] mt-4" x-show="preview.errors.length > 0 || fetchError">
            <template x-for="e in preview.errors" :key="e.message"><div x-text="e.message"></div></template>
            <div x-show="fetchError" x-text="fetchError"></div>
        </div>

        <div class="card mt-4 !p-0" :class="loading ? 'opacity-60' : ''">
            <div class="text-[14px] font-bold px-3 pt-3">2. Sözleşmelerin fiziksel alanları</div>

            <div class="px-3 pt-3 space-y-3">
                <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-lg p-3 text-[13px] flex flex-wrap items-center justify-between gap-3" x-show="showShortage()">
                    <div>
                        <div class="font-semibold" x-text="'Boş kontenjanlar için ' + fmt(preview.normShortArea) + ' m² yer eksik.'"></div>
                        @if (Model.CanApply)
                        {
                            <div>Elle girilen fiziksel alanları orantılı küçülterek yer açabiliriz.</div>
                        }
                    </div>
                    @if (Model.CanApply)
                    {
                        <button type="button" class="btn btn-secondary" x-on:click="optimize()">Boş kontenjanlara yer aç</button>
                    }
                </div>
                <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-3 text-[13px] font-semibold" x-show="preview.minimumShort && !fetchError"
                     x-text="'Boş kontenjanlara kişi başı asgari fiziksel alan bile ayrılamıyor; ' + fmt(preview.minimumShortArea) + ' m² yer eksik.'"></div>
                <div class="bg-primary/5 border border-primary/10 rounded-lg p-3 text-[13px] text-primary" x-show="optimizeNotice" x-text="optimizeNotice"></div>
                <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-lg p-3 text-[13px]" x-show="shortfalls.length > 0"
                     x-text="'Fiziksel alanlar en küçük değerine indirildiği halde ' + fmt(shortfallTotal()) + ' m² yetmiyor.'"></div>
            </div>

            <div class="overflow-x-auto mt-3">
                <table class="w-full text-[13px]">
                    <thead>
                        <tr class="text-left text-[11.5px] text-muted border-b border-[var(--color-border)]">
                            <th class="px-3 py-2.5">Kiracı</th>
                            <th class="px-3 py-2.5 text-right" title="Sözleşmede kiralanan ve faturalanan m²; değişmez">Kiralanan alan</th>
                            <th class="px-3 py-2.5 text-right" title="Kiracının ofiste fiilen kapladığı m²">Şu anki fiziksel alan</th>
                            <th class="px-3 py-2.5 text-right" title="Kiracının ofiste fiilen kapladığı m²">Yeni fiziksel alan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="row in preview.rows" :key="row.id">
                            <tr class="border-b border-[var(--color-border)] last:border-0 align-top">
                                <td class="px-3 py-2.5">
                                    <div class="font-medium">
                                        <span x-text="row.tenant"></span>
                                        <span x-show="row.status !== 'Aktif'" class="badge text-[10.5px] ml-1" x-text="row.status"></span>
                                    </div>
                                    <div class="text-[11.5px] text-muted" x-text="row.leaseNo + ' · ' + row.start + ' – ' + row.end"></div>
                                    <div x-show="rowNote(row)" class="text-[12px] mt-1" :class="rowNote(row) && rowNote(row).red ? 'text-red-700' : 'text-amber-700'" x-text="rowNote(row) ? rowNote(row).text : ''"></div>
                                </td>
                                <td class="px-3 py-2.5 text-right" x-text="row.rentedArea == null ? '—' : fmt(row.rentedArea) + ' m²'"></td>
                                <td class="px-3 py-2.5 text-right whitespace-nowrap">
                                    <span x-text="fmt(row.currentArea) + ' m²'"></span>
                                    <span x-show="row.currentMode" class="badge text-[10.5px] ml-1" x-text="row.currentMode"></span>
                                </td>
                                <td class="px-3 py-2.5 text-right">
                                    <template x-if="row.editable">
                                        <div class="inline-flex items-center gap-2 justify-end">
                                            <span x-show="suggested.includes(row.id)" class="badge badge-bireysel text-[10.5px]">Önerildi</span>
                                            <span x-show="row.manual && !suggested.includes(row.id)" class="badge badge-bireysel text-[10.5px]">Elle girilen</span>
                                            <input type="number" min="0" step="0.01" class="form-control !w-28 text-right"
                                                   :value="row.proposedArea"
                                                   x-on:change="setOverride(row, $event.target.value)" />
                                            <button type="button" class="text-[12px] text-muted hover:text-primary" title="Otomatiğe döndür"
                                                    x-show="overrides[row.id] !== undefined" x-on:click="clearOverride(row)">↺</button>
                                        </div>
                                    </template>
                                    <template x-if="!row.editable">
                                        <span class="text-muted" x-text="row.proposedMode ? fmt(row.proposedArea) + ' m²' : '—'"></span>
                                    </template>
                                    <div x-show="row.error" x-text="row.error" class="text-[12px] text-red-700 mt-1"></div>
                                </td>
                            </tr>
                        </template>
                        <tr x-show="preview.rows.length === 0">
                            <td colspan="4" class="px-3 py-6 text-center text-muted">Bu birimde etkilenen sözleşme yok.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card sticky bottom-0 z-10 mt-4 shadow-lg">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="text-[13px]">
                    <div>
                        Toplam fiziksel alan <b x-text="fmt(preview.peak) + ' / ' + fmt(preview.unitArea) + ' m²'"></b>
                        · Boş fiziksel alan <b :class="preview.unitArea - preview.peak < 0 ? 'text-red-700' : ''" x-text="fmt(preview.unitArea - preview.peak) + ' m²'"></b>
                        · Boş kontenjan <b x-text="preview.freeSlots"></b>
                    </div>
                    <div class="text-[11.5px] text-muted">Aynı anda geçerli sözleşmelere göre hesaplanır.</div>
                </div>
                <div class="flex items-center gap-2">
                    <a href="@backUrl" class="btn btn-secondary">Vazgeç</a>
                    @if (Model.CanApply)
                    {
                        <form asp-action="Apply" asp-route-id="@unitHash" method="post">
                            <input type="hidden" name="NewCapacity" :value="capacity" />
                            <input type="hidden" name="ExpectedHash" :value="preview.hash" />
                            <template x-for="(value, key) in overrides" :key="key">
                                <input type="hidden" :name="'Overrides[' + key + ']'" :value="value" />
                            </template>
                            <button type="submit" class="btn btn-primary" :disabled="!canSave()">Kaydet</button>
                        </form>
                    }
                </div>
            </div>
            @if (Model.CanApply)
            {
                <div class="text-[12px] text-muted text-right mt-1" x-show="!canSave()" x-text="saveBlocker()"></div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function unitCapacityPage() {
            return {
                preview: @Html.Raw(Json.Serialize(Model.Preview)),
                capacity: @Model.Preview.NewCapacity,
                overrides: @Html.Raw(Json.Serialize(Model.Overrides)),
                loading: false,
                fetchError: '',
                optimizeNotice: '',
                shortfalls: [],
                suggested: [],
                areaOverflowCode: '@KiraTakip.Models.Dtos.Property.CapacityPlanCodes.AreaOverflow',
                timer: null,
                sequence: 0,
                previewUrl: '/UnitCapacity/@unitHash/Preview',
                init() {
                    const known = new Set(this.preview.rows.map(r => r.id));
                    Object.keys(this.overrides).forEach(k => { if (!known.has(k)) delete this.overrides[k]; });
                },
                fmt(value) {
                    return Number(value || 0).toLocaleString('tr-TR', { maximumFractionDigits: 2 });
                },
                canSave() {
                    return !this.loading
                        && !this.fetchError
                        && this.capacity > 0
                        && !this.preview.hasErrors
                        && !this.preview.rows.some(r => r.error);
                },
                saveBlocker() {
                    if (!(this.capacity > 0)) return 'Geçerli bir kontenjan girin.';
                    if (this.loading) return 'Hesaplanıyor…';
                    return 'Kaydetmek için kırmızı uyarıdaki sorunu düzeltin.';
                },
                showShortage() {
                    return this.preview.normShortArea != null
                        && this.canOptimize()
                        && !this.optimizeNotice
                        && this.shortfalls.length === 0;
                },
                shortfallTotal() {
                    return Math.max(0, ...this.shortfalls.map(s => s.missing));
                },
                rowNote(row) {
                    const overflow = this.preview.errors.some(e => e.code === this.areaOverflowCode && e.rowIds.includes(row.id));
                    if (overflow) return { red: true, text: 'Bu sözleşme başladığında birim alanı yetmiyor.' };
                    const short = this.preview.warnings.some(w => w.rowIds.includes(row.id))
                        || this.shortfalls.some(s => s.rowIds.includes(row.id));
                    if (short) return { red: false, text: 'Bu sözleşme başladığında boş kontenjanlara yer kalmıyor.' };
                    return null;
                },
                schedule() {
                    clearTimeout(this.timer);
                    this.sequence++;
                    this.loading = true;
                    this.timer = setTimeout(() => this.refresh(), 400);
                },
                setOverride(row, raw) {
                    const value = parseFloat(raw);
                    if (isNaN(value) || value < 0) {
                        delete this.overrides[row.id];
                    } else {
                        this.overrides[row.id] = value;
                    }
                    this.suggested = this.suggested.filter(id => id !== row.id);
                    this.schedule();
                },
                clearOverride(row) {
                    delete this.overrides[row.id];
                    this.suggested = this.suggested.filter(id => id !== row.id);
                    this.schedule();
                },
                canOptimize() {
                    return !this.loading
                        && !this.fetchError
                        && this.capacity > 0
                        && !this.preview.countExceeded;
                },
                async requestPreview(optimize) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                    const response = await fetch(this.previewUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ newCapacity: Number(this.capacity), overrides: this.overrides, optimize: optimize })
                    });
                    if (!response.ok) {
                        throw new Error((await response.text()) || 'Önizleme alınamadı.');
                    }
                    return await response.json();
                },
                async optimize() {
                    if (!this.canOptimize()) return;
                    clearTimeout(this.timer);
                    this.loading = true;
                    this.optimizeNotice = '';
                    this.shortfalls = [];
                    const current = ++this.sequence;
                    let result;
                    try {
                        result = await this.requestPreview(true);
                    } catch (e) {
                        if (current === this.sequence) {
                            this.fetchError = e.message || 'Önizleme alınamadı.';
                            this.loading = false;
                        }
                        return;
                    }
                    if (current !== this.sequence) return;
                    const optimization = result.optimization;
                    if (!optimization) {
                        this.optimizeNotice = 'Şu anki durumda yer açılamıyor. Önce kırmızı uyarıdaki sorunu düzeltin.';
                        this.loading = false;
                        return;
                    }
                    if (!optimization.isNeeded) {
                        this.optimizeNotice = 'Boş kontenjanlar için yeterli yer var; değişiklik gerekmiyor.';
                        this.loading = false;
                        return;
                    }
                    optimization.suggestions.forEach(s => { this.overrides[s.id] = s.area; });
                    if (await this.refresh()) {
                        this.shortfalls = optimization.shortfalls;
                        this.suggested = optimization.suggestions.map(s => s.id);
                        if (this.suggested.length > 0) {
                            this.optimizeNotice = this.suggested.length + ' sözleşmenin fiziksel alanı küçültüldü. Kaydetmeden uygulanmaz; satırdaki ↺ ile geri alabilirsiniz.';
                        }
                    }
                },
                async refresh() {
                    if (!(this.capacity > 0)) { this.loading = false; return false; }
                    const current = ++this.sequence;
                    this.optimizeNotice = '';
                    this.shortfalls = [];
                    try {
                        const result = await this.requestPreview(false);
                        if (current !== this.sequence) return false;
                        this.preview = result;
                        this.fetchError = '';
                        const known = new Set(this.preview.rows.map(r => r.id));
                        Object.keys(this.overrides).forEach(k => { if (!known.has(k)) delete this.overrides[k]; });
                        return true;
                    } catch (e) {
                        if (current === this.sequence) this.fetchError = e.message || 'Önizleme alınamadı.';
                        return false;
                    } finally {
                        if (current === this.sequence) this.loading = false;
                    }
                }
            };
        }
    </script>
}
