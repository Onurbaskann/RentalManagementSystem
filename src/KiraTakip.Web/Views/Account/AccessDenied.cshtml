@{
    ViewData["Title"] = "Erişim Reddedildi";
}

<div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mb-5">
        <svg class="stroke-danger" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
        </svg>
    </div>
    <h1 class="font-display text-[28px] font-bold text-primary mb-2">Erişim Reddedildi</h1>
    <p class="text-sm text-muted max-w-[360px] mb-6">
        Bu sayfaya erişim için gerekli yetkiye sahip değilsiniz.
        Farklı bir hesapla giriş yapmayı deneyin veya yönetici ile iletişime geçin.
    </p>
    <div class="flex gap-3">
        <a href="/" class="btn btn-primary">Anasayfaya Dön</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-secondary">Çıkış Yap</button>
        </form>
    </div>
</div>
