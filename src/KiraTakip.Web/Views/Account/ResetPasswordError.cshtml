@{
    Layout = null;
    ViewData["Title"] = "Geçersiz Bağlantı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UniTeknopark — Geçersiz Bağlantı</title>
    @await Html.PartialAsync("_BrandHead")
</head>
<body class="min-h-screen bg-canvas flex items-center justify-center p-4">
    <div class="w-full max-w-md text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-red-100 mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="stroke-danger" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>
        <h1 class="text-xl font-semibold text-primary mb-2 font-display">Geçersiz Sıfırlama Bağlantısı</h1>
        <p class="text-slate-500 text-sm mb-6">@(ViewBag.ErrorMessage ?? "Bu şifre sıfırlama bağlantısı geçersiz veya süresi dolmuş.")</p>
        <a href="/Account/ForgotPassword" class="text-primary hover:text-navy-mid text-sm font-medium">Yeni sıfırlama bağlantısı iste</a>
    </div>
</body>
</html>

