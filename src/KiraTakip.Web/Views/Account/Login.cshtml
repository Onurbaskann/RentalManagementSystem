@model KiraTakip.Web.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
    string? returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UniTeknopark — Giriş</title>
    @await Html.PartialAsync("_BrandHead")
</head>
<body class="min-h-screen bg-canvas flex items-center justify-center p-4 selection:bg-primary-light selection:text-primary">
    <div class="w-full max-w-md">
        <!-- Logo / Marka -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-accent mb-4">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-primary font-display">UniTeknopark</h1>
            <p class="text-slate-500 text-sm mt-1">Yönetim Paneli</p>
        </div>

        <!-- Login Kartı -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
            <h2 class="text-lg font-semibold text-primary mb-1">Hesabınıza giriş yapın</h2>
            <p class="text-sm text-slate-500 mb-6">Devam etmek için e-posta ve şifrenizi girin.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm mb-5">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Login" method="post">
                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">E-posta</label>
                    <input asp-for="Email" type="email" autocomplete="email"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-sm text-primary bg-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-all"
                        placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-5">
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">Şifre</label>
                    <input asp-for="Password" type="password" autocomplete="current-password"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-sm text-primary bg-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-all"
                        placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between mb-6">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input asp-for="RememberMe" type="checkbox"
                            class="w-4 h-4 rounded border-slate-300 accent-primary" />
                        <span class="text-sm text-slate-600">Beni hatırla</span>
                    </label>
                    <a href="/Account/ForgotPassword" class="text-sm text-primary hover:text-navy-mid font-medium">Şifremi unuttum</a>
                </div>

                <button type="submit"
                    class="w-full bg-brand-button hover:brightness-110 text-white font-semibold text-sm py-2.5 px-4 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2">
                    Giriş Yap
                </button>
            </form>
        </div>


    </div>
</body>
</html>

