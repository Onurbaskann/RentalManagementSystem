@model KiraTakip.Web.Models.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Şifre Sıfırla";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UniTeknopark — Şifre Sıfırla</title>
    @await Html.PartialAsync("_BrandHead")
</head>
<body class="min-h-screen bg-canvas flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-accent mb-4">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-primary font-display">UniTeknopark</h1>
            <p class="text-slate-500 text-sm mt-1">Yeni Şifre Belirle</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
            @if (ViewBag.IsSuccess == true)
            {
                <div class="text-center py-4">
                    <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-emerald-100 mb-3">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="stroke-success" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <h2 class="text-base font-semibold text-primary mb-2">Şifreniz Güncellendi</h2>
                    <p class="text-sm text-slate-500">Yeni şifrenizle giriş yapabilirsiniz.</p>
                    <a href="/Account/Login" class="mt-4 inline-block text-sm text-primary hover:text-navy-mid font-medium">Giriş Yap</a>
                </div>
            }
            else
            {
                <h2 class="text-lg font-semibold text-primary mb-1">Yeni Şifre Belirle</h2>
                <p class="text-sm text-slate-500 mb-6">Yeni şifrenizi girin.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm mb-5">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Yeni Şifre <span class="text-red-500">*</span></label>
                        <input asp-for="Password" type="password" autocomplete="new-password"
                            class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-sm text-primary bg-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-all"
                            placeholder="En az 6 karakter, büyük/küçük harf, rakam ve özel karakter" />
                        <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Şifre Tekrar <span class="text-red-500">*</span></label>
                        <input asp-for="PasswordConfirm" type="password" autocomplete="new-password"
                            class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-sm text-primary bg-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-all"
                            placeholder="••••••••" />
                        <span asp-validation-for="PasswordConfirm" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <button type="submit"
                        class="w-full bg-brand-button hover:brightness-110 text-white font-semibold text-sm py-2.5 px-4 rounded-lg transition-colors">
                        Şifremi Güncelle
                    </button>
                </form>
            }
        </div>
    </div>
</body>
</html>

