@model KiraTakip.Models.Dtos.TenantDetailsDto
@using System.Globalization
@{
    Layout = "_KiraciLayout";
    ViewData["Title"] = "Firma Profili";
    ViewData["UseCentralFeedback"] = true;
    var trCulture = new CultureInfo("tr-TR");
    var profileInitials = string.Concat(Model.Name
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpper(part[0], trCulture)));
}

<div class="page-header">
    <div>
        <div class="page-title">Firma Profili</div>
        <div class="page-subtitle">Firmanıza ait kayıt bilgileri</div>
    </div>
</div>

<!-- Ana Kart: Firma Başlığı -->
<div class="card mb-4">
    <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-full bg-primary text-white flex items-center justify-center text-[20px] font-bold flex-shrink-0">
            @profileInitials
        </div>
        <div class="flex-1 min-w-0">
            <div class="font-serif text-[24px] font-bold leading-tight">@Model.Name</div>
            <div class="mt-1.5 flex flex-wrap gap-1.5 items-center">
                <span class="badge badge-kurumsal">Tüzel Kişi</span>
                @if (!string.IsNullOrEmpty(Model.TenantCategoryName))
                {
                    <span class="badge badge-bos">@Model.TenantCategoryName</span>
                }
                @if (!string.IsNullOrEmpty(Model.SectorName))
                {
                    <span class="badge badge-bos">@Model.SectorName</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.TenantNo))
            {
                <div class="mt-2 text-[12.5px] text-muted">
                    Kiracı No: <span class="font-mono font-semibold">@Model.TenantNo</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- 2 Kolonlu Detay -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Genel & Vergi -->
    <div class="card">
        <div class="card-title">Genel Bilgiler</div>
        <div class="mt-3 grid grid-cols-1 gap-0">
            @{
                void Row(string label, string? value, bool mono = false) {
                    <div class="px-1 py-2.5 border-b border-[var(--color-border)] last:border-0">
                        <div class="detail-label">@label</div>
                        <div class="text-sm font-medium @(mono ? "font-mono" : "")">@(string.IsNullOrEmpty(value) ? "—" : value)</div>
                    </div>
                }
                Row("Firma Adı", Model.Name);
                Row("Ticaret Sicil No", Model.TradeRegistryNo, true);
                Row("Vergi No", Model.TaxNo, true);
                Row("Vergi Dairesi", Model.TaxOffice);
                Row("MERSİS No", Model.MersisNo, true);
                Row("Kayıt Tarihi", Model.RegistrationDate.ToString("dd MMMM yyyy", trCulture));
            }
        </div>
    </div>

    <!-- İletişim & Adres -->
    <div class="card">
        <div class="card-title">İletişim Bilgileri</div>
        <div class="mt-3 grid grid-cols-1 gap-0">
            @{
                Row("Telefon", Model.Phone);
                Row("E-posta", Model.Email);
                Row("Adres", Model.Address);
            }
        </div>
    </div>
</div>

<div class="mt-5 text-[12px] text-muted italic">
    Firma bilgilerinizde güncelleme yapılması gerekiyorsa lütfen yönetici ile iletişime geçin.
</div>

