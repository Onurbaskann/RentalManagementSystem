@* Sözleşme tarifesi satırları. Alpine kapsamında `readOnly`, `isRentFree`, `sourceLabel()` bulunmalıdır.
   ViewData: ItemsExpr (satır dizisi), NamePrefix (JS şablon dizesi: ad öneki), AmountExpr (tutar ifadesi), AreaExpr (m² ifadesi). *@
@{
    string itemsExpr = ViewData["ItemsExpr"] as string ?? "lineItems";
    string namePrefix = ViewData["NamePrefix"] as string ?? "LeaseLineItems";
    string amountExpr = ViewData["AmountExpr"] as string ?? "amount(item)";
    string areaExpr = ViewData["AreaExpr"] as string ?? "unitArea()";
}
<template x-for="(item, index) in @itemsExpr" :key="item.chargeTypeId">
    <div class="bg-slate-50/50 border border-[var(--color-border)] rounded-xl p-4"
         x-show="!isRentFree || String(item.chargeTypeCode || '').toUpperCase() !== 'KIRA'">
        <div class="flex justify-between gap-2 mb-3">
            <strong class="text-sm text-slate-800" x-text="item.chargeTypeName"></strong>
            <span class="text-[10px] px-2 py-0.5 rounded font-bold bg-slate-800 text-white" x-text="sourceLabel(item.sourceType)"></span>
        </div>
        <div class="grid grid-cols-3 gap-2 items-end">
            <div>
                <label class="text-[10px] text-muted font-bold mb-1 block" x-text="item.calculationMethod == 2 ? '₺ / m²' : 'Tutar (₺)'"></label>
                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                       x-model.number="item.unitValue" @@input="item.isUserModified = true" :disabled="readOnly" />
            </div>
            <div>
                <label class="text-[10px] text-muted font-bold mb-1 block">Yöntem</label>
                <select class="form-control form-control-sm" x-model.number="item.calculationMethod"
                    @@change="item.isUserModified = true" :disabled="readOnly">
                    <option value="1">Sabit</option>
                    <option value="2">m²</option>
                </select>
            </div>
            <div>
                <label class="text-[10px] text-muted font-bold mb-1 block">KDV (%)</label>
                <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm"
                       x-model.number="item.vatRate" @@input="item.isUserModified = true" :disabled="readOnly" />
            </div>
        </div>
        <div class="mt-2 text-xs text-indigo-700" x-show="item.calculationMethod == 2"
             x-text="`${Number(item.unitValue || 0).toLocaleString('tr-TR')} ₺/m² × ${@(Html.Raw(areaExpr))} m² = ${@(Html.Raw(amountExpr)).toLocaleString('tr-TR')} ₺`"></div>

        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].ChargeTypeId`" :value="item.chargeTypeId" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].ChargeTypeName`" :value="item.chargeTypeName" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].ChargeTypeCode`" :value="item.chargeTypeCode" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].Behavior`" :value="item.behavior" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].UnitValue`" :value="item.unitValue" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].CalculationMethod`" :value="item.calculationMethod" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].Amount`" :value="@(Html.Raw(amountExpr))" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].DefaultAmount`" :value="item.defaultAmount" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].DefaultUnitValue`" :value="item.defaultUnitValue" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].VatRate`" :value="item.vatRate" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].IsUserModified`" :value="item.isUserModified" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].IsRateFound`" :value="item.isRateFound" />
        <input type="hidden" :name="`@(Html.Raw(namePrefix))[${index}].SourceType`" :value="item.sourceType" />
    </div>
</template>
