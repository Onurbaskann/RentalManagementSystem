@model KiraTakip.Web.Models.ViewModels.LeaseGroupDetailViewModel
@using KiraTakip.Models.Enums
@using KiraTakip.Web.Extensions
@{
    var group = Model.Group;
    ViewData["Title"] = "Paylaşımlı Sözleşme Grubu";
    ViewData["UseCentralFeedback"] = true;
    bool areaMatches = Math.Abs(Model.TotalArea - group.UnitArea) < 0.005m;
}

<div class="max-w-[1050px] mx-auto" x-data="{ approveOpen: false, resubmitOpen: false, deleteOpen: false }">
    <div class="page-header flex flex-wrap items-start justify-between gap-3">
        <div>
            <a href="@Url.Action("Index", "Lease")" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary">← Sözleşmeler</a>
            <div class="page-title">Paylaşımlı Sözleşme Grubu</div>
            <div class="page-subtitle">@group.PropertyName — @group.UnitName • Başvuru sahibi: @group.OwnerDisplayName</div>
        </div>
        @if (Model.CanEdit || Model.CanResubmit || Model.CanApprove || Model.CanDelete)
        {
            <div class="flex flex-wrap gap-2">
                @if (Model.CanEdit)
                {
                    <a href="@Url.Action("EditGroup", "Lease", new { id = group.GroupId })" class="btn btn-secondary">Düzenle</a>
                }
                @if (Model.CanResubmit)
                {
                    <button type="button" class="btn btn-secondary" @@click="resubmitOpen = true">Yeniden Gönder</button>
                }
                @if (Model.CanApprove)
                {
                    <button type="button" class="btn btn-primary" @@click="approveOpen = true">Onayla</button>
                }
                @if (Model.CanDelete)
                {
                    <button type="button" class="btn btn-danger" @@click="deleteOpen = true">Taslağı Sil</button>
                }
            </div>
        }
    </div>

    @if (Model.HasRevisionRequested)
    {
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-rose-950 text-sm">
            <div class="font-bold">Gruptaki en az bir sözleşme için revizyon istendi.</div>
            <div class="mt-1">Revizyon tamamlanıp grup yeniden gönderilmeden grup onaylanamaz. m² payları yalnız grup düzenleme ekranından değiştirilir.</div>
        </div>
    }
    else if (Model.IsPending)
    {
        <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-950 text-sm">
            <div class="font-bold">Grup onay bekliyor.</div>
            <div class="mt-1">Onayda tüm sözleşmeler birlikte aktifleşir ve tahakkuklar oluşturulur.</div>
        </div>
    }

    <div class="mb-4 grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
        <div class="rounded-lg border border-slate-200 bg-white p-3"><span class="text-muted block">Süre</span><strong>@group.StartDate.ToString("dd.MM.yyyy") – @group.EndDate.ToString("dd.MM.yyyy")</strong></div>
        <div class="rounded-lg border border-slate-200 bg-white p-3"><span class="text-muted block">Vade</span><strong>@(group.DueDateRuleType == DueDateRuleType.FixedDayOfMonth ? $"Ayın {group.DueDay}. günü" : $"Dönem başı + {group.DueDay} gün")</strong></div>
        <div class="rounded-lg border border-slate-200 bg-white p-3"><span class="text-muted block">Birim alanı / Σ m²</span><strong class="@(areaMatches ? "" : "text-amber-700")">@group.UnitArea.M2() / @Model.TotalArea.M2()</strong></div>
        <div class="rounded-lg border border-slate-200 bg-white p-3"><span class="text-muted block">Oluşturma</span><strong>@group.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></div>
    </div>

    @if (group.IsRentFree)
    {
        <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-900">Bedelsiz sözleşme: kira bedeli tahakkuku oluşturulmaz.</div>
    }
    @if (!string.IsNullOrWhiteSpace(group.Description))
    {
        <div class="mb-4 rounded-lg border border-slate-200 bg-white p-3 text-sm whitespace-pre-wrap">@group.Description</div>
    }

    <div class="card">
        <div class="text-[15px] font-bold mb-4">Sözleşmeler (@group.Members.Count)</div>
        <div class="space-y-3">
            @foreach (var member in group.Members)
            {
                bool isPending = member.Status is LeaseStatus.Draft or LeaseStatus.RevisionRequested;
                string statusLabel = member.Status switch
                {
                    LeaseStatus.Draft => "Onay Bekliyor",
                    LeaseStatus.RevisionRequested => "Revizyon İstendi",
                    LeaseStatus.Active => "Aktif",
                    LeaseStatus.Ended => "Sona Erdi",
                    LeaseStatus.Terminated => "Feshedildi",
                    _ => member.Status.ToString()
                };
                string statusCls = member.Status switch
                {
                    LeaseStatus.RevisionRequested => "bg-rose-100 text-rose-800",
                    LeaseStatus.Draft => "bg-amber-100 text-amber-800",
                    LeaseStatus.Active => "bg-emerald-100 text-emerald-800",
                    _ => "bg-slate-100 text-slate-700"
                };
                string memberUrl = isPending
                    ? Url.Action("Draft", "Lease", new { id = member.LeaseId })!
                    : Url.Action("Details", "Lease", new { id = member.LeaseId })!;
                <div class="rounded-lg border border-slate-200 p-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <strong class="text-sm">@member.LeaseNo</strong>
                            <span class="text-sm"> — @member.TenantName</span>
                            <div class="text-xs text-muted mt-0.5">@member.Area.M2()</div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold @statusCls">@statusLabel</span>
                            <a href="@memberUrl" class="btn btn-sm btn-secondary">@(isPending ? "Taslak Ekranı" : "Sözleşme")</a>
                        </div>
                    </div>
                    @if (member.Status == LeaseStatus.RevisionRequested && member.LatestRevision != null)
                    {
                        <div class="mt-2 rounded-md bg-rose-50 border border-rose-200 p-2 text-xs text-rose-900">
                            <div class="whitespace-pre-wrap">@member.LatestRevision.Explanation</div>
                            <div class="mt-1 text-rose-700">@member.LatestRevision.ActorDisplayName · @member.LatestRevision.ActionDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.CanApprove)
    {
        <div x-show="approveOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" @@keydown.escape.window="approveOpen = false">
            <form asp-action="ApproveGroup" method="post" class="card w-full max-w-lg" x-on:submit="if ($el.dataset.submitting) $event.preventDefault(); else $el.dataset.submitting = '1'">
                @Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@group.GroupId" />
                <div class="text-lg font-bold">Grubu Onayla</div><p class="text-sm text-muted my-3">Onayla birlikte gruptaki tüm sözleşmeler aktifleşir ve tahakkuklar oluşturulur.</p>
                <textarea name="Explanation" maxlength="1000" class="form-control" rows="3" placeholder="Onay açıklaması (opsiyonel)"></textarea>
                <div class="flex justify-end gap-2 mt-4"><button type="button" class="btn btn-secondary" @@click="approveOpen = false">Vazgeç</button><button type="submit" class="btn btn-primary">Onayla</button></div>
            </form>
        </div>
    }

    @if (Model.CanResubmit)
    {
        <div x-show="resubmitOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" @@keydown.escape.window="resubmitOpen = false">
            <form asp-action="ResubmitGroup" method="post" class="card w-full max-w-lg" x-on:submit="if ($el.dataset.submitting) $event.preventDefault(); else $el.dataset.submitting = '1'">
                @Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@group.GroupId" />
                <div class="text-lg font-bold">Grubu Yeniden Gönder</div><p class="text-sm text-muted my-3">Revizyon istenen sözleşmeler onay bekleyen taslağa döner.</p>
                <textarea name="Explanation" maxlength="1000" class="form-control" rows="3" placeholder="Açıklama (opsiyonel)"></textarea>
                <div class="flex justify-end gap-2 mt-4"><button type="button" class="btn btn-secondary" @@click="resubmitOpen = false">Vazgeç</button><button type="submit" class="btn btn-primary">Yeniden Gönder</button></div>
            </form>
        </div>
    }

    @if (Model.CanDelete)
    {
        <div x-show="deleteOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" @@keydown.escape.window="deleteOpen = false">
            <form asp-action="DeleteGroupDraft" method="post" class="card w-full max-w-lg" x-data="{ reason: '' }">
                @Html.AntiForgeryToken()<input type="hidden" name="GroupId" value="@group.GroupId" />
                <div class="text-lg font-bold text-red-700">Grup Taslağını Sil</div><p class="text-sm text-muted my-3">Gruptaki tüm taslak sözleşmeler pasif hale getirilir; inceleme geçmişi denetim amacıyla korunur.</p>
                <textarea name="Explanation" x-model="reason" required maxlength="1000" class="form-control" rows="5" placeholder="Silme açıklaması (zorunlu)"></textarea>
                <div class="text-xs text-muted text-right mt-1" x-text="`${reason.length}/1000`"></div>
                <span class="form-error">@Html.ValidationMessage("Explanation")</span>
                <div class="flex justify-end gap-2 mt-4"><button type="button" class="btn btn-secondary" @@click="deleteOpen = false">Vazgeç</button><button type="submit" class="btn btn-danger">Taslağı Sil</button></div>
            </form>
        </div>
    }
</div>
