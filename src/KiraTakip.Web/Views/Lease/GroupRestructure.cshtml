@model KiraTakip.Web.Models.ViewModels.LeaseGroupRestructureViewModel
@using KiraTakip.Authorization
@using KiraTakip.Web.Extensions
@{
    ViewData["Title"] = "Grubu Yeniden Yapılandır";
    ViewData["UseCentralFeedback"] = true;
    string backUrl = Url.Action(nameof(KiraTakip.Web.Controllers.LeaseController.Group), "Lease", new { id = Model.GroupId })!;
    string[] reasons = ["Kiracı talebi", "Mal sahibi talebi", "Kira ödeme ihlali", "Erken çıkış", "Anlaşmazlık"];
    bool otherReason = !string.IsNullOrEmpty(Model.TerminationReason) && !reasons.Contains(Model.TerminationReason);
    string reasonChoice = otherReason ? "Diğer" : Model.TerminationReason;
    bool startManual = Model.StartDate.Date != Model.TerminationDate.Date.AddDays(1);
    var scriptViewData = new ViewDataDictionary(ViewData)
    {
        ["RestructureTerminationDate"] = Model.TerminationDate.ToString("yyyy-MM-dd"),
        ["RestructureStartManual"] = startManual
    };
}

<div class="max-w-[1000px] mx-auto">
    <div class="page-header">
        <a href="@backUrl" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← Gruba Dön</a>
        <div class="page-title">Grubu Yeniden Yapılandır</div>
        <div class="page-subtitle">Mevcut grubun sözleşmeleri fesih tarihiyle feshedilir; yeni kiracı ve m² payları ile onay bekleyen yeni bir grup açılır.</div>
    </div>

    <div x-data="leaseGroupForm()" x-init="init()" x-cloak>
        <form action="@Url.Content("~/Lease/RestructureGroup")" method="post" asp-antiforgery="true" id="leaseGroupRestructureForm"
              asp-form-write-permission="@PermissionCatalog.Lease.RestructureGroup"
              x-on:submit="if (!confirm('Mevcut grubun tüm sözleşmeleri feshedilecek. Bu işlem geri alınamaz. Devam edilsin mi?')) $event.preventDefault(); else submitting = true">
            <div asp-validation-summary="All" class="form-error mb-3"></div>
            <input type="hidden" name="GroupId" value="@Model.GroupId" />

            <div class="card">
                <div class="text-[15px] font-bold mb-3 pb-3 border-b border-[var(--color-border)] flex items-center gap-2">
                    <span class="w-1.5 h-4 bg-red-600 rounded-full"></span><span>Mevcut Grubun Feshi</span>
                </div>
                <div class="bg-primary/5 border border-primary/10 rounded-lg p-3 text-[13.5px] font-medium text-primary mb-4">
                    @Model.UnitName • @Model.UnitArea.M2()
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5" x-data="{ choice: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(reasonChoice))', other: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(otherReason ? Model.TerminationReason : ""))' }">
                    <div class="form-group mb-0">
                        <label class="form-label">Fesih Tarihi *</label>
                        <input type="date" name="TerminationDate" class="form-control" x-model="terminationDate" required />
                        <span asp-validation-for="TerminationDate" class="form-error"></span>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Fesih Nedeni *</label>
                        <select class="form-control" x-model="choice">
                            <option value="">— Seçiniz —</option>
                            @foreach (var reason in reasons)
                            {
                                <option value="@reason">@reason</option>
                            }
                            <option value="Diğer">Diğer</option>
                        </select>
                        <span asp-validation-for="TerminationReason" class="form-error"></span>
                    </div>
                    <div class="form-group mb-0 md:col-span-2" x-show="choice === 'Diğer'" x-cloak>
                        <label class="form-label">Nedeni belirtin *</label>
                        <input type="text" class="form-control" maxlength="500" x-model="other" placeholder="Fesih nedenini açıklayın" />
                    </div>
                    <input type="hidden" name="TerminationReason" :value="choice === 'Diğer' ? other : choice" />
                    <div class="form-group mb-0 md:col-span-2">
                        <label class="form-label">Fesih Açıklaması</label>
                        <textarea asp-for="TerminationDescription" class="form-control" rows="2" placeholder="Opsiyonel açıklama"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="text-[15px] font-bold mb-5 pb-3 border-b border-[var(--color-border)] flex items-center gap-2">
                    <span class="w-1.5 h-4 bg-primary rounded-full"></span><span>Yeni Grup: Süre ve Vade (tüm sözleşmeler için ortak)</span>
                </div>
                <input type="hidden" name="UnitId" value="@Model.UnitId" />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                    <div class="form-group mb-0">
                        <label class="form-label">Başlangıç Tarihi *</label>
                        <input type="date" name="StartDate" class="form-control" x-model="startDate" :min="minStart()"
                               @@input="startManual = true" required />
                        <div class="text-xs text-muted mt-1">En erken fesih tarihini izleyen gün.</div>
                        <span asp-validation-for="StartDate" class="form-error"></span>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Bitiş Tarihi *</label>
                        <input type="date" name="EndDate" class="form-control" x-model="endDate" :min="startDate" required />
                        <span asp-validation-for="EndDate" class="form-error"></span>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mt-3.5">
                    <div class="form-group mb-0">
                        <label class="form-label">Vade Kuralı</label>
                        <select asp-for="DueDateRuleType" class="form-control" x-model.number="dueDateRuleType">
                            <option value="1">Sabit Ay Günü (ayın N'i)</option>
                            <option value="2">Dönem Başı + N Gün</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Vade Günü *</label>
                        <input asp-for="DueDay" type="number" class="form-control" x-model.number="dueDay" />
                        <span asp-validation-for="DueDay" class="form-error"></span>
                    </div>
                </div>
                <label class="flex items-start gap-3 cursor-pointer rounded-lg border border-emerald-200 bg-emerald-50 p-3 mt-4">
                    <input asp-for="IsRentFree" type="checkbox" class="mt-1" x-model="isRentFree" />
                    <span>
                        <strong class="block text-sm text-emerald-900">Bedelsiz sözleşme</strong>
                        <span class="block text-xs text-emerald-800 mt-1">Kira bedeli tahakkuku oluşturulmaz. Depozito ve diğer borç kalemleri tanımlıysa uygulanmaya devam eder.</span>
                    </span>
                </label>
            </div>

            @await Html.PartialAsync("_LeaseGroupMembersCard", Model.Tenants)

            <div class="card mt-4">
                <div class="form-group mb-0">
                    <label class="form-label">Yeni Grup Açıklaması</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Gruba ait ek açıklama..."></textarea>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button type="submit" class="btn btn-danger px-6 flex items-center gap-2"
                        asp-permission="@PermissionCatalog.Lease.RestructureGroup" :disabled="submitting">
                    <span x-text="submitting ? 'Kaydediliyor…' : 'Feshet ve Yeni Grup Aç'"></span>
                </button>
                <a href="@backUrl" class="btn btn-secondary px-6">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_LeaseGroupFormScripts", Model.ToFormModel(), scriptViewData)
}
