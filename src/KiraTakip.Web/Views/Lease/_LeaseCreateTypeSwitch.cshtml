@using KiraTakip.Web.Models.ViewModels
@{
    var model = ViewData[LeaseCreateTypeSwitchViewModel.ViewDataKey] as LeaseCreateTypeSwitchViewModel;
}
@if (model is { IsVisible: true })
{
    var normalUrl = Url.Action("Create", "Lease", new { unitId = model.UnitId, tenantId = model.TenantId });
    var sharedUrl = Url.Action("Create", "Lease", new { unitId = model.UnitId, tenantId = model.TenantId, tur = LeaseCreateTypeSwitchViewModel.SharedType });
    const string baseClass = "px-4 py-2 rounded-md text-[13px] font-semibold no-underline transition-colors";
    const string activeClass = baseClass + " bg-primary text-white";
    const string idleClass = baseClass + " text-muted hover:text-primary";

    <div class="mb-4">
        <div class="inline-flex gap-1 rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] p-1" role="tablist" aria-label="Sözleşme türü">
            <a href="@normalUrl" role="tab" aria-selected="@(!model.IsShared ? "true" : "false")"
               class="@(model.IsShared ? idleClass : activeClass)">Normal</a>
            <a href="@sharedUrl" role="tab" aria-selected="@(model.IsShared ? "true" : "false")"
               class="@(model.IsShared ? activeClass : idleClass)">Paylaşımlı (çok kiracı)</a>
        </div>
        <div class="mt-2 text-[12.5px] text-muted">
            @(model.IsShared
                ? "Aynı birimi paylaşan birden çok kiracı için ortak tarihli sözleşmeler tek başvuruda açılır."
                : "Tek kiracılı sözleşme: normal birim veya açık ofis.")
        </div>
    </div>
}
