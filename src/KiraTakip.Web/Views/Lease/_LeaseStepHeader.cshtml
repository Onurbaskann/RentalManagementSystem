@{
    string number = ViewData["Number"]?.ToString() ?? string.Empty;
    string title = ViewData["StepTitle"]?.ToString() ?? string.Empty;
}
<div class="text-[15px] font-bold mb-5 pb-3 border-b border-[var(--color-border)] flex items-center gap-2.5">
    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-primary text-white text-[12px] font-bold" x-text="@(ViewData["NumberExpr"] ?? $"'{number}'")">@number</span>
    <span>@title</span>
</div>
