@model KiraTakip.Web.Models.ViewModels.LeaseGroupFormViewModel
@using KiraTakip.Models.Enums
@using KiraTakip.Web.Extensions
@{
    ViewData["Title"] = Model.IsEdit ? "Paylaşımlı Grubu Düzenle" : "Paylaşımlı Sözleşme Grubu";
    ViewData["UseCentralFeedback"] = true;
    string writePermission = Model.IsEdit ? PermissionCatalog.Lease.UpdateGroup : PermissionCatalog.Lease.CreateGroup;
    string backUrl = Model.IsEdit
        ? Url.Action(nameof(KiraTakip.Web.Controllers.LeaseController.Group), "Lease", new { id = Model.GroupId })!
        : Url.Action(nameof(KiraTakip.Web.Controllers.LeaseController.Index), "Lease")!;
}

<div class="max-w-[1000px] mx-auto">
    <div class="page-header">
        <a href="@backUrl" class="text-[12.5px] text-muted no-underline inline-block mb-2 hover:text-primary transition-colors">← @(Model.IsEdit ? "Gruba Dön" : "Sözleşmeler")</a>
        <div class="page-title">@(Model.IsEdit ? "Paylaşımlı Grubu Düzenle" : "Paylaşımlı Sözleşme Grubu")</div>
        <div class="page-subtitle">Aynı birimi paylaşan kiracılar için ortak tarihli sözleşmeler tek taslakta açılır; onaylanana kadar sözleşmeler aktifleşmez.</div>
    </div>

    <div x-data="leaseGroupForm()" x-init="init()" x-cloak @@datechanged="onPickerChanged($event)">
        <form asp-action="@(Model.IsEdit ? "UpdateGroup" : "CreateGroup")" method="post" id="leaseGroupForm"
              asp-form-write-permission="@writePermission"
              x-on:submit="submitting = true">
            <div asp-validation-summary="All" class="form-error mb-3"></div>
            <input type="hidden" name="GroupId" value="@Model.GroupId" />

            <div class="card">
                <div class="text-[15px] font-bold mb-5 pb-3 border-b border-[var(--color-border)] flex items-center gap-2">
                    <span class="w-1.5 h-4 bg-primary rounded-full"></span><span>Birim</span>
                </div>
                @if (Model.IsEdit)
                {
                    <input type="hidden" name="UnitId" value="@Model.UnitId" />
                    <div class="bg-primary/5 border border-primary/10 rounded-lg p-3 text-[13.5px] font-medium text-primary">
                        @Model.UnitName • @Model.UnitArea.M2()
                    </div>
                }
                else
                {
                    <div class="form-group mb-0">
                        <label class="form-label">Birim *</label>
                        <select asp-for="UnitId" class="form-control" x-model="unitId">
                            <option value="">— Boş birim seçin —</option>
                            @foreach (var unit in Model.AvailableUnits)
                            {
                                string label = unit.UnitStructure == UnitStructure.MultipleUnits
                                    ? $"{unit.PropertyName} — Birim {unit.UnitNo}{(unit.FloorNo.HasValue ? $" • {unit.FloorNo}. Kat" : "")} • {unit.Area.M2()}"
                                    : $"{unit.PropertyName} — Komple • {unit.Area.M2()} • {unit.District}";
                                <option value="@unit.Id">@label</option>
                            }
                        </select>
                        <span asp-validation-for="UnitId" class="form-error"></span>
                    </div>
                }
            </div>

            <div class="card mt-4">
                <div class="text-[15px] font-bold mb-5 pb-3 border-b border-[var(--color-border)] flex items-center gap-2">
                    <span class="w-1.5 h-4 bg-primary rounded-full"></span><span>Süre ve Vade (tüm sözleşmeler için ortak)</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                    <div class="form-group mb-0">
                        <label class="form-label">Başlangıç Tarihi *</label>
                        @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                        {
                            ["Name"] = "StartDate",
                            ["Value"] = Model.StartDate.ToString("yyyy-MM-dd"),
                            ["Mode"] = "date",
                            ["Field"] = "start"
                        })
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Bitiş Tarihi *</label>
                        @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                        {
                            ["Name"] = "EndDate",
                            ["Value"] = Model.EndDate.ToString("yyyy-MM-dd"),
                            ["Mode"] = "date",
                            ["Field"] = "end"
                        })
                        <span asp-validation-for="EndDate" class="form-error"></span>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mt-3.5">
                    <div class="form-group mb-0">
                        <label class="form-label">Vade Kuralı</label>
                        <select asp-for="DueDateRuleType" class="form-control" x-model.number="dueDateRuleType">
                            <option value="1">Sabit Ay Günü (ayın N'i)</option>
                            <option value="2">Dönem Başı + N Gün</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Vade Günü *</label>
                        <input asp-for="DueDay" type="number" class="form-control" x-model.number="dueDay" />
                        <span asp-validation-for="DueDay" class="form-error"></span>
                    </div>
                </div>
                <label class="flex items-start gap-3 cursor-pointer rounded-lg border border-emerald-200 bg-emerald-50 p-3 mt-4">
                    <input asp-for="IsRentFree" type="checkbox" class="mt-1" x-model="isRentFree" />
                    <span>
                        <strong class="block text-sm text-emerald-900">Bedelsiz sözleşme</strong>
                        <span class="block text-xs text-emerald-800 mt-1">Kira bedeli tahakkuku oluşturulmaz. Depozito ve diğer borç kalemleri tanımlıysa uygulanmaya devam eder.</span>
                    </span>
                </label>
            </div>

            <div class="card mt-4">
                <div class="text-[15px] font-bold mb-3 pb-3 border-b border-[var(--color-border)] flex flex-wrap justify-between items-center gap-2">
                    <div class="flex items-center gap-2"><span class="w-1.5 h-4 bg-primary rounded-full"></span><span>Kiracılar ve m² Payları</span></div>
                    <button type="button" class="btn btn-sm btn-secondary" @@click="addMember()">+ Kiracı Ekle</button>
                </div>
                <div class="mb-4 rounded-lg border p-3 text-[13px]"
                     :class="Math.abs(remaining()) < 0.005 ? 'border-emerald-200 bg-emerald-50 text-emerald-900' : 'border-amber-200 bg-amber-50 text-amber-900'">
                    <span>Birim alanı (P): <strong x-text="`${fmt(unitArea())} m²`"></strong></span>
                    <span class="mx-2">•</span>
                    <span>Σ m²: <strong x-text="`${fmt(totalArea())} m²`"></strong></span>
                    <span class="mx-2">•</span>
                    <span>Fark: <strong x-text="`${fmt(remaining())} m²`"></strong></span>
                    <div class="text-xs mt-1 opacity-80">Bilgi amaçlıdır; Σ m² = P kuralı kayıtta doğrulanır. En az 2 farklı kiracı gerekir.</div>
                </div>

                <template x-for="(m, mi) in members" :key="m.key">
                    <div class="rounded-xl border border-[var(--color-border)] p-4 mb-4">
                        <div class="flex items-center justify-between mb-3">
                            <strong class="text-sm" x-text="m.leaseNo ? `Sözleşme ${m.leaseNo}` : `Kiracı ${mi + 1}`"></strong>
                            <button type="button" class="btn btn-sm btn-danger" x-show="members.length > 2" @@click="removeMember(mi)">Çıkar</button>
                        </div>
                        <input type="hidden" :name="`Members[${mi}].LeaseId`" :value="m.leaseId ?? ''" />
                        <input type="hidden" :name="`Members[${mi}].LeaseNo`" :value="m.leaseNo ?? ''" />
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
                            <div class="form-group mb-0 md:col-span-2">
                                <label class="form-label">Kiracı *</label>
                                <select class="form-control" :name="`Members[${mi}].TenantId`" x-model.number="m.tenantId" @@change="fetchItems(m)">
                                    <option value="0">— Kiracı seçin —</option>
                                    @foreach (var tenant in Model.Tenants)
                                    {
                                        <option value="@tenant.Id">@tenant.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label">m² *</label>
                                <input type="number" step="0.01" min="0" class="form-control" :name="`Members[${mi}].Area`" x-model.number="m.area" />
                            </div>
                        </div>

                        <div x-show="unitId && m.tenantId && startDate" class="mt-4">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-[13px] font-bold">Sözleşme Tarifesi (opsiyonel)</span>
                                <span x-show="m.loading" class="text-xs text-muted">Yükleniyor…</span>
                            </div>
                            <div x-show="m.error" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-3 text-sm" x-text="m.error"></div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                @await Html.PartialAsync("_LeaseLineItemFields", null, new ViewDataDictionary(ViewData)
                                {
                                    ["ItemsExpr"] = "m.lineItems",
                                    ["NamePrefix"] = "Members[${mi}].LeaseLineItems",
                                    ["AmountExpr"] = "amount(item, m)",
                                    ["AreaExpr"] = "Number(m.area || 0)"
                                })
                            </div>
                            <div x-show="!m.loading && m.lineItems.length === 0" class="text-muted text-sm italic">Bu seçimlere uygun tarife bulunamadı.</div>
                        </div>
                    </div>
                </template>
            </div>

            <div class="card mt-4">
                <div class="form-group mb-0">
                    <label class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Gruba ait ek açıklama..."></textarea>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button type="submit" class="btn btn-primary px-6 flex items-center gap-2"
                        asp-permission="@writePermission" :disabled="submitting">
                    <span x-text="submitting ? 'Kaydediliyor…' : '@(Model.IsEdit ? "Kaydet" : "Taslak Olarak Kaydet")'"></span>
                </button>
                <a href="@backUrl" class="btn btn-secondary px-6">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_LeaseGroupFormScripts", Model)
}
