@model KiraTakip.Web.Models.ViewModels.ILeaseFormViewModel
@using KiraTakip.Models.Enums
@{
    bool readOnly = ViewData["ReadOnly"] as bool? ?? false;
    bool tenantLocked = ViewData["TenantLocked"] as bool? ?? false;
    bool hasKind = ViewData[LeaseKindChoiceViewModel.ViewDataKey] is LeaseKindChoiceViewModel { IsVisible: true };
    int step = hasKind ? 3 : 2;
}

<div asp-validation-summary="ModelOnly" class="form-error mb-3"></div>

@if (!readOnly)
{
    @await Html.PartialAsync("_LeaseKindChoice")
}

@await Html.PartialAsync("_LeaseSpaceSelect", null, new ViewDataDictionary(ViewData) { ["ReadOnly"] = readOnly, ["StepNumber"] = (hasKind && !readOnly ? 2 : 1).ToString() })

<div class="card mt-4">
    @await Html.PartialAsync("_LeaseStepHeader", null, new ViewDataDictionary(ViewData) { ["Number"] = step.ToString(), ["StepTitle"] = "Kiracı" })
    <div class="form-group">
        <label class="form-label">Kiracı *</label>
        @if (tenantLocked && !readOnly)
        {
            <input type="hidden" asp-for="TenantId" />
        }
        <select asp-for="TenantId" class="form-control" x-model="tenantId" disabled="@(readOnly || tenantLocked)">
            <option value="">— Kiracı seçin —</option>
            @foreach (var tenant in Model.Tenants)
            {
                <option value="@tenant.Id">@tenant.DisplayName</option>
            }
        </select>
        @if (tenantLocked && !readOnly)
        {
            <div class="text-muted text-[12.5px] mt-1">Kiracı detay sayfasından seçildiği için bu alanda değiştirilemez.</div>
        }
        <span asp-validation-for="TenantId" class="form-error"></span>
    </div>
    <div class="form-group mb-0">
        <label class="form-label">Kiralanan alan (m²)</label>
        <input name="RentedArea" type="number" step="0.01" min="0" class="form-control" x-model.number="rentedArea"
               :placeholder="spaceAreaText()" :disabled="readOnly" />
        <div class="text-muted text-[12.5px] mt-1">Boş bırakılırsa alanın tamamı kiralanır; sözleşmede kiralanan ve faturalanan m².</div>
        <span asp-validation-for="RentedArea" class="form-error"></span>
    </div>
</div>

<div class="card mt-4">
    @await Html.PartialAsync("_LeaseStepHeader", null, new ViewDataDictionary(ViewData) { ["Number"] = (step + 1).ToString(), ["StepTitle"] = "Süre ve vade" })
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        <div class="form-group mb-0">
            <label class="form-label">Başlangıç Tarihi *</label>
            @if (readOnly)
            {
                <input class="form-control" value="@Model.StartDate.ToString("dd.MM.yyyy")" disabled />
            }
            else
            {
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                {
                    ["Name"] = "StartDate",
                    ["Value"] = Model.StartDate.ToString("yyyy-MM-dd"),
                    ["Mode"] = "date",
                    ["Field"] = "start"
                })
            }
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Bitiş Tarihi *</label>
            @if (readOnly)
            {
                <input class="form-control" value="@Model.EndDate.ToString("dd.MM.yyyy")" disabled />
            }
            else
            {
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                {
                    ["Name"] = "EndDate",
                    ["Value"] = Model.EndDate.ToString("yyyy-MM-dd"),
                    ["Mode"] = "date",
                    ["Field"] = "end"
                })
            }
            <span asp-validation-for="EndDate" class="form-error"></span>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mt-3.5">
        <div class="form-group mb-0">
            <label class="form-label">Vade Kuralı</label>
            <select asp-for="DueDateRuleType" class="form-control" x-model.number="dueDateRuleType" disabled="@readOnly">
                <option value="1">Sabit Ay Günü (ayın N'i)</option>
                <option value="2">Dönem Başı + N Gün</option>
            </select>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Vade Günü *</label>
            <input asp-for="DueDay" type="number" class="form-control" x-model.number="dueDay" disabled="@readOnly" />
            <span asp-validation-for="DueDay" class="form-error"></span>
        </div>
    </div>
    <label class="flex items-start gap-3 cursor-pointer rounded-lg border border-emerald-200 bg-emerald-50 p-3 mt-4">
        <input asp-for="IsRentFree" type="checkbox" class="mt-1" x-model="isRentFree" disabled="@readOnly" />
        <span>
            <strong class="block text-sm text-emerald-900">Bedelsiz sözleşme</strong>
            <span class="block text-xs text-emerald-800 mt-1">Kira bedeli tahakkuku oluşturulmaz. Depozito ve diğer borç kalemleri tanımlıysa uygulanmaya devam eder.</span>
        </span>
    </label>
</div>

<div class="card mt-4">
    <div class="flex justify-between items-center">
        @await Html.PartialAsync("_LeaseStepHeader", null, new ViewDataDictionary(ViewData) { ["Number"] = (step + 2).ToString(), ["StepTitle"] = "Sözleşme tarifesi" })
        <span x-show="loading" class="text-xs text-muted mb-5">Yükleniyor…</span>
    </div>
    <div x-show="!(spaceId && tenantId && startDate)" class="text-muted text-sm italic">Alan, kiracı ve başlangıç tarihi seçilince tarife yüklenir.</div>
    <div x-show="spaceId && tenantId && startDate" x-cloak>
    <div x-show="error" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-sm" x-text="error"></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @await Html.PartialAsync("_LeaseLineItemFields", null, new ViewDataDictionary(ViewData)
        {
            ["ItemsExpr"] = "lineItems",
            ["NamePrefix"] = "LeaseLineItems",
            ["AmountExpr"] = "amount(item)",
            ["AreaExpr"] = "spaceArea()"
        })
    </div>
    <div x-show="!loading && lineItems.length === 0" class="text-muted text-sm italic">Bu seçimlere uygun tarife bulunamadı.</div>
    <span asp-validation-for="LeaseLineItems" class="form-error"></span>
    </div>
</div>

<div class="card mt-4">
    <div class="form-group mb-0">
        <label class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="3" disabled="@readOnly"
                  placeholder="Başvuruya ait ek açıklama..."></textarea>
    </div>
</div>
