@model KiraTakip.Web.Models.ViewModels.ILeaseFormViewModel
@using KiraTakip.Models.Enums
@{
    bool readOnly = ViewData["ReadOnly"] as bool? ?? false;
    bool tenantLocked = ViewData["TenantLocked"] as bool? ?? false;
}

<div asp-validation-summary="ModelOnly" class="form-error mb-3"></div>

<div class="card">
    <div class="text-[15px] font-bold mb-5 pb-3 border-b border-[var(--color-border)] flex items-center gap-2">
        <span class="w-1.5 h-4 bg-primary rounded-full"></span>
        <span>Taşınmaz ve Kiracı</span>
    </div>
    <div class="form-group">
        <label class="form-label">Birim *</label>
        <select asp-for="UnitId" class="form-control" x-model="unitId" disabled="@readOnly">
            <option value="">— Boş birim seçin —</option>
            @foreach (var unit in Model.AvailableUnits)
            {
                string label = unit.UnitStructure == UnitStructure.MultipleUnits
                    ? $"{unit.PropertyName} — Birim {unit.UnitNo}{(unit.FloorNo.HasValue ? $" • {unit.FloorNo}. Kat" : "")} • {unit.Area.M2()}"
                    : $"{unit.PropertyName} — Komple • {unit.Area.M2()} • {unit.District}";
                if (unit.RentalMode == UnitRentalMode.CapacityBased)
                {
                    label += $" • {unit.FreeCapacity ?? 0} kişi · {unit.FreeArea.M2()} boş";
                }
                <option value="@unit.Id">@label</option>
            }
        </select>
        <span asp-validation-for="UnitId" class="form-error"></span>
    </div>
    <div x-show="unitId && units[unitId]" class="mb-4" x-cloak>
        <div class="bg-primary/5 border border-primary/10 rounded-lg p-3 text-[13.5px] font-medium text-primary"
             x-text="units[unitId] ? `${units[unitId].name} • ${units[unitId].meta} • ${units[unitId].district}, ${units[unitId].city}` : ''"></div>
    </div>
    <div x-show="isCap()" class="mb-4" x-cloak>
        <div class="form-group">
            <label class="form-label">Kiralanan m² *</label>
            <input name="RentedArea" type="number" step="0.01" min="0" class="form-control" x-model.number="rentedArea"
                   :disabled="readOnly || !isCap()" />
            <div class="text-muted text-[12.5px] mt-1" x-show="minArea > 0"
                 x-text="`En az ${minArea} m² kiralanmalıdır.`"></div>
            <span asp-validation-for="RentedArea" class="form-error"></span>
        </div>
        <div x-show="isLastSlot()" class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-[13px] mb-3">
            Son kontenjan: kalan alan öneri olarak dolduruldu, değiştirebilirsiniz.
        </div>
        <div class="form-group">
            <label class="form-label">Fiziksel m² modu</label>
            <div class="flex gap-4 text-[13.5px]">
                <label class="flex items-center gap-1.5">
                    <input type="radio" name="AllocationMode" value="@((int)LeaseAreaMode.Automatic)" x-model.number="allocationMode"
                           :disabled="readOnly || !isCap()" /> Otomatik
                </label>
                <label class="flex items-center gap-1.5">
                    <input type="radio" name="AllocationMode" value="@((int)LeaseAreaMode.Manual)" x-model.number="allocationMode"
                           :disabled="readOnly || !isCap()" /> Manuel
                </label>
            </div>
            <span asp-validation-for="AllocationMode" class="form-error"></span>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Fiziksel m²<span x-show="isManual()"> *</span></label>
            <input x-show="!isManual()" type="number" class="form-control" readonly :value="autoArea()" />
            <input x-show="isManual()" name="AllocatedArea" type="number" step="0.01" min="0" class="form-control" x-model.number="allocatedArea"
                   :disabled="readOnly || !isCap() || !isManual()" />
            <div class="text-muted text-[12.5px] mt-1" x-show="!isManual()">Onayda güncel kontenjanla yeniden hesaplanır.</div>
            <div class="text-muted text-[12.5px] mt-1" x-show="isManual()"
                 x-text="`Min ${minArea} m² – en fazla Kiralanan m²`"></div>
            <span asp-validation-for="AllocatedArea" class="form-error"></span>
        </div>
    </div>
    <div class="form-group mb-0">
        <label class="form-label">Kiracı *</label>
        @if (tenantLocked && !readOnly)
        {
            <input type="hidden" asp-for="TenantId" />
        }
        <select asp-for="TenantId" class="form-control" x-model="tenantId" disabled="@(readOnly || tenantLocked)">
            <option value="">— Kiracı seçin —</option>
            @foreach (var tenant in Model.Tenants)
            {
                <option value="@tenant.Id">@tenant.DisplayName</option>
            }
        </select>
        @if (tenantLocked && !readOnly)
        {
            <div class="text-muted text-[12.5px] mt-1">Kiracı detay sayfasından seçildiği için bu alanda değiştirilemez.</div>
        }
        <span asp-validation-for="TenantId" class="form-error"></span>
    </div>
</div>

<div class="card mt-4">
    <div class="text-[15px] font-bold mb-5 pb-3 border-b border-[var(--color-border)] flex items-center gap-2">
        <span class="w-1.5 h-4 bg-primary rounded-full"></span><span>Süre ve Vade</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        <div class="form-group mb-0">
            <label class="form-label">Başlangıç Tarihi *</label>
            @if (readOnly)
            {
                <input class="form-control" value="@Model.StartDate.ToString("dd.MM.yyyy")" disabled />
            }
            else
            {
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                {
                    ["Name"] = "StartDate",
                    ["Value"] = Model.StartDate.ToString("yyyy-MM-dd"),
                    ["Mode"] = "date",
                    ["Field"] = "start"
                })
            }
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Bitiş Tarihi *</label>
            @if (readOnly)
            {
                <input class="form-control" value="@Model.EndDate.ToString("dd.MM.yyyy")" disabled />
            }
            else
            {
                @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
                {
                    ["Name"] = "EndDate",
                    ["Value"] = Model.EndDate.ToString("yyyy-MM-dd"),
                    ["Mode"] = "date",
                    ["Field"] = "end"
                })
            }
            <span asp-validation-for="EndDate" class="form-error"></span>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mt-3.5">
        <div class="form-group mb-0">
            <label class="form-label">Vade Kuralı</label>
            <select asp-for="DueDateRuleType" class="form-control" x-model.number="dueDateRuleType" disabled="@readOnly">
                <option value="1">Sabit Ay Günü (ayın N'i)</option>
                <option value="2">Dönem Başı + N Gün</option>
            </select>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Vade Günü *</label>
            <input asp-for="DueDay" type="number" class="form-control" x-model.number="dueDay" disabled="@readOnly" />
            <span asp-validation-for="DueDay" class="form-error"></span>
        </div>
    </div>
</div>

<div class="card mt-4" x-show="unitId && tenantId && startDate" x-cloak>
    <div class="text-[15px] font-bold mb-5 pb-3 border-b border-[var(--color-border)] flex justify-between items-center">
        <div class="flex items-center gap-2"><span class="w-1.5 h-4 bg-primary rounded-full"></span><span>Sözleşme Tarifesi</span></div>
        <span x-show="loading" class="text-xs text-muted">Yükleniyor…</span>
    </div>
    <label class="flex items-start gap-3 cursor-pointer rounded-lg border border-emerald-200 bg-emerald-50 p-3 mb-4">
        <input asp-for="IsRentFree" type="checkbox" class="mt-1" x-model="isRentFree" disabled="@readOnly" />
        <span>
            <strong class="block text-sm text-emerald-900">Bedelsiz sözleşme</strong>
            <span class="block text-xs text-emerald-800 mt-1">Kira bedeli tahakkuku oluşturulmaz. Depozito ve diğer borç kalemleri tanımlıysa uygulanmaya devam eder.</span>
        </span>
    </label>
    <div x-show="error" class="bg-red-50 border border-red-200 text-red-800 p-3 rounded-lg mb-4 text-sm" x-text="error"></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @await Html.PartialAsync("_LeaseLineItemFields", null, new ViewDataDictionary(ViewData)
        {
            ["ItemsExpr"] = "lineItems",
            ["NamePrefix"] = "LeaseLineItems",
            ["AmountExpr"] = "amount(item)",
            ["AreaExpr"] = "unitArea()"
        })
    </div>
    <div x-show="!loading && lineItems.length === 0" class="text-muted text-sm italic">Bu seçimlere uygun tarife bulunamadı.</div>
    <span asp-validation-for="LeaseLineItems" class="form-error"></span>
</div>

<div class="card mt-4">
    <div class="form-group mb-0">
        <label class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="3" disabled="@readOnly"
                  placeholder="Başvuruya ait ek açıklama..."></textarea>
    </div>
</div>
