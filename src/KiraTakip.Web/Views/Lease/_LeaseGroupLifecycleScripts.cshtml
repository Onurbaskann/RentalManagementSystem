<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('leaseGroupExtend', (config) => ({
            spaceId: config.spaceId,
            startDate: config.startDate,
            isRentFree: config.isRentFree,
            readOnly: false,
            applyInflation: false,
            applyVat: false,
            updateRate: false,
            members: config.members.map(m => ({ ...m, lineItems: [], loading: false, error: null, loaded: false })),
            toggleRates() {
                if (this.updateRate) this.members.forEach(m => this.fetchItems(m));
            },
            async fetchItems(m) {
                if (m.loaded) return;
                m.loading = true; m.error = null;
                try {
                    const response = await fetch(`/Lease/GetDefaultLineItems?spaceId=${this.spaceId}&tenantId=${m.tenantId}&startDate=${this.startDate}&leaseId=${m.leaseId}`);
                    if (!response.ok) throw new Error('Tarife kalemleri alınamadı.');
                    m.lineItems = (await response.json()).map(item => ({ ...item }));
                    m.loaded = true;
                } catch (error) { m.error = error.message; }
                finally { m.loading = false; }
            },
            amount(item, m) { return item.calculationMethod == 2 ? item.unitValue * Number(m.area || 0) : item.unitValue; },
            sourceLabel(source) {
                const labels = { LeaseRateOverride: 'Sözleşme Tarifesi', SpaceRate: 'Alan Tarifesi', RateSchedule: 'Genel Tarife', ManualInput: 'Manuel Giriş' };
                return labels[source] || 'Tarife';
            }
        }));
    });
</script>
