@model KiraTakip.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["UseCentralFeedback"] = true;
    int totalUnits = Model.RentedUnits + Model.VacantUnits + Model.ExpiringLeaseUnits;
    double rentedPercentage = totalUnits > 0 ? (double)Model.RentedUnits / totalUnits * 100 : 0;
    double expiringPercentage = totalUnits > 0 ? (double)Model.ExpiringLeaseUnits / totalUnits * 100 : 0;
    double vacantPercentage = totalUnits > 0 ? (double)Model.VacantUnits / totalUnits * 100 : 0;

    bool hasPropertyAccess = await PermissionService.HasModuleAccessAsync(PermissionCatalog.Property.Module);
    bool hasLeaseAccess = await PermissionService.HasModuleAccessAsync(PermissionCatalog.Lease.Module);
    bool hasPaymentAccess = await PermissionService.HasModuleAccessAsync(PermissionCatalog.Payment.Module);
    bool hasChargeAccess = await PermissionService.HasModuleAccessAsync(PermissionCatalog.Charge.Module);

    var nameParts = (Model.UserName ?? "").Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
    var turkishCulture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    string initials = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[1][0]}".ToUpper(turkishCulture)
        : nameParts.Length == 1 && nameParts[0].Length > 0
            ? nameParts[0][0].ToString().ToUpper(turkishCulture)
            : "?";

    bool heroDanger = false;
    string heroMessage;
    if (hasChargeAccess && Model.OverdueChargeCount > 0)
    {
        heroDanger = true;
        heroMessage = $"{Model.OverdueChargeCount} gecikmiş tahakkuk var ({Model.TotalOverdueAmount:N2} ₺)";
    }
    else if (hasPaymentAccess && Model.PendingPaymentApprovalCount > 0)
    {
        heroMessage = $"{Model.PendingPaymentApprovalCount} ödeme onay bekliyor";
    }
    else if (hasLeaseAccess && Model.RenewalsThisMonth > 0)
    {
        heroMessage = $"Bu ay {Model.RenewalsThisMonth} sözleşme yenilenmeli";
    }
    else
    {
        heroMessage = "Tüm akışlar güncel.";
    }
}

@functions {
    // Aylık Kira Geliri kartı — kaynak x zaman aralığı kombinasyonlarını JS objesine gömmek için.
    string SerializeTrendRows(List<KiraTakip.Web.Models.ViewModels.DashboardMonthlyRevenueTrendRow> rows)
    {
        // rows en yeni ay üstte gelir (Model.RevenueTrend*'in genel kuralı) — grafikte soldan
        // sağa kronolojik (en eski solda, en yeni sağda) gitmesi için ters çeviriyoruz.
        var chronological = rows.AsEnumerable().Reverse().ToList();
        var culture = System.Globalization.CultureInfo.InvariantCulture;
        var aylar = string.Join(",", chronological.Select(x => $"'{x.MonthLabel}'"));
        var tahakkuk = string.Join(",", chronological.Select(x => x.Amount.ToString(culture)));
        var tahsilat = string.Join(",", chronological.Select(x => x.CollectedAmount.ToString(culture)));
        var oran = string.Join(",", chronological.Select(x => x.CollectionRatePercent.HasValue ? x.CollectionRatePercent.Value.ToString(culture) : "null"));
        return $"{{ aylar: [{aylar}], tahakkuk: [{tahakkuk}], tahsilat: [{tahsilat}], oran: [{oran}] }}";
    }

    string SerializeTrendSet(KiraTakip.Web.Models.ViewModels.DashboardRevenueTrendSet set)
        => $"{{ ay3: {SerializeTrendRows(set.Months3)}, ay6: {SerializeTrendRows(set.Months6)}, yil1: {SerializeTrendRows(set.Months12)} }}";
}

<!-- ─── §3.1 HERO BANNER ─── -->
<div class="relative overflow-hidden rounded-3xl p-8 mb-6 bg-brand-gradient text-white">
    <svg class="absolute -right-10 -top-10 w-48 h-48 opacity-10 pointer-events-none" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="90" stroke="white" stroke-width="2"/>
        <circle cx="100" cy="100" r="60" stroke="white" stroke-width="2"/>
        <circle cx="100" cy="100" r="30" stroke="white" stroke-width="2"/>
    </svg>

    <div class="flex flex-wrap items-center justify-between gap-6">
        <div>
            <h1 class="text-2xl font-bold font-display">Hoş geldiniz, @Model.UserName</h1>
            <div class="text-sm text-white/80 mt-1">@Model.DateLabel</div>
            <div class="inline-flex items-center gap-1.5 mt-3 px-2.5 py-1.5 rounded-md text-xs @(heroDanger ? "bg-danger/25 text-red-100" : "bg-white/15 text-white/90")">
                @if (heroDanger)
                {
                    <i data-lucide="alert-triangle" class="w-3 h-3"></i>
                }
                <span>@heroMessage</span>
            </div>
        </div>

        <div class="flex items-center gap-3 shrink-0">
            <div class="w-10 h-10 rounded-full bg-white/15 text-white text-sm font-bold flex items-center justify-center">
                @initials
            </div>
            <div>
                <div class="text-sm font-semibold">@Model.UserName</div>
                <div class="text-xs text-white/70">@Model.UserRole</div>
            </div>
        </div>
    </div>
</div>


<!-- ─── §3.2 GENEL BAKIŞ ─── -->
@if (hasPropertyAccess || hasLeaseAccess || hasPaymentAccess)
{
    <div class="section-label">Genel Bakış</div>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 mb-6">

        @if (hasPropertyAccess)
        {
        <div class="card lg:col-span-2">
            <div class="stat-rail-label">Toplam Taşınmaz</div>
            <div class="stat-rail-value" data-countup="@Model.TotalProperties" data-decimals="0">0</div>
            <div class="stat-rail-sub truncate">@string.Join(", ", Model.PropertyTypeDistribution.Select(kv => $"{kv.Value} {kv.Key}"))</div>

            @if (Model.PropertyOccupancies.Any())
            {
                var propertyPages = Model.PropertyOccupancies.Chunk(4).ToList();
                <div class="mt-4" x-data="{ propertySayfa: 0 }">
                    @for (int pageIndex = 0; pageIndex < propertyPages.Count; pageIndex++)
                    {
                        <div class="space-y-2" x-show="propertySayfa === @pageIndex" x-cloak>
                            @foreach (var propertyOccupancy in propertyPages[pageIndex])
                            {
                                var propUnitTotal = propertyOccupancy.UnitCount;
                                var propLeasedPct = propUnitTotal > 0 ? (double)propertyOccupancy.LeasedUnitCount / propUnitTotal * 100 : 0;
                                var propExpiringPct = propUnitTotal > 0 ? (double)propertyOccupancy.ExpiringSoonUnitCount / propUnitTotal * 100 : 0;
                                var propVacantPct = propUnitTotal > 0 ? (double)propertyOccupancy.VacantUnitCount / propUnitTotal * 100 : 0;
                                <div>
                                    <div class="flex items-center justify-between text-[11px] text-slate-600 mb-1">
                                        <span class="truncate">@propertyOccupancy.PropertyName</span>
                                        <span class="text-muted shrink-0 ml-2">@propertyOccupancy.UnitCount birim</span>
                                    </div>
                                    <div class="h-1.5 rounded-full overflow-hidden bg-slate-100 flex">
                                        <div class="h-full bg-emerald-500" style="width:@propLeasedPct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        <div class="h-full bg-amber-500" style="width:@propExpiringPct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        <div class="h-full bg-slate-400" style="width:@propVacantPct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @if (propertyPages.Count > 1)
                    {
                        <div class="flex items-center justify-end gap-0.5 mt-2">
                            <button type="button" aria-label="Önceki"
                                    class="w-5 h-5 flex items-center justify-center rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:pointer-events-none"
                                    @@click="propertySayfa = Math.max(0, propertySayfa - 1)" :disabled="propertySayfa === 0">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                            </button>
                            <button type="button" aria-label="Sonraki"
                                    class="w-5 h-5 flex items-center justify-center rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:pointer-events-none"
                                    @@click="propertySayfa = Math.min(@(propertyPages.Count - 1), propertySayfa + 1)" :disabled="propertySayfa === @(propertyPages.Count - 1)">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                            </button>
                            <span class="text-[10px] text-muted ml-0.5" x-text="(propertySayfa + 1) + ' / @propertyPages.Count'"></span>
                        </div>
                    }
                </div>
            }

            <div class="mt-3 pt-2 border-t border-[var(--color-border)] flex items-center justify-between text-[11px] text-slate-500">
                <span>Toplam @Model.TotalUnits birim</span>
                <span class="font-semibold text-slate-700">Doluluk %@Model.OccupancyCountRate.ToString("F0") · m² %@Model.OccupancyAreaRate.ToString("F0")</span>
            </div>
        </div>
        }

        @if (hasPaymentAccess)
        {
            var initialTrend = Model.RevenueTrendAll.Months6.FirstOrDefault();
        <div class="card lg:col-span-2" x-data="{ kiraKaynak: 'tumu', kiraZaman: 'ay6' }">
            <div class="flex items-center justify-between mb-1 flex-wrap gap-2">
                <div class="stat-rail-label mb-0">Tahakkuk & Tahsilat</div>
                <div class="flex gap-1 bg-slate-100 rounded-lg p-0.5 flex-wrap justify-end">
                    <button type="button" @@click="kiraKaynak = 'tumu'; renderKiraTrend(kiraKaynak, kiraZaman)"
                            :class="kiraKaynak === 'tumu' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                            class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Tümü</button>
                    <button type="button" @@click="kiraKaynak = 'sozlesme'; renderKiraTrend(kiraKaynak, kiraZaman)"
                            :class="kiraKaynak === 'sozlesme' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                            class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Sözleşme</button>
                    <button type="button" @@click="kiraKaynak = 'manuel'; renderKiraTrend(kiraKaynak, kiraZaman)"
                            :class="kiraKaynak === 'manuel' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                            class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Manuel</button>
                    <button type="button" @@click="kiraKaynak = 'rezervasyon'; renderKiraTrend(kiraKaynak, kiraZaman)"
                            :class="kiraKaynak === 'rezervasyon' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                            class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Rezervasyon</button>
                </div>
            </div>
            <div class="flex items-center gap-3 mb-3">
                <button type="button" @@click="kiraZaman = 'ay3'; renderKiraTrend(kiraKaynak, kiraZaman)"
                        :class="kiraZaman === 'ay3' ? 'text-primary font-bold' : 'text-muted font-medium'"
                        class="text-[11px] transition-colors">3 Ay</button>
                <button type="button" @@click="kiraZaman = 'ay6'; renderKiraTrend(kiraKaynak, kiraZaman)"
                        :class="kiraZaman === 'ay6' ? 'text-primary font-bold' : 'text-muted font-medium'"
                        class="text-[11px] transition-colors">6 Ay</button>
                <button type="button" @@click="kiraZaman = 'yil1'; renderKiraTrend(kiraKaynak, kiraZaman)"
                        :class="kiraZaman === 'yil1' ? 'text-primary font-bold' : 'text-muted font-medium'"
                        class="text-[11px] transition-colors">1 Yıl</button>
            </div>

            <div class="stat-rail-value" id="kira-trend-value"
                 data-countup="@((initialTrend?.Amount ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                 data-decimals="2" data-suffix=" ₺">0</div>

            <div class="mt-4">
                <div class="flex items-center justify-between text-xs mb-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-medium @(initialTrend?.CollectionRatePercent is null ? "text-muted" : initialTrend.CollectionRatePercent >= 100 ? "text-success" : initialTrend.CollectionRatePercent >= 50 ? "text-warning-strong" : "text-danger")" id="kira-trend-rate">
                            @(initialTrend?.CollectionRatePercent is null ? "—" : $"%{initialTrend.CollectionRatePercent:F0}")
                        </span>
                        <span class="text-muted" id="kira-trend-rate-label">@(initialTrend?.MonthLabel) tahsilat oranı</span>
                    </div>
                    <div class="flex items-center gap-2 text-[10px] text-slate-500">
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-accent inline-block"></span>Tahakkuk</span>
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>Tahsilat</span>
                    </div>
                </div>
                <div id="chart-kira-trend"></div>
                <div class="text-[10px] text-muted mt-1">Kalem toplamları, KDV dahil — tahakkuk dönemine göre</div>
            </div>
        </div>
        }

        @if (hasLeaseAccess)
        {
        <div class="lg:col-span-1 flex flex-col gap-4">
            <div class="card flex-1">
                <div class="stat-rail-label">Aktif Sözleşme</div>
                <div class="stat-rail-value" data-countup="@Model.ActiveLeases" data-decimals="0">0</div>
                @if (Model.RenewalsThisMonth > 0)
                {
                    <div class="stat-rail-sub text-warning-strong font-medium">@Model.RenewalsThisMonth sözleşme yenilenecek</div>
                }
                <div class="mt-2"><a href="/Lease?filter=aktif" class="link-more">Görüntüle</a></div>
            </div>

            <div class="card flex-1">
                <div class="stat-rail-label">Aktif Kiracı</div>
                <div class="stat-rail-value" data-countup="@Model.ActiveTenantCount" data-decimals="0">0</div>
                <div class="stat-rail-sub">@Model.ActiveLeases aktif sözleşme</div>
            </div>
        </div>
        }
    </div>
}


<!-- ─── §3.3 BUGÜN VADE DOLAN UYARI BANDI ─── -->
@if (hasPaymentAccess && Model.ChargesDueTodayCount > 0)
{
    <div class="alert-warning mb-6 flex items-center justify-between gap-4">
        <div>
            <div class="text-sm font-bold">Bugün vade dolan @Model.ChargesDueTodayCount tahakkuk</div>
            <div class="text-xs mt-0.5">Toplam kalan: <strong>@Model.ChargesDueTodayAmount.ToString("N2") ₺</strong>. Bugün takip et.</div>
        </div>
        <a href="/Charge?from=@DateTime.Today.ToString("yyyy-MM-dd")&to=@DateTime.Today.ToString("yyyy-MM-dd")" class="link-more shrink-0">İncele</a>
    </div>
}


<!-- ─── §3.4 ÖDEME DURUMU ─── -->
@if (hasPaymentAccess)
{
    <div class="section-label">Ödeme Durumu</div>
    <div class="stat-rail mb-6">

        <!-- A: Tahsilat Oranı -->
        <div class="stat-rail-item">
            <div class="stat-rail-label"><span class="stat-rail-dot bg-slate-300"></span>Tahsilat Oranı (30 gün)</div>
            <div class="stat-rail-value"
                 data-countup="@Model.ThirtyDayCollectionRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-decimals="1" data-suffix="%">0</div>
            <div class="stat-rail-sub">Beklenenin @Model.ThirtyDayCollectionRate.ToString("F1")%'i tahsil edildi</div>
            <div class="progress-bar mt-2">
                <div class="progress-fill bg-success"
                     style="width:@Math.Min((double)Model.ThirtyDayCollectionRate, 100d).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>

        <!-- B: Gecikmiş Tahakkuk -->
        <div class="stat-rail-item">
            <div class="stat-rail-label">
                <span class="stat-rail-dot @(Model.OverdueChargeCount > 0 ? "bg-danger" : "bg-slate-300")"></span>Gecikmiş Tahakkuk
                <i data-lucide="info" class="w-3 h-3 text-muted"
                   data-tip="Vade tarihi geçmiş ve tamamı ödenmemiş tüm tahakkukların kalan tutarı (tüm yıllar dahil)."></i>
            </div>
            <div class="stat-rail-value @(Model.OverdueChargeCount > 0 ? "text-danger" : "")" data-countup="@Model.OverdueChargeCount" data-decimals="0">0</div>
            <div class="stat-rail-sub">@Model.TotalOverdueAmount.ToString("N2") ₺ toplam</div>
            <div class="mt-2"><a href="/Charge?status=gecikti" class="link-more">Görüntüle</a></div>
        </div>

        <!-- C: Onay Bekleyen -->
        <div class="stat-rail-item">
            <div class="stat-rail-label"><span class="stat-rail-dot @(Model.PendingPaymentApprovalCount > 0 ? "bg-warning" : "bg-slate-300")"></span>Onay Bekleyen Ödeme</div>
            <div class="stat-rail-value @(Model.PendingPaymentApprovalCount > 0 ? "text-warning-strong" : "")" data-countup="@Model.PendingPaymentApprovalCount" data-decimals="0">0</div>
            <div class="mt-2"><a href="/Payment?status=onaybekliyor" class="link-more">İncele</a></div>
        </div>

        <!-- D: Eşleşmemiş Banka Hareketi -->
        <div class="stat-rail-item">
            <div class="stat-rail-label"><span class="stat-rail-dot @(Model.UnmatchedBankTransactionCount > 0 ? "bg-info" : "bg-slate-300")"></span>Eşleşmemiş Banka Hareketi</div>
            <div class="stat-rail-value @(Model.UnmatchedBankTransactionCount > 0 ? "text-info" : "")" data-countup="@Model.UnmatchedBankTransactionCount" data-decimals="0">0</div>
            <div class="mt-2"><a href="/BankTransaction?status=eslestirilmedi" class="link-more">Eşleştir</a></div>
        </div>
    </div>
}


<!-- ─── §3.5 GRAFİK PANELİ ─── -->
@if (hasPaymentAccess || hasPropertyAccess)
{
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">

    <!-- Gelir Kırılımı Donut -->
    @if (hasPaymentAccess)
    {
    <div class="card lg:col-span-1">
        <div class="section-title mb-1">Gelir Kırılımı</div>
        <div class="text-xs text-muted mb-4">Son 6 ay, kalem tipine göre</div>
        @if (Model.ChargeTypeRevenueBreakdown.Any())
        {
            <div id="chart-gelir-kirilim"></div>
            var breakdownColorClasses = new[] { "bg-emerald-500", "bg-amber-500", "bg-sky-500", "bg-violet-500", "bg-rose-500", "bg-slate-400" };
            var breakdownTotal = Model.ChargeTypeRevenueBreakdown.Sum(item => item.TotalCollected);
            var breakdownPages = Model.ChargeTypeRevenueBreakdown
                .Select((item, index) => (item, index))
                .Chunk(3)
                .ToList();
            <div class="mt-4" x-data="{ kirilimSayfa: 0 }">
                @for (int pageIndex = 0; pageIndex < breakdownPages.Count; pageIndex++)
                {
                    <div class="space-y-2" x-show="kirilimSayfa === @pageIndex" x-cloak>
                        @foreach (var (breakdownItem, breakdownIndex) in breakdownPages[pageIndex])
                        {
                            var breakdownPct = breakdownTotal > 0 ? (double)(breakdownItem.TotalCollected / breakdownTotal) * 100 : 0;
                            <div class="flex items-center justify-between">
                                <span class="flex items-center gap-2 text-xs text-slate-600 truncate"><span class="w-2 h-2 rounded-full @breakdownColorClasses[breakdownIndex % breakdownColorClasses.Length] inline-block shrink-0"></span>@breakdownItem.ChargeTypeName</span>
                                <span class="text-sm font-semibold tabular-nums shrink-0 ml-2">%@breakdownPct.ToString("F0")</span>
                            </div>
                        }
                    </div>
                }
                @if (breakdownPages.Count > 1)
                {
                    <div class="flex items-center justify-end gap-0.5 mt-2">
                        <button type="button" aria-label="Önceki"
                                class="w-5 h-5 flex items-center justify-center rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:pointer-events-none"
                                @@click="kirilimSayfa = Math.max(0, kirilimSayfa - 1)" :disabled="kirilimSayfa === 0">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                        </button>
                        <button type="button" aria-label="Sonraki"
                                class="w-5 h-5 flex items-center justify-center rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:pointer-events-none"
                                @@click="kirilimSayfa = Math.min(@(breakdownPages.Count - 1), kirilimSayfa + 1)" :disabled="kirilimSayfa === @(breakdownPages.Count - 1)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                        </button>
                        <span class="text-[10px] text-muted ml-0.5" x-text="(kirilimSayfa + 1) + ' / @breakdownPages.Count'"></span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-10 text-slate-400 text-sm">Henüz tahsilat verisi yok</div>
        }
    </div>
    }

    <!-- Doluluk Donut -->
    @if (hasPropertyAccess)
    {
    <div class="card lg:col-span-1">
        <div class="section-title mb-1">Doluluk Dağılımı</div>
        <div class="text-xs text-muted mb-4">Birim bazında</div>
        @if (Model.TotalUnits > 0)
        {
            <div id="chart-doluluk"></div>
            <div class="mt-4 space-y-2">
                <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>Kiralı</span>
                    <span class="text-sm font-semibold tabular-nums">@Model.RentedUnits <span class="text-xs font-normal text-muted">%@rentedPercentage.ToString("F0")</span></span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>Dolmak Üzere</span>
                    <span class="text-sm font-semibold tabular-nums">@Model.ExpiringLeaseUnits <span class="text-xs font-normal text-muted">%@expiringPercentage.ToString("F0")</span></span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><span class="w-2 h-2 rounded-full bg-slate-400 inline-block"></span>Boş</span>
                    <span class="text-sm font-semibold tabular-nums">@Model.VacantUnits <span class="text-xs font-normal text-muted">%@vacantPercentage.ToString("F0")</span></span>
                </div>
                <div class="flex items-center justify-between border-t border-[var(--color-border)] pt-2">
                    <span class="text-xs text-muted">Toplam</span>
                    <span class="text-sm font-semibold tabular-nums text-primary">@totalUnits</span>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-10 text-slate-400 text-sm">Henüz birim yok</div>
        }
    </div>
    }

    <!-- C: Top 5 Gelir Şampiyonları -->
    @if (hasPaymentAccess)
    {
    <div class="card" x-data="{ gelirSekme: 'tenant' }">
        <div class="flex items-center justify-between mb-3">
            <div>
                <div class="section-title">Gelir Şampiyonları</div>
                <div class="text-[11px] text-slate-500 mt-0.5">Son 12 ay tahsilat</div>
            </div>
            <div class="flex gap-1 bg-slate-100 rounded-lg p-0.5 flex-wrap justify-end">
                <button type="button" @@click="gelirSekme = 'tenant'"
                        :class="gelirSekme === 'tenant' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                        class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Kiracı</button>
                <button type="button" @@click="gelirSekme = 'property'"
                        :class="gelirSekme === 'property' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                        class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Taşınmaz</button>
                <button type="button" @@click="gelirSekme = 'store'"
                        :class="gelirSekme === 'store' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                        class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Mağaza</button>
                <button type="button" @@click="gelirSekme = 'risk'"
                        :class="gelirSekme === 'risk' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'"
                        class="text-[11px] font-semibold px-2.5 py-1 rounded-md transition-all">Risk</button>
            </div>
        </div>

        <!-- Kiracı sekmesi -->
        <div x-show="gelirSekme === 'tenant'">
        @if (!Model.TopRevenueTenants.Any())
        {
            <div class="text-center py-8 text-slate-400 text-sm">Henüz tahsilat verisi yok</div>
        }
        else
        {
            var maxTenantRevenue = Model.TopRevenueTenants.Max(tenant => tenant.TotalCollected);
            <div class="space-y-2.5">
                @{ int tenantRank = 0; }
                @foreach (var tenantRevenue in Model.TopRevenueTenants)
                {
                    tenantRank++;
                    var pct = maxTenantRevenue > 0 ? (double)(tenantRevenue.TotalCollected / maxTenantRevenue) * 100 : 0;
                    <a href="/Tenant/Details/@tenantRevenue.TenantId.ToHashId()" class="block p-2 rounded-lg hover:bg-slate-50 transition-colors no-underline">
                        <div class="flex items-center justify-between mb-1.5">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-5 h-5 rounded-md bg-primary-light text-primary text-[10px] font-bold flex items-center justify-center shrink-0">@tenantRank</span>
                                <span class="text-[13px] font-semibold text-slate-800 truncate">@tenantRevenue.TenantName</span>
                            </div>
                            <span class="text-[12px] font-bold text-slate-800 shrink-0">@tenantRevenue.TotalCollected.ToString("N0") ₺</span>
                        </div>
                        <div class="h-1 rounded-full overflow-hidden bg-slate-100">
                            <div class="h-full bg-accent"
                                 style="width:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <div class="text-[10px] text-slate-500 mt-1">@tenantRevenue.LeaseCount sözleşme</div>
                    </a>
                }
            </div>
        }
        </div>

        <!-- Taşınmaz sekmesi -->
        <div x-show="gelirSekme === 'property'" x-cloak>
        @if (!Model.TopRevenueProperties.Any())
        {
            <div class="text-center py-8 text-slate-400 text-sm">Henüz tahsilat verisi yok</div>
        }
        else
        {
            var maxPropertyRevenue = Model.TopRevenueProperties.Max(property => property.TotalCollected);
            <div class="space-y-2.5">
                @{ int rank = 0; }
                @foreach (var propertyRevenue in Model.TopRevenueProperties)
                {
                    rank++;
                    var pct = maxPropertyRevenue > 0 ? (double)(propertyRevenue.TotalCollected / maxPropertyRevenue) * 100 : 0;
                    <a href="/Property/Details/@propertyRevenue.PropertyId.ToHashId()" class="block p-2 rounded-lg hover:bg-slate-50 transition-colors no-underline">
                        <div class="flex items-center justify-between mb-1.5">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-5 h-5 rounded-md bg-primary-light text-primary text-[10px] font-bold flex items-center justify-center shrink-0">@rank</span>
                                <span class="text-[13px] font-semibold text-slate-800 truncate">@propertyRevenue.PropertyName</span>
                            </div>
                            <span class="text-[12px] font-bold text-slate-800 shrink-0">@propertyRevenue.TotalCollected.ToString("N0") ₺</span>
                        </div>
                        <div class="h-1 rounded-full overflow-hidden bg-slate-100">
                            <div class="h-full bg-accent"
                                 style="width:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <div class="text-[10px] text-slate-500 mt-1">@propertyRevenue.UnitCount birim</div>
                    </a>
                }
            </div>
        }
        </div>

        <!-- Mağaza sekmesi -->
        <div x-show="gelirSekme === 'store'" x-cloak>
        @if (!Model.TopRevenueStores.Any())
        {
            <div class="text-center py-8 text-slate-400 text-sm">Henüz mağaza tahsilatı yok</div>
        }
        else
        {
            var maxStoreRevenue = Model.TopRevenueStores.Max(store => store.TotalCollected);
            <div class="space-y-2.5">
                @{ int storeRank = 0; }
                @foreach (var storeRevenue in Model.TopRevenueStores)
                {
                    storeRank++;
                    var pct = maxStoreRevenue > 0 ? (double)(storeRevenue.TotalCollected / maxStoreRevenue) * 100 : 0;
                    <div class="p-2 rounded-lg">
                        <div class="flex items-center justify-between mb-1.5">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-5 h-5 rounded-md bg-primary-light text-primary text-[10px] font-bold flex items-center justify-center shrink-0">@storeRank</span>
                                <span class="text-[13px] font-semibold text-slate-800 truncate">@storeRevenue.StoreName</span>
                            </div>
                            <span class="text-[12px] font-bold text-slate-800 shrink-0">@storeRevenue.TotalCollected.ToString("N0") ₺</span>
                        </div>
                        <div class="h-1 rounded-full overflow-hidden bg-slate-100">
                            <div class="h-full bg-accent"
                                 style="width:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <div class="text-[10px] text-slate-500 mt-1">@storeRevenue.PaymentCount ödeme</div>
                    </div>
                }
            </div>
        }
        </div>

        <!-- Risk sekmesi -->
        <div x-show="gelirSekme === 'risk'" x-cloak>
        @if (!Model.RiskyTenants.Any())
        {
            <div class="text-center py-8 text-slate-400 text-sm">Riskli kiracı yok</div>
        }
        else
        {
            var maxRiskAmount = Model.RiskyTenants.Max(tenant => tenant.OverdueAmount);
            <div class="space-y-2.5">
                @{ int riskRank = 0; }
                @foreach (var riskyTenant in Model.RiskyTenants)
                {
                    riskRank++;
                    var pct = maxRiskAmount > 0 ? (double)(riskyTenant.OverdueAmount / maxRiskAmount) * 100 : 0;
                    <a href="/Tenant/Details/@riskyTenant.TenantId.ToHashId()" class="block p-2 rounded-lg hover:bg-slate-50 transition-colors no-underline">
                        <div class="flex items-center justify-between mb-1.5">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-5 h-5 rounded-md bg-red-100 text-danger text-[10px] font-bold flex items-center justify-center shrink-0">@riskRank</span>
                                <span class="text-[13px] font-semibold text-slate-800 truncate">@riskyTenant.TenantName</span>
                            </div>
                            <span class="text-[12px] font-bold text-danger shrink-0">@riskyTenant.OverdueAmount.ToString("N0") ₺</span>
                        </div>
                        <div class="h-1 rounded-full overflow-hidden bg-slate-100">
                            <div class="h-full bg-danger"
                                 style="width:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <div class="text-[10px] text-slate-500 mt-1">@riskyTenant.OverdueChargeCount gecikmiş tahakkuk</div>
                    </a>
                }
            </div>
        }
        </div>
    </div>
    }
</div>
}


<!-- ─── §3.6 LİSTE PANELİ ─── -->
@if (hasLeaseAccess || hasPropertyAccess)
{
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">

    <!-- A: Süresi Dolmak Üzere -->
    @if (hasLeaseAccess)
    {
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <div class="section-title">Süresi Dolmak Üzere</div>
            <a href="/Lease?filter=surek" class="link-more">Tümü</a>
        </div>
        @if (Model.LeaseStatusDistribution.Any())
        {
            var leaseStatusDots = new Dictionary<string, string>
            {
                ["Aktif"] = "bg-emerald-500",
                ["Taslak"] = "bg-slate-400",
                ["Revizyon İstenen"] = "bg-amber-500",
                ["Sona Erdi"] = "bg-slate-300",
                ["Feshedildi"] = "bg-red-400"
            };
            <div class="flex items-center justify-between flex-wrap gap-x-3 gap-y-1 mb-3 pb-3 border-b border-[var(--color-border)] text-[11px] text-slate-600">
                <div class="flex items-center flex-wrap gap-x-3 gap-y-1">
                    @foreach (var statusGroup in Model.LeaseStatusDistribution)
                    {
                        var statusDotClass = leaseStatusDots.TryGetValue(statusGroup.Key, out var dotCls) ? dotCls : "bg-slate-300";
                        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full @statusDotClass inline-block"></span>@statusGroup.Key <strong class="text-slate-800">@statusGroup.Value</strong></span>
                    }
                </div>
                <span class="text-muted">Ort. süre: <strong class="text-slate-700">@Model.AverageLeaseDurationMonths.ToString("F0") ay</strong></span>
            </div>
        }
        @if (!Model.ExpiringLeases.Any())
        {
            <div class="text-center py-8 text-slate-400 text-sm">Yakında dolacak sözleşme yok</div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var leaseSummary in Model.ExpiringLeases)
                {
                    var borderCls = leaseSummary.RemainingDays <= 10 ? "border-red-500" : leaseSummary.RemainingDays <= 30 ? "border-amber-500" : "border-emerald-500";
                    var badgeClass = leaseSummary.RemainingDays <= 10 ? "bg-red-100 text-red-700" : leaseSummary.RemainingDays <= 30 ? "bg-amber-100 text-amber-700" : "bg-emerald-100 text-emerald-700";
                    <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50/50 border-l-4 @borderCls hover:translate-x-0.5 transition-all">
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold text-slate-800 truncate">@leaseSummary.TenantName</div>
                            <div class="text-xs text-slate-500 truncate mt-0.5">@leaseSummary.PropertyName, @leaseSummary.UnitName</div>
                        </div>
                        <div class="ml-3 shrink-0 text-right">
                            <span class="px-2 py-1 rounded text-[11px] font-bold @badgeClass">@leaseSummary.RemainingDays gün</span>
                            <a href="/Lease/Details/@leaseSummary.LeaseId.ToHashId()" class="link-more mt-0.5 flex justify-end">Detay</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    }

    <!-- B: Boş Units -->
    @if (hasPropertyAccess)
    {
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <div class="section-title">Boş Birimler</div>
            <a href="/Lease/Create" class="link-more">Kiraya Ver</a>
        </div>
        @if (!Model.VacantUnitSummaries.Any())
        {
            <div class="text-center py-8 text-slate-400 text-sm">Tüm birimler kiralı</div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var vacantUnit in Model.VacantUnitSummaries)
                {
                    <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50/50 border-l-4 border-slate-300 hover:translate-x-0.5 transition-all">
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold text-slate-800 truncate">@vacantUnit.PropertyName</div>
                            <div class="text-xs text-slate-500 truncate mt-0.5">@vacantUnit.UnitName, @vacantUnit.District</div>
                        </div>
                        <div class="ml-3 shrink-0 text-right">
                            <span class="bg-slate-100 text-slate-700 px-2 py-1 rounded text-[11px] font-bold">@vacantUnit.Area.ToString("F0") m²</span>
                            <a href="/Lease/Create?unitId=@vacantUnit.UnitId.ToHashId()" class="link-more mt-0.5 flex justify-end">Kiraya Ver</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    }

</div>
}


<!-- ─── §3.7 REZERVASYON & MANUEL BORÇ ─── -->
@if (hasPaymentAccess && (Model.ManualChargeTotalThisMonth > 0 || Model.ReservationRevenueThisMonth > 0 || Model.UntransferredReservationCount > 0))
{
    <div class="section-label">Rezervasyon & Manuel Borç</div>
    <div class="stat-rail mb-6">

        <!-- Bu Ay Manuel Borç -->
        <div class="stat-rail-item">
            <div class="stat-rail-label">Bu Ay Manuel Borç</div>
            <div class="stat-rail-value"
                 data-countup="@Model.ManualChargeTotalThisMonth.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-decimals="2" data-suffix=" ₺">0</div>
        </div>

        <!-- Bu Ay Rezervasyon Geliri -->
        <div class="stat-rail-item">
            <div class="stat-rail-label">Bu Ay Rezervasyon Geliri</div>
            <div class="stat-rail-value"
                 data-countup="@Model.ReservationRevenueThisMonth.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-decimals="2" data-suffix=" ₺">0</div>
        </div>

        <!-- Aktarılmamış Ücretli Rezervasyon -->
        <div class="stat-rail-item">
            <div class="stat-rail-label"><span class="stat-rail-dot @(Model.UntransferredReservationCount > 0 ? "bg-warning" : "bg-slate-300")"></span>Aktarılmamış Ücretli Rezervasyon</div>
            <div class="stat-rail-value @(Model.UntransferredReservationCount > 0 ? "text-warning-strong" : "")" data-countup="@Model.UntransferredReservationCount" data-decimals="0">0</div>
        </div>
    </div>
}


<!-- ─── §3.8 HIZLI EYLEMLER ─── -->
