            <div class="text-xs text-muted mt-0.5">CSV/Excel yükle</div>
        </a>
    }
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // §4.C — CountUp.js
            document.querySelectorAll('[data-countup]').forEach(function (el) {
                var target = parseFloat(el.getAttribute('data-countup')) || 0;
                var decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
                var prefix = el.getAttribute('data-prefix') || '';
                var suffix = el.getAttribute('data-suffix') || '';
                var c = new countUp.CountUp(el, target, {
                    duration: 1.2,
                    separator: '.',
                    decimal: ',',
                    decimalPlaces: decimals,
                    prefix: prefix,
                    suffix: suffix
                });
                if (!c.error) c.start();
            });

            // §4.A0 — Aylık Kira Geliri mini çizgi grafiği — kaynak x zaman aralığı sekmeleri
            // (Alpine state değişince renderKiraTrend yeniden çağrılır; yeni sunucu isteği yok).
            var kiraTrendData = {
                tumu: @Html.Raw(SerializeTrendSet(Model.RevenueTrendAll)),
                sozlesme: @Html.Raw(SerializeTrendSet(Model.RevenueTrendLease)),
                manuel: @Html.Raw(SerializeTrendSet(Model.RevenueTrendManual)),
                rezervasyon: @Html.Raw(SerializeTrendSet(Model.RevenueTrendReservation))
            };
            var kiraTrendState = { kaynak: 'tumu', zaman: 'ay6' };
            var kiraChart = null;

            // Alpine'in @@click ifadeleri global (window) kapsamda çözümlenir — bu closure'ın
            // içindeki yerel fonksiyon Alpine'e görünmez, o yüzden window'a da atanır.
            window.renderKiraTrend = function renderKiraTrend(kaynak, zaman) {
                var combo = kiraTrendData[kaynak] && kiraTrendData[kaynak][zaman];
                if (!combo || combo.aylar.length === 0) return;
                kiraTrendState = { kaynak: kaynak, zaman: zaman };

                var lastIdx = combo.tahakkuk.length - 1;
                var valueEl = document.querySelector('#kira-trend-value');
                var rateEl = document.querySelector('#kira-trend-rate');
                var rateLabelEl = document.querySelector('#kira-trend-rate-label');

                if (valueEl) {
                    valueEl.textContent = combo.tahakkuk[lastIdx].toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
                }
                if (rateEl) {
                    var rate = combo.oran[lastIdx];
                    rateEl.textContent = rate === null ? '—' : '%' + rate.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
                    rateEl.className = 'font-medium ' + (rate === null ? 'text-muted' : rate >= 100 ? 'text-success' : rate >= 50 ? 'text-warning-strong' : 'text-danger');
                }
                if (rateLabelEl) {
                    rateLabelEl.textContent = combo.aylar[lastIdx] + ' tahsilat oranı';
                }

                if (kiraChart) {
                    kiraChart.updateOptions({ xaxis: { categories: combo.aylar } }, false, false);
                    kiraChart.updateSeries([
                        { name: 'Tahakkuk', data: combo.tahakkuk },
                        { name: 'Tahsilat', data: combo.tahsilat }
                    ]);
                }
            }

            var kiraTrendEl = document.querySelector('#chart-kira-trend');
            if (kiraTrendEl) {
                var initialCombo = kiraTrendData.tumu.ay6;
                kiraChart = new ApexCharts(kiraTrendEl, {
                    chart: { type: 'area', height: 140, toolbar: { show: false }, animations: { enabled: true, speed: 500 } },
                    series: [
                        { name: 'Tahakkuk', data: initialCombo.tahakkuk },
                        { name: 'Tahsilat', data: initialCombo.tahsilat }
                    ],
                    colors: [brandColor('teal'), brandColor('success')],
                    stroke: { width: 2, curve: 'smooth' },
                    fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.3, opacityTo: 0, stops: [0, 90, 100] } },
                    markers: { size: 3, colors: [brandColor('teal'), brandColor('success')], strokeColors: '#fff', strokeWidth: 2 },
                    dataLabels: { enabled: false },
                    legend: { show: false },
                    grid: { show: false, padding: { left: 8, right: 8, top: 4, bottom: 0 } },
                    xaxis: {
                        categories: initialCombo.aylar,
                        labels: { style: { fontSize: '10px', colors: '#94a3b8' } },
                        axisBorder: { show: false },
                        axisTicks: { show: false }
                    },
                    yaxis: { show: false },
                    tooltip: {
                        shared: true,
                        y: {
                            formatter: function (v) {
                                return v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
                            }
                        },
                        custom: function (opts) {
                            var combo = kiraTrendData[kiraTrendState.kaynak][kiraTrendState.zaman];
                            var idx = opts.dataPointIndex;
                            var oran = combo.oran[idx];
                            var oranText = oran === null ? '—' : '%' + oran.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
                            var tahakkuk = combo.tahakkuk[idx].toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            var tahsilat = combo.tahsilat[idx].toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            return '<div class="p-2 text-xs">'
                                + '<div class="font-semibold mb-1">' + combo.aylar[idx] + '</div>'
                                + '<div>Tahakkuk: ' + tahakkuk + ' ₺</div>'
                                + '<div>Tahsilat: ' + tahsilat + ' ₺ (' + oranText + ')</div>'
                                + '</div>';
                        }
                    }
                });
                kiraChart.render();
            }

            // §4.A2 — Gelir Kırılımı Donut (legend HTML'de; renkler legend noktalarıyla aynı)
            var kirilimEl = document.querySelector('#chart-gelir-kirilim');
            if (kirilimEl) {
                var kirilimData   = [@Html.Raw(string.Join(",", Model.ChargeTypeRevenueBreakdown.Select(x => x.TotalCollected.ToString(System.Globalization.CultureInfo.InvariantCulture))))];
                var kirilimLabels = [@Html.Raw(string.Join(",", Model.ChargeTypeRevenueBreakdown.Select(x => $"'{x.ChargeTypeName}'")))];

                if (kirilimData.reduce(function (a, b) { return a + b; }, 0) > 0) {
                    new ApexCharts(kirilimEl, {
                        chart: { type: 'donut', height: 200, animations: { enabled: true, speed: 600 } },
                        series: kirilimData,
                        labels: kirilimLabels,
                        colors: ['#10b981', '#f59e0b', '#0ea5e9', '#8b5cf6', '#f43f5e', '#94a3b8'],
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '68%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Toplam',
                                            formatter: function (w) {
                                                return w.globals.seriesTotals.reduce(function (a, b) { return a + b; }, 0).toLocaleString('tr-TR') + ' ₺';
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { show: false },
                        stroke: { width: 2, colors: ['#fff'] },
                        tooltip: { y: { formatter: function (v) { return v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺'; } } }
                    }).render();
                }
            }

            // §4.B — Doluluk Donut (legend HTML'de; renkler legend noktalarıyla aynı: emerald/amber/slate)
            var dolulukEl = document.querySelector('#chart-doluluk');
            if (dolulukEl) {
                var dolulukData   = [@Model.RentedUnits, @Model.ExpiringLeaseUnits, @Model.VacantUnits];
                var dolulukLabels = ['Kiralı', 'Dolmak Üzere', 'Boş'];

                if (dolulukData.reduce(function (a, b) { return a + b; }, 0) > 0) {
                    new ApexCharts(dolulukEl, {
                        chart: { type: 'donut', height: 200, animations: { enabled: true, speed: 600 } },
                        series: dolulukData,
                        labels: dolulukLabels,
                        colors: ['#10b981', '#f59e0b', '#94a3b8'],
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '68%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Birim',
                                            formatter: function (w) {
                                                return w.globals.seriesTotals.reduce(function (a, b) { return a + b; }, 0);
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { show: false },
                        stroke: { width: 2, colors: ['#fff'] },
                        tooltip: { y: { formatter: function (v) { return v + ' birim'; } } }
                    }).render();
                }
            }

        });
    </script>
}
