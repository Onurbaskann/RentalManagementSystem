@model KiraTakip.Web.Models.ViewModels.AdminUserEditViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    ViewData["UseCentralFeedback"] = true;
    var systemAdminRoleId = Model.Roles.FirstOrDefault(role => role.Name == "Sistem Yöneticisi")?.Id.ToString() ?? "0";
}

<div class="page-header">
    <div>
        <a href="/Admin/Users" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">
            ← Kullanıcı Yönetimi
        </a>
        <div class="page-title">Kullanıcı Düzenle</div>
        <div class="page-subtitle">@Model.Email</div>
    </div>
</div>

@if (Model.IsCurrentUser)
{
    <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-lg mb-4 text-[13.5px]">
        Kendi hesabınızı düzenliyorsunuz. Rol değişikliği uygulanmaz.
    </div>
}

<div class="card" x-data="{ seciliRolId: '@Model.RoleId', globalErisim: @(Model.HasAccessToAllSpaces ? "true" : "false") }">
    <form asp-form-write-permission="@PermissionCatalog.User.Edit" method="post" action="/Admin/Users/Edit/@Model.Id">
        @Html.AntiForgeryToken()


        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsCurrentUser" />

        <div class="form-group">
            <label class="form-label">E-posta</label>
            <div class="form-control bg-slate-50 text-muted cursor-default">@Model.Email</div>
            <input type="hidden" asp-for="Email" />
        </div>

        <div class="form-group">
            <label class="form-label">Ad Soyad</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Rol</label>
            @if (Model.IsCurrentUser)
            {
                var currentRoleName = Model.Roles.FirstOrDefault(role => role.Id == Model.RoleId)?.Name ?? "—";
                <div class="form-control bg-slate-50 text-muted cursor-default">
                    @currentRoleName
                </div>
                <input type="hidden" asp-for="RoleId" />
            }
            else
            {
                <select asp-for="RoleId" class="form-control" x-model="seciliRolId">
                    <option value="0">— Seçin —</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
                <span asp-validation-for="RoleId" class="form-error"></span>
            }
        </div>

        <div class="bg-slate-50 border border-slate-100 rounded-lg p-3 mt-1 text-[13px] text-slate-500"
             x-show="seciliRolId != '0'" x-cloak>
            İzinler bu rol için rol yönetiminde tanımlanır.
            <a href="/Admin/Roles" class="text-primary underline">Rolleri yönet →</a>
        </div>

        <!-- Kapsam ayarları: Admin rolünde gizli -->
        <div x-show="seciliRolId !== '@systemAdminRoleId'" x-cloak class="mt-5">
            <div class="bg-slate-50 border border-slate-100 rounded-xl p-4">
                <div class="text-[10px] font-bold text-slate-400 mb-3 flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                    Alan Erişim Kapsamı
                </div>

                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="checkbox" name="HasAccessToAllSpaces" value="true"
                           @(Model.HasAccessToAllSpaces ? "checked" : "")
                           @@change="globalErisim = $event.target.checked"
                           class="w-4 h-4 rounded border-slate-300 accent-primary" />
                    <input type="hidden" name="HasAccessToAllSpaces" value="false" />
                    <span class="text-[13.5px] font-semibold text-slate-700">Tüm Alanlara Erişim</span>
                </label>
                <p class="text-[11.5px] text-slate-400 mt-1.5 ml-6" x-show="globalErisim">
                    Kullanıcı sistemdeki tüm alanlara erişebilir.
                </p>

                <!-- Spesifik alan kapsamı: global toggle kapalıyken -->
                @if (Model.Spaces.Any())
                {
                    <div x-show="seciliRolId !== '@systemAdminRoleId' && seciliRolId !== '0' && !globalErisim" x-cloak class="mt-3">
                        <div class="text-[11.5px] font-semibold text-slate-500 mb-2">Alan Yetkileri</div>
                        <div class="flex flex-col gap-2.5">
                            @for (int i = 0; i < Model.Spaces.Count; i++)
                            {
                                <label class="flex items-center gap-2.5 text-[13.5px] cursor-pointer group">
                                    <input type="checkbox" name="SelectedSpaceIds"
                                           value="@Model.Spaces[i].SpaceId"
                                           @(Model.Spaces[i].Selected ? "checked" : "")
                                           class="w-4 h-4 rounded border-slate-300 accent-primary" />
                                    <span class="font-semibold text-slate-700 group-hover:text-primary transition-colors">@Model.Spaces[i].NamePath</span>
                                </label>
                            }
                        </div>
                        <div class="text-[11px] text-slate-400 mt-4 pt-3 border-t border-slate-200/60 italic flex items-center gap-1.5">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            Kullanıcı yalnızca seçilen alanlara (ve alt alanlarına) bağlı bilgileri görebilir.
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex gap-2.5 mt-6">
            <button type="submit" class="btn btn-primary px-6">Kaydet</button>
            <a href="/Admin/Users" class="btn btn-secondary px-6">İptal</a>
        </div>
    </form>
</div>


