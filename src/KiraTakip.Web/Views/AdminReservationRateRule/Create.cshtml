@model KiraTakip.Web.Models.ViewModels.ReservationRateOverrideViewModel
@{
    ViewData["Title"] = "Yeni Ücret Kuralı";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header">
    <a href="/Admin/ReservationRateOverride" class="text-[12.5px] text-muted no-underline inline-flex items-center gap-1 mb-2 hover:text-primary transition-colors">← Rezervasyon Ücret Kuralları</a>
    <div class="page-title">Yeni Rezervasyon Ücret Kuralı</div>
    <div class="page-subtitle">Alan için rezervasyon ücret kuralı ve borç tipi tanımlayın</div>
</div>

<div class="card">
    <form asp-action="Create" method="post" asp-form-write-permission="@PermissionCatalog.ReservationRateRule.Create">
        @Html.AntiForgeryToken()



        <div class="form-group">
            <label asp-for="SpaceId" class="form-label">Alan <span class="text-danger">*</span></label>
            <select asp-for="SpaceId" class="form-control">
                <option value="">— Alan seçin —</option>
                @foreach (var b in Model.Spaces)
                {
                    var depth = b.Path.Count(c => c == '/') - 1;
                    <option value="@b.Id" selected="@(Model.SpaceId == b.Id ? "selected" : null)">@(new string('·', Math.Max(depth, 0)) + " " + b.Name)</option>
                }
            </select>
            <span asp-validation-for="SpaceId" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ChargeTypeId" class="form-label">Borç Tipi <span class="text-danger">*</span></label>
            <select asp-for="ChargeTypeId" class="form-control">
                <option value="">— Borç tipi seçin —</option>
                @foreach (var t in Model.ChargeTypes)
                {
                    <option value="@t.Id" selected="@(Model.ChargeTypeId == t.Id ? "selected" : null)">@t.Name</option>
                }
            </select>
            <span asp-validation-for="ChargeTypeId" class="form-error"></span>
        </div>

        <div class="two-col">
            <div class="form-group">
                <label asp-for="FreeDurationMinutes" class="form-label">Ücretsiz Süre (dk) <span class="text-danger">*</span></label>
                <input asp-for="FreeDurationMinutes" type="number" class="form-control" />
                <span asp-validation-for="FreeDurationMinutes" class="form-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="BillingPeriodMinutes" class="form-label">Periyot Süresi (dk) <span class="text-danger">*</span></label>
                <input asp-for="BillingPeriodMinutes" type="number" class="form-control" />
                <span asp-validation-for="BillingPeriodMinutes" class="form-error"></span>
            </div>
        </div>

        <div class="two-col">
            <div class="form-group">
                <label asp-for="PeriodRate" class="form-label">Periyot Ücreti (₺) <span class="text-danger">*</span></label>
                <input asp-for="PeriodRate" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PeriodRate" class="form-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="KdvRate" class="form-label">KDV Oranı (%)</label>
                <input asp-for="KdvRate" type="number" step="1" min="0" max="100" class="form-control" />
                <span asp-validation-for="KdvRate" class="form-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <input asp-for="Description" type="text" class="form-control" placeholder="Opsiyonel not…" />
            <span asp-validation-for="Description" class="form-error"></span>
        </div>

        <div class="form-group">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" />
                <span class="form-label m-0">Aktif</span>
            </label>
        </div>

        <div class="flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary" asp-permission="@PermissionCatalog.ReservationRateRule.Create">Kaydet</button>
            <a href="/Admin/ReservationRateOverride" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
</div>
