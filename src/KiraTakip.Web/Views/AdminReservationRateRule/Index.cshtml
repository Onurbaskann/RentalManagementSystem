@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.ReservationRateOverrideListItemDto>
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Rezervasyon Ücret Kuralları";
    ViewData["UseCentralFeedback"] = true;
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var pagination = PaginationModel.FromPaged(Model, "/Admin/ReservationRateOverride", query.ToQueryDict());
}


<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Rezervasyon Ücret Kuralları</div>
        <div class="page-subtitle">@Model.Total kayıt · Birime özel kural genel kuralı geçersiz kılar</div>
    </div>
    <a href="/Admin/ReservationRateOverride/Create" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Kural
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Kapsam</th>
                    <th class="w-32 text-center">Ücretsiz Süre</th>
                    <th class="w-32 text-center">Periyot</th>
                    <th class="w-32 text-right">Periyot Ücreti</th>
                    <th class="w-20 text-center">KDV</th>
                    <th class="w-20">Durum</th>
                    <th class="w-36"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.Items)
                {
                    <tr>
                        <td>
                            @if (k.UnitId == null)
                            {
                                <span class="font-semibold">Genel Kural</span>
                                <div class="text-xs text-muted">Tüm toplantı salonları</div>
                            }
                            else
                            {
                                <span class="font-semibold">@k.UnitName</span>
                                <div class="text-xs text-muted">@k.PropertyName</div>
                            }
                            @if (!string.IsNullOrEmpty(k.Description))
                            {
                                <div class="text-[11px] text-muted mt-0.5">@k.Description</div>
                            }
                        </td>
                        <td class="text-center">@k.FreeDurationMinutes dk</td>
                        <td class="text-center">@k.BillingPeriodMinutes dk/periyot</td>
                        <td class="text-right font-semibold">@k.PeriodRate.ToString("N2") ₺</td>
                        <td class="text-center">%@k.KdvRate.ToString("F0")</td>
                        <td>
                            @if (k.IsActive) { <span class="badge badge-kirali">Aktif</span> }
                            else { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/ReservationRateOverride/Edit/@k.Id.ToHashId()" class="btn btn-sm btn-secondary">Düzenle</a>
                            <form method="post" action="/Admin/ReservationRateOverride/ToggleStatus/@k.Id.ToHashId()" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(k.IsActive ? "btn-danger" : "btn-amber")">
                                    @(k.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center p-8 text-muted">Henüz ücret kuralı tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
