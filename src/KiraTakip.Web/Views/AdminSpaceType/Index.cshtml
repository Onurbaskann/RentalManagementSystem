@model List<KiraTakip.Models.Dtos.Space.SpaceTypeDto>
@{
    ViewData["Title"] = "Alan Türleri";
    ViewData["UseCentralFeedback"] = true;
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Alan Türleri</div>
        <div class="page-subtitle">@Model.Count kayıt</div>
    </div>
    <a href="/Admin/SpaceType/Create" class="btn btn-primary flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Alan Türü
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="w-16 text-center">Sıra</th>
                    <th>Kod</th>
                    <th>Ad</th>
                    <th>Varsayılan Kullanım</th>
                    <th class="w-24">Durum</th>
                    <th class="w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in Model)
                {
                    <tr>
                        <td class="text-center text-muted text-xs">@type.SortOrder</td>
                        <td class="text-muted text-xs">@type.Code</td>
                        <td class="font-medium text-slate-700">@type.Name</td>
                        <td><span class="badge @SpaceDisplay.UsageBadge(type.DefaultUsage)">@SpaceDisplay.Usage(type.DefaultUsage)</span></td>
                        <td>
                            @if (type.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/SpaceType/Edit/@type.Id.ToHashId()" class="icon-btn" data-tip="Düzenle" aria-label="Düzenle">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg>
                            </a>
                            <form asp-permission="@PermissionCatalog.SpaceType.ToggleStatus" method="post" action="/Admin/SpaceType/ToggleStatus/@type.Id.ToHashId()"
                                  data-confirm="@(type.IsActive ? $"'{type.Name}' pasif yapılsın mı?" : $"'{type.Name}' aktif yapılsın mı?")"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(type.IsActive ? "btn-danger" : "btn-amber")">
                                    @(type.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-8 text-muted">Henüz alan türü tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
