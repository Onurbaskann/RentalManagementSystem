@model SpaceTypeFormViewModel
@{
    var isEdit = Model.Id != 0;
    var action = isEdit ? $"/Admin/SpaceType/Edit/{Model.Id.ToHashId()}" : "/Admin/SpaceType/Create";
    var permission = isEdit ? PermissionCatalog.SpaceType.Edit : PermissionCatalog.SpaceType.Create;
}

<div class="max-w-[600px] mx-auto">
    <div class="page-header">
        <div class="page-title">@(isEdit ? "Alan Türünü Düzenle" : "Yeni Alan Türü")</div>
    </div>

    <div class="card">
        <form method="post" action="@action" asp-form-write-permission="@permission">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Kod <span class="text-red-500">*</span></label>
                <input name="Code" value="@Model.Code" class="form-control" maxlength="50" />
            </div>
            <div class="form-group">
                <label class="form-label">Ad <span class="text-red-500">*</span></label>
                <input name="Name" value="@Model.Name" class="form-control" maxlength="150" />
            </div>
            <div class="form-group">
                <label class="form-label">Sıra</label>
                <input name="SortOrder" type="number" value="@Model.SortOrder" class="form-control w-24" />
            </div>
            <div class="form-group">
                <label class="form-label">Varsayılan Kullanım</label>
                <select name="DefaultUsage" class="form-control">
                    @foreach (var usage in new[] { SpaceUsage.Rentable, SpaceUsage.Reservable, SpaceUsage.NotRentable })
                    {
                        <option value="@usage" selected="@(usage == Model.DefaultUsage)">@SpaceDisplay.Usage(usage)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="DefaultIsPreAllocatable" value="true" checked="@Model.DefaultIsPreAllocatable" class="w-4 h-4 accent-primary cursor-pointer" />
                    <span class="form-label mb-0">Varsayılan olarak ön tahsise açık</span>
                </label>
            </div>
            <div class="form-group">
                <label class="form-label">Varsayılan Özellikler</label>
                <div class="flex flex-col gap-2">
                    @foreach (var attr in Model.AttributeCandidates)
                    {
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" name="DefaultAttributeIds" value="@attr.Id" checked="@Model.DefaultAttributeIds.Contains(attr.Id)" class="w-4 h-4 accent-primary cursor-pointer" />
                            <span class="text-sm">@attr.Name <span class="text-muted text-xs">(@SpaceDisplay.DataType(attr.DataType))</span></span>
                        </label>
                    }
                    @if (!Model.AttributeCandidates.Any())
                    {
                        <div class="text-xs text-muted">Tanımlı özellik yok.</div>
                    }
                </div>
            </div>

            <div class="flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-6" asp-permission="@permission">Kaydet</button>
                <a href="/Admin/SpaceType" class="btn btn-secondary px-6">İptal</a>
            </div>
        </form>
    </div>
</div>
