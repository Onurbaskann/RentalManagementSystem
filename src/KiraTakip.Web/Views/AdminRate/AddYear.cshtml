@model KiraTakip.Web.Models.ViewModels.RateYearAddViewModel
@{
    ViewData["Title"] = "Yeni Tarife Yılı";
    ViewData["UseCentralFeedback"] = true;
    var existingYears = ViewBag.ExistingYears as IEnumerable<int> ?? [];
}

<div class="max-w-[600px] mx-auto"><div class="page-header">
    <div>
        <div class="page-title">Yeni Tarife Yılı</div>
    </div>
</div>

<div class="card">
    <form method="post" action="/Admin/Rate/AddYear">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Yıl <span class="text-danger">*</span></label>
            <input asp-for="Year" type="number" class="form-control w-32" />
            <span asp-validation-for="Year" class="text-danger text-xs"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Önceki yıldan kopyala</label>
            <select asp-for="CopyFromYear" class="form-control max-w-52">
                <option value="">— Kopyalama (boş başlat) —</option>
                @foreach (var y in existingYears)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <div class="text-xs text-muted mt-1">Seçilirse o yılın fiyatları kopyalanır.</div>
        </div>

        <div class="flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary">Oluştur</button>
            <a href="/Admin/Rate" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
</div>
