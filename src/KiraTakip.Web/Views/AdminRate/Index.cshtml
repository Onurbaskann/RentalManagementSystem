@model KiraTakip.Models.Common.PagedResult<KiraTakip.Models.Dtos.RateSchedule.RateYearSummaryDto>
@using KiraTakip.Models.Common
@{
    ViewData["Title"] = "Tarifeler";
    ViewData["UseCentralFeedback"] = true;
    var query = ViewBag.Query as TableQuery ?? new TableQuery();
    var pagination = PaginationModel.FromPaged(Model, "/Admin/Rate", query.ToQueryDict());
}


<div class="page-header flex items-center justify-between">
    <div>
        <div class="page-title">Tarifeler</div>
        <div class="page-subtitle">Yıllık borç tipi tarifeleri</div>
    </div>
    <a href="/Admin/Rate/AddYear" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yıl Ekle
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th class="w-20">Yıl</th>
                    <th class="w-24">Kalem Sayısı</th>
                    <th class="w-24">Durum</th>
                    <th class="w-44"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td class="font-bold text-base">@t.Year</td>
                        <td class="text-center">@t.ItemCount</td>
                        <td>
                            @if (t.IsActive)
                            { <span class="badge badge-kirali">Aktif</span> }
                            else
                            { <span class="badge badge-gecmis">Pasif</span> }
                        </td>
                        <td class="flex gap-1.5 justify-end">
                            <a href="/Admin/Rate/Year/@t.Year" class="icon-btn" data-tip="Düzenle" aria-label="Düzenle">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg>
                            </a>
                            <form method="post" action="/Admin/Rate/ToggleStatus/@t.Year"
                                  data-confirm="@(t.IsActive ? $"{t.Year} yılı pasif yapılsın mı?" : $"{t.Year} yılı aktif yapılsın mı?")"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-danger" : "btn-amber")">
                                    @(t.IsActive ? "Pasif Yap" : "Aktif Yap")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="4" class="text-center p-8 text-muted">Henüz tarife tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pagination)
</div>
