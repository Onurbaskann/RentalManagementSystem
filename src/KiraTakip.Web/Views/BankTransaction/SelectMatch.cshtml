@model KiraTakip.Web.Models.ViewModels.BankTransactionMatchSelectionViewModel
@using KiraTakip.Models.Enums
@{
    ViewData["Title"] = "Ödeme Eşleştir";
    ViewData["UseCentralFeedback"] = true;
    var transaction = Model.BankTransaction;
}

<div class="page-header flex items-center justify-between">
    <div>
        <a href="/BankTransaction" class="text-xs text-muted no-underline inline-flex items-center gap-1 mb-2">← Banka Hareketleri</a>
        <div class="page-title">Ödeme Eşleştir</div>
        <div class="page-subtitle">Banka hareketine karşılık gelen ödemeyi seçin</div>
    </div>
</div>

<!-- Hareketi bilgileri -->
<div class="card mb-5">
    <div class="section-title mb-3">Banka Hareketi</div>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(160px,1fr))] gap-3.5">
        <div>
            <div class="detail-label">Tarih</div>
            <div class="font-semibold">@transaction.TransactionDate.ToString("dd.MM.yyyy")</div>
        </div>
        <div>
            <div class="detail-label">Tutar</div>
            <div class="font-display text-lg font-bold">@transaction.TransactionAmount.ToString("N0") ₺</div>
        </div>
        <div>
            <div class="detail-label">Karşı Taraf</div>
            <div>@(transaction.SenderInfo ?? transaction.SenderIban ?? "—")</div>
        </div>
        <div>
            <div class="detail-label">Açıklama</div>
            <div class="text-sm text-muted">@transaction.Description</div>
        </div>
        <div>
            <div class="detail-label">Mağaza</div>
            <div>@transaction.StoreName</div>
        </div>
    </div>
</div>

<!-- Aday ödemeler -->
<div class="card p-0 overflow-hidden">
    <div class="px-5 py-4 border-b border-[var(--color-border)] flex justify-between items-center">
        <div class="section-title m-0">Aday Ödemeler (@Model.PaymentCandidates.Count)</div>
        @if (!Model.PaymentCandidates.Any())
        {
            <span class="text-sm text-muted">Eşleştirilebilecek onaylı/bekleyen ödeme bulunamadı.</span>
        }
        else
        {
            <span class="text-xs text-muted">Yalnız aynı mağaza hesabına ait ödemeler listelenir.</span>
        }
    </div>
    @if (Model.PaymentCandidates.Any())
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Ödeme</th>
                        <th>Kiracı</th>
                        <th>Dönem</th>
                        <th>Tutar</th>
                        <th>Ödeme Tarihi</th>
                        <th>Durum</th>
                        <th>Uyum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNumber = 0;
                        foreach (var payment in Model.PaymentCandidates)
                        {
                            bool isExactAmount = payment.Amount == transaction.TransactionAmount;
                            bool isCloseAmount = Math.Abs(payment.Amount - transaction.TransactionAmount) <= transaction.TransactionAmount * 0.02m;
                            int dayDifference = Math.Abs((payment.PaymentDate - transaction.TransactionDate).Days);

                            string compatibilityLabel, compatibilityClass, compatibilityTooltip;
                            if (isExactAmount && dayDifference <= 15) { compatibilityLabel = "Yüksek"; compatibilityClass = "badge-kirali"; compatibilityTooltip = $"Tutar birebir eşleşiyor • Tarih farkı {dayDifference} gün (≤15)"; }
                            else if (isExactAmount) { compatibilityLabel = "Orta"; compatibilityClass = "badge-surek"; compatibilityTooltip = $"Tutar birebir eşleşiyor • Tarih farkı {dayDifference} gün (>15)"; }
                            else if (isCloseAmount && dayDifference <= 15) { compatibilityLabel = "Zayıf"; compatibilityClass = "badge-bos"; compatibilityTooltip = $"Tutar %2 toleransta • Tarih farkı {dayDifference} gün"; }
                            else { compatibilityLabel = "Düşük"; compatibilityClass = "badge-gecmis"; compatibilityTooltip = $"Tutar farkı %2'den fazla veya tarih uzak ({dayDifference} gün)"; }

                            string statusClass = payment.Status == PaymentStatus.Approved ? "badge-kirali" : "badge-surek";
                            string statusLabel = payment.Status == PaymentStatus.Approved ? "Onaylandı" : "Onay Bekliyor";
                            rowNumber++;
                            <tr class="@(rowNumber == 1 ? "bg-green-50" : "")">
                                <td class="font-mono text-muted-sm">@payment.PaymentNo</td>
                                <td class="font-semibold">@(string.IsNullOrEmpty(payment.TenantDisplayName) ? "Rezervasyon Ödemesi" : payment.TenantDisplayName)</td>
                                <td class="text-sm">@payment.PeriodStart.ToString("MMMM yyyy")</td>
                                <td class="@(isExactAmount ? "font-bold" : "font-normal")">
                                    @payment.Amount.ToString("N0") ₺
                                    @if (!isExactAmount)
                                    {
                                        <span class="text-[11px] text-muted"> (fark: @Math.Abs(payment.Amount - transaction.TransactionAmount).ToString("N0") ₺)</span>
                                    }
                                </td>
                                <td>
                                    @payment.PaymentDate.ToString("dd.MM.yyyy")
                                    <span class="text-[11px] text-muted"> (@dayDifference gün)</span>
                                </td>
                                <td><span class="badge @statusClass">@statusLabel</span></td>
                                <td><span class="badge @compatibilityClass" data-tip="@compatibilityTooltip">@compatibilityLabel</span></td>
                                <td>
                                    <form method="post" action="/BankTransaction/Match">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="PaymentId" value="@payment.Id" />
                                        <input type="hidden" name="BankTransactionId" value="@transaction.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm">Eşleştir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-8 text-center text-muted text-sm">
            Eşleştirilebilecek ödeme bulunamadı. Önce ilgili tahakkuk için ödeme girilmeli ve onaylanmalıdır.
        </div>
    }
</div>

