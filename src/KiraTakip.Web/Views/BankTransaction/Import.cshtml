@model KiraTakip.Web.Models.ViewModels.BankTransactionImportViewModel
@{
    ViewData["Title"] = "Banka Hareketi İçe Aktar";
    ViewData["UseCentralFeedback"] = true;
}

<div class="max-w-[600px] mx-auto">
    <div class="page-header">
        <div>
            <a href="/BankTransaction" class="text-xs text-muted no-underline inline-flex items-center gap-1 mb-2">← Banka Hareketleri</a>
            <div class="page-title">CSV İçe Aktar</div>
            <div class="page-subtitle">Bankanızdan indirdiğiniz CSV dosyasını yükleyin.</div>
        </div>
    </div>

    <div>
    <div class="card">
        <form method="post" action="/BankTransaction/Import" enctype="multipart/form-data">
            @Html.AntiForgeryToken()


            <div class="form-group">
                <label class="form-label">Banka</label>
                <select asp-for="BankCode" class="form-control">
                    <option value="AKBANK">Akbank</option>
                </select>
                <span asp-validation-for="BankCode" class="text-red-600 text-xs"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Hedef Mağaza <span class="text-red-500">*</span></label>
                <select asp-for="StoreId" class="form-control">
                    <option value="0">Seçiniz</option>
                    @foreach (var item in Model.StoreOptions)
                    {
                        <option value="@item.Id">@item.Name — @item.ProviderCode / @item.Currency</option>
                    }
                </select>
                <span asp-validation-for="StoreId" class="text-red-600 text-xs"></span>
                @if (!Model.StoreOptions.Any())
                {
                    <div class="text-xs text-amber-700 mt-1">Aktif ve tek aktif hesaba sahip mağaza bulunamadı; içe aktarma yapılamaz.</div>
                }
                <div class="form-hint">Bu dosyadaki tüm hareketler seçilen mağazanın aktif hesabına bağlanır ve yalnız aynı hesaba ait ödemelerle eşleştirilebilir.</div>
            </div>

            <div class="form-group">
                <label class="form-label">CSV Dosyası</label>
                <input type="file" asp-for="File" class="form-control" accept=".csv,.txt" />
                <span asp-validation-for="File" class="text-red-600 text-xs"></span>
                <div class="form-hint">Noktalı virgülle (;) ayrılmış CSV formatı. Başlık satırı içermeli.</div>
            </div>

            <div class="bg-surface rounded-xl px-3.5 py-3 mb-4 text-sm text-muted">
                <strong class="text-primary block mb-1.5">Beklenen kolon sırası (Akbank):</strong>
                Tarih · Açıklama · Borç · Alacak · Bakiye · Karşı Hesap · Karşı Unvan
            </div>

            <div class="flex gap-2.5">
                <button type="submit" class="btn btn-primary">İçe Aktar</button>
                <a href="/BankTransaction" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
    </div>
</div>

